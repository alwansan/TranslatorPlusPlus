{
    "name": "translator++",
    "description": "Translator++, a multipurpose translation tool.",
    "main": "main.js",
    "homepage": "https://dreamsavior.net",
    "version": "8.8.9",
    "author": "Dreamsavior",
    "license": "GPL",
    "chromium-args": "--mixed-context --enable-spell-checking --disable-web-security --memory-pressure-off --unlimited-storage",
    "window": {
        "width": 880,
        "height": 600,
        "icon": "icon.png"
    },
    "inject_js_start": "www/js/preload.js",
    "dependencies": {
        "@alenaksu/json-viewer": "^0.2.0",
        "7zip-min": "^1.1.1",
        "acorn": "^8.1.1",
        "acorn-loose": "^8.1.0",
        "associate-ext": "github:dreamsavior/associate-ext",
        "async-lz-string": "^1.0.3",
        "async-wait-until": "^2.0.12",
        "await-fs": "^1.0.0",
        "baidu-translate-api": "^0.4.0",
        "better-copy": "^1.0.4",
        "better-localstorage": "github:dreamsavior/Better-localStorage",
        "blob-polyfill": "^9.0.20240710",
        "buffer-tools": "github:dreamsavior/buffer-tools",
        "codepage": "^1.15.0",
        "comment-parser": "^1.4.0",
        "create-require": "^1.1.1",
        "debounce": "^1.2.1",
        "detect-file-encoding-and-language": "^2.3.1",
        "dexie": "^4.0.7",
        "dragselect": "^1.13.1",
        "encoding-japanese": "^1.0.30",
        "fs-extra": "^9.0.0",
        "glob": "^8.1.0",
        "glob-to-regexp": "^0.4.1",
        "iconv-lite": "^0.6.3",
        "ini": "^3.0.1",
        "is-valid-path": "^0.1.1",
        "jquery": "^1.12.3",
        "jquery-csv": "^1.0.21",
        "js-ini": "^1.5.1",
        "js-tiktoken": "^1.0.12",
        "js-tokens": "^6.0.0",
        "jschardet": "^3.0.0",
        "jsonata": "^2.0.3",
        "kaitai-struct": "github:dreamsavior/kaitai_struct_translatable",
        "kstg": "^0.7.0",
        "light-trans": "github:dreamsavior/light-trans",
        "module-alias": "^2.2.2",
        "node-downloader-helper": "^1.0.18",
        "p-limit": "^3.1.0",
        "pako": "^2.0.4",
        "pofile": "^1.1.4",
        "postman-request": "^2.88.1-postman.28",
        "prismjs": "^1.29.0",
        "promisify-child-process": "^4.1.1",
        "regexp-match-indices": "^1.0.2",
        "renpy-js": "^1.0.0",
        "request-progress": "^3.0.0",
        "rpy-parser": "github:dreamsavior/rpy-parser",
        "shell-escape": "^0.2.0",
        "shelljs": "^0.8.5",
        "string-argv": "^0.3.1",
        "strip-bom": "^4.0.0",
        "userscript-meta": "^1.0.1",
        "win-version-info": "^6.0.1",
        "windows-elevate": "^1.0.1",
        "windows-shortcuts": "^0.1.6",
        "ws": "^8.2.2",
        "yaml": "^1.10.2"
    },
    "show": false,
    "localConfig": {
        "logToFile": false,
        "configFile": "data\\config.json",
        "defaultTemplate": "data\\template.trans",
        "ruby": "ruby\\bin\\ruby.exe",
        "php": "php\\php.exe",
        "addons": "www\\addons",
        "phpAddons": "www\\php\\addons",
        "defaultStagingPath": "data/staging",
        "extensions": [
            "tpp",
            "trans",
            "json"
        ],
        "iconIndex": {
            "tpp": 4,
            "trans": 3,
            "json": 3
        },
        "defaultIconIndex": 3,
        "versionHistory": "http://dreamsavior.net/others/verHistory.php",
        "checkVersion": "not-always",
        "defaultDocsUrl": "http://dreamsavior.net/?post_type=docs&search_in_doc=all&s="
    },
    "scripts": {
        "test": "jest --coverage",
        "build-doc": "jsdoc -c jsdoc.json"
    },
    "licenseScope": {
        "include": [
            "www/**/*.js",
            "www/**/*.css"
        ],
        "exclude": [
            "**/node_modules/**",
            "www/modules/**",
            "www/php/**",
            "www/addons/**"
        ],
        "allowedExtensions": [
            "js",
            "css",
            "mjs",
            "ts"
        ],
        "licenseFile": "license.txt"
    }
}
