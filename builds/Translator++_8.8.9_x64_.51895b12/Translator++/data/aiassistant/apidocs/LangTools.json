      "getLanguageList": {
        "signature": "getLanguageList(blacklist, mode) → Object",
        "description": "Get a list of languages, excluding those in the blacklist",
        "parameters": [
          {
            "name": "blacklist",
            "type": "Array",
            "description": "The list of language codes to exclude",
            "required": true
          },
          {
            "name": "mode",
            "type": "string",
            "description": "What code to send to the client, default is \"name\"",
            "required": true
          }
        ],
        "returns": {
          "type": "Object",
          "description": "The list of languages"
        },
        "examples": [],
        "usage": "getLanguageList(blacklist, mode) : Object"
      },
