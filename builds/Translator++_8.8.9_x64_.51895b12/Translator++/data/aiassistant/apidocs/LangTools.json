      },
      "getLanguage": {
        "signature": "getLanguage(code) → Object",
        "description": "Get language by code",
        "parameters": [
          {
            "name": "code",
            "type": "string",
            "description": "The language code",
            "required": true
          }
        ],
        "returns": {
          "type": "Object",
          "description": "The language object"
        },
        "examples": [],
        "usage": "getLanguage(code) : Object"
