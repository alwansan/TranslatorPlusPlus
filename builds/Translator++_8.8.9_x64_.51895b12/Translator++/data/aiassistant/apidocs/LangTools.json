        "signature": "lookupDB(key, name) → Object",
        "description": "Lookup in the language database by key or name",
        "parameters": [
          {
            "name": "key",
            "type": "string",
            "description": "The key to lookup",
            "required": true
          },
          {
            "name": "name",
            "type": "string",
            "description": "The name to lookup",
            "required": true
          }
        ],
        "returns": {
          "type": "Object",
          "description": "The language object"
        },
        "examples": [],
        "usage": "lookupDB(key, name) : Object"
