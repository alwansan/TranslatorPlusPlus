        ],
        "returns": {
          "type": "string",
          "description": "The display name of the language"
        },
        "examples": [
          "```js\nlangTools.getDisplayName(\"ja\");\n// returns \"日本語\"\n```"
        ],
        "usage": "getDisplayName(langObj) : string"
