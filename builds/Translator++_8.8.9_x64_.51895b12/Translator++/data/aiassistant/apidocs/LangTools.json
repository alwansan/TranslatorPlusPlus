        "signature": "compareWithDB(langPairs) → Object",
        "description": "Compare language pairs with the language database",
        "parameters": [
          {
            "name": "langPairs",
            "type": "Object",
            "description": "The language pairs to compare",
            "required": true
          }
        ],
        "returns": {
          "type": "Object",
          "description": "The result of the comparison"
        },
        "examples": [],
        "usage": "compareWithDB(langPairs) : Object"
      },
      "generateLangPairs": {
        "signature": "generateLangPairs(langPairs) → Object",
        "description": "Generate language pairs",
        "parameters": [
          {
            "name": "langPairs",
            "type": "Object",
            "description": "The language pairs to generate",
            "required": true
          }
        ],
        "returns": {
          "type": "Object",
          "description": "The result of the generation"
        },
        "examples": [],
        "usage": "generateLangPairs(langPairs) : Object"
