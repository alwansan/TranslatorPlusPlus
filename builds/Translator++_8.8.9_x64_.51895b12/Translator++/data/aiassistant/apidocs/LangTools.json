        "examples": [
          "```js\nlangTools.getName(\"ja\");\n// returns \"Japanese\"\n```"
        ],
        "usage": "getName(langObj) : string"
      },
      "isCJK": {
        "signature": "isCJK(langCode) → boolean",
        "description": "Check if a language is CJK (Chinese, Japanese, Korean)",
        "parameters": [
          {
            "name": "langCode",
            "type": "string",
            "description": "The language code",
            "required": true
          }
        ],
        "returns": {
          "type": "boolean",
          "description": "True if the language is CJK, false otherwise"
        },
        "examples": [],
        "usage": "isCJK(langCode) : boolean"
