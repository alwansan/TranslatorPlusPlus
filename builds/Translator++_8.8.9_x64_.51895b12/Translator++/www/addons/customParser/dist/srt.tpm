{"files":[{"pattern":"*.srt","rules":[{"type":"regex","pattern":"/\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --> \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g","captureGroups":"1"}],"options":{"writeEncoding":""},"toGrid":"","beforeWrite":"text = text.replaceAll(\"\\r\", \"\");\nreturn text;","fromGrid":"let thisText = text.trimEnd();\nreturn thisText+\"\\r\\n\""}],"modelInfo":{"name":"SRT Subtitle Parser","version":"0.1","author":"Dreamsavior","contact":"","info":"<p>TPM script for parsing SRT subtitle files.</p><p>Extracts subtitle text blocks while preserving timing and numbering during write-back.</p>"},"options":{"testData":""}}