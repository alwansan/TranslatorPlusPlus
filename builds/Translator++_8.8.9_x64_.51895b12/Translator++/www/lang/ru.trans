70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","Вы можете просмотреть более подробную информацию в консоли (F12)"],["Close","Закрыть"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","Вы можете просмотреть более подробную информацию в консоли (F12)"],["Close","Закрыть"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.parts.js":{"data":[["Form","Форма"],["Cancel","Отмена"],["Ok","Хорошо"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":true,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","Удалить заметку"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/login.html":{"data":[["working","в работе"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":true,"indexIds":{"working":0},"tags":[],"parameters":[]},"/note.html":{"data":[["Remove note","Удалить заметку"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/options.html":{"data":[["Click to login","Нажмите для входа"],["Translator &amp; Language","Переводчик &amp; Язык"],["Proofreader","Корректор"],["Assistant","Ассистент"],["General","Общие"],["Preferences","Настройки"],["Add-ons","Дополнения"],["About","О программе"],["User Information","Информация о пользователе"],["Login to your Patreon account to get access to the latest features and updates.","Войдите в свой аккаунт Patreon, чтобы получить доступ к последним функциям и обновлениям."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> Войти"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> Войти через браузер"],["Welcome,","Добро пожаловать,"],["Name","Имя"],["Email","Email"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Уровень <div class=\"infoHeadNote\">(Текущая подписка в центах США)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Очки <div class=\"infoHeadNote\">(Общая пожизненная подписка в центах США)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","Статус оплаты <div class=\"infoHeadNote\">(Текущий статус платежа)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Не паникуйте!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>И, пожалуйста, прочтите следующую информацию.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Этот флаг указывает, что Patreon ещё не получил успешно средства за ваше пожертвование. Это нормально, что платёжная система может испытывать задержки. В зависимости от вашего способа оплаты и страны происхождения, задержки могут длиться до 24 часов.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">В течение этой задержки вы можете увидеть списание с вашей кредитной карты. Не волнуйтесь—Patreon будет периодически проверять, получили ли они ваш платёж. Обычно это решается в течение 24 часов.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Если проблема сохраняется дольше этого срока, пожалуйста, напишите в теме <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> на сервере Translator++ в Discord. Я помогу вам, насколько это возможно.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Пожалуйста, поймите, что для предотвращения мошенничества <b><span class=\"userInfoPoints\">очки</span> и <span class=\"userInfoLevel\">Уровень</span> не будут засчитаны, пока ваш платёж не будет успешно получен Patreon</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">Не паникуйте!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","Этот флаг указывает, что Patreon ещё не получил успешно средства за ваше пожертвование. Это нормально, что платёжная система может испытывать задержки. В зависимости от вашего способа оплаты и страны происхождения, задержки могут длиться до 24 часов."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","В течение этой задержки вы можете увидеть списание с вашей кредитной карты. Не волнуйтесь — Patreon будет периодически повторять попытки проверить, получен ли ваш платёж. Обычно это решается в течение 24 часов."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","Если проблема сохраняется дольше этого срока, пожалуйста, напишите в теме <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> на сервере Translator++ в Discord. Я помогу вам, насколько это возможно."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","Пожалуйста, учтите, что для предотвращения мошенничества <b><span class=\"userInfoPoints\">очки</span> и <span class=\"userInfoLevel\">уровень</span> не будут засчитаны, пока Patreon не получит ваш платёж успешно</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> Выйти"],["Primary Translator","Основной переводчик"],["Default Translator Engine","Движок переводчика по умолчанию"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tЭтот движок переводчика будет использоваться, когда вы нажмете кнопку <span class=\"keyboardHint\">Ctrl+g</span> в выбранной ячейке (ячейках), чтобы <strong>c</strong>генерировать перевод в выбранной ячейке.\n\t\t\t\t"],["Default Language","Язык по умолчанию"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\tЯзыковые настройки по умолчанию для всех проектов!<br>\n\t\t\t\tНастройки в свойствах проекта будут переопределять это значение.\n\t\t\t"],["Default Source Language","Язык источника по умолчанию"],["Default Target Language","Язык перевода по умолчанию"],["Custom escape","Пользовательское исключение"],["Patterns","Шаблоны"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tВсе слова, соответствующие шаблону ниже, не будут переведены машинными переводчиками. \n\t\t\t\t\t\tЭтот раздел подходит для скрытия тегов и скриптов от движков перевода. <br>\n\t\t\t\t\t\tКаждая запись — это допустимое регулярное выражение, функция или literal string на JavaScript, разделённые <b>запятой</b>.<br>\n\t\t\t\t\t\tПользовательское исключение работает только для поддерживаемых <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">алгоритмов исключения</a>.\n\t\t\t\t\t\t<b>Подсказка:</b> Вы также можете попросить ChatGPT сгенерировать регулярное выражение. <br>\n\t\t\t\t\t\tПожалуйста, укажите шаблон регулярного выражения вместе с его модификатором.<br>\n\t\t\t\t\t\tНапример:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","Тестер"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tВставьте ваш текст здесь, чтобы проверить шаблон.\n\t\t\t\t\t\tВсе совпадающие шаблоны будут выделены.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>В разработке</h2>\n\t\t\t\t<p>Эта область будет местом для настройки параметров и опций автоматического корректора.</p>\n\t\t\t"],["AI Assistant","ИИ-ассистент"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Привет! Я MIRAI, ваш ИИ-ассистент для Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Просто нажмите на мою иконку <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> в главном меню, чтобы пообщаться со мной. Я могу помочь вам с:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Улучшением и предложениями по переводу</li>\n\t\t\t\t\t\t\t<li>Корректурой и проверкой качества</li>\n\t\t\t\t\t\t\t<li>Настройкой рабочего процесса перевода</li>\n\t\t\t\t\t\t\t<li>Созданием скриптов автоматизации</li>\n\t\t\t\t\t\t\t<li>И многим другим!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Давайте сделаем вашу переводческую работу проще и эффективнее вместе!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>P.S. Я ещё новичок, так что, пожалуйста, будьте терпеливы со мной.🙇‍♀️ Но я учусь и улучшаюсь каждый день!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","Настройка ИИ"],["Model Endpoint","Конечная точка модели"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","URL конечной точки API для вашей ИИ-модели. Например: https://api.openai.com/v1/chat/completions"],["API Key","Ключ API"],["Your API key for authenticating with the AI service. This will be stored securely.","Ваш ключ API для аутентификации в ИИ-сервисе. Он будет храниться безопасно."],["Model Name","Название модели"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","Выберите или введите ИИ-модель для использования. Рекомендуются модели с поддержкой инструментов для лучших результатов."],["File Association","Файловая ассоциация"],["Extension","Расширение"],["Associate","Ассоциация"],["Set All","Установить все"],["Unset All","Сбросить Все"],["Apply","Применить"],["Update","Обновление"],["Auto update","Автоматическое обновление"],["Automatically update Translator++ if possible.","Автоматическое обновление Переводчика++, если доступно."],["Allow reinstall the same version","Разрешить переустановку той же версии"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Разрешение Переводчику++ переустановить ту же версию, которая уже была установлена. Пожалуйста, отключите эту опцию после установки обновления, особенно если включена настройка <b>Автоматическое обновление</b>. В противном случае ваш переводчик++ будет обновляться каждый раз, когда вы открываете программу."],["Use default browser to login","Используйте браузер по умолчанию для входа в систему"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","Используйте браузер по умолчанию вашей доверенной системы для входа в аккаунт Patreon. Если этот параметр не отмечен, будет использоваться встроенный браузер Translator++."],["Multi threading","Многопоточность"],["Number of thread","Количество потоков"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","Количество дочерних процессов, открываемых одновременно.<br>\n\t\t\t\t\t\t\t0 = отключить многопоточность. Все процессы будут выполняться процессом рендеринга.<br>\n\t\t\t\t\t\t\tОптимальное количество обычно равно числу физических ядер - 1.\n\t\t\t\t\t\t"],["Backup","Резервное копирование"],["Enable backup","Включить резервное копирование"],["Automatically create backup every time you save your project.","Автоматически создавать резервную копию каждый раз при сохранении проекта."],["Backup level history","История уровней резервного копирования"],["How many history of backup do you want to keep?","Сколько версий резервных копий вы хотите сохранить?"],["Log &amp; Debugging","Логи и отладка"],["Log to file","Записывать логи в файл"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","Записывать логи в файл вместо окна консоли по умолчанию.<br>Это полезно, если вы хотите отлаживать Translator++ и у вас нет доступа к окну консоли. Включение этой опции слегка повлияет на производительность. Поэтому рекомендуется держать эту опцию выключенной, кроме случаев отладки или сообщения о проблемах.<br>Логи сохраняются в папке data/logs/."],["Truncate log file each session","Обрезать файл лога при каждом сеансе"],["When checked your log file will be truncated each time you re open the application.","При включении файл лога будет обрезаться каждый раз при повторном открытии приложения."],["Application Settings","Настройки приложения"],["Enable remote debugging","Включить удаленную отладку"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","Включает протокол удаленной отладки Chrome DevTools на порту 9222. Это позволяет инспектировать и отлаживать Translator++ с помощью внешнего браузера, перейдя на <code>chrome://inspect</code>. Этот флаг добавляет <code>--remote-debugging-port=9222</code> к аргументам запуска приложения. Для применения изменений требуется перезапуск."],["Disable GPU","Отключить GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","Отключает аппаратное ускорение GPU. Это полезно, если вы сталкиваетесь с визуальными глюками, сбоями или проблемами рендеринга на определенном графическом оборудовании или драйверах. Этот флаг добавляет <code>--disable-gpu</code> к аргументам запуска приложения. Для применения изменений требуется перезапуск."],["Dangerous Area","Опасная зона"],["Interface Language","Язык интерфейса"],["UI Language","Язык интерфейса"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","Установите язык пользовательского интерфейса. Вы можете создать свою собственную локализацию, если Translator++ не доступен на вашем языке. Данные языка находятся в папке www/lang."],["Spell checker Language","Язык проверки орфографии"],["Set the default spell checker language.","Установите язык проверки орфографии по умолчанию."],["Environment Variables","Переменные среды"],["Staging Directory","Постановочный каталог"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","Постановочный каталог - это кэш проектов, над которыми ведется работа. Часть данных из исходных материалов копируется в этот каталог, чтобы получить доступ к скриптам интерпретатора."],["Project creation","Создание проекта"],["Auto Load Common Reference","Автоматическая загрузка Общая ссылка"],["Auto load common reference from .trans file.","Автоматическая загрузка общей ссылки из файла .trans."],["Project settings","Настройки проекта"],["Progress Column Indices","Индексы столбцов прогресса"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","Здесь вы можете указать, какие столбцы будут включены в расчет прогресса проекта.\n\t\t\t\t\t\t\t<br>Индекс столбца — это целое число, начинающееся с нуля, где самый левый столбец равен 0.\n\t\t\t\t\t\t\t<br>Используйте запятые для указания нескольких столбцов. Например: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>По умолчанию: Пусто</b>. Если оставить пустым, Translator++ будет рассчитывать прогресс по всем доступным столбцам.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>Включить/Выключить"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>Установить"],["Install from a package","Установить из пакета"],["Visit our website &amp; documentation : ","Посетите наш сайт &amp; документация : "],["Fork Translator++ at : ","Форк Translator++ на : "],["Support Translator++ at : ","Поддержка Переводчика++ на :"],["Join our discord channel at : ","Присоединяйтесь к нашему каналу Discord по адресу : "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) Если вы патрон, вам следует <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">привязать свою учетную запись Discord в профиле Patreon</a>. Вы будете приглашены автоматически, и для вас есть преимущества!"],["Version Info","Информация о версии"],["Last checked at : ","Последняя проверка :"],["Check now!","Проверить сейчас!"],["You have a pending update","У вас есть ожидаемое обновление"],["Update now","Обновить сейчас"],["Your Translator++ is up to date 😃.","Ваш Переводчик++ в актуальном состоянии 😃."],["Architecture","Архитектура"],["License","Лицензия"],["Click here to read the license.","Нажмите здесь, чтобы ознакомиться с лицензией."],["Credits","Титры"],["Localization","Локализация"],["About Third Party Software","О стороннем программном обеспечении"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tЭто программное обеспечение использует стороннее программное обеспечение, расположенное по адресу /3rdParty. Эти сторонние программы имеют свои собственные лицензии и\nвключены исключительно для удобства использования и\nпредоставляются как есть, без каких-либо гарантий, явных или подразумеваемых, и такое программное обеспечение должно использоваться на ваш собственный риск."],["Special Thanks","Особая Благодарность"],["Want to explicitly support Translator++ by putting your name on this section?","Хотите явно поддержать Translator++, прописав ваше имя в этом разделе?"],["Click here to learn more about how to do that!","Нажмите здесь, чтобы узнать больше о том, как это сделать!"],["Changelog","Блок изменений"],["Feeds","Новостные ленты"],["Click connect button, to connect translator with Translator++ table","Нажмите кнопку подключения, чтобы соединить переводчика с таблицей Translator++."],["working","в работе"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Уровень Patreon/Ваш текущий взнос в этом месяце в центах (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","Очки/Ваш пожизненный взнос+бонусы в центах (1 USD = 100 pts)"],["Filter...","Фильтр..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":true,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"parameters":[]},"/scriptEditor.html":{"data":[["Run","Запустить"],["New Project (ctrl+n)","Новый проект (ctrl+n)"],["Open (ctrl+o)","Открыть (ctrl+o)"],["Save file (ctrl+s)","Сохранить файл (ctrl+s)"],["Save As (ctrl+shift+s)","Сохранить как (ctrl+shift+s)"],["Open debugger (F12)","Открыть отладчик (F12)"],["Help","Помощь"],["Select file in the current workspace","Выбрать файл в текущей рабочей области"],["file path","путь к файлу"],["Create shortcut of the current script","Создать ярлык текущего скрипта"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":true,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"parameters":[]},"/tableEditor.html":{"data":[["Reset","Сброс"],["Clear","Очистить"],["Search","Поиск"],["Help","Помощь"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":true,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"parameters":[]},"/trans.html":{"data":[["Start","Начать"],["Home","Главная"],["Translator","Переводчик"],["Objects","Объекты"],["Live translation","Живой перевод"],["Original","Оригинал"],["Raw","Исходник"],["Row Properties","Свойства строки"],["Default translation","Перевод по умолчанию"],["Context translation","Контекстный перевод"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\tПуть <a class=\"problemPath\"></a> недоступен для интерпретатора PHP.<br>\n\t\tПожалуйста, переименуйте путь и используйте только буквенно-цифровые имена."],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>Местоположение</span>"],["File :","Файл :"],["Row ID :","ID строки:"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>Контекст</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>Актёры</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>Ключевой текст</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>Лучший перевод</span>"],["File ID","Идентификатор файла"],["Path","Путь"],["Original Format","Исходный формат"],["Data Length","Длина данных"],["Translated","Переведено"],["General","Общие"],["Language","Язык"],["Staging","Размещение"],["Stats","Статистика"],["Advanced","Расширенные"],["Info","Инфо"],["Title","Название"],["File Location","Местоположение файла"],["Project ID","ID проекта"],["Built on","Построен на"],["Editor Name","Название редактора"],["Editor Version","Версия редактора"],["Engine","Движок"],["Parser","Парсер"],["Parser version","Версия парсера"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","Местоположение исходного материала <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Местоположение исходного материала. Не следует изменять что-либо внутри этой папки.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Неверный путь.<br>Некоторые функции будут отключены до исправления."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","Расположение переведённого материала <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Местонахождение игры, которая была переведена. Стандартное расположение для внедрения перевода.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","Переводчик <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Предпочтительный переводчик для этого проекта. Если не указан, будут использованы глобальные настройки.\"></i>"],["Translate From","Перевести с"],["Translate Into","Перевести на"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","Путь промежуточного хранения <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Путь промежуточного хранения — это местоположение некоторых файлов, необходимых для экспорта/сборки переводов. Файлы промежуточного хранения создаются при создании проекта.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","Объекты <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Количество объектов/файлов, доступных на левой панели\"></i>"],["Folders","Папки"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","Символы <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Количество символов в столбце Исходный текст\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","Слова <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Может отображать неверное значение для языков, не использующих пробелы (например, японский, китайский).\"></i>"],["Total Rows","Всего строк"],["Translated row","Переведённая строка"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Органический перевод <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Пользователи заполняли напрямую в сетке. Это хороший признак. Может быть человеческим переводом, отредактированным MTL и т.д.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","Общий прогресс <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","После экспорта <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Запустить функцию JavaScript после успешного экспорта этого проекта.\"></i>"],["Display this information when the project is opened.","Отображение этой информации при открытии проекта."],["Select Export Mode","Выберите режим экспорта"],["Export to a folder","Экспорт в папку"],["Export pre-compiled game data to a folder<br>Folder structures are retained","Экспорт предварительно скомпилированных игровых данных в папку<br>Структуры папок сохраняются"],["Export as a Zip file","Экспорт как Zip-файл"],["Export pre-compiled game data to a single zipped archive","Экспорт предварительно скомпилированных данных игры в один заархивированный архив."],["RPGMakerTrans Patch Files","RPGMakerTrans патч-файлы"],["Export to RPGMakerTrans formatted *.txt files in a folder","Экспорт в RPGMakerTrans отформатированных *.txt файлов в папку"],["Comma Separated Values","Значения, разделенные запятыми"],["Export to Comma Separated Values (csv) files in a folder","Экспорт в файлы с разделенными запятыми значениями (csv) в папку"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 и выше"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","Экспорт в файлы электронной таблицы Microsoft Excel (xlsx) в папку"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 and above"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","Экспорт в файлы электронной таблицы Microsoft Excel (xls) в папку"],["HTML Spreadsheet","Электронная таблица HTML"],["Export to HTML files in a folder","Экспорт в HTML файлы в папку"],["Open Document Format/OASIS (.ods)","Открытый формат документа/OASIS (.ods)"],["Export to ODS files in a folder","Экспорт в ODS файлы в папку"],["Select Import Mode","Выберите Режим импорта"],["Import translation from another .trans file","Импортировать перевод из другого файла .trans"],["Open another Translator++ file<br>Apply translation into current project.","Откройте другой файл Переводчика++<br>Применить перевод в текущем проекте."],["Import translation from spreadsheets","Импорт перевода из электронных таблиц"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","Импорт перевода из различных файлов электронных таблиц<br>(.xls, .xlsx, .ods, .html, .xml, etc)"],["Import translation from RPGMakerTrans Patch format","Импорт перевода из формата патча RPGMakerTrans"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","Импорт перевода из патч-файлов RPGMaker Trans<br>(.txt)"],["Source :","Источник :"],["Select objects to import","Выберите объекты для импорта"],["Import mode :","Режим импорта :"],["Import translations","Импорт переводов"],["Import data object","Импорт объекта данных"],["Destination :","Назначения :"],["Currently selected : ","В настоящее время выбрано :"],["Options :","Опции :"],["Import the context translations","Импортировать контекстные переводы"],["Case insensitive","Без учёта регистра"],["Overwrite target","Перезаписать цель"],["Destination column : ","Колонка назначения :"],["Translation mode :","Режим перевода:"],["Row by row translation","Перевод построчно"],["Line by line translation","Перевод с одной строки на другую"],["Select translation by context address","Выбрать перевод по адресу контекста"],["Just copy translation into the same row (No checking)","Просто скопировать перевод в ту же строку (без проверки)"],["Merge data","Слияние данных"],["Import translation from spreadsheet into project","Импорт перевода из электронной таблицы в проект"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","Импортировать перевод из любого формата таблиц (xls, xlsx, odx, html, csv и т.д.)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>Таблица должна содержать как минимум 2 столбца.</b> Самый важный столбец — первый (крайний слева), содержащий исходные тексты. Следующие столбцы содержат переводы. Translator++ будет использовать текст в самой правой ячейке, которая не пуста."],["Please click the radio button to select files/folder to import","Пожалуйста, установите переключатель, чтобы выбрать файлы/папки для импорта"],["Import file(s)","Импортировать файл(ы)"],["Import folder","Импортировать папку"],["Import translation from RPG Maker Trans into project","Импорт перевода из RPG Maker Trans в проект"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\">Выберите тип проекта</span>"],["Select project type","Выберите тип проекта"],["Spreadsheet","Электронная таблица"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","Начать проект перевода из данных таблицы (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","Пустой проект"],["Create a new .trans file from scratch.","Создайте новый файл .trans с нуля."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\">Электронная таблица</span>"],["Fetch type","Тип выборки"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","Первые столбцы — переводимый текст, остальные столбцы — предопределённые переводы (Создать сетку данных, соответствующую исходной таблице)"],["All columns are translatable text","Все столбцы — переводимый текст"],["Custom","Пользовательский"],["Custom Options","Пользовательские настройки"],["Which column do you want to fetch?","Какой столбец вы хотите извлечь?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","Пожалуйста, укажите, какой столбец вы хотите извлечь и в какой столбец поместить перевод. <b>Индексация начинается с 0 (первый столбец — 0)</b>."],["Column to be translated","Столбец для перевода"],["Column to put translation into","Столбец для размещения перевода"],["Action","Действие"],["Enable Row Header Text Column","Включить столбец текста заголовка строки"],["If enabled, the parser will process the following Row Header Text Column rule","Если включено, парсер будет обрабатывать следующее правило столбца текста заголовка строки"],["Row Header Text Column","Столбец текста заголовка строки"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","Если указан, значение в этом столбце будет применено к заголовку строки. Это полезно для определения текущего говорящего или актёра и т.д. Индексация начинается с нуля."],["Options","Параметры"],["Calculate cell value","Вычислить значение ячейки"],["Cell value in the form of formula will be transpiled","Значение ячейки в виде формулы будет преобразовано"],["Get formatted value","Получить форматированное значение"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","Обработать значения ячеек после форматирования. (Например, целое число 100000 в определённом регионе станет USD 100,000)"],["Parse CSV in EXCEL format","Парсить CSV в формате EXCEL"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","Принудительно парсить CSV в стиле MS EXCEL. (только для CSV файлов)"],["Skip the first <i>n</i> row(s)","Пропустить первые <i>n</i> строк(и)"],["Use this option if you want to skip the row header.","Используйте эту опцию, если хотите пропустить заголовок строки."],["Select File(s)","Выбрать файл(ы)"],["Select a directory","Выбрать директорию"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\">Создайте новый файл Trans</span>"],["Create a new Trans file","Создайте новый файл Trans"],["The title of this project","Название этого проекта"],["Engine type","Тип движка"],["Type of the engine","Тип движка"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\">Место для чего-то великого в ближайшем будущем!</span>"],["Placeholder for something great at the near future!","Место для чего-то великого в ближайшем будущем!"],["This module will be created when the patron count reach 500!","Этот модуль будет создан, когда количество патронов достигнет 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tОдноименный проект <br>\"<span class=\"dialogGameTitle\"></span>\"<br> уже существует в кэше после обработки.<br>\n\t\tВы можете повторно использовать этот кэш для значительного сокращения времени загрузки.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","Если вы запутались, вы всегда можете смело нажимать кнопку <strong><a href=\"#\">\"Создать новый проект\"</a></strong>. "],["Existed cache","Существующий кэш"],["Select Translator","Выберите Переводчик"],["Source column","Столбец источника"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","Какой столбец содержит исходный текст для перевода?<br>(по умолчанию — ключевой столбец / крайний левый столбец)."],["Target column","Целевая колонка"],["Which column is the translated text put into.<br>(Can not same with source column)","В какой столбец помещается переведённый текст.<br>(Не может совпадать со столбцом источника)"],["Translator's Options","Настройки переводчика"],["Also try to translate other object","Также попробуйте перевести другой объект"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","Если эта опция установлена, то Translator++ будет пытаться перевести и другие объекты, которые вы не выбрали и которые не требуют машинного перевода. Это поведение по умолчанию в Translator++ версии 2.3.23 или ниже."],["Ignore if already translated","Игнорировать, если уже переведено"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Если эта опция отмечена, Translator++ будет игнорировать любые строки, в которых уже есть переводы в их столбце."],["Overwrite cells","Перезаписать ячейки"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","Перезаписать целевые ячейки. Если не отмечено, ячейки не будут затронуты, если они не пусты."],["Save project on each batch.","Сохранять проект после каждой партии."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","Сохраняйте ваш проект после завершения каждой партии.<br>Эта опция помогает избежать потери данных при сбое приложения из-за выполнения тяжёлых задач из локального переводчика. Вероятно, вам это не нужно, если вы используете облачный переводчик."],["Play sound when completed.","Воспроизводить звук при завершении."],["Tags","Теги"],["Select Context(s)","Выбрать контекст(ы)"],["Manual Query","Запрос вручную"],["Match all words","Сопоставьте все слова"],["Remove selected","Удалить выбранное"],["Remove all but selected","Удалить всё, кроме выбранного"],["Select Context","Выберите Контекст"],["Source Column","Исходная колонка"],["Target Column","Целевая колонка"],["Maximum length","Максимальная длина"],["Export into","Экспортировать в"],["What to do with tagged rows?","Что делать с помеченными строками?"],["Select Color Tag","Выберите цветной тег"],["On the fly word wrap","Перенос строк на лету"],["Inject all files (ignoring selection)","Внедрить все файлы (игнорируя выбор)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","Вы собираетесь внедрить перевод с помощью кнопки <b>Внедрить все</b>. Это внедрит перевод независимо от выбранного объекта на левой панели. Используйте контекстное меню левой панели, если хотите внедрить выбранный объект."],["Select the source material to be translated","Выберите исходный материал для перевода"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tВыберите конкретный материал или контент, который вы хотите перевести, например, файл, каталог или другой соответствующий ввод. Убедитесь, что выбранный материал доступен и правильно отформатирован для соответствующего парсера.<br>\n\t\t\t\tПо умолчанию некоторые парсеры используют промежуточный каталог в качестве исходного материала.\n\t\t\t"],["Path is inaccessible.","Путь недоступен."],["Target Directory","Целевой каталог"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tВ этой папке будет сгенерирована копия Вашего переведенного приложения.\n\t\t\t"],["Field can not be empty!","Поле не может быть пустым!"],["Target to apply translation","Цель для применения перевода"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tПожалуйста, выберите исполняемый файл.\n\t\t\t"],["Copy materials","Копировать материалы"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","Опции копирования из Исходного материала в Целевой каталог. (экспериментальные, поддерживаются не все движки)"],["Word Wrap by Tags","Перенос строк по тегам"],["Directory name","Название каталога"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tОбъект будет сгруппирован в этом каталоге.<br>\n\t\t\t\tВведите звездочку \"<code>*</code>\" для добавления нового <b>ссылочного объекта</b>.\n\t\t\t"],["Invalid directory  name","Недопустимое имя каталога"],["Object name","Имя объекта"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tИмя объекта."],["Invalid object name","Недопустимое имя объекта"],["New Project","Новый проект"],["Save","Сохранить"],["Save as...","Сохранить как..."],["Open...","Открыть..."],["Recent","Недавние"],["None...","Ничего..."],["Export Project","Экспорт проекта"],["To a folder","В папку"],["As a zip file","В виде zip-файла"],["To portable .tpp file","В портативный .tpp-файл"],["To RPGMakerTrans file (*.txt)","В файл RPGMakerTrans (*.txt)"],["To CSV file","В CSV-файл"],["To XLSX file","В файл XLSX"],["To XLS file","В XLS файл"],["To ODS file","В ОDS-файл"],["To HTML file","В HTML-файл"],["Import","Импорт"],["Project from .tpp file","Проект из файла .tpp"],["Translation from .trans file","Перевод из файла .trans"],["Translation Spreadsheet","Перевод из Электронной таблицы"],["Translation RPGMKTRANSPATCH Format","Перевод Формат RPGMKTRANSPATCH"],["Automation","Автоматизация"],["Batch translation","Пакетный перевод"],["Context tool","Инструмент контекста"],["Batch word wrapping","Пакетная упаковка слов"],["Trim","Trim"],["Auto padding","Автозаполнение"],["Tools","Инструменты"],["Third Party Application Installer","Сторонний Установщик Приложений"],["Close project","Закрыть проект"],["Exit","Выход"],["Start here","Начните здесь"],["Start a New Project","Начните новый проект"],["Continue your work","Продолжите свою работу"],["Open Project","Открыть проект"],["Your recent translation","Ваш недавний перевод"],["Tips for you","Советы для вас"],["Next tip! <span class=\"icon-angle-double-right\"></span>","Следующий совет! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","Крайняя правая ячейка в строке получит приоритет."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","Вы не можете поделиться своим проектом с другими, используя только файл перевода. Вам нужно сгенерировать файл TPP."],["Always make backups of your trans files.","Всегда создавайте резервные копии ваших файлов перевода."],["You can rename and reorder the column with the coulumn header's context menu.","Вы можете переименовать и изменить порядок столбцов с помощью контекстного меню заголовка столбца."],["Always backup your game before working with Translator++!","Всегда создавайте резервную копию вашей игры перед работой с Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","Если вы столкнулись с функцией, которая работает некорректно, попробуйте перезапустить Translator++ — в большинстве случаев это решит проблему."],["Always create a backup of your game before patching with a translation.","Всегда создавайте резервную копию вашей игры перед применением перевода."],["Thank you for supporting Translator++.","Спасибо за поддержку Translator++."],["Please check Translator++'s online documentation at","Пожалуйста, проверьте онлайн-документацию Translator++ на"],["working","в работе"],["Open","Открыть"],["Save file","Сохранить файл"],["Save As","Сохранить Как"],["Import Project","Импорт Проекта"],["Inject / apply all translation","Внедрить / применить весь перевод"],["Execute Global Level Custom Script","Выполнить глобальный пользовательский скрипт"],["Toggle Active Cell Info","Переключение Информации об активной ячейке"],["Project Properties","Свойства проекта"],["Get Help (F1)","Получить помощь (F1)"],["Batch translation (crl+b)","Пакетный перевод (ctrl+b)"],["File list","Список файлов"],["Live Translation Pane","Панель живого перевода"],["Toggle selection","Переключение выбора"],["Invert selection","Инвертировать выбор"],["Add A New Object","Добавление Нового Объекта"],["Connect to auto translator","Подключение к автопереводчику"],["Undock pane","Разблокировка парнели"],["Collapse / restore left panel","Свернуть / восстановить левую панель"],["Add new key (alt+n)","Добавить новый ключ (alt+n)"],["Import Here","Импорт сюда"],["Add a note to this file","Добавить примечание к этому файлу"],["Open search menu","Открыть меню поиска"],["Toggle grid information","Переключить информацию о сетке"],["Object Properties","Свойства объекта"],["Automatically set selected original text to clipboard","Автоматически копировать выбранный исходный текст в буфер обмена"],["Resize Font","Изменить размер шрифта"],["Toggle word wrapping & Explicit white spaces","Переключение переноса слов и явных пробелов"],["Use Monospace font","Используйте моноширинный шрифт"],["Remove all translation from this file","Удалите все переводы из этого файла"],["Remove this file from project","Удалите этот файл из проекта"],["file path","путь к файлу"],["Quick find","Быстрый поиск"],["Active cell's info","Информация о активной ячейке"],["View original untranslated text","Просмотр оригинального непереведённого текста "],["View raw data","Просмотр исходных данных"],["View row properties","Просмотреть свойства строки"],["Go to current cell","Перейти к текущей ячейке"],["Current coordinate","Текущие координаты"],["Word wraping (for non Japanese text)","Word wraping (for non Japanese text)"],["Speak original text (alt+,)","Произносит оригинальный текст (alt+,)"],["Copy original text into current cell (ctrl+0)","Скопируйте исходный текст в текущую ячейку (ctrl+0)."],["Default translation for all occurrence","Перевод по умолчанию для всех вхождений"],["Translations by context","Перевод в контексте"],["This cell has a comment","Эта ячейка содержит комментарий"],["This cell has an organic content","Эта ячейка содержит органический контент"],["This cell has been visited","Эта ячейка была посещена"],["This is the first time this cell has been visited","Это первое посещение этой ячейки"],["Word wraping","Word wraping"],["Speak current translation text (alt+.)","Произносит текущий текст перевода (alt+.)"],["Current Cell Editor options","Текущие параметры редактора ячеек"],["Clear context translation for current row","Очистить контекстный перевод для текущей строки"],["Get help about translation by context","Справка о контекстном переводе (онлайн)"],["Open menu","Открыть меню"],["Path not accessible","Путь недоступен"],["The location of the original material. You should not modify anything inside this folder.","Расположение исходного материала. Не следует изменять что-либо внутри этой папки."],["The location of the game that has been translated. The default location of the translation injection.","Расположение переведенной игры. Место по умолчанию для внедрения перевода."],["Prefered translator for this project. If not defined, global setting will be used.","Предпочтительный переводчик для этого проекта. Если не указан, будут использованы глобальные настройки."],["-use default-","-использовать по умолчанию-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","Промежуточный путь — это расположение некоторых файлов, необходимых для экспорта/сборки переводов. Промежуточные файлы создаются при создании проекта."],["Number of objects/files available on the left pane","Количество объектов/файлов, доступных на левой панели"],["Number of characters in the Original Text column","Количество символов в столбце исходного текста"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","Может отображать неверное значение в языках, не использующих пробелы (например, японский, китайский)."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","Пользователи заполняли напрямую в сетке. Это хороший знак. Может быть человеческим переводом, отредактированным MTL и т.д."],["Run a javascript function after this project is successfully exported.","Запустить функцию javascript после успешного экспорта этого проекта."],["Import .TRANS into project","Импорт .TRANS в проект"],["Import Spreadsheet Options","Параметры импорта электронных таблиц"],["Import RPGMTransPatch Options","Параметры импорта RPGMTransPatch"],["Start a new project","Начните новый проект"],["Search project type...","Поиск типа проекта..."],["Remove row","Удалить строку"],["Add row","Добавить строку"],["Project is exist","Проект существует"],["Context Tool","Контекстный инструмент"],["Your list of context separated by new line","Ваш список контекста, разделенный новой строкой"],["Wrap text","Перенос текста"],["Export Options","Параметры экспорта"],["Tagging","Маркировка"],["Apply Translation","Применить Перевод"],["Add new Object","Добавить новый объект"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText","idx/56/innerText"],["idx/29/innerText","idx/152/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText","idx/41/innerText"],["idx/40/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/5