/type/StringLiteral"],["tid/606300/type/StringLiteral"],["tid/606379/type/StringLiteral"],["tid/606405/type/StringLiteral"],["tid/606526/type/StringLiteral"],["tid/606548/type/StringLiteral"],["tid/606570/type/StringLiteral"],["tid/608417/type/StringLiteral"],["tid/608422/type/StringLiteral"],["tid/621955/type/StringLiteral","tid/629854/type/StringLiteral"],["tid/621975/type/StringLiteral"],["tid/622292/type/StringLiteral"],["tid/622315/type/StringLiteral"],["tid/629235/type/StringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","пользовательские модели.метка"],["model","модель"],["|","|"],["promptLibrary","библиотека подсказок"],["search","поиск"],["downloadChat","скачать чат"],["newChat","новый чат"],["api","API"],["customEndpoint","пользовательская конечная точка"],["apiEndpoint.inputLabel","метка ввода конечной точки API"],["apiKey.inputLabel","метка ввода ключа API"],["apiVersion.inputLabel","метка ввода версии API"],["apiVersion.description","описание версии API"],["securityMessage","сообщениеБезопасности"],["apiEndpoint.description","apiEndpoint.описание"],["apiEndpoint.warn","apiEndpoint.предупреждение"],["partialImportMessages","сообщенияЧастногоИмпорта"],["import","импорт"],["name","имя"],["prompt","подсказка"],["clearPrompts","очиститьПодсказки"],["morePrompts","большеПодсказок"],["toast.sync","уведомление.синхронизация"],["toast.stop","уведомление.остановка"],["button.sync","кнопка.синхронизация"],["button.stop","кнопка.остановка"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Перевести с помощью ChatGPT Batch API"],["Model","Модель"],["The pre-trained model.","Предварительно обученная модель."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Похоже, что OpenAI Batch API использует немного другое соглашение об именовании моделей, чем общепринятый API. Модели, используемые в Batch API, имеют префикс «-batch». Например, если вы используете <code>gpt-4.1-mini</code>, модель автоматически становится <code>gpt-4.1-mini-batch</code>.<br />\nОднако на момент создания этого дополнения пакетные модели не указаны в лимитах использования моделей OpenAI, что делает невозможным использование Batch API, если пользователь установил фильтр использования моделей в «Разрешить» (белый список).<br />\nВероятно, это ошибка в интерфейсе OpenAI, которая может быть исправлена в будущем.<br />\nПоэтому убедитесь, что установили лимиты использования в OpenAI в режим «Блокировать» (черный список), чтобы использовать Batch API.<br />\nНажмите здесь, чтобы изменить лимиты использования модели: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Исходная колонка"],["The column of the original texts you want to translate.","Столбец исходных текстов, которые вы хотите перевести."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавить имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Ignore if already translated","Игнорировать, если уже переведено"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Если эта опция отмечена, Translator++ будет игнорировать любую строку, которая уже имеет переводы в своей колонке."],["Load Actor Reference as Glossary","Загрузить ссылку на актера как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит ссылку на актера как глоссарий. Это поможет переводчику понять контекст диалога. Ссылка на актера — это имя актера в диалоге. Она будет загружена как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, присутствующие в диалоге, будут загружены как глоссарий для каждого элемента партии. Используйте команду шаблона, чтобы загрузить ссылку на актера в сообщении-подсказке."],["Actor Reference Translation Column","Колонка перевода ссылки на актера"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Колонка перевода имени актера. Эта колонка будет использоваться как перевод ссылки на актера. Это улучшит согласованность перевода имени актера в диалоге."],["Actor's Information Column","Колонка информации об актере"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Колонка, содержащая дополнительную информацию об актере. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в диалоге."],["System Message Template","Шаблон системного сообщения"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Системное сообщение — это заголовок сообщения, который указывает, какую роль играет ваш помощник ChatGPT. Это сообщение будет отправлено самым первым в каждой партии, которую вы отправляете в ChatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Вы можете включить следующие переменные в стиле шаблонных литералов JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Переменные:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Исходный язык</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Целевой язык</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Полное название исходного языка</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Полное название целевого языка</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Исходный текст</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Предопределенное сообщение алгоритма экранирования.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Строка, представляющая новую строку (замена строки).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Количество сообщений в партии.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Добавьте информацию об актерах.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример: <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Включить несколько предыдущих строк в качестве контекста</li>"],["Body Message Template","Шаблон тела сообщения"],["Template of the body of your chat.","Шаблон тела вашего чата."],["Sample conversation","Пример диалога"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","Пакетный API ChatGPT позволяет переводить ваш проект асинхронно со скидкой 50%, что означает, что вы получите результаты перевода <b style=\"color:red\">в течение 24 часов</b> по <b style=\"color:red\">половине обычной стоимости</b>. Это особенно полезно для крупных проектов, не требующих немедленных результатов перевода."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Подробнее о пакетном API ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Общие настройки"],["This form is using your existing ChatGPT configuration.<br>","Эта форма использует вашу существующую конфигурацию ChatGPT.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Вы можете изменить конфигурацию, перейдя в настройки переводчика ChatGPT в окне опций.<br>"],["There you can set the API key, model, and other settings.<br />","Там вы можете установить API-ключ, модель и другие параметры.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Открыть настройки ChatGPT\" />"],["Append actor name to the translatable text","Добавить имя актера к переводимому тексту"],["Ignore translated rows","Игнорировать переведенные строки"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в подсказку. Глоссарий будет загружаться для каждой партии элементов, чтобы улучшить качество перевода. Функция попытается загрузить только соответствующие термины, чтобы избежать перегрузки вашей подсказки.</p>"],["The Column of Actor's Additional Information","Колонка дополнительной информации об актёре"],["Prompt Template","Шаблон промпта"],["<h2>1. System Message</h2>","<h2>1. Системное сообщение</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Здесь вы можете объяснить ассистенту, какова его роль.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Ваш фактический промпт</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Это фактический промпт для ассистента.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Накладные расходы</h3>\n                        Накладные расходы — это стоимость промпт-сообщения, которое вы отправляете ассистенту без фактических текстов для перевода. Стоимость рассчитывается на основе количества токенов в промпт-сообщении. Чем больше токенов, тем выше будет стоимость.<br>\n                        <b>Текущие накладные расходы:</b> <span class=\"overheadCost\">0</span> токенов / запрос."],["Are you sure you want to reset the form?","Вы уверены, что хотите сбросить форму?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Вы уверены, что хотите обработать пакет?\nЗа эту операцию будут взиматься расходы."],["The batch is successfully created. Do you want to open the batch manager?","Пакет успешно создан. Хотите открыть менеджер пакетов?"],["OpenAI Batch API Queue","Очередь OpenAI Batch API"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>ССЫЛКА[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>ССЫЛКА[Общая ссылка]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Пожалуйста, выберите строки для применения перевода"],["Target Column","Целевая колонка"],["The column to put the translation result.","Столбец для размещения результата перевода."],["Import translation from ChatGPT Batch","Импорт перевода из ChatGPT Batch"],["Translation applied to selected rows","Перевод применён к выбранным строкам"],["Invalid format","Неверный формат"],["OK","OK"],["Mismatch","Несоответствие"],["Failed to load batch list with error: \n","Не удалось загрузить список партий с ошибкой: \n"],["Download Error File","Скачать файл ошибок"],["Batch is not completed yet","Партия ещё не завершена"],["Are you sure you want to cancel this batch?","Вы уверены, что хотите отменить эту партию?"],["Cannot cancel completed batch.","Нельзя отменить завершённую партию."],["Batch cancelled","Партия отменена"],["Failed to cancel batch","Не удалось отменить партию"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","Пакеты"],["Apply translation","Применить перевод"],["Cancel batch","Отменить пакет"],["Status","Статус"],["Batch ID","ID пакета"],["Input File ID","ID входного файла"],["End point","Конечная точка"],["Created at","Создано в"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Истекает в <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Пакеты, не завершённые вовремя, в конечном итоге переходят в состояние истечения; незавершённые запросы в этом пакете отменяются, а ответы на завершённые запросы становятся доступны через выходной файл пакета. С вас будет списана плата за токены, потреблённые в любых завершённых запросах.\"></i>"],["Completed at","Завершено в"],["Errors","Ошибки"],["Batch Item Detail of","Детали элемента пакета"],["ID","ID"],["Completed on","Завершено"],["Model","Модель"],["Prompt Token","Токены промпта"],["Completion Token","Токены завершения"],["Total Token","Всего токенов"],["Status Code","Код статуса"],["error","ошибка"],["Conversation","Диалог"],["Response Validation","Проверка ответа"],["Raw Payload","Необработанные данные"],["View raw payload","Просмотреть необработанные данные"],["Response Preview","Предпросмотр ответа"],["Apply translations from selected rows","Применить переводы из выбранных строк"],["Here you can edit the translation result individually and send it into Translator++","Здесь вы можете редактировать результат перевода индивидуально и отправить его в Translator++"],["Open ChatGPT Settings","Открыть настройки ChatGPT"],["Help","Справка"],["File list","Список файлов"],["Collapse / restore left panel","Свернуть / восстановить левую панель"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Пакеты, которые не завершаются вовремя, в конечном итоге переходят в состояние истечения срока; незавершенные запросы в этом пакете отменяются, а ответы на завершенные запросы становятся доступными через выходной файл пакета. Вы будете платить за токены, потребленные в любых завершенных запросах."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","OpenAI Чат"],["Target URL","Целевой URL"],["Target end point. You can use any service that supports OpenAI API.","Конечная точка цели. Вы можете использовать любой сервис, поддерживающий OpenAI API."],["Sample endpoints","Примеры конечных точек"],["Use this endpoint","Используйте эту конечную точку"],["Copy to clipboard","Копировать в буфер обмена"],["e.g.","например"],["API Key","API-ключ"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","Введите ваш API-ключ здесь.<br>Метод получения API-ключа различается для каждого сервиса.<br>"],["Leave it blank if the service doesn't require API key.","Оставьте пустым, если сервис не требует API-ключа."],["Model","Модель"],["The pre-trained model","Предобученная модель"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","Для OpenAI может потребоваться установить разрешенную модель для использования (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","Включить контекст"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Включите контекст для перевода. Ранее переведенный материал выше текущей партии будет включен в контекст. <b>Вам также необходимо явно включить КОНТЕКСТ в шаблон</b>"],["Context Character Limit","Ограничение символов контекста"],["Character limit for the context.","Ограничение символов для контекста."],["System Message Template","Шаблон системного сообщения"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Системное сообщение — это заголовок сообщения, который указывает, какую роль играет ваш ассистент chatGPT. Это сообщение будет отправлено самым первым в каждой партии, которую вы отправляете в chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Вы можете включить следующие переменные в стиле шаблонных литералов JavaScript <span class='inlineCode'><b>${</b>ПЕРЕМЕННАЯ<b>}</b></span><br>"],["Variables:<br>","Переменные:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Исходный язык</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Целевой язык</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Исходный текст</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Предопределённое сообщение алгоритма экранирования.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Строка, представляющая новую строку (замена строки).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Количество сообщений в пакете.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Глоссарий информации об актёрах. (Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Генерировать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Контекст предыдущего перевода (если контекст включён)</li>"],["Sample conversation","Пример диалога"],["User message","Сообщение пользователя"],["Assistant's response","Ответ помощника"],["Body Message Template","Шаблон сообщения тела"],["Template of the body of your chat.","Шаблон тела вашего чата."],["Enable JailBreak","Включить JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Включить Jailbreak для перевода. Это сделает перевод более точным и менее предвзятым. Некоторые модели могут связывать вымышленные события с реальными, пытаясь изменить перевод под свою повестку. Эта опция предотвратит это."],["Jailbreak Template","Шаблон Jailbreak"],["Template of the Jailbreak message.","Шаблон сообщения Jailbreak."],["Maximum Tokens","Максимальное количество токенов"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Максимальное количество токенов для генерации в завершении.<br>Количество токенов в вашем запросе плюс max_tokens не может превышать длину контекста модели. Большинство моделей имеют длину контекста 2048 токенов (кроме новейших моделей, которые поддерживают 4096)."],["Temperature","Температура"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Какую температуру выборки использовать, от 0 до 2. Более высокие значения, например 0.8, сделают вывод более случайным, а более низкие, например 0.2, — более сфокусированным и детерминированным. <br>OpenAI обычно рекомендует изменять этот параметр или top_p, но не оба одновременно."],["Nucleus sampling (top_p)","Ядерная выборка (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Альтернатива выборке с температурой, называемая ядерной выборкой, где модель учитывает результаты токенов с вероятностной массой top_p. Так, 0.1 означает, что рассматриваются только токены, составляющие верхние 10% вероятностной массы. <br>OpenAI обычно рекомендует изменять этот параметр или температуру, но не оба одновременно."],["Frequency Penalty","Штраф за частоту"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе их текущей частоты в тексте, уменьшая вероятность того, что модель повторит ту же строку дословно. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Штраф за присутствие"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе того, появляются ли они в тексте, увеличивая вероятность того, что модель заговорит о новых темах. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Использовать JSON-схему"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Используйте <code>json_schema</code> для поля <code>response_format.type</code> вместо старого <code>json_object</code>. <code>json_schema</code> требуется некоторыми последними моделями и серверами, такими как <b>LM Studio</b>, но некоторые старые модели всё ещё используют <code>json_object</code>."],["Max Characters per Batch","Максимум символов на партию"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Максимальный лимит символов на партию перевода.\nЭта опция считает только длину символов исходного текста, а не длину символов сообщения-запроса."],["Max concurrent requests","Максимум параллельных запросов"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","Сколько параллельных запросов разрешено одновременно? Каждое дополнительное параллельное соединение увеличит скорость перевода, но также быстро исчерпает лимит токенов, установленный вашим провайдером.<br />Установите значение <b>0</b>, чтобы отключить эту функцию.<br />Сочетайте эту опцию с <b>Максимум строк на параллельный запрос</b>, чтобы ещё больше повысить скорость перевода.<br />Установка этого параметра больше 1 повлияет на <b>Контекст</b>, так как запросы будут обрабатываться до завершения предыдущих, и контекст будет отправлен без результатов перевода предыдущего запроса."],["Max row per concurrent requests","Максимум строк на параллельный запрос"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Сколько строк разрешено для каждого параллельного запроса. Установите значение <b>0</b>, чтобы отключить эту функцию.<br />Если эта опция отключена, то независимо от того, сколько установлено <b>Максимум параллельных запросов</b>, Translator++ будет обрабатывать запрос как единый блок.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Чем больше строк вы установите, тем больше перевода можно получить в одной партии, что снижает накладные расходы, но увеличивает вероятность ошибок в результатах ИИ.<br />Чем меньше число, тем меньше вероятность ошибки перевода, но это обойдётся дороже из-за дополнительных запросов."],["Preserve translations from invalid returned number of rows","Сохранять переводы из неверного количества возвращённых строк"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","Сохранять переводы из ответов с неверным количеством строк.<br />Если отмечено, Translator++ попытается исправить количество строк и вставить переводы в сетку.<br />Если не отмечено, ячейки останутся пустыми.<br />Рекомендуется оставить эту опцию неотмеченной для целей повторного перевода."],["Batch delay","Задержка между партиями"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","Задержка между партиями (в миллисекундах).<br />Используйте эту настройку для контроля запросов, чтобы не превысить лимит RPM (запросов в минуту)."],["Batch Timeout","Таймаут пакета"],["Timeout for each batch in milisecond","Таймаут для каждого пакета в миллисекундах"],["Code Escaping Algorithm","Алгоритм экранирования кода"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Алгоритм экранирования для встроенного кода в диалогах. Возможно, потребуется изменить <b>Шаблон системного сообщения</b> и <b>Шаблон тела сообщения</b> в соответствии с выбранным алгоритмом экранирования.<br />При выборе <b>JSONCloaking</b> или <b>JSONObjectCloaking</b> автоматически отправляется <code>response_format: { type: 'json_object' }</code> (если не включена опция <b>Использовать JSON-схему</b>, которая отправит JSON-схему вместо этого). <b>JSONCloaking</b> очень точен, но работает не со всеми моделями, попробуйте <b>gpt-3.5-turbo-1106</b>."],["Number of retry","Количество повторных попыток"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Сколько раз движок должен повторить попытку при неудачной проверке вывода перевода. Если значение nullish (пустое), то повторных попыток не будет."],["Retry when the number of translated rows doesn't match original","Повторять, если количество переведённых строк не совпадает с оригиналом"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Если включено, движок будет повторять попытку, когда модель возвращает другое количество строк перевода по сравнению с исходным набором данных."],["Retry when the number of lines for each translated row doesn't match original","Повторять, если количество строк для каждой переведённой строки не совпадает с оригиналом"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Если включено, движок будет повторять попытку, когда любая переведённая строка имеет другое количество строк, чем её оригинальная строка."],["Prompt: Row count mismatch","Запрос: Несоответствие количества строк"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","Запрос, используемый при повторной попытке из-за несоответствия количества строк/элементов. Доступные переменные шаблона включают: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","Запрос: Несоответствие количества строк"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","Запрос, используемый при повторной попытке из-за несоответствия количества строк в каждой строке. Доступные переменные шаблона включают: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","Запрос: Ошибка / Инструкция для повторной попытки"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","Запрос, добавляемый после запроса о несоответствии, чтобы указать модели повторить попытку. Доступные переменные шаблона включают: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","Пользовательский параметр"],["Key","Ключ"],["Value","Значение"],["Type","Тип"],["Type of the value.","Тип значения."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Для типа <b>javascript</b> значение будет вычисляться как код JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Область видимости кода JavaScript — это <code>window</code>. Таким образом, вы можете получить практически любое значение."],["<br />Example: <code>trans.project.title</code>","<br />Пример: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Удалите параметры, которые не будут отправлены в API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI постоянно меняется, некоторые новые модели могут не поддерживать старые параметры и возвращать HTTP-ошибку для нераспознанного параметра запроса."],["You can drop the parameters that are not supported by the model here.","Здесь вы можете удалить параметры, не поддерживаемые моделью."],["Manage configuration","Управление конфигурацией"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","HTML Cloaking Wrapped"],["JSONObject Cloaking","JSONObject Cloaking"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","Это дополнение позволяет переводить через любой сервис, поддерживающий OpenAI Chat API, такой как Deepseek, LlamaCPP, Google Gemini и, конечно же, OpenAI ChatGPT."],["OpenAI API settings","Настройки OpenAI API"],["General","Общие"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Не тратьте деньги на Reasoning Models</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Различные исследования доказали, что reasoning models значительно хуже обычных моделей в выполнении творческих задач написания и перевода.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Используя reasoning models, вы получаете только более высокую стоимость и медленное время отклика.</p>"],["Explore more models","Изучить больше моделей"],["Templates","Шаблоны"],["Enable context","Включить контекст"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Add Example: Translate Japanese to English","Добавить пример: Перевод с японского на английский"],["Retry prompts","Повторные запросы"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Эти запросы добавляются как дополнительные сообщения <b>пользователя</b> во время повторных попыток, сразу после предыдущего вывода модели.</p>"],["<p>Available variables:</p>","<p>Доступные переменные:</p>"],["Enable Jailbreak","Включить взлом"],["Advanced","Расширенные"],["Custom Parameters","Пользовательские параметры"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Вы можете добавить пользовательские параметры в тело запроса OpenAI Chat API. Это полезно, если вы хотите добавить дополнительные параметры, недоступные в форме."],["<h2>Warning</h2>","<h2>Предупреждение</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Неправильная настройка пользовательских параметров может привести к сбою запроса API. Убедитесь, что вы знаете, что делаете, перед добавлением пользовательских параметров. Некоторые сервисы, такие как OpenAI, строги к отправляемым параметрам и могут возвращать HTTP-ошибку для нераспознанных параметров запроса.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Если один и тот же ключ используется несколько раз, будет использоваться только последнее значение.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Если используется тот же ключ, что и в существующей конфигурации, то существующий параметр конфигурации будет перезаписан пользовательским параметром.</li>"],["Drop Parameters","Удалить параметры"],["Open chatGPT tester","Открыть тестер ChatGPT"],["Batch Translation Setting","Настройка пакетного перевода"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Извините, этот аддон доступен только активным патронам.\nВы можете разблокировать эту функцию, став патроном за $1."],["Preserve invalid returned rows","Сохранять недопустимые возвращённые строки"],["Retries and Refinement","Повторные попытки и уточнение"],["<h2>Retries and Refinement</h2>","<h2>Повторные попытки и уточнение</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Когда вывод перевода не проходит проверку, Translator++ может попросить модель повторить перевод. Вы можете установить, сколько раз модель должна повторять попытку, а также задать условия для повторной попытки.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Установка разумного количества повторных попыток с правильными условиями может значительно улучшить качество перевода, сохраняя затраты и время под контролем.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Каждая повторная попытка стоит вам дополнительного времени и денег</b>. Если ваша пакетная обработка часто повторяется, возможно, стоит скорректировать промпт, чтобы сделать инструкции более понятными для модели.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Используйте инструмент разработчика или Менеджер пакетов для отладки пакетного перевода.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Алгоритм экранирования кода</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Экранирование кода — это техника, предотвращающая изменение MTL фрагментов кода внутри диалогов. Это полезно, когда ваши диалоги содержат фрагменты кода, такие как HTML-теги, XML-теги, JSON-объекты или шаблоны JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Выберите алгоритм экранирования, соответствующий фрагментам кода в ваших диалогах. Возможно, потребуется соответствующим образом настроить шаблоны <b>системного сообщения</b>, <b>Примерного промпта</b> и <b>тела сообщения</b>.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Нажмите <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>здесь</a>, чтобы узнать больше об алгоритмах экранирования кода и их эффективном использовании.</p>"],["Default","По умолчанию"],["JavaScript template cloaking","Маскировка шаблонов JavaScript"],["None (no escaping)","Нет (без экранирования)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Хотите загрузить предустановку примеров диалогов для выбранного алгоритма экранирования? Это перезапишет ваши существующие примеры диалогов."],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда отделяйте файл для каждого пакета. Это может сохранить контекст каждого файла незагрязненным другими файлами."],["Add actor name","Добавить имя актера"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актера из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актера из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить справочник актеров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актеров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актеров — это имя актера в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента пакета. Используйте команду шаблона, чтобы загрузить справочник актеров в сообщении промпта."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ACTOR_INFO</code> в шаблон промпта для размещения данных информации о персонажах."],["Actor Reference Translation Column","Колонка перевода справочника актеров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Колонка перевода имени актера. Эта колонка будет использоваться как перевод справочника актеров. Это улучшит согласованность перевода имен актеров в разговоре."],["Actor's Information Column","Колонка информации об актере"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Колонка, содержащая дополнительную информацию об актере. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в диалоге."],["Extra Prompt","Дополнительный промпт"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительный промпт, который будет добавлен к сообщению промпта. Он будет добавлен после системного сообщения и перед основным сообщением промпта."],["<br />","<br />"],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавлять имя актера к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы повысить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать переполнения вашего промпта.</p>"],["The Column of Actor's Additional Information","Колонка дополнительной информации об актере"],["Prompt","Промпт"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":true,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>О</u>тправить"],["Toggle word wrap","Переключить перенос строк"],["Open debugger (F12)","Открыть отладчик (F12)"],["Help","Справка"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Эта функция доступна только при использовании версии Developer для Translator++. Вы можете переключиться на версию Developer с помощью Basic Utilities -> Change Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Глоссарий информации об актерах. (Только если опция информации об актерах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Создать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Контекст предыдущего перевода (если контекст включен)</li>"],["Sample conversation","Пример диалога"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда отделяйте файл для каждой партии. Это может сохранить контексты каждого файла незагрязненными другими файлами."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить справочник актёров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актёров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актёров — это имя актёра в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента партии. Используйте команду шаблона для загрузки справочника актёров в сообщении подсказки."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ACTOR_INFO</code> в шаблоне подсказки, чтобы разместить данные информации о персонаже."],["Actor Reference Translation Column","Столбец перевода справочника актёров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Столбец перевода имени актёра. Этот столбец будет использоваться как перевод справочника актёров. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Столбец информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше информации, такую как пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["Extra Prompt","Дополнительная подсказка"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительная подсказка, которая будет добавлена к сообщению подсказки. Она будет добавлена после системного сообщения и перед фактическим сообщением подсказки."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавить имя актёра к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы повысить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать перегрузки вашего промпта.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации актёра"],["Prompt","Промпт"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","Чат с ChatGPT API"],["Batch Manager","Менеджер партий"],["This feature is only available if you have a project open.","Эта функция доступна только при открытом проекте."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","Хотите установить DazedMTLTool?"],["Ignore if already translated","Игнорировать, если уже переведено"],["OpenAI Translation with DazedMTL","Перевод OpenAI с DazedMTL"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":true,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","Сервер DeepL не установлен. Хотите установить его сейчас?"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":true,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","Использование символов:\n"],["Failed to fetch quota: ","Не удалось получить квоту: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":true,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>О</u>тправить"],["Toggle word wrap","Переключить перенос слов"],["Open debugger (F12)","Открыть отладчик (F12)"],["Help","Помощь"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Эта функция доступна только при использовании Developer версии Translator++. Вы можете переключиться на Developer версию через Basic Utilities -> Change Core NWJS."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>ССЫЛКА[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>ССЫЛКА[Общая ссылка]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>Нативный API Gemini</h2><p>Этот движок использует нативный API Google Gemini для перевода. <br />Вы также можете использовать аддон OpenAI для Google Gemini. В аддоне OpenAI больше функций, поэтому <b style='color:green;'>рекомендую использовать аддон OpenAI вместо этого</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI требует некоторые модули из библиотеки OpenAI. Убедитесь, что аддон <b>transChatGPT (ChatGPT для Translator++)</b> установлен."],["Explore more models","Исследовать больше моделей"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","модель"],["|","|"],["promptLibrary","promptLibrary"],["search","поиск"],["downloadChat","downloadChat"],["newChat","newChat"],["api","api"],["customEndpoint","customEndpoint"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","import"],["name","name"],["prompt","prompt"],["clearPrompts","clearPrompts"],["morePrompts","morePrompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","button.sync"],["button.stop","button.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/typ