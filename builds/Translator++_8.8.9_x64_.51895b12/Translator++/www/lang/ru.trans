iEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","пользовательские модели.пользовательская метка"],["model","модель"],["|","|"],["promptLibrary","библиотека подсказок"],["search","поиск"],["downloadChat","скачать чат"],["newChat","новый чат"],["api","API"],["customEndpoint","пользовательская конечная точка"],["apiEndpoint.inputLabel","ввод метки конечной точки API"],["apiKey.inputLabel","ввод метки ключа API"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","import"],["name","name"],["prompt","prompt"],["clearPrompts","clearPrompts"],["morePrompts","morePrompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","button.sync"],["button.stop","button.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Перевод с помощью ChatGPT Batch API"],["Model","Модель"],["The pre-trained model.","Предобученная модель."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Похоже, что OpenAI Batch API использует немного другое соглашение об именовании моделей, чем в общем API. Модели, используемые в Batch API, имеют префикс «-batch». Например, если вы используете <code>gpt-4.1-mini</code>, модель автоматически становится <code>gpt-4.1-mini-batch</code>.<br />\nОднако на момент создания этого дополнения пакетные модели не указаны в лимитах использования моделей OpenAI, что делает невозможным использование Batch API, если пользователь установил фильтр использования моделей в режим «Разрешить» (белый список).<br />\nВероятно, это ошибка в интерфейсе OpenAI, которая может быть исправлена в будущем.<br />\nПоэтому убедитесь, что установили лимиты использования в OpenAI в режим «Блокировать» (черный список), чтобы использовать Batch API.<br />\nНажмите здесь, чтобы изменить лимиты использования модели: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Исходная колонка"],["The column of the original texts you want to translate.","Столбец с исходными текстами, которые вы хотите перевести."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавить имя актёра из информации строки в переводимый текст. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Ignore if already translated","Игнорировать, если уже переведено"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Если эта опция отмечена, Translator++ будет игнорировать любую строку, в которой уже есть переводы в её столбце."],["Load Actor Reference as Glossary","Загрузить справочник актёров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актёров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актёров — это имя актёра в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента партии. Используйте команду шаблона для загрузки справочника актёров в сообщении-подсказке."],["Actor Reference Translation Column","Столбец перевода справочника актёров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Столбец перевода имени актёра. Этот столбец будет использоваться как перевод справочника актёров. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Столбец информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["System Message Template","Шаблон системного сообщения"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Системное сообщение — это заголовок сообщения, который сообщит, какова роль вашего помощника chatGPT. Это сообщение будет отправлено как самое первое сообщение в каждой партии, которую вы отправляете в chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Вы можете включить следующие переменные в стиле шаблонных литералов JavaScript <span class='inlineCode'><b>${</b>ПЕРЕМЕННАЯ<b>}</b></span><br>"],["Variables:<br>","Переменные:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Исходный язык</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Целевой язык</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Полное название исходного языка</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Полное название целевого языка</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Исходный текст</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Предопределённое сообщение алгоритма экранирования.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Строка, представляющая новую строку (замена строки).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Количество сообщений в пакете.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Добавить информацию об актерах.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Создать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Включить несколько предыдущих строк в качестве контекста</li>"],["Body Message Template","Шаблон тела сообщения"],["Template of the body of your chat.","Шаблон тела вашего чата."],["Sample conversation","Пример разговора"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","Пакетный API ChatGPT позволяет переводить ваш проект асинхронно с 50% снижением затрат, что означает, что вы получите результаты перевода <b style=\"color:red\">в течение 24 часов</b> по <b style=\"color:red\">половине обычной стоимости</b>. Это особенно полезно для крупных проектов, не требующих немедленных результатов перевода."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Подробнее о пакетном API ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Общие настройки"],["This form is using your existing ChatGPT configuration.<br>","Эта форма использует вашу существующую конфигурацию ChatGPT.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Вы можете изменить конфигурацию, перейдя в настройки ChatGPT Translator в окне опций.<br>"],["There you can set the API key, model, and other settings.<br />","Там вы можете установить API-ключ, модель и другие настройки.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Открыть настройки ChatGPT\" />"],["Append actor name to the translatable text","Добавить имя актера к переводимому тексту"],["Ignore translated rows","Игнорировать переведенные строки"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы повысить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать переполнения вашего промпта.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации об актёре"],["Prompt Template","Шаблон промпта"],["<h2>1. System Message</h2>","<h2>1. Системное сообщение</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Здесь вы можете объяснить ассистенту, какова его роль.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Ваш фактический промпт</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Это фактический промпт для ассистента.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Накладные расходы</h3>\n                        Накладные расходы — это стоимость промпт-сообщения, которое вы отправляете ассистенту без фактических текстов для перевода. Стоимость рассчитывается на основе количества токенов в промпт-сообщении. Чем больше токенов, тем выше будет стоимость.<br>\n                        <b>Текущие накладные расходы:</b> <span class=\"overheadCost\">0</span> токенов / запрос."],["Are you sure you want to reset the form?","Вы уверены, что хотите сбросить форму?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Вы уверены, что хотите обработать партию?\nЗа эту операцию будут взиматься расходы."],["The batch is successfully created. Do you want to open the batch manager?","Партия успешно создана. Хотите открыть менеджер партий?"],["OpenAI Batch API Queue","Очередь OpenAI Batch API"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>ССЫЛКА[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>ССЫЛКА[Общая ссылка]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Пожалуйста, выберите строки для применения перевода"],["Target Column","Целевая колонка"],["The column to put the translation result.","Столбец для размещения результата перевода."],["Import translation from ChatGPT Batch","Импорт перевода из пакета ChatGPT"],["Translation applied to selected rows","Перевод применен к выбранным строкам"],["Invalid format","Неверный формат"],["OK","ОК"],["Mismatch","Несоответствие"],["Failed to load batch list with error: \n","Не удалось загрузить список пакетов с ошибкой: \n"],["Download Error File","Скачать файл ошибок"],["Batch is not completed yet","Пакет еще не завершен"],["Are you sure you want to cancel this batch?","Вы уверены, что хотите отменить этот пакет?"],["Cannot cancel completed batch.","Нельзя отменить завершенный пакет."],["Batch cancelled","Пакет отменен"],["Failed to cancel batch","Не удалось отменить пакет"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","Пакеты"],["Apply translation","Применить перевод"],["Cancel batch","Отменить пакет"],["Status","Статус"],["Batch ID","ID пакета"],["Input File ID","ID входного файла"],["End point","Конечная точка"],["Created at","Создано в"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Истекает в <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Пакеты, не завершенные вовремя, в конечном итоге переходят в состояние истечения; незавершенные запросы в этом пакете отменяются, а ответы на завершенные запросы становятся доступными через выходной файл пакета. Вам будет выставлен счет за токены, использованные в любых завершенных запросах.\"></i>"],["Completed at","Завершено в"],["Errors","Ошибки"],["Batch Item Detail of","Детали элемента пакета"],["ID","ID"],["Completed on","Завершено"],["Model","Модель"],["Prompt Token","Токены промпта"],["Completion Token","Токены завершения"],["Total Token","Всего токенов"],["Status Code","Код статуса"],["error","ошибка"],["Conversation","Диалог"],["Response Validation","Проверка ответа"],["Raw Payload","Исходные данные"],["View raw payload","Просмотреть исходные данные"],["Response Preview","Предпросмотр ответа"],["Apply translations from selected rows","Применить переводы из выбранных строк"],["Here you can edit the translation result individually and send it into Translator++","Здесь вы можете редактировать результат перевода индивидуально и отправить его в Translator++"],["Open ChatGPT Settings","Открыть настройки ChatGPT"],["Help","Помощь"],["File list","Список файлов"],["Collapse / restore left panel","Свернуть / восстановить левую панель"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Пакеты, которые не завершаются вовремя, в конечном итоге переходят в состояние истечения срока; незавершённые запросы в этом пакете отменяются, а ответы на завершённые запросы становятся доступными через выходной файл пакета. С вас будет взиматься плата за токены, потреблённые любыми завершёнными запросами."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Глоссарий информации об актёрах.(Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Контекст предыдущего перевода (если контекст включён)</li>"],["Sample conversation","Пример разговора"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Не тратьте деньги на модели рассуждений</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Различные исследования доказали, что модели рассуждений гораздо хуже обычных моделей в выполнении творческих писательских и переводческих задач.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Вы получите только более высокую стоимость и более медленное время отклика при использовании моделей рассуждений.</p>"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда разделяйте файл для каждого пакета. Это может сохранить контексты каждого файла незагрязнёнными другими файлами."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить справочник актёров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актёров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актёров — это имя актёра в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента пакета. Используйте команду шаблона, чтобы загрузить справочник актёров в сообщении подсказки."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ACTOR_INFO</code> в шаблоне подсказки, чтобы разместить данные информации о персонажах."],["Actor Reference Translation Column","Колонка перевода справочника актёров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Колонка перевода имени актёра. Эта колонка будет использоваться как перевод справочника актёров. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Колонка информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в диалоге."],["Extra Prompt","Дополнительный промпт"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительный промпт, который будет добавлен к промпт-сообщению. Он будет добавлен после системного сообщения и перед основным промпт-сообщением."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавлять имя актёра к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы улучшить качество перевода. Функция постарается загрузить только релевантные термины, чтобы избежать переполнения вашего промпта.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации об актёре"],["Prompt","Промпт"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>О</u>тправить"],["Toggle word wrap","Переключить перенос строк"],["Open debugger (F12)","Открыть отладчик (F12)"],["Help","Помощь"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Эта функция доступна только при использовании версии Developer для Translator++. Вы можете переключиться на версию Developer с помощью Basic Utilities -> Change Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Глоссарий информации об актёрах. (Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[имя объекта] : Сгенерировать ссылку из объекта Translator++. <br />Пример: <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Контекст предыдущего перевода (если контекст включён)</li>"],["Sample conversation","Пример диалога"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда разделяйте файл для каждой партии. Это поможет сохранить контекст каждого файла незагрязненным другими файлами."],["Add actor name","Добавить имя актера"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавить имя актера из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актера из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить справочник актеров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актеров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актеров — это имя актера в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента партии. Используйте команду шаблона, чтобы загрузить справочник актеров в сообщении подсказки."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ACTOR_INFO</code> в шаблоне подсказки, чтобы разместить данные информации о персонажах."],["Actor Reference Translation Column","Колонка перевода справочника актеров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Колонка перевода имени актера. Эта колонка будет использоваться как перевод справочника актеров. Это улучшит согласованность перевода имен актеров в разговоре."],["Actor's Information Column","Колонка информации об актере"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Колонка, содержащая дополнительную информацию об актере. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["Extra Prompt","Дополнительная подсказка"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительная подсказка, которая будет добавлена к сообщению подсказки. Она будет добавлена после системного сообщения и перед фактическим сообщением подсказки."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда разделять файл для каждой партии"],["Append actor name to the translatable text","Добавлять имя актера к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в подсказку. Глоссарий будет загружен для каждой партии элементов, чтобы улучшить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать переполнения вашей подсказки.</p>"],["The Column of Actor's Additional Information","Колонка дополнительной информации об актере"],["Prompt","Подсказка"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","Чат с API ChatGPT"],["Batch Manager","Менеджер пакетов"],["This feature is only available if you have a project open.","Эта функция доступна только при открытом проекте."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","Это действие запустит окно браузера. Убедитесь, что ваш браузер по умолчанию установлен на Chrome. Вы хотите продолжить?"],["Gemini Nano server is already running. Do you want to restart it?","Сервер Gemini Nano уже запущен. Вы хотите перезапустить его?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","Это действие запустит окно браузера. Убедитесь, что ваш браузер по умолчанию установлен на Chrome, и сервер Gemini Nano запущен. Вы хотите продолжить?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":true,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ИНФОРМАЦИЯ_АКТЁРА : Глоссарий информации об актёрах. (Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>ССЫЛКА[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>ССЫЛКА[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>КОНТЕКСТ : Контекст предыдущего перевода (если включен контекст)</li>"],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда разделяйте файл для каждой партии. Это может сохранить контексты каждого файла незагрязненными другими файлами."],["Add actor name","Добавить имя актера"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актера из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актера из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить справочник актера как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актера как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актера — это имя актера в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента партии. Используйте команду шаблона, чтобы загрузить справочник актера в сообщении подсказки."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ACTOR_INFO</code> в шаблоне подсказки, чтобы разместить данные информации о персонаже."],["Actor Reference Translation Column","Столбец перевода справочника актера"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Столбец перевода имени актера. Этот столбец будет использоваться как перевод справочника актера. Это улучшит согласованность перевода имени актера в разговоре."],["Actor's Information Column","Столбец информации об актере"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актере. Вы можете добавить больше информации, такую как пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавить имя актера к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавить глоссарий в подсказку. Глоссарий будет загружаться для каждой партии элементов, чтобы улучшить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать переполнения вашей подсказки.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации об актере"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","Название сервиса"],["Service provider for your Batch API.","Провайдер услуг для вашего Batch API."],["Your API Key","Ваш API-ключ"],["Please enter your API key for the Batch API service.","Пожалуйста, введите ваш API-ключ для сервиса Batch API."],["Model","Модель"],["The model for your translation.","Модель для вашего перевода."],["Source Column","Исходная колонка"],["The column of the original texts you want to translate.","Столбец с исходными текстами, которые вы хотите перевести."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавить имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалоги и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Ignore if already translated","Игнорировать, если уже переведено"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Если эта опция отмечена, Translator++ будет игнорировать любую строку, в столбце которой уже есть переводы."],["Filter Tag","Фильтр тегов"],["If set, only rows with this tag will be translated.","Если установлено, будут переведены только строки с этим тегом."],["Load Actor Reference as Glossary","Загрузить справочник актёров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актёров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актёров — это имя актёра в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента пакета. Используйте команду шаблона, чтобы загрузить справочник актёров в сообщении запроса."],["Actor Reference Translation Column","Столбец перевода справочника актёров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Столбец с переводом имени актёра. Этот столбец будет использоваться как перевод справочника актёров. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Столбец информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["Enable Context","Включить контекст"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Включить контекст для перевода. Ранее переведенный материал над текущей партией будет включен в контекст. <b>Вам также необходимо явно включить КОНТЕКСТ в шаблон</b>"],["Context Character Limit","Лимит символов контекста"],["Character limit for the context.","Лимит символов для контекста."],["System Message Template","Шаблон системного сообщения"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Системное сообщение — это заголовок сообщения, который сообщает, какую роль выполняет ваш ассистент chatGPT. Это сообщение будет отправлено самым первым в каждой партии, которую вы отправляете в chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Вы можете включить следующие переменные в стиле шаблонных литералов JavaScript <span class='inlineCode'><b>${</b>ПЕРЕМЕННАЯ<b>}</b></span><br>"],["Variables:<br>","Переменные:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Исходный язык</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Целевой язык</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Полное название исходного языка</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Полное название целевого языка</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Исходный текст</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Предопределенное сообщение алгоритма экранирования.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Строка, представляющая новую строку (замена строки).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Количество сообщений в партии.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Добавить информацию об актерах.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Сгенерировать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Включить некоторые предыдущие строки в качестве контекста</li>"],["Body Message Template","Шаблон сообщения тела"],["Template of the body of your chat.","Шаблон тела вашего чата."],["Sample conversation","Пример диалога"],["User message","Сообщение пользователя"],["Assistant's response","Ответ помощника"],["Enable JailBreak","Включить JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Включить Jailbreak для перевода. Это сделает перевод более точным и менее предвзятым. Некоторые модели могут пытаться связать вымышленные события с реальными, изменяя перевод под свою повестку. Эта опция предотвратит это."],["Jailbreak Template","Шаблон Jailbreak"],["Template of the Jailbreak message.","Шаблон сообщения Jailbreak."],["Maximum Tokens","Максимальное количество токенов"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Максимальное количество токенов для генерации в завершении.<br>Количество токенов в вашем промте плюс max_tokens не должно превышать длину контекста модели. У большинства моделей длина контекста составляет 2048 токенов (кроме новейших моделей, которые поддерживают 4096)."],["Temperature","Температура"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Какую температуру выборки использовать, от 0 до 2. Более высокие значения, например 0.8, делают вывод более случайным, а более низкие, например 0.2, — более сфокусированным и детерминированным. <br>OpenAI обычно рекомендует изменять это или top_p, но не оба одновременно."],["Nucleus sampling (top_p)","Ядерная выборка (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Альтернатива выборке с температурой, называемая ядерной выборкой, где модель учитывает результаты токенов с вероятностной массой top_p. Так, 0.1 означает, что рассматриваются только токены, составляющие верхние 10% вероятностной массы. <br>OpenAI обычно рекомендует изменять это или температуру, но не оба одновременно."],["Frequency Penalty","Штраф за частоту"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе их текущей частоты в тексте, уменьшая вероятность повторения модели той же строки дословно. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Штраф за присутствие"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе их появления в тексте, увеличивая вероятность обсуждения новых тем. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","Пользовательский параметр"],["Key","Ключ"],["Value","Значение"],["Type","Тип"],["Type of the value.","Тип значения."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Для типа <b>javascript</b> значение будет вычислено как код JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Область видимости кода JavaScript — <code>window</code>. Таким образом, вы можете получить практически любое значение."],["Example: <code>trans.project.title</code>","Пример: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Удалите параметры, которые не будут отправлены в API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI постоянно меняется, некоторые новые модели могут не поддерживать старые параметры и возвращать HTTP-ошибку для нераспознанного параметра запроса."],["You can drop the parameters that are not supported by the model here.","Здесь вы можете удалить параметры, которые не поддерживаются моделью."],["Batch API settings","Настройки пакетного API"],["General","Общие"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","Пакетный API OpenAI позволяет переводить ваш проект асинхронно с 50% снижением стоимости, что означает, что вы получите результаты перевода <b style=\"color:red\">в течение 24 часов</b> по <b style=\"color:blue\">половине обычной цены</b>. Это особенно полезно для больших проектов, не требующих немедленных результатов перевода."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Подробнее о пакетном API читайте <a href=\"https://platform.openai.com/docs/guides/batch\" external>здесь</a>.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />Поддерживаемые сервисы: <b>OpenAI</b> и <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>Дополнительные настройки находятся в настройках дополнения</h2>"],["Open Add-on Settings","Открыть настройки дополнения"],["Import Configuration from OpenAI Setting","Импортировать конфигурацию из настроек OpenAI"],["General Settings","Общие настройки"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Не тратьте деньги на модели рассуждений</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Различные исследования доказали, что модели рассуждений значительно хуже обычных моделей при выполнении творческих задач письма и перевода.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Вы ничего не получаете, кроме более высокой стоимости и более медленного времени отклика при использовании моделей рассуждений.</p>"],["<h2>If you're using OpenAI</h2>","<h2>Если вы используете OpenAI</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","Пакетный API OpenAI использует немного другое соглашение об именовании моделей по сравнению со стандартным API. Модели в пакетном режиме включают суффикс -batch. Например, если вы укажете <code>gpt-4.1-mini</code>, это автоматически будет интерпретировано как <code>gpt-4.1-mini-batch</code>.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","Однако на момент разработки этого дополнения пакетные модели не были перечислены в ограничениях использования моделей OpenAI. Это означает, что пользователи, установившие фильтр использования моделей на «Разрешить» (белый список), не смогут получить доступ к пакетному API.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","Нажмите <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>здесь</a>, чтобы изменить ограничения использования модели."],["Explore more models","Изучить больше моделей"],["Append actor name to the translatable text","Добавить имя актера к переводимому тексту"],["Ignore translated rows","Игнорировать переведенные строки"],["Templates","Шаблоны"],["<h2>1. System Message</h2>","<h2>1. Системное сообщение</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Здесь вы можете объяснить ассистенту, какова его роль.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Ваш фактический запрос</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Это фактический запрос к ассистенту.</p>"],["Enable Jailbreak","Включить взлом"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавить глоссарий в запрос. Глоссарий будет загружаться для каждой партии элементов, чтобы повысить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать перегрузки вашего запроса.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации актера"],["Enable context","Включить контекст"],["Advanced","Расширенные"],["Custom Parameters","Пользовательские параметры"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Вы можете добавить пользовательские параметры в тело запроса OpenAI Chat API. Это полезно, если вы хотите добавить дополнительные параметры, недоступные в форме."],["<h2>Warning</h2>","<h2>Предупреждение</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Неправильная настройка пользовательских параметров может привести к сбою запроса API. Убедитесь, что вы понимаете, что делаете, перед добавлением пользовательских параметров. Некоторые сервисы, такие как OpenAI, строги к отправляемым параметрам и могут вернуть HTTP-ошибку при нераспознанном параметре запроса.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Если один и тот же ключ используется несколько раз, будет использовано только последнее значение.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Если используется ключ, уже присутствующий в существующей конфигурации, то существующий параметр конфигурации будет перезаписан пользовательским параметром.</li>"],["String","Строка"],["Number","Число"],["Boolean","Логическое"],["JavaScript","JavaScript"],["Drop Parameters","Удалить параметры"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Накладные расходы</h3>\n                        Накладные расходы — это стоимость сообщения-запроса, которое вы отправляете ассистенту без фактических текстов перевода. Стоимость рассчитывается на основе количества токенов в сообщении-запросе. Чем больше токенов, тем выше будут расходы.<br>\n                        <b>Ориентировочные накладные расходы:</b> <span class=\"overheadCost\">0</span> токенов / запрос."],["Are you sure you want to reset the form?","Вы уверены, что хотите сбросить форму?"],["Translate with Batch API","Перевести с помощью Batch API"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Вы уверены, что хотите обработать пакет?\nЭта операция повлечёт за собой расходы."],["The batch is successfully created. Do you want to open the batch manager?","Пакет успешно создан. Хотите открыть менеджер пакетов?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","Вы уверены, что хотите импортировать конфигурацию из настроек OpenAI? Это перезапишет текущую конфигурацию."],["chatGPT engine is not found","Движок chatGPT не найден"],["Configuration imported successfully.","Конфигурация успешно импортирована."],["Batch API Queue","Пакетная очередь API"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Пожалуйста, выберите строки для применения перевода"],["Target Column","Целевая колонка"],["The column to put the translation result.","Столбец для размещения результата перевода."],["Import translation from ChatGPT Batch","Импорт перевода из партии ChatGPT"],["Translation applied to selected rows","Перевод применен к выбранным строкам"],["Invalid format","Неверный формат"],["OK","OK"],["Mismatch","Несоответствие"],["Failed to load batch list with error: \n","Не удалось загрузить список партий с ошибкой: \n"],["Download Error File","Скачать файл ошибки"],["Batch is not completed yet","Партия еще не завершена"],["Are you sure you want to cancel this batch?","Вы уверены, что хотите отменить эту партию?"],["Cannot cancel completed batch.","Нельзя отменить завершённую партию."],["Batch cancelled","Партия отменена"],["Failed to cancel batch","Не удалось отменить партию"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","Партии"],["Apply translation","Применить перевод"],["Cancel batch","Отменить партию"],["Status","Статус"],["Batch ID","ID партии"],["Input File ID","ID входного файла"],["End point","Конечная точка"],["Created at","Создано"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Истекает в <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Партии, которые не завершаются вовремя, в конечном итоге переходят в состояние истечения; незавершённые запросы в этой партии отменяются, а ответы на завершённые запросы становятся доступны через выходной файл партии. С вас будет списана плата за токены, использованные в любых завершённых запросах.\"></i>"],["Completed at","Завершено"],["Errors","Ошибки"],["Batch Item Detail of","Детали элемента партии"],["ID","ID"],["Completed on","Завершено"],["Model","Модель"],["Prompt Token","Токены промпта"],["Completion Token","Токен завершения"],["Total Token","Всего токенов"],["Status Code","Код состояния"],["error","ошибка"],["Conversation","Диалог"],["Response Validation","Проверка ответа"],["Raw Payload","Необработанные данные"],["View raw payload","Просмотреть необработанные данные"],["Response Preview","Предпросмотр ответа"],["Apply translations from selected rows","Применить переводы из выбранных строк"],["Here you can edit the translation result individually and send it into Translator++","Здесь вы можете редактировать результат перевода по отдельности и отправить его в Translator++"],["Open ChatGPT Settings","Открыть настройки ChatGPT"],["Help","Справка"],["File list","Список файлов"],["Collapse / restore left panel","Свернуть / восстановить левую панель"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Пакеты, не завершённые вовремя, в конечном итоге переходят в состояние истёкших; незавершённые запросы в таком пакете отменяются, а ответы на завершённые запросы становятся доступными через выходной файл пакета. С вас будет списана плата за токены, потреблённые любыми завершёнными запросами."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","Название сервиса"],["Service provider for your Batch API.","Провайдер сервиса для вашего пакетного API."],["API Key","Ключ API"],["Please enter your API key for the Batch API service.","Пожалуйста, введите ваш ключ API для сервиса пакетного API."],["Model","Модель"],["The pre-trained model","Предобученная модель"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","В ChatGPT, возможно, потребуется установить разрешённую модель для использования (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","Включить JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Включить Jailbreak для перевода. Это сделает перевод более точным и менее предвзятым. Некоторые модели могут пытаться связать вымышленные события с реальными, изменяя перевод под свою повестку. Эта опция предотвратит это."],["Jailbreak Template","Шаблон Jailbreak"],["Template of the Jailbreak message.","Шаблон сообщения Jailbreak."],["Maximum Tokens","Максимальное количество токенов"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Максимальное количество токенов для генерации в завершении.<br>Количество токенов в вашем промпте плюс max_tokens не может превышать длину контекста модели. Большинство моделей имеют длину контекста 2048 токенов (кроме новейших, которые поддерживают 4096)."],["Temperature","Температура"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Какую температуру выборки использовать, от 0 до 2. Более высокие значения, например 0.8, сделают вывод более случайным, а более низкие, например 0.2, более сфокусированным и детерминированным.<br>OpenAI обычно рекомендует изменять это или top_p, но не оба сразу."],["Nucleus sampling (top_p)","Ядерная выборка (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Альтернатива выборке с температурой, называемая ядерной выборкой, где модель рассматривает результаты токенов с вероятностной массой top_p. Так, 0.1 означает, что учитываются только токены, составляющие верхние 10% вероятностной массы.<br>OpenAI обычно рекомендует изменять это или температуру, но не оба сразу."],["Frequency Penalty","Штраф за частоту"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе их текущей частоты в тексте, уменьшая вероятность повторения моделью той же строки дословно.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Штраф за повторение"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены в зависимости от их присутствия в тексте, увеличивая вероятность того, что модель заговорит о новых темах. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","Максимум символов на партию"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Максимальный лимит символов на партию перевода.\nЭта опция учитывает только длину символов исходного текста, а не длину символов промпта."],["Max row per concurrent requests","Максимум строк на параллельный запрос"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Сколько строк разрешено для каждого параллельного запроса. Установите <b>0</b>, чтобы отключить эту функцию.<br />Если эта опция отключена, то независимо от того, сколько <b>Максимум параллельных запросов</b> вы установите, Translator++ будет обрабатывать запрос как единый блок.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Чем больше строк вы установите, тем больше перевода можно получить в одной партии, что снижает накладные расходы, но увеличивает вероятность ошибок от ИИ.<br />Чем меньше число, тем меньше вероятность ошибки перевода, но это обойдётся дороже из-за дополнительных промптов."],["Code Escaping Algorithm","Алгоритм экранирования кода"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Алгоритм экранирования встроенного кода в диалогах. Возможно, потребуется изменить <b>Шаблон системного сообщения</b> и <b>Шаблон тела сообщения</b> в соответствии с выбранным алгоритмом экранирования.<br />При выборе <b>JSONCloaking</b> параметр response_format: { type: 'json_object' } будет автоматически отправлен в ChatGPT. <b>JSONCloaking</b> очень точен, но не работает со всеми моделями, попробуйте <b>gpt-3.5-turbo-1106</b>."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>Пакетный API</b> позволяет отправлять множество запросов одновременно, которые обрабатываются асинхронно в фоне. Вы не получите результаты сразу, но процесс <b>будет завершён в течение 24 часов</b> — и часто гораздо быстрее. Этот метод <b>стоит вдвое дешевле стандартного подхода</b>."],["Batch API settings","Настройки пакетного API"],["General","Общие"],["Explore more models","Исследовать больше моделей"],["Templates","Шаблоны"],["Enable Jailbreak","Включить взлом"],["Advanced","Расширенные"],["Batch Translation Setting","Настройка пакетного перевода"],["Default","По умолчанию"],["JavaScript template cloaking","JavaScript шаблонное экранирование"],["None (no escaping)","Нет (без экранирования)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Глоссарий информации об актёрах. (Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Контекст предыдущего перевода (если контекст включён)</li>"],["Sample conversation","Пример разговора"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда разделяйте файл для каждого пакета. Это может сохранить контексты каждого файла незагрязнёнными другими файлами."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить ссылку на актёра как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит ссылку на актёра как глоссарий. Это поможет переводчику понять контекст разговора. Ссылка на актёра — это имя актёра в диалоге. Она будет загружена как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента пакета. Используйте команду шаблона, чтобы загрузить ссылку на актёра в сообщении запроса."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ACTOR_INFO</code> в шаблоне запроса, чтобы разместить данные информации о персонажах."],["Actor Reference Translation Column","Столбец перевода ссылки на актёра"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Столбец перевода имени актёра. Этот столбец будет использоваться как перевод ссылки на актёра. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Столбец информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше информации, такой как пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["Extra Prompt","Дополнительный запрос"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительный запрос, который будет добавлен к сообщению запроса. Он будет добавлен после системного сообщения и перед фактическим сообщением запроса."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавлять имя актера к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы улучшить качество перевода. Функция попытается загрузить только соответствующие термины, чтобы избежать переполнения вашего промпта.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации актера"],["Prompt","Промпт"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","Открыть менеджер партий"],["This feature is only available if you have a project open.","Эта функция доступна только при открытом проекте."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":true,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","URL прокси LiteLLM. Адрес URL вашего прокси LiteLLM. По умолчанию: <code>http://localhost:8890/chat/completions</code>"],["API's base URL","Базовый URL API"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","Базовый URL выбранного сервиса. Заполняйте это поле только при использовании пользовательского URL конечной точки. LiteLLM автоматически определит базовый URL на основе заданной модели.<br />Способ добавления пути к URL в LiteLLM зависит от сервиса. Например, для совместимых с OpenAI конечных точек LiteLLM добавит <code>/chat/completions</code> к указанному URL. Так, если ваша конечная точка — <code>https://api.fast-tunnel.one/v1/chat/completions</code>, заполните поле значением <code>https://api.fast-tunnel.one/v1</code>."],["API Version","Версия API"],["Optional. The API version parameter needed for some services.","Необязательно. Параметр версии API, необходимый для некоторых сервисов."],["API Key","Ключ API"],["Optional. The API key used for authenticating your access to the service.","Опционально. Ключ API, используемый для аутентификации доступа к сервису."],["Model","Модель"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","Предварительно обучите выбранную модель. Используйте удобный формат модели LiteLLM для указания предпочтительной модели. Формат: {название сервиса}/{модель}. Например:"],["your deployment name","ваше название развертывания"],["However, some models have unique names that can be directly identified, like:","Однако некоторые модели имеют уникальные имена, которые можно напрямую идентифицировать, например:"],["Azure AD Token","Токен Azure AD"],["AWS Access Key ID","Идентификатор ключа доступа AWS"],["AWS secret access key","Секретный ключ доступа AWS"],["Open router site URL","URL сайта Open router"],["Open router APP name","Название приложения Open router"],["Enable Context","Включить контекст"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Включите контекст для перевода. Ранее переведенный материал выше текущей партии будет включен в контекст. <b>Вам также необходимо явно включить КОНТЕКСТ в шаблон</b>"],["Context Character Limit","Лимит символов контекста"],["Character limit for the context.","Лимит символов для контекста."],["System Message Template","Шаблон системного сообщения"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Системное сообщение — это заголовок сообщения, который указывает, какую роль выполняет ваш ассистент chatGPT. Это сообщение будет отправлено самым первым в каждой партии, которую вы отправляете в chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Вы можете включить следующие переменные в стиле шаблонных литералов JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Переменные:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Исходный язык</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Целевой язык</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Исходный текст</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Предопределённое сообщение алгоритма экранирования.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Строка, представляющая новую строку (замена строки).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Количество сообщений в пакете.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Глоссарий информации об актёрах. (Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Контекст предыдущего перевода (если контекст включён)</li>"],["Sample conversation","Пример диалога"],["User message","Сообщение пользователя"],["Assistant's response","Ответ помощника"],["Body Message Template","Шаблон основного сообщения"],["Template of the body of your message.","Шаблон тела вашего сообщения."],["Enable JailBreak","Включить JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Включить Jailbreak для перевода. Это сделает перевод более точным и менее предвзятым. Некоторые модели могут пытаться связать вымышленные события с реальными, изменяя перевод под свою повестку. Эта опция предотвратит это."],["Jailbreak Template","Шаблон Jailbreak"],["Template of the Jailbreak message.","Шаблон сообщения Jailbreak."],["Maximum Tokens","Максимальное количество токенов"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Максимальное количество токенов для генерации в завершении.<br>Количество токенов в вашем промте плюс max_tokens не может превышать длину контекста модели. Большинство моделей имеют длину контекста 2048 токенов (кроме новейших моделей, которые поддерживают 4096)."],["Temperature","Температура"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Какую температуру выборки использовать, от 0 до 2. Более высокие значения, такие как 0.8, сделают вывод более случайным, а более низкие, такие как 0.2, — более сфокусированным и детерминированным. <br>OpenAI обычно рекомендует изменять это или top_p, но не оба сразу."],["Nucleus sampling (top_p)","Ядерная выборка (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Альтернатива выборке с температурой, называемая ядерной выборкой, где модель учитывает результаты токенов с массой вероятности top_p. Так, 0.1 означает, что рассматриваются только токены, составляющие верхние 10% массы вероятности. <br>OpenAI обычно рекомендует изменять это или температуру, но не оба сразу."],["Frequency Penalty","Штраф за частоту"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе их существующей частоты в тексте, уменьшая вероятность повторения моделью той же строки дословно. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Штраф за присутствие"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Число от -2.0 до 2.0. Положительные значения штрафуют новые токены на основе того, появляются ли они в тексте, увеличивая вероятность обсуждения моделью новых тем. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Использовать JSON-схему"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Используйте <code>json_schema</code> для поля <code>response_format.type</code> вместо старого <code>json_object</code>. <code>json_schema</code> требуется некоторыми новейшими моделями и серверами, такими как <b>LM Studio</b>, но некоторые старые модели всё ещё используют <code>json_object</code>."],["Stop","Стоп"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","Введите ключевое слово, на котором API остановит генерацию дальнейших токенов. Разделяйте каждую запись новой строкой."],["Additional argument variables","Дополнительные переменные аргументов"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","Дополнительные переменные аргументов, которые будут добавлены при запуске сервера.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","Таймаут пакета"],["Timeout for each batch in milisecond","Таймаут для каждого пакета в миллисекундах"],["Max Request Length","Максимальная длина запроса"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","Максимальная длина символов для каждого пакета перевода.\nУ каждого переводчика разные спецификации.\nРекомендую менее 2000 для веб-фронтенд-переводчика, использующего GET-параметр."],["Max concurrent requests","Максимум одновременных запросов"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","Сколько одновременных запросов разрешено подключать одновременно. Установите <b>0</b>, чтобы отключить эту функцию.<br />Сочетайте эту опцию с <b>Максимальным количеством строк на одновременный запрос</b> для ускорения перевода."],["Max row per concurrent requests","Максимальное количество строк на одновременный запрос"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","Сколько строк разрешено для каждого одновременного запроса. Установите значение <b>0</b>, чтобы отключить эту функцию.<br />Если эта опция отключена, то независимо от того, сколько <b>Максимальных одновременных запросов</b> вы установите, Translator++ будет обрабатывать запрос как единый блок."],["Batch delay","Задержка между пакетами"],["Delay between batch (in miliseconds)","Задержка между пакетами (в миллисекундах)"],["Code Escaping Algorithm","Алгоритм экранирования кода"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","Алгоритм экранирования для встроенного кода внутри диалогов. Возможно, вам потребуется изменить <b>Шаблон системного сообщения</b> и <b>Шаблон тела сообщения</b> в соответствии с выбранным алгоритмом экранирования."],["Number of retry","Количество повторных попыток"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Сколько раз движок должен повторить попытку, когда проверка выходных данных перевода не удалась. Если значение nullish (пустое), то повторных попыток не будет."],["Retry when the number of translated rows doesn't match original","Повторить, если количество переведённых строк не совпадает с оригиналом"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Если включено, движок повторит попытку, когда модель возвращает другое количество строк перевода по сравнению с исходным набором данных."],["Retry when the number of lines for each translated row doesn't match original","Повторить, если количество строк для каждой переведённой строки не совпадает с оригиналом"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Если включено, движок повторит попытку, когда любая переведённая строка имеет другое количество строк, чем её оригинальная строка."],["Prompt: Row count mismatch","Подсказка: Несоответствие количества строк"],["Prompt used when retrying due to row/element count mismatch.","Подсказка, используемая при повторной попытке из-за несоответствия количества строк/элементов."],["Prompt: Line count mismatch","Подсказка: Несоответствие количества строк"],["Prompt used when retrying due to per-row line count mismatch.","Подсказка, используемая при повторной попытке из-за несоответствия количества строк в каждой строке."],["Prompt: Error / Retry instruction","Подсказка: Ошибка / Инструкция для повторной попытки"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","Подсказка, добавляемая после подсказки(ок) о несоответствии, чтобы указать модели повторить попытку."],["Custom Parameter","Пользовательский параметр"],["Key","Ключ"],["Value","Значение"],["Type","Тип"],["Type of the value.","Тип значения."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Для типа <b>javascript</b> значение будет оценено как код JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Область видимости кода JavaScript — <code>window</code>. Так что вы можете получить практически любое значение."],["<br />Example: <code>trans.project.title</code>","<br />Пример: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Удалите параметры, которые не будут отправлены в API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI постоянно меняется, некоторые новые модели могут не поддерживать старые параметры и возвращать HTTP-ошибку для нераспознанного параметра запроса."],["You can drop the parameters that are not supported by the model here.","Вы можете удалить параметры, которые не поддерживаются моделью, здесь."],["Manage configuration","Управление конфигурацией"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","Некоторые функции этого движка требуют установки дополнения ChatGPT. Убедитесь, что вы установили дополнение ChatGPT, прежде чем использовать этот движок."],["Text Completion Setting","Настройка завершения текста"],["General","Общие"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Не тратьте деньги на модели рассуждений</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Различные исследования доказали, что модели рассуждений значительно хуже обычных моделей в выполнении творческих писательских и переводческих задач.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Вы ничего не выигрываете, кроме более высокой стоимости и более медленного времени отклика при использовании моделей рассуждений.</p>"],["Platform specific","Специфично для платформы"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","Шаблоны"],["Enable context","Включить контекст"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Retry prompts","Повторные запросы"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Эти запросы добавляются как дополнительные сообщения <b>пользователя</b> при повторных попытках, сразу после предыдущего вывода модели.</p>"],["<p>Available variables:</p>","<p>Доступные переменные:</p>"],["Enable Jailbreak","Включить взлом"],["Advanced","Расширенные"],["Custom Parameters","Пользовательские параметры"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Вы можете добавить пользовательские параметры в тело запроса OpenAI Chat API. Это полезно, если вы хотите добавить дополнительные параметры, недоступные в форме."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>Предупреждение</h2><ul><li>Неправильная настройка пользовательских параметров может привести к сбою запроса API. Убедитесь, что вы понимаете, что делаете, перед добавлением пользовательских параметров. Некоторые сервисы, такие как OpenAI, строги к отправляемым параметрам и вернут HTTP-ошибку за нераспознанный параметр запроса.</li><li>Если один и тот же ключ используется несколько раз, будет использовано только последнее значение.</li><li>Если используется тот же ключ в существующей конфигурации, то существующий параметр конфигурации будет перезаписан пользовательским параметром.</li></ul>"],["Drop Parameters","Удалить параметры"],["LiteLLM Proxy Configuration","Конфигурация прокси LiteLLM"],["Start LiteLLM server","Запустить сервер LiteLLM"],["Processing...","Обработка..."],["Server started on port ","Сервер запущен на порту "],["Check LiteLLM Status","Проверить статус LiteLLM"],["Change LiteLLM Version","Изменить версию LiteLLM"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","Введите новую версию LiteLLM, которую вы хотите установить.\nИзвестные рабочие версии: 1.38.0, 1.49.4 \nРекомендуемая версия: "],["Are you sure you want to install LiteLLM version ","Вы уверены, что хотите установить версию LiteLLM "],["Failed to install LiteLLM. Please check the console for more details.","Не удалось установить LiteLLM. Пожалуйста, проверьте консоль для получения дополнительных сведений."],["LiteLLM has been successfully updated to version ","LiteLLM успешно обновлен до версии "],["Batch Translation Setting","Настройки пакетного перевода"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Извините, этот аддон доступен только активным патронам.\nВы можете разблокировать эту функцию, став патроном за $1."],["Retries and Refinement","Повторы и уточнение"],["<h2>Retries and Refinement</h2>","<h2>Повторы и уточнение</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Когда результат перевода не проходит проверку, Translator++ может попросить модель повторить перевод. Вы можете установить, сколько раз модель должна повторить, а также задать условия для повтора.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Установка разумного количества повторов с правильными условиями может значительно улучшить качество перевода, сохраняя при этом затраты и время под контролем.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Каждый повтор стоит вам дополнительного времени и денег</b>. Если ваш пакетный перевод часто требует повторов, возможно, стоит скорректировать промпт, чтобы сделать инструкции более понятными для модели.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Используйте инструменты разработчика или менеджер пакетного перевода для отладки.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Алгоритм экранирования кода</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Экранирование кода — это техника, предотвращающая изменение MTL фрагментов кода внутри диалогов. Это полезно, когда ваши диалоги содержат фрагменты кода, такие как HTML-теги, XML-теги, JSON-объекты или шаблоны JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Выберите алгоритм экранирования, соответствующий фрагментам кода в ваших диалогах. Возможно, вам потребуется соответствующим образом настроить шаблоны <b>системного сообщения</b>, <b>Примерного промпта</b> и <b>основного сообщения</b>.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Нажмите <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>здесь</a>, чтобы узнать больше об алгоритмах экранирования кода и их эффективном использовании.</p>"],["JavaScript template cloaking","Маскирование шаблонов JavaScript"],["None (no escaping)","Нет (без экранирования)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Хотите загрузить пресет примерного диалога для выбранного алгоритма экранирования? Это перезапишет ваш существующий примерный диалог."],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда отделяйте файл для каждого пакета. Это может сохранить контекст каждого файла незагрязненным другими файлами."],["Add actor name","Добавить имя актера"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актера из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актера из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить ссылку на актёра как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит ссылку на актёра как глоссарий. Это поможет переводчику понять контекст разговора. Ссылка на актёра — это имя актёра в диалоге. Она будет загружена как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, присутствующие в разговоре, будут загружены как глоссарий для каждого элемента партии. Используйте команду шаблона для загрузки ссылки на актёра в сообщении-подсказке."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно добавить переменную <code>ACTOR_INFO</code> в шаблон подсказки, чтобы разместить данные информации о персонаже."],["Actor Reference Translation Column","Колонка перевода ссылки на актёра"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Колонка перевода имени актёра. Эта колонка будет использоваться как перевод ссылки на актёра. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Колонка информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Колонка, содержащая дополнительную информацию об актёре. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["Extra Prompt","Дополнительная подсказка"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительная подсказка, которая будет добавлена к сообщению-подсказке. Она будет добавлена после системного сообщения и перед фактическим сообщением-подсказкой."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавлять имя актёра к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в подсказку. Глоссарий будет загружаться для каждой партии элементов, чтобы улучшить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать переполнения вашей подсказки.</p>"],["The Column of Actor's Additional Information","Колонка дополнительной информации об актёре"],["Prompt","Подсказка"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":true,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","Переводить с помощью OpenAI Batch API"],["Model","Модель"],["The pre-trained model.","Предобученная модель."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Похоже, что OpenAI Batch API использует немного другое соглашение об именовании моделей, чем обычно используемый API. Модели, используемые в Batch API, имеют префикс «-batch». Например, если вы используете <code>gpt-4.1-mini</code>, модель автоматически становится <code>gpt-4.1-mini-batch</code>.<br />\nОднако на момент создания этого дополнения пакетные модели не указаны в лимитах использования моделей OpenAI, что делает невозможным использование Batch API, если пользователь установил фильтр использования моделей в «Разрешить» (белый список).<br />\nВероятно, это ошибка в интерфейсе OpenAI, которая может быть исправлена в будущем.<br />\nПоэтому, чтобы использовать Batch API, убедитесь, что лимиты использования в OpenAI установлены в режим «Блокировать» (черный список).<br />\nНажмите здесь, чтобы изменить лимиты использования модели: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Исходная колонка"],["The column of the original texts you want to translate.","Столбец исходных текстов, которые вы хотите перевести."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавить имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Ignore if already translated","Игнорировать, если уже переведено"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Если эта опция отмечена, Translator++ будет игнорировать любую строку, в столбце которой уже есть переводы."],["Load Actor Reference as Glossary","Загрузить справочник актёров как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит справочник актёров как глоссарий. Это поможет переводчику понять контекст разговора. Справочник актёров — это имя актёра в диалоге. Он будет загружен как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, существующие в разговоре, будут загружены как глоссарий для каждого элемента пакета. Используйте команду шаблона, чтобы загрузить справочник актёров в сообщении подсказки."],["Actor Reference Translation Column","Столбец перевода справочника актёров"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Столбец перевода имени актёра. Этот столбец будет использоваться как перевод справочника актёров. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Столбец информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше информации, например, пол, возраст и т.д. Это улучшит перевод местоимений в разговоре."],["System Message Template","Шаблон системного сообщения"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Системное сообщение — это заголовок сообщения, который сообщает, какую роль выполняет ваш помощник chatGPT. Это сообщение будет отправлено самым первым в каждом пакете, который вы отправляете в chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Вы можете включить следующие переменные в стиле шаблонных литералов JavaScript <span class='inlineCode'><b>${</b>ПЕРЕМЕННАЯ<b>}</b></span><br>"],["Variables:<br>","Переменные:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Исходный язык</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Целевой язык</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Полное название исходного языка</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Полное название целевого языка</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Исходный текст</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Предопределенное сообщение алгоритма экранирования.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Строка, представляющая новую строку (замена строки).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Количество сообщений в пакете.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Добавить информацию об актерах.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Движок игры</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Создать ссылку из объекта Translator++. <br />Пример : <code>REFERENCE[Общая ссылка]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Включить несколько предыдущих строк в качестве контекста</li>"],["Body Message Template","Шаблон основного сообщения"],["Template of the body of your chat.","Шаблон тела вашего чата."],["Sample conversation","Пример разговора"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API OpenAI Batch позволяет асинхронно переводить ваш проект на 50% дешевле, что означает, что вы получите результаты перевода <b style=\"color:red\">в течение 24 часов</b> по <b style=\"color:blue\">половине обычной стоимости</b>. Это особенно полезно для больших проектов, не требующих немедленных результатов перевода."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />Подробнее об API OpenAI Batch читайте <a href=\"https://platform.openai.com/docs/guides/batch\" external>здесь</a>."],["General Settings","Общие настройки"],["This form is using your OpenAI Batch API configuration.<br>","Эта форма использует вашу конфигурацию API OpenAI Batch.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","Вы можете изменить конфигурацию, перейдя в настройки дополнения <b>OpenAI Batch API</b> в окне опций.<br>"],["There you can set the API key, model, and other settings.<br />","Там вы можете установить API-ключ, модель и другие настройки.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Ваш OpenAI API Key\"}});' value=\"Открыть настройки ChatGPT\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Не тратьте деньги на модели с рассуждениями</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Различные исследования доказали, что модели с рассуждениями значительно хуже обычных моделей при выполнении творческих писательских задач и переводов.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Использование моделей с рассуждениями приносит лишь более высокие затраты и медленное время отклика.</p>"],["Append actor name to the translatable text","Добавить имя актера к переводимому тексту"],["Ignore translated rows","Игнорировать переведенные строки"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет автоматически добавить глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы улучшить качество перевода. Функция попытается загрузить только релевантные термины, чтобы избежать переполнения вашего промпта.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации актера"],["Prompt Template","Шаблон промпта"],["<h2>1. System Message</h2>","<h2>1. Системное сообщение</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Здесь вы можете объяснить ассистенту его роль.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Ваш фактический промпт</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Это фактический промпт для ассистента.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Накладные расходы</h3>\n                        Накладные расходы — это стоимость промпт-сообщения, которое вы отправляете ассистенту без фактических текстов для перевода. Стоимость рассчитывается на основе количества токенов в промпт-сообщении. Чем больше токенов, тем выше будет стоимость.<br>\n                        <b>Оценочные накладные расходы:</b> <span class=\"overheadCost\">0</span> токенов / запрос."],["Are you sure you want to reset the form?","Вы уверены, что хотите сбросить форму?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Вы уверены, что хотите обработать партию?\nЗа эту операцию будут начислены расходы."],["The batch is successfully created. Do you want to open the batch manager?","Партия успешно создана. Хотите открыть менеджер партий?"],["OpenAI Batch API Queue","Очередь OpenAI Batch API"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Пожалуйста, выберите строки для применения перевода"],["Target Column","Целевая колонка"],["The column to put the translation result.","Столбец для размещения результата перевода."],["Import translation from ChatGPT Batch","Импортировать перевод из ChatGPT Batch"],["Translation applied to selected rows","Перевод применён к выбранным строкам"],["Invalid format","Неверный формат"],["OK","ОК"],["Mismatch","Несоответствие"],["Failed to load batch list with error: \n","Не удалось загрузить список пакетов с ошибкой: \n"],["Download Error File","Скачать файл ошибок"],["Batch is not completed yet","Пакет ещё не завершён"],["Are you sure you want to cancel this batch?","Вы уверены, что хотите отменить этот пакет?"],["Cannot cancel completed batch.","Нельзя отменить завершённый пакет."],["Batch cancelled","Пакет отменён"],["Failed to cancel batch","Не удалось отменить пакет"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","Пакеты"],["Apply translation","Применить перевод"],["Cancel batch","Отменить пакет"],["Status","Статус"],["Batch ID","ID пакета"],["Input File ID","ID входного файла"],["End point","Конечная точка"],["Created at","Создано"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Истекает в <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Пакеты, которые не завершаются вовремя, в конечном итоге переходят в состояние истечения; незавершённые запросы в этом пакете отменяются, а ответы на завершённые запросы становятся доступными через выходной файл пакета. Вы будете оплачивать токены, потреблённые для любых завершённых запросов.\"></i>"],["Completed at","Завершено в"],["Errors","Ошибки"],["Batch Item Detail of","Детали элемента пакета"],["ID","ID"],["Completed on","Завершено"],["Model","Модель"],["Prompt Token","Токены запроса"],["Completion Token","Токены ответа"],["Total Token","Всего токенов"],["Status Code","Код статуса"],["error","ошибка"],["Conversation","Диалог"],["Response Validation","Проверка ответа"],["Raw Payload","Исходные данные"],["View raw payload","Просмотреть исходные данные"],["Response Preview","Предпросмотр ответа"],["Apply translations from selected rows","Применить переводы из выбранных строк"],["Here you can edit the translation result individually and send it into Translator++","Здесь вы можете отредактировать результат перевода по отдельности и отправить его в Translator++"],["Open ChatGPT Settings","Открыть настройки ChatGPT"],["Help","Помощь"],["File list","Список файлов"],["Collapse / restore left panel","Свернуть / восстановить левую панель"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Пакеты, не завершённые вовремя, в конечном итоге переходят в состояние истёкших; незавершённые запросы в таком пакете отменяются, а ответы на завершённые запросы становятся доступными через выходной файл пакета. Вы будете платить за токены, использованные в любых завершённых запросах."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>НАЗВАНИЕ : Название игры</li>"],["<li>ENGINE : Engine of the game</li>","<li>ДВИЖОК : Движок игры</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ИНФОРМАЦИЯ_АКТЁРА : Глоссарий информации об актёрах. (Только если опция информации об актёрах включена в пакетном режиме)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>ССЫЛКА[имя объекта] : Создать ссылку из объекта Translator++. <br />Пример : <code>ССЫЛКА[Общая ссылка]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>КОНТЕКСТ : Контекст предыдущего перевода (если контекст включён)</li>"],["Sample conversation","Пример разговора"],["<h2>Sample dialogue</h2>","<h2>Пример диалога</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Пример существующего диалога. Вы можете написать пример хороших или плохих ответов, чтобы помочь переводчику понять вашу цель и контекст разговора.</p>"],["Always separate file","Всегда отдельный файл"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Всегда разделяйте файл для каждого пакета. Это может сохранить контексты каждого файла незагрязнёнными другими файлами."],["Add actor name","Добавить имя актёра"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Добавьте имя актёра из информации строки к переводимому тексту. Это поможет переводчикам отслеживать диалог и местоимения. Translator++ затем удалит имя актёра из результата перевода. Это, очевидно, увеличит стоимость перевода."],["Load Actor Reference as Glossary","Загрузить ссылку на актёра как глоссарий"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Если отмечено, Translator++ загрузит ссылку на актёра как глоссарий. Это поможет переводчику понять контекст разговора. Ссылка на актёра — это имя актёра в диалоге. Она будет загружена как глоссарий для переводчика. Это увеличит стоимость перевода."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Только персонажи, которые существуют в разговоре, будут загружены как глоссарий для каждого элемента пакета. Используйте команду шаблона, чтобы загрузить ссылку на актёра в сообщении подсказки."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Если вы включите эту опцию, вам также нужно включить переменную <code>ИНФОРМАЦИЯ_АКТЁРА</code> в шаблоне подсказки, чтобы разместить данные информации о персонажах."],["Actor Reference Translation Column","Колонка перевода ссылки на актёра"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Колонка перевода имени актёра. Эта колонка будет использоваться как перевод ссылки на актёра. Это улучшит согласованность перевода имён актёров в разговоре."],["Actor's Information Column","Колонка информации об актёре"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Столбец, содержащий дополнительную информацию об актёре. Вы можете добавить больше данных, таких как пол, возраст и т.д. Это улучшит перевод местоимений в диалоге."],["Extra Prompt","Дополнительный промпт"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Дополнительный промпт, который будет добавлен к промпт-сообщению. Он будет добавлен после системного сообщения и перед основным промпт-сообщением."],["General Settings","Общие настройки"],["Always separate file for each batch","Всегда отдельный файл для каждой партии"],["Append actor name to the translatable text","Добавлять имя актёра к переводимому тексту"],["Glossary","Глоссарий"],["<h2>Glossary</h2>","<h2>Глоссарий</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Эта функция поможет вам автоматически добавлять глоссарий в промпт. Глоссарий будет загружаться для каждой партии элементов, чтобы повысить качество перевода. Функция постарается загрузить только релевантные термины, чтобы избежать переполнения вашего промпта.</p>"],["The Column of Actor's Additional Information","Столбец дополнительной информации об актёре"],["Prompt","Промпт"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","Менеджер партий"],["This feature is only available if you have a project open.","Эта функция доступна только при открытом проекте."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":true,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","Запустить сервер"],["Server started","Сервер запущен"],["Reinstall server","Переустановить сервер"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","Введите новую версию библиотеки Translators, которую вы хотите установить.\nПоследняя версия: "],["Are you sure you want to install Translators version ","Вы уверены, что хотите установить версию Translators "],["Failed to install Translators. Please check the console for more details.","Не удалось установить Translators. Пожалуйста, проверьте консоль для получения подробностей."],["Translators has been successfully updated to version ","Translators успешно обновлён до версии "],["General Settings","Общие настройки"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":true,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","Вы уверены, что хотите прервать?"],["Process paused!\nPress OK to continue!","Процесс приостановлен!\nНажмите OK для продолжения!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":true,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","Никогда не выгружать словари из оперативной памяти"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":true,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","Не удалось запустить Translation Proxy!\nTranslation Proxy в настоящее время доступен только для патронов уровня $3 и выше."],["Please enter the port number:","Пожалуйста, введите номер порта:"],["Invalid port : ","Неверный порт: "],["Port must be a numeric.","Порт должен быть числовым."],["Port has successfully changed to: ","Порт успешно изменён на: "],["Connection Info","Информация о подключении"],["Do you want to copy the base URL into the clipboard?","Хотите скопировать базовый URL в буфер обмена?"],["Use secure protocol(HTTPS)","Использовать защищённый протокол (HTTPS)"],["Port","Порт"],["Connection info","Информация о подключении"],["Help","Справка"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":true,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","Принудительно установит кодировку текста в выбранную при записи скриптов. (пусто = автоматически)<br />. Вы можете использовать это поле для преобразования скрипта в <b>UTF-16</b>, чтобы игра была воспроизводима без изменения локали на японскую."],["Use legacy parser","Использовать устаревший парсер"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","Используйте устаревший (старый парсер) вместо нового.<br />Устаревший парсер быстрее, но ненадёжен в некоторых играх.<br />Новый парсер надёжнее, но медленнее."],["Select TyranoBuilder packaged game","Выберите упакованную игру TyranoBuilder"],["Select the exe file of your packaged game.","Выберите exe-файл вашей упакованной игры."],["Target folder","Целевая папка"],["Select destination folder. The process will replace the existing files.","Выберите папку назначения. Процесс заменит существующие файлы."],["Extraction completed","Извлечение завершено"],["Close","Закрыть"],["Next","Следующее"],["Please select game executable file","Пожалуйста, выберите исполняемый файл игры"],["Back","Назад"],["The game is fully loaded, proceed!","Игра полностью загружена, продолжайте!"],["Extract data","Извлечь данные"],["Open extracted folder","Открыть извлечённую папку"],["Extract resources","Извлечь ресурсы"],["Select the game executable","Выберите исполняемый файл игры"],["Select the game executable or asar file to extract","Выберите исполняемый файл игры или asar-файл для извлечения"],["Target directory","Целевой каталог"],["Select the target directory to store the unpacked files","Выберите целевой каталог для хранения распакованных файлов"],["Electron archive file detected. Do you want to extract the asar file instead?","Обнаружен файл архива Electron. Вы хотите извлечь asar-файл вместо этого?"],["Tyranobuilder Game Extractor","Экстрактор игр TyranoBuilder"],["Before you create a new project, please make sure that :","Прежде чем создать новый проект, убедитесь, что:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","<b>Дополнение парсера игр Kirikiri Adventure Game</b> установлено в вашем Translator++"],["Your game is fully extracted.","Ваша игра полностью извлечена."],["Extract TyranoBuilder package","Извлечь пакет TyranoBuilder"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Все файлы .ks и .tjs находятся в виде обычного текста (нескомпилированы, не зашифрованы и не закодированы)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Некоторые действия изменят вашу игру. <b>Поэтому обязательно создайте резервную копию вашей игры!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Выберите исполняемый файл игры. Этот файл является основным файлом игры, который будет использоваться для извлечения игровых данных."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","В играх Tyrano это обычно файл <b>index.html</b> или <b>exe</b>."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Список возможных кодировок символов. <b>Порядок имеет значение!</b>. Вы можете перетаскивать элементы для сортировки списка."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","Игры, созданные с TyranoBuilder, используют кодировку <b>UTF-8</b>"],["Literal tags are the tags that will be escaped into Translator++ editor.","Литеральные теги — это теги, которые будут экранированы в редакторе Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> являются обязательными."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Теги будут интерполированы Translator++ в новую строку. Поэтому вам не нужно явно писать <b>[r]</b>."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Скрипт Kirikiri (.ks) является очень настраиваемым и позволяет разработчикам создавать собственные теги."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ может обрабатывать стандартные теги, такие как имена персонажей, начинающиеся с решётки (#)."],["However, Translator++ may not be able to handle custom tags created by developers.","Однако Translator++ может не справиться с пользовательскими тегами, созданными разработчиками."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Поэтому вам может потребоваться определить теги и атрибуты, которые нужно переводить, и те, которые нужно отметить как имена актёров."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>Пожалуйста, посетите <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">справочник тегов TyranoBuilder</a> для получения дополнительной информации о тегах.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","Возможно, вам потребуется <input type=\"button\" value=\"извлечь вашу игру\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> и проанализировать скрипт <b>ks</b> внутри неё перед началом проекта."],["Create Project","Создать проект"],["Play last build","Запустить последнюю сборку"],["Extract TyranoBuilder","Извлечь TyranoBuilder"],["Create playable package","Создать игровой пакет"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":true,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","Общие"],["Executable file location","Расположение исполняемого файла"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tПуть к исполняемому файлу приложения.\n\t\t\t"],["Field can not be empty!","Поле не может быть пустым!"],["Service","Сервис"],["End Point","Конечная точка"],["Auto translation service to use.","Используйте сервис автоперевода"],["Target Language","Целевой язык"],["The language to translate into","Язык, на который нужно перевести"],["Source Language","Исходный язык"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","Оригинальный язык игры. \"авто\" также поддерживается для некоторых конечных точек, но обычно это не рекомендуется"],["Files","Файлы"],["Directory","Каталог"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Каталог для поиска кэшированных файлов перевода. Можно использовать заполнитель: {GameExeName}, {Lang}"],["Output File","Выходной файл"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","Файл для вставки сгенерированных переводов. Можно использовать заполнители: {GameExeName}, {Lang}"],["Substitution File","Файл замещения"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","Файл, содержащий подстановки, применяемые перед переводами. Можно использовать заполнители: {GameExeName}, {Lang}"],["Preprocessors File","Файл препроцессоров"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","Файл, содержащий препроцессоры, которые необходимо применить перед отправкой текста переводчику. Можно использовать заполнители: {GameExeName}, {Lang}"],["Text Frameworks","Текстовые фреймворки"],["Enable/Disable auto translation for Unity's text frameworks.","Включить/выключить автоматический перевод для текстовых фреймворков Unity."],["Behaviour","Поведение"],["Max Characters Per Translation","Максимальное количество символов в переводе"],["Max characters per text to translate. Max 2500.","Максимальное количество символов в тексте для перевода. Максимум 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Игнорировать или нет пробельные символы, включая новые строки, в диалоговых клавишах"],["Whether or not to ignore whitespace, including newlines, in NGUI","Игнорировать или нет пробельные символы, включая новые строки, в NGUI"],["Minimum Dialogue Chars","Минимальное количество символов в диалоге"],["The length of the text for it to be considered a dialogue","Длина текста для того, чтобы он считался диалогом"],["Force Split Text After Characters","Принудительное разделение текста после символов"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Разделить текст на несколько строк, если переведенный текст превышает указанное количество символов. (0 - нет разделения)"],["Whether or not to copy hooked texts to clipboard","Следует ли копировать подключенные тексты в буфер обмена"],["MaxClipboardCopyCharacters","MaxClipboardCopyCharacters"],["Max number of characters to hook to clipboard at a time","Максимальное количество символов в буфере обмена за один раз"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Должен ли плагин обеспечивать \"лучшую попытку\" изменения размера компонентов пользовательского интерфейса при переводе"],["Indicates whether batching of translations should be enabled for supported endpoints","Указывает, следует ли включить пакетную обработку переводов для поддерживаемых конечных точек."],["Indicates whether or not to use translations from the included static translation cache","Указывает, следует ли использовать переводы из включенного статического кэша переводов."],["Override Font","Переопределение шрифта"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Переопределяет шрифты, используемые для текстов при обновлении текстовых компонентов. ПРИМЕЧАНИЕ: Работает только для UGUI"],["Override Font TextMeshPro","Переопределение шрифта TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Переопределяет шрифты, используемые для текстов при обновлении текстовых компонентов. ПРИМЕЧАНИЕ: Работает только для TextMeshPro"],["Resize UI Line Spacing Scale","Изменение размера пользовательского интерфейса Масштаб межстрочного интервала"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","Десятичное значение, на которое следует масштабировать расстояние между строками по умолчанию при изменении размера пользовательского интерфейса, например: 0,80. ПРИМЕЧАНИЕ: работает только для UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","Указывает, должно ли поведение изменения размера пользовательского интерфейса применяться ко всем компонентам пользовательского интерфейса, независимо от их перевода."],["Ignore Text Starting With","Игнорировать текст, начинающийся с"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Указывает, что плагин должен игнорировать любые строки, начинающиеся с определенных символов. Это список, разделенный символами ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","Указывает, включать или не включать \"Режим совместимости с текстовым геттером\". Должен быть включен только в том случае, если этого требует игра."],["GameLog Text Paths","Пути к тексту журнала игр"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Указывает определенные пути для игровых объектов, которые игра использует в качестве \"компонентов журнала\", куда постоянно добавляет или дописывает текст. Требует специальных знаний для настройки. Это список, разделенный символом ';'."],["Romaji Post Processing","Постобработка Ромаджи"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","Указывает, какой тип постобработки следует выполнить для \"переведенных\" текстов Ромаджи. Это может быть важно в некоторых играх, поскольку используемый шрифт не поддерживает различные диакритические знаки должным образом. Это список, разделенный символом ';'. Возможные значения: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]."],["Translation Post Processing","Постобработка перевода"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Указывает, какой тип постобработки следует выполнять для переведенных текстов (не romaji). Возможные значения: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]."],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Указывает, следует ли выводить результаты поиска регулярных выражений в указанный выходной файл."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Указывает, следует ли выводить различия между пробелами в указанный выходной файл."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Указывает, следует ли выводить полный результат разбитых на регулярные выражения переводов в указанный выходной файл."],["Indicates that the plugin should generate translations without variables when using substitutions.","Указывает, что плагин должен генерировать переводы без переменных при использовании замен."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Указывает, что плагин должен генерировать частичные переводы для поддержки перевода текста по мере его \"прокрутки\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Указывает, что плагин должен анализировать директивы 'TARC' и переводить область видимости на их основе."],["Indicates the plugin should not print out success messages in relation to translations.","Указывает, что плагин не должен выводить сообщения об успехе в отношении переводов."],["Blacklisted IMGUI Plugins","Плагины IMGUI в черном списке"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","Если имя сборки/класса/метода окна IMGUI содержит любую из строк в этом списке (без учета регистра), этот UI не будет переведен. Требуются крючки MonoMod. Это список, разделенный символами ';'"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Указывает, следует ли выводить в указанный выходной файл тексты, которые плагин считает непереводимыми."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Указывает, что правила для вызовов виртуальных методов следует игнорировать при попытке задать текст текстового компонента. В некоторых случаях может помочь в настройке текста упрямых компонентов."],["Max Text Parser Recursion","Максимальная рекурсия синтаксического анализатора Текста"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Указывает, сколько уровней рекурсии разрешено при разборе текста, чтобы его можно было переводить по частям. Это может быть использовано с разделительными регексами в продвинутых сценариях. Значение по умолчанию, равное единице, означает, что рекурсия отключена."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Выполняет предварительную обработку и декодирование html-сущностей перед отправкой их на перевод. При отправке html-сущностей некоторые переводчики выходят из строя."],["Will enable automated handling of rich text (text with markup).","Позволит автоматически обрабатывать форматированный текст (текст с разметкой)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Указывает, следует ли включать полезные сообщения журнала, связанные с транслятором. Может быть полезно при переводе на основе перенаправленных ресурсов."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Указывает, что плагин должен использовать MonoMod hooks вместо harmony hooks."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Указывает, что плагин должен инициализировать harmony detour bridge, который позволяет harmony hooks работать в среде, где System.Reflection.Emit не существует (обычно такие настройки обрабатываются менеджерами плагинов, поэтому не используйте при использовании менеджера плагинов)."],["Redirected Resource Detection Strategy","Стратегия обнаружения перенаправленных ресурсов"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Указывает, должен ли плагин пытаться распознать перенаправленные ресурсы, чтобы предотвратить двойной перевод."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Указывает, должен ли плагин выводить текст, который превышает <b>'Максимальное количество символов в переводе'</b> не переводя."],["Texture","Текстура"],["Texture Directory","Каталог текстур"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Каталог для сброса текстур и корень каталога для загрузки изображений. Можно использовать заполнители: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Указывает, будет ли плагин пытаться заменить внутриигровые изображения изображениями из каталога TextureDirectory."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Указывает, будет ли плагин сбрасывать текстуры, которые он способен заменить, в TextureDirectory. Оказывает значительное влияние на производительность."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","Указывает, будет ли переключение перевода с помощью горячих клавиш ALT+T также влиять на текстуры. Не гарантируется работа для всех текстур. Оказывает значительное влияние на производительность."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Указывает, должен ли плагин сканировать текстуры при загрузке сцены. Это позволяет плагину найти и (возможно) заменить больше текстур."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Указывает, должен ли плагин пытаться подключить SpriteRenderer. Это отдельная опция, потому что SpriteRenderer не может быть подключен должным образом, и реализованное обходное решение может теоретически повлиять на производительность в определенных ситуациях."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Указывает, следует ли загружать немодифицированные текстуры. Модификации определяются на основе хэша в имени файла. Включайте этот параметр только в целях отладки, так как он может вызвать странности."],["Texture Hash Generation Strategy","Стратегия генерации текстурного хэша"],["Indicates how the mod identifies pictures through hashes.","Указывает, как мод идентифицирует изображения с помощью хэшей."],["Duplicate Texture Names","Дублирование названий текстур"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Указывает конкретные имена текстур, которые дублируются в игре. Список разделен ';'"],["Indicates if the plugin should detect duplicate texture names.","Указывает, должен ли плагин обнаруживать дублирующиеся имена текстур."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Указывает, что плагин должен использовать другую стратегию для загрузки изображений, что может быть актуально, если движок игры старый."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Указывает, что все загруженные текстуры должны храниться в памяти для оптимальной производительности. Отключите, чтобы уменьшить использование памяти."],["Resource Redirector","Перенаправление ресурсов"],["Preferred Storage Path","Предпочитаемый путь хранения"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Указывает предпочтительное хранилище для перенаправленных ресурсов по отношению к автоматическому переводчику. Можно использовать заполнитель: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","Указывает, следует ли перенаправлять TextAssets"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Указывает, должен ли плагин записывать в консоль все загруженные активы. Полезно для определения того, что может быть подключено"],["Indicates if translatable resources that are found should be dumped","Указывает, следует ли сбрасывать найденные переводимые ресурсы"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","Когда файлы находятся в ZIP-файлах в PreferredStoragePath, эти файлы индексируются в памяти, чтобы избежать выполнения IO проверки файлов при их загрузке. Включение этого параметра сделает то же самое для физических файлов"],["HTTP","HTTP"],["User Agent","User Agent"],["Override the user agent used by APIs requiring a user agent","Переопределите агент пользователя, используемый API, требующими агента пользователя"],["Indiciates whether certificate validations for the .NET API should be disabled","Указывает, следует ли отключить проверку сертификатов для API .NET"],["Translation Aggregator","Агрегатор переводов"],["Width","Ширина"],["The total width of the translation aggregator window","Общая ширина окна агрегатора переводов"],["Height","Высота"],["The width (per translator) of the translation aggregator window.","Ширина (для каждого переводчика) окна агрегатора переводов."],["Enabled Translators","Включенные переводчики"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","Идентификаторы конечных точек перевода, которые были включены в окне агрегатора переводов. Список разделен ';'"],["Google","Google"],["ServiceUrl","ServiceUrl"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","ВАРИАНТ, может использоваться для направления запроса API google на другой URL. Может использоваться для обхода GFWoC"],["Google Legitimate","Google Legitimate"],["Google API Key","Google API Key"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","НЕОБЯЗАТЕЛЬНО, необходимо, если настроен GoogleTranslateLegitimate"],["Bing Legitimate","Bing Legitimate"],["OcpApim Subscription Key","OcpApim Subscription Key"],["OPTIONAL, needed if BingTranslateLegitimate is configured","НЕОБЯЗАТЕЛЬНО, необходимо, если настроен BingTranslateLegitimate"],["Baidu","Baidu"],["Baidu App Id","Baidu App Id"],["OPTIONAL, needed if BaiduTranslate is configured","НЕОБЯЗАТЕЛЬНО, необходимо, если настроен BaiduTranslate"],["BaiduAppSecret","BaiduAppSecret"],["Yandex","Yandex"],["Yandex API Key","Yandex API Key"],["OPTIONAL, needed if YandexTranslate is configured","НЕОБЯЗАТЕЛЬНО, необходимо, если настроен YandexTranslate"],["Watson","Ватсон"],["Url","Url"],["OPTIONAL, needed if WatsonTranslate is configured","НЕОБЯЗАТЕЛЬНО, необходимо, если настроен WatsonTranslate"],["Key","Ключ"],["DeepL","DeepL"],["MinDelay","Мин. задержка"],["OPTIONAL, used for throttling DeepL","ОПЦИОНАЛЬНО, используется для регулирования DeepL"],["MaxDelay","Макс. задержка"],["DeepL Legitimate","DeepL Легитимный"],["OPTIONAL, required if DeepLLegitimate is configured","ОПЦИОНАЛЬНО, требуется, если настроен DeepLLegitimate"],["Custom","Пользовательский"],["Optional, needed if Custom Translated is configured","Необязательно, необходимо, если настроен пользовательский перевод"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","InstallationPath"],["Optional, needed if Lec Power Translator 15 is configured","Необязательно, необходимо, если настроен преобразователь мощности 15 Lec"],["Debug","Отладка"],["Enables the console. Do not enable if other plugins (managers) handles this","Включает консоль. Не включайте, если другие плагины (менеджеры) обрабатывают эту функцию"],["Enables extra logging for debugging purposes","Включает дополнительное ведение журнала для целей отладки"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","Путь установки ezTrans."],["Migrations","Миграции"],["Used to enable automatic migrations of this configuration file","Используется для включения автоматической миграции этого файла конфигурации"],["Tag","Тег"],["Tag representing the last version this plugin was executed under. Do not edit","Тег, представляющий последнюю версию, под которой был запущен этот плагин. Не редактировать"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":true,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","Для выполнения этого действия необходим переводчик XUnity\nПожалуйста, установите его через сторонний установщик приложений!"],["XUnity.AutoTranslator is found!","XUnity.AutoTranslator найден!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++ обнаружил, что XUnity.AutoTranslator уже установлен. Translator++ будет использовать существующие данные перевода для запуска нового проекта перевода."],["XUnity.AutoTranslator is not found!","XUnity.AutoTranslator не найден!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","Мастер проведет вас по установке XUnity.AutoTranslator в игру."],["Next","Следующее"],["Given path: ","Заданный путь:"],["\nis not an Unity game. Do you still want to proceed?","\nне является игрой Unity. Вы всё ещё хотите продолжить?"],["Patch successfully installed!\r\n","Патч успешно установлен!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","Конфигурация будет сгенерирована при первом запуске игры.\r\n"],["Open the game now?","Открыть игру сейчас?"],["Finish","Завершить"],["Update current project?","Обновить текущий проект?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":true,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","Максимальное количество строк в окне сообщения."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","Значение по умолчанию — 4. Введите 0, чтобы отключить эту функцию. Если количество строк в окне сообщения превышает это число, Translator++ создаст новое окно сообщения, чтобы предотвратить переполнение текстом."],["Use shell copy if possible","Использовать копирование через оболочку, если возможно"],["Use shell copy instead of native NodeJS copy handler.","Использовать копирование через оболочку вместо нативного обработчика копирования NodeJS."],["Use shell copy","Использовать копирование через оболочку"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","Редактор WRPGE не установлен\r\nПожалуйста, установите его из меню T++ > Установщик сторонних приложений\r\n\r\nОткрыть установщик сторонних приложений сейчас?"],["Unable to determina WRPGE path.","Не удалось определить путь WRPGE."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++ собирается установить редактор WRPGE в целевую папку.\r\nПродолжить?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Путь разработки не определен.\nВам следует внедрить вашу игру один раз, чтобы сгенерировать путь разработки."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","Переводите игры Wolf RPG до версии 3.330 с библиотекой WolfJs. Стандартный парсер Wolf RPG для Translator++."],["Wolf RPG Editor games","Игры Wolf RPG Editor"],["Parsing Wolf RPG Game with","Разбор игры Wolf RPG с"],["Wolf RPG Editor game","Игра Wolf RPG Editor"],["Select the game's executable file","Выберите исполняемый файл игры"],["Engine version","Версия движка"],["Detected WolfRPG Engine version of the selected game","Обнаруженная версия движка WolfRPG для выбранной игры"],["Heads up!\r\n","Внимание!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nне похож на исполняемый файл Wolf RPG!\r\nВы уверены, что хотите начать проект Wolf RPG с этой точки входа?"],["Create a new project","Создать новый проект"],["Please specify a game to be processed!","Пожалуйста, укажите игру для обработки!"],["Set dev path. Path to the directory of the translated game.","Установите путь разработки. Путь к каталогу переведенной игры."],["Play last build","Запустить последнюю сборку"],["Open editor","Открыть редактор"],["Open Wolf RPG Editor online manual","Открыть онлайн-руководство Wolf RPG Editor"],["Open Wolf RPG Editor english manual","Открыть английское руководство Wolf RPG Editor"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","Не удается найти файл руководства.\nПожалуйста, установите Wolf RPG Editor через установщик сторонних приложений."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":true,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","Начать перевод из XML-подобных документов. Поддерживает как XML, так и HTML форматы."],["Create project","Создать проект"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":true,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","Переводчик движка YU-RIS"],["Checking up requirements...","Проверка требований..."],["Create a new translation project from YU-RIS visual novel engine","Создать новый проект перевода из движка визуальных новелл YU-RIS"],["Next","Следующее"],["Select YU-RIS game","Выбрать игру YU-RIS"],["Select the game's executable file","Выбрать исполняемый файл игры"],["Engine version","Версия движка"],["Detected YU-RIS version of the selected game","Обнаружена версия YU-RIS выбранной игры"],["Create a new project","Создать новый проект"],["Invalid target game :","Неверная целевая игра:"],["Source material do not match the current translation project!","Исходный материал не соответствует текущему проекту перевода!"],["Select the repack method.","Выберите метод перепаковки."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>Перепаковать в исходные файлы YPF</b><br />Перепакует перевод в исходный пакет. Может потребоваться больше времени для извлечения исходного пакета, его патча переводом и повторной перепаковки.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>Перепаковать как файл патча YPF</b><br>Перепакует перевод как отдельный файл патча (например, update9.ypf). Таким образом, можно перевести игру, не изменяя исходные файлы ypf. Сочетайте это с опцией копирования материала <b>Не копировать материал, только внедрить перевод</b> для более быстрого процесса патчинга.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","Целевая версия перепаковки должна соответствовать версии вашей игры. Введите основную и второстепенную версию, разделенные точкой. Например: <b>0.466</b>. По умолчанию, Translator++ определит версию движка при создании проекта."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":true,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","Конструктор форм"],["Run","Запустить"],["New Project (ctrl+n)","Новый проект (ctrl+n)"],["Open (ctrl+o)","Открыть (ctrl+o)"],["Save file (ctrl+s)","Сохранить файл (ctrl+s)"],["Save As (ctrl+shift+s)","Сохранить как (ctrl+shift+s)"],["Open debugger (F12)","Открыть отладчик (F12)"],["Help","Справка"],["Select file in the current workspace","Выбрать файл в текущей рабочей области"],["file path","путь к файлу"],["Create shortcut of the current script","Создать ярлык текущего скрипта"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":true,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"parameters":[]},"/find.html":{"data":[["Find","Поиск"],["Replace","Замена"],["Put","Вставить"],["Target","Цель"],["Grid","Сетка"],["Context","Контекст"],["Tag","Тег"],["Comment","Комментарий"],["Untranslated rows","Непереведённые строки"],["Refine","Уточнить"],["Case sensitive","С учетом регистра"],["Transpile \\r\\n\\t","Транспилировать \\r\\n\\t"],["RegExp","RegExp"],["All files","Все файлы"],["Select All Columns","Выбрать все столбцы"],["Find all string above and replace with :","Найдите все строки выше и замените их на :"],["Original text:","Исходный текст:"],["Text to put :","Текст для вставки:"],["into: ","в:"],["Search all files","Поиск по всем файлам"],["Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)","Введите ключевое слово и нажмите Enter. Можно использовать шаблон glob (например: *.png)"],["Drag to select, Shift+Drag to unselect","Перетащите для выбора, Shift+перетащите для отмены выбора"],["Select target column","Выбрать целевой столбец"],["A line in the original text to find. Press alt+enter to add a new line.","Строка в исходном тексте для поиска. Нажмите alt+enter, чтобы добавить новую строку."],["Translation","Перевод"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":true,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","Не удалось найти файл, связанный с данными"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Чтобы исправить это, исправьте поле <b>Расположение исходных материалов</b> в <a href=\"#\" class=\"openProjectProperties\">Свойствах проекта</a>"],["Copy path to clipboard","Скопировать путь в буфер обмена"],["Path has been copied to clipboard.","Путь скопирован в буфер обмена."],["Open folder","Открыть папку"],["Open with external application","Открыть внешним приложением"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","Открыть с помощью..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~использовать перевод по умолчанию~"],["Column","Столбец"],["Do you want to delete all context translation on the currently selected row?","Вы хотите удалить весь контекстный перевод в выбранной строке?"],["Do you want to delete all translation on the currently active row?","Вы хотите удалить весь перевод в активной строке?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":true,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","недопустимый тип addonObj"],["invalid type addonObj.addons","недопустимый тип addonObj.addons"],["You are not eligible to get this addon","Вы не имеете права получить это дополнение"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":true,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Сначала сохраните текущий проект, прежде чем создавать ярлык для Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Эта функция доступна только при использовании версии Developer в Translator++. Вы можете переключиться на версию Developer с помощью Basic Utilities -> Change Core NWJS."]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/find.js":{"data":[["Action","Действие"],["Append tags","Добавить теги"],["Remove tags","Удалить теги"],["Set tags","Установить теги"],["Do nothing","Ничего не делать"],["Close","Закрыть"],["Proceed","Продолжить"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","Ключевое слово слишком короткое!\nПытаетесь найти все строки? Попробуйте использовать звёздочку '*' в качестве ключевого слова."],["Found nothing!<br />Don't forget to set the Target search field.","Ничего не найдено!<br />Не забудьте установить поле поиска цели."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","Заменять нечего!<br />Функция Замены ничего не заменяет в ключевом столбце."],["Replace '","Заменить '"],["' with '","' с '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'?\nМы до сих пор не создали функцию отмены для этой штуки!\nВы уверены, что хотите продолжить?"],["click to go","нажмите, чтобы продожить"],["This will replace any translation found in target colum,\nAre you sure?","Это заменит любой перевод, найденный в целевой колонке,\nВы уверены?"],["Keyword too short!","Ключевое слово слишком короткое!"],["Not found!","Не найдено!"],["Are you sure want to execute the following script?","Вы уверены, что хотите выполнить следующий скрипт?"],["For ","Для "],[" selected item(s)?"," выбранных элементов?"],[" Select all"," Выбрать все"],[" Invert selection"," Инвертировать выбор"],[" Clear selection"," Очистить выбор"],[" Set Red tag","Установить красный тег"],[" Set Yellow tag","Установить желтый тег"],[" Set Green tag","Установить зеленый тег"],[" Set Blue tag","Установить синий тег"],[" Set Gold tag","Установить золотой тег"],[" More tags..."," Больше тегов..."],[" Clear tags","Очистить теги"],[" Create Automation"," Создать автоматизацию"],[" Run Automation"," Запустить автоматизацию"],[" Clear Automation"," Очистить автоматизацию"],["Are you sure want to clear all quick launch scripts?","Вы уверены, что хотите очистить все скрипты быстрого запуска?"],[" Clear translation"," Очистить перевод"],["Do you want to clear translations of the selected items?","Вы хотите очистить переводы выбранных элементов?"],[" Delete rows"," Удалить строки"],["Do you want to remove selected rows?\nYou can not undo this action!","Вы хотите удалить выбранные строки?\nЭто действие нельзя отменить!"],[" With selection ..."," С выбором ..."],["Always on top","Всегда сверху"],["Default","По умолчанию"],["Blur opacity","Непрозрачность"],["Type regex with the modifier","Введите регулярное выражение с модификатором"],["Use $n to replace a group. e.g. $1","Используйте $n для замены группы. Например, $1"],["Find","Поиск"],["Replace","Замена"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":true,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","Скрыть пароль"],["Show password","Показать пароль"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":true,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","Некоторые конфигурации требуют перезапуска приложения, чтобы они вступили в силу.\nПожалуйста, сохраните свою работу и перезапустите Переводчик++."],["Pleae select the name for your configuration.","Пожалуйста, выберите имя для вашей конфигурации."],["Translator Engine configuration","Конфигурация движка переводчика"],["Translator engine version.","Версия движка переводчика."],["By.","с."],["No option for this engine","Нет опции для этого движка"],["License","Лицензия"],["Can not disable this addon","Нельзя отключить этот аддон"],["Requirements","Требования"],["What is this?","Что это?"],["Uninstall","Удалить"],["Update","Обновление"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","Дополнение успешно установлено.\r\nДля некоторых дополнений может потребоваться перезапуск Translator++."],["WARNING!\n","ВНИМАНИЕ!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","Это дополнение помечено как \"изменение парсера\". Ваши старые проекты, связанные с этим дополнением, могут перестать работать корректно. Рекомендуется сделать резервную копию проекта перед установкой.\nВы можете импортировать существующие переводы в новый проект.\n\nВы хотите установить "],["Do you want to install ","Вы хотите установить "],["Add-on","Дополнение"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","успешно установлено.\r\nДля некоторых дополнений может потребоваться перезапуск Translator++."],["Add-on version.","Версия дополнения."],["No option for this add-on","Нет опции для этого дополнения"],["Translator++ will write Window's registry.\r\nAre you sure?","Переводчик++ прописывается в реестр Window.\nВы уверены?"],["Error parsing patterns:","Ошибка при разборе шаблонов:"],["Do you really want to clear the custom escaper?","Вы действительно хотите очистить пользовательский экранировщик?"],["Do you really want to reset the custom escaper?","Вы действительно хотите сбросить пользовательский экранировщик?"],["You are currently on the latest version.\nDo you still want to update?","В настоящее время у вас последняя версия.\nВы всё ещё хотите обновиться?"],["This option will open your default browser to login.\nDo you want to continue?","Эта опция откроет ваш браузер по умолчанию для входа.\nВы хотите продолжить?"],["Login with Browser","Войти через браузер"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","Ваш браузер был открыт на <b>dreamsavior.net/gettoken/</b>.<br>Вход завершится автоматически после авторизации.<br><br>Если автоматический вход не сработает, скопируйте токен с этой страницы и вставьте его ниже:"],["There is no default translator selected.\nChange the default translator to Google!","Переводчик по умолчанию не выбран.\nИзмените переводчик по умолчанию на Google!"],["Change Stagging Path to :","Изменить путь привязки на :"],["Move the content of current Stagging Path into the new one?","Перенести содержимое текущего Stagging Path в новый?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","Аддон(ы) был(ы) установлен(ы).\nПереводчик++ необходимо перезапустить, чтобы изменения вступили в силу."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","Вы действительно хотите сбросить все настройки и вернуть Translator++ к значениям по умолчанию?\nОбратите внимание, что это действие необратимо.\nПожалуйста, создайте резервную копию вашего проекта перед продолжением."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","Translator++ может работать некорректно, если вы не исправите ошибку.\nВы хотите закрыть окно настроек?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":true,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Вам следует сохранить текущий проект перед созданием ярлыка для Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Эта функция доступна только при использовании версии Developer для Translator++. Вы можете переключиться на версию Developer с помощью Basic Utilities -> Change Core NWJS."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>Не удалось запустить интерпретатор PHP!</b><br />\n\t\t\t\tTranslator++ требует PHP CLI для выполнения некоторых обязательных процедур.<br />\n\t\t\t\tЭта ошибка обычно возникает, если на вашем компьютере <b>не установлена <a href=\"http://dreamsavior.net/download/#TPPSysreq\">правильная версия Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Пожалуйста, установите <a href=\"http://dreamsavior.net/download/#TPPSysreq\">необходимую среду выполнения</a>.</li>\n\t\t\t\t\t\t<li>И переместите каталог установки Translator++ в другую папку, если вы установили все среды выполнения, но ошибка сохраняется.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tПожалуйста, проверьте <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>документацию</a> для получения дополнительной информации об этой проблеме."],["Initialization Error!","Ошибка инициализации!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":true,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"parameters":[]},"/js/trans.js":{"data":[["Original Text","Оригинальный Текст"],["Initial","Первоначальный"],["Machine translation","Машинный"],["Better translation","Улучшенный перевод"],["Best translation","Лучший перевод"],["Loading","Загрузка"],["Error!","Ошибка!"],["Error processing init file : ","Обработка ошибок в файле init :"],["Error! File list not found in init file at : ","Ошибка! Список файлов не найден в файле init по адресу:"],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","Это означает, что ваша игра не была успешно обработана. Пожалуйста, посетите https://dreamsavior.net/?p=1311 для возможных решений этой проблемы."],["Done!","Готово!"],["All done!","Всё готово!"],["Error opening file : ","Ошибка открытия файла :"],["error opening file (open): ","ошибка открытия файла (open): "],["Project properties - Staging path error!","Свойства проекта - Ошибка пути стадии!"],["Project properties","Свойства проекта"],["untitled project","проект без названия"],["create file list","создать список файлов"],["Finished","Завершено"],["All process finished!","Все процессы завершены!"],["Open Explorer","Открыть проводник"],["Opening file!","Открыть файл!"],["Assigning new staging path : ","Назначение нового промежуточного пути :"],["Success!","Успех!"],["Failed!","Неудачно!"],["Collecting paths","Пути сбора"],["Path : '","Путь : '"],["' doesn't exist","' не существует"],[" file(s) collected!"," файл(ы) собраны!"],["Start importing data!","Начните импортировать данные!"],["Importing : ","Импорт :"],["All Done!","Всё готово!"],[" is not a valid object name","не является допустимым именем объекта"],[" is not a valid directory name","не является допустимым именем каталога"],[" is already exist"," уже существует"],["Error opening file :","Ошибка открытия файла:"],["Error executing :","Ошибка выполнения:"],["Are you sure want to execute the following script?","Вы уверены, что хотите выполнить следующий скрипт?"],["Clear quick launch","Очистить быстрый запуск"],["Are you sure want to clear quick launch?","Вы уверены, что хотите очистить быстрый запуск?"],["How to add Automation here","Как добавить автоматизацию здесь"],["Select all","Выбрать все"],["Clear selection","Очистить выделенное"],["Select 100%","Выберите 100%"],["Select <100%","Выберите <100%"],["Select progress ≥ ...","Выбрать прогресс ≥ ..."],["Select completed","Выбрать завершённые"],["Invert selection","Инвертировать выбор"],["Toggle mark as complete","Переключить отметку как завершённое"],["With all","Дополнительно"],["With ","С"],[" selected","выбранным"],["Mark as complete","Отметить как завершённое"],["Un-mark as complete","Снять отметку завершённого"],["Batch translation","Пакетный перевод"],["Send to...","Отправить в..."],["Wrap texts","Перенос текстов"],["Trim","Trim"],["Auto padding","Автозаполнение"],["Context Tool","Контекстный инструмент"],["Create Automation","Создать автоматизацию"],["For each object","Для каждого объекта"],["For each row","Для каждой строки"],["Run Automation","Запустить автоматизацию"],["Import from...","Импорт из..."],["Trans File","Транс Файл"],["Spreadsheets","Электронные таблицы"],["RPGMTransPatch Files","Файлы RPGMTransPatch"],["Export into...","Экспортировать в..."],["A folder","Папку"],["Zipped Game Patch","Игровой патч в архив"],["Comma Separated Value (csv)","Значение, разделенное запятыми (csv)"],["Excel 2007 Spreadsheets (xlsx)","Электронные таблицы Excel 2007 (xlsx)"],["Excel Spreadsheets (xls)","Электронные таблицы Excel (xls)"],["ODS Spreadsheets","Электронные таблицы ODS"],["Html Spreadsheets","Электронные таблицы Html"],["RMTrans Patch","Патч RMTrans"],["Inject Translation","Внедрить перевод"],["Revert to original","Вернуть к оригиналу"],["Clear translation","Очистить перевод"],["Delete files","Удалить файлы"],["Properties","Свойства"],["Select progress greater than","Выбрать прогресс больше чем"],["Please input a number","Пожалуйста, введите число"],["Do you want to clear translation?","Вы хотите очистить перевод?"],["Add comment","Добавить комментарий"],["Remove comment","Удалить комментарий"],["added to reference table!","добавлено в справочную таблицу!"],["Can not modify Column 0","Невозможно изменить колонку 0"],["Unable to delete table : ","Невозможно удалить таблицу :"],["Can not remove key column!","Невозможно удалить ключевую колонку!"],["Please open or create a project first","Пожалуйста, сначала откройте или создайте проект"],["Column name can not be empty!","Имя столбца не может быть пустым!"],["Invalid column index!","Неверный индекс столбца!"],["Please open or create a new project first!","Пожалуйста, сначала откройте или создайте новый проект!"],["You should not edit key value","Не следует редактировать ключевое значение"],["Ilegal value","Законное значение"],["That value already exist!","Это значение уже существует!"],["The maximum number of columns for this project has been reached, so you cannot add any more.","Максимальное количество столбцов для этого проекта достигнуто, поэтому вы не можете добавить больше."],["Are you sure want to abort this process?","Вы уверены, что хотите прервать этот процесс?"],["Process paused!\nPress OK to continue!","Процесс приостановлен!\nНажмите OK для продолжения!"],["Unable to process, project not found","Невозможно обработать, проект не найден"],["Unable to process, data not found","Невозможно обработать, данные не найдены"],["Translation engine not found","Движок для перевода не найден"],["Translation engine ","Движок для перевода"],[" is disabled!"," отключен!"],["Selected files :","Выбранные файлы :"],["Collecting data from :","Сбор данных из :"],["Translation finished","Перевод завершён"],["applying translation to table!","применение перевода к таблице!"],["Error when translating data!","Ошибка при переводе данных!"],["\tHTTP Status : ","\tСтатус HTTP : "],["\tError Type : ","\tТип ошибки : "],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","Скорее всего, ваш сервис перевода временно заблокировал вас!\nПожалуйста, используйте онлайн-сервис перевода в умеренных количествах\nОбычно это исправляется само собой в течение дня или двух.."],["Running trans.translateAll","Выполнение trans.translateAll"],["Start collecting data!","Начните сбор данных!"],["Data collection is done!","Сбор данных завершён!"],["nothing is selected","ничего не выбрано"],["no translator loaded","переводчик не загружен"],["unable to load translator window","unable to load translator window"],["Reference path cannot empty!","Путь не может быть пустым!"],["Collecting translation refference","Сбор информации о переводе"],["Applying translation!","Применение перевода!"],["Importing translation","Импорт перевода"],["Parsing data","Анализ данных"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions","не является допустимым регулярным выражением javascript!\nУзнайте больше о регулярном выражении Javascipt на сайте :\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"],["Keyword too short!","Ключевое слово слишком короткое!"],["Delete comment","Удалить комментарий"],["Translate here","Перевести здесь"],["Translate here using ","Переведите здесь, используя "],["Translate using...","Перевести с помощью..."],["Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?","Вы хотите перевести все одинаковые тексты в этом проекте с переводом из выбранной ячейки(ячеек)?"],[" cell(s) has been written!"," ячейка(ячейки) записана(ы)!"],["Column width","Ширина колонки"],["Width must greater than 0","Ширина должна быть больше 0"],["Insert column right","Вставить колонку справа"],["Duplicate column","Дубликат колонки"],["Remove this column","Удалить эту колонку"],["Remove selected column?\nThis can not be undone!","Удалить выделенную колонку?\nЭтого уже не отменить!"],["Rename this column","Переименовать эту колонку"],["Please enter new name","Пожалуйста, введите новое имя"],["Tags","Теги"],["Red","Красный"],["Yellow","Желтый"],["Green","Зеленый"],["Blue","Синий"],["Gold","Золотой"],["More tags...","Ещё теги ..."],["Clear tags","Очистить теги"],["Delete Row","Удалить строку"],["Do you want to remove the currently selected row(s)?","Вы хотите удалить выбранную(ые) строку(строки)?"],["Clear Context Translation","Очистить контекстный перевод"],["Clear Automation","Очистить автоматизацию"],["Are you sure want to clear all quick launch scripts?","Вы уверены, что хотите очистить все скрипты быстрого запуска?"],["Append rows to reference","Добавить строки в справочник"],["