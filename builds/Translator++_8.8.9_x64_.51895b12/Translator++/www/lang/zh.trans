ype/StringLiteral"],["tid/69208/type/StringLiteral"],["tid/69382/type/TemplateHead","tid/70089/type/TemplateHead"],["tid/69384/type/TemplateTail","tid/70091/type/TemplateTail"],["tid/69811/type/StringLiteral"],["tid/70151/type/StringLiteral"],["tid/74815/type/StringLiteral"],["tid/74898/type/StringLiteral"],["tid/75985/type/StringLiteral"],["tid/77908/type/StringLiteral"]],"basename":"ui.js","dirname":"/js","extension":".js","filename":"ui.js","path":"/js/ui.js","indexIsBuilt":true,"indexIds":{"`You cannot close the application at this moment, reason: \\n${":0,"}`":1,"Do you really want to exit Translator++?\nAll unsaved changes will be discarded!":2,"Trans file":3,"Translator++ Project Package (TPP) file":4,"Select all":5,"Select none":6,"Invert":7,"Match destination selection":8,"use mouse drag to do bulk selection":9,"Invalid trans data":10,"Inject / Apply translation":11,"Inject / Apply translation to all":12,"Cancel":13,"Apply Translation":14,"Target path cannot be a parent or child of the source material's path.\nPlease select another path.":15,"Help":16,"Import":17,"Revert to origin data":18,"Select target directory.":19,"The existing files will be overwritten!":20,"Process":21,"Path to the directory can not be empty!":22,"Invalid directory:":23,"Rebuild translation table from this cache":24,"Create new project":25,"-nothing-":26,"Ok":27,"No action selected, are you sure?":28,"No context's keyword specified!":29,"Remove context containing keyword :\n":30,"\nfrom selected files?":31,"Remove every rows except rows that has a context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","你可以在控制台日志中查看更多细节 (F12)"],["Close","关闭"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","你可以在控制台日志中查看更多细节 (F12)"],["Close","关闭"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.parts.js":{"data":[["Form","表单"],["Cancel","取消"],["Ok","Ok"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":true,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","移除标注"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/login.html":{"data":[["working","加载中"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":true,"indexIds":{"working":0},"tags":[],"parameters":[]},"/note.html":{"data":[["Remove note","移除标注"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/options.html":{"data":[["Click to login","点击登录"],["Translator &amp; Language","翻译引擎 &amp; 语言"],["Proofreader","校对员"],["Assistant","助手"],["General","通用"],["Preferences","偏好"],["Add-ons","插件"],["About","关于"],["User Information","用户信息"],["Login to your Patreon account to get access to the latest features and updates.","登录你的Patreon账号来获取最新更新及功能."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> 登录"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> 通过浏览器登录"],["Welcome,","欢迎,"],["Name","名称"],["Email","Email"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","付费状态 <div class=\"infoHeadNote\">(Current payment status)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">请放心!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">出现这个标志，表示Patreon网站暂时还未收到您的赞助资金.支付系统有延迟是很正常的现象. 根据您的支付方式和所在国家或区域的不同，延迟最长可能会达到24小时.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">在这期间，您的信用卡可能会收到扣款信息. 请放心—Patreon会定期检测是否收到了您的捐赠. 该问题通常会在24小时内自行解决.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">如果超出期限后此问题仍然存在，请联系Translator++的Discord <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" 里的\"\">account-problem</a>频道. 我会尽可能帮助你解决问题.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">设置这些流程是为了防止诈骗行为，请谅解,在收到您的Patreon捐赠之前， <b><span class=\"userInfoPoints\">points</span> 和 <span class=\"userInfoLevel\">Level</span> 都不会开始计时</b>.</p>\n"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">请放心!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","出现这个标志，表示Patreon网站暂时还未收到您的赞助资金.支付系统有延迟是很正常的现象. 根据您的支付方式和所在国家或区域的不同，延迟最长可能会达到24小时."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","在这期间，您的信用卡可能会收到扣款信息. 请放心—Patreon会定期检测是否收到了您的捐赠. 该问题通常会在24小时内自行解决."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","如果超出期限后此问题仍然存在，请联系Translator++的Discord <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" 里的\"\">account-problem</a>频道. 我会尽可能帮助你解决问题."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","设置这些流程是为了防止诈骗行为，请谅解,在收到您的Patreon捐赠之前， <b><span class=\"userInfoPoints\">points</span> 和 <span class=\"userInfoLevel\">Level</span> 都不会开始计时</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> 登出"],["Primary Translator","翻译基础设置"],["Default Translator Engine","默认翻译引擎"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\t当按下 <span class=\"keyboardHint\">Ctrl+g</span> 的时候会自动调用该引擎进行翻译，其结果会被放在 <strong>当前</strong>单元格中.\n\t\t\t\t"],["Default Language","默认语言"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\t对整个工程进行基本的语言定义!<br>\n\t\t\t\t但是在项目属性里设置的语言会覆盖这里的效果.\n\t\t\t"],["Default Source Language","默认初始语言"],["Default Target Language","默认目标语言"],["Custom escape","自定义忽略文本"],["Patterns","模式"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\t所有下列高亮的文本，在使用机器翻译的过程中都会被忽略. \n\t\t\t\t\t\t该功能可以让翻译引擎在翻译时规避特定标记以及脚本代码. <br>\n\t\t\t\t\t\t输入的规则代码应符合JavaScript的正则表达式规则，多段规则用半角逗号“,”隔开<b>comma</b>.<br>\n\t\t\t\t\t\t仅<a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">支持自定义忽略功能</a>.\n\t\t\t\t\t\t<b>Hint:</b>您也可以利用ChatGPT协助撰写正则表达式. <br>\n\t\t\t\t\t\t请在编写正则表达式时正确使用修饰符.<br>\n\t\t\t\t\t\t例如 :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\t\n"],["Tester","测试器"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\t在此处粘贴文本以检查模式。\n\t\t\t\t\t\t所有匹配的模式将被高亮显示。\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>正在建设中</h2>\n\t\t\t\t<p>此区域将用于配置自动校对设置和选项。</p>\n\t\t\t"],["AI Assistant","AI助手"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>嗨！我是MIRAI，您的Translator++ AI助手。👋</strong></p>\n\t\t\t\t\t\t<p>只需点击主菜单上的图标 <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> 即可与我聊天。我可以协助您：</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>翻译改进和建议</li>\n\t\t\t\t\t\t\t<li>校对和质量检查</li>\n\t\t\t\t\t\t\t<li>设置翻译工作流程</li>\n\t\t\t\t\t\t\t<li>创建自动化脚本</li>\n\t\t\t\t\t\t\t<li>以及更多！</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>让我们一起让您的翻译工作更轻松高效！</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. 我还是新手，所以请对我耐心点。🙇‍♀️ 但我每天都在学习和进步！😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","AI配置"],["Model Endpoint","模型端点"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","AI模型的API端点URL。例如：https://api.openai.com/v1/chat/completions"],["API Key","API密钥"],["Your API key for authenticating with the AI service. This will be stored securely.","用于AI服务身份验证的API密钥。将安全存储。"],["Model Name","模型名称"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","选择或输入要使用的AI模型。推荐使用支持工具功能的模型以获得最佳效果。"],["File Association","文件关联"],["Extension","拓展名"],["Associate","是否关联"],["Set All","全选"],["Unset All","全不选"],["Apply","应用"],["Update","更新"],["Auto update","自动更新"],["Automatically update Translator++ if possible.","自动更新Translator++."],["Allow reinstall the same version","允许更新到相同版本"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","允许Translator++zai相同版本之间进行更新. 请在正确更新之后关闭这项功能，尤其是在 <b>自动更新</b>选项开启的时候. 否则每当打开Translator++，软件都会进行更新."],["Use default browser to login","使用默认浏览器来登录"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","使用你系统默认的浏览器进行账号登录操作. 如果不勾选此项, Translator++将会使用内置浏览器进行登录."],["Multi threading","多线程"],["Number of thread","线程数量"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","可以设置软件同时使用的线程数量.<br>\n\t\t\t\t\t\t\t0 = 禁用多线程. 所有操作都会通过单线程完成.<br>\n\t\t\t\t\t\t\t该项值推荐为你电脑的CPU线程数量-1."],["Backup","备份"],["Enable backup","允许备份"],["Automatically create backup every time you save your project.","每当您主动保存时，都会自动生成一份备份文件。"],["Backup level history","备份程度"],["How many history of backup do you want to keep?","您想要保留多少份备份文件？"],["Log &amp; Debugging","日志 &amp; Debugging"],["Log to file","用文件保存日志"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","将原本显示在调试器中的日志代码用文件保存.<br>这在测试Translator++功能时尤为有用，利用该功能可以避免打开调试器. 启用该选项会对性能产生轻微影响. 所以除了在测试功能时，请您保持该功能处于关闭状态.<br>日志将存储在 data/logs/ 文件夹下."],["Truncate log file each session","独立日志"],["When checked your log file will be truncated each time you re open the application.","每次打开该程序时，都会中断日志并独立生成文件."],["Application Settings","应用程序设置"],["Enable remote debugging","启用远程调试"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","在端口9222上启用Chrome DevTools远程调试协议。这允许您通过导航到<code>chrome://inspect</code>使用外部浏览器检查和调试Translator++。此标志将<code>--remote-debugging-port=9222</code>添加到应用程序启动参数中。需要重启以应用更改。"],["Disable GPU","禁用GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","禁用硬件GPU加速。如果在某些图形硬件或驱动程序上遇到视觉故障、崩溃或渲染问题，这很有用。此标志将<code>--disable-gpu</code>添加到应用程序启动参数中。需要重启以应用更改。"],["Dangerous Area","警告：危险区域"],["Interface Language","界面语言"],["UI Language","UI 语言"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","设置软件显示的语言. 如果你的语言没有被支持，你可以自己定义Translator++的语言. 语言文件数据存放在 www/lang文件夹里."],["Spell checker Language","拼写检查语言"],["Set the default spell checker language.","设定基础拼写检查的语言类型."],["Environment Variables","环境变量"],["Staging Directory","缓存目录"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","Translator++会对正在进行的工程进行缓存. 部分游戏内的数据文件会被复制到这个目录中，供程序提取和调用."],["Project creation","工程创建"],["Auto Load Common Reference","自动加载公共引用词库"],["Auto load common reference from .trans file.","将自动从 .trans 文件中加载公共词条."],["Project settings","工程设置"],["Progress Column Indices","进度列索引"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","在这里，您可以指定哪些列将会包含在工程进度计算之内。\n\t\t\t\t\t\t\t<br>该功能所指的“列”是自0开始的整数，最左侧的列为第0列.\n\t\t\t\t\t\t\t<br>如果要指定多列，请用半角逗号隔开，例如: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>默认为空</b>. 如果该栏为空，Translator++将会统计所有列.\n"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>开启/禁用"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>安装"],["Install from a package","从补丁中安装"],["Visit our website &amp; documentation : ","访问官网 &amp; 说明网页 : "],["Fork Translator++ at : ","在以下位置分叉Translator++："],["Support Translator++ at : ","支持 Translator++ : "],["Join our discord channel at : ","加入Discord频道："],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*)如果您是赞助者，您可以通过 <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\">来绑定您的discord账号</a>. 您会自动收到邀请，并且得到一些奖励。!"],["Version Info","版本信息"],["Last checked at : ","最近一次检查更新时间 : "],["Check now!","立即检查!"],["You have a pending update","你有错过的更新"],["Update now","现在更新"],["Your Translator++ is up to date 😃.","你的Translator++是最新版本的😃."],["Architecture","架构"],["License","许可"],["Click here to read the license.","单击以阅读许可声明."],["Credits","积分"],["Localization","本地化"],["About Third Party Software","关于第三方插件"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\t本软件使用位于 /3rdParty 的第三方软件。  这些第三方软件拥有自己的许可证，\n\t\t\t\t本软件为了方便起见使用了这些第三方软件，\n\t\t\t\t并且未对这些第三方软件进行任何修改。使用此类软件的风险由您自行承担。\n\t\t\t\t"],["Special Thanks","特别鸣谢"],["Want to explicitly support Translator++ by putting your name on this section?","希望在Translator++上署上自己的名字吗?"],["Click here to learn more about how to do that!","单击这里可以找到方法!"],["Changelog","更新说明"],["Feeds","Feeds"],["Click connect button, to connect translator with Translator++ table","Click connect button, to connect translator with Translator++ table"],["working","加载中"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","赞助等级/你目前的每月赞助等级是 (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","点数积分/你通过赞助累计获得的积分 (1 USD = 100 pts)"],["Filter...","筛选..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":true,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"parameters":[]},"/scriptEditor.html":{"data":[["Run","运行"],["New Project (ctrl+n)","新建项目 (ctrl+n)"],["Open (ctrl+o)","打开 (ctrl+o)"],["Save file (ctrl+s)","保存文件 (ctrl+s)"],["Save As (ctrl+shift+s)","另存为 (ctrl+shift+s)"],["Open debugger (F12)","打开调试器 (F12)"],["Help","帮助"],["Select file in the current workspace","在当前工作区域选择文件"],["file path","文件路径"],["Create shortcut of the current script","为当前脚本创建快捷方式"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":true,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"parameters":[]},"/tableEditor.html":{"data":[["Reset","重置"],["Clear","清除"],["Search","搜索"],["Help","帮助"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":true,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"parameters":[]},"/trans.html":{"data":[["Start","开始"],["Home","主界面"],["Translator","翻译器"],["Objects","项目"],["Live translation","在线翻译"],["Original","原文"],["Raw","源代码"],["Row Properties","行属性"],["Default translation","默认翻译"],["Context translation","区分翻译"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\t翻译器无法识别路径 <a class=\"problemPath\"></a>.<br>\n\t\t请保持路径中不要出现中文字符.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>位置</span>"],["File :","文件 :"],["Row ID :","行 ID :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>上下文</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>角色</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>关键文本</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>最佳翻译</span>"],["File ID","文件 ID"],["Path","缓存"],["Original Format","原始格式"],["Data Length","数据长度"],["Translated","已翻译"],["General","通用"],["Language","语言"],["Staging","路径"],["Stats","统计"],["Advanced","高级"],["Info","关于"],["Title","标题"],["File Location","文件地址"],["Project ID","工程 ID"],["Built on","建立于"],["Editor Name","编辑器名"],["Editor Version","编辑器版本"],["Engine","引擎"],["Parser","解码器"],["Parser version","解码器版本"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","原文件位置 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"最初始的游戏文件位置. 最好不要对这个文件夹进行任何操作.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> 无效路径.<br>某些功能将在这个问题修复之后才能实现."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","译文文件位置 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"翻译之后的文件将要放置的位置. 注入游戏时会默认选择这里.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","翻译软件 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"预先为工程设定翻译软件. 如果为空，则将使用全局翻译软件设定.\"></i>"],["Translate From","原语言"],["Translate Into","翻译语言"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","缓存路径 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"当导出/注入翻译文本的时候将会从缓存中调取数据. 缓存文件在创建工程时就创建完成了.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","文件数量 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"在左侧栏显示的所有文件的数量\"></i>"],["Folders","文件夹"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","字符数 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"对原文列中的所有字符进行统计\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","单词数 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"对于不使用半角字符的语言可能统计有误 (例如. 日语, 中文).\"></i>"],["Total Rows","总行数"],["Translated row","已翻译行数"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","总翻译进度 <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","导出后运行<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"在此项目成功导出后运行一个JavaScript函数。\"></i>"],["Display this information when the project is opened.","该信息会在工程打开时弹出."],["Select Export Mode","选择导出模式"],["Export to a folder","导出到文件夹"],["Export pre-compiled game data to a folder<br>Folder structures are retained","将编译好的游戏文件导出到文件夹<br>子文件夹会保留"],["Export as a Zip file","导出到Zip压缩文件"],["Export pre-compiled game data to a single zipped archive","将编译好的游戏文件导出到一个压缩文件中"],["RPGMakerTrans Patch Files","RPGMakerTrans 文件包"],["Export to RPGMakerTrans formatted *.txt files in a folder","以RPGMakerTrans 专用的 *.txt 文件形式导出到文件夹"],["Comma Separated Values","CSV数据格式"],["Export to Comma Separated Values (csv) files in a folder","将数据以CSV格式导出到文件夹"],["Office Open XML (.xlsx) Excel 2007 and above","XML(.xlsx)格式（Excel2007及以上版本）"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","以Microsoft Excel 电子表格(xlsx)形式导出到文件夹"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) （Excel97及以上版本）"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","以Microsoft Excel 电子表格(xls)形式导出到文件夹"],["HTML Spreadsheet","HTML 电子表格"],["Export to HTML files in a folder","以HTML文件形式导出到文件夹"],["Open Document Format/OASIS (.ods)","Open Document Format/OASIS (.ods)"],["Export to ODS files in a folder","以ODS文件形式导出到文件夹"],["Select Import Mode","选择导入模式"],["Import translation from another .trans file","从其他的.trans文件导入"],["Open another Translator++ file<br>Apply translation into current project.","打来另一个Translator++文件<br>将翻译应用于该工程中."],["Import translation from spreadsheets","从电子表格导入翻译"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","从各种各样的表格文件导入翻译<br>(.xls, .xlsx, .ods, .html, .xml, etc)"],["Import translation from RPGMakerTrans Patch format","从RPGMakerTrans Patch format导入翻译"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","从RPGMaker Trans' patch 文件导入翻译<br>(.txt)"],["Source :","源文件 :"],["Select objects to import","选择需要导入的文件"],["Import mode :","导入模式 :"],["Import translations","导入翻译"],["Import data object","导入源数据"],["Destination :","目标 :"],["Currently selected : ","已选项目 : "],["Options :","选项 :"],["Import the context translations","导入地址翻译"],["Case insensitive","不区分大小写"],["Overwrite target","覆盖已有文本"],["Destination column : ","目标列 : "],["Translation mode :","翻译模式 :"],["Row by row translation","对应原文翻译"],["Line by line translation","对应行翻译"],["Select translation by context address","对应代码物理地址翻译"],["Just copy translation into the same row (No checking)","仅将翻译导入至相同行 (跳过检查)"],["Merge data","合并数据"],["Import translation from spreadsheet into project","从电子表格中导入翻译"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","从表格类文件中导入翻译 (xls, xlsx, odx, html, csv等)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>这些表格类文件至少需要有2列.</b> 表格内的第一列尤为重要(最左列)，其应包含原文文本. 其余列为译文文本. Translator++会以每行最右侧的文本作为最终译文."],["Please click the radio button to select files/folder to import","请勾选按钮来选择要导入的文件/文件夹"],["Import file(s)","导入文件"],["Import folder","导入文件夹"],["Import translation from RPG Maker Trans into project","从 RPG Maker Trans 导入翻译"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">选择项目种类</span>"],["Select project type","选择项目种类"],["Spreadsheet","数据表"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","从一个电子表格中新建工程 (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","空白工程"],["Create a new .trans file from scratch.","创建一个新的.trans文件."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">电子表格</span>"],["Fetch type","获取类型"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","第一列为可能需要翻译的文本, 剩下的列为翻译好的译文 (请尽量使数据格式与原文相同)"],["All columns are translatable text","所有列均为可翻译文本"],["Custom","自定义"],["Custom Options","自定义设置"],["Which column do you want to fetch?","想要提取哪一列的数据?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","请指定要获取的列和要将翻译放入的列. <b>阿拉伯数字表示(最左列为第0列)</b>."],["Column to be translated","需要翻译的列"],["Column to put translation into","译文放置列"],["Action","操作"],["Enable Row Header Text Column","启用行标题文本列"],["If enabled, the parser will process the following Row Header Text Column rule","如果启用，解析器将处理以下行标题文本列规则"],["Row Header Text Column","行标题文本列"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","如果指定，此列中的值将应用于行标题。这对于确定当前说话者或角色等很有用。它是从零开始的索引。"],["Options","选项"],["Calculate cell value","计算单元格数值"],["Cell value in the form of formula will be transpiled","这将会读取含有公式的单元格内的最终数值"],["Get formatted value","获取单元格属性"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","读取格式信息后再处理数据. (比如，某些格式下，数字100000将会转换为USD 100,000)"],["Parse CSV in EXCEL format","在EXCEL中解析CSV文件"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","强制使用Excel来解析Csv文件. (仅针对CSV文件)"],["Skip the first <i>n</i> row(s)","跳过前 <i>n</i> 行"],["Use this option if you want to skip the row header.","想要跳过表头时可以使用此功能."],["Select File(s)","选择文件"],["Select a directory","选择目录"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">新建翻译文件</span>"],["Create a new Trans file","新建一个Trans文件"],["The title of this project","工程标题"],["Engine type","引擎种类"],["Type of the engine","引擎种类"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">暂时占用，将来会投入新功能!</span>"],["Placeholder for something great at the near future!","占位用，将来会有新的功能!"],["This module will be created when the patron count reach 500!","该功能将会在支援者达到 500 的时候解锁!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\t缓存内已经有工程名为 <br>\"<span class=\"dialogGameTitle\"></span>\"<br>的同名工程存在了.<br>\n\t\t您可以读取旧缓存来缩短读取时间.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","如果您不理解，点击 <strong><a href=\"#\">\"新建一个工程\"</a></strong>按钮是最为稳妥的方法. "],["Existed cache","缓存已存在"],["Select Translator","选择翻译引擎"],["Source column","原文列"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","哪一列是需要翻译的文本?<br>(默认为 选定列/最左侧的列)."],["Target column","目标列"],["Which column is the translated text put into.<br>(Can not same with source column)","将翻译好的文本放在哪一列.<br>(无法与原文列相同)"],["Translator's Options","翻译器设置"],["Also try to translate other object","同时翻译整个工程"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","如果这项功能被勾选，那么Translator++将会对整个工程都进行翻译，即使有些并不需要翻译. 该功能在2.3.23版本以及更低是默认开启的."],["Ignore if already translated","如果已有翻译则跳过"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果这项功能被勾选，Translator++将会忽略一切译文栏有内容的行."],["Overwrite cells","覆盖单元格"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","覆盖已有内容. 如果不勾选，那么所有非空的单元格将会被保留."],["Save project on each batch.","每次翻译完成后都自动保存文件."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","每阶段翻译完成后都会保存文件.<br>这项功能是为了防止在大量在线翻译过程中丢失数据的. 如果你使用云翻译的话可能用不着这项功能."],["Play sound when completed.","完成时播放声音."],["Tags","标记"],["Select Context(s)","选择上下文"],["Manual Query","人工输入"],["Match all words","全文匹配"],["Remove selected","删除所选"],["Remove all but selected","删除所有，保留所选"],["Select Context","选择地址"],["Source Column","原列"],["Target Column","目标列"],["Maximum length","最长长度"],["Export into","输出至"],["What to do with tagged rows?","如何处理标记列?"],["Select Color Tag","选择标记颜色"],["On the fly word wrap","动态换行"],["Inject all files (ignoring selection)","注入所有文件(忽略选择)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","您即将通过<b>全部注入</b>功能注入文本. 这将会无视您左侧勾选的文件，全部进行注入. 如果您只想注入特定文件，请通过右键选定的文件出现的菜单进行操作"],["Select the source material to be translated","选择需要翻译的原文"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\t选择您希望翻译的特定材料或内容，例如文件、目录或其他相关输入。确保所选材料可访问且格式适合相应的解析器。<br>\n\t\t\t\t默认情况下，一些解析器使用暂存目录作为源材料。\n\t\t\t"],["Path is inaccessible.","路径无法访问."],["Target Directory","目标路径"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\t将会在该位置生成注入翻译之后的游戏的副本.\n\t\t\t"],["Field can not be empty!","路径不可为空!"],["Target to apply translation","选择应用翻译的目标"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\t请选择可执行文件.\n\t\t\t"],["Copy materials","复制原文件"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","从原文件复制到目标文件夹. (测试功能，非所有引擎都能使用)"],["Word Wrap by Tags","根据标记自动换行"],["Directory name","路径名字"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\t对象将在此目录下分组。<br>\n\t\t\t\t输入星号 \"<code>*</code>\" 以添加新的 <b>参考对象</b>。\n\t\t\t"],["Invalid directory  name","目标路径非法"],["Object name","工程名字"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\t该工程的名字.\n\t\t\t"],["Invalid object name","工程名字非法"],["New Project","新建工程"],["Save","保存"],["Save as...","另存为..."],["Open...","打开..."],["Recent","最近"],["None...","没有..."],["Export Project","导出工程"],["To a folder","导出到文件夹"],["As a zip file","以Zip文件形式"],["To portable .tpp file","导出到.tpp文件"],["To RPGMakerTrans file (*.txt)","导出到RPGMakerTrans文件 (*.txt)"],["To CSV file","导出到CSV文件"],["To XLSX file","导出到XLSX文件"],["To XLS file","导出到XLS文件"],["To ODS file","导出到ODS文件"],["To HTML file","导出到HTML文件"],["Import","导入"],["Project from .tpp file","从.tpp文件"],["Translation from .trans file","从.trans文件导入翻译"],["Translation Spreadsheet","电子表格"],["Translation RPGMKTRANSPATCH Format","RPGMKTRANSPATCH Format"],["Automation","自动批处理"],["Batch translation","机器翻译"],["Context tool","上下文工具"],["Batch word wrapping","批量自动换行"],["Trim","自动首行对齐"],["Auto padding","自动原文对齐"],["Tools","工具"],["Third Party Application Installer","第三方插件安装器"],["Close project","关闭工程"],["Exit","退出"],["Start here","从这里开始"],["Start a New Project","创建新的工程"],["Continue your work","读取工程"],["Open Project","打开工程"],["Your recent translation","近期翻译"],["Tips for you","小提示"],["Next tip! <span class=\"icon-angle-double-right\"></span>","下一条小提示! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","应用翻译时越靠右边的文本优先级越高."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","你无法简单通过Trans格式文件与其他人共享翻译. 你需要生成一个 TPP 文件才行."],["Always make backups of your trans files.","在翻译过程中要注意随时备份."],["You can rename and reorder the column with the coulumn header's context menu.","你可以随时对列名进行编辑，也可以随时对列的位置进行调整."],["Always backup your game before working with Translator++!","在使用Translator++创立工程时，请注意备份原版游戏!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","如果某项功能没有正常运行, 那么尝试重启Translator++, 这会解决绝大多数的问题."],["Always create a backup of your game before patching with a translation.","在使用Translator++注入游戏文本时一定要注意备份游戏!"],["Thank you for supporting Translator++.","感谢您支持Translator++."],["Please check Translator++'s online documentation at","请在这个网站确认Translator++的帮助说明"],["working","加载中"],["Open","打开"],["Save file","保存"],["Save As","另存为"],["Import Project","导入工程"],["Inject / apply all translation","注入 / 应用 全部翻译"],["Execute Global Level Custom Script","运行全局自定义代码"],["Toggle Active Cell Info","切换活动单元格信息面板"],["Project Properties","工程属性"],["Get Help (F1)","获取帮助 (F1)"],["Batch translation (crl+b)","批量翻译 (ctrl+b)"],["File list","文件列表"],["Live Translation Pane","在线翻译面板"],["Toggle selection","选择切换"],["Invert selection","反向选择"],["Add A New Object","新建文件"],["Connect to auto translator","无法与翻译器连接"],["Undock pane","Undock pane"],["Collapse / restore left panel","Collapse / restore left panel"],["Add new key (alt+n)","Add new key (alt+n)"],["Import Here","导入到这里"],["Add a note to this file","为这个文件增加备注"],["Open search menu","打开搜索栏"],["Toggle grid information","切换单元格信息"],["Object Properties","文件属性"],["Automatically set selected original text to clipboard","自动将所选单元格的原文文本添加进剪贴板"],["Resize Font","字体大小"],["Toggle word wrapping & Explicit white spaces","文本换行切换 & 是否显示空白"],["Use Monospace font","使用等宽字体"],["Remove all translation from this file","删除文件中所有翻译"],["Remove this file from project","将该文件从工程中删除"],["file path","文件路径"],["Quick find","快速查找"],["Active cell's info","活动单元格信息"],["View original untranslated text","查看未翻译的原文"],["View raw data","查看源代码数据"],["View row properties","查看行属性"],["Go to current cell","前往目标单元格"],["Current coordinate","当前坐标"],["Word wraping (for non Japanese text)","换行 (针对非日语文本)"],["Speak original text (alt+,)","朗读原文 (alt+,)"],["Copy original text into current cell (ctrl+0)","将原文复制到该单元格 (ctrl+0)"],["Default translation for all occurrence","默认翻译"],["Translations by context","根据地址区分翻译"],["This cell has a comment","该单元格存在注释"],["This cell has an organic content","此单元格有原始内容"],["This cell has been visited","该单元格已访问"],["This is the first time this cell has been visited","该单元格初次受到访问"],["Word wraping","自动换行"],["Speak current translation text (alt+.)","朗读该处译文文本 (alt+.)"],["Current Cell Editor options","当前单元格编辑设置"],["Clear context translation for current row","清楚该行的地址区分翻译"],["Get help about translation by context","根据地址获得翻译帮助"],["Open menu","打开菜单"],["Path not accessible","路径不可访问"],["The location of the original material. You should not modify anything inside this folder.","游戏初始文件的位置. 最好不要对这里面的文件进行任何操作."],["The location of the game that has been translated. The default location of the translation injection.","翻译后的游戏文件所在的位置. 在注入翻译时会默认使用这里的路径."],["Prefered translator for this project. If not defined, global setting will be used.","该工程的默认翻译引擎. 如果为空，则会使用全局翻译引擎代替."],["-use default-","-使用默认-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","当导出/注入翻译文本的时候将会从缓存中调取数据. 缓存文件在创建工程时就创建完成了"],["Number of objects/files available on the left pane","在左侧栏显示的所有文件的数量"],["Number of characters in the Original Text column","对原文列中的所有字符进行统计"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","对于不使用半角字符的语言可能统计有误 (例如. 日语, 中文)"],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","用户直接填入网格中。这是一个好迹象。可能是人工翻译，可能是编辑过的机器翻译等。"],["Run a javascript function after this project is successfully exported.","该工程成功导出之后运行一个javascript函数."],["Import .TRANS into project","从.TRANS导入翻译"],["Import Spreadsheet Options","从电子表格导入翻译设置"],["Import RPGMTransPatch Options","从RPGMTransPatch导入翻译设置"],["Start a new project","新建工程"],["Search project type...","搜索项目类型..."],["Remove row","移除行"],["Add row","新增行"],["Project is exist","工程已存在"],["Context Tool","地址工具"],["Your list of context separated by new line","文件将根据地址进行分行"],["Wrap text","文本换行"],["Export Options","导出设置"],["Tagging","标记"],["Apply Translation","应用翻译"],["Add new Object","新建项目"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],[