pe/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","模型"],["|","|"],["promptLibrary","提示库"],["search","搜索"],["downloadChat","下载聊天"],["newChat","新聊天"],["api","API"],["customEndpoint","自定义端点"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","导入"],["name","名称"],["prompt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","同步通知"],["toast.stop","停止通知"],["button.sync","同步按钮"],["button.stop","停止按钮"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","使用ChatGPT批量API翻译"],["Model","模型"],["The pre-trained model.","预训练模型。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 批量 API 使用的模型命名约定与通用 API 略有不同。批量 API 中的模型带有“-batch”前缀。例如，如果您使用 <code>gpt-4.1-mini</code>，模型会自动变为 <code>gpt-4.1-mini-batch</code>。<br />\n然而，截至本插件创建时，批量模型未在 OpenAI 的模型使用限制中列出，这导致如果用户将模型使用过滤器设置为“允许”（白名单），则无法使用批量 API。<br />\n这可能是 OpenAI UI 中的一个错误，未来可能会修复。<br />\n因此，请确保将 OpenAI 中的使用限制设置为“阻止”（黑名单）模式，以便使用批量 API。<br />\n点击此处更改模型的使用限制：https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","原列"],["The column of the original texts you want to translate.","要翻译的原始文本列。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Ignore if already translated","如果已有翻译则跳过"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果这项功能被勾选，Translator++将会忽略一切译文栏有内容的行."],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["System Message Template","系统消息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系统消息是消息的头部，用于告知您的 chatGPT 助手的角色。此消息将作为每个发送给 chatGPT 的批量的第一条消息发送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面量样式包含以下变量 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","变量：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 源语言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目标语言</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完整的源语言名称</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完整的目标语言名称</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 转义算法的预定义消息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示换行的字符串（行替代符）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的消息数量。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 添加角色信息。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 包含一些前几行作为上下文</li>"],["Body Message Template","正文消息模板"],["Template of the body of your chat.","您聊天正文的模板。"],["Sample conversation","示例对话"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT批量API允许您以50%更低的成本异步翻译项目，这意味着您将在<b style=\"color:red\">24小时内</b>收到翻译结果，且成本仅为<b style=\"color:red\">正常价格的一半</b>。这对于不需要即时翻译结果的大型项目特别有用。"],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .","<br />了解更多关于ChatGPT批量API的信息：https://platform.openai.com/docs/guides/batch 。"],["General Settings","常规设置"],["This form is using your existing ChatGPT configuration.<br>","此表单使用您现有的ChatGPT配置。<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","您可以通过在选项窗口中前往ChatGPT翻译器设置来更改配置。<br>"],["There you can set the API key, model, and other settings.<br />","在那里，您可以设置 API 密钥、模型和其他设置。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"打开ChatGPT设置\" />"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Ignore translated rows","忽略已翻译行"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt Template","提示模板"],["<h2>1. System Message</h2>","<h2>1. 系统消息</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>您可以在此向助手解释其角色。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 您的实际提示</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>这是给助手的实际提示。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>间接成本</h3>\n                        间接成本是指您发送给助手但不包含实际翻译文本的提示消息的成本。该成本基于提示消息中的令牌数量计算。令牌越多，成本越高。<br>\n                        <b>当前间接成本：</b> <span class=\"overheadCost\">0</span> 令牌 / 请求。"],["Are you sure you want to reset the form?","您确定要重置表单吗？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","您确定要处理此批次吗？\n此操作将产生成本。"],["The batch is successfully created. Do you want to open the batch manager?","批次已成功创建。您要打开批次管理器吗？"],["OpenAI Batch API Queue","OpenAI 批次 API 队列"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","请选择要应用翻译的行"],["Target Column","目标列"],["The column to put the translation result.","用于放置翻译结果的列。"],["Import translation from ChatGPT Batch","从ChatGPT批次导入翻译"],["Translation applied to selected rows","翻译已应用于选定行"],["Invalid format","格式无效"],["OK","确定"],["Mismatch","不匹配"],["Failed to load batch list with error: \n","加载批次列表失败，错误：\n"],["Download Error File","下载错误文件"],["Batch is not completed yet","批次尚未完成"],["Are you sure you want to cancel this batch?","您确定要取消此批次吗？"],["Cannot cancel completed batch.","无法取消已完成的批次。"],["Batch cancelled","批次已取消"],["Failed to cancel batch","取消批次失败"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","批次"],["Apply translation","应用翻译"],["Cancel batch","取消批次"],["Status","状态"],["Batch ID","批次ID"],["Input File ID","输入文件ID"],["End point","端点"],["Created at","创建于"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","过期于 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，已完成请求的响应可通过批次的输出文件获取。您将按已完成的请求消耗的令牌计费。\"></i>"],["Completed at","完成于"],["Errors","错误"],["Batch Item Detail of","批次项目详情"],["ID","ID"],["Completed on","完成于"],["Model","模型"],["Prompt Token","提示令牌"],["Completion Token","完成令牌"],["Total Token","总令牌"],["Status Code","状态码"],["error","错误"],["Conversation","对话"],["Response Validation","响应验证"],["Raw Payload","原始负载"],["View raw payload","查看原始负载"],["Response Preview","响应预览"],["Apply translations from selected rows","应用选定行的翻译"],["Here you can edit the translation result individually and send it into Translator++","在此处，您可以单独编辑翻译结果并将其发送到 Translator++"],["Open ChatGPT Settings","打开 ChatGPT 设置"],["Help","帮助"],["File list","文件列表"],["Collapse / restore left panel","Collapse / restore left panel"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，而针对已完成请求的任何响应将通过批次的输出文件提供。您将按消耗的令牌收费。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","OpenAI 聊天"],["Target URL","目标 URL"],["Target end point. You can use any service that supports OpenAI API.","目标端点。你可以使用任何支持 OpenAI API 的服务。</li>"],["Sample endpoints","示例端点"],["Use this endpoint","使用此端点"],["Copy to clipboard","复制到剪贴板"],["e.g.","例如"],["API Key","API密钥"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","在此输入您的API密钥。<br>获取API密钥的方法因服务而异。<br>"],["Leave it blank if the service doesn't require API key.","如果服务不需要API密钥，请留空。"],["Model","模型"],["The pre-trained model","预训练模型"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","对于OpenAI，您可能需要设置允许使用的模型（https://platform.openai.com/settings/proj_xxx/limits）。"],["Enable Context","启用上下文"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","启用翻译的上下文。当前批次上方先前翻译的材料将作为上下文包含。<b>您还需要在模板中明确包含 CONTEXT</b>"],["Context Character Limit","上下文字符限制"],["Character limit for the context.","上下文的字符限制。"],["System Message Template","系统消息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系统消息是消息的头部，用于告知您的 chatGPT 助手的角色。此消息将作为每个发送给 chatGPT 的批量的第一条消息发送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面量样式包含以下变量 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","变量：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 源语言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目标语言</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 转义算法的预定义消息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示换行的字符串（行替代符）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的消息数量。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["User message","用户消息"],["Assistant's response","助手的响应"],["Body Message Template","正文消息模板"],["Template of the body of your chat.","您聊天正文的模板。"],["Enable JailBreak","启用越狱"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","为翻译启用越狱。这将使翻译更准确且减少偏见。某些模型可能试图将虚构事件与现实事件联系起来，从而尝试改变翻译以适应其自身叙述。此选项将防止这种情况。"],["Jailbreak Template","越狱模板"],["Template of the Jailbreak message.","越狱消息模板。"],["Maximum Tokens","最大令牌数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","完成中生成的最大令牌数。<br>提示的令牌计数加上最大令牌数不能超过模型的上下文长度。大多数模型的上下文长度为2048个令牌（最新模型除外，支持4096）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用的采样温度，介于0和2之间。较高的值如0.8会使输出更随机，而较低的值如0.2会使输出更专注和确定。<br>OpenAI通常建议调整此参数或top_p，但不要同时调整两者。"],["Nucleus sampling (top_p)","核心采样（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度采样的替代方法，称为核心采样，模型考虑具有top_p概率质量的令牌结果。所以0.1意味着只考虑构成前10%概率质量的令牌。<br>OpenAI通常建议调整此参数或温度，但不要同时调整两者。"],["Frequency Penalty","频率惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌在文本中已有的频率惩罚新令牌，降低模型逐字重复相同行的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌是否已在文本中出现来惩罚新令牌，增加模型讨论新主题的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","使用JSON模式"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","使用<code>json_schema</code>作为<code>response_format.type</code>字段，而不是旧的<code>json_object</code>。一些最新模型和服务器如<b>LM Studio</b>需要<code>json_schema</code>，但一些旧模型仍在使用<code>json_object</code>。"],["Max Characters per Batch","每批次最大字符数"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","每翻译批次的最大字符限制。\n此选项仅计算原始文本的字符长度，不包括提示消息的字符长度。"],["Max concurrent requests","最大并发请求数"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","允许同时连接多少个并发请求？每增加一个并发连接会倍增您的翻译速度，但也会快速耗尽提供商设置的令牌限制。<br />设置为<b>0</b>以禁用此功能。<br />将此选项与<b>每并发请求最大行数</b>结合使用，以进一步提升翻译速度。<br />将此选项设置为大于1会影响<b>上下文</b>，因为会在前一个请求完成前处理新请求，导致上下文发送时缺少先前请求的翻译结果。"],["Max row per concurrent requests","每个并发请求的最大行数"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","每个并发请求允许的行数。设置为<b>0</b>以禁用此功能。<br />如果此选项被禁用，则无论您设置了多少<b>最大并发请求</b>，Translator++都会将请求作为单个块处理。<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","设置的行数越多，单个批次中获得的翻译就越多，从而减少开销成本，但增加AI返回错误结果的可能性。<br />数字越低，翻译出错的可能性越小，但会因额外提示而增加成本。"],["Preserve translations from invalid returned number of rows","保留无效返回行数的翻译"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","保留行数无效的响应中的翻译。<br />如果勾选，Translator++将尝试修正行数并将翻译插入网格。<br />如果不勾选，单元格将保持空白。<br />建议为重新翻译目的不勾选此选项。"],["Batch delay","批次延迟"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","批处理之间的延迟（以毫秒计）。<br />使用此设置控制请求，以避免达到RPM（每分钟请求数）限制。"],["Batch Timeout","批处理超时"],["Timeout for each batch in milisecond","每个批处理的超时时间（毫秒）"],["Code Escaping Algorithm","代码转义算法"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","用于对话内联代码的转义算法。您可能需要根据所选转义算法更改<b>系统消息模板</b>和<b>正文消息模板</b>。<br />当选择<b>JSONCloaking</b>或<b>JSONObjectCloaking</b>时，将自动发送<code>response_format: { type: 'json_object' }</code>（除非启用<b>使用JSON模式</b>，这将发送JSON模式）。<b>JSONCloaking</b>非常准确，但不适用于所有模型，请尝试<b>gpt-3.5-turbo-1106</b>。"],["Number of retry","重试次数"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","当翻译输出验证失败时，引擎应重试的次数。如果为空值（空白），则不重试。"],["Retry when the number of translated rows doesn't match original","当翻译行数与原始行数不匹配时重试"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","如果启用，当模型返回的翻译行数与原始负载的行数不同时，引擎将重试。"],["Retry when the number of lines for each translated row doesn't match original","当每个翻译行的行数与原始行数不匹配时重试"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","如果启用，当任何翻译行的行数与其原始行不同时，引擎将重试。"],["Prompt: Row count mismatch","提示：行数不匹配"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","由于行/元素计数不匹配而重试时使用的提示。可用的模板变量包括：${MESSAGE_COUNT}、${RETURNED_MESSAGE_COUNT}、${LANG_TO}、${SOURCE_TEXT}。"],["Prompt: Line count mismatch","提示：行内行数不匹配"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","由于每行行数不匹配而重试时使用的提示。可用的模板变量包括：${LINE_ERRORS}、${LANG_TO}、${SOURCE_TEXT}。"],["Prompt: Error / Retry instruction","提示：错误/重试指令"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","在不匹配提示后附加的提示，用于指示模型重试。可用的模板变量包括：${ERROR_MESSAGE}、${LANG_TO}、${SOURCE_TEXT}。"],["Custom Parameter","自定义参数"],["Key","秘钥"],["Value","值"],["Type","类型"],["Type of the value.","值的类型。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","对于<b>javascript</b>类型，值将作为JavaScript代码执行。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript代码的作用域是<code>window</code>，因此您可以获取几乎所有值。"],["<br />Example: <code>trans.project.title</code>","<br />示例：<code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","丢弃不会发送到API的参数。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API不断变化，一些新模型可能不支持旧参数，并会返回HTTP错误以响应无法识别的请求参数。"],["You can drop the parameters that are not supported by the model here.","您可以在此处丢弃模型不支持的参数。"],["Manage configuration","管理配置"],["RPG Maker","RPG制作大师"],["HTML Cloaking Wrapped","HTML伪装包装"],["JSONObject Cloaking","JSON对象伪装"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","此插件支持通过任何支持OpenAI聊天API的服务进行翻译，例如Deepseek、LlamaCPP、Google Gemini等，当然也包括OpenAI ChatGPT。"],["OpenAI API settings","OpenAI API设置"],["General","通用"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>不要在推理模型上浪费金钱</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>多项研究已证明，推理模型在执行创意写作和翻译任务时远不如普通模型。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>使用推理模型只会带来更高的成本和更慢的响应时间，别无益处。</p>"],["Explore more models","探索更多模型"],["Templates","模板"],["Enable context","启用上下文"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Add Example: Translate Japanese to English","添加示例：翻译日语到英语"],["Retry prompts","重试提示"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>这些提示在重试时作为额外的<b>用户</b>消息附加，紧接在之前的模型输出之后。</p>"],["<p>Available variables:</p>","<p>可用变量：</p>"],["Enable Jailbreak","启用越狱"],["Advanced","高级"],["Custom Parameters","自定义参数"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","您可以向OpenAI Chat API请求体中添加自定义参数。如果您想添加表单中不可用的额外参数，这很有用。"],["<h2>Warning</h2>","<h2>警告</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>错误设置自定义参数可能导致API请求失败。在添加自定义参数前，请确保您知道自己在做什么。像OpenAI这样的服务对发送的参数有严格要求，对于无法识别的请求参数，它们会返回HTTP错误。</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>如果同一个键被多次使用，只有最后一个值会被采用。</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>如果使用了现有配置中的相同键，则现有配置参数将被自定义参数覆盖。</li>"],["Drop Parameters","删除参数"],["Open chatGPT tester","打开聊天GPT测试器"],["Batch Translation Setting","批量翻译设置"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","抱歉，此插件仅对活跃的赞助者开放。\n您可以通过成为每月 $1 的赞助者来解锁此功能。"],["Preserve invalid returned rows","保留无效返回行"],["Retries and Refinement","重试与精炼"],["<h2>Retries and Refinement</h2>","<h2>重试与精炼</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>当翻译输出验证失败时，Translator++ 可以要求模型重试翻译。您可以设置模型应重试的次数以及重试的条件。</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>设置合理的重试次数和适当的重试条件，可以在控制成本和时间的同时，显著提高翻译质量。</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>每次重试都会增加额外的时间和金钱成本</b>。如果您的批量翻译频繁重试，可能需要调整提示，使指令对模型更清晰。</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>使用开发者工具或批量管理器来调试您的批量翻译。</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>代码转义算法</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>代码转义是一种技术，用于防止 MTL 修改对话中的代码片段。这在您的对话包含代码片段（如 HTML 标签、XML 标签、JSON 对象或 JavaScript 模板）时非常有用。</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>选择与您对话中代码片段匹配的转义算法。您可能需要相应地调整 <b>系统消息</b>、<b>示例提示</b> 和 <b>正文消息</b> 模板。</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>点击 <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>此处</a> 阅读更多关于代码转义算法及其有效使用的信息。</p>"],["Default","默认"],["JavaScript template cloaking","JavaScript 模板伪装"],["None (no escaping)","无（不转义）"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","您要加载所选转义算法的示例对话预设吗？这将覆盖您现有的示例对话。"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["<br />","<br />"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":true,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>发</u>送"],["Toggle word wrap","切换自动换行"],["Open debugger (F12)","打开调试器 (F12)"],["Help","帮助"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能仅在您使用 Translator++ 的开发者版本时可用。您可以通过基本工具 -> 更改核心 NWJS 切换到开发者版本。"]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","与ChatGPT API聊天"],["Batch Manager","批次管理器"],["This feature is only available if you have a project open.","此功能仅在打开项目时可用。"]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","您要安装 DazedMTLTool 吗？"],["Ignore if already translated","如果已有翻译则跳过"],["OpenAI Translation with DazedMTL","使用 DazedMTL 的 OpenAI 翻译"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":true,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","DeepL 服务器未安装。您要现在安装吗？"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":true,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","字符使用量：\n"],["Failed to fetch quota: ","获取配额失败："]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":true,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>发</u>送"],["Toggle word wrap","切换自动换行"],["Open debugger (F12)","打开调试器 (F12)"],["Help","帮助"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能仅在您使用 Translator++ 的开发者版本时可用。您可以通过基本工具 -> 更改核心 NWJS 切换到开发者版本。"]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>原生 Gemini API</h2><p>此引擎使用 Google Gemini 原生 API 进行翻译。<br />您也可以使用 OpenAI 插件来处理 Google Gemini。OpenAI 插件提供更多功能，这就是为什么<b style='color:green;'>我推荐使用 OpenAI 插件代替</b>。</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI 需要 OpenAI 库中的某些模块。请确保已安装 <b>transChatGPT（Translator++ 的 ChatGPT）</b> 插件。"],["Explore more models","探索更多模型"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","模型"],["|","|"],["promptLibrary","提示库"],["search","搜索"],["downloadChat","下载聊天"],["newChat","新聊天"],["api","API"],["customEndpoint","自定义端点"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","导入"],["name","名称"],["prompt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","同步通知"],["toast.stop","停止通知"],["button.sync","同步按钮"],["button.stop","停止按钮"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/S