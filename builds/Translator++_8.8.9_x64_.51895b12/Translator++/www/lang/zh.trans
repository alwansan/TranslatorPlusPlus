tringLiteral"],["tid/608417/type/StringLiteral"],["tid/608422/type/StringLiteral"],["tid/621955/type/StringLiteral","tid/629854/type/StringLiteral"],["tid/621975/type/StringLiteral"],["tid/622292/type/StringLiteral"],["tid/622315/type/StringLiteral"],["tid/629235/type/StringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","模型"],["|","|"],["promptLibrary","提示库"],["search","搜索"],["downloadChat","下载聊天"],["newChat","新聊天"],["api","API"],["customEndpoint","自定义端点"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","导入"],["name","名称"],["prompt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","同步通知"],["toast.stop","停止通知"],["button.sync","同步按钮"],["button.stop","停止按钮"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","使用ChatGPT批量API翻译"],["Model","模型"],["The pre-trained model.","预训练模型。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 批量 API 使用的模型命名约定与通用 API 略有不同。批量 API 中的模型带有“-batch”前缀。例如，如果您使用 <code>gpt-4.1-mini</code>，模型会自动变为 <code>gpt-4.1-mini-batch</code>。<br />\n然而，截至本插件创建时，批量模型未在 OpenAI 的模型使用限制中列出，这导致如果用户将模型使用过滤器设置为“允许”（白名单），则无法使用批量 API。<br />\n这可能是 OpenAI UI 中的一个错误，未来可能会修复。<br />\n因此，请确保将 OpenAI 中的使用限制设置为“阻止”（黑名单）模式，以便使用批量 API。<br />\n点击此处更改模型的使用限制：https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","原列"],["The column of the original texts you want to translate.","要翻译的原始文本列。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Ignore if already translated","如果已有翻译则跳过"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果这项功能被勾选，Translator++将会忽略一切译文栏有内容的行."],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["System Message Template","系统消息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系统消息是消息的头部，用于告知您的 chatGPT 助手的角色。此消息将作为每个发送给 chatGPT 的批量的第一条消息发送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面量样式包含以下变量 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","变量：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 源语言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目标语言</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完整的源语言名称</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完整的目标语言名称</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 转义算法的预定义消息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示换行的字符串（行替代符）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的消息数量。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 添加角色信息。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 包含一些前几行作为上下文</li>"],["Body Message Template","正文消息模板"],["Template of the body of your chat.","您聊天正文的模板。"],["Sample conversation","示例对话"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT批量API允许您以50%更低的成本异步翻译项目，这意味着您将在<b style=\"color:red\">24小时内</b>收到翻译结果，且成本仅为<b style=\"color:red\">正常价格的一半</b>。这对于不需要即时翻译结果的大型项目特别有用。"],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .","<br />了解更多关于ChatGPT批量API的信息：https://platform.openai.com/docs/guides/batch 。"],["General Settings","常规设置"],["This form is using your existing ChatGPT configuration.<br>","此表单使用您现有的ChatGPT配置。<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","您可以通过在选项窗口中前往ChatGPT翻译器设置来更改配置。<br>"],["There you can set the API key, model, and other settings.<br />","在那里，您可以设置 API 密钥、模型和其他设置。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"打开ChatGPT设置\" />"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Ignore translated rows","忽略已翻译行"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt Template","提示模板"],["<h2>1. System Message</h2>","<h2>1. 系统消息</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>您可以在此向助手解释其角色。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 您的实际提示</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>这是给助手的实际提示。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>间接成本</h3>\n                        间接成本是指您发送给助手但不包含实际翻译文本的提示消息的成本。该成本基于提示消息中的令牌数量计算。令牌越多，成本越高。<br>\n                        <b>当前间接成本：</b> <span class=\"overheadCost\">0</span> 令牌 / 请求。"],["Are you sure you want to reset the form?","您确定要重置表单吗？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","您确定要处理此批次吗？\n此操作将产生成本。"],["The batch is successfully created. Do you want to open the batch manager?","批次已成功创建。您要打开批次管理器吗？"],["OpenAI Batch API Queue","OpenAI 批次 API 队列"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","请选择要应用翻译的行"],["Target Column","目标列"],["The column to put the translation result.","用于放置翻译结果的列。"],["Import translation from ChatGPT Batch","从ChatGPT批次导入翻译"],["Translation applied to selected rows","翻译已应用于选定行"],["Invalid format","格式无效"],["OK","确定"],["Mismatch","不匹配"],["Failed to load batch list with error: \n","加载批次列表失败，错误：\n"],["Download Error File","下载错误文件"],["Batch is not completed yet","批次尚未完成"],["Are you sure you want to cancel this batch?","您确定要取消此批次吗？"],["Cannot cancel completed batch.","无法取消已完成的批次。"],["Batch cancelled","批次已取消"],["Failed to cancel batch","取消批次失败"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","批次"],["Apply translation","应用翻译"],["Cancel batch","取消批次"],["Status","状态"],["Batch ID","批次ID"],["Input File ID","输入文件ID"],["End point","端点"],["Created at","创建于"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","过期于 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，已完成请求的响应可通过批次的输出文件获取。您将按已完成的请求消耗的令牌计费。\"></i>"],["Completed at","完成于"],["Errors","错误"],["Batch Item Detail of","批次项目详情"],["ID","ID"],["Completed on","完成于"],["Model","模型"],["Prompt Token","提示令牌"],["Completion Token","完成令牌"],["Total Token","总令牌"],["Status Code","状态码"],["error","错误"],["Conversation","对话"],["Response Validation","响应验证"],["Raw Payload","原始负载"],["View raw payload","查看原始负载"],["Response Preview","响应预览"],["Apply translations from selected rows","应用选定行的翻译"],["Here you can edit the translation result individually and send it into Translator++","在此处，您可以单独编辑翻译结果并将其发送到 Translator++"],["Open ChatGPT Settings","打开 ChatGPT 设置"],["Help","帮助"],["File list","文件列表"],["Collapse / restore left panel","Collapse / restore left panel"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，而针对已完成请求的任何响应将通过批次的输出文件提供。您将按消耗的令牌收费。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>不要在推理模型上浪费金钱</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>多项研究已证明，推理模型在执行创意写作和翻译任务时远不如普通模型。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>使用推理模型只会带来更高的成本和更慢的响应时间，别无益处。</p>"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>发</u>送"],["Toggle word wrap","切换自动换行"],["Open debugger (F12)","打开调试器 (F12)"],["Help","帮助"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能仅在您使用 Translator++ 的开发者版本时可用。您可以通过基本工具 -> 更改核心 NWJS 切换到开发者版本。"]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","与ChatGPT API聊天"],["Batch Manager","批次管理器"],["This feature is only available if you have a project open.","此功能仅在打开项目时可用。"]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","此操作将启动浏览器窗口。请确保您的默认浏览器设置为Chrome浏览器。您要继续吗？"],["Gemini Nano server is already running. Do you want to restart it?","Gemini Nano服务器已在运行。您要重启它吗？"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","此操作将启动浏览器窗口。请确保您的默认浏览器设置为Chrome浏览器。并且Gemini Nano服务器已启动。您要继续吗？"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":true,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","服务名称"],["Service provider for your Batch API.","您的批处理API的服务提供商。"],["Your API Key","您的API密钥"],["Please enter your API key for the Batch API service.","请输入您的批处理API服务的API密钥。"],["Model","模型"],["The model for your translation.","用于翻译的模型。"],["Source Column","原列"],["The column of the original texts you want to translate.","要翻译的原始文本列。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Ignore if already translated","如果已有翻译则跳过"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果这项功能被勾选，Translator++将会忽略一切译文栏有内容的行."],["Filter Tag","筛选标签"],["If set, only rows with this tag will be translated.","如果设置，仅翻译带有此标签的行。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Enable Context","启用上下文"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","启用翻译的上下文。当前批次上方先前翻译的材料将作为上下文包含。<b>您还需要在模板中明确包含 CONTEXT</b>"],["Context Character Limit","上下文字符限制"],["Character limit for the context.","上下文的字符限制。"],["System Message Template","系统消息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系统消息是消息的头部，用于告知您的 chatGPT 助手的角色。此消息将作为每个发送给 chatGPT 的批量的第一条消息发送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面量样式包含以下变量 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","变量：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 源语言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目标语言</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完整的源语言名称</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完整的目标语言名称</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 转义算法的预定义消息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示换行的字符串（行替代符）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的消息数量。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 添加角色信息。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 包含一些前几行作为上下文</li>"],["Body Message Template","正文消息模板"],["Template of the body of your chat.","您聊天正文的模板。"],["Sample conversation","示例对话"],["User message","用户消息"],["Assistant's response","助手的响应"],["Enable JailBreak","启用越狱"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","为翻译启用越狱。这将使翻译更准确且减少偏见。某些模型可能试图将虚构事件与现实事件联系起来，从而尝试改变翻译以适应其自身叙述。此选项将防止这种情况。"],["Jailbreak Template","越狱模板"],["Template of the Jailbreak message.","越狱消息模板。"],["Maximum Tokens","最大令牌数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","完成中生成的最大令牌数。<br>提示的令牌计数加上最大令牌数不能超过模型的上下文长度。大多数模型的上下文长度为2048个令牌（最新模型除外，支持4096）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用的采样温度，介于0和2之间。较高的值如0.8会使输出更随机，而较低的值如0.2会使输出更专注和确定。<br>OpenAI通常建议调整此参数或top_p，但不要同时调整两者。"],["Nucleus sampling (top_p)","核心采样（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度采样的替代方法，称为核心采样，模型考虑具有top_p概率质量的令牌结果。所以0.1意味着只考虑构成前10%概率质量的令牌。<br>OpenAI通常建议调整此参数或温度，但不要同时调整两者。"],["Frequency Penalty","频率惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌在文本中已有的频率惩罚新令牌，降低模型逐字重复相同行的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌是否已在文本中出现来惩罚新令牌，增加模型讨论新主题的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","自定义参数"],["Key","秘钥"],["Value","值"],["Type","类型"],["Type of the value.","值的类型。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","对于<b>javascript</b>类型，值将作为JavaScript代码执行。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript代码的作用域是<code>window</code>，因此您可以获取几乎所有值。"],["Example: <code>trans.project.title</code>","示例：<code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","丢弃不会发送到API的参数。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API不断变化，一些新模型可能不支持旧参数，并会返回HTTP错误以响应无法识别的请求参数。"],["You can drop the parameters that are not supported by the model here.","您可以在此处丢弃模型不支持的参数。"],["Batch API settings","批量API设置"],["General","通用"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI 批量 API 允许您以 50% 更低的成本异步翻译您的项目，这意味着您将在 <b style=\"color:red\">24 小时内</b>以 <b style=\"color:blue\">正常成本的一半</b>收到翻译结果。这对于不需要立即翻译结果的大型项目特别有用。"],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />了解更多关于批量 API 的信息 <a href=\"https://platform.openai.com/docs/guides/batch\" external>这里</a>。<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />支持的服务：<b>OpenAI</b> 和 <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>更多配置可在插件设置中找到</h2>"],["Open Add-on Settings","打开插件设置"],["Import Configuration from OpenAI Setting","从OpenAI设置导入配置"],["General Settings","常规设置"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>不要在推理模型上浪费金钱</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>多项研究已证明，推理模型在执行创意写作和翻译任务时远不如普通模型。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>使用推理模型只会带来更高的成本和更慢的响应时间，别无益处。</p>"],["<h2>If you're using OpenAI</h2>","<h2>如果您使用OpenAI</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","OpenAI批量API使用与标准API略有不同的模型命名约定。批量模式中的模型包含-batch后缀。例如，如果您指定<code>gpt-4.1-mini</code>，它将被自动解释为<code>gpt-4.1-mini-batch</code>。<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","然而，在此插件开发时，批量模型未列在OpenAI的模型使用限制下。这意味着将模型使用过滤器设置为“允许”（白名单）的用户将无法访问批量API。<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","点击<a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>此处</a>更改模型的使用限制。"],["Explore more models","探索更多模型"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Ignore translated rows","忽略已翻译行"],["Templates","模板"],["<h2>1. System Message</h2>","<h2>1. 系统消息</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>您可以在此向助手解释其角色。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 您的实际提示</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>这是给助手的实际提示。</p>"],["Enable Jailbreak","启用越狱"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Enable context","启用上下文"],["Advanced","高级"],["Custom Parameters","自定义参数"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","您可以向OpenAI Chat API请求体中添加自定义参数。如果您想添加表单中不可用的额外参数，这很有用。"],["<h2>Warning</h2>","<h2>警告</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>错误设置自定义参数可能导致API请求失败。在添加自定义参数前，请确保您知道自己在做什么。像OpenAI这样的服务对发送的参数有严格要求，对于无法识别的请求参数，它们会返回HTTP错误。</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>如果同一个键被多次使用，只有最后一个值会被采用。</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>如果使用了现有配置中的相同键，则现有配置参数将被自定义参数覆盖。</li>"],["String","字符串"],["Number","数字"],["Boolean","布尔值"],["JavaScript","JavaScript"],["Drop Parameters","删除参数"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>开销成本</h3>\n                        开销成本是您发送给助手的提示消息（不包括实际翻译文本）的成本。成本根据提示消息中的令牌数量计算。令牌越多，成本越高。<br>\n                        <b>预估开销成本：</b> <span class=\"overheadCost\">0</span> 令牌 / 请求。"],["Are you sure you want to reset the form?","您确定要重置表单吗？"],["Translate with Batch API","使用批量API翻译"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","您确定要处理此批次吗？\n此操作将产生成本。"],["The batch is successfully created. Do you want to open the batch manager?","批次已成功创建。您要打开批次管理器吗？"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","您确定要从OpenAI设置导入配置吗？这将覆盖当前配置。"],["chatGPT engine is not found","未找到chatGPT引擎"],["Configuration imported successfully.","配置导入成功。"],["Batch API Queue","批处理API队列"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","请选择要应用翻译的行"],["Target Column","目标列"],["The column to put the translation result.","用于放置翻译结果的列。"],["Import translation from ChatGPT Batch","从ChatGPT批次导入翻译"],["Translation applied to selected rows","翻译已应用于选定行"],["Invalid format","格式无效"],["OK","确定"],["Mismatch","不匹配"],["Failed to load batch list with error: \n","加载批次列表失败，错误：\n"],["Download Error File","下载错误文件"],["Batch is not completed yet","批次尚未完成"],["Are you sure you want to cancel this batch?","您确定要取消此批次吗？"],["Cannot cancel completed batch.","无法取消已完成的批次。"],["Batch cancelled","批次已取消"],["Failed to cancel batch","取消批次失败"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","批次"],["Apply translation","应用翻译"],["Cancel batch","取消批次"],["Status","状态"],["Batch ID","批次ID"],["Input File ID","输入文件ID"],["End point","端点"],["Created at","创建于"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","过期于 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，已完成请求的响应可通过批次的输出文件获取。您将按已完成的请求消耗的令牌计费。\"></i>"],["Completed at","完成于"],["Errors","错误"],["Batch Item Detail of","批次项目详情"],["ID","ID"],["Completed on","完成于"],["Model","模型"],["Prompt Token","提示令牌"],["Completion Token","完成令牌"],["Total Token","总令牌"],["Status Code","状态码"],["error","错误"],["Conversation","对话"],["Response Validation","响应验证"],["Raw Payload","原始负载"],["View raw payload","查看原始负载"],["Response Preview","响应预览"],["Apply translations from selected rows","应用选定行的翻译"],["Here you can edit the translation result individually and send it into Translator++","在此处，您可以单独编辑翻译结果并将其发送到 Translator++"],["Open ChatGPT Settings","打开 ChatGPT 设置"],["Help","帮助"],["File list","文件列表"],["Collapse / restore left panel","Collapse / restore left panel"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，而针对已完成请求的任何响应将通过批次的输出文件提供。您将按消耗的令牌收费。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","服务名称"],["Service provider for your Batch API.","您的批处理API的服务提供商。"],["API Key","API密钥"],["Please enter your API key for the Batch API service.","请输入您的批处理API服务的API密钥。"],["Model","模型"],["The pre-trained model","预训练模型"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","在ChatGPT中，您可能需要设置允许使用的模型（https://platform.openai.com/settings/proj_xxx/limits）。"],["Enable JailBreak","启用越狱"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","为翻译启用越狱。这将使翻译更准确且减少偏见。某些模型可能试图将虚构事件与现实事件联系起来，从而尝试改变翻译以适应其自身叙述。此选项将防止这种情况。"],["Jailbreak Template","越狱模板"],["Template of the Jailbreak message.","越狱消息模板。"],["Maximum Tokens","最大令牌数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","完成中生成的最大令牌数。<br>提示的令牌计数加上最大令牌数不能超过模型的上下文长度。大多数模型的上下文长度为2048个令牌（最新模型除外，支持4096）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用的采样温度，介于0和2之间。较高的值如0.8会使输出更随机，而较低的值如0.2会使输出更专注和确定。<br>OpenAI通常建议调整此参数或top_p，但不要同时调整两者。"],["Nucleus sampling (top_p)","核心采样（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度采样的替代方法，称为核心采样，模型考虑具有top_p概率质量的令牌结果。所以0.1意味着只考虑构成前10%概率质量的令牌。<br>OpenAI通常建议调整此参数或温度，但不要同时调整两者。"],["Frequency Penalty","频率惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌在文本中已有的频率惩罚新令牌，降低模型逐字重复相同行的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌是否已在文本中出现来惩罚新令牌，增加模型讨论新主题的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","每批次最大字符数"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","每翻译批次的最大字符限制。\n此选项仅计算原始文本的字符长度，不包括提示消息的字符长度。"],["Max row per concurrent requests","每个并发请求的最大行数"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","每个并发请求允许的行数。设置为<b>0</b>以禁用此功能。<br />如果此选项被禁用，则无论您设置了多少<b>最大并发请求</b>，Translator++都会将请求作为单个块处理。<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","设置的行数越多，单个批次中获得的翻译就越多，从而减少开销成本，但增加AI返回错误结果的可能性。<br />数字越低，翻译出错的可能性越小，但会因额外提示而增加成本。"],["Code Escaping Algorithm","代码转义算法"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","用于对话中内联代码的转义算法。您可能需要根据选择的转义算法调整<b>系统消息模板</b>和<b>正文消息模板</b>。<br />当选择<b>JSONCloaking</b>时，response_format: { type: 'json_object' } 参数会自动发送给ChatGPT。<b>JSONCloaking</b>非常准确，但并非所有模型都适用，请尝试<b>gpt-3.5-turbo-1106</b>。"],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>批量API</b>允许您一次性提交多个请求，这些请求在后台异步处理。您不会立即收到结果，但过程<b>将在24小时内完成</b>—通常更快。此方法<b>成本仅为标准方法的一半</b>。"],["Batch API settings","批量API设置"],["General","通用"],["Explore more models","探索更多模型"],["Templates","模板"],["Enable Jailbreak","启用越狱"],["Advanced","高级"],["Batch Translation Setting","批量翻译设置"],["Default","默认"],["JavaScript template cloaking","JavaScript 模板伪装"],["None (no escaping)","无（不转义）"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","打开批次管理器"],["This feature is only available if you have a project open.","此功能仅在打开项目时可用。"]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":true,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","LiteLLM 的代理 URL。您的 LiteLLM 代理的 URL 地址。默认为：<code>http://localhost:8890/chat/completions</code>"],["API's base URL","API 的基础 URL"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","所选服务的基础 URL。仅当使用自定义端点 URL 时填写此字段。LiteLLM 将根据给定模型自动检测基础 URL。<br />LiteLLM 向 URL 添加路径的方式取决于服务。例如，对于 OpenAI 兼容的端点，LiteLLM 会将 <code>/chat/completions</code> 附加到给定的 URL。因此，如果您的端点是 <code>https://api.fast-tunnel.one/v1/chat/completions</code>，请在此字段中填写 <code>https://api.fast-tunnel.one/v1</code>。"],["API Version","API 版本"],["Optional. The API version parameter needed for some services.","可选。某些服务所需的 API 版本参数。"],["API Key","API密钥"],["Optional. The API key used for authenticating your access to the service.","可选。用于验证访问服务的 API 密钥。"],["Model","模型"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","预训练您选择的模型。使用 LiteLLM 模型便利格式指定您偏好的模型。格式为 {服务名称}/{模型}。例如："],["your deployment name","您的部署名称"],["However, some models have unique names that can be directly identified, like:","然而，一些模型具有可直接识别的独特名称，例如："],["Azure AD Token","Azure AD 令牌"],["AWS Access Key ID","AWS 访问密钥 ID"],["AWS secret access key","AWS 秘密访问密钥"],["Open router site URL","Open router 站点 URL"],["Open router APP name","Open router 应用名称"],["Enable Context","启用上下文"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","启用翻译的上下文。当前批次上方先前翻译的材料将作为上下文包含。<b>您还需要在模板中明确包含 CONTEXT</b>"],["Context Character Limit","上下文字符限制"],["Character limit for the context.","上下文的字符限制。"],["System Message Template","系统消息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系统消息是消息的头部，用于告知您的 chatGPT 助手的角色。此消息将作为每个发送给 chatGPT 的批量的第一条消息发送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面量样式包含以下变量 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","变量：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 源语言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目标语言</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 转义算法的预定义消息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示换行的字符串（行替代符）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的消息数量。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["User message","用户消息"],["Assistant's response","助手的响应"],["Body Message Template","正文消息模板"],["Template of the body of your message.","您消息正文的模板。"],["Enable JailBreak","启用越狱"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","为翻译启用越狱。这将使翻译更准确且减少偏见。某些模型可能试图将虚构事件与现实事件联系起来，从而尝试改变翻译以适应其自身叙述。此选项将防止这种情况。"],["Jailbreak Template","越狱模板"],["Template of the Jailbreak message.","越狱消息模板。"],["Maximum Tokens","最大令牌数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","完成中生成的最大令牌数。<br>提示的令牌计数加上最大令牌数不能超过模型的上下文长度。大多数模型的上下文长度为2048个令牌（最新模型除外，支持4096）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用的采样温度，介于0和2之间。较高的值如0.8会使输出更随机，而较低的值如0.2会使输出更专注和确定。<br>OpenAI通常建议调整此参数或top_p，但不要同时调整两者。"],["Nucleus sampling (top_p)","核心采样（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度采样的替代方法，称为核心采样，模型考虑具有top_p概率质量的令牌结果。所以0.1意味着只考虑构成前10%概率质量的令牌。<br>OpenAI通常建议调整此参数或温度，但不要同时调整两者。"],["Frequency Penalty","频率惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌在文本中已有的频率惩罚新令牌，降低模型逐字重复相同行的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在惩罚"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","介于-2.0和2.0之间的数字。正值根据令牌是否已在文本中出现来惩罚新令牌，增加模型讨论新主题的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","使用JSON模式"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","使用<code>json_schema</code>作为<code>response_format.type</code>字段，而不是旧的<code>json_object</code>。一些最新模型和服务器如<b>LM Studio</b>需要<code>json_schema</code>，但一些旧模型仍在使用<code>json_object</code>。"],["Stop","停止"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","输入一个关键词，API将在该处停止生成更多令牌。每个条目用新行分隔。"],["Additional argument variables","额外参数变量"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","启动服务器时将附加的额外参数变量。<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","批处理超时"],["Timeout for each batch in milisecond","每个批处理的超时时间（毫秒）"],["Max Request Length","最大请求长度"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","每个翻译批次的最大字符长度。\n不同翻译器有不同的规格。\n对于使用GET参数的WEB前端翻译器，建议小于2000。"],["Max concurrent requests","最大并发请求数"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","允许同时连接的最大并发请求数。设置为<b>0</b>以禁用此功能。<br />结合<b>每个并发请求的最大行数</b>选项可提升翻译速度。"],["Max row per concurrent requests","每个并发请求的最大行数"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","每个并发请求允许的最大行数。设置为<b>0</b>以禁用此功能。<br />如果此选项被禁用，则无论设置多少<b>最大并发请求数</b>，Translator++都会将请求作为单个块处理。"],["Batch delay","批次延迟"],["Delay between batch (in miliseconds)","批次之间的延迟（毫秒）"],["Code Escaping Algorithm","代码转义算法"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","对话中内联代码的转义算法。您可能需要根据所选转义算法调整<b>系统消息模板</b>和<b>正文消息模板</b>。"],["Number of retry","重试次数"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","当翻译输出验证失败时，引擎应重试的次数。如果为空值（空白），则不重试。"],["Retry when the number of translated rows doesn't match original","当翻译行数与原始行数不匹配时重试"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","如果启用，当模型返回的翻译行数与原始负载的行数不同时，引擎将重试。"],["Retry when the number of lines for each translated row doesn't match original","当每个翻译行的行数与原始行数不匹配时重试"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","如果启用，当任何翻译行的行数与其原始行不同时，引擎将重试。"],["Prompt: Row count mismatch","提示：行数不匹配"],["Prompt used when retrying due to row/element count mismatch.","由于行数/元素数不匹配而重试时使用的提示。"],["Prompt: Line count mismatch","提示：行内行数不匹配"],["Prompt used when retrying due to per-row line count mismatch.","由于每行行数不匹配而重试时使用的提示。"],["Prompt: Error / Retry instruction","提示：错误/重试指令"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","在不匹配提示后追加的指令，以指示模型重试。"],["Custom Parameter","自定义参数"],["Key","秘钥"],["Value","值"],["Type","类型"],["Type of the value.","值的类型。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","对于<b>javascript</b>类型，值将作为JavaScript代码执行。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript代码的作用域是<code>window</code>，因此您可以获取几乎所有值。"],["<br />Example: <code>trans.project.title</code>","<br />示例：<code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","丢弃不会发送到API的参数。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API不断变化，一些新模型可能不支持旧参数，并会返回HTTP错误以响应无法识别的请求参数。"],["You can drop the parameters that are not supported by the model here.","您可以在此处丢弃模型不支持的参数。"],["Manage configuration","管理配置"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","此引擎的某些功能需要安装ChatGPT插件。请确保在使用此引擎前已安装ChatGPT插件。"],["Text Completion Setting","文本完成设置"],["General","通用"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>不要在推理模型上浪费金钱</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>多项研究已证明，推理模型在执行创意写作和翻译任务时远不如普通模型。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>使用推理模型只会带来更高的成本和更慢的响应时间，别无益处。</p>"],["Platform specific","平台特定"],["Azure","Azure"],["AWS","AWS"],["Open Router","打开路由器"],["Templates","模板"],["Enable context","启用上下文"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Retry prompts","重试提示"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>这些提示在重试时作为额外的<b>用户</b>消息附加，紧接在之前的模型输出之后。</p>"],["<p>Available variables:</p>","<p>可用变量：</p>"],["Enable Jailbreak","启用越狱"],["Advanced","高级"],["Custom Parameters","自定义参数"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","您可以向OpenAI Chat API请求体中添加自定义参数。如果您想添加表单中不可用的额外参数，这很有用。"],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>警告</h2><ul><li>错误设置自定义参数可能导致API请求失败。在添加自定义参数之前，请确保您知道自己在做什么。像OpenAI这样的服务对您发送的参数有严格限制，对于无法识别的请求参数，它们将返回HTTP错误。</li><li>如果同一个键被多次使用，只有最后一个值会被采用。</li><li>如果使用了现有配置中的相同键，则现有配置参数将被自定义参数覆盖。</li></ul>"],["Drop Parameters","删除参数"],["LiteLLM Proxy Configuration","LiteLLM代理配置"],["Start LiteLLM server","启动LiteLLM服务器"],["Processing...","处理中..."],["Server started on port ","服务器已启动在端口 "],["Check LiteLLM Status","检查LiteLLM状态"],["Change LiteLLM Version","更改LiteLLM版本"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","输入您希望安装的新LiteLLM版本。\n已知可用版本：1.38.0, 1.49.4 \n建议版本为："],["Are you sure you want to install LiteLLM version ","您确定要安装 LiteLLM 版本 "],["Failed to install LiteLLM. Please check the console for more details.","LiteLLM 安装失败。请检查控制台以获取更多详情。"],["LiteLLM has been successfully updated to version ","LiteLLM 已成功更新至版本 "],["Batch Translation Setting","批量翻译设置"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","抱歉，此插件仅对活跃的赞助者开放。\n您可以通过成为每月 $1 的赞助者来解锁此功能。"],["Retries and Refinement","重试与精炼"],["<h2>Retries and Refinement</h2>","<h2>重试与精炼</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>当翻译输出验证失败时，Translator++ 可以要求模型重试翻译。您可以设置模型应重试的次数以及重试的条件。</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>设置合理的重试次数和适当的重试条件，可以在控制成本和时间的同时，显著提高翻译质量。</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>每次重试都会增加额外的时间和金钱成本</b>。如果您的批量翻译频繁重试，可能需要调整提示，使指令对模型更清晰。</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>使用开发者工具或批量管理器来调试您的批量翻译。</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>代码转义算法</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>代码转义是一种技术，用于防止 MTL 修改对话中的代码片段。这在您的对话包含代码片段（如 HTML 标签、XML 标签、JSON 对象或 JavaScript 模板）时非常有用。</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>选择与您对话中代码片段匹配的转义算法。您可能需要相应地调整 <b>系统消息</b>、<b>示例提示</b> 和 <b>正文消息</b> 模板。</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>点击 <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>此处</a> 阅读更多关于代码转义算法及其有效使用的信息。</p>"],["JavaScript template cloaking","JavaScript 模板伪装"],["None (no escaping)","无（不转义）"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","您要加载所选转义算法的示例对话预设吗？这将覆盖您现有的示例对话。"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":true,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","使用 OpenAI 批量 API 翻译"],["Model","模型"],["The pre-trained model.","预训练模型。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 批量 API 使用的模型命名约定与通用 API 略有不同。批量 API 中的模型带有“-batch”前缀。例如，如果您使用 <code>gpt-4.1-mini</code>，模型会自动变为 <code>gpt-4.1-mini-batch</code>。<br />\n然而，截至本插件创建时，批量模型未在 OpenAI 的模型使用限制中列出，这导致如果用户将模型使用过滤器设置为“允许”（白名单），则无法使用批量 API。<br />\n这可能是 OpenAI UI 中的一个错误，未来可能会修复。<br />\n因此，请确保将 OpenAI 中的使用限制设置为“阻止”（黑名单）模式，以便使用批量 API。<br />\n点击此处更改模型的使用限制：https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","原列"],["The column of the original texts you want to translate.","要翻译的原始文本列。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Ignore if already translated","如果已有翻译则跳过"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果这项功能被勾选，Translator++将会忽略一切译文栏有内容的行."],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["System Message Template","系统消息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系统消息是消息的头部，用于告知您的 chatGPT 助手的角色。此消息将作为每个发送给 chatGPT 的批量的第一条消息发送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面量样式包含以下变量 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","变量：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 源语言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目标语言</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完整的源语言名称</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完整的目标语言名称</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 转义算法的预定义消息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示换行的字符串（行替代符）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的消息数量。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 添加角色信息。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 包含一些前几行作为上下文</li>"],["Body Message Template","正文消息模板"],["Template of the body of your chat.","您聊天正文的模板。"],["Sample conversation","示例对话"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI 批量 API 允许您以 50% 更低的成本异步翻译您的项目，这意味着您将在 <b style=\"color:red\">24 小时内</b>以 <b style=\"color:blue\">正常成本的一半</b>收到翻译结果。这对于不需要立即翻译结果的大型项目特别有用。"],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />了解更多关于 OpenAI 批量 API 的信息 <a href=\"https://platform.openai.com/docs/guides/batch\" external>请点击这里</a>。"],["General Settings","常规设置"],["This form is using your OpenAI Batch API configuration.<br>","此表单使用您的 OpenAI 批量 API 配置。<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","您可以通过进入选项窗口中的 <b>OpenAI 批量 API</b> 附加组件设置来更改配置。<br>"],["There you can set the API key, model, and other settings.<br />","在那里，您可以设置 API 密钥、模型和其他设置。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"打开ChatGPT设置\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>不要在推理模型上浪费金钱</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>多项研究已证明，推理模型在执行创意写作和翻译任务时远不如普通模型。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>使用推理模型只会带来更高的成本和更慢的响应时间，别无益处。</p>"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Ignore translated rows","忽略已翻译行"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt Template","提示模板"],["<h2>1. System Message</h2>","<h2>1. 系统消息</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>您可以在此向助手解释其角色。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 您的实际提示</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>这是给助手的实际提示。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>开销成本</h3>\n                        开销成本是您发送给助手的提示消息（不包括实际翻译文本）的成本。成本根据提示消息中的令牌数量计算。令牌越多，成本越高。<br>\n                        <b>预估开销成本：</b> <span class=\"overheadCost\">0</span> 令牌 / 请求。"],["Are you sure you want to reset the form?","您确定要重置表单吗？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","您确定要处理此批次吗？\n此操作将产生成本。"],["The batch is successfully created. Do you want to open the batch manager?","批次已成功创建。您要打开批次管理器吗？"],["OpenAI Batch API Queue","OpenAI 批次 API 队列"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","请选择要应用翻译的行"],["Target Column","目标列"],["The column to put the translation result.","用于放置翻译结果的列。"],["Import translation from ChatGPT Batch","从ChatGPT批次导入翻译"],["Translation applied to selected rows","翻译已应用于选定行"],["Invalid format","格式无效"],["OK","确定"],["Mismatch","不匹配"],["Failed to load batch list with error: \n","加载批次列表失败，错误：\n"],["Download Error File","下载错误文件"],["Batch is not completed yet","批次尚未完成"],["Are you sure you want to cancel this batch?","您确定要取消此批次吗？"],["Cannot cancel completed batch.","无法取消已完成的批次。"],["Batch cancelled","批次已取消"],["Failed to cancel batch","取消批次失败"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","批次"],["Apply translation","应用翻译"],["Cancel batch","取消批次"],["Status","状态"],["Batch ID","批次ID"],["Input File ID","输入文件ID"],["End point","端点"],["Created at","创建于"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","过期于 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，已完成请求的响应可通过批次的输出文件获取。您将按已完成的请求消耗的令牌计费。\"></i>"],["Completed at","完成于"],["Errors","错误"],["Batch Item Detail of","批次项目详情"],["ID","ID"],["Completed on","完成于"],["Model","模型"],["Prompt Token","提示令牌"],["Completion Token","完成令牌"],["Total Token","总令牌"],["Status Code","状态码"],["error","错误"],["Conversation","对话"],["Response Validation","响应验证"],["Raw Payload","原始负载"],["View raw payload","查看原始负载"],["Response Preview","响应预览"],["Apply translations from selected rows","应用选定行的翻译"],["Here you can edit the translation result individually and send it into Translator++","在此处，您可以单独编辑翻译结果并将其发送到 Translator++"],["Open ChatGPT Settings","打开 ChatGPT 设置"],["Help","帮助"],["File list","文件列表"],["Collapse / restore left panel","Collapse / restore left panel"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","未及时完成的批次最终会进入过期状态；该批次中未完成的请求将被取消，而针对已完成请求的任何响应将通过批次的输出文件提供。您将按消耗的令牌收费。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 游戏标题</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 游戏引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色信息词汇表。（仅在批次模式中启用了角色信息选项时）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[对象名称] : 从 Translator++ 对象生成参考。<br />示例：<code>REFERENCE[通用参考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻译的上下文（如果启用了上下文）</li>"],["Sample conversation","示例对话"],["<h2>Sample dialogue</h2>","<h2>示例对话</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>示例现有对话。您可以编写好或坏回复的示例，以帮助翻译者理解您的目标和对话上下文。</p>"],["Always separate file","始终分离文件"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始终为每个批次分离文件。这可以保持每个文件的上下文不受其他文件污染。"],["Add actor name","添加角色名称"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","从行信息中追加角色名称到可翻译文本。这将帮助翻译者跟踪对话和代词。Translator++ 随后会从翻译结果中移除角色名称。这显然会增加翻译成本。"],["Load Actor Reference as Glossary","加载角色参考作为词汇表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾选，Translator++ 将加载角色参考作为词汇表。这将帮助翻译者理解对话的上下文。角色参考是对话中角色的名称。这将作为词汇表加载给翻译者。这会增加翻译成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有对话中存在的角色才会作为每个批次项目的词汇表加载。使用模板命令在提示消息中加载角色参考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您启用此选项，还需要在提示模板中包含 <code>ACTOR_INFO</code> 变量来放置角色信息数据。"],["Actor Reference Translation Column","角色参考翻译列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名称翻译的列。此列将用作角色参考的翻译。这将提高对话中角色名称翻译的一致性。"],["Actor's Information Column","演员信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演员附加信息的列。您可以添加更多信息，如性别、年龄等。这将改善对话中代词的翻译。"],["Extra Prompt","额外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","将添加到提示消息中的额外提示。这将在系统消息之后、实际提示消息之前添加。"],["General Settings","常规设置"],["Always separate file for each batch","始终为每个批次使用单独文件"],["Append actor name to the translatable text","将演员名称附加到可翻译文本"],["Glossary","术语表"],["<h2>Glossary</h2>","<h2>术语表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能将帮助您自动将术语表添加到提示中。术语表将为每个批次的项目加载，以提高翻译质量。该功能将尝试仅加载相关术语，以避免提示内容膨胀。</p>"],["The Column of Actor's Additional Information","演员附加信息列"],["Prompt","提示"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","批次管理器"],["This feature is only available if you have a project open.","此功能仅在打开项目时可用。"]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":true,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","启动服务器"],["Server started","服务器已启动"],["Reinstall server","重新安装服务器"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","请输入您希望安装的Translators库的新版本。\n最新版本是："],["Are you sure you want to install Translators version ","您确定要安装Translators版本"],["Failed to install Translators. Please check the console for more details.","安装Translators失败。请检查控制台以获取更多详情。"],["Translators has been successfully updated to version ","Translators已成功更新到版本"],["General Settings","常规设置"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":true,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","您确定要中止吗？"],["Process paused!\nPress OK to continue!","进程暂停!\n请选择OK以继续!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":true,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","永不从RAM卸载字典"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":true,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","无法启动翻译代理！\n翻译代理目前仅适用于$3或以上的赞助者。"],["Please enter the port number:","请输入端口号："],["Invalid port : ","无效端口："],["Port must be a numeric.","端口必须是数字。"],["Port has successfully changed to: ","端口已成功更改为："],["Connection Info","连接信息"],["Do you want to copy the base URL into the clipboard?","您想将基础URL复制到剪贴板吗？"],["Use secure protocol(HTTPS)","使用安全协议(HTTPS)"],["Port","端口"],["Connection info","连接信息"],["Help","帮助"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":true,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","在编写脚本时，将强制文本编码为所选编码。（空白=自动）<br />。您可以使用此字段将脚本转换为<b>UTF-16</b>，这样游戏无需将区域设置更改为日语即可运行。"],["Use legacy parser","使用旧版解析器"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","使用旧版（旧解析器）而非新解析器。<br />旧版解析器更快，但在某些游戏中不可靠。<br />新版解析器更可靠，但较慢。"],["Select TyranoBuilder packaged game","选择TyranoBuilder打包游戏"],["Select the exe file of your packaged game.","选择您打包游戏的exe文件。"],["Target folder","目标文件夹"],["Select destination folder. The process will replace the existing files.","选择目标文件夹。此过程将替换现有文件。"],["Extraction completed","提取完成"],["Close","关闭"],["Next","Next"],["Please select game executable file","请选择游戏可执行文件"],["Back","返回"],["The game is fully loaded, proceed!","游戏已完全加载，继续！"],["Extract data","提取数据"],["Open extracted folder","打开提取的文件夹"],["Extract resources","提取资源"],["Select the game executable","选择游戏可执行文件"],["Select the game executable or asar file to extract","选择要提取的游戏可执行文件或asar文件"],["Target directory","目标目录"],["Select the target directory to store the unpacked files","选择存储解包文件的目标目录"],["Electron archive file detected. Do you want to extract the asar file instead?","检测到Electron存档文件。是否要提取asar文件？"],["Tyranobuilder Game Extractor","TyranoBuilder游戏提取器"],["Before you create a new project, please make sure that :","在创建新项目之前，请确保："],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","<b>Kirikiri冒险游戏解析器</b>插件已安装在您的Translator++中"],["Your game is fully extracted.","您的游戏已完全提取。"],["Extract TyranoBuilder package","提取TyranoBuilder包"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","所有 .ks 和 .tjs 文件均为纯文本（未编译、未加扰且未加密）"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","某些操作会修改您的游戏。<b>因此，请确保创建游戏的备份！</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","选择游戏可执行文件。此文件是用于提取游戏数据的主游戏文件。"],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","在 Tyrano 游戏中，通常是 <b>index.html</b> 或 <b>exe</b> 文件。"],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","可能的字符编码列表。<b>顺序很重要！</b>您可以拖动以排序列表。"],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","使用 TyranoBuilder 创建的游戏采用 <b>UTF-8</b> 编码"],["Literal tags are the tags that will be escaped into Translator++ editor.","字面标签是将在 Translator++ 编辑器中转义的标签。"],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> 是必需的。"],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> 标签将由 Translator++ 插入为新行。因此您无需显式写入 <b>[r]</b>。"],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kirikiri 脚本 (.ks) 高度可定制，允许开发者创建自己的标签。"],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ 可以处理标准标签，例如以井号 (#) 开头的角色名称。"],["However, Translator++ may not be able to handle custom tags created by developers.","但是，Translator++ 可能无法处理开发者创建的自定义标签。"],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","因此，您可能需要定义需要翻译的标签和属性，以及需要标记为演员名称的标签和属性。"],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>请访问 <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder 标签参考</a>以获取有关标签的更多信息。</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","您可能需要 <input type=\"button\" value=\"提取您的游戏\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> 并在开始项目前分析其中的 <b>ks</b> 脚本。"],["Create Project","创建项目"],["Play last build","播放最新构建"],["Extract TyranoBuilder","提取 TyranoBuilder"],["Create playable package","创建可播放包"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":true,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","通用"],["Executable file location","Executable file location"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tPath to the application's executable file."],["Field can not be empty!","路径不可为空!"],["Service","Service"],["End Point","End Point"],["Auto translation service to use.","Auto translation service to use."],["Target Language","目标语言"],["The language to translate into","The language to translate into"],["Source Language","源语言"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended"],["Files","Files"],["Directory","Directory"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}"],["Output File","Output File"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}"],["Substitution File","Substitution File"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}"],["Preprocessors File","Preprocessors File"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}"],["Text Frameworks","Text Frameworks"],["Enable/Disable auto translation for Unity's text frameworks.","Enable/Disable auto translation for Unity's text frameworks."],["Behaviour","Behaviour"],["Max Characters Per Translation","Max Characters Per Translation"],["Max characters per text to translate. Max 2500.","Max characters per text to translate. Max 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Whether or not to ignore whitespace, including newlines, in dialogue keys"],["Whether or not to ignore whitespace, including newlines, in NGUI","Whether or not to ignore whitespace, including newlines, in NGUI"],["Minimum Dialogue Chars","Minimum Dialogue Chars"],["The length of the text for it to be considered a dialogue","The length of the text for it to be considered a dialogue"],["Force Split Text After Characters","Force Split Text After Characters"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)"],["Whether or not to copy hooked texts to clipboard","Whether or not to copy hooked texts to clipboard"],["MaxClipboardCopyCharacters","MaxClipboardCopyCharacters"],["Max number of characters to hook to clipboard at a time","Max number of characters to hook to clipboard at a time"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation"],["Indicates whether batching of translations should be enabled for supported endpoints","Indicates whether batching of translations should be enabled for supported endpoints"],["Indicates whether or not to use translations from the included static translation cache","Indicates whether or not to use translations from the included static translation cache"],["Override Font","Override Font"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI"],["Override Font TextMeshPro","Override Font TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro"],["Resize UI Line Spacing Scale","Resize UI Line Spacing Scale"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated."],["Ignore Text Starting With","Ignore Text Starting With"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game."],["GameLog Text Paths","GameLog Text Paths"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'."],["Romaji Post Processing","Romaji Post Processing"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]"],["Translation Post Processing","Translation Post Processing"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Indicates whether or not results of regex lookups should be output to the specified OutputFile."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Indicates whether or not whitespace differences should be output to the specified OutputFile."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile."],["Indicates that the plugin should generate translations without variables when using substitutions.","Indicates that the plugin should generate translations without variables when using substitutions."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Indicates the plugin should parse 'TARC' directives and scope translations based on these."],["Indicates the plugin should not print out success messages in relation to translations.","Indicates the plugin should not print out success messages in relation to translations."],["Blacklisted IMGUI Plugins","Blacklisted IMGUI Plugins"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components."],["Max Text Parser Recursion","Max Text Parser Recursion"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent."],["Will enable automated handling of rich text (text with markup).","Will enable automated handling of rich text (text with markup)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Indicates that the plugin must use MonoMod hooks instead of harmony hooks."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager)."],["Redirected Resource Detection Strategy","Redirected Resource Detection Strategy"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it."],["Texture","Texture"],["Texture Directory","Texture Directory"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities."],["Texture Hash Generation Strategy","Texture Hash Generation Strategy"],["Indicates how the mod identifies pictures through hashes.","Indicates how the mod identifies pictures through hashes."],["Duplicate Texture Names","Duplicate Texture Names"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Indicates specific texture names that are duplicated in the game. List is separated by ';'"],["Indicates if the plugin should detect duplicate texture names.","Indicates if the plugin should detect duplicate texture names."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage."],["Resource Redirector","Resource Redirector"],["Preferred Storage Path","Preferred Storage Path"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","Indicates if TextAssets should be redirected"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked"],["Indicates if translatable resources that are found should be dumped","Indicates if translatable resources that are found should be dumped"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files"],["HTTP","HTTP"],["User Agent","User Agent"],["Override the user agent used by APIs requiring a user agent","Override the user agent used by APIs requiring a user agent"],["Indiciates whether certificate validations for the .NET API should be disabled","Indiciates whether certificate validations for the .NET API should be disabled"],["Translation Aggregator","Translation Aggregator"],["Width","Width"],["The total width of the translation aggregator window","The total width of the translation aggregator window"],["Height","Height"],["The width (per translator) of the translation aggregator window.","The width (per translator) of the translation aggregator window."],["Enabled Translators","Enabled Translators"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'"],["Google","Google"],["ServiceUrl","ServiceUrl"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC"],["Google Legitimate","Google Legitimate"],["Google API Key","Google API Key"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","OPTIONAL, needed if GoogleTranslateLegitimate is configured"],["Bing Legitimate","Bing Legitimate"],["OcpApim Subscription Key","OcpApim Subscription Key"],["OPTIONAL, needed if BingTranslateLegitimate is configured","OPTIONAL, needed if BingTranslateLegitimate is configured"],["Baidu","Baidu"],["Baidu App Id","Baidu App Id"],["OPTIONAL, needed if BaiduTranslate is configured","OPTIONAL, needed if BaiduTranslate is configured"],["BaiduAppSecret","BaiduAppSecret"],["Yandex","Yandex"],["Yandex API Key","Yandex API Key"],["OPTIONAL, needed if YandexTranslate is configured","OPTIONAL, needed if YandexTranslate is configured"],["Watson","Watson"],["Url","Url"],["OPTIONAL, needed if WatsonTranslate is configured","OPTIONAL, needed if WatsonTranslate is configured"],["Key","秘钥"],["DeepL","DeepL"],["MinDelay","最小延迟"],["OPTIONAL, used for throttling DeepL","可选，用于限制DeepL请求频率"],["MaxDelay","最大延迟"],["DeepL Legitimate","DeepL合法"],["OPTIONAL, required if DeepLLegitimate is configured","可选，如果配置了DeepL合法则必需"],["Custom","自定义"],["Optional, needed if Custom Translated is configured","Optional, needed if Custom Translated is configured"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","InstallationPath"],["Optional, needed if Lec Power Translator 15 is configured","Optional, needed if Lec Power Translator 15 is configured"],["Debug","Debug"],["Enables the console. Do not enable if other plugins (managers) handles this","Enables the console. Do not enable if other plugins (managers) handles this"],["Enables extra logging for debugging purposes","Enables extra logging for debugging purposes"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","Installation Path of ezTrans."],["Migrations","Migrations"],["Used to enable automatic migrations of this configuration file","Used to enable automatic migrations of this configuration file"],["Tag","标签"],["Tag representing the last version this plugin was executed under. Do not edit","Tag representing the last version this plugin was executed under. Do not edit"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":true,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!"],["XUnity.AutoTranslator is found!","检测到XUnity.AutoTranslator！"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++检测到XUnity.AutoTranslator已安装。Translator++将使用现有翻译数据启动新翻译项目。"],["XUnity.AutoTranslator is not found!","未找到XUnity.AutoTranslator！"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","向导将引导您将XUnity.AutoTranslator安装到游戏中。"],["Next","Next"],["Given path: ","Given path: "],["\nis not an Unity game. Do you still want to proceed?","\nis not an Unity game. Do you still want to proceed?"],["Patch successfully installed!\r\n","补丁安装成功！\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","配置将在您首次运行游戏时生成。\r\n"],["Open the game now?","现在打开游戏？"],["Finish","Finish"],["Update current project?","Update current project?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":true,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","消息框最大行数"],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","默认值为4。输入0可禁用此功能。如果消息框中的行数超过此数值，Translator++将生成新消息框以防止文本溢出。"],["Use shell copy if possible","尽可能使用Shell复制"],["Use shell copy instead of native NodeJS copy handler.","使用Shell复制而非原生NodeJS复制处理程序。"],["Use shell copy","使用Shell复制"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","WRPGE编辑器未安装\r\n请从T++菜单 > 第三方应用安装程序安装\r\n\r\n现在打开第三方应用安装程序？"],["Unable to determina WRPGE path.","无法确定WRPGE路径。"],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++即将在目标文件夹中安装WRPGE编辑器。\r\n继续吗？"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","开发路径未定义。\n您应注入游戏一次以生成开发路径。"],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","使用WolfJs库翻译Wolf RPG游戏，最高支持版本3.330。Translator++的默认Wolf RPG解析器。"],["Wolf RPG Editor games","Wolf RPG Editor游戏"],["Parsing Wolf RPG Game with","正在解析Wolf RPG游戏，使用"],["Wolf RPG Editor game","Wolf RPG Editor游戏"],["Select the game's executable file","选择游戏的可执行文件"],["Engine version","引擎版本"],["Detected WolfRPG Engine version of the selected game","检测到所选游戏的WolfRPG引擎版本"],["Heads up!\r\n","注意！\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\n似乎不是Wolf RPG可执行文件！\r\n确定要从这个入口点启动Wolf RPG项目吗？"],["Create a new project","创建新项目"],["Please specify a game to be processed!","请指定要处理的游戏！"],["Set dev path. Path to the directory of the translated game.","设置开发路径。指向翻译后游戏的目录路径。"],["Play last build","播放最新构建"],["Open editor","打开编辑器"],["Open Wolf RPG Editor online manual","打开Wolf RPG Editor在线手册"],["Open Wolf RPG Editor english manual","打开Wolf RPG Editor英文手册"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","找不到手册文件。\n请通过第三方应用安装程序安装Wolf RPG Editor。"]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":true,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","开始从类XML文档翻译。支持XML和HTML格式。"],["Create project","创建项目"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":true,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","YU-RIS引擎翻译器"],["Checking up requirements...","正在检查要求..."],["Create a new translation project from YU-RIS visual novel engine","从YU-RIS视觉小说引擎创建新的翻译项目"],["Next","Next"],["Select YU-RIS game","选择YU-RIS游戏"],["Select the game's executable file","选择游戏的可执行文件"],["Engine version","引擎版本"],["Detected YU-RIS version of the selected game","检测到所选游戏的YU-RIS版本"],["Create a new project","创建新项目"],["Invalid target game :","无效的目标游戏："],["Source material do not match the current translation project!","源材料与当前翻译项目不匹配！"],["Select the repack method.","选择重新打包方法。"],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>重新打包到原始YPF文件</b><br />将翻译重新打包到原始包中。可能需要更长时间来提取原始包、用翻译修补并重新打包。</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>重新打包为YPF补丁文件</b><br>将翻译重新打包为单独的补丁文件（例如update9.ypf）。这样，即使不修改原始ypf文件也能翻译游戏。结合复制材料的<b>不复制材料，仅注入翻译</b>选项，可实现更快的修补过程。</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","目标重新打包版本必须与您的游戏版本匹配。输入用点分隔的主版本和次版本。例如：<b>0.466</b>。默认情况下，Translator++会在创建项目时检测引擎版本。"]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":true,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","表格生成器"],["Run","运行"],["New Project (ctrl+n)","新建项目 (ctrl+n)"],["Open (ctrl+o)","打开 (ctrl+o)"],["Save file (ctrl+s)","保存文件 (ctrl+s)"],["Save As (ctrl+shift+s)","另存为 (ctrl+shift+s)"],["Open debugger (F12)","打开调试器 (F12)"],["Help","帮助"],["Select file in the current workspace","在当前工作区域选择文件"],["file path","文件路径"],["Create shortcut of the current script","为当前脚本创建快捷方式"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":true,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"parameters":[]},"/find.html":{"data":[["Find","查找"],["Replace","替换"],["Put","新增"],["Target","目标"],["Grid","文本"],["Context","地址"],["Tag","标签"],["Comment","备注"],["Untranslated rows","未翻译行"],["Refine","优化"],["Case sensitive","区分大小写"],["Transpile \\r\\n\\t","忽略 \\r\\n\\t"],["RegExp","正则表达式"],["All files","所有文件"],["Select All Columns","选择所有列"],["Find all string above and replace with :","将所有搜寻到的文本替换为 :"],["Original text:","原文本:"],["Text to put :","替换文本 :"],["into: ","放置到（列）: "],["Search all files","查找所有文件"],["Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)","输入关键词后按回车。可使用通配符模式（例如：*.png）"],["Drag to select, Shift+Drag to unselect","拖动以选中，Shift+拖动取消选择"],["Select target column","选择目标列"],["A line in the original text to find. Press alt+enter to add a new line.","在原文中查找。按下alt+enter添加新行。"],["Translation","翻译文本"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":true,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","无法找到数据对应的原文件"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>"],["Copy path to clipboard","将路径复制到剪贴板"],["Path has been copied to clipboard.","路径已被复制到剪贴板."],["Open folder","打开文件夹"],["Open with external application","用外部应用打开"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","打开方式..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~使用默认翻译~"],["Column","列"],["Do you want to delete all context translation on the currently selected row?","你真的想要删除该行包含的全部地址翻译吗?"],["Do you want to delete all translation on the currently active row?","你真的想要删除该行的全部翻译吗?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":true,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","无法识别的插件格式"],["invalid type addonObj.addons","无法识别的.addons 插件格式"],["You are not eligible to get this addon","您没有权限获得这个插件。"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":true,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","在创建 Translator++ 的快捷方式之前，请先保存当前项目。"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能仅在您使用 Translator++ 的开发者版本时可用。您可以通过基本工具 -> 更改核心 NWJS 切换到开发者版本。"]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/find.js":{"data":[["Action","操作"],["Append tags","增加标签"],["Remove tags","删除标签"],["Set tags","设置标签"],["Do nothing","取消"],["Close","关闭"],["Proceed","Proceed"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","关键词太短！\n您想搜索所有行吗？尝试使用星号 '*' 作为关键词。"],["Found nothing!<br />Don't forget to set the Target search field.","什么也没找到!<br />请注意搜索的格式以及范围."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","未找到可替换文本!<br />替换功能没有替换任何文本."],["Replace '","用 '"],["' with '","' 替换 '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'吗?\n该项操作没有撤销功能!\n你真的要这样操作吗?"],["click to go","确认继续"],["This will replace any translation found in target colum,\nAre you sure?","这项操作将会替换所有目标列的翻译内容,\n真的确定吗?"],["Keyword too short!","关键词太短!"],["Not found!","没有找到结果！"],["Are you sure want to execute the following script?","确定要执行下列脚本吗？"],["For ","对于 "],[" selected item(s)?","选择的对象是?"],[" Select all","全选"],[" Invert selection","反选"],[" Clear selection","清除选择"],[" Set Red tag","选定红色标签"],[" Set Yellow tag","选定黄色标签"],[" Set Green tag","选定绿色标签"],[" Set Blue tag","选定蓝色标签"],[" Set Gold tag","选定金色标签"],[" More tags...","更多标签..."],[" Clear tags","清除标签"],[" Create Automation","创建自动化脚本"],[" Run Automation","执行自动化脚本"],[" Clear Automation","清除自动化脚本"],["Are you sure want to clear all quick launch scripts?","真的要移除所有快速启动项吗？"],[" Clear translation","删除翻译"],["Do you want to clear translations of the selected items?","真的要删除所选择的项目中的全部翻译吗?"],[" Delete rows","删除行"],["Do you want to remove selected rows?\nYou can not undo this action!","真的想要删除所选行吗?\n该操作不可撤销!"],[" With selection ...","对选择项 ..."],["Always on top","置顶"],["Default","默认"],["Blur opacity","显示清晰度"],["Type regex with the modifier","输入正则表达式"],["Use $n to replace a group. e.g. $1","用 $n 替换一整组. 例如： $1"],["Find","查找"],["Replace","替换"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":true,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","隐藏密码"],["Show password","显示密码"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":true,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","某些设置需要重启软件才能生效.\n请注意先保存你的文件，然后再重新启动Translator++."],["Pleae select the name for your configuration.","请选择您的翻译器名称。"],["Translator Engine configuration","翻译引擎配置"],["Translator engine version.","翻译器版本"],["By.","By."],["No option for this engine","该引擎下没有设置选项"],["License","许可"],["Can not disable this addon","无法关闭该项插件"],["Requirements","需求"],["What is this?","这是什么?"],["Uninstall","卸载"],["Update","更新"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","插件安装成功.\n你可能需要重启Translator++才能使插件生效."],["WARNING!\n","警告！"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","此插件在更新过程中更换了解析器。 使用了此插件的旧工程可能无法按预期运行。 建议在安装此附加组件前备份您的工程。\n您可以将现有翻译导入新创建的工程。\n\n您是否需要安装"],["Do you want to install ","您是否需要安装"],["Add-on","插件"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","已成功安装。\r\nTranslator++ 可能需要重启才能使某些插件生效。"],["Add-on version.","插件版本."],["No option for this add-on","该插件没有设置界面"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++ 将会编辑系统注册表.\n确定继续吗?"],["Error parsing patterns:","解析错误:"],["Do you really want to clear the custom escaper?","真的想要清空自定义代码栏吗?"],["Do you really want to reset the custom escaper?","真的想要重置自定义代码栏吗?"],["You are currently on the latest version.\nDo you still want to update?","您目前是最新版本.\n仍然想要更新版本吗?"],["This option will open your default browser to login.\nDo you want to continue?","该功能将会打开您的默认浏览器进行登录.\n要继续吗?"],["Login with Browser","使用浏览器登录"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","您的浏览器已打开至 <b>dreamsavior.net/gettoken/</b>。<br>登录后，登录将自动完成。<br><br>如果自动登录无效，请从该页面复制您的令牌并粘贴到下方："],["There is no default translator selected.\nChange the default translator to Google!","未找到默认翻译引擎.\n将默认切换到以Google引擎翻译!"],["Change Stagging Path to :","修改缓存路径至 :"],["Move the content of current Stagging Path into the new one?","将现有缓存文件转入新的位置吗?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","插件已经成功安装.\n需要重新启动Translator++才能使其生效."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","是否真的要删除所有设置并重置Translator++?\n请注意，这项操作是不可逆的.\n在执行此操作前请务必备份您的工程文件."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","您必须修复这个错误才能确保Translator++正常运行.\n要关闭设置窗口吗?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":true,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","在创建 Translator++ 的快捷方式之前，请先保存当前项目。"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能仅在您使用 Translator++ 的开发者版本时可用。您可以通过基本工具 -> 更改核心 NWJS 切换到开发者版本。"]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>无法运行 PHP 解释器！</b><br />\n\t\t\t\tTranslator++ 需要 PHP CLI 来运行一些必要程序。<br />\n\t\t\t\t此错误通常发生是因为您的计算机<b>未安装<a href=\"http://dreamsavior.net/download/#TPPSysreq\">正确版本的 Microsoft Visual C++ 可再发行组件</a></b>。\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>请安装<a href=\"http://dreamsavior.net/download/#TPPSysreq\">所需的运行时</a>。</li>\n\t\t\t\t\t\t<li>如果已安装所有运行时但仍遇到此错误，请将 Translator++ 安装目录移动到其他文件夹。</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t有关此症状的更多信息，请查看<a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>文档</a>。"],["Initialization Error!","初始化错误！"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":true,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"parameters":[]},"/js/trans.js":{"data":[["Original Text","原始文本"],["Initial","翻译文本"],["Machine translation","机器翻译"],["Better translation","润色翻译"],["Best translation","最终翻译"],["Loading","加载中"],["Error!","错误！"],["Error processing init file : ","init文件处理错误 :"],["Error! File list not found in init file at : ","错误! 在init文件中未发现文件列表 :"],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","这意味着您的游戏未成功解析。请访问 https://dreamsavior.net/?p=1311 获取此问题的可能解决方案。"],["Done!","完成!"],["All done!","全部完成!"],["Error opening file : ","无法打开文件 :"],["error opening file (open): ","打开文件错误（打开）："],["Project properties - Staging path error!","项目属性 - 暂存路径错误！"],["Project properties","项目属性"],["untitled project","未命名工程"],["create file list","创建文件列表"],["Finished","结束"],["All process finished!","全部进程结束!"],["Open Explorer","打开显示器"],["Opening file!","打开文件中!"],["Assigning new staging path : ","指定新的缓存路径 :"],["Success!","成功!"],["Failed!","失败!"],["Collecting paths","确认路径"],["Path : '","路径 : '"],["' doesn't exist","' 不存在"],[" file(s) collected!","确认文件!"],["Start importing data!","开始导入数据!"],["Importing : ","导入中 :"],["All Done!","全部完成!"],[" is not a valid object name","不是一个正确的工程名字"],[" is not a valid directory name","不是一个合法的路径"],[" is already exist","已存在"],["Error opening file :","打开文件错误："],["Error executing :","执行错误："],["Are you sure want to execute the following script?","确定要执行下列脚本吗？"],["Clear quick launch","清除快速启动"],["Are you sure want to clear quick launch?","您确定要清除快速启动吗？"],["How to add Automation here","如何在这里添加自动项"],["Select all","全选"],["Clear selection","取消选择"],["Select 100%","选择 100%"],["Select <100%","选择 <100%"],["Select progress ≥ ...","选择进度 ≥ ..."],["Select completed","选择已完成项"],["Invert selection","反向选择"],["Toggle mark as complete","高亮标记为已完成"],["With all","全部选择"],["With ","With"],[" selected","已选择"],["Mark as complete","高亮标记为已完成"],["Un-mark as complete","取消已完成标记"],["Batch translation","机器翻译"],["Send to...","发送到..."],["Wrap texts","自动换行"],["Trim","自动首行对齐"],["Auto padding","自动原文对齐"],["Context Tool","地址工具"],["Create Automation","创建自动化脚本"],["For each object","对每个文件"],["For each row","对每行"],["Run Automation","运行自动化脚本"],["Import from...","从文件导入..."],["Trans File","Trans 文件"],["Spreadsheets","电子表格"],["RPGMTransPatch Files","RPGMTransPatch 文件"],["Export into...","导出到..."],["A folder","文件夹"],["Zipped Game Patch","Zip游戏补丁"],["Comma Separated Value (csv)","Comma Separated Value (csv)"],["Excel 2007 Spreadsheets (xlsx)","Excel 2007 电子表格 (xlsx)"],["Excel Spreadsheets (xls)","Excel 电子表格 (xls)"],["ODS Spreadsheets","ODS 电子表格"],["Html Spreadsheets","Html 电子表格"],["RMTrans Patch","RMTrans Patch"],["Inject Translation","注入/应用翻译"],["Revert to original","还原为原始"],["Clear translation","删除翻译"],["Delete files","删除文件"],["Properties","属性"],["Select progress greater than","选择进度大于"],["Please input a number","请输入一个数字"],["Do you want to clear translation?","你真的想删除翻译吗?"],["Add comment","新增备注"],["Remove comment","移除备注"],["added to reference table!","添加到公共引用表!"],["Can not modify Column 0","无法编辑原文列"],["Unable to delete table : ","无法删除表格 :"],["Can not remove key column!","无法删除选定列!"],["Please open or create a project first","请先打开或者新建一个工程"],["Column name can not be empty!","列名不能为空！"],["Invalid column index!","无效的列索引！"],["Please open or create a new project first!","请先打开或者新建一个工程！"],["You should not edit key value","无法编辑原始文本"],["Ilegal value","数值超出范围"],["That value already exist!","该项数值已存在!"],["The maximum number of columns for this project has been reached, so you cannot add any more.","此项目的最大列数已达到，因此无法添加更多列。"],["Are you sure want to abort this process?","你确定要退出该项进程吗?"],["Process paused!\nPress OK to continue!","进程暂停!\n请选择OK以继续!"],["Unable to process, project not found","无法进行操作，工程不存在"],["Unable to process, data not found","无法进行操作，数据不存在"],["Translation engine not found","未找到翻译引擎"],["Translation engine ","翻译引擎"],[" is disabled!","已经关闭!"],["Selected files :","选择文件 :"],["Collecting data from :","收集数据 :"],["Translation finished","翻译结束"],["applying translation to table!","将译文填入表格!"],["Error when translating data!","翻译过程中出现错误!"],["\tHTTP Status : ","HTTP 状态 :"],["\tError Type : ","错误类型 :"],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","你很可能已经被翻译服务器禁止访问!\n请适量使用在线翻译引擎。\n该项错误通常在一两天后会自己恢复."],["Running trans.translateAll","运行 trans.translateAll"],["Start collecting data!","开始收集数据!"],["Data collection is done!","数据收集完成!"],["nothing is selected","未选中任何项目"],["no translator loaded","未加载任何翻译"],["unable to load translator window","无法加载翻译窗口"],["Reference path cannot empty!","参考路径不能为空!"],["Collecting translation refference","收集参考翻译"],["Applying translation!","应用翻译中!"],["Importing translation","注入翻译"],["Parsing data","分析数据中"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions","并不是有效的javascript正则表达式!\n需要Javascipt正则表达式的帮助可以点击以下网址:\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"],["Keyword too short!","关键词太短!"],["Delete comment","删除备注"],["Translate here","在这里翻译"],["Translate here using ","在该处使用机翻，翻译软件"],["Translate using...","选择翻译引擎翻译..."],["Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?","您是否希望翻译整个项目中的所有相同文本，并在选定的单元格中进行翻译？"],[" cell(s) has been written!","单元格已写入!"],["Column width","列宽"],["Width must greater than 0","列宽需要大于0"],["Insert column right","在该列右侧插入列"],["Duplicate column","复制列"],["Remove this column","删除该列"],["Remove selected column?\nThis can not be undone!","要删除选中的列吗?\n该操作无法撤回!"],["Rena