nslation":77,"Revert to original":78,"Clear translation":79,"Delete files":80,"Properties":81,"Select progress greater than":82,"Please input a number":83,"Do you want to clear translation?":84,"Add comment":85,"Remove comment":86,"added to reference table!":87,"Can not modify Column 0":88,"Unable to delete table : ":89,"Can not remove key column!":90,"Please open or create a project first":91,"Column name can not be empty!":92,"Invalid column index!":93,"Please open or create a new project first!":94,"You should not edit key value":95,"Ilegal value":96,"That value already exist!":97,"The maximum number of columns for this project has been reached, so you cannot add any more.":98,"Are you sure want to abort this process?":99,"Process paused!\nPress OK to continue!":100,"Unable to process, project not found":101,"Unable to process, data not found":102,"Translation engine not found":103,"Translation engine ":104," is disabled!":105,"Selected files :":106,"Collecting data from :":107,"Translation finished":108,"applying translation to table!":109,"Error when translating data!":110,"\tHTTP Status : ":111,"\tError Type : ":112,"You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n":113,"Running trans.translateAll":114,"Start collecting data!":115,"Data collection is done!":116,"nothing is selected":117,"no translator loaded":118,"unable to load translator window":119,"Reference path cannot empty!":120,"Collecting translation refference":121,"Applying translation!":122,"Importing translation":123,"Parsing data":124," is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions":125,"Keyword too short!":126,"Delete comment":127,"Translate here":128,"Translate here using ":129,"Translate using...":130,"Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?":131," cell(s) has been written!":132,"Column width":133,"Width must greater than 0":134,"Insert column right":135,"Duplicate column":136,"Remove this column":137,"Remove selected column?\nThis can not be undone!":138,"Rename this column":139,"Please enter new name":140,"Tags":141,"Red":142,"Yellow":143,"Green":144,"Blue":145,"Gold":146,"More tags...":147,"Clear tags":148,"Delete Row":149,"Do you want to remove the currently selected row(s)?":150,"Clear Context Translation":151,"Clear Automation":152,"Are you sure want to clear all quick launch scripts?":153,"Append rows to reference":154,"Row properties":155},"tags":[],"parameters":[]},"/js/ui.js":{"data":[["`You cannot close the application at this moment, reason: \\n${","`您此时无法关闭应用程序，原因：\\n${"],["}`","}`"],["Do you really want to exit Translator++?\nAll unsaved changes will be discarded!","你确定要关闭Translator++吗?\n未保存的数据将全部丢失!"],["Trans file","翻译文件"],["Translator++ Project Package (TPP) file","Translator++工程文件 (.TPP) "],["Select all","全选"],["Select none","全不选"],["Invert","反选"],["Match destination selection","Match destination selection"],["use mouse drag to do bulk selection","运用鼠标框选批量选择"],["Invalid trans data","无法识别翻译数据"],["Inject / Apply translation","注入 / 应用 翻译"],["Inject / Apply translation to all","全部 注入 / 应用 翻译"],["Cancel","取消"],["Apply Translation","应用翻译"],["Target path cannot be a parent or child of the source material's path.\nPlease select another path.","目标路径不能是源材料路径的父级或子级。\n请选择另一个路径。"],["Help","帮助"],["Import","导入"],["Revert to origin data","恢复默认设置"],["Select target directory.","选择目标词典"],["The existing files will be overwritten!","将会覆盖当前文件"],["Process","开始"],["Path to the directory can not be empty!","路径不能为空!"],["Invalid directory:","路径非法:"],["Rebuild translation table from this cache","从缓存中重建该表格"],["Create new project","新建工程"],["-nothing-","-空白-"],["Ok","Ok"],["No action selected, are you sure?","什么都没有选择, 确定吗?"],["No context's keyword specified!","没有指定地址关键词!"],["Remove context containing keyword :\n","移除工程中包含 :\n"],["\nfrom selected files?","\n从选定的文件？"],["Remove every rows except rows that has a context containing keyword :\n","移除所有行，除非地址中包含下列关键词 :\n"],["items","类"],["Select Context","选择地址"],["Manual Query","人工输入"],["Tag filter","标签过滤器"],["Merging option","合并选项"],["Source Column","原列"],["Target Column","目标列"],["Maximum length","最长长度"],["Query","查询"],["Select how you want to filter the rows to be wrapped based on their context.","选择您希望如何根据上下文过滤要包装的行。"],["Your list of context separated by new line","文件将根据地址进行分行"],["Optionally filter rows by their color tags.","可选地按颜色标签过滤行。"],["Options","选项"],["No merging","不合并"],["Merge lines","合并行"],["Merge lines except first line","合并除第一行外的行"],["General setup","常规设置"],["Wrap text","文本换行"],["Source & target column can not be same!","待转换列和转换列不能相同!"],["No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?","未选中任何需要操作的目标文件.\nTranslator++ 将会对所有文件进行所选操作\n确定要继续吗?"],["One or more required options are not set for ","缺乏必须的设置"],["One or more settings required by the translator engine are not set. If you continue, the translation process may fail.","引擎缺乏必备的设置。如果仍要继续，翻译进程可能会闪退"],["Required options :","需要的设置 :"],["Open the settings","打开设置界面"],["Continue anyway","继续"],["Translate Now","现在翻译"],["Please select translator engine","请选择翻译引擎"],["Can not process your request because the source column and target column are same!","无法完成操作，因为目标列和源列相同!"],["Tags","标记"],["Merge Option","合并选项"],["Add rows","添加行"],["None","无"],["Merge","合并"],["Merge except the first line","合并除第一行外"],["No export path specified","未指定导出路径"],["Export path can not be inside or the same with the project folder.\nYour export path: ","导出路径不能位于或与项目文件夹相同。\n您的导出路径："],["\nYour project path: ","\n您的项目路径："],["\n\nPlease choose another folder!","\n\n请选择另一个文件夹！"],["Export Now","导出文件"],["Action","操作"],["Append tags","增加标签"],["Remove tags","删除标签"],["Set tags","设置标签"],["Do nothing","取消"],["-unknown title-","-未命名标题-"],["Can not open file. File not exist.","无法打开文件，文件不存在"],["Go to online documentation.","转到在线说明."],["No projects yet","没有工程"],["Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t","请问您是第一次使用Translator++吗?<br />\n\t          请在<b>dreamsavior.net</b>.<br />阅读本软件的使用说明\n\t\t  也可以按<b>F1</b>来打开在线说明.<br />\n\t\t  可以通过<b>patreon.com/dreamsavior</b>联系我咨询或者提交BUG."],["Warning","警告"],["Close","关闭"],["You are about to run a user script!","您即将运行自定义的脚本"],["Execute the script","运行脚本"],["Bring to main screen","切换至主界面"],["Show row header info","显示行标题信息"],["Row header width","行标题宽度"],["Display marker on organic cells","显示原单元格标签"],["Leave trail on cell visit","访问单元格时留下痕迹"],["Display trails on visited cells","显示当前单元格路径"],["Row Properties","行属性"],["Project Properties","工程属性"],["Project Properties : ","工程属性 :"],["Stage path do not exist!","路径不存在！"],["Select dev folder","选择默认文件夹"],["Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.","需要翻译的游戏的具体位置<br />该路径将与应用翻译时注入的游戏的路径相同."],["Select folder","选择文件夹"],["Submit","提交"],["File Properties","文件属性"],["File Properties : ","文件属性 :"],["Target column","目标列"],["Trim Whitespaces","对齐白名单"],["Please select a column","请选择列"],["Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!","确定要在白名单对应列上进行对齐操作吗?\n该项操作不可撤回!"],["Are you sure want commit autopadding on selected column?\nThis action can not be undone!","确定要在目标列上进行自动操作吗?\n该项操作不可撤回!"],["Markers","标记"],["Markers are visual guidelines for the number of characters in a line.","标记是行内字符数的视觉参考线。"],["The marker will only be visible if wordwrap in the text area is disabled.","仅当文本区域禁用自动换行时，标记才可见。"],["Add","添加"],["Clear all","清除所有"],["Enable suggestion","启用建议"],["Speech Synthesizer","语音合成器"],["Reading speed:","阅读速度："],["Pitch:","音高："],["Volume:","音量："],["Mark at","标记于"],["Units","单位"],["Half width character (ie. Alphabet, etc)","半角字符 (例如. 英文字母等)"],["Full width character (ie. Hiragana, Kanji, 漢字, etc)","全角字符 (例如. 平假名，汉字等)"],["Color","颜色"],["Remove","移除"],["Current Cell's Editor Options","当前单元格编辑设置"],["Auto Padding","批量原文对齐"],["Create","创建"],["Unable to open that file!","无法打开该文件!"],["Are you sure want to close the project?\nYou will lost any unsaved changes!","你确定要关闭工程吗?\n未保存的数据将全部丢失!"],["Are you sure want to exit Translator++?\nYou will lost any unsaved changes!","你确定要关闭Translator++吗?\n未保存的数据将全部丢失!"],["Do not show this message again!","不再显示这条信息!"],["Back","返回"],["Are you sure want to execute the following script?","确定要执行下列脚本吗？"],["No script found","无可执行脚本代码"],["Open Script Editor","打开脚本编辑器"],["How to add Automation here","如何在这里添加自动项"],["Clear Quick Launch","清除快速启动"],["Are you sure want to clear all quick launch scripts?","真的要移除所有快速启动项吗？"],["Remove selected objects?","移除选定的项目吗?"],["Do you wish to remove related staging files too?\nWarning: This is can not be undone!","是否需要删除对应的缓存文件?\n警告: 该操作是不可逆的!"],["Error!\r\nTranslator++ is unable to detect the type of ","错误!\nTranslator++无法识别"],["`Required application to parse ${","`类型，需要其他应用来解析 ${"],["} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`","} 未安装.\\n青葱第三方插件处安装该应用.\\n现在就打开第三方插件安装窗口吗?`"],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","该游戏通过Enigma加密了.\n是否需要解包游戏?\n这会可能要花费一些时间."],["Copy & extract data into ","在该文件夹下复制并解包游戏"],["Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!","你真的确定要删除当前界面上的所有的翻译文本吗?\n警告: 该操作是不可逆的!"],["Are you realy sure want to delete current file?\nWarning: this is irreversible action!","你真的确定要删除当前文件吗?\n警告: 该操作是不可逆的!"],["Please enter the title","请输入标题"],["Do you want to remove the currently selected row(s)?","你想要删除现在选中的行吗?"]],"context":[["tid/154/type/TemplateHead"],["tid/158/type/TemplateTail"],["tid/202/type/StringLiteral"],["tid/1201/type/StringLiteral"],["tid/1261/type/StringLiteral"],["tid/4827/type/StringLiteral"],["tid/4834/type/StringLiteral"],["tid/4841/type/StringLiteral"],["tid/4848/type/StringLiteral"],["tid/4855/type/StringLiteral"],["tid/8249/type/StringLiteral"],["tid/8829/type/StringLiteral"],["tid/8861/type/StringLiteral"],["tid/9513/type/StringLiteral","tid/10983/type/StringLiteral","tid/11779/type/StringLiteral","tid/12739/type/StringLiteral","tid/13697/type/StringLiteral","tid/17723/type/StringLiteral","tid/20089/type/StringLiteral","tid/21021/type/StringLiteral","tid/23071/type/StringLiteral","tid/23751/type/StringLiteral","tid/36680/type/StringLiteral","tid/38040/type/StringLiteral","tid/38571/type/StringLiteral","tid/43926/type/StringLiteral","tid/44634/type/StringLiteral","tid/59585/type/StringLiteral","tid/60083/type/StringLiteral","tid/60416/type/StringLiteral"],["tid/9564/type/StringLiteral"],["tid/9784/type/StringLiteral"],["tid/10939/type/StringLiteral"],["tid/11030/type/StringLiteral","tid/11826/type/StringLiteral"],["tid/12499/type/NoSubstitutionTemplate","tid/12580/type/StringLiteral"],["tid/12504/type/NoSubstitutionTemplate"],["tid/12509/type/NoSubstitutionTemplate"],["tid/12802/type/StringLiteral"],["tid/12862/type/StringLiteral","tid/36791/type/StringLiteral"],["tid/12891/type/StringLiteral","tid/36820/type/StringLiteral"],["tid/13200/type/StringLiteral"],["tid/13613/type/StringLiteral"],["tid/17536/type/StringLiteral"],["tid/17773/type/StringLiteral","tid/23801/type/StringLiteral","tid/38091/type/StringLiteral","tid/38622/type/StringLiteral","tid/40249/type/StringLiteral","tid/43977/type/StringLiteral"],["tid/17841/type/StringLiteral"],["tid/17951/type/StringLiteral"],["tid/17990/type/StringLiteral"],["tid