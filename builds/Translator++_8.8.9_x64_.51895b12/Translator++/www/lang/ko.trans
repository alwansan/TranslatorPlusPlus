,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","사용자 정의 모델.사용자 정의 라벨"],["model","모델"],["|","|"],["promptLibrary","프롬프트 라이브러리"],["search","검색"],["downloadChat","채팅 다운로드"],["newChat","새 채팅"],["api","API"],["customEndpoint","사용자 정의 엔드포인트"],["apiEndpoint.inputLabel","API 엔드포인트.입력 라벨"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","import"],["name","name"],["prompt","prompt"],["clearPrompts","clearPrompts"],["morePrompts","morePrompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","button.sync"],["button.stop","button.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ChatGPT 배치 API로 번역"],["Model","모델"],["The pre-trained model.","사전 훈련된 모델."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 배치 API는 일반적으로 사용되는 API와 약간 다른 모델 명명 규칙을 사용하는 것으로 보입니다. 배치 API에서 사용되는 모델에는 '-batch' 접두사가 붙습니다. 예를 들어, <code>gpt-4.1-mini</code>를 사용하면 모델이 자동으로 <code>gpt-4.1-mini-batch</code>가 됩니다.<br />\n그러나 이 애드온이 생성된 시점 기준으로, 배치 모델은 OpenAI의 모델 사용 제한 목록에 나열되지 않아, 사용자가 모델 사용 필터를 '허용'(화이트리스트)으로 설정한 경우 배치 API를 사용할 수 없습니다.<br />\n이는 OpenAI UI의 버그일 가능성이 있으며, 향후 수정될 수 있습니다.<br />\n따라서 배치 API를 사용하려면 OpenAI에서 사용 제한을 '차단'(블랙리스트) 모드로 설정해야 합니다.<br />\n모델 사용 제한을 변경하려면 여기를 클릭하세요: https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","원본 열"],["The column of the original texts you want to translate.","번역하려는 원본 텍스트의 열입니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 배우 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 이후 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Ignore if already translated","이미 번역된 경우 무시"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","이 옵션을 선택하면 Translator++는 해당 열에 이미 번역이 있는 행을 무시합니다."],["Load Actor Reference as Glossary","배우 참조를 용어집으로 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택하면 Translator++는 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서 배우의 이름입니다. 이는 번역자에게 용어집으로 로드되어 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용되어 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있어 대화에서 대명사 번역을 개선합니다."],["System Message Template","시스템 메시지 템플릿"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","시스템 메시지는 ChatGPT 어시스턴트의 역할을 알려주는 메시지의 헤더입니다. 이 메시지는 ChatGPT로 보내는 모든 배치의 첫 번째 메시지로 전송됩니다."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript의 템플릿 리터럴 스타일 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>를 사용하여 다음 변수를 포함할 수 있습니다."],["Variables:<br>","변수:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 원본 언어</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 대상 언어</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 전체 원본 언어 이름</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 전체 대상 언어 이름</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 원본 텍스트</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 이스케이프 알고리즘의 사전 정의된 메시지.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 새 줄을 나타내는 문자열 (줄 대체).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 배치 내 메시지 수.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 배우 정보 추가.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 일부 이전 줄을 컨텍스트로 포함</li>"],["Body Message Template","본문 메시지 템플릿"],["Template of the body of your chat.","채팅 본문의 템플릿."],["Sample conversation","샘플 대화"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT 배치 API를 사용하면 프로젝트를 비동기적으로 50% 저렴한 비용으로 번역할 수 있어, 번역 결과를 <b style=\"color:red\">24시간 이내</b>에 <b style=\"color:red\">정상 비용의 절반</b>으로 받을 수 있습니다. 이는 즉각적인 번역 결과가 필요하지 않은 대규모 프로젝트에 특히 유용합니다."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />ChatGPT 배치 API에 대해 더 알아보기: https://platform.openai.com/docs/guides/batch ."],["General Settings","일반 설정"],["This form is using your existing ChatGPT configuration.<br>","이 양식은 기존 ChatGPT 구성을 사용합니다.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","옵션 창의 ChatGPT 번역기 설정으로 이동하여 구성을 변경할 수 있습니다.<br>"],["There you can set the API key, model, and other settings.<br />","거기서 API 키, 모델 및 기타 설정을 지정할 수 있습니다.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT 설정 열기\" />"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Ignore translated rows","번역된 행 무시"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 자동으로 용어집을 추가하여 번역 품질을 향상시킵니다. 용어집은 각 항목 배치마다 로드되며, 프롬프트가 부풀어오르는 것을 방지하기 위해 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Prompt Template","프롬프트 템플릿"],["<h2>1. System Message</h2>","<h2>1. 시스템 메시지</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>여기에서 어시스턴트에게 그들의 역할이 무엇인지 설명할 수 있습니다.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플입니다. 좋은 또는 나쁜 응답의 샘플을 작성하여 번역자가 목표와 대화의 맥락을 이해하도록 도울 수 있습니다.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 실제 프롬프트</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>이것은 어시스턴트에게 보내는 실제 프롬프트입니다.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>간접 비용</h3>\n                        간접 비용은 실제 번역 텍스트 없이 어시스턴트에게 보내는 프롬프트 메시지의 비용입니다. 이 비용은 프롬프트 메시지의 토큰 수를 기반으로 계산됩니다. 토큰이 많을수록 비용이 높아집니다.<br>\n                        <b>현재 간접 비용:</b> <span class=\"overheadCost\">0</span> 토큰 / 요청."],["Are you sure you want to reset the form?","정말로 양식을 초기화하시겠습니까?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","정말로 배치를 처리하시겠습니까?\n이 작업에는 비용이 발생합니다."],["The batch is successfully created. Do you want to open the batch manager?","배치가 성공적으로 생성되었습니다. 배치 관리자를 열겠습니까?"],["OpenAI Batch API Queue","OpenAI 배치 API 대기열"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조를 생성합니다. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","번역을 적용할 행을 선택하세요"],["Target Column","대상 열"],["The column to put the translation result.","번역 결과를 넣을 열입니다."],["Import translation from ChatGPT Batch","ChatGPT 배치에서 번역 가져오기"],["Translation applied to selected rows","선택한 행에 번역이 적용됨"],["Invalid format","잘못된 형식"],["OK","확인"],["Mismatch","불일치"],["Failed to load batch list with error: \n","오류로 배치 목록을 로드하지 못했습니다: \n"],["Download Error File","오류 파일 다운로드"],["Batch is not completed yet","배치가 아직 완료되지 않았습니다"],["Are you sure you want to cancel this batch?","이 배치를 취소하시겠습니까?"],["Cannot cancel completed batch.","완료된 배치는 취소할 수 없습니다."],["Batch cancelled","배치 취소됨"],["Failed to cancel batch","배치 취소 실패"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","배치들"],["Apply translation","번역 적용"],["Cancel batch","배치 취소"],["Status","상태"],["Batch ID","배치 ID"],["Input File ID","입력 파일 ID"],["End point","엔드포인트"],["Created at","생성일"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","만료일 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"시간 내에 완료되지 않은 배치는 결국 만료 상태로 이동하며, 해당 배치 내 미완료 요청은 취소되고 완료된 요청에 대한 응답은 배치의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 부과됩니다.\"></i>"],["Completed at","완료일"],["Errors","오류"],["Batch Item Detail of","배치 항목 상세 정보"],["ID","ID"],["Completed on","완료일"],["Model","모델"],["Prompt Token","프롬프트 토큰"],["Completion Token","완성 토큰"],["Total Token","총 토큰"],["Status Code","상태 코드"],["error","오류"],["Conversation","대화"],["Response Validation","응답 검증"],["Raw Payload","원본 페이로드"],["View raw payload","원본 페이로드 보기"],["Response Preview","응답 미리보기"],["Apply translations from selected rows","선택한 행에서 번역 적용"],["Here you can edit the translation result individually and send it into Translator++","여기서 번역 결과를 개별적으로 편집하고 Translator++로 전송할 수 있습니다."],["Open ChatGPT Settings","ChatGPT 설정 열기"],["Help","도움말"],["File list","파일 목록"],["Collapse / restore left panel","왼쪽 패널 접기 / 복원"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","시간 내에 완료되지 않은 배치는 결국 만료 상태로 이동합니다. 해당 배치 내 미완료 요청은 취소되며, 완료된 요청에 대한 응답은 배치의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 청구됩니다."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보 용어집 (일괄 처리 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조를 생성합니다. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 컨텍스트 (컨텍스트가 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>추론 모델에 돈을 낭비하지 마세요</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>다양한 연구에 의해, 추론 모델이 창의적인 글쓰기와 번역 작업에서 일반 모델보다 훨씬 더 나쁘다는 것이 입증되었습니다.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>추론 모델을 사용하면 더 비싼 비용과 느린 응답 시간만 얻을 뿐입니다.</p>"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>샘플 기존 대화. 번역자가 목표와 대화의 맥락을 이해하도록 돕기 위해 좋거나 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["Always separate file","항상 파일 분리"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","각 일괄 처리마다 항상 파일을 분리하세요. 이렇게 하면 각 파일의 컨텍스트가 다른 파일과 섞이지 않게 유지할 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 배우 이름을 번역 가능한 텍스트에 추가합니다. 이렇게 하면 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","용어집으로 배우 참조 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","체크하면, Translator++가 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서 배우의 이름입니다. 이는 번역자에게 용어집으로 로드됩니다. 이는 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 일괄 처리 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 프롬프트 템플릿에 캐릭터 정보 데이터를 배치하기 위해 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","액터 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","액터 이름 번역의 열입니다. 이 열은 액터 참조의 번역으로 사용되어 대화에서 액터 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","액터 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","액터의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있으며, 이는 대화에서 대명사 번역을 개선합니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 시스템 메시지 후와 실제 프롬프트 메시지 전에 추가됩니다."],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치마다 별도 파일"],["Append actor name to the translatable text","번역 가능한 텍스트에 액터 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 자동으로 용어집을 추가하는 데 도움을 줍니다. 용어집은 번역 품질을 향상시키기 위해 각 배치 항목에 로드되며, 프롬프트가 부풀어오르지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","액터 추가 정보 열"],["Prompt","프롬프트"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>전</u>송"],["Toggle word wrap","줄 바꿈 전환"],["Open debugger (F12)","디버거 열기 (F12)"],["Help","도움말"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","이 기능은 Translator++의 개발자 버전을 사용하는 경우에만 사용할 수 있습니다. 기본 유틸리티 -> 코어 NWJS 변경을 통해 개발자 버전으로 전환할 수 있습니다."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 액터 정보 용어집 (배치 모드에서 액터 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 컨텍스트 (컨텍스트가 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플. 번역자가 목표와 대화 맥락을 이해하도록 좋거나 나쁜 응답의 예시를 작성할 수 있습니다.</p>"],["Always separate file","항상 파일 분리"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","각 배치마다 항상 파일을 분리하세요. 이렇게 하면 각 파일의 맥락이 다른 파일로 오염되지 않을 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 번역 가능한 텍스트에 배우 이름을 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","용어집으로 배우 참조 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택하면, Translator++는 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서의 배우 이름입니다. 이는 번역가에게 용어집으로 로드되어 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 캐릭터 정보 데이터를 배치하기 위해 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용되어 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있어 대화에서 대명사 번역을 개선합니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 이는 시스템 메시지 후와 실제 프롬프트 메시지 전에 추가됩니다."],["General Settings","일반 설정"],["Always separate file for each batch","각 배치마다 항상 파일 분리"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 용어집을 프롬프트에 자동으로 추가하여 번역 품질을 향상시키는 데 도움을 줍니다. 용어집은 각 항목 배치마다 로드되며, 프롬프트가 부풀어 오르지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Prompt","프롬프트"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","ChatGPT API와 채팅"],["Batch Manager","배치 관리자"],["This feature is only available if you have a project open.","이 기능은 프로젝트가 열려 있을 때만 사용할 수 있습니다."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","이 작업은 브라우저 창을 실행합니다. 기본 브라우저가 Chrome 브라우저로 설정되어 있는지 확인하세요. 계속하시겠습니까?"],["Gemini Nano server is already running. Do you want to restart it?","Gemini Nano 서버가 이미 실행 중입니다. 재시작하시겠습니까?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","이 작업은 브라우저 창을 실행합니다. 기본 브라우저가 Chrome으로 설정되어 있는지 확인하세요. 그리고 Gemini Nano 서버가 시작됩니다. 계속하시겠습니까?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":true,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보 용어집.(일괄 처리 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 컨텍스트 (컨텍스트가 활성화된 경우)</li>"],["Always separate file","항상 파일 분리"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","각 배치마다 항상 파일을 분리하세요. 이렇게 하면 각 파일의 컨텍스트가 다른 파일과 혼합되지 않도록 유지할 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 배우 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 그런 다음 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","배우 참조를 용어집으로 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택하면, Translator++는 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 컨텍스트를 이해하는 데 도움이 됩니다. 배우 참조는 대화에서 배우의 이름입니다. 이는 번역자에게 용어집으로 로드됩니다. 이는 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 캐릭터 정보 데이터를 배치하기 위해 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용됩니다. 이는 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있습니다. 이는 대화에서 대명사의 번역을 향상시킵니다."],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치마다 별도 파일"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 용어집을 자동으로 추가하여 번역 품질을 향상시킵니다. 용어집은 각 배치 항목마다 로드되며, 프롬프트가 부풀어오르지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","서비스 이름"],["Service provider for your Batch API.","배치 API에 대한 서비스 제공업체입니다."],["Your API Key","당신의 API 키"],["Please enter your API key for the Batch API service.","배치 API 서비스에 대한 API 키를 입력해 주세요."],["Model","모델"],["The model for your translation.","번역에 사용할 모델입니다."],["Source Column","원본 열"],["The column of the original texts you want to translate.","번역하려는 원본 텍스트의 열입니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","번역 가능한 텍스트에 행 정보에서 배우 이름을 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 번역 결과에서 배우 이름을 제거합니다. 이는 번역 비용을 증가시킵니다."],["Ignore if already translated","이미 번역된 경우 무시"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","이 옵션을 선택하면 Translator++는 이미 해당 열에 번역이 있는 행을 무시합니다."],["Filter Tag","필터 태그"],["If set, only rows with this tag will be translated.","설정된 경우, 이 태그가 있는 행만 번역됩니다."],["Load Actor Reference as Glossary","액터 참조를 용어집으로 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","이 옵션을 선택하면 Translator++가 액터 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 액터 참조는 대화에서 액터의 이름입니다. 이는 번역자에게 용어집으로 로드되어 번역 비용을 증가시킬 수 있습니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대해 용어집으로 로드됩니다. 프롬프트 메시지에서 액터 참조를 로드하려면 템플릿 명령을 사용하세요."],["Actor Reference Translation Column","액터 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","액터 이름의 번역이 있는 열입니다. 이 열은 액터 참조의 번역으로 사용되어 대화에서 액터 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","액터 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","액터의 추가 정보가 포함된 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있으며, 이는 대화에서 대명사의 번역을 개선합니다."],["Enable Context","컨텍스트 활성화"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","번역을 위한 컨텍스트를 활성화합니다. 현재 배치 위의 이전 번역된 자료가 컨텍스트로 포함됩니다. <b>템플릿에 CONTEXT를 명시적으로 포함시켜야 합니다.</b>"],["Context Character Limit","컨텍스트 문자 제한"],["Character limit for the context.","컨텍스트에 대한 문자 제한입니다."],["System Message Template","시스템 메시지 템플릿"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","시스템 메시지는 chatGPT 어시스턴트의 역할을 알리는 메시지의 헤더입니다. 이 메시지는 chatGPT에 보내는 모든 배치의 첫 번째 메시지로 전송됩니다."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript의 템플릿 리터럴 스타일 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span>을 사용하여 다음 변수를 포함할 수 있습니다.<br>"],["Variables:<br>","변수:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 원본 언어</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 대상 언어</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 전체 원본 언어 이름</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 전체 대상 언어 이름</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 원본 텍스트</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 탈출 알고리즘의 사전 정의된 메시지.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 새 줄을 나타내는 문자열 (줄 대체).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 배치 내 메시지 수.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 배우 정보 추가.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성. <br />예: <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 일부 이전 줄을 컨텍스트로 포함</li>"],["Body Message Template","본문 메시지 템플릿"],["Template of the body of your chat.","채팅 본문의 템플릿."],["Sample conversation","샘플 대화"],["User message","사용자 메시지"],["Assistant's response","어시스턴트 응답"],["Enable JailBreak","JailBreak 활성화"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","번역을 위해 Jailbreak를 활성화합니다. 이렇게 하면 번역이 더 정확하고 편향되지 않게 됩니다. 일부 모델은 가상의 사건을 실제 사건과 연관시키려 할 수 있어, 자신의 서사에 맞게 번역을 변경하려 할 수 있습니다. 이 옵션은 이를 방지합니다."],["Jailbreak Template","Jailbreak 템플릿"],["Template of the Jailbreak message.","Jailbreak 메시지의 템플릿."],["Maximum Tokens","최대 토큰 수"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","완성에서 생성할 최대 토큰 수.<br>프롬프트의 토큰 수와 max_tokens의 합이 모델의 컨텍스트 길이를 초과할 수 없습니다. 대부분의 모델은 2048 토큰의 컨텍스트 길이를 가집니다 (4096을 지원하는 최신 모델 제외)."],["Temperature","온도"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0에서 2 사이의 샘플링 온도를 사용합니다. 0.8과 같은 높은 값은 출력을 더 무작위로 만들고, 0.2와 같은 낮은 값은 더 집중적이고 결정론적으로 만듭니다. <br>OpenAI는 일반적으로 이 값이나 top_p 중 하나만 변경하도록 권장합니다."],["Nucleus sampling (top_p)","핵 샘플링 (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","온도 샘플링의 대안으로, 핵 샘플링이라고 하며, 모델이 top_p 확률 질량을 가진 토큰의 결과를 고려합니다. 따라서 0.1은 상위 10% 확률 질량을 구성하는 토큰만 고려됨을 의미합니다. <br>OpenAI는 일반적으로 이 값이나 온도 중 하나만 변경하도록 권장합니다."],["Frequency Penalty","빈도 패널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자입니다. 양수 값은 지금까지 텍스트에서 기존 빈도를 기반으로 새 토큰에 패널티를 부여하여 모델이 동일한 줄을 그대로 반복할 가능성을 줄입니다. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","존재 패널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자입니다. 양수 값은 지금까지 텍스트에 나타나는지 여부를 기반으로 새 토큰에 패널티를 부여하여 모델이 새로운 주제에 대해 이야기할 가능성을 높입니다. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","사용자 정의 매개변수"],["Key","키"],["Value","값"],["Type","유형"],["Type of the value.","값의 유형입니다."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b> 유형의 경우 값은 JavaScript 코드로 평가됩니다."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript 코드의 범위는 <code>window</code>입니다. 따라서 거의 모든 값을 가져올 수 있습니다."],["Example: <code>trans.project.title</code>","예: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","API에 전송되지 않을 매개변수를 삭제합니다.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API는 계속 변화하고 있으며, 일부 새로운 모델은 이전 매개변수를 지원하지 않을 수 있고 인식되지 않은 요청 매개변수에 대해 HTTP 오류를 반환할 수 있습니다."],["You can drop the parameters that are not supported by the model here.","모델에서 지원되지 않는 매개변수를 여기서 삭제할 수 있습니다."],["Batch API settings","배치 API 설정"],["General","일반"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI Batch API를 사용하면 프로젝트를 비동기적으로 번역할 수 있으며, 비용이 50% 절감됩니다. 즉, <b style=\"color:red\">24시간 이내</b>에 번역 결과를 받을 수 있고, <b style=\"color:blue\">일반 비용의 절반</b>으로 이용할 수 있습니다. 이는 즉각적인 번역 결과가 필요하지 않은 대규모 프로젝트에 특히 유용합니다."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Batch API에 대해 더 알아보려면 <a href=\"https://platform.openai.com/docs/guides/batch\" external>여기</a>를 클릭하세요.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />지원 서비스: <b>OpenAI</b> 및 <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>추가 설정은 애드온 설정에서 확인하세요</h2>"],["Open Add-on Settings","애드온 설정 열기"],["Import Configuration from OpenAI Setting","OpenAI 설정에서 구성 가져오기"],["General Settings","일반 설정"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>추론 모델에 돈을 낭비하지 마세요</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>다양한 연구에 따르면, 추론 모델은 창의적인 글쓰기와 번역 작업에서 일반 모델보다 훨씬 성능이 떨어집니다.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>추론 모델을 사용하면 비용만 더 비싸지고 응답 시간이 느려질 뿐입니다.</p>"],["<h2>If you're using OpenAI</h2>","<h2>OpenAI를 사용 중이라면</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","OpenAI Batch API는 표준 API와 약간 다른 모델 명명 규칙을 사용합니다. 배치 모드의 모델에는 -batch 접미사가 포함됩니다. 예를 들어, <code>gpt-4.1-mini</code>를 지정하면 자동으로 <code>gpt-4.1-mini-batch</code>로 해석됩니다.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","그러나 이 애드온이 개발된 시점에는 배치 모델이 OpenAI의 모델 사용 제한 목록에 포함되지 않았습니다. 이는 모델 사용 필터를 '허용'(화이트리스트)으로 설정한 사용자가 Batch API에 접근할 수 없음을 의미합니다.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","모델 사용 제한을 변경하려면 <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>여기</a>를 클릭하세요."],["Explore more models","더 많은 모델 탐색"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Ignore translated rows","번역된 행 무시"],["Templates","템플릿"],["<h2>1. System Message</h2>","<h2>1. 시스템 메시지</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>여기서 어시스턴트에게 그들의 역할이 무엇인지 설명할 수 있습니다.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>샘플 기존 대화. 번역자가 목표와 대화의 맥락을 이해하는 데 도움이 되도록 좋거나 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 실제 프롬프트</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>어시스턴트에 대한 실제 프롬프트입니다.</p>"],["Enable Jailbreak","탈옥 활성화"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 자동으로 용어집을 추가하는 데 도움을 줍니다. 번역 품질을 향상시키기 위해 각 항목 배치에 용어집이 로드됩니다. 이 기능은 프롬프트가 부풀어오르지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Enable context","맥락 활성화"],["Advanced","고급"],["Custom Parameters","사용자 정의 매개변수"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API 요청 본문에 사용자 정의 매개변수를 추가할 수 있습니다. 이는 폼에서 사용할 수 없는 추가 매개변수를 추가하려는 경우에 유용합니다."],["<h2>Warning</h2>","<h2>경고</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>사용자 정의 매개변수를 잘못 설정하면 API 요청이 실패할 수 있습니다. 사용자 정의 매개변수를 추가하기 전에 무엇을 하고 있는지 확인하세요. OpenAI와 같은 일부 서비스는 전송하는 매개변수에 대해 엄격하며, 인식되지 않은 요청 매개변수에 대해 HTTP 오류를 반환합니다.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>동일한 키가 여러 번 사용되면 마지막 값만 사용됩니다.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>기존 구성에 동일한 키가 사용되면 기존 구성 매개변수가 사용자 정의 매개변수로 덮어쓰여집니다.</li>"],["String","문자열"],["Number","숫자"],["Boolean","불리언"],["JavaScript","자바스크립트"],["Drop Parameters","매개변수 삭제"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>간접 비용</h3>\n                        간접 비용은 실제 번역 텍스트 없이 어시스턴트에게 보내는 프롬프트 메시지의 비용입니다. 이 비용은 프롬프트 메시지의 토큰 수를 기반으로 계산됩니다. 토큰이 많을수록 비용이 높아집니다.<br>\n                        <b>예상 간접 비용:</b> <span class=\"overheadCost\">0</span> 토큰 / 요청."],["Are you sure you want to reset the form?","양식을 초기화하시겠습니까?"],["Translate with Batch API","배치 API로 번역"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","배치를 처리하시겠습니까?\n이 작업에는 비용이 발생합니다."],["The batch is successfully created. Do you want to open the batch manager?","배치가 성공적으로 생성되었습니다. 배치 관리자를 열겠습니까?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","OpenAI 설정에서 구성을 가져오시겠습니까? 이 작업은 현재 구성을 덮어씁니다."],["chatGPT engine is not found","chatGPT 엔진을 찾을 수 없습니다"],["Configuration imported successfully.","구성이 성공적으로 가져와졌습니다."],["Batch API Queue","배치 API 대기열"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","번역을 적용할 행을 선택해 주세요"],["Target Column","대상 열"],["The column to put the translation result.","번역 결과를 넣을 열입니다."],["Import translation from ChatGPT Batch","ChatGPT 배치에서 번역 가져오기"],["Translation applied to selected rows","선택한 행에 번역이 적용되었습니다"],["Invalid format","잘못된 형식"],["OK","확인"],["Mismatch","불일치"],["Failed to load batch list with error: \n","오류로 배치 목록을 불러오지 못했습니다: \n"],["Download Error File","오류 파일 다운로드"],["Batch is not completed yet","배치가 아직 완료되지 않았습니다"],["Are you sure you want to cancel this batch?","이 배치를 취소하시겠습니까?"],["Cannot cancel completed batch.","완료된 배치는 취소할 수 없습니다."],["Batch cancelled","배치 취소됨"],["Failed to cancel batch","배치 취소 실패"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","배치"],["Apply translation","번역 적용"],["Cancel batch","배치 취소"],["Status","상태"],["Batch ID","배치 ID"],["Input File ID","입력 파일 ID"],["End point","엔드포인트"],["Created at","생성 시각"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","만료 시각 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"시간 내에 완료되지 않은 배치는 결국 만료 상태로 이동합니다. 해당 배치 내의 미완료 요청은 취소되며, 완료된 요청에 대한 응답은 배치의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 부과됩니다.\"></i>"],["Completed at","완료 시각"],["Errors","오류"],["Batch Item Detail of","배치 항목 상세 정보"],["ID","ID"],["Completed on","완료 시각"],["Model","모델"],["Prompt Token","프롬프트 토큰"],["Completion Token","완성 토큰"],["Total Token","총 토큰"],["Status Code","상태 코드"],["error","오류"],["Conversation","대화"],["Response Validation","응답 검증"],["Raw Payload","원본 페이로드"],["View raw payload","원본 페이로드 보기"],["Response Preview","응답 미리보기"],["Apply translations from selected rows","선택한 행에서 번역 적용"],["Here you can edit the translation result individually and send it into Translator++","여기서 번역 결과를 개별적으로 편집하고 Translator++로 보낼 수 있습니다"],["Open ChatGPT Settings","ChatGPT 설정 열기"],["Help","도움말"],["File list","파일 목록"],["Collapse / restore left panel","왼쪽 패널 접기 / 복원"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","시간 내에 완료되지 않은 배치는 결국 만료 상태로 이동하며, 해당 배치 내 미완료 요청은 취소되고 완료된 요청에 대한 응답은 배치의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 청구됩니다."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","서비스 이름"],["Service provider for your Batch API.","배치 API용 서비스 제공업체입니다."],["API Key","API 키"],["Please enter your API key for the Batch API service.","배치 API 서비스용 API 키를 입력해 주세요."],["Model","모델"],["The pre-trained model","사전 훈련된 모델"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","ChatGPT에서는 사용할 수 있는 모델을 설정해야 할 수 있습니다(https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","탈옥 활성화"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","번역에 탈옥을 활성화합니다. 이렇게 하면 번역이 더 정확하고 편향되지 않게 됩니다. 일부 모델은 가상의 사건을 실제 생활 사건과 연관시키려 할 수 있어, 자신의 서사에 맞추기 위해 번역을 변경하려 할 수 있습니다. 이 옵션은 이를 방지합니다."],["Jailbreak Template","탈옥 템플릿"],["Template of the Jailbreak message.","탈옥 메시지의 템플릿입니다."],["Maximum Tokens","최대 토큰"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","생성할 완성문의 최대 토큰 수입니다.<br>프롬프트의 토큰 수와 최대 토큰 수를 합한 값이 모델의 컨텍스트 길이를 초과할 수 없습니다. 대부분의 모델은 2048 토큰의 컨텍스트 길이를 가지며(최신 모델은 4096을 지원), 이를 참고하세요."],["Temperature","온도"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0에서 2 사이의 샘플링 온도를 사용합니다. 0.8과 같은 높은 값은 출력을 더 무작위로 만들고, 0.2와 같은 낮은 값은 더 집중적이고 결정론적으로 만듭니다.<br>OpenAI는 일반적으로 이 값이나 top_p 중 하나만 변경할 것을 권장합니다."],["Nucleus sampling (top_p)","핵 샘플링 (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","온도 샘플링의 대안으로, 모델이 top_p 확률 질량을 가진 토큰의 결과를 고려하는 핵 샘플링입니다. 따라서 0.1은 상위 10% 확률 질량을 구성하는 토큰만 고려함을 의미합니다.<br>OpenAI는 일반적으로 이 값이나 온도 중 하나만 변경할 것을 권장합니다."],["Frequency Penalty","빈도 패널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자입니다. 양수 값은 텍스트에서 기존 빈도에 기반해 새로운 토큰에 패널티를 부과하여, 모델이 동일한 문장을 그대로 반복할 가능성을 줄입니다.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","존재 패널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자입니다. 양수 값은 텍스트에서 나타나는지 여부에 기반해 새로운 토큰에 패널티를 부과하여, 모델이 새로운 주제에 대해 이야기할 가능성을 높입니다.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","배치당 최대 문자 수"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","번역 배치당 최대 문자 제한입니다.\n이 옵션은 원본 텍스트의 문자 길이만 계산하며, 프롬프트 메시지의 문자 길이는 포함하지 않습니다."],["Max row per concurrent requests","동시 요청당 최대 행 수"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","각 동시 요청에 허용되는 행 수입니다. <b>0</b>으로 설정하면 이 기능을 비활성화합니다.<br />이 옵션이 비활성화되면 <b>최대 동시 요청</b>을 얼마나 설정하든, Translator++는 요청을 단일 청크로 처리합니다.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","설정한 행 수가 많을수록 단일 배치에서 더 많은 번역을 얻을 수 있습니다. 따라서 오버헤드 비용을 줄이고 AI가 오류 결과를 반환할 가능성을 높입니다.<br />숫자가 낮을수록 번역 오류 가능성은 줄지만, 오버헤드 프롬프트에 대한 추가 비용이 발생합니다."],["Code Escaping Algorithm","코드 이스케이프 알고리즘"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","대화 내 인라인 코드에 대한 이스케이프 알고리즘입니다. 선택한 이스케이프 알고리즘에 따라 <b>시스템 메시지 템플릿</b>과 <b>본문 메시지 템플릿</b>을 변경해야 할 수 있습니다.<br /><b>JSONCloaking</b>을 선택하면 response_format: { type: 'json_object' } 매개변수가 ChatGPT에 자동으로 전송됩니다. <b>JSONCloaking</b>은 매우 정확하지만 모든 모델에서 작동하지는 않으니, <b>gpt-3.5-turbo-1106</b>을 시도해 보세요."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>배치 API</b>를 사용하면 한 번에 많은 요청을 제출할 수 있으며, 이는 백그라운드에서 비동기적으로 처리됩니다. 결과를 즉시 받지는 못하지만, 프로세스는 <b>24시간 이내에 완료</b>되며 종종 더 빠르게 처리됩니다. 이 방법은 <b>표준 접근 방식보다 절반의 비용만</b> 듭니다."],["Batch API settings","배치 API 설정"],["General","일반"],["Explore more models","더 많은 모델 탐색"],["Templates","템플릿"],["Enable Jailbreak","탈옥 활성화"],["Advanced","고급"],["Batch Translation Setting","배치 번역 설정"],["Default","기본값"],["JavaScript template cloaking","JavaScript 템플릿 은폐"],["None (no escaping)","없음 (이스케이프 없음)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보 용어집 (배치 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 컨텍스트 (컨텍스트가 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>샘플 기존 대화. 번역자가 목적과 대화의 맥락을 이해하도록 좋은 또는 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["Always separate file","항상 별도 파일"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","각 배치마다 항상 파일을 분리합니다. 이렇게 하면 각 파일의 컨텍스트가 다른 파일과 혼합되지 않도록 유지할 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 배우 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 그 후 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","용어집으로 배우 참조 불러오기"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","체크하면, Translator++가 배우 참조를 용어집으로 불러옵니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서의 배우 이름입니다. 이는 번역자에게 용어집으로 불러와집니다. 이는 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 불러옵니다. 프롬프트 메시지에 배우 참조를 불러오려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 캐릭터 정보 데이터를 배치하기 위해 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용됩니다. 이는 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있습니다. 이는 대화에서 대명사의 번역을 향상시킵니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 이는 시스템 메시지 후와 실제 프롬프트 메시지 전에 추가됩니다."],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치에 대해 별도의 파일"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 자동으로 용어집을 추가하는 데 도움이 됩니다. 용어집은 번역 품질을 향상시키기 위해 각 배치 항목에 대해 불러옵니다. 이 기능은 프롬프트를 부풀리지 않도록 관련 용어만 불러오려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보의 열"],["Prompt","프롬프트"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","배치 관리자 열기"],["This feature is only available if you have a project open.","이 기능은 프로젝트가 열려 있을 때만 사용 가능합니다."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":true,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","LiteLLM 프록시 URL. LiteLLM 프록시의 URL 주소입니다. 기본값은 <code>http://localhost:8890/chat/completions</code>입니다."],["API's base URL","API 기본 URL"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","선택한 서비스의 기본 URL입니다. 사용자 정의 엔드포인트 URL을 사용하는 경우에만 이 필드를 채우세요. LiteLLM은 주어진 모델을 기반으로 기본 URL을 자동으로 감지합니다.<br />LiteLLM이 URL에 경로를 추가하는 방식은 서비스에 따라 다릅니다. 예를 들어, OpenAI 호환 엔드포인트의 경우 LiteLLM은 주어진 URL에 <code>/chat/completions</code>를 추가합니다. 따라서 엔드포인트가 <code>https://api.fast-tunnel.one/v1/chat/completions</code>인 경우, 이 필드를 <code>https://api.fast-tunnel.one/v1</code>로 채우세요."],["API Version","API 버전"],["Optional. The API version parameter needed for some services.","선택 사항. 일부 서비스에 필요한 API 버전 매개변수입니다."],["API Key","API 키"],["Optional. The API key used for authenticating your access to the service.","선택 사항. 서비스에 대한 접근 인증에 사용되는 API 키입니다."],["Model","모델"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","선택한 모델을 사전 훈련하세요. 선호하는 모델을 지정하기 위해 LiteLLM 모델 편의 형식을 활용하세요. 형식은 {서비스 이름}/{모델}입니다. 예를 들어:"],["your deployment name","배포 이름"],["However, some models have unique names that can be directly identified, like:","그러나 일부 모델은 다음과 같이 직접 식별할 수 있는 고유한 이름을 가집니다:"],["Azure AD Token","Azure AD 토큰"],["AWS Access Key ID","AWS 액세스 키 ID"],["AWS secret access key","AWS 비밀 액세스 키"],["Open router site URL","Open router 사이트 URL"],["Open router APP name","Open router 앱 이름"],["Enable Context","컨텍스트 활성화"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","번역을 위한 컨텍스트를 활성화합니다. 현재 배치 위의 이전 번역된 자료가 컨텍스트로 포함됩니다. <b>템플릿에 CONTEXT를 명시적으로 포함해야 합니다</b>"],["Context Character Limit","컨텍스트 문자 제한"],["Character limit for the context.","컨텍스트의 문자 제한입니다."],["System Message Template","시스템 메시지 템플릿"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","시스템 메시지는 ChatGPT 어시스턴트의 역할을 알리는 메시지의 헤더입니다. 이 메시지는 ChatGPT로 보내는 모든 배치의 첫 번째 메시지로 전송됩니다."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript의 템플릿 리터럴 스타일로 다음 변수를 포함할 수 있습니다 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","변수:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 원본 언어</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 대상 언어</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 원본 텍스트</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 이스케이프 알고리즘의 사전 정의된 메시지입니다.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 새 줄을 나타내는 문자열(줄 대체).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 배치의 메시지 수입니다.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보 용어집.(배치 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성. <br />예 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 맥락 (맥락이 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["User message","사용자 메시지"],["Assistant's response","어시스턴트의 응답"],["Body Message Template","본문 메시지 템플릿"],["Template of the body of your message.","메시지 본문의 템플릿입니다."],["Enable JailBreak","JailBreak 활성화"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","번역을 위해 Jailbreak를 활성화합니다. 이렇게 하면 번역이 더 정확하고 편향되지 않게 됩니다. 일부 모델은 가상의 사건을 실제 생활 사건과 연관시키려 할 수 있어, 자신의 서사에 맞게 번역을 변경하려 할 수 있습니다. 이 옵션은 이를 방지합니다."],["Jailbreak Template","Jailbreak 템플릿"],["Template of the Jailbreak message.","Jailbreak 메시지의 템플릿입니다."],["Maximum Tokens","최대 토큰 수"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","생성할 완성에서의 최대 토큰 수입니다.<br>프롬프트의 토큰 수와 max_tokens의 합은 모델의 컨텍스트 길이를 초과할 수 없습니다. 대부분의 모델은 2048 토큰의 컨텍스트 길이를 가집니다(최신 모델은 4096을 지원합니다)."],["Temperature","온도"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0에서 2 사이의 샘플링 온도를 사용합니다. 0.8과 같은 높은 값은 출력을 더 무작위로 만들고, 0.2와 같은 낮은 값은 더 집중적이고 결정적으로 만듭니다. <br>OpenAI는 일반적으로 이 옵션이나 top_p 중 하나만 변경할 것을 권장합니다."],["Nucleus sampling (top_p)","핵 샘플링 (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","온도 샘플링의 대안으로, 핵 샘플링이라고 하며, 모델이 top_p 확률 질량을 가진 토큰의 결과를 고려합니다. 따라서 0.1은 상위 10% 확률 질량을 구성하는 토큰만 고려됨을 의미합니다. <br>OpenAI는 일반적으로 이 옵션이나 온도 중 하나만 변경할 것을 권장합니다."],["Frequency Penalty","빈도 페널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자. 양수 값은 지금까지 텍스트에서 토큰의 기존 빈도를 기반으로 새 토큰에 불이익을 주어, 모델이 동일한 줄을 그대로 반복할 가능성을 감소시킵니다. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","존재 페널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자. 양수 값은 지금까지 텍스트에 나타나는지 여부를 기반으로 새 토큰에 불이익을 주어, 모델이 새로운 주제에 대해 이야기할 가능성을 증가시킵니다. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","JSON 스키마 사용"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","오래된 <code>json_object</code> 대신 <code>response_format.type</code> 필드에 <code>json_schema</code>를 사용하세요. <code>json_schema</code>는 일부 최신 모델과 <b>LM Studio</b>와 같은 일부 서버에서 필요하지만, 일부 오래된 모델은 여전히 <code>json_object</code>를 사용합니다."],["Stop","중지"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","API가 추가 토큰 생성을 중지할 키워드를 입력하세요. 각 항목은 새 줄로 구분하세요."],["Additional argument variables","추가 인수 변수"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","서버를 시작할 때 추가될 추가 인수 변수입니다.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","배치 타임아웃"],["Timeout for each batch in milisecond","각 배치에 대한 타임아웃(밀리초 단위)"],["Max Request Length","최대 요청 길이"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","각 번역 배치의 최대 문자 길이입니다.\n각 번역기는 다른 사양을 가지고 있습니다.\nGET 매개변수를 사용하는 WEB 프론트엔드 번역기의 경우 2000 미만을 권장합니다."],["Max concurrent requests","최대 동시 요청 수"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","동시에 연결할 수 있는 동시 요청 수입니다. 이 기능을 비활성화하려면 <b>0</b>으로 설정하세요.<br />이 옵션을 <b>동시 요청당 최대 행 수</b>와 결합하여 번역 속도를 높이세요."],["Max row per concurrent requests","동시 요청당 최대 행 수"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","각 동시 요청에 허용되는 행 수입니다. 이 기능을 비활성화하려면 <b>0</b>으로 설정하세요.<br />이 옵션이 비활성화되면 <b>최대 동시 요청 수</b>를 얼마나 설정하든, Translator++는 요청을 단일 청크로 처리합니다."],["Batch delay","배치 지연"],["Delay between batch (in miliseconds)","배치 간 지연(밀리초 단위)"],["Code Escaping Algorithm","코드 이스케이핑 알고리즘"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","대화 내 인라인 코드 이스케이프 알고리즘. 선택한 이스케이프 알고리즘에 따라 <b>시스템 메시지 템플릿</b>과 <b>본문 메시지 템플릿</b>을 변경해야 할 수 있습니다."],["Number of retry","재시도 횟수"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","번역 출력 검증 실패 시 엔진이 재시도해야 하는 횟수입니다. nullish(비어 있음)인 경우 재시도하지 않습니다."],["Retry when the number of translated rows doesn't match original","번역된 행 수가 원본과 일치하지 않을 때 재시도"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","활성화하면 모델이 원본 페이로드와 비교하여 다른 수의 번역 행을 반환할 때 엔진이 재시도합니다."],["Retry when the number of lines for each translated row doesn't match original","각 번역 행의 줄 수가 원본과 일치하지 않을 때 재시도"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","활성화하면 번역된 행 중 원본 행보다 다른 줄 수를 가진 경우 엔진이 재시도합니다."],["Prompt: Row count mismatch","프롬프트: 행 수 불일치"],["Prompt used when retrying due to row/element count mismatch.","행/요소 수 불일치로 인한 재시도 시 사용되는 프롬프트입니다."],["Prompt: Line count mismatch","프롬프트: 줄 수 불일치"],["Prompt used when retrying due to per-row line count mismatch.","행별 줄 수 불일치로 인한 재시도 시 사용되는 프롬프트입니다."],["Prompt: Error / Retry instruction","프롬프트: 오류 / 재시도 지침"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","불일치 프롬프트 뒤에 추가되어 모델에 재시도를 지시하는 프롬프트입니다."],["Custom Parameter","사용자 정의 매개변수"],["Key","키"],["Value","값"],["Type","유형"],["Type of the value.","값의 유형입니다."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b> 유형의 경우 값은 JavaScript 코드로 평가됩니다."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript 코드의 범위는 <code>window</code>입니다. 따라서 거의 모든 값을 가져올 수 있습니다."],["<br />Example: <code>trans.project.title</code>","<br />예시: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","API로 전송되지 않을 매개변수를 삭제하세요.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API는 계속 변화하고 있어, 일부 새로운 모델은 이전 매개변수를 지원하지 않을 수 있으며 인식되지 않은 요청 매개변수에 대해 HTTP 오류를 반환할 수 있습니다."],["You can drop the parameters that are not supported by the model here.","모델에서 지원하지 않는 매개변수를 여기서 삭제할 수 있습니다."],["Manage configuration","구성 관리"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","이 엔진의 일부 기능은 ChatGPT 애드온이 설치되어 있어야 합니다. 이 엔진을 사용하기 전에 ChatGPT 애드온이 설치되어 있는지 확인하세요."],["Text Completion Setting","텍스트 완성 설정"],["General","일반"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>추론 모델에 돈을 낭비하지 마세요</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>다양한 연구에 의해 추론 모델은 창의적인 글쓰기와 번역 작업에서 일반 모델보다 훨씬 성능이 떨어지는 것으로 입증되었습니다.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>추론 모델을 사용하면 더 비싼 비용과 느린 응답 시간만 얻을 뿐입니다.</p>"],["Platform specific","플랫폼별"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","템플릿"],["Enable context","컨텍스트 활성화"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플입니다. 번역자가 목표와 대화의 맥락을 이해하도록 좋거나 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["Retry prompts","프롬프트 재시도"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>이 프롬프트들은 재시도 시 이전 모델 출력 직후 추가 <b>사용자</b> 메시지로 추가됩니다.</p>"],["<p>Available variables:</p>","<p>사용 가능한 변수:</p>"],["Enable Jailbreak","탈옥 활성화"],["Advanced","고급"],["Custom Parameters","사용자 정의 매개변수"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API 요청 본문에 사용자 정의 매개변수를 추가할 수 있습니다. 이는 폼에서 사용할 수 없는 추가 매개변수를 추가하려는 경우 유용합니다."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>경고</h2><ul><li>사용자 정의 매개변수를 잘못 설정하면 API 요청이 실패할 수 있습니다. 매개변수를 추가하기 전에 무엇을 하고 있는지 확인하세요. OpenAI와 같은 일부 서비스는 전송하는 매개변수에 대해 엄격하며, 인식되지 않는 요청 매개변수에 대해 HTTP 오류를 반환합니다.</li><li>동일한 키가 여러 번 사용되면 마지막 값만 사용됩니다.</li><li>기존 구성에 동일한 키가 사용되면 기존 구성 매개변수가 사용자 정의 매개변수로 덮어쓰여집니다.</li></ul>"],["Drop Parameters","매개변수 삭제"],["LiteLLM Proxy Configuration","LiteLLM 프록시 구성"],["Start LiteLLM server","LiteLLM 서버 시작"],["Processing...","처리 중..."],["Server started on port ","포트에서 서버 시작됨 "],["Check LiteLLM Status","LiteLLM 상태 확인"],["Change LiteLLM Version","LiteLLM 버전 변경"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","설치하려는 LiteLLM의 새 버전을 입력하세요.\n작동하는 것으로 알려진 버전: 1.38.0, 1.49.4 \n권장 버전은: "],["Are you sure you want to install LiteLLM version ","LiteLLM 버전 "],["Failed to install LiteLLM. Please check the console for more details.","LiteLLM 설치에 실패했습니다. 자세한 내용은 콘솔을 확인하세요."],["LiteLLM has been successfully updated to version ","LiteLLM이 버전 "],["Batch Translation Setting","일괄 번역 설정"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","죄송합니다, 이 애드온은 활성 후원자에게만 제공됩니다.\n$1 후원자가 되어 이 기능을 잠금 해제할 수 있습니다."],["Retries and Refinement","재시도 및 개선"],["<h2>Retries and Refinement</h2>","<h2>재시도 및 개선</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>번역 출력이 검증에 실패할 때, Translator++는 모델에게 번역을 재시도하도록 요청할 수 있습니다. 모델이 재시도해야 하는 횟수와 재시도 조건을 설정할 수 있습니다.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>적절한 재시도 조건과 합리적인 재시도 횟수를 설정하면 비용과 시간을 통제하면서 번역 품질을 크게 향상시킬 수 있습니다.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>각 재시도는 추가 시간과 비용이 듭니다</b>. 배치가 자주 재시도하게 된다면, 모델에 대한 지시를 더 명확하게 하기 위해 프롬프트를 조정하는 것이 좋습니다.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>개발자 도구나 배치 관리자를 사용하여 배치 번역을 디버그하세요.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>코드 이스케이핑 알고리즘</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>코드 이스케이핑은 MTL이 대화 내부의 코드 조각을 변경하지 못하도록 방지하는 기술입니다. 이는 대화에 HTML 태그, XML 태그, JSON 객체 또는 JavaScript 템플릿과 같은 코드 조각이 포함된 경우 유용합니다.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>대화 내부의 코드 조각과 일치하는 이스케이핑 알고리즘을 선택하세요. <b>시스템 메시지</b>, <b>샘플 프롬프트</b> 및 <b>본문 메시지</b> 템플릿을 그에 따라 조정해야 할 수 있습니다.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>코드 이스케이핑 알고리즘과 효과적인 사용 방법에 대해 더 읽으려면 <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>여기</a>를 클릭하세요.</p>"],["JavaScript template cloaking","JavaScript 템플릿 숨기기"],["None (no escaping)","없음 (이스케이핑 없음)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","선택한 이스케이핑 알고리즘에 대한 샘플 대화 프리셋을 로드하시겠습니까? 이는 기존 샘플 대화를 덮어씁니다."],["Always separate file","항상 별도 파일"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","각 배치에 대해 항상 파일을 분리하세요. 이렇게 하면 각 파일의 컨텍스트가 다른 파일로 오염되지 않을 수 있습니다."],["Add actor name","액터 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 액터 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 그런 다음 번역 결과에서 액터 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","액터 참조를 용어집으로 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","체크하면, Translator++는 액터 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 컨텍스트를 이해하는 데 도움이 됩니다. 액터 참조는 대화에서의 액터 이름입니다. 이는 번역자에게 용어집으로 로드됩니다. 이는 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 액터 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하려면 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함하여 캐릭터 정보 데이터를 배치해야 합니다."],["Actor Reference Translation Column","액터 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","액터 이름 번역의 열입니다. 이 열은 액터 참조의 번역으로 사용되어 대화에서 액터 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","액터 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","액터의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 입력할 수 있으며, 이는 대화에서 대명사 번역을 개선합니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 시스템 메시지 이후와 실제 프롬프트 메시지 이전에 추가됩니다."],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치마다 별도 파일로 저장"],["Append actor name to the translatable text","번역 가능한 텍스트에 액터 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 자동으로 용어집을 추가하는 데 도움을 줍니다. 용어집은 각 배치 항목에 대해 로드되어 번역 품질을 향상시킵니다. 이 기능은 프롬프트를 부풀리지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","액터 추가 정보 열"],["Prompt","프롬프트"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":true,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","OpenAI 배치 API로 번역"],["Model","모델"],["The pre-trained model.","사전 훈련된 모델입니다."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 배치 API는 일반적으로 사용되는 API와 약간 다른 모델 명명 규칙을 사용하는 것으로 보입니다. 배치 API에서 사용되는 모델에는 “-batch” 접두사가 붙습니다. 예를 들어, <code>gpt-4.1-mini</code>를 사용하면 모델이 자동으로 <code>gpt-4.1-mini-batch</code>가 됩니다.<br />\n그러나 이 애드온이 생성된 시점 기준으로, 배치 모델은 OpenAI의 모델 사용 제한 목록에 나열되지 않아, 사용자가 모델 사용 필터를 “허용”(화이트리스트)으로 설정한 경우 배치 API를 사용할 수 없습니다.<br />\n이는 OpenAI UI의 버그일 수 있으며, 향후 수정될 수 있습니다.<br />\n따라서 배치 API를 사용하려면 OpenAI에서 사용 제한을 “차단”(블랙리스트) 모드로 설정해야 합니다.<br />\n모델 사용 제한을 변경하려면 여기를 클릭하세요: https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","원본 열"],["The column of the original texts you want to translate.","번역하려는 원본 텍스트의 열입니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 번역 가능한 텍스트에 배우 이름을 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 이후 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Ignore if already translated","이미 번역된 경우 무시"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","이 옵션을 선택하면 Translator++는 해당 열에 이미 번역이 있는 행을 무시합니다."],["Load Actor Reference as Glossary","배우 참조를 용어집으로 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택 시, Translator++는 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서의 배우 이름입니다. 이는 번역자에게 용어집으로 로드되어 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용되어 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있어 대화에서 대명사 번역을 개선합니다."],["System Message Template","시스템 메시지 템플릿"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","시스템 메시지는 ChatGPT 어시스턴트의 역할을 알리는 메시지의 헤더입니다. 이 메시지는 ChatGPT에 보내는 모든 배치의 첫 번째 메시지로 전송됩니다."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript의 템플릿 리터럴 스타일 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span>을 사용하여 다음 변수를 포함할 수 있습니다.<br>"],["Variables:<br>","변수:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 원본 언어</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 대상 언어</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 전체 원본 언어 이름</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 전체 대상 언어 이름</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 원본 텍스트</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 이스케이프 알고리즘의 사전 정의된 메시지.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 줄바꿈을 나타내는 문자열 (줄 대체).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 배치 내 메시지 수.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 배우 정보 추가.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 일부 이전 줄을 문맥으로 포함</li>"],["Body Message Template","본문 메시지 템플릿"],["Template of the body of your chat.","채팅 본문의 템플릿."],["Sample conversation","샘플 대화"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI 배치 API를 사용하면 프로젝트를 비동기적으로 50% 낮은 비용으로 번역할 수 있어, 번역 결과를 <b style=\"color:red\">24시간 이내</b>에 <b style=\"color:blue\">일반 비용의 절반</b>으로 받을 수 있습니다. 이는 즉각적인 번역 결과가 필요하지 않은 대규모 프로젝트에 특히 유용합니다."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />OpenAI 배치 API에 대해 더 읽어보려면 <a href=\"https://platform.openai.com/docs/guides/batch\" external>여기</a>를 클릭하세요."],["General Settings","일반 설정"],["This form is using your OpenAI Batch API configuration.<br>","이 양식은 귀하의 OpenAI 배치 API 구성을 사용하고 있습니다.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","옵션 창에서 <b>OpenAI 배치 API</b> 애드온 설정으로 이동하여 구성을 변경할 수 있습니다.<br>"],["There you can set the API key, model, and other settings.<br />","거기에서 API 키, 모델 및 기타 설정을 지정할 수 있습니다.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT 설정 열기\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>추론 모델에 돈을 낭비하지 마세요</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>다양한 연구에 의해 추론 모델이 창의적인 글쓰기와 번역 작업 수행에서 일반 모델보다 훨씬 더 나쁘다는 것이 입증되었습니다.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>추론 모델을 사용할 때 더 비싼 비용과 느린 응답 시간 외에는 아무것도 얻지 못합니다.</p>"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Ignore translated rows","번역된 행 무시"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 용어집을 자동으로 추가하는 데 도움을 줍니다. 번역 품질을 향상시키기 위해 각 항목 배치에 용어집이 로드됩니다. 이 기능은 프롬프트가 부풀어오르는 것을 피하기 위해 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Prompt Template","프롬프트 템플릿"],["<h2>1. System Message</h2>","<h2>1. 시스템 메시지</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>여기서는 어시스턴트에게 그들의 역할이 무엇인지 설명할 수 있습니다.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플입니다. 번역자가 목표와 대화의 맥락을 이해하도록 돕기 위해 좋거나 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 실제 프롬프트</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>이것은 어시스턴트에게 보내는 실제 프롬프트입니다.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>간접 비용</h3>\n                        간접 비용은 실제 번역 텍스트 없이 어시스턴트에게 보내는 프롬프트 메시지의 비용입니다. 비용은 프롬프트 메시지의 토큰 수를 기준으로 계산됩니다. 토큰이 많을수록 비용이 높아집니다.<br>\n                        <b>예상 간접 비용:</b> <span class=\"overheadCost\">0</span> 토큰 / 요청."],["Are you sure you want to reset the form?","양식을 초기화하시겠습니까?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","배치를 처리하시겠습니까?\n이 작업에는 비용이 발생합니다."],["The batch is successfully created. Do you want to open the batch manager?","배치가 성공적으로 생성되었습니다. 배치 관리자를 열겠습니까?"],["OpenAI Batch API Queue","OpenAI 배치 API 대기열"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","번역을 적용할 행을 선택하세요"],["Target Column","대상 열"],["The column to put the translation result.","번역 결과를 넣을 열입니다."],["Import translation from ChatGPT Batch","ChatGPT 배치에서 번역 가져오기"],["Translation applied to selected rows","선택된 행에 번역 적용됨"],["Invalid format","잘못된 형식"],["OK","확인"],["Mismatch","불일치"],["Failed to load batch list with error: \n","일괄 목록을 로드하는 데 실패했습니다. 오류: \n"],["Download Error File","오류 파일 다운로드"],["Batch is not completed yet","일괄 처리가 아직 완료되지 않았습니다"],["Are you sure you want to cancel this batch?","이 일괄 처리를 취소하시겠습니까?"],["Cannot cancel completed batch.","완료된 일괄 처리는 취소할 수 없습니다."],["Batch cancelled","일괄 처리 취소됨"],["Failed to cancel batch","일괄 처리 취소 실패"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","일괄 처리"],["Apply translation","번역 적용"],["Cancel batch","일괄 처리 취소"],["Status","상태"],["Batch ID","일괄 처리 ID"],["Input File ID","입력 파일 ID"],["End point","엔드포인트"],["Created at","생성 시간"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","만료 시간 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"시간 내에 완료되지 않은 일괄 처리는 만료 상태로 이동하며, 해당 일괄 처리 내 미완료 요청은 취소되고, 완료된 요청에 대한 응답은 일괄 처리의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 청구됩니다.\"></i>"],["Completed at","완료 시간"],["Errors","오류"],["Batch Item Detail of","일괄 처리 항목 상세 정보"],["ID","ID"],["Completed on","완료 날짜"],["Model","모델"],["Prompt Token","프롬프트 토큰"],["Completion Token","완료 토큰"],["Total Token","총 토큰"],["Status Code","상태 코드"],["error","오류"],["Conversation","대화"],["Response Validation","응답 검증"],["Raw Payload","원본 페이로드"],["View raw payload","원본 페이로드 보기"],["Response Preview","응답 미리보기"],["Apply translations from selected rows","선택한 행에서 번역 적용"],["Here you can edit the translation result individually and send it into Translator++","여기서 번역 결과를 개별적으로 편집하고 Translator++로 보낼 수 있습니다"],["Open ChatGPT Settings","ChatGPT 설정 열기"],["Help","도움말"],["File list","파일 목록"],["Collapse / restore left panel","왼쪽 패널 접기 / 복원"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","시간 내에 완료되지 않은 배치는 결국 만료 상태로 이동하며, 해당 배치 내 미완료 요청은 취소되고 완료된 요청에 대한 응답은 배치의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 청구됩니다."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보 용어집.(일괄 처리 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 맥락(맥락이 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>샘플 기존 대화. 번역자가 목표와 대화 맥락을 이해하도록 좋거나 나쁜 응답의 예시를 작성할 수 있습니다.</p>"],["Always separate file","항상 파일 분리"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","항상 각 일괄 처리마다 파일을 분리하세요. 이렇게 하면 각 파일의 맥락이 다른 파일과 혼합되지 않도록 유지할 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 번역 가능한 텍스트에 배우 이름을 추가하세요. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 그런 다음 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","용어집으로 배우 참조 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택하면, Translator++는 용어집으로 배우 참조를 로드합니다. 이는 번역자가 대화 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서 배우의 이름입니다. 이는 번역자에게 용어집으로 로드됩니다. 이는 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 일괄 처리 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 캐릭터 정보 데이터를 배치하기 위해 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용됩니다. 이는 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있습니다. 이는 대화에서 대명사 번역을 향상시킵니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 이는 시스템 메시지 이후와 실제 프롬프트 메시지 이전에 추가됩니다."],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치마다 별도의 파일"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 용어집을 자동으로 추가하는 데 도움을 줍니다. 번역 품질을 향상시키기 위해 각 배치 항목에 대해 용어집이 로드됩니다. 이 기능은 프롬프트를 부풀리지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Prompt","프롬프트"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","배치 관리자"],["This feature is only available if you have a project open.","이 기능은 프로젝트가 열려 있을 때만 사용 가능합니다."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":true,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","서버 시작"],["Server started","서버 시작됨"],["Reinstall server","서버 재설치"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","설치하려는 Translators 라이브러리의 새 버전을 입력하세요.\n최신 버전은: "],["Are you sure you want to install Translators version ","Translators 버전 "],["Failed to install Translators. Please check the console for more details.","을(를) 설치하시겠습니까?"],["Translators has been successfully updated to version ","Translators 설치에 실패했습니다. 자세한 내용은 콘솔을 확인하세요."],["General Settings","Translators가 버전 "]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":true,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","으로 성공적으로 업데이트되었습니다."],["Process paused!\nPress OK to continue!","일반 설정"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":true,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","정말로 중단하시겠습니까?"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":true,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","프로세스가 일시 중지되었습니다!\n계속하려면 확인을 누르세요!"],["Please enter the port number:","사전을 RAM에서 절대 언로드하지 않음"],["Invalid port : ","번역 프록시를 시작할 수 없습니다!\n번역 프록시는 현재 $3 이상의 후원자만 이용 가능합니다."],["Port must be a numeric.","포트 번호를 입력하세요:"],["Port has successfully changed to: ","잘못된 포트: "],["Connection Info","포트는 숫자여야 합니다."],["Do you want to copy the base URL into the clipboard?","포트가 성공적으로 변경되었습니다: "],["Use secure protocol(HTTPS)","연결 정보"],["Port","기본 URL을 클립보드에 복사하시겠습니까?"],["Connection info","보안 프로토콜(HTTPS) 사용"],["Help","도움말"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":true,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","스크립트 작성 시 선택된 텍스트 인코딩으로 강제 변환합니다. (공백 = 자동)<br />. 이 필드를 사용하여 스크립트를 <b>UTF-16</b>으로 변환하면 로케일을 일본어로 변경하지 않고도 게임을 실행할 수 있습니다."],["Use legacy parser","레거시 파서 사용"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","새 파서 대신 레거시(구형 파서)를 사용합니다.<br />레거시 파서는 더 빠르지만 일부 게임에서 신뢰성이 낮습니다.<br />새 파서는 더 신뢰할 수 있지만 느립니다."],["Select TyranoBuilder packaged game","TyranoBuilder 패키지 게임 선택"],["Select the exe file of your packaged game.","패키지된 게임의 exe 파일을 선택하세요."],["Target folder","대상 폴더"],["Select destination folder. The process will replace the existing files.","대상 폴더를 선택하세요. 기존 파일이 대체됩니다."],["Extraction completed","추출 완료"],["Close","닫기"],["Next","다음"],["Please select game executable file","게임 실행 파일을 선택하세요"],["Back","뒤로"],["The game is fully loaded, proceed!","게임이 완전히 로드되었습니다, 진행하세요!"],["Extract data","데이터 추출"],["Open extracted folder","추출된 폴더 열기"],["Extract resources","리소스 추출"],["Select the game executable","게임 실행 파일 선택"],["Select the game executable or asar file to extract","추출할 게임 실행 파일 또는 asar 파일 선택"],["Target directory","대상 디렉토리"],["Select the target directory to store the unpacked files","압축 해제된 파일을 저장할 대상 디렉토리를 선택하세요"],["Electron archive file detected. Do you want to extract the asar file instead?","Electron 아카이브 파일이 감지되었습니다. asar 파일을 대신 추출하시겠습니까?"],["Tyranobuilder Game Extractor","TyranoBuilder 게임 추출기"],["Before you create a new project, please make sure that :","새 프로젝트를 생성하기 전에 다음을 확인하세요:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","<b>Kirikiri 어드벤처 게임 파서</b> 애드온이 Translator++에 설치되어 있는지"],["Your game is fully extracted.","게임이 완전히 추출되었습니다."],["Extract TyranoBuilder package","TyranoBuilder 패키지 추출"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","모든 .ks 및 .tjs 파일이 일반 텍스트입니다(컴파일되지 않았고, 스크램블되지 않았으며, 암호화되지 않음)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","일부 작업은 게임을 수정할 수 있습니다. <b>따라서 게임의 백업을 반드시 생성하세요!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","게임 실행 파일을 선택하세요. 이 파일은 게임 데이터를 추출하는 데 사용될 주요 게임 파일입니다."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","Tyrano 게임에서는 일반적으로 <b>index.html</b> 또는 <b>exe</b> 파일입니다."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","가능한 문자 인코딩 목록입니다. <b>순서가 중요합니다!</b>. 목록을 드래그하여 정렬할 수 있습니다."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","TyranoBuilder로 생성된 게임은 <b>UTF-8</b> 인코딩입니다"],["Literal tags are the tags that will be escaped into Translator++ editor.","리터럴 태그는 Translator++ 편집기에서 이스케이프될 태그입니다."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b>은 필수입니다."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> 태그는 Translator++에 의해 새로운 줄로 보간됩니다. 따라서 <b>[r]</b>을 명시적으로 작성할 필요가 없습니다."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kirikiri 스크립트(.ks)는 매우 사용자 정의 가능하며 개발자가 자신만의 태그를 생성할 수 있습니다."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++는 샵(#)으로 시작하는 캐릭터 이름과 같은 표준 태그를 처리할 수 있습니다."],["However, Translator++ may not be able to handle custom tags created by developers.","그러나 Translator++는 개발자가 생성한 사용자 정의 태그를 처리하지 못할 수 있습니다."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","따라서 번역해야 할 태그와 속성, 그리고 배우 이름으로 표시해야 할 태그를 정의해야 할 수 있습니다."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>태그에 대한 자세한 정보는 <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder 태그 참조</a>를 방문해 주세요.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","프로젝트를 시작하기 전에 <input type=\"button\" value=\"게임 추출\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" />하고 내부의 <b>ks</b> 스크립트를 분석해야 할 수 있습니다."],["Create Project","프로젝트 생성"],["Play last build","마지막 빌드 실행"],["Extract TyranoBuilder","TyranoBuilder 추출"],["Create playable package","실행 가능한 패키지 생성"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":true,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","일반"],["Executable file location","실행 파일 위치"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\t애플리케이션 실행 파일의 경로입니다.\n\t\t\t"],["Field can not be empty!","필드를 비워둘 수 없습니다!"],["Service","서비스"],["End Point","엔드포인트"],["Auto translation service to use.","사용할 자동 번역 서비스입니다."],["Target Language","대상 언어"],["The language to translate into","번역할 언어입니다."],["Source Language","원본 언어"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","게임의 원본 언어입니다. 일부 엔드포인트에서는 \"auto\"도 지원되지만 일반적으로 권장되지 않습니다."],["Files","파일"],["Directory","디렉토리"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","캐시된 번역 파일을 검색할 디렉토리입니다. 플레이스홀더 사용 가능: {GameExeName}, {Lang}"],["Output File","출력 파일"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","생성된 번역을 삽입할 파일입니다. 플레이스홀더 사용 가능: {GameExeName}, {Lang}"],["Substitution File","치환 파일"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","번역 전에 적용되는 치환을 포함하는 파일입니다. 플레이스홀더 사용 가능: {GameExeName}, {Lang}"],["Preprocessors File","전처리기 파일"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","텍스트를 번역기에 보내기 전에 적용할 전처리기를 포함하는 파일입니다. 플레이스홀더 사용 가능: {GameExeName}, {Lang}"],["Text Frameworks","텍스트 프레임워크"],["Enable/Disable auto translation for Unity's text frameworks.","Unity의 텍스트 프레임워크에 대한 자동 번역 활성화/비활성화"],["Behaviour","동작"],["Max Characters Per Translation","번역당 최대 문자 수"],["Max characters per text to translate. Max 2500.","번역할 텍스트당 최대 문자 수. 최대 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","대화 키에서 공백(줄바꿈 포함)을 무시할지 여부"],["Whether or not to ignore whitespace, including newlines, in NGUI","NGUI에서 공백(줄바꿈 포함)을 무시할지 여부"],["Minimum Dialogue Chars","최소 대화 문자 수"],["The length of the text for it to be considered a dialogue","텍스트를 대화로 간주하기 위한 길이"],["Force Split Text After Characters","문자 후 강제 분할 텍스트"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","번역된 텍스트가 이 문자 수를 초과하면 여러 줄로 분할합니다. (0은 분할 없음)"],["Whether or not to copy hooked texts to clipboard","후킹된 텍스트를 클립보드에 복사할지 여부"],["MaxClipboardCopyCharacters","최대 클립보드 복사 문자 수"],["Max number of characters to hook to clipboard at a time","한 번에 클립보드에 후킹할 최대 문자 수"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation",null],["Indicates whether batching of translations should be enabled for supported endpoints",null],["Indicates whether or not to use translations from the included static translation cache",null],["Override Font",null],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI",null],["Override Font TextMeshPro",null],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro",null],["Resize UI Line Spacing Scale",null],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI",null],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.",null],["Ignore Text Starting With",null],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.",null],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.",null],["GameLog Text Paths",null],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.",null],["Romaji Post Processing",null],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]",null],["Translation Post Processing",null],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]",null],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.",null],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","지정된 OutputFile에 공백 차이를 출력할지 여부를 나타냅니다."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","지정된 OutputFile에 정규식 분할 번역의 완전한 결과를 출력할지 여부를 나타냅니다."],["Indicates that the plugin should generate translations without variables when using substitutions.","치환 사용 시 변수 없이 번역을 생성해야 함을 나타냅니다."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","플러그인이 텍스트 번역을 \"스크롤 인\" 상태로 지원하기 위해 부분 번역을 생성해야 함을 나타냅니다."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","플러그인이 'TARC' 지시문을 파싱하고 이를 기반으로 번역 범위를 설정해야 함을 나타냅니다."],["Indicates the plugin should not print out success messages in relation to translations.","플러그인이 번역 관련 성공 메시지를 출력하지 않아야 함을 나타냅니다."],["Blacklisted IMGUI Plugins","블랙리스트된 IMGUI 플러그인"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","IMGUI 창 어셈블리/클래스/메서드 이름이 이 목록의 문자열(대소문자 구분 없음)을 포함하면 해당 UI는 번역되지 않습니다. MonoMod 훅이 필요합니다. 이 목록은 ';'로 구분됩니다."],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","플러그인이 번역 불가능하다고 간주하는 텍스트를 지정된 OutputFile에 출력할지 여부를 나타냅니다."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","텍스트 컴포넌트의 텍스트를 설정할 때 가상 메서드 호출 규칙을 무시해야 함을 나타냅니다. 경우에 따라 고집스러운 컴포넌트의 텍스트 설정에 도움이 될 수 있습니다."],["Max Text Parser Recursion","최대 텍스트 파서 재귀"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","텍스트가 다른 부분으로 번역될 수 있도록 파싱될 때 허용되는 재귀 수준을 나타냅니다. 고급 시나리오에서 분할기 정규식과 함께 사용할 수 있습니다. 기본값 1은 재귀가 비활성화됨을 의미합니다."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","번역 전에 HTML 엔티티를 전처리 및 디코딩합니다. 일부 번역기는 HTML 엔티티가 전송되면 실패할 수 있습니다."],["Will enable automated handling of rich text (text with markup).","리치 텍스트(마크업이 있는 텍스트)의 자동 처리를 활성화합니다."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","번역 관련 도움이 되는 로그 메시지를 활성화할지 여부를 나타냅니다. 리디렉션된 리소스를 기반으로 번역할 때 유용할 수 있습니다."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","플러그인이 Harmony 훅 대신 MonoMod 훅을 사용해야 함을 나타냅니다."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","플러그인이 Harmony 훅이 System.Reflection.Emit가 없는 환경에서 작동하도록 하는 Harmony 데투어 브리지를 초기화해야 함을 나타냅니다(일반적으로 이러한 설정은 플러그인 관리자가 처리하므로, 플러그인 관리자 사용 시 사용하지 마세요)."],["Redirected Resource Detection Strategy","리디렉션된 리소스 감지 전략"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","플러그인이 이중 번역을 방지하기 위해 리디렉션된 리소스를 인식하려고 시도할지 및 방법을 나타냅니다."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","플러그인이 <b>'번역당 최대 문자 수'</b>를 초과하는 텍스트를 번역 없이 출력할지 여부를 나타냅니다."],["Texture","텍스처"],["Texture Directory","텍스처 디렉토리"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","텍스처를 덤프하고 이미지를 로드할 디렉토리의 루트입니다. 플레이스홀더 사용 가능: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","플러그인이 게임 내 이미지를 TextureDirectory 디렉토리의 이미지로 교체하려 시도할지 여부를 나타냅니다."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","플러그인이 교체 가능한 텍스처를 TextureDirectory에 덤프할지 여부를 나타냅니다. 성능에 큰 영향을 미칩니다."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","ALT+T 단축키로 번역 전환 시 텍스처에도 영향을 미칠지 여부를 나타냅니다. 모든 텍스처에서 작동을 보장하지 않으며, 성능에 큰 영향을 미칩니다."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","플러그인이 장면 로드 시 텍스처를 스캔할지 여부를 나타냅니다. 이는 플러그인이 더 많은 텍스처를 찾고 (가능하면) 교체할 수 있게 합니다."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","플러그인이 SpriteRenderer를 후킹하려 시도할지 여부를 나타냅니다. SpriteRenderer는 제대로 후킹할 수 없으며, 구현된 해결 방법이 특정 상황에서 이론적으로 성능에 영향을 미칠 수 있어 별도 옵션입니다."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","수정되지 않은 텍스처를 로드할지 여부를 나타냅니다. 수정 여부는 파일 이름의 해시를 기반으로 결정됩니다. 디버깅 목적으로만 활성화하세요, 이상 현상을 일으킬 가능성이 있습니다."],["Texture Hash Generation Strategy","텍스처 해시 생성 전략"],["Indicates how the mod identifies pictures through hashes.","모드가 해시를 통해 그림을 식별하는 방법을 나타냅니다."],["Duplicate Texture Names","중복 텍스처 이름"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","게임 내에서 중복된 특정 텍스처 이름을 나타냅니다. 목록은 ';'로 구분됩니다."],["Indicates if the plugin should detect duplicate texture names.","플러그인이 중복 텍스처 이름을 감지할지 여부를 나타냅니다."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","플러그인이 이미지 로드에 다른 전략을 사용할지 여부를 나타냅니다. 게임 엔진이 오래된 경우 관련될 수 있습니다."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","최적 성능을 위해 로드된 모든 텍스처를 메모리에 유지할지 여부를 나타냅니다. 메모리 사용량을 줄이려면 비활성화하세요."],["Resource Redirector","리소스 리디렉터"],["Preferred Storage Path","선호 저장 경로"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Auto Translator와 관련하여 리디렉트된 리소스의 선호 저장 위치를 나타냅니다. 플레이스홀더 사용 가능: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","TextAsset을 리디렉트할지 여부를 나타냅니다."],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","플러그인이 로드된 모든 애셋을 콘솔에 기록할지 여부를 나타냅니다. 후킹 가능한 항목을 확인하는 데 유용합니다."],["Indicates if translatable resources that are found should be dumped","발견된 번역 가능한 리소스를 덤프할지 여부를 나타냅니다."],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","PreferredStoragePath에 있는 ZIP 파일 내의 파일들은 메모리에 인덱싱되어 로드 시 파일 확인 IO를 피합니다. 이 옵션을 활성화하면 물리적 파일에도 동일하게 적용됩니다."],["HTTP","HTTP"],["User Agent","사용자 에이전트"],["Override the user agent used by APIs requiring a user agent","사용자 에이전트가 필요한 API에서 사용되는 사용자 에이전트를 재정의합니다."],["Indiciates whether certificate validations for the .NET API should be disabled",".NET API에 대한 인증서 검증을 비활성화할지 여부를 나타냅니다."],["Translation Aggregator","번역 집계기"],["Width","너비"],["The total width of the translation aggregator window","번역 집계기 창의 전체 너비"],["Height","높이"],["The width (per translator) of the translation aggregator window.","번역 집계기 창의 (번역기당) 너비입니다."],["Enabled Translators","활성화된 번역기"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","번역 집계기 창에서 활성화된 번역 엔드포인트의 ID들입니다. 목록은 ';'로 구분됩니다."],["Google","구글"],["ServiceUrl","서비스 URL"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","선택사항, Google API 요청을 다른 URL로 보내는 데 사용할 수 있습니다. GFWoC를 우회하는 데 사용될 수 있습니다."],["Google Legitimate","구글 정식"],["Google API Key","구글 API 키"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","선택사항, GoogleTranslateLegitimate가 구성된 경우 필요합니다."],["Bing Legitimate","빙 정식"],["OcpApim Subscription Key","OcpApim 구독 키"],["OPTIONAL, needed if BingTranslateLegitimate is configured","선택사항, BingTranslateLegitimate이 구성된 경우 필요"],["Baidu","바이두"],["Baidu App Id","바이두 앱 ID"],["OPTIONAL, needed if BaiduTranslate is configured","선택사항, BaiduTranslate가 구성된 경우 필요"],["BaiduAppSecret","바이두 앱 비밀"],["Yandex","얀덱스"],["Yandex API Key","얀덱스 API 키"],["OPTIONAL, needed if YandexTranslate is configured","선택사항, YandexTranslate가 구성된 경우 필요"],["Watson","왓슨"],["Url","URL"],["OPTIONAL, needed if WatsonTranslate is configured","선택사항, WatsonTranslate가 구성된 경우 필요"],["Key","키"],["DeepL","딥엘"],["MinDelay","최소 지연"],["OPTIONAL, used for throttling DeepL","선택사항, 딥엘 제한에 사용됨"],["MaxDelay","최대 지연"],["DeepL Legitimate","딥엘 정식"],["OPTIONAL, required if DeepLLegitimate is configured","선택사항, DeepLLegitimate이 구성된 경우 필요"],["Custom","사용자 지정"],["Optional, needed if Custom Translated is configured","선택 사항, 사용자 지정 번역이 구성된 경우 필요함"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","설치 경로"],["Optional, needed if Lec Power Translator 15 is configured","선택 사항, Lec Power Translator 15가 구성된 경우 필요함"],["Debug","디버그"],["Enables the console. Do not enable if other plugins (managers) handles this","콘솔을 활성화합니다. 다른 플러그인(관리자)가 이를 처리하는 경우 활성화하지 마세요"],["Enables extra logging for debugging purposes","디버깅 목적으로 추가 로깅을 활성화합니다"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","ezTrans의 설치 경로"],["Migrations","마이그레이션"],["Used to enable automatic migrations of this configuration file","이 구성 파일의 자동 마이그레이션을 활성화하는 데 사용됨"],["Tag","태그"],["Tag representing the last version this plugin was executed under. Do not edit","이 플러그인이 마지막으로 실행된 버전을 나타내는 태그. 편집하지 마세요"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":true,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","이 작업을 수행하려면 XUnity Translator가 필요합니다\n타사 애플리케이션 설치 프로그램을 통해 설치하세요!"],["XUnity.AutoTranslator is found!","XUnity.AutoTranslator가 발견되었습니다!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++는 XUnity.AutoTranslator가 이미 설치된 것을 감지했습니다. Translator++는 기존 번역 데이터를 사용하여 새 번역 프로젝트를 시작합니다."],["XUnity.AutoTranslator is not found!","XUnity.AutoTranslator를 찾을 수 없습니다!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","마법사가 게임에 XUnity.AutoTranslator를 설치하도록 안내합니다."],["Next","다음"],["Given path: ","주어진 경로: "],["\nis not an Unity game. Do you still want to proceed?","\n은(는) Unity 게임이 아닙니다. 계속 진행하시겠습니까?"],["Patch successfully installed!\r\n","패치가 성공적으로 설치되었습니다!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","구성은 게임을 처음 실행할 때 생성됩니다.\r\n"],["Open the game now?","지금 게임을 열까요?"],["Finish","완료"],["Update current project?","현재 프로젝트를 업데이트하시겠습니까?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":true,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","메시지 상자의 최대 줄 수."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","기본값은 4입니다. 이 기능을 비활성화하려면 0을 입력하세요. 메시지 상자의 줄 수가 이 숫자보다 많으면 Translator++가 텍스트가 상자를 넘치지 않도록 새 메시지 상자를 생성합니다."],["Use shell copy if possible","가능하면 셸 복사 사용"],["Use shell copy instead of native NodeJS copy handler.","네이티브 NodeJS 복사 핸들러 대신 셸 복사를 사용합니다."],["Use shell copy","셸 복사 사용"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","WRPGE 편집기가 설치되지 않았습니다\r\nT++ 메뉴 > 타사 애플리케이션 설치 프로그램에서 설치해 주세요\r\n\r\n지금 타사 애플리케이션 설치 프로그램을 열까요?"],["Unable to determina WRPGE path.","WRPGE 경로를 확인할 수 없습니다."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++가 대상 폴더에 WRPGE 편집기를 설치하려고 합니다.\r\n계속하시겠습니까?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","개발 경로가 정의되지 않았습니다.\n개발 경로를 생성하려면 게임을 한 번 주입해야 합니다."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","WolfJs 라이브러리를 사용하여 Wolf RPG 게임을 ver. 3.330까지 번역합니다. Translator++의 기본 Wolf RPG 파서입니다."],["Wolf RPG Editor games","Wolf RPG 편집기 게임"],["Parsing Wolf RPG Game with","Wolf RPG 게임 파싱 중"],["Wolf RPG Editor game","Wolf RPG 편집기 게임"],["Select the game's executable file","게임 실행 파일 선택"],["Engine version","엔진 버전"],["Detected WolfRPG Engine version of the selected game","선택한 게임의 WolfRPG 엔진 버전 감지됨"],["Heads up!\r\n","주의!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nWolf RPG 실행 파일로 보이지 않습니다!\r\n이 진입점에서 Wolf RPG 프로젝트를 시작하시겠습니까?"],["Create a new project","새 프로젝트 생성"],["Please specify a game to be processed!","처리할 게임을 지정해 주세요!"],["Set dev path. Path to the directory of the translated game.","개발 경로 설정. 번역된 게임의 디렉토리 경로입니다."],["Play last build","마지막 빌드 실행"],["Open editor","에디터 열기"],["Open Wolf RPG Editor online manual","Wolf RPG Editor 온라인 매뉴얼 열기"],["Open Wolf RPG Editor english manual","Wolf RPG Editor 영어 매뉴얼 열기"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","매뉴얼 파일을 찾을 수 없습니다.\n3rd Party 앱 설치 프로그램을 통해 Wolf RPG Editor를 설치해 주세요."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":true,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","XML 유사 문서에서 번역 시작. XML 및 HTML 형식을 모두 지원합니다."],["Create project","프로젝트 생성"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":true,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","YU-RIS 엔진 번역기"],["Checking up requirements...","요구 사항 확인 중..."],["Create a new translation project from YU-RIS visual novel engine","YU-RIS 비주얼 노벨 엔진에서 새 번역 프로젝트 생성"],["Next","다음"],["Select YU-RIS game","YU-RIS 게임 선택"],["Select the game's executable file","게임 실행 파일 선택"],["Engine version","엔진 버전"],["Detected YU-RIS version of the selected game","선택한 게임의 YU-RIS 버전 감지됨"],["Create a new project","새 프로젝트 생성"],["Invalid target game :","잘못된 대상 게임:"],["Source material do not match the current translation project!","소스 자료가 현재 번역 프로젝트와 일치하지 않습니다!"],["Select the repack method.","리팩 방법 선택"],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>원본 YPF 파일로 리팩</b><br />번역을 원본 팩에 리팩합니다. 원본 팩을 추출하고 번역으로 패치한 후 다시 리팩하는 데 더 오랜 시간이 걸릴 수 있습니다.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>YPF 패치 파일로 리팩</b><br />번역을 별도의 패치 파일(예: update9.ypf)로 리팩합니다. 이렇게 하면 원본 ypf 파일을 수정하지 않고도 게임을 번역할 수 있습니다. 더 빠른 패칭 과정을 위해 복사 자료의 <b>자료 복사하지 않고 번역만 주입</b> 옵션과 함께 사용하세요.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","대상 리팩 버전은 게임 버전과 일치해야 합니다. 점으로 구분된 주 버전과 부 버전을 입력하세요. 예: <b>0.466</b>. 기본적으로 Translator++는 프로젝트 생성 시 엔진 버전을 감지합니다."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":true,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","폼 빌더"],["Run","실행"],["New Project (ctrl+n)","새 프로젝트 (ctrl+n)"],["Open (ctrl+o)","열기 (ctrl+o)"],["Save file (ctrl+s)","파일 저장 (ctrl+s)"],["Save As (ctrl+shift+s)","다른 이름으로 저장 (ctrl+shift+s)"],["Open debugger (F12)","디버거 열기 (F12)"],["Help","도움말"],["Select file in the current workspace","현재 작업 공간에서 파일 선택"],["file path","파일 경로"],["Create shortcut of the current script","현재 스크립트의 바로가기 만들기"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":true,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"parameters":[]},"/find.html":{"data":[["Find","찾기"],["Replace","바꾸기"],["Put","넣기"],["Target","대상"],["Grid","그리드"],["Context","컨텍스트"],["Tag","태그"],["Comment","주석"],["Untranslated rows","번역되지 않은 행"],["Refine","정제"],["Case sensitive","대소문자 구분"],["Transpile \\r\\n\\t","\\r\\n\\t 변환"],["RegExp","정규 표현식"],["All files","모든 파일"],["Select All Columns","모든 열 선택"],["Find all string above and replace with :","위의 모든 문자열을 찾아서 다음으로 바꾸기:"],["Original text:","원본 텍스트:"],["Text to put :","넣을 텍스트:"],["into: ","다음으로:"],["Search all files","모든 파일 검색"],["Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)","키워드를 입력한 후 엔터를 누르세요. 글로브 패턴(예: *.png)을 사용할 수 있습니다."],["Drag to select, Shift+Drag to unselect","드래그로 선택, Shift+드래그로 선택 해제"],["Select target column","대상 열 선택"],["A line in the original text to find. Press alt+enter to add a new line.","찾을 원본 텍스트의 한 줄입니다. alt+enter를 눌러 새 줄을 추가하세요."],["Translation","번역"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":true,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","데이터와 관련된 파일을 찾을 수 없습니다"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","이 문제를 해결하려면 <a href=\"#\" class=\"openProjectProperties\">프로젝트 속성</a>에서 <b>원자재 위치</b> 필드를 수정하세요"],["Copy path to clipboard","클립보드에 경로 복사"],["Path has been copied to clipboard.","경로가 클립보드에 복사되었습니다"],["Open folder","폴더 열기"],["Open with external application","외부 애플리케이션으로 열기"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","다른 프로그램으로 열기..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~기본 번역 사용~"],["Column","열"],["Do you want to delete all context translation on the currently selected row?","현재 선택된 행의 모든 컨텍스트 번역을 삭제하시겠습니까?"],["Do you want to delete all translation on the currently active row?","현재 활성화된 행의 모든 번역을 삭제하시겠습니까?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":true,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","유효하지 않은 타입 addonObj"],["invalid type addonObj.addons","유효하지 않은 타입 addonObj.addons"],["You are not eligible to get this addon","이 애드온을 받을 자격이 없습니다"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":true,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Translator++에 대한 바로가기를 생성하기 전에 현재 프로젝트를 먼저 저장해야 합니다"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","이 기능은 Translator++의 개발자 버전을 사용하는 경우에만 사용할 수 있습니다. 기본 유틸리티 -> 코어 NWJS 변경을 사용하여 개발자 버전으로 전환할 수 있습니다."]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/find.js":{"data":[["Action","작업"],["Append tags","태그 추가"],["Remove tags","태그 제거"],["Set tags","태그 설정"],["Do nothing","아무것도 하지 않음"],["Close","닫기"],["Proceed","진행"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","키워드가 너무 짧습니다!\n모든 행을 검색하려고 하시나요? 키워드로 별표 '*'를 사용해 보세요."],["Found nothing!<br />Don't forget to set the Target search field.","찾을 수 없습니다!<br />대상 검색 필드를 설정하는 것을 잊지 마세요."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","교체할 내용이 없습니다!<br />교체 기능은 키 열의 내용을 교체하지 않습니다."],["Replace '","'"],["' with '","'을(를) '으로 교체"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'?\r\n이 기능에 대한 실행 취소 기능을 아직 만들지 않았습니다!\n계속 진행하시겠습니까?"],["click to go","클릭하여 이동"],["This will replace any translation found in target colum,\nAre you sure?","이 작업은 대상 열에서 발견된 모든 번역을 대체합니다.\n계속하시겠습니까?"],["Keyword too short!","키워드가 너무 짧습니다!"],["Not found!","찾을 수 없습니다!"],["Are you sure want to execute the following script?","다음 스크립트를 실행하시겠습니까?"],["For ","에 대해 "],[" selected item(s)?"," 선택된 항목?"],[" Select all"," 모두 선택"],[" Invert selection"," 선택 반전"],[" Clear selection"," 선택 해제"],[" Set Red tag"," 빨간 태그 설정"],[" Set Yellow tag"," 노란 태그 설정"],[" Set Green tag"," 초록 태그 설정"],[" Set Blue tag"," 파란 태그 설정"],[" Set Gold tag"," 금색 태그 설정"],[" More tags..."," 더 많은 태그..."],[" Clear tags"," 태그 지우기"],[" Create Automation"," 자동화 생성"],[" Run Automation"," 자동화 실행"],[" Clear Automation","자동화 지우기"],["Are you sure want to clear all quick launch scripts?","모든 빠른 실행 스크립트를 지우시겠습니까?"],[" Clear translation","번역 지우기"],["Do you want to clear translations of the selected items?","선택한 항목의 번역을 지우시겠습니까?"],[" Delete rows","행 삭제"],["Do you want to remove selected rows?\nYou can not undo this action!","선택한 행을 제거하시겠습니까?\n이 작업은 취소할 수 없습니다!"],[" With selection ...","선택 항목으로 ..."],["Always on top","항상 위에"],["Default","기본값"],["Blur opacity","흐림 불투명도"],["Type regex with the modifier","수정자와 함께 정규 표현식 입력"],["Use $n to replace a group. e.g. $1","그룹을 대체하려면 $n을 사용하세요. 예: $1"],["Find","찾기"],["Replace","바꾸기"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":true,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","비밀번호 숨기기"],["Show password","비밀번호 표시"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":true,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","일부 구성은 적용을 위해 애플리케이션을 재시작해야 합니다.\n작업을 저장하고 Translator++를 재시작하세요."],["Pleae select the name for your configuration.","구성 이름을 선택하세요."],["Translator Engine configuration","번역 엔진 구성"],["Translator engine version.","번역 엔진 버전."],["By.","작성자"],["No option for this engine","이 엔진에 대한 옵션이 없습니다"],["License","라이선스"],["Can not disable this addon","이 애드온을 비활성화할 수 없습니다"],["Requirements","요구사항"],["What is this?","이것은 무엇인가요?"],["Uninstall","제거"],["Update","업데이트"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","애드온이 성공적으로 설치되었습니다.\r\n일부 애드온이 적용되려면 Translator++를 재시작해야 할 수 있습니다."],["WARNING!\n","경고!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","이 애드온은 \"파서 변경\"으로 표시되었습니다. 이 애드온과 관련된 기존 프로젝트가 예상대로 작동하지 않을 수 있습니다. 이 애드온을 설치하기 전에 프로젝트를 백업하는 것이 좋습니다.\n기존 번역을 새로 생성된 프로젝트로 가져올 수 있습니다.\n\n이 애드온을 설치하시겠습니까? "],["Do you want to install ","이 애드온을 설치하시겠습니까? "],["Add-on","애드온"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","가 성공적으로 설치되었습니다.\r\n일부 애드온이 적용되려면 Translator++를 재시작해야 할 수 있습니다."],["Add-on version.","애드온 버전"],["No option for this add-on","이 애드온에 대한 옵션이 없습니다"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++가 Windows 레지스트리에 기록합니다.\r\n확실합니까?"],["Error parsing patterns:","패턴 구문 분석 오류:"],["Do you really want to clear the custom escaper?","사용자 정의 이스케이퍼를 정말로 지우시겠습니까?"],["Do you really want to reset the custom escaper?","사용자 정의 이스케이퍼를 정말로 초기화하시겠습니까?"],["You are currently on the latest version.\nDo you still want to update?","현재 최신 버전을 사용 중입니다.\n그래도 업데이트하시겠습니까?"],["This option will open your default browser to login.\nDo you want to continue?","이 옵션은 기본 브라우저를 열어 로그인합니다.\n계속하시겠습니까?"],["Login with Browser","브라우저로 로그인"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","브라우저가 <b>dreamsavior.net/gettoken/</b>로 열렸습니다.<br>로그인하면 자동으로 완료됩니다.<br><br>자동 로그인이 작동하지 않으면 해당 페이지에서 토큰을 복사하여 아래에 붙여넣으세요:"],["There is no default translator selected.\nChange the default translator to Google!","기본 번역기가 선택되지 않았습니다.\n기본 번역기를 Google로 변경하세요!"],["Change Stagging Path to :","스태깅 경로를 다음으로 변경:"],["Move the content of current Stagging Path into the new one?","현재 스태깅 경로의 내용을 새 경로로 이동하시겠습니까?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","애드온이 설치되었습니다.\nTranslator++를 재시작해야 적용됩니다."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","정말로 모든 설정을 지우고 Translator++를 기본값으로 초기화하시겠습니까?\n이 작업은 되돌릴 수 없습니다.\n진행하기 전에 프로젝트를 백업해 주세요."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","오류를 수정하지 않으면 Translator++가 정상적으로 작동하지 않을 수 있습니다.\n옵션 창을 닫으시겠습니까?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":true,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Translator++에 대한 바로가기를 만들기 전에 현재 프로젝트를 먼저 저장해야 합니다"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","이 기능은 Translator++의 개발자 버전을 사용할 때만 사용 가능합니다. 기본 유틸리티 -> 코어 NWJS 변경을 통해 개발자 버전으로 전환할 수 있습니다."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>PHP 인터프리터를 실행할 수 없습니다!</b><br />\n\t\t\t\tTranslator++는 일부 필수 절차를 실행하기 위해 PHP CLI가 필요합니다.<br />\n\t\t\t\t이 오류는 일반적으로 컴퓨터에 <b><a href=\"http://dreamsavior.net/download/#TPPSysreq\">올바른 버전의 Microsoft Visual C++ 재배포 가능 패키지</a>가 설치되지 않았기</b> 때문에 발생합니다.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li><a href=\"http://dreamsavior.net/download/#TPPSysreq\">필요한 런타임</a>을 설치해 주세요.</li>\n\t\t\t\t\t\t<li>모든 런타임을 설치했는데도 이 오류가 계속 발생하면 Translator++ 설치 디렉토리를 다른 폴더로 이동해 주세요.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t이 증상에 대한 자세한 정보는 <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>문서</a>를 확인해 주세요."],["Initialization Error!","초기화 오류!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":true,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"parameters":[]},"/js/trans.js":{"data":[["Original Text","원본 텍스트"],["Initial","초기"],["Machine translation","기계 번역"],["Better translation","더 나은 번역"],["Best translation","최고의 번역"],["Loading","로딩 중"],["Error!","오류!"],["Error processing init file : ","초기화 파일 처리 오류 : "],["Error! File list not found in init file at : ","오류! 초기화 파일에서 파일 목록을 찾을 수 없음 : "],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","이는 게임이 성공적으로 파싱되지 않았음을 의미합니다. 이 문제에 대한 가능한 해결책을 보려면 https://dreamsavior.net/?p=1311을 방문해 주세요."],["Done!","완료!"],["All done!","모두 완료!"],["Error opening file : ","파일 열기 오류 : "],["error opening file (open): ","파일 열기 오류 (open): "],["Project properties - Staging path error!","프로젝트 속성 - 스테이징 경로 오류!"],["Project properties","프로젝트 속성"],["untitled project","제목 없는 프로젝트"],["create file list","파일 목록 생성"],["Finished","완료됨"],["All process finished!","모든 프로세스 완료!"],["Open Explorer","탐색기 열기"],["Opening file!","파일 열기 중!"],["Assigning new staging path : ","새 스테이징 경로 할당 : "],["Success!","성공!"],["Failed!","실패!"],["Collecting paths","경로 수집 중"],["Path : '","경로 : '"],["' doesn't exist","' 존재하지 않음"],[" file(s) collected!"," 파일(들) 수집됨!"],["Start importing data!","데이터 가져오기 시작!"],["Importing : ","가져오는 중 : "],["All Done!","모두 완료!"],[" is not a valid object name","는 유효한 객체 이름이 아님"],[" is not a valid directory name","는 유효한 디렉토리 이름이 아님"],[" is already exist","는 이미 존재함"],["Error opening file :","파일 열기 오류 :"],["Error executing :","실행 오류 :"],["Are you sure want to execute the following script?","다음 스크립트를 실행하시겠습니까?"],["Clear quick launch","빠른 실행 지우기"],["Are you sure want to clear quick launch?","빠른 실행을 지우시겠습니까?"],["How to add Automation here","여기에 자동화 추가하는 방법"],["Select all","모두 선택"],["Clear selection","선택 지우기"],["Select 100%","100% 선택"],["Select <100%","<100% 선택"],["Select progress ≥ ...","진행률 ≥ ... 선택"],["Select completed","완료 선택"],["Invert selection","선택 반전"],["Toggle mark as complete","완료 표시 토글"],["With all","모두와 함께"],["With ","와 함께 "],[" selected"," 선택됨"],["Mark as complete","완료로 표시"],["Un-mark as complete","완료 표시 해제"],["Batch translation","일괄 번역"],["Send to...","보내기..."],["Wrap texts","텍스트 줄바꿈"],["Trim","정리"],["Auto padding","자동 패딩"],["Context Tool","컨텍스트 도구"],["Create Automation","자동화 생성"],["For each object","각 객체에 대해"],["For each row","각 행에 대해"],["Run Automation","자동화 실행"],["Import from...","가져오기..."],["Trans File","번역 파일"],["Spreadsheets","스프레드시트"],["RPGMTransPatch Files","RPGMTrans 패치 파일"],["Export into...","내보내기..."],["A folder","폴더"],["Zipped Game Patch","압축된 게임 패치"],["Comma Separated Value (csv)","쉼표로 구분된 값 (csv)"],["Excel 2007 Spreadsheets (xlsx)","Excel 2007 스프레드시트 (xlsx)"],["Excel Spreadsheets (xls)","Excel 스프레드시트 (xls)"],["ODS Spreadsheets","ODS 스프레드시트"],["Html Spreadsheets","Html 스프레드시트"],["RMTrans Patch","RMTrans 패치"],["Inject Translation","번역 주입"],["Revert to original","원본으로 되돌리기"],["Clear translation","번역 지우기"],["Delete files","파일 삭제"],["Properties","속성"],["Select progress greater than","진행률이 다음보다 큰 항목 선택"],["Please input a number","숫자를 입력하세요"],["Do you want to clear translation?","번역을 지우시겠습니까?"],["Add comment","댓글 추가"],["Remove comment","코멘트 제거"],["added to reference table!","참조 테이블에 추가됨!"],["Can not modify Column 0","열 0은 수정할 수 없습니다"],["Unable to delete table : ","테이블 삭제 불가: "],["Can not remove key column!","키 열은 제거할 수 없습니다!"],["Please open or create a project first","먼저 프로젝트를 열거나 생성해 주세요"],["Column name can not be empty!","열 이름은 비워둘 수 없습니다!"],["Invalid column index!","유효하지 않은 열 인덱스!"],["Please open or create a new project first!","먼저 새 프로젝트를 열거나 생성해 주세요!"],["You should not edit key value","키 값은 편집하지 않는 것이 좋습니다"],["Ilegal value","잘못된 값"],["That value already exist!","해당 값은 이미 존재합니다!"],["The maximum number of columns for this project has been reached, so you cannot add any more.","이 프로젝트의 최대 열 수에 도달하여 더 이상 추가할 수 없습니다."],["Are you sure want to abort this process?","이 프로세스를 중단하시겠습니까?"],["Process paused!\nPress OK to continue!","프로세스 일시 중지됨!\n계속하려면 확인을 누르세요!"],["Unable to process, project not found","처리 불가, 프로젝트를 찾을 수 없음"],["Unable to process, data not found","처리 불가, 데이터를 찾을 수 없음"],["Translation engine not found","번역 엔진을 찾을 수 없음"],["Translation engine ","번역 엔진 "],[" is disabled!"," 비활성화됨!"],["Selected files :","선택된 파일 :"],["Collecting data from :","데이터 수집 중 :"],["Translation finished","번역 완료"],["applying translation to table!","테이블에 번역 적용 중!"],["Error when translating data!","데이터 번역 중 오류 발생!"],["\tHTTP Status : ","\tHTTP 상태 : "],["\tError Type : ","\t오류 유형 : "],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","번역 서비스에서 일시적으로 차단되었을 수 있습니다!\r\n온라인 번역 서비스를 적절히 사용해 주세요.\r\n이 문제는 보통 하루나 이틀 안에 자동으로 해결됩니다.\r\n"],["Running trans.translateAll","trans.translateAll 실행 중"],["Start collecting data!","데이터 수집 시작!"],["Data collection is done!","데이터 수집 완료!"],["nothing is selected","선택된 항목 없음"],["no translator loaded","번역기가 로드되지 않음"],["unable to load translator window","번역기 창을 로드할 수 없음"],["Reference path cannot empty!","참조 경로는 비워둘 수 없습니다!"],["Collecting translation refference","번역 참조 수집 중"],["Applying translation!","번역 적용 중!"],["Importing translation","번역 가져오기"],["Parsing data","데이터 파싱 중"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions","는 유효한 JavaScript 정규 표현식이 아닙니다!\r\nJavaScript 정규 표현식에 대해 더 알아보기 :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"],["Keyword too short!","키워드가 너무 짧습니다!"],["Delete comment","댓글 삭제"],["Translate here","여기 번역"],["Translate here using ","여기 번역하기 "],["Translate using...","번역 사용..."],["Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?","선택한 셀의 번역으로 이 프로젝트에서 발견된 모든 동일한 텍스트를 번역하시겠습니까?"],[" cell(s) has been written!"," 셀이 작성되었습니다!"],["Column width","열 너비"],["Width must greater than 0","너비는 0보다 커야 합니다"],["Insert column right","오른쪽에 열 삽입"],["Duplicate column","열 복제"],["Remove this column","이 열 제거"],["Remove selected column?\nThis can not be undone!","선택한 열을 제거하시겠습니까?\n이 작업은 취소할 수 없습니다!"],["Rename this column","이 열 이름 변경"],["Please enter new name","새 이름을 입력하세요"],["Tags","태그"],["Red","빨강"],["Yellow","노랑"],["Green","초록"],["Blue","파랑"],["Gold","골드"],["More tags...","더 많은 태그..."],["Clear tags","태그 지우기"],["Delete Row","행 삭제"],["Do you want to remove the currently selected row(s)?","현재 선택된 행을 제거하시겠습니까?"],["Clear Context Translation","컨텍스트 번역 지우기"],["Clear Automation","자동화 지우기"],["Are you sure want to clear all quick launch scripts?","모든 빠른 실행 스크립트를 지우시겠습니까?"],["Append rows to reference","참조에 행 추가"],["Row properties","행 속성"]],"context":[["tid/2227/type/StringLiteral","tid/2619/type/StringLiteral"],["tid/2233/type/StringLiteral","tid/2625/type/StringLiteral"],["tid/2239/type/StringLiteral","tid/2631/type/StringLiteral"],["tid/2245/type/StringLiteral","tid/2637/type/StringLiteral"],["tid/2251/type/StringLiteral","tid/2643/type/StringLiteral"],["tid/4770/type/StringLiteral","tid/4811/type/StringLiteral","tid/18019/type/StringLiteral","tid/18070/ty