ing : ":30,"All Done!":31," is not a valid object name":32," is not a valid directory name":33," is already exist":34,"Error opening file :":35,"Error executing :":36,"Are you sure want to execute the following script?":37,"Clear quick launch":38,"Are you sure want to clear quick launch?":39,"How to add Automation here":40,"Select all":41,"Clear selection":42,"Select 100%":43,"Select <100%":44,"Select progress ≥ ...":45,"Select completed":46,"Invert selection":47,"Toggle mark as complete":48,"With all":49,"With ":50," selected":51,"Mark as complete":52,"Un-mark as complete":53,"Batch translation":54,"Send to...":55,"Wrap texts":56,"Trim":57,"Auto padding":58,"Context Tool":59,"Create Automation":60,"For each object":61,"For each row":62,"Run Automation":63,"Import from...":64,"Trans File":65,"Spreadsheets":66,"RPGMTransPatch Files":67,"Export into...":68,"A folder":69,"Zipped Game Patch":70,"Comma Separated Value (csv)":71,"Excel 2007 Spreadsheets (xlsx)":72,"Excel Spreadsheets (xls)":73,"ODS Spreadsheets":74,"Html Spreadsheets":75,"RMTrans Patch":76,"Inject Translation":77,"Revert to original":78,"Clear translation":79,"Delete files":80,"Properties":81,"Select progress greater than":82,"Please input a number":83,"Do you want to clear translation?":84,"Add comment":85,"Remove comment":86,"added to reference table!":87,"Can not modify Column 0":88,"Unable to delete table : ":89,"Can not remove key column!":90,"Please open or create a project first":91,"Column name can not be empty!":92,"Invalid column index!":93,"Please open or create a new project first!":94,"You should not edit key value":95,"Ilegal value":96,"That value already exist!":97,"The maximum number of columns for this project has been reached, so you cannot add any more.":98,"Are you sure want to abort this process?":99,"Process paused!\nPress OK to continue!":100,"Unable to process, project not found":101,"Unable to process, data not found":102,"Translation engine not found":103,"Translation engine ":104," is disabled!":105,"Selected files :":106,"Collecting data from :":107,"Translation finished":108,"applying translation to table!":109,"Error when translating data!":110,"\tHTTP Status : ":111,"\tError Type : ":112,"You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n":113,"Running trans.translateAll":114,"Start collecting data!":115,"Data collection is done!":116,"nothing is selected":117,"no translator loaded":118,"unable to load translator window":119,"Reference path cannot empty!":120,"Collecting translation refference":121,"Applying translation!":122,"Importing translation":123,"Parsing data":124," is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions":125,"Keyword too short!":126,"Delete comment":127,"Translate here":128,"Translate here using ":129,"Translate using...":130,"Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?":131," cell(s) has been written!":132,"Column width":133,"Width must greater than 0":134,"Insert column right":135,"Duplicate column":136,"Remove this column":137,"Remove selected column?\nThis can not be undone!":138,"Rename this column":139,"Please enter new name":140,"Tags":141,"Red":142,"Yellow":143,"Green":144,"Blue":145,"Gold":146,"More tags...":147,"Clear tags":148,"Delete Row":149,"Do you want to remove the currently selected row(s)?":150,"Clear Context Translation":151,"Clear Automation":152,"Are you sure want to clear all quick launch scripts?":153,"Append rows to reference":154,"Row properties":155},"tags":[],"parameters":[]},"/js/ui.js":{"data":[["`You cannot close the application at this moment, reason: \\n${","`현재 애플리케이션을 닫을 수 없습니다, 이유: \\n${"],["}`","}`"],["Do you really want to exit Translator++?\nAll unsaved changes will be discarded!","정말 Translator++를 종료하시겠습니까?\n저장되지 않은 모든 변경 사항이 삭제됩니다!"],["Trans file","번역 파일"],["Translator++ Project Package (TPP) file","Translator++ 프로젝트 패키지 (TPP) 파일"],["Select all","모두 선택"],["Select none","선택 없음"],["Invert","반전"],["Match destination selection","대상 선택과 일치"],["use mouse drag to do bulk selection","마우스 드래그로 대량 선택"],["Invalid trans data","유효하지 않은 변환 데이터"],["Inject / Apply translation","번역 주입 / 적용"],["Inject / Apply translation to all","모든 번역 주입 / 적용"],["Cancel","취소"],["Apply Translation","번역 적용"],["Target path cannot be a parent or child of the source material's path.\nPlease select another path.","대상 경로는 소스 자료 경로의 상위 또는 하위가 될 수 없습니다.\n다른 경로를 선택해 주세요."],["Help","도움말"],["Import","가져오기"],["Revert to origin data","원본 데이터로 되돌리기"],["Select target directory.","대상 디렉토리 선택."],["The existing files will be overwritten!","기존 파일이 덮어쓰기됩니다!"],["Process","처리"],["Path to the directory can not be empty!","디렉토리 경로는 비워둘 수 없습니다!"],["Invalid directory:","유효하지 않은 디렉토리:"],["Rebuild translation table from this cache","이 캐시에서 번역 테이블 다시 빌드"],["Create new project","새 프로젝트 생성"],["-nothing-","-없음-"],["Ok","확인"],["No action selected, are you sure?","선택된 작업이 없습니다, 계속하시겠습니까?"],["No context's keyword specified!","컨텍스트 키워드가 지정되지 않았습니다!"],["Remove context containing keyword :\n","키워드를 포함하는 컨텍스트 제거 :\n"],["\nfrom selected files?","\n선택한 파일에서?"],["Remove every rows except rows that has a context containing keyword :\n","키워드를 포함하는 컨텍스트가 있는 행을 제외한 모든 행 제거 :\n"],["items","항목"],["Select Context","컨텍스트 선택"],["Manual Query","수동 쿼리"],["Tag filter","태그 필터"],["Merging option","병합 옵션"],["Source Column","소스 열"],["Target Column","타겟 열"],["Maximum length","최대 길이"],["Query","쿼리"],["Select how you want to filter the rows to be wrapped based on their context.","컨텍스트를 기반으로 래핑할 행을 필터링하는 방법을 선택하세요."],["Your list of context separated by new line","새 줄로 구분된 컨텍스트 목록"],["Optionally filter rows by their color tags.","선택적으로 색상 태그로 행을 필터링합니다."],["Options","옵션"],["No merging","병합 없음"],["Merge lines","줄 병합"],["Merge lines except first line","첫 줄을 제외한 줄 병합"],["General setup","일반 설정"],["Wrap text","텍스트 줄바꿈"],["Source & target column can not be same!","원본 및 대상 열은 동일할 수 없습니다!"],["No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?","파일 선택 창에서 파일이 선택되지 않았습니다.\nTranslator++는 모든 파일이 처리될 것으로 가정합니다.\n이에 동의하시겠습니까?"],["One or more required options are not set for ","하나 이상의 필수 옵션이 설정되지 않았습니다: "],["One or more settings required by the translator engine are not set. If you continue, the translation process may fail.","번역 엔진에 필요한 하나 이상의 설정이 설정되지 않았습니다. 계속 진행하면 번역 과정이 실패할 수 있습니다."],["Required options :","필수 옵션:"],["Open the settings","설정 열기"],["Continue anyway","그래도 계속"],["Translate Now","지금 번역"],["Please select translator engine","번역 엔진을 선택해 주세요"],["Can not process your request because the source column and target column are same!","원본 열과 대상 열이 동일하여 요청을 처리할 수 없습니다!"],["Tags","태그"],["Merge Option","병합 옵션"],["Add rows","행 추가"],["None","없음"],["Merge","병합"],["Merge except the first line","첫 번째 줄 제외 병합"],["No export path specified","내보내기 경로가 지정되지 않았음"],["Export path can not be inside or the same with the project folder.\nYour export path: ","내보내기 경로는 프로젝트 폴더 내부이거나 동일할 수 없습니다.\n내보내기 경로: "],["\nYour project path: ","\n프로젝트 경로: "],["\n\nPlease choose another folder!","\n\n다른 폴더를 선택해 주세요!"],["Export Now","지금 내보내기"],["Action","작업"],["Append tags","태그 추가"],["Remove tags","태그 제거"],["Set tags","태그 설정"],["Do nothing","아무것도 하지 않음"],["-unknown title-","-알 수 없는 제목-"],["Can not open file. File not exist.","파일을 열 수 없습니다. 파일이 존재하지 않습니다."],["Go to online documentation.","온라인 문서로 이동"],["No projects yet","아직 프로젝트가 없습니다"],["Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t","Translator++가 처음이신가요?<br />\n\t\t\t<b>dreamsavior.net</b>에서 온라인 문서를 읽어보세요.<br />\n\t\t\t<b>F1</b>을 눌러 온라인 도움말을 열 수 있습니다.<br />\n\t\t\t질문이나 버그 보고는 <b>patreon.com/dreamsavior</b>로 연락해 주세요.\n\t\t\t"],["Warning","경고"],["Close","닫기"],["You are about to run a user script!","사용자 스크립트를 실행하려고 합니다!"],["Execute the script","스크립트 실행"],["Bring to main screen","메인 화면으로 가져오기"],["Show row header info","행 헤더 정보 표시"],["Row header width","행 헤더 너비"],["Display marker on organic cells","유기적 셀에 마커 표시"],["Leave trail on cell visit","셀 방문 시 흔적 남기기"],["Display trails on visited cells","방문한 셀에 흔적 표시"],["Row Properties","행 속성"],["Project Properties","프로젝트 속성"],["Project Properties : ","프로젝트 속성 : "],["Stage path do not exist!","스테이지 경로가 존재하지 않습니다!"],["Select dev folder","개발 폴더 선택"],["Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.","번역된 게임의 디렉토리는 어디에 위치합니까?<br />이는 게임을 주입할 때 대상 디렉토리와 동일한 폴더입니다."],["Select folder","폴더 선택"],["Submit","제출"],["File Properties","파일 속성"],["File Properties : ","파일 속성 : "],["Target column","대상 열"],["Trim Whitespaces","공백 제거"],["Please select a column","열을 선택해 주세요"],["Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!","선택한 열의 공백을 제거하시겠습니까?\n이 작업은 되돌릴 수 없습니다!"],["Are you sure want commit autopadding on selected column?\nThis action can not be undone!","선택한 열에 자동 패딩을 적용하시겠습니까?\n이 작업은 되돌릴 수 없습니다!"],["Markers","마커"],["Markers are visual guidelines for the number of characters in a line.","마커는 한 줄의 문자 수를 위한 시각적 가이드라인입니다."],["The marker will only be visible if wordwrap in the text area is disabled.","마커는 텍스트 영역의 줄 바꿈이 비활성화된 경우에만 표시됩니다."],["Add","추가"],["Clear all","모두 지우기"],["Enable suggestion","제안 활성화"],["Speech Synthesizer","음성 합성기"],["Reading speed:","읽기 속도:"],["Pitch:","음높이:"],["Volume:","볼륨:"],["Mark at","표시 위치"],["Units","단위"],["Half width character (ie. Alphabet, etc)","반각 문자 (예: 알파벳 등)"],["Full width character (ie. Hiragana, Kanji, 漢字, etc)","전각 문자 (예: 히라가나, 한자, 漢字 등)"],["Color","색상"],["Remove","제거"],["Current Cell's Editor Options","현재 셀의 편집기 옵션"],["Auto Padding","자동 패딩"],["Create","생성"],["Unable to open that file!","해당 파일을 열 수 없습니다!"],["Are you sure want to close the project?\nYou will lost any unsaved changes!","프로젝트를 닫으시겠습니까?\n저장되지 않은 변경 사항이 손실됩니다!"],["Are you sure want to exit Translator++?\nYou will lost any unsaved changes!","Translator++를 종료하시겠습니까?\n저장되지 않은 변경 사항이 손실됩니다!"],["Do not show this message again!","이 메시지를 다시 표시하지 않음!"],["Back","뒤로"],["Are you sure want to execute the following script?","다음 스크립트를 실행하시겠습니까?"],["No script found","스크립트를 찾을 수 없음"],["Open Script Editor","스크립트 편집기 열기"],["How to add Automation here","여기에 자동화를 추가하는 방법"],["Clear Quick Launch","빠른 실행 지우기"],["Are you sure want to clear all quick launch scripts?","모든 빠른 실행 스크립트를 지우시겠습니까?"],["Remove selected objects?","선택된 개체를 제거하시겠습니까?"],["Do you wish to remove related staging files too?\nWarning: This is can not be undone!","관련 스테이징 파일도 제거하시겠습니까?\n경고: 이 작업은 되돌릴 수 없습니다!"],["Error!\r\nTranslator++ is unable to detect the type of ","오류!\r\nTranslator++가 유형을 감지할 수 없습니다: "],["`Required application to parse ${","`${"],["} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`","}를 파싱하는 데 필요한 애플리케이션이 설치되지 않았습니다.\\n타사 애플리케이션 설치 프로그램을 통해 설치해 주세요.\\n타사 애플리케이션 설치 프로그램 창을 열겠습니까?`"],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","게임이 Enigma로 패키징되어 있습니다.\r\n패키지를 추출하시겠습니까?\r\n게임 크기에 따라 몇 분이 소요될 수 있습니다."],["Copy & extract data into ","데이터를 복사 및 추출하여 "],["Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!","현재 페이지의 모든 번역을 정말로 삭제하시겠습니까?\n경고: 이 작업은 되돌릴 수 없습니다!"],["Are you realy sure want to delete current file?\nWarning: this is irreversible action!","현재 파일을 정말로 삭제하시겠습니까?\n경고: 이 작업은 되돌릴 수 없습니다!"],["Please enter the title","제목을 입력하세요"],["Do you want to remove the currently selected row(s)?","현재 선택된 행을 제거하시겠습니까?"]],"context":[["tid/154/type/TemplateHead"],["tid/158/type/TemplateTail"],["tid/202/type/StringLiteral"],["tid/1201/type/StringLiteral"],["tid/1261/type/StringLiteral"],["tid/4827/type/StringLiteral"],["tid/4834/type/StringLiteral"],["tid/4841/type/StringLiteral"],["tid/4848/type/StringLiteral"],["tid/4855/type/StringLiteral"],["tid/8249/type/StringLiteral"],["tid/8829/type/StringLiteral"],["tid/8861/type/StringLiteral"],["tid/9513/type/StringLiteral","tid/10983/type/StringLiteral","tid/11779/type/StringLiteral","tid/12739/type/StringLiteral","tid/13697/type/StringLiteral","tid/17723/type/StringLiteral","tid/20089/type/StringLiteral","tid/21021/type/StringLiteral","tid/23071/type/StringLiteral","tid/23751/type/StringLiteral","tid/36680/type/StringLiteral","tid/38040/type/StringLiteral","tid/38571/type/StringLiteral","tid/43926/type/StringLiteral","tid/44634/type/StringLiteral","tid/59585/type/StringLiteral","tid/60083/type/StringLiteral","tid/60416/type/StringLiteral"],["tid/9564/type/StringLiteral"],["tid/9784/type/StringLiteral"],["tid/10939/type/StringLiteral"],["tid/11030/type/StringLiteral","tid/11826/type/StringLiteral"],["tid/12499/type/NoSubstitutionTemplate","tid/12580/type/StringLiteral"],["tid/12504/type/NoSubstitutionTemplate"],["tid/12509/type/NoSubstitutionTemplate"],["tid/12802/type/StringLiteral"],["tid/12862/type/StringLiteral","tid/36791/type/StringLiteral"],["tid/12891/type/StringLiteral","tid/36820/type/StringLiteral"],["tid/13200/type/StringLiteral"],["tid/13613/type/StringLiteral"],["tid/17536/type/StringLiteral"],["tid/17773/type/StringLiteral","tid/23801/type/StringLiteral","tid/38091/type/StringLiteral","tid/38622/type/StringLiteral","tid/40249/type/StringLiteral","tid/43977/type/StringLiteral"],["tid/17841/type/StringLiteral"],["tid/17951/type/StringLiteral"],["tid/17990/type/StringLiteral"],["tid/18002/type/StringLiteral","tid/18107/type/StringLiteral"],["tid/18095/type/StringLiteral"],["tid/18369