":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","사용자 정의 모델.사용자 정의 라벨"],["model","모델"],["|","|"],["promptLibrary","프롬프트 라이브러리"],["search","검색"],["downloadChat","채팅 다운로드"],["newChat","새 채팅"],["api","API"],["customEndpoint","사용자 정의 엔드포인트"],["apiEndpoint.inputLabel","API 엔드포인트 입력 라벨"],["apiKey.inputLabel","API 키 입력 라벨"],["apiVersion.inputLabel","API 버전 입력 라벨"],["apiVersion.description","API 버전 설명"],["securityMessage","보안 메시지"],["apiEndpoint.description","API 엔드포인트 설명"],["apiEndpoint.warn","API 엔드포인트 경고"],["partialImportMessages","부분 가져오기 메시지"],["import","가져오기"],["name","이름"],["prompt","프롬프트"],["clearPrompts","프롬프트 지우기"],["morePrompts","더 많은 프롬프트"],["toast.sync","토스트.동기화"],["toast.stop","토스트.중지"],["button.sync","버튼.동기화"],["button.stop","버튼.중지"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ChatGPT 배치 API로 번역"],["Model","모델"],["The pre-trained model.","사전 훈련된 모델입니다."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 배치 API는 일반적으로 사용되는 API와 약간 다른 모델 명명 규칙을 사용하는 것으로 보입니다. 배치 API에서 사용되는 모델에는 \"-batch\" 접두사가 붙습니다. 예를 들어, <code>gpt-4.1-mini</code>를 사용하면 모델이 자동으로 <code>gpt-4.1-mini-batch</code>가 됩니다.<br />\n그러나 이 애드온이 생성된 시점 기준으로, 배치 모델은 OpenAI의 모델 사용 제한 목록에 나열되지 않아, 사용자가 모델 사용 필터를 \"허용\"(화이트리스트)으로 설정한 경우 배치 API를 사용할 수 없습니다.<br />\n이는 OpenAI UI의 버그일 가능성이 있으며, 향후 수정될 수 있습니다.<br />\n따라서 배치 API를 사용하려면 OpenAI에서 사용 제한을 \"차단\"(블랙리스트) 모드로 설정해야 합니다.<br />\n모델 사용 제한을 변경하려면 여기를 클릭하세요: https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","원본 열"],["The column of the original texts you want to translate.","번역하려는 원본 텍스트의 열입니다."],["Add actor name","액터 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 액터 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 이후 번역 결과에서 액터 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Ignore if already translated","이미 번역된 경우 무시"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","이 옵션을 선택하면 Translator++는 해당 열에 이미 번역이 있는 모든 행을 무시합니다."],["Load Actor Reference as Glossary","액터 참조를 용어집으로 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택하면, Translator++는 액터 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 액터 참조는 대화에서의 액터 이름입니다. 이는 번역자에게 용어집으로 로드되어 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 액터 참조를 로드하려면 템플릿 명령을 사용하세요."],["Actor Reference Translation Column","액터 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","액터 이름 번역의 열입니다. 이 열은 액터 참조의 번역으로 사용되어 대화에서 액터 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있습니다. 이렇게 하면 대화에서 대명사의 번역이 개선됩니다."],["System Message Template","시스템 메시지 템플릿"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","시스템 메시지는 ChatGPT 어시스턴트의 역할을 알려주는 메시지의 헤더입니다. 이 메시지는 ChatGPT에 보내는 모든 배치의 첫 번째 메시지로 전송됩니다."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript의 템플릿 리터럴 스타일로 다음 변수를 포함할 수 있습니다 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","변수:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 원본 언어</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 대상 언어</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 전체 원본 언어 이름</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 전체 대상 언어 이름</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 원본 텍스트</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 이스케이프 알고리즘의 사전 정의된 메시지.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 줄바꿈을 나타내는 문자열 (줄 대체).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 배치의 메시지 수</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 배우의 추가 정보</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 이전 줄을 컨텍스트로 포함</li>"],["Body Message Template","본문 메시지 템플릿"],["Template of the body of your chat.","채팅 본문의 템플릿입니다."],["Sample conversation","샘플 대화"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT 배치 API를 사용하면 비동기적으로 프로젝트를 번역할 수 있으며, 비용이 50% 절감됩니다. 즉, 번역 결과를 <b style=\"color:red\">24시간 이내</b>에 <b style=\"color:red\">정상 비용의 절반</b>으로 받게 됩니다. 이는 즉각적인 번역 결과가 필요하지 않은 대규모 프로젝트에 특히 유용합니다."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />ChatGPT 배치 API에 대해 자세히 알아보기: https://platform.openai.com/docs/guides/batch ."],["General Settings","일반 설정"],["This form is using your existing ChatGPT configuration.<br>","이 양식은 기존 ChatGPT 구성을 사용하고 있습니다.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","옵션 창의 ChatGPT 번역기 설정으로 이동하여 구성을 변경할 수 있습니다.<br>"],["There you can set the API key, model, and other settings.<br />","거기에서 API 키, 모델 및 기타 설정을 지정할 수 있습니다.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT 설정 열기\" />"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Ignore translated rows","번역된 행 무시"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 용어집을 자동으로 추가하여 번역 품질을 향상시킵니다. 용어집은 각 항목 배치마다 로드되며, 프롬프트가 부풀어오르지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Prompt Template","프롬프트 템플릿"],["<h2>1. System Message</h2>","<h2>1. 시스템 메시지</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>여기서 어시스턴트에게 그들의 역할이 무엇인지 설명할 수 있습니다.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플입니다. 번역자가 목적과 대화 맥락을 이해하도록 좋거나 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 실제 프롬프트</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>이것은 어시스턴트에게 보내는 실제 프롬프트입니다.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>간접 비용</h3>\n                        간접 비용은 실제 번역 텍스트 없이 어시스턴트에게 보내는 프롬프트 메시지의 비용입니다. 비용은 프롬프트 메시지의 토큰 수를 기준으로 계산됩니다. 토큰이 많을수록 비용이 높아집니다.<br>\n                        <b>현재 간접 비용:</b> <span class=\"overheadCost\">0</span> 토큰 / 요청."],["Are you sure you want to reset the form?","양식을 초기화하시겠습니까?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","일괄 처리를 진행하시겠습니까?\n이 작업에 비용이 발생합니다."],["The batch is successfully created. Do you want to open the batch manager?","일괄 처리가 성공적으로 생성되었습니다. 일괄 관리자를 열겠습니까?"],["OpenAI Batch API Queue","OpenAI 일괄 API 대기열"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","번역을 적용할 행을 선택해 주세요"],["Target Column","대상 열"],["The column to put the translation result.","번역 결과를 넣을 열입니다."],["Import translation from ChatGPT Batch","ChatGPT 일괄 처리에서 번역 가져오기"],["Translation applied to selected rows","선택한 행에 번역이 적용되었습니다"],["Invalid format","잘못된 형식"],["OK","확인"],["Mismatch","불일치"],["Failed to load batch list with error: \n","오류로 일괄 처리 목록을 불러오지 못했습니다:\n"],["Download Error File","오류 파일 다운로드"],["Batch is not completed yet","일괄 처리가 아직 완료되지 않았습니다"],["Are you sure you want to cancel this batch?","이 일괄 처리를 취소하시겠습니까?"],["Cannot cancel completed batch.","완료된 일괄 처리는 취소할 수 없습니다."],["Batch cancelled","일괄 처리 취소됨"],["Failed to cancel batch","일괄 처리 취소 실패"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","일괄 처리"],["Apply translation","번역 적용"],["Cancel batch","일괄 취소"],["Status","상태"],["Batch ID","일괄 ID"],["Input File ID","입력 파일 ID"],["End point","종료점"],["Created at","생성 시간"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","만료 시간 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"시간 내에 완료되지 않은 일괄 작업은 결국 만료 상태로 이동하며, 해당 일괄 내 미완료 요청은 취소되고 완료된 요청에 대한 응답은 일괄 작업의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 청구됩니다.\"></i>"],["Completed at","완료 시간"],["Errors","오류"],["Batch Item Detail of","일괄 항목 상세 정보"],["ID","ID"],["Completed on","완료일"],["Model","모델"],["Prompt Token","프롬프트 토큰"],["Completion Token","완료 토큰"],["Total Token","총 토큰"],["Status Code","상태 코드"],["error","오류"],["Conversation","대화"],["Response Validation","응답 검증"],["Raw Payload","원본 페이로드"],["View raw payload","원본 페이로드 보기"],["Response Preview","응답 미리보기"],["Apply translations from selected rows","선택한 행에서 번역 적용"],["Here you can edit the translation result individually and send it into Translator++","여기서 번역 결과를 개별적으로 편집하고 Translator++로 보낼 수 있습니다."],["Open ChatGPT Settings","ChatGPT 설정 열기"],["Help","도움말"],["File list","파일 목록"],["Collapse / restore left panel","왼쪽 패널 접기 / 복원"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","시간 내에 완료되지 않은 배치는 결국 만료 상태로 이동합니다. 해당 배치 내 미완료 요청은 취소되며, 완료된 요청에 대한 응답은 배치의 출력 파일을 통해 제공됩니다. 완료된 요청에서 소비된 토큰에 대해 요금이 부과됩니다."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","OpenAI 채팅"],["Target URL","대상 URL"],["Target end point. You can use any service that supports OpenAI API.","대상 엔드포인트. OpenAI API를 지원하는 모든 서비스를 사용할 수 있습니다."],["Sample endpoints","샘플 엔드포인트"],["Use this endpoint","이 엔드포인트 사용"],["Copy to clipboard","클립보드에 복사"],["e.g.","예:"],["API Key","API 키"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","여기에 API 키를 입력하세요.<br>API 키를 얻는 방법은 서비스마다 다릅니다.<br>"],["Leave it blank if the service doesn't require API key.","서비스가 API 키를 요구하지 않으면 비워두세요."],["Model","모델"],["The pre-trained model","사전 훈련된 모델"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","OpenAI의 경우, 사용 가능한 모델을 설정해야 할 수 있습니다 (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","컨텍스트 활성화"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","번역에 컨텍스트를 활성화합니다. 현재 배치 위의 이전 번역 자료가 컨텍스트로 포함됩니다. <b>템플릿에 CONTEXT를 명시적으로 포함해야 합니다</b>"],["Context Character Limit","컨텍스트 문자 제한"],["Character limit for the context.","컨텍스트의 문자 제한입니다."],["System Message Template","시스템 메시지 템플릿"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","시스템 메시지는 chatGPT 어시스턴트의 역할을 알리는 메시지의 헤더입니다. 이 메시지는 chatGPT에 보내는 모든 배치의 첫 번째 메시지로 전송됩니다."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript의 템플릿 리터럴 스타일 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span>로 다음 변수들을 포함할 수 있습니다.<br>"],["Variables:<br>","변수:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 원본 언어</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 대상 언어</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 원본 텍스트</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 이스케이프 알고리즘의 사전 정의된 메시지입니다.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 줄 바꿈을 나타내는 문자열 (줄 대체).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 배치의 메시지 수입니다.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보의 용어집입니다. (배치 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조를 생성합니다. <br />예시 : <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 컨텍스트 (컨텍스트가 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["User message","사용자 메시지"],["Assistant's response","어시스턴트의 응답"],["Body Message Template","본문 메시지 템플릿"],["Template of the body of your chat.","채팅 본문의 템플릿입니다."],["Enable JailBreak","JailBreak 활성화"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","번역을 위해 Jailbreak를 활성화합니다. 이렇게 하면 번역이 더 정확하고 편향되지 않게 됩니다. 일부 모델은 가상의 사건을 실제 사건과 연관시키려 할 수 있어, 자신의 서사에 맞게 번역을 변경하려 할 수 있습니다. 이 옵션은 이를 방지합니다."],["Jailbreak Template","Jailbreak 템플릿"],["Template of the Jailbreak message.","Jailbreak 메시지의 템플릿입니다."],["Maximum Tokens","최대 토큰 수"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","생성할 완성문의 최대 토큰 수입니다.<br>프롬프트의 토큰 수와 max_tokens의 합계는 모델의 컨텍스트 길이를 초과할 수 없습니다. 대부분의 모델은 2048 토큰의 컨텍스트 길이를 가집니다 (최신 모델은 4096을 지원합니다)."],["Temperature","온도"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0에서 2 사이의 샘플링 온도를 사용합니다. 0.8과 같은 높은 값은 출력을 더 무작위로 만들고, 0.2와 같은 낮은 값은 더 집중적이고 결정론적으로 만듭니다. <br>OpenAI는 일반적으로 이 값이나 top_p 중 하나만 변경할 것을 권장합니다."],["Nucleus sampling (top_p)","핵심 샘플링 (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","온도 샘플링의 대안으로, 핵심 샘플링이라고 하며, 모델이 top_p 확률 질량을 가진 토큰의 결과를 고려합니다. 따라서 0.1은 상위 10% 확률 질량을 구성하는 토큰만 고려됨을 의미합니다. <br>OpenAI는 일반적으로 이 값이나 온도 중 하나만 변경할 것을 권장합니다."],["Frequency Penalty","빈도 패널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자입니다. 양수 값은 토큰이 텍스트에서 기존에 나타난 빈도에 기반하여 새로운 토큰에 패널티를 부과하여, 모델이 동일한 문장을 그대로 반복할 가능성을 줄입니다. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","존재 패널티"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0에서 2.0 사이의 숫자. 양수 값은 새로운 토큰이 지금까지 텍스트에 나타나는지 여부에 따라 페널티를 부여하여 모델이 새로운 주제에 대해 이야기할 가능성을 높입니다.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","JSON 스키마 사용"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","<code>response_format.type</code> 필드에 이전 <code>json_object</code> 대신 <code>json_schema</code>를 사용하세요. <code>json_schema</code>는 일부 최신 모델과 <b>LM Studio</b> 같은 서버에서 필요하지만, 일부 오래된 모델은 여전히 <code>json_object</code>를 사용합니다."],["Max Characters per Batch","배치당 최대 문자 수"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","번역 배치당 최대 문자 제한.\n이 옵션은 원본 텍스트의 문자 길이만 계산하며, 프롬프트 메시지의 문자 길이는 포함하지 않습니다."],["Max concurrent requests","최대 동시 요청 수"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","동시에 연결할 수 있는 동시 요청 수는 몇 개인가요? 각 추가 동시 연결은 번역 속도를 배가시키지만, 공급자가 설정한 토큰 한도를 빠르게 소진할 수 있습니다.<br /><b>0</b>으로 설정하면 이 기능을 비활성화합니다.<br />이 옵션을 <b>동시 요청당 최대 행 수</b>와 결합하여 번역 속도를 더욱 높일 수 있습니다.<br />이 옵션을 1보다 크게 설정하면 <b>컨텍스트</b>에 영향을 미칩니다. 이전 요청이 완료되기 전에 요청이 처리되기 때문에, 컨텍스트는 이전 요청의 번역 결과 없이 전송됩니다."],["Max row per concurrent requests","동시 요청당 최대 행 수"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","각 동시 요청에 허용되는 행 수입니다. <b>0</b>으로 설정하면 이 기능을 비활성화합니다.<br />이 옵션이 비활성화되면 <b>최대 동시 요청 수</b>를 얼마나 설정하든, Translator++는 요청을 단일 청크로 처리합니다.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","설정한 행 수가 많을수록 단일 배치에서 더 많은 번역을 얻을 수 있습니다. 따라서 오버헤드 비용을 줄이고 AI가 오류 결과를 반환할 가능성을 높입니다.<br />숫자가 낮을수록 번역 오류 가능성은 줄어들지만, 오버헤드 프롬프트에 대한 추가 비용이 발생합니다."],["Preserve translations from invalid returned number of rows","잘못된 반환 행 수에서 번역 보존"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","잘못된 행 수를 가진 응답에서 번역을 보존합니다.<br />체크하면, Translator++는 행 수를 수정하고 번역을 그리드에 삽입하려고 시도합니다.<br />체크하지 않으면 셀이 비어 있게 됩니다.<br />재번역 목적을 위해 이 옵션을 체크하지 않는 것이 권장됩니다."],["Batch delay","배치 지연"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","배치 간 지연(밀리초 단위).<br />이 설정을 사용하여 RPM(분당 요청 수) 제한에 도달하지 않도록 요청을 제어하세요."],["Batch Timeout","배치 타임아웃"],["Timeout for each batch in milisecond","각 배치에 대한 타임아웃(밀리초 단위)"],["Code Escaping Algorithm","코드 이스케이프 알고리즘"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","대화 내 인라인 코드에 대한 이스케이프 알고리즘입니다. 선택한 이스케이프 알고리즘에 따라 <b>시스템 메시지 템플릿</b>과 <b>본문 메시지 템플릿</b>을 변경해야 할 수 있습니다.<br /><b>JSONCloaking</b> 또는 <b>JSONObjectCloaking</b>을 선택하면, <code>response_format: { type: 'json_object' }</code>가 자동으로 전송됩니다(<b>JSON 스키마 사용</b>을 활성화하지 않는 한, 이 경우 JSON 스키마가 대신 전송됩니다). <b>JSONCloaking</b>은 매우 정확하지만 모든 모델에서 작동하지 않습니다. <b>gpt-3.5-turbo-1106</b>를 시도해 보세요."],["Number of retry","재시도 횟수"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","번역 출력 검증이 실패할 때 엔진이 재시도해야 하는 횟수입니다. nullish(비어 있음)이면 재시도하지 않습니다."],["Retry when the number of translated rows doesn't match original","번역된 행 수가 원본과 일치하지 않을 때 재시도"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","활성화하면, 모델이 반환한 번역 행 수가 원본 페이로드와 다를 때 엔진이 재시도합니다."],["Retry when the number of lines for each translated row doesn't match original","각 번역된 행의 줄 수가 원본과 일치하지 않을 때 재시도"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","활성화하면, 번역된 행이 원본 행과 다른 줄 수를 가질 때 엔진이 재시도합니다."],["Prompt: Row count mismatch","프롬프트: 행 수 불일치"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","행/요소 수 불일치로 인해 재시도할 때 사용되는 프롬프트입니다. 사용 가능한 템플릿 변수: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","프롬프트: 줄 수 불일치"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","행별 줄 수 불일치로 인해 재시도할 때 사용되는 프롬프트입니다. 사용 가능한 템플릿 변수: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","프롬프트: 오류 / 재시도 지침"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","불일치 프롬프트 뒤에 추가되어 모델에 재시도를 지시하는 프롬프트입니다. 사용 가능한 템플릿 변수: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","사용자 정의 매개변수"],["Key","키"],["Value","값"],["Type","유형"],["Type of the value.","값의 유형입니다."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b> 유형의 경우, 값은 JavaScript 코드로 평가됩니다."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript 코드의 범위는 <code>window</code>입니다. 따라서 거의 모든 값을 가져올 수 있습니다."],["<br />Example: <code>trans.project.title</code>","<br />예시: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","API로 전송되지 않을 매개변수를 삭제합니다.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API는 계속 변경되고 있으며, 일부 새로운 모델은 이전 매개변수를 지원하지 않아 인식되지 않은 요청 매개변수에 대해 HTTP 오류를 반환할 수 있습니다."],["You can drop the parameters that are not supported by the model here.","여기서 모델이 지원하지 않는 매개변수를 제외할 수 있습니다."],["Manage configuration","구성 관리"],["RPG Maker","RPG 메이커"],["HTML Cloaking Wrapped","HTML 클로킹 래핑"],["JSONObject Cloaking","JSONObject 클로킹"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","이 애드온은 Deepseek, LlamaCPP, Google Gemini 등 OpenAI Chat API를 지원하는 모든 서비스를 통해 번역을 가능하게 하며, 물론 OpenAI ChatGPT도 포함됩니다."],["OpenAI API settings","OpenAI API 설정"],["General","일반"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>추론 모델에 돈을 낭비하지 마세요</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>다양한 연구에 따르면, 추론 모델은 창의적인 글쓰기와 번역 작업에서 일반 모델보다 훨씬 성능이 떨어집니다.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>추론 모델을 사용하면 비용만 더 비싸지고 응답 시간이 느려질 뿐입니다.</p>"],["Explore more models","더 많은 모델 탐색"],["Templates","템플릿"],["Enable context","컨텍스트 활성화"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플입니다. 번역자가 목표와 대화 맥락을 이해하도록 좋거나 나쁜 응답의 예를 작성할 수 있습니다.</p>"],["Add Example: Translate Japanese to English","예시 추가: 일본어에서 영어로 번역"],["Retry prompts","프롬프트 재시도"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>이 프롬프트는 이전 모델 출력 직후 추가 <b>사용자</b> 메시지로 첨부됩니다.</p>"],["<p>Available variables:</p>","<p>사용 가능한 변수:</p>"],["Enable Jailbreak","탈옥 활성화"],["Advanced","고급"],["Custom Parameters","사용자 정의 매개변수"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API 요청 본문에 사용자 정의 매개변수를 추가할 수 있습니다. 이는 폼에서 사용할 수 없는 추가 매개변수를 추가하려는 경우 유용합니다."],["<h2>Warning</h2>","<h2>경고</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>사용자 정의 매개변수를 잘못 설정하면 API 요청이 실패할 수 있습니다. 사용자 정의 매개변수를 추가하기 전에 무엇을 하는지 확실히 알고 있어야 합니다. OpenAI와 같은 일부 서비스는 보내는 매개변수에 대해 엄격하며, 인식되지 않는 요청 매개변수에 대해 HTTP 오류를 반환합니다.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>동일한 키가 여러 번 사용되면 마지막 값만 사용됩니다.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>기존 구성에서 동일한 키가 사용되면 기존 구성 매개변수가 사용자 정의 매개변수로 덮어쓰기됩니다.</li>"],["Drop Parameters","매개변수 삭제"],["Open chatGPT tester","chatGPT 테스터 열기"],["Batch Translation Setting","일괄 번역 설정"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","죄송합니다, 이 애드온은 활성 후원자만 사용할 수 있습니다.\n$1 후원자가 되어 이 기능을 잠금 해제할 수 있습니다."],["Preserve invalid returned rows","유효하지 않은 반환된 행 유지"],["Retries and Refinement","재시도 및 개선"],["<h2>Retries and Refinement</h2>","<h2>재시도 및 개선</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>번역 출력이 유효성 검사를 통과하지 못할 때, Translator++는 모델에게 번역을 재시도하도록 요청할 수 있습니다. 모델이 몇 번 재시도해야 하는지 설정하고, 재시도 조건도 설정할 수 있습니다.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>적절한 재시도 조건과 합리적인 재시도 횟수를 설정하면 비용과 시간을 관리하면서 번역 품질을 크게 향상시킬 수 있습니다.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>각 재시도는 추가 시간과 비용이 듭니다</b>. 일괄 번역이 자주 재시도하게 되면, 모델에 대한 지시를 더 명확하게 하기 위해 프롬프트를 조정하는 것이 좋습니다.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>개발자 도구나 일괄 관리자를 사용하여 일괄 번역을 디버그하세요.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>코드 이스케이프 알고리즘</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>코드 이스케이핑은 MTL이 대화 내부의 코드 스니펫을 변경하지 못하도록 방지하는 기술입니다. 이는 대화에 HTML 태그, XML 태그, JSON 객체 또는 JavaScript 템플릿과 같은 코드 스니펫이 포함된 경우 유용합니다.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>대화 내부의 코드 스니펫과 일치하는 이스케이핑 알고리즘을 선택하세요. <b>시스템 메시지</b>, <b>샘플 프롬프트</b> 및 <b>본문 메시지</b> 템플릿을 그에 따라 조정해야 할 수 있습니다.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>코드 이스케이핑 알고리즘과 효과적인 사용 방법에 대해 더 읽으려면 <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>여기</a>를 클릭하세요.</p>"],["Default","기본값"],["JavaScript template cloaking","JavaScript 템플릿 은닉"],["None (no escaping)","없음 (이스케이핑 안 함)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","선택한 이스케이프 알고리즘에 대한 샘플 대화 프리셋을 로드하시겠습니까? 이는 기존 샘플 대화를 덮어씁니다."],["Always separate file","항상 별도 파일"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","각 배치마다 항상 파일을 분리합니다. 이는 각 파일의 컨텍스트가 다른 파일로 오염되지 않도록 유지할 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 배우 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 그런 다음 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","용어집으로 배우 참조 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","체크하면, Translator++는 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 컨텍스트를 이해하는 데 도움이 됩니다. 배우 참조는 대화에서 배우의 이름입니다. 이는 번역자에게 용어집으로 로드됩니다. 이는 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 캐릭터 정보 데이터를 배치하기 위해 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름의 번역 열입니다. 이 열은 배우 참조의 번역으로 사용됩니다. 이는 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보가 포함된 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있습니다. 이는 대화에서 대명사의 번역을 향상시킵니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 시스템 메시지 이후, 실제 프롬프트 메시지 전에 추가됩니다."],["<br />","<br />"],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치마다 별도의 파일 사용"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 용어집을 자동으로 추가하여 번역 품질을 향상시킵니다. 용어집은 각 배치 항목에 대해 로드되며, 프롬프트의 부풀림을 피하기 위해 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보 열"],["Prompt","프롬프트"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":true,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>보</u>내기"],["Toggle word wrap","단어 줄바꿈 전환"],["Open debugger (F12)","디버거 열기 (F12)"],["Help","도움말"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","이 기능은 Translator++의 개발자 버전을 사용하는 경우에만 사용 가능합니다. 기본 유틸리티 -> 코어 NWJS 변경을 사용하여 개발자 버전으로 전환할 수 있습니다."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 게임 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 게임 엔진</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 배우 정보 용어집 (배치 모드에서 배우 정보 옵션이 활성화된 경우에만)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[객체 이름] : Translator++ 객체에서 참조 생성 <br />예: <code>REFERENCE[공통 참조]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 이전 번역의 컨텍스트 (컨텍스트가 활성화된 경우)</li>"],["Sample conversation","샘플 대화"],["<h2>Sample dialogue</h2>","<h2>샘플 대화</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>기존 대화 샘플입니다. 번역자가 목적과 대화 컨텍스트를 이해하도록 좋은 또는 나쁜 응답의 샘플을 작성할 수 있습니다.</p>"],["Always separate file","항상 별도 파일"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","항상 각 배치마다 별도의 파일을 사용하세요. 이렇게 하면 각 파일의 컨텍스트가 다른 파일과 섞이지 않게 유지될 수 있습니다."],["Add actor name","배우 이름 추가"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","행 정보에서 배우 이름을 번역 가능한 텍스트에 추가합니다. 이는 번역자가 대화와 대명사를 추적하는 데 도움이 됩니다. Translator++는 그 후 번역 결과에서 배우 이름을 제거합니다. 이는 분명히 번역 비용을 증가시킵니다."],["Load Actor Reference as Glossary","용어집으로 배우 참조 로드"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","선택하면, Translator++는 배우 참조를 용어집으로 로드합니다. 이는 번역자가 대화의 맥락을 이해하는 데 도움이 됩니다. 배우 참조는 대화에서 배우의 이름입니다. 이는 번역자에게 용어집으로 로드되어 번역 비용을 증가시킵니다."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","대화에 존재하는 캐릭터만 각 배치 항목에 대한 용어집으로 로드됩니다. 프롬프트 메시지에서 배우 참조를 로드하려면 템플릿 명령을 사용하세요."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️이 옵션을 활성화하면, 캐릭터 정보 데이터를 배치하기 위해 프롬프트 템플릿에 <code>ACTOR_INFO</code> 변수를 포함해야 합니다."],["Actor Reference Translation Column","배우 참조 번역 열"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","배우 이름 번역의 열입니다. 이 열은 배우 참조의 번역으로 사용되어 대화에서 배우 이름 번역의 일관성을 향상시킵니다."],["Actor's Information Column","배우 정보 열"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","배우의 추가 정보를 포함하는 열입니다. 성별, 나이 등 더 많은 정보를 넣을 수 있으며, 이는 대화에서 대명사 번역을 개선합니다."],["Extra Prompt","추가 프롬프트"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","프롬프트 메시지에 추가될 추가 프롬프트입니다. 이는 시스템 메시지 후와 실제 프롬프트 메시지 전에 추가됩니다."],["General Settings","일반 설정"],["Always separate file for each batch","항상 각 배치에 대해 별도의 파일 사용"],["Append actor name to the translatable text","번역 가능한 텍스트에 배우 이름 추가"],["Glossary","용어집"],["<h2>Glossary</h2>","<h2>용어집</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>이 기능은 프롬프트에 자동으로 용어집을 추가하는 데 도움이 됩니다. 용어집은 번역 품질을 향상시키기 위해 각 배치 항목에 로드됩니다. 이 기능은 프롬프트를 부풀리지 않도록 관련 용어만 로드하려고 시도합니다.</p>"],["The Column of Actor's Additional Information","배우 추가 정보의 열"],["Prompt","프롬프트"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","ChatGPT API와 채팅"],["Batch Manager","일괄 관리자"],["This feature is only available if you have a project open.","이 기능은 프로젝트가 열려 있을 때만 사용할 수 있습니다."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","DazedMTLTool을 설치하시겠습니까?"],["Ignore if already translated","이미 번역된 경우 무시"],["OpenAI Translation with DazedMTL","DazedMTL을 사용한 OpenAI 번역"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":true,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","DeepL 서버가 설치되지 않았습니다. 지금 설치하시겠습니까?"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":true,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","문자 사용량:\n"],["Failed to fetch quota: ","할당량 가져오기 실패: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":true,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>보</u>내기"],["Toggle word wrap","자동 줄바꿈 전환"],["Open debugger (F12)","디버거 열기 (F12)"],["Help","도움말"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","이 기능은 Translator++의 개발자 버전을 사용 중일 때만 사용 가능합니다. 기본 유틸리티 -> 코어 NWJS 변경을 통해 개발자 버전으로 전환할 수 있습니다."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>제목 : 게임의 제목</li>"],["<li>ENGINE : Engine of the game</li>","<li>엔진 : 게임의 엔진</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>참조[객체 이름] : Translator++ 객체에서 참조 생성. <br />예시 : <code>참조[공통 참조]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>네이티브 Gemini API</h2><p>이 엔진은 번역에 Google Gemini 네이티브 API를 사용합니다. <br />Google Gemini용 OpenAI 애드온도 사용할 수 있습니다. OpenAI 애드온에는 더 많은 기능이 있으므로, <b style='color:green;'>대신 OpenAI 애드온 사용을 권장합니다</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI는 OpenAI 라이브러리의 일부 모듈이 필요합니다. <b>transChatGPT (Translator++용 ChatGPT)</b> 애드온이 설치되어 있는지 확인하세요."],["Explore more models","더 많은 모델 탐색"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","사용자 정의 모델.사용자 정의 레이블"],["model","모델"],["|","|"],["promptLibrary","프롬프트 라이브러리"],["search","검색"],["downloadChat","채팅 다운로드"],["newChat","새 채팅"],["api","API"],["customEndpoint","사용자 정의 엔드포인트"],["apiEndpoint.inputLabel","API 엔드포인트 입력 라벨"],["apiKey.inputLabel","API 키 입력 라벨"],["apiVersion.inputLabel","API 버전 입력 라벨"],["apiVersion.d