plateHead"],["tid/69384/type/TemplateTail","tid/70091/type/TemplateTail"],["tid/69811/type/StringLiteral"],["tid/70151/type/StringLiteral"],["tid/74815/type/StringLiteral"],["tid/74898/type/StringLiteral"],["tid/75985/type/StringLiteral"],["tid/77908/type/StringLiteral"]],"basename":"ui.js","dirname":"/js","extension":".js","filename":"ui.js","path":"/js/ui.js","indexIsBuilt":true,"indexIds":{"`You cannot close the application at this moment, reason: \\n${":0,"}`":1,"Do you really want to exit Translator++?\nAll unsaved changes will be discarded!":2,"Trans file":3,"Translator++ Project Package (TPP) file":4,"Select all":5,"Select none":6,"Invert":7,"Match destination selection":8,"use mouse drag to do bulk selection":9,"Invalid trans data":10,"Inject / Apply translation":11,"Inject / Apply translation to all":12,"Cancel":13,"Apply Translation":14,"Target path cannot be a parent or child of the source material's path.\nPlease select another path.":15,"Help":16,"Import":17,"Revert to origin data":18,"Select target directory.":19,"The existing files will be overwritten!":20,"Process":21,"Path to the directory can not be empty!":22,"Invalid directory:":23,"Rebuild translation table from this cache":24,"Create new project":25,"-nothing-":26,"Ok":27,"No action selected, are you sure?":28,"No context's keyword specified!":29,"Remove context containing keyword :\n":30,"\nfrom selected files?":31,"Remove every rows except rows that has a context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","콘솔 로그(F12)에서 더 자세한 정보를 볼 수 있습니다"],["Close","닫기"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","더 자세한 정보는 콘솔 로그(F12)에서 확인할 수 있습니다"],["Close","닫기"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.parts.js":{"data":[["Form","양식"],["Cancel","취소"],["Ok","확인"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":true,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","노트 제거"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/login.html":{"data":[["working","작업 중"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":true,"indexIds":{"working":0},"tags":[],"parameters":[]},"/note.html":{"data":[["Remove note","노트 제거"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/options.html":{"data":[["Click to login","클릭하여 로그인"],["Translator &amp; Language","번역기 & 언어"],["Proofreader","교정자"],["Assistant","어시스턴트"],["General","일반"],["Preferences","환경 설정"],["Add-ons","애드온"],["About","정보"],["User Information","사용자 정보"],["Login to your Patreon account to get access to the latest features and updates.","최신 기능과 업데이트에 액세스하려면 Patreon 계정에 로그인하세요."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> 로그인"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> 브라우저로 로그인"],["Welcome,","환영합니다,"],["Name","이름"],["Email","이메일"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","레벨 <div class=\"infoHeadNote\">(현재 구독 금액, USD 센트 기준)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","포인트 <div class=\"infoHeadNote\">(총 구독 금액, USD 센트 기준)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","결제 상태 <div class=\"infoHeadNote\">(현재 결제 상태)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">당황하지 마세요!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>그리고 다음 정보를 읽어주세요.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">이 플래그는 Patreon이 아직 후원금을 성공적으로 받지 못했음을 나타냅니다. 결제 시스템에 지연이 발생하는 것은 정상입니다. 결제 방법과 국가에 따라 최대 24시간까지 지연될 수 있습니다.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">이 지연 동안 신용카드에서 인출이 표시될 수 있습니다. 걱정하지 마세요—Patreon은 정기적으로 재시도하여 결제를 받았는지 확인합니다. 이는 보통 24시간 내에 해결됩니다.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">이 기간을 넘어서도 문제가 지속되면, Translator++ Discord 서버의 <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> 스레드에 글을 남겨주세요. 최대한 도와드리겠습니다.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">사기 방지를 위해, <b><span class=\"userInfoPoints\">포인트</span>와 <span class=\"userInfoLevel\">레벨</span>은 Patreon이 결제를 성공적으로 받을 때까지 집계되지 않습니다</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">당황하지 마세요!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","이 플래그는 Patreon이 아직 후원금을 성공적으로 받지 못했음을 나타냅니다. 결제 시스템에 지연이 발생하는 것은 정상입니다. 결제 방법과 국가에 따라 최대 24시간까지 지연될 수 있습니다."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","이 지연 동안 신용카드에서 인출이 표시될 수 있습니다. 걱정하지 마세요—Patreon은 정기적으로 재시도하여 결제를 받았는지 확인합니다. 이는 보통 24시간 내에 해결됩니다."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","이 기간을 넘어서도 문제가 지속되면, Translator++ Discord 서버의 <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> 스레드에 글을 남겨주세요. 최대한 도와드리겠습니다."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","사기 방지를 위해, <b><span class=\"userInfoPoints\">포인트</span>와 <span class=\"userInfoLevel\">레벨</span>은 Patreon이 결제를 성공적으로 받을 때까지 집계되지 않습니다</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> 로그아웃"],["Primary Translator","기본 번역기"],["Default Translator Engine","기본 번역 엔진"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\t이 번역 엔진은 선택한 셀에서 <span class=\"keyboardHint\">Ctrl+g</span>를 눌러 번역을 <strong>생성</strong>할 때 사용됩니다.\n\t\t\t\t"],["Default Language","기본 언어"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\t프로젝트 전반의 기본 언어 설정입니다!<br>\n\t\t\t\t프로젝트 속성의 설정이 이 값을 덮어씁니다.\n\t\t\t"],["Default Source Language","기본 원본 언어"],["Default Target Language","기본 대상 언어"],["Custom escape","사용자 정의 이스케이프"],["Patterns","패턴"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\t아래 패턴과 일치하는 모든 단어는 기계 번역기에 의해 번역되지 않습니다.\n\t\t\t\t\t\t이 섹션은 번역 엔진에서 태그와 스크립트를 숨기는 데 적합합니다.<br>\n\t\t\t\t\t\t각 항목은 유효한 자바스크립트 정규 표현식, 함수 또는 <b>쉼표</b>로 구분된 literal string입니다.<br>\n\t\t\t\t\t\t사용자 정의 이스케이프는 지원되는 <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">이스케이프 알고리즘</a>에 대해서만 작동합니다.\n\t\t\t\t\t\t<b>힌트:</b> ChatGPT에 정규 표현식을 생성하도록 요청할 수도 있습니다.<br>\n\t\t\t\t\t\t정규 표현식 패턴과 수정자를 함께 작성해 주세요.<br>\n\t\t\t\t\t\t예시:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","테스터"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\t여기에 텍스트를 붙여넣어 패턴을 확인하세요.\n\t\t\t\t\t\t일치하는 모든 패턴이 강조 표시됩니다.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>공사 중</h2>\n\t\t\t\t<p>이 영역은 자동 교정기 설정과 옵션이 구성될 장소입니다.</p>\n\t\t\t"],["AI Assistant","AI 어시스턴트"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>안녕하세요! 저는 MIRAI입니다, Translator++를 위한 AI 어시스턴트입니다.👋</strong></p>\n\t\t\t\t\t\t<p>홈 메뉴에서 제 아이콘 <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button>을 클릭하면 저와 대화할 수 있습니다. 저는 다음과 같은 도움을 드릴 수 있습니다:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>번역 개선 및 제안</li>\n\t\t\t\t\t\t\t<li>교정 및 품질 검사</li>\n\t\t\t\t\t\t\t<li>번역 워크플로우 설정</li>\n\t\t\t\t\t\t\t<li>자동화 스크립트 생성</li>\n\t\t\t\t\t\t\t<li>그 외에도 많은 것들!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>함께 번역 작업을 더 쉽고 효율적으로 만들어 봅시다!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. 저는 아직 초보자라서, 조금만 기다려 주세요.🙇‍♀️ 하지만 매일 배우고 발전하고 있습니다!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","AI 구성"],["Model Endpoint","모델 엔드포인트"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","AI 모델에 대한 API 엔드포인트 URL입니다. 예: https://api.openai.com/v1/chat/completions"],["API Key","API 키"],["Your API key for authenticating with the AI service. This will be stored securely.","AI 서비스와 인증하기 위한 API 키입니다. 안전하게 저장됩니다."],["Model Name","모델 이름"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","사용할 AI 모델을 선택하거나 입력하세요. 도구 지원이 있는 모델이 최상의 결과를 위해 권장됩니다."],["File Association","파일 연결"],["Extension","확장자"],["Associate","연결"],["Set All","모두 설정"],["Unset All","모두 해제"],["Apply","적용"],["Update","업데이트"],["Auto update","자동 업데이트"],["Automatically update Translator++ if possible.","가능한 경우 Translator++를 자동으로 업데이트합니다."],["Allow reinstall the same version","동일 버전 재설치 허용"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Translator++가 이미 설치된 동일 버전을 재설치하도록 허용합니다. 업데이트를 설치한 후에는 특히 <b>자동 업데이트</b> 설정이 켜져 있을 때 이 옵션을 비활성화된 상태로 유지하세요. 그렇지 않으면 프로그램을 열 때마다 Translator++가 계속해서 자체 업데이트를 시도합니다."],["Use default browser to login","기본 브라우저로 로그인"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","신뢰할 수 있는 시스템의 기본 브라우저를 사용하여 Patreon 계정에 로그인합니다. 이 옵션이 선택되지 않으면 Translator++의 내장 브라우저가 사용됩니다."],["Multi threading","멀티 스레딩"],["Number of thread","스레드 수"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","동시에 열리는 자식 프로세스의 수입니다.<br>\n\t\t\t\t\t\t\t0 = 멀티 스레딩 비활성화. 모든 프로세스는 렌더러 프로세스에서 처리됩니다.<br>\n\t\t\t\t\t\t\t최적의 수는 일반적으로 물리적 코어 수 - 1입니다.\n\t\t\t\t\t\t"],["Backup","백업"],["Enable backup","백업 활성화"],["Automatically create backup every time you save your project.","프로젝트를 저장할 때마다 자동으로 백업을 생성합니다."],["Backup level history","백업 레벨 기록"],["How many history of backup do you want to keep?","유지하려는 백업 기록의 수는 얼마입니까?"],["Log &amp; Debugging","로그 &amp; 디버깅"],["Log to file","파일에 로그"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","기본 콘솔 창 대신 파일에 로그를 기록합니다.<br>콘솔 창에 접근할 수 없는 상태에서 Translator++를 디버깅하려는 경우 유용합니다. 이 옵션을 활성화하면 성능이 약간 저하될 수 있습니다. 따라서 디버깅이나 문제 보고 시를 제외하고는 항상 이 옵션을 끄는 것이 좋습니다.<br>로그는 data/logs/ 폴더에 저장됩니다."],["Truncate log file each session","세션마다 로그 파일 자르기"],["When checked your log file will be truncated each time you re open the application.","체크 시 애플리케이션을 다시 열 때마다 로그 파일이 잘립니다."],["Application Settings","애플리케이션 설정"],["Enable remote debugging","원격 디버깅 활성화"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","9222번 포트에서 Chrome DevTools 원격 디버깅 프로토콜을 활성화합니다. 이를 통해 <code>chrome://inspect</code>로 이동하여 외부 브라우저로 Translator++를 검사하고 디버깅할 수 있습니다. 이 플래그는 애플리케이션 시작 인수에 <code>--remote-debugging-port=9222</code>를 추가합니다. 변경을 적용하려면 재시작이 필요합니다."],["Disable GPU","GPU 비활성화"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","하드웨어 GPU 가속을 비활성화합니다. 특정 그래픽 하드웨어나 드라이버에서 시각적 결함, 충돌 또는 렌더링 문제가 발생할 때 유용합니다. 이 플래그는 애플리케이션 시작 인수에 <code>--disable-gpu</code>를 추가합니다. 변경을 적용하려면 재시작이 필요합니다."],["Dangerous Area","위험 구역"],["Interface Language","인터페이스 언어"],["UI Language","UI 언어"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","사용자 인터페이스의 언어를 설정합니다. Translator++가 사용자의 언어로 제공되지 않으면 직접 현지화를 만들 수 있습니다. 언어 데이터는 www/lang 폴더 안에 있습니다."],["Spell checker Language","맞춤법 검사 언어"],["Set the default spell checker language.","기본 맞춤법 검사 언어를 설정합니다."],["Environment Variables","환경 변수"],["Staging Directory","스테이징 디렉토리"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","스테이징 디렉토리는 작업 중인 프로젝트의 하드 캐시입니다. 원자재 데이터의 일부가 이 디렉토리에 복사되어 인터프리터 스크립트에서 접근할 수 있습니다."],["Project creation","프로젝트 생성"],["Auto Load Common Reference","공통 참조 자동 로드"],["Auto load common reference from .trans file.",".trans 파일에서 공통 참조를 자동으로 로드합니다."],["Project settings","프로젝트 설정"],["Progress Column Indices","진행률 열 인덱스"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","여기서 프로젝트의 진행률 계산에 포함될 열을 지정할 수 있습니다.\n\t\t\t\t\t\t\t<br>열 인덱스는 0부터 시작하는 정수이며, 가장 왼쪽 열이 0입니다.\n\t\t\t\t\t\t\t<br>여러 열을 지정하려면 쉼표를 사용하세요. 예: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>기본값: 비어 있음</b>. 비워 두면 Translator++는 사용 가능한 모든 열에서 진행률을 계산합니다.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>활성화/비활성화"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>설치"],["Install from a package","패키지에서 설치"],["Visit our website &amp; documentation : ","웹사이트 및 문서 방문 : "],["Fork Translator++ at : ","Translator++ 포크 : "],["Support Translator++ at : ","Translator++ 지원 : "],["Join our discord channel at : ","디스코드 채널 참여 : "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) 후원자라면 <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">Patreon 프로필에서 디스코드 계정을 연결</a>해야 합니다. 자동으로 초대되며 혜택이 기다리고 있습니다!"],["Version Info","버전 정보"],["Last checked at : ","마지막 확인 시간 : "],["Check now!","지금 확인!"],["You have a pending update","보류 중인 업데이트가 있습니다"],["Update now","지금 업데이트"],["Your Translator++ is up to date 😃.","Translator++가 최신 상태입니다 😃."],["Architecture","아키텍처"],["License","라이선스"],["Click here to read the license.","라이선스를 읽으려면 여기를 클릭하세요."],["Credits","크레딧"],["Localization","로컬라이제이션"],["About Third Party Software","제3자 소프트웨어 정보"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\t이 소프트웨어는 /3rdParty에 위치한 제3자 소프트웨어를 사용하고 있습니다. 이러한 제3자 소프트웨어는 각자의 라이선스를 보유하며, \n\t\t\t\t사용 편의를 위해 포함되었으며, \n\t\t\t\t명시적 또는 묵시적 보증 없이 \"있는 그대로\" 제공되며, 해당 소프트웨어는 사용자의 책임 하에 사용됩니다.\n\t\t\t\t"],["Special Thanks","특별 감사"],["Want to explicitly support Translator++ by putting your name on this section?","이 섹션에 이름을 올려 Translator++를 명시적으로 지원하고 싶으신가요?"],["Click here to learn more about how to do that!","그 방법에 대해 더 알아보려면 여기를 클릭하세요!"],["Changelog","변경 로그"],["Feeds","피드"],["Click connect button, to connect translator with Translator++ table","번역기와 Translator++ 테이블을 연결하려면 연결 버튼을 클릭하세요"],["working","작업 중"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Patreon 등급/이번 달 현재 후원 금액(센트 단위, 1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","포인트/평생 후원 금액+보너스(센트 단위, 1 USD = 100 pts)"],["Filter...","필터..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":true,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"parameters":[]},"/scriptEditor.html":{"data":[["Run","실행"],["New Project (ctrl+n)","새 프로젝트 (ctrl+n)"],["Open (ctrl+o)","열기 (ctrl+o)"],["Save file (ctrl+s)","파일 저장 (ctrl+s)"],["Save As (ctrl+shift+s)","다른 이름으로 저장 (ctrl+shift+s)"],["Open debugger (F12)","디버거 열기 (F12)"],["Help","도움말"],["Select file in the current workspace","현재 작업 공간에서 파일 선택"],["file path","파일 경로"],["Create shortcut of the current script","현재 스크립트의 바로 가기 생성"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":true,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"parameters":[]},"/tableEditor.html":{"data":[["Reset","초기화"],["Clear","지우기"],["Search","검색"],["Help","도움말"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":true,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"parameters":[]},"/trans.html":{"data":[["Start","시작"],["Home","홈"],["Translator","번역기"],["Objects","객체"],["Live translation","실시간 번역"],["Original","원본"],["Raw","원시"],["Row Properties","행 속성"],["Default translation","기본 번역"],["Context translation","컨텍스트 번역"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\t경로 <a class=\"problemPath\"></a>는 PHP 인터프리터가 접근할 수 없습니다.<br>\n\t\t경로 이름을 변경하고 영숫자 이름만 사용해 주세요.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>위치</span>"],["File :","파일 :"],["Row ID :","행 ID :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>컨텍스트</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>배우</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>키 텍스트</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>최고 번역</span>"],["File ID","파일 ID"],["Path","경로"],["Original Format","원본 형식"],["Data Length","데이터 길이"],["Translated","번역됨"],["General","일반"],["Language","언어"],["Staging","스테이징"],["Stats","통계"],["Advanced","고급"],["Info","정보"],["Title","제목"],["File Location","파일 위치"],["Project ID","프로젝트 ID"],["Built on","빌드 날짜"],["Editor Name","편집기 이름"],["Editor Version","편집기 버전"],["Engine","엔진"],["Parser","파서"],["Parser version","파서 버전"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","원본 자료 위치 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"원본 자료의 위치입니다. 이 폴더 내의 내용은 수정하지 마세요.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> 잘못된 경로입니다.<br>이 문제가 해결될 때까지 일부 기능이 비활성화됩니다."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","번역 자료 위치 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"번역된 게임의 위치입니다. 번역 주입의 기본 위치입니다.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","번역기 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"이 프로젝트에 선호하는 번역기입니다. 정의되지 않으면 전역 설정이 사용됩니다.\"></i>"],["Translate From","번역 출처"],["Translate Into","번역 대상"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","스테이징 경로 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"스테이징 경로는 번역 내보내기/빌드에 필요한 일부 파일의 위치입니다. 프로젝트를 생성할 때 생성된 스테이징 파일입니다.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","객체 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"왼쪽 창에서 사용 가능한 객체/파일 수\"></i>"],["Folders","폴더"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","문자 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"원본 텍스트 열의 문자 수\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","단어 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"공백을 사용하지 않는 언어(예: 일본어, 중국어)에서는 잘못된 값이 표시될 수 있습니다.\"></i>"],["Total Rows","총 행 수"],["Translated row","번역된 행"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","유기적 번역 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"사용자가 그리드에 직접 입력한 번역입니다. 좋은 신호입니다. 인간 번역일 수도 있고, 편집된 MTL일 수도 있습니다.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","전체 진행률 <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","내보내기 후 실행<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"이 프로젝트가 성공적으로 내보내진 후 자바스크립트 함수를 실행합니다.\"></i>"],["Display this information when the project is opened.","프로젝트가 열릴 때 이 정보를 표시합니다."],["Select Export Mode","내보내기 모드 선택"],["Export to a folder","폴더로 내보내기"],["Export pre-compiled game data to a folder<br>Folder structures are retained","미리 컴파일된 게임 데이터를 폴더로 내보내기<br>폴더 구조가 유지됩니다"],["Export as a Zip file","Zip 파일로 내보내기"],["Export pre-compiled game data to a single zipped archive","미리 컴파일된 게임 데이터를 단일 압축 아카이브로 내보내기"],["RPGMakerTrans Patch Files","RPGMakerTrans 패치 파일"],["Export to RPGMakerTrans formatted *.txt files in a folder","폴더에 RPGMakerTrans 형식의 *.txt 파일로 내보내기"],["Comma Separated Values","쉼표로 구분된 값"],["Export to Comma Separated Values (csv) files in a folder","폴더에 쉼표로 구분된 값(csv) 파일로 내보내기"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 이상"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","폴더에 Microsoft Excel 스프레드시트(xlsx) 파일로 내보내기"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 이상"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","폴더에 Microsoft Excel 스프레드시트(xls) 파일로 내보내기"],["HTML Spreadsheet","HTML 스프레드시트"],["Export to HTML files in a folder","폴더에 HTML 파일로 내보내기"],["Open Document Format/OASIS (.ods)","Open Document Format/OASIS (.ods)"],["Export to ODS files in a folder","폴더에 ODS 파일로 내보내기"],["Select Import Mode","가져오기 모드 선택"],["Import translation from another .trans file","다른 .trans 파일에서 번역 가져오기"],["Open another Translator++ file<br>Apply translation into current project.","다른 Translator++ 파일 열기<br>현재 프로젝트에 번역 적용"],["Import translation from spreadsheets","스프레드시트에서 번역 가져오기"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","다양한 스프레드시트 파일에서 번역 가져오기<br>(.xls, .xlsx, .ods, .html, .xml 등)"],["Import translation from RPGMakerTrans Patch format","RPGMakerTrans 패치 형식에서 번역 가져오기"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","RPGMaker Trans의 패치 파일에서 번역 가져오기<br>(.txt)"],["Source :","소스 :"],["Select objects to import","가져올 객체 선택"],["Import mode :","가져오기 모드 :"],["Import translations","번역 가져오기"],["Import data object","데이터 객체 가져오기"],["Destination :","목적지 :"],["Currently selected : ","현재 선택됨 : "],["Options :","옵션 :"],["Import the context translations","컨텍스트 번역 가져오기"],["Case insensitive","대소문자 구분 안 함"],["Overwrite target","대상 덮어쓰기"],["Destination column : ","목적지 열 : "],["Translation mode :","번역 모드 :"],["Row by row translation","행 단위 번역"],["Line by line translation","줄 단위 번역"],["Select translation by context address","컨텍스트 주소로 번역 선택"],["Just copy translation into the same row (No checking)","동일 행에 번역 복사 (검사 없음)"],["Merge data","데이터 병합"],["Import translation from spreadsheet into project","스프레드시트에서 프로젝트로 번역 가져오기"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","모든 스프레드시트 형식(xls, xlsx, odx, html, csv 등)에서 번역 가져오기"],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>스프레드시트는 최소 2개의 열이 있어야 합니다.</b> 가장 중요한 열은 원본 텍스트가 포함된 첫 번째 열(가장 왼쪽 열)입니다. 다음 열에는 번역이 포함됩니다. Translator++는 비어 있지 않은 가장 오른쪽 셀의 텍스트를 사용합니다."],["Please click the radio button to select files/folder to import","가져올 파일/폴더를 선택하려면 라디오 버튼을 클릭하세요"],["Import file(s)","파일 가져오기"],["Import folder","폴더 가져오기"],["Import translation from RPG Maker Trans into project","RPG Maker Trans에서 프로젝트로 번역 가져오기"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">프로젝트 유형 선택</span>"],["Select project type","프로젝트 유형 선택"],["Spreadsheet","스프레드시트"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","스프레드시트 데이터(xls, xlsx, ods, xml, html, sylk, gnumeric, csv)에서 번역 프로젝트 시작"],["Blank project","빈 프로젝트"],["Create a new .trans file from scratch.","처음부터 새 .trans 파일 생성"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">스프레드시트</span>"],["Fetch type","가져오기 유형"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","첫 번째 열은 번역 가능한 텍스트이고, 나머지 열은 미리 정의된 번역입니다 (원본 테이블과 일치하는 그리드 데이터를 생성하세요)"],["All columns are translatable text","모든 열은 번역 가능한 텍스트입니다"],["Custom","사용자 정의"],["Custom Options","사용자 정의 옵션"],["Which column do you want to fetch?","어떤 열을 가져오시겠습니까?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","가져올 열과 번역을 넣을 열을 지정해 주세요. <b>0 기반 인덱스입니다 (첫 번째 열은 0)</b>."],["Column to be translated","번역할 열"],["Column to put translation into","번역을 넣을 열"],["Action","작업"],["Enable Row Header Text Column","행 헤더 텍스트 열 활성화"],["If enabled, the parser will process the following Row Header Text Column rule","활성화하면 파서가 다음 행 헤더 텍스트 열 규칙을 처리합니다"],["Row Header Text Column","행 헤더 텍스트 열"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","지정된 경우, 이 열의 값이 행 헤더에 적용됩니다. 현재 화자나 배우 등을 결정하는 데 유용합니다. 0 기반 인덱스입니다."],["Options","옵션"],["Calculate cell value","셀 값 계산"],["Cell value in the form of formula will be transpiled","수식 형태의 셀 값이 변환됩니다"],["Get formatted value","서식이 적용된 값 가져오기"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","서식 적용 후 셀 값을 처리합니다. (예: 특정 로케일에서 정수 100000은 USD 100,000이 됩니다)"],["Parse CSV in EXCEL format","EXCEL 형식으로 CSV 파싱"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","파서가 MS EXCEL 방식으로 CSV를 파싱하도록 강제합니다. (CSV 파일 전용)"],["Skip the first <i>n</i> row(s)","처음 <i>n</i> 행 건너뛰기"],["Use this option if you want to skip the row header.","행 헤더를 건너뛰려면 이 옵션을 사용하세요."],["Select File(s)","파일 선택"],["Select a directory","디렉토리 선택"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">새로운 Trans 파일 생성</span>"],["Create a new Trans file","새로운 Trans 파일 생성"],["The title of this project","이 프로젝트의 제목"],["Engine type","엔진 유형"],["Type of the engine","엔진의 유형"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">곧 다가올 멋진 것을 위한 자리표시자!</span>"],["Placeholder for something great at the near future!","곧 다가올 멋진 것을 위한 자리표시자!"],["This module will be created when the patron count reach 500!","이 모듈은 후원자 수가 500명에 도달하면 생성됩니다!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\t동일한 제목의 프로젝트 <br>\"<span class=\"dialogGameTitle\"></span>\"<br>이(가) 이미 사후 처리된 캐시에 존재합니다.<br>\n\t\t이 캐시를 재사용하면 로딩 시간을 크게 단축할 수 있습니다.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","혼란스러우면 언제든지 안전하게 <strong><a href=\"#\">\"새 프로젝트 생성\"</a></strong> 버튼을 클릭하세요."],["Existed cache","기존 캐시"],["Select Translator","번역기 선택"],["Source column","소스 열"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","어떤 열이 번역할 소스 텍스트인가요?<br>(기본값은 키 열 / 가장 왼쪽 열입니다)."],["Target column","대상 열"],["Which column is the translated text put into.<br>(Can not same with source column)","어떤 열에 번역된 텍스트를 넣을까요?<br>(소스 열과 같을 수 없습니다)."],["Translator's Options","번역기 옵션"],["Also try to translate other object","다른 객체도 번역 시도"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","이 옵션이 선택되면 Translator++는 기계 번역이 필요하지 않은 선택하지 않은 다른 객체도 번역하려고 시도합니다. 이는 Translator++ 버전 2.3.23 이하의 기본 동작입니다."],["Ignore if already translated","이미 번역된 경우 무시"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","이 옵션이 선택되면 Translator++는 해당 열에 이미 번역이 있는 행을 무시합니다."],["Overwrite cells","셀 덮어쓰기"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","대상 셀을 덮어씁니다. 선택하지 않으면 비어 있지 않은 셀은 건드리지 않습니다."],["Save project on each batch.","각 배치마다 프로젝트 저장"],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","각 배치 완료 시 프로젝트를 저장합니다.<br>이 옵션은 로컬 번역기 애플리케이션에서 무거운 작업 실행으로 인해 애플리케이션이 충돌할 때 데이터 손실을 방지하기 위한 것입니다. 클라우드 기반 번역기를 사용 중이라면 필요하지 않을 수 있습니다."],["Play sound when completed.","완료 시 소리 재생"],["Tags","태그"],["Select Context(s)","컨텍스트 선택"],["Manual Query","수동 쿼리"],["Match all words","모든 단어 일치"],["Remove selected","선택 항목 제거"],["Remove all but selected","선택 항목 외 모두 제거"],["Select Context","컨텍스트 선택"],["Source Column","소스 열"],["Target Column","대상 열"],["Maximum length","최대 길이"],["Export into","내보내기"],["What to do with tagged rows?","태그된 행을 어떻게 처리할까요?"],["Select Color Tag","색상 태그 선택"],["On the fly word wrap","실시간 단어 줄바꿈"],["Inject all files (ignoring selection)","모든 파일 주입 (선택 무시)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","<b>모두 주입</b> 버튼을 통해 번역을 주입하려 합니다. 이는 왼쪽 창에서 선택한 객체와 관계없이 번역을 주입합니다. 선택한 객체를 주입하려면 왼쪽 창의 컨텍스트 메뉴를 사용하세요."],["Select the source material to be translated","번역할 원본 자료 선택"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\t번역하려는 특정 자료나 콘텐츠(예: 파일, 디렉터리 등)를 선택하세요. 선택한 자료가 접근 가능하고 해당 파서에 적절히 형식화되었는지 확인하세요.<br>\n\t\t\t\t기본적으로 일부 파서는 스테이징 디렉터리를 원본 자료로 사용합니다.\n\t\t\t"],["Path is inaccessible.","경로에 접근할 수 없습니다."],["Target Directory","대상 디렉터리"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\t번역된 애플리케이션의 복사본이 이 폴더에 생성됩니다.\n\t\t\t"],["Field can not be empty!","필드를 비워둘 수 없습니다!"],["Target to apply translation","번역을 적용할 대상"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\t실행 파일을 선택하세요.\n\t\t\t"],["Copy materials","자료 복사"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","원본 자료에서 대상 디렉터리로의 복사 옵션입니다. (실험적, 모든 엔진이 지원되지는 않음)"],["Word Wrap by Tags","태그별 단어 줄바꿈"],["Directory name","디렉터리 이름"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\t객체가 이 디렉터리 아래에 그룹화됩니다.<br>\n\t\t\t\t별표 \"<code>*</code>\"를 입력하여 새 <b>참조 객체</b>를 추가하세요.\n\t\t\t"],["Invalid directory  name","잘못된 디렉터리 이름"],["Object name","객체 이름"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\t객체의 이름입니다.\n\t\t\t"],["Invalid object name","잘못된 객체 이름"],["New Project","새 프로젝트"],["Save","저장"],["Save as...","다른 이름으로 저장..."],["Open...","열기..."],["Recent","최근 항목"],["None...","없음..."],["Export Project","프로젝트 내보내기"],["To a folder","폴더로"],["As a zip file","ZIP 파일로"],["To portable .tpp file","휴대용 .tpp 파일로"],["To RPGMakerTrans file (*.txt)","RPGMakerTrans 파일로 (*.txt)"],["To CSV file","CSV 파일로"],["To XLSX file","XLSX 파일로"],["To XLS file","XLS 파일로"],["To ODS file","ODS 파일로"],["To HTML file","HTML 파일로"],["Import","가져오기"],["Project from .tpp file",".tpp 파일에서 프로젝트"],["Translation from .trans file",".trans 파일에서 번역"],["Translation Spreadsheet","번역 스프레드시트"],["Translation RPGMKTRANSPATCH Format","RPGMKTRANSPATCH 형식 번역"],["Automation","자동화"],["Batch translation","일괄 번역"],["Context tool","컨텍스트 도구"],["Batch word wrapping","일괄 줄 바꿈"],["Trim","자르기"],["Auto padding","자동 패딩"],["Tools","도구"],["Third Party Application Installer","서드파티 애플리케이션 설치 프로그램"],["Close project","프로젝트 닫기"],["Exit","종료"],["Start here","여기서 시작"],["Start a New Project","새 프로젝트 시작"],["Continue your work","작업 계속하기"],["Open Project","프로젝트 열기"],["Your recent translation","최근 번역"],["Tips for you","팁"],["Next tip! <span class=\"icon-angle-double-right\"></span>","다음 팁! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","행의 가장 오른쪽 셀이 우선순위를 가집니다."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","번역 파일만으로는 프로젝트를 다른 사람과 공유할 수 없습니다. TPP 파일을 생성해야 합니다."],["Always make backups of your trans files.","항상 번역 파일의 백업을 만드세요."],["You can rename and reorder the column with the coulumn header's context menu.","열 헤더의 컨텍스트 메뉴로 열의 이름을 변경하고 순서를 재정렬할 수 있습니다."],["Always backup your game before working with Translator++!","Translator++ 작업 전에 항상 게임을 백업하세요!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","기능이 정상적으로 작동하지 않는 경우, Translator++를 재시작해 보세요. 대부분의 경우 문제가 해결됩니다."],["Always create a backup of your game before patching with a translation.","번역 패치 전에 항상 게임의 백업을 만드세요."],["Thank you for supporting Translator++.","Translator++를 지원해 주셔서 감사합니다."],["Please check Translator++'s online documentation at","Translator++의 온라인 문서를 확인해 주세요."],["working","작업 중"],["Open","열기"],["Save file","파일 저장"],["Save As","다른 이름으로 저장"],["Import Project","프로젝트 가져오기"],["Inject / apply all translation","모든 번역 주입/적용"],["Execute Global Level Custom Script","전역 수준 사용자 스크립트 실행"],["Toggle Active Cell Info","활성 셀 정보 토글"],["Project Properties","프로젝트 속성"],["Get Help (F1)","도움말 보기 (F1)"],["Batch translation (crl+b)","일괄 번역 (ctrl+b)"],["File list","파일 목록"],["Live Translation Pane","실시간 번역 패널"],["Toggle selection","선택 토글"],["Invert selection","선택 반전"],["Add A New Object","새 객체 추가"],["Connect to auto translator","자동 번역기 연결"],["Undock pane","패널 분리"],["Collapse / restore left panel","왼쪽 패널 접기/복원"],["Add new key (alt+n)","새 키 추가 (alt+n)"],["Import Here","여기로 가져오기"],["Add a note to this file","이 파일에 메모 추가"],["Open search menu","검색 메뉴 열기"],["Toggle grid information","그리드 정보 토글"],["Object Properties","객체 속성"],["Automatically set selected original text to clipboard","선택한 원본 텍스트를 클립보드에 자동 설정"],["Resize Font","글꼴 크기 조정"],["Toggle word wrapping & Explicit white spaces","단어 줄바꿈 및 명시적 공백 토글"],["Use Monospace font","고정폭 글꼴 사용"],["Remove all translation from this file","이 파일에서 모든 번역 제거"],["Remove this file from project","프로젝트에서 이 파일 제거"],["file path","파일 경로"],["Quick find","빠른 찾기"],["Active cell's info","활성 셀 정보"],["View original untranslated text","원본 번역되지 않은 텍스트 보기"],["View raw data","원시 데이터 보기"],["View row properties","행 속성 보기"],["Go to current cell","현재 셀로 이동"],["Current coordinate","현재 좌표"],["Word wraping (for non Japanese text)","단어 줄 바꿈 (비일본어 텍스트용)"],["Speak original text (alt+,)","원본 텍스트 읽기 (alt+,)"],["Copy original text into current cell (ctrl+0)","원본 텍스트를 현재 셀에 복사 (ctrl+0)"],["Default translation for all occurrence","모든 발생에 대한 기본 번역"],["Translations by context","컨텍스트별 번역"],["This cell has a comment","이 셀에 주석이 있음"],["This cell has an organic content","이 셀에 유기적 내용이 있음"],["This cell has been visited","이 셀은 방문됨"],["This is the first time this cell has been visited","이 셀은 처음 방문됨"],["Word wraping","단어 줄 바꿈"],["Speak current translation text (alt+.)","현재 번역 텍스트 읽기 (alt+.)"],["Current Cell Editor options","현재 셀 편집기 옵션"],["Clear context translation for current row","현재 행의 컨텍스트 번역 지우기"],["Get help about translation by context","컨텍스트로 번역 도움말 보기"],["Open menu","메뉴 열기"],["Path not accessible","경로 접근 불가"],["The location of the original material. You should not modify anything inside this folder.","원본 자료의 위치입니다. 이 폴더 내부의 내용은 수정하지 마세요."],["The location of the game that has been translated. The default location of the translation injection.","번역된 게임의 위치입니다. 번역 주입의 기본 위치입니다."],["Prefered translator for this project. If not defined, global setting will be used.","이 프로젝트의 선호 번역기입니다. 정의되지 않은 경우 전역 설정이 사용됩니다."],["-use default-","-기본값 사용-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","스테이징 경로는 번역 내보내기/빌드에 필요한 일부 파일의 위치입니다. 프로젝트 생성 시 생성된 스테이징 파일입니다."],["Number of objects/files available on the left pane","왼쪽 패널에서 사용 가능한 객체/파일 수"],["Number of characters in the Original Text column","원본 텍스트 열의 문자 수"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","공백을 사용하지 않는 언어(예: 일본어, 중국어)에서는 잘못된 값이 표시될 수 있습니다."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","사용자가 그리드에 직접 입력했습니다. 좋은 신호입니다. 인간 번역일 수도 있고, 편집된 MTL일 수도 있습니다."],["Run a javascript function after this project is successfully exported.","이 프로젝트가 성공적으로 내보내진 후 자바스크립트 함수를 실행합니다."],["Import .TRANS into project",".TRANS를 프로젝트로 가져오기"],["Import Spreadsheet Options","스프레드시트 가져오기 옵션"],["Import RPGMTransPatch Options","RPGMTransPatch 가져오기 옵션"],["Start a new project","새 프로젝트 시작"],["Search project type...","프로젝트 유형 검색..."],["Remove row","행 삭제"],["Add row","행 추가"],["Project is exist","프로젝트가 존재합니다"],["Context Tool","컨텍스트 도구"],["Your list of context separated by new line","새 줄로 구분된 컨텍스트 목록"],["Wrap text","텍스트 줄바꿈"],["Export Options","내보내기 옵션"],["Tagging","태깅"],["Apply Translation","번역 적용"],["Add new Object","새 객체 추가"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText","idx/56/innerText"],["idx/29/innerText","idx/152/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText","idx/41/innerText"],["idx/40/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText","idx/106/innerText","idx/113/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText","idx/99/in