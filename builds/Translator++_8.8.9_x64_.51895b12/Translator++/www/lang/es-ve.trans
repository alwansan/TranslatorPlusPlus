información más detallada en la consola (F12)"],["Close","Cerrar"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":true,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"parameters":[]},"/js/ui.parts.js":{"data":[["Form","Formulario"],["Cancel","Cancelar"],["Ok","Ok"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":true,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","Eliminar nota"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/login.html":{"data":[["working","trabajando"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":true,"indexIds":{"working":0},"tags":[],"parameters":[]},"/note.html":{"data":[["Remove note","Eliminar nota"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":true,"indexIds":{"Remove note":0},"tags":[],"parameters":[]},"/options.html":{"data":[["Click to login","Haz clic para iniciar sesión"],["Translator &amp; Language","Traductor e Idioma"],["Proofreader","Corrector de pruebas"],["Assistant","Asistente"],["General","General"],["Preferences","Preferencias"],["Add-ons","Complementos"],["About","Acerca de"],["User Information","Información del usuario"],["Login to your Patreon account to get access to the latest features and updates.","Inicia sesión en tu cuenta de Patreon para acceder a las últimas funciones y actualizaciones."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> Iniciar sesión"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> Iniciar sesión con el navegador"],["Welcome,","Bienvenido,"],["Name","Nombre"],["Email","Correo electrónico"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Nivel <div class=\"infoHeadNote\">(Suscripción actual en centavos de USD)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Puntos <div class=\"infoHeadNote\">(Suscripción total de por vida en centavos de USD)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","Estado del pago <div class=\"infoHeadNote\">(Estado actual del pago)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">¡No entres en pánico!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>Y por favor, lee la siguiente información.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Esta bandera indica que Patreon aún no ha recibido exitosamente los fondos de tu contribución. Es normal que el sistema de pago experimente retrasos. Dependiendo de tu método de pago y país de origen, los retrasos pueden ocurrir hasta por 24 horas.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Durante este retraso, podrías ver un débito en tu tarjeta de crédito. No te preocupes—Patreon reintentará a intervalos regulares para verificar si han recibido tu pago. Esto usualmente se resuelve por sí solo en 24 horas.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Si el problema persiste más allá de este período, por favor publica en el hilo <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> en el servidor de Translator++ en Discord. Te asistiré tanto como sea posible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Por favor, entiende que para prevenir fraudes, <b><span class=\"userInfoPoints\">puntos</span> y <span class=\"userInfoLevel\">Nivel</span> no se contarán hasta que tu pago haya sido recibido exitosamente por Patreon</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">¡No entres en pánico!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","Esta bandera indica que Patreon aún no ha recibido exitosamente los fondos de tu contribución. Es normal que el sistema de pago experimente retrasos. Dependiendo de tu método de pago y país de origen, los retrasos pueden ocurrir hasta por 24 horas."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","Durante este retraso, podrías ver un débito en tu tarjeta de crédito. No te preocupes—Patreon reintentará a intervalos regulares para verificar si han recibido tu pago. Esto usualmente se resuelve por sí solo en 24 horas."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","Si el problema persiste más allá de este período, por favor publica en el hilo <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> en el servidor de Translator++ en Discord. Te asistiré tanto como sea posible."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","Por favor, entiende que para prevenir fraudes, <b><span class=\"userInfoPoints\">puntos</span> y <span class=\"userInfoLevel\">Nivel</span> no se contarán hasta que tu pago haya sido recibido exitosamente por Patreon</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> Cerrar sesión"],["Primary Translator","Traductor Principal"],["Default Translator Engine","Motor de Traducción Predeterminado"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tEste Motor de Traducción se usará cuando presiones <span class=\"keyboardHint\">Ctrl+g</span> en la(s) celda(s) seleccionada(s) para <strong>g</strong>enerar traducción en la celda seleccionada.\n\t\t\t\t"],["Default Language","Idioma Predeterminado"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\t¡La configuración de idioma predeterminada en todos los proyectos!<br>\n\t\t\t\tLa configuración en las propiedades del proyecto anulará este valor.\n\t\t\t"],["Default Source Language","Idioma de Origen Predeterminado"],["Default Target Language","Idioma de Destino Predeterminado"],["Custom escape","Escape Personalizado"],["Patterns","Patrones"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tTodas las palabras que coincidan con el patrón a continuación no serán traducidas por los traductores automáticos. \n\t\t\t\t\t\tEsta sección es adecuada para ocultar etiquetas y scripts de los motores de traducción. <br>\n\t\t\t\t\t\tCada entrada es una expresión regular válida de JavaScript, función, o literal string separada por una <b>coma</b>.<br>\n\t\t\t\t\t\tEl escape personalizado solo funciona para los <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">algoritmos de escape compatibles</a>.\n\t\t\t\t\t\t<b>Sugerencia:</b> También puedes pedirle a ChatGPT que genere expresiones regulares. <br>\n\t\t\t\t\t\tPor favor, escribe el patrón de regex junto con su modificador.<br>\n\t\t\t\t\t\tpor ejemplo:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","Probador"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tPega tu texto aquí para verificar el patrón.\n\t\t\t\t\t\tTodos los patrones coincidentes serán resaltados.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>En Construcción</h2>\n\t\t\t\t<p>Esta área será el lugar donde se configurarán los ajustes y opciones del corrector automático.</p>\n\t\t\t"],["AI Assistant","Asistente de IA"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>¡Hola! Soy MIRAI, tu asistente de IA para Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Solo haz clic en mi ícono <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> en tu menú de Inicio para chatear conmigo. Puedo ayudarte con:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Mejoras y sugerencias de traducción</li>\n\t\t\t\t\t\t\t<li>Corrección y verificación de calidad</li>\n\t\t\t\t\t\t\t<li>Configuración de tu flujo de trabajo de traducción</li>\n\t\t\t\t\t\t\t<li>Creación de scripts de automatización</li>\n\t\t\t\t\t\t\t<li>¡Y mucho más!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>¡Hagamos que tu trabajo de traducción sea más fácil y eficiente juntos!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PD. Todavía soy nueva, así que ten paciencia conmigo.🙇‍♀️ ¡Pero estoy aprendiendo y mejorando cada día!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","Configuración de IA"],["Model Endpoint","Punto Final del Modelo"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","La URL del punto final de la API para tu modelo de IA. Por ejemplo: https://api.openai.com/v1/chat/completions"],["API Key","Clave de API"],["Your API key for authenticating with the AI service. This will be stored securely.","Tu clave de API para autenticarte con el servicio de IA. Esto se almacenará de forma segura."],["Model Name","Nombre del Modelo"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","Selecciona o ingresa el modelo de IA a usar. Se recomiendan modelos con soporte de herramientas para mejores resultados."],["File Association","Asociación de Archivos"],["Extension","Extensión"],["Associate","Asociar"],["Set All","Establecer Todo"],["Unset All","Desmarcar Todo"],["Apply","Aplicar"],["Update","Actualizar"],["Auto update","Actualización automática"],["Automatically update Translator++ if possible.","Actualizar Translator++ automáticamente si es posible."],["Allow reinstall the same version","Permitir reinstalar la misma versión"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Permitir que Translator++ reinstale la misma versión que ya está instalada. Por favor, mantén esta opción desactivada después de instalar la actualización, especialmente cuando tu configuración de <b>Actualización automática</b> está activada. De lo contrario, Translator++ seguirá actualizándose cada vez que abras el programa."],["Use default browser to login","Usar navegador predeterminado para iniciar sesión"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","Usa el navegador predeterminado de confianza de tu sistema para iniciar sesión en tu cuenta de Patreon. A menos que esta opción esté marcada, se usará el navegador integrado de Translator++."],["Multi threading","Multihilo"],["Number of thread","Número de hilos"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","El número de procesos secundarios que se abren simultáneamente.<br>\n\t\t\t\t\t\t\t0 = deshabilitar multihilo. Todos los procesos los hará el proceso de renderizado.<br>\n\t\t\t\t\t\t\tLa cantidad óptima suele ser el número de tus núcleos físicos - 1.\n\t\t\t\t\t\t"],["Backup","Copia de seguridad"],["Enable backup","Habilitar copia de seguridad"],["Automatically create backup every time you save your project.","Crear automáticamente una copia de seguridad cada vez que guardes tu proyecto."],["Backup level history","Historial de niveles de copia de seguridad"],["How many history of backup do you want to keep?","¿Cuántos historiales de copia de seguridad quieres conservar?"],["Log &amp; Debugging","Registro y Depuración"],["Log to file","Registrar en archivo"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","Registrar en un archivo en lugar de la ventana de consola predeterminada.<br>Esto es útil si quieres depurar Translator++ y no tienes acceso a la ventana de consola. Habilitar esta opción afectará ligeramente el rendimiento. Por lo tanto, debes mantener esta opción desactivada todo el tiempo, excepto cuando estés depurando o reportando problemas.<br>Los registros se guardan en la carpeta data/logs/."],["Truncate log file each session","Truncar archivo de registro cada sesión"],["When checked your log file will be truncated each time you re open the application.","Cuando está marcado, tu archivo de registro se truncará cada vez que vuelvas a abrir la aplicación."],["Application Settings","Configuración de la aplicación"],["Enable remote debugging","Habilitar depuración remota"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","Habilita el protocolo de depuración remota de Chrome DevTools en el puerto 9222. Esto te permite inspeccionar y depurar Translator++ usando un navegador externo navegando a <code>chrome://inspect</code>. Esta bandera añade <code>--remote-debugging-port=9222</code> a los argumentos de inicio de la aplicación. Se requiere reiniciar para aplicar los cambios."],["Disable GPU","Deshabilitar GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","Deshabilita la aceleración de GPU por hardware. Esto es útil si experimentas fallos visuales, cierres inesperados o problemas de renderizado en ciertos hardware gráficos o controladores. Esta bandera añade <code>--disable-gpu</code> a los argumentos de inicio de la aplicación. Se requiere reiniciar para aplicar los cambios."],["Dangerous Area","Área peligrosa"],["Interface Language","Idioma de la interfaz"],["UI Language","Idioma de la UI"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","Establece el idioma de la interfaz de usuario. Puedes crear tu propia localización si Translator++ no está disponible en tu idioma. Los datos de idioma se encuentran dentro de la carpeta www/lang."],["Spell checker Language","Idioma del corrector ortográfico"],["Set the default spell checker language.","Establece el idioma predeterminado del corrector ortográfico."],["Environment Variables","Variables de entorno"],["Staging Directory","Directorio de ensayo"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","El directorio de ensayo es una caché dura de proyectos en los que se está trabajando. Una porción de los datos de las materias primas se copia a este directorio para ser accedida por los scripts del intérprete."],["Project creation","Creación de proyecto"],["Auto Load Common Reference","Cargar automáticamente referencia común"],["Auto load common reference from .trans file.","Carga automáticamente la referencia común desde el archivo .trans."],["Project settings","Configuración del proyecto"],["Progress Column Indices","Índices de Columnas de Progreso"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","Aquí, puedes especificar qué columnas se incluirán en el cálculo del progreso del proyecto.\n\t\t\t\t\t\t\t<br>El índice de columna es un entero basado en cero, donde la columna más a la izquierda es 0.\n\t\t\t\t\t\t\t<br>Usa comas para especificar múltiples columnas. Por ejemplo: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Por defecto: En blanco</b>. Si se deja en blanco, Translator++ calculará el progreso de todas las columnas disponibles.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>Activar/Desactivar"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>Instalar"],["Install from a package","Instalar desde un paquete"],["Visit our website &amp; documentation : ","Visita nuestro sitio web y documentación: "],["Fork Translator++ at : ","Bifurca Translator++ en: "],["Support Translator++ at : ","Apoya a Translator++ en: "],["Join our discord channel at : ","Únete a nuestro canal de Discord en: "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) Si eres patrocinador, debes <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">vincular tu cuenta de Discord en tu perfil de Patreon</a>. Serás invitado automáticamente, ¡y hay beneficios esperándote!"],["Version Info","Información de Versión"],["Last checked at : ","Última verificación: "],["Check now!","¡Verificar ahora!"],["You have a pending update","Tienes una actualización pendiente"],["Update now","Actualizar ahora"],["Your Translator++ is up to date 😃.","Tu Translator++ está actualizado 😃."],["Architecture","Arquitectura"],["License","Licencia"],["Click here to read the license.","Haz clic aquí para leer la licencia."],["Credits","Créditos"],["Localization","Localización"],["About Third Party Software","Acerca del Software de Terceros"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tEste software utiliza programas de terceros ubicados en /3rdParty. Estos programas de terceros tienen sus propias licencias y \n\t\t\t\tse incluyen únicamente por conveniencia de uso y \n\t\t\t\tse proporcionan “tal cual” sin garantía de ningún tipo, ya sea expresa o implícita, y dicho software debe usarse bajo su propio riesgo.\n\t\t\t\t"],["Special Thanks","Agradecimientos Especiales"],["Want to explicitly support Translator++ by putting your name on this section?","¿Quieres apoyar explícitamente a Translator++ poniendo tu nombre en esta sección?"],["Click here to learn more about how to do that!","¡Haz clic aquí para aprender más sobre cómo hacerlo!"],["Changelog","Registro de Cambios"],["Feeds","Fuentes"],["Click connect button, to connect translator with Translator++ table","Haz clic en el botón conectar, para conectar el traductor con la tabla de Translator++"],["working","trabajando"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Nivel de Patreon/Tu contribución actual este mes en centavos (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","Puntos/Tu contribución de por vida+bonificaciones en centavos (1 USD = 100 pts)"],["Filter...","Filtrar..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":true,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"parameters":[]},"/scriptEditor.html":{"data":[["Run","Ejecutar"],["New Project (ctrl+n)","Nuevo Proyecto (ctrl+n)"],["Open (ctrl+o)","Abrir (ctrl+o)"],["Save file (ctrl+s)","Guardar archivo (ctrl+s)"],["Save As (ctrl+shift+s)","Guardar Como (ctrl+shift+s)"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ayuda"],["Select file in the current workspace","Seleccionar archivo en el espacio de trabajo actual"],["file path","ruta del archivo"],["Create shortcut of the current script","Crear acceso directo del script actual"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":true,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"parameters":[]},"/tableEditor.html":{"data":[["Reset","Reiniciar"],["Clear","Limpiar"],["Search","Buscar"],["Help","Ayuda"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":true,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"parameters":[]},"/trans.html":{"data":[["Start","Iniciar"],["Home","Inicio"],["Translator","Traductor"],["Objects","Objetos"],["Live translation","Traducción en vivo"],["Original","Original"],["Raw","Crudo"],["Row Properties","Propiedades de la fila"],["Default translation","Traducción por defecto"],["Context translation","Traducción contextual"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\tLa ruta <a class=\"problemPath\"></a> no es accesible por el intérprete PHP.<br>\n\t\tPor favor, renombra la ruta y usa solo nombres alfanuméricos.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>Ubicación</span>"],["File :","Archivo :"],["Row ID :","ID de Fila :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>Contexto</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>Actores</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>Texto Clave</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>Mejor Traducción</span>"],["File ID","ID de Archivo"],["Path","Ruta"],["Original Format","Formato Original"],["Data Length","Longitud de Datos"],["Translated","Traducido"],["General","General"],["Language","Idioma"],["Staging","Preparación"],["Stats","Estadísticas"],["Advanced","Avanzado"],["Info","Información"],["Title","Título"],["File Location","Ubicación del Archivo"],["Project ID","ID del Proyecto"],["Built on","Construido en"],["Editor Name","Nombre del Editor"],["Editor Version","Versión del Editor"],["Engine","Motor"],["Parser","Analizador"],["Parser version","Versión del analizador"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","Ubicación del Material Original <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"La ubicación del material original. No deberías modificar nada dentro de esta carpeta.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Ruta inválida.<br>Algunas funciones estarán deshabilitadas hasta que esto se solucione."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","Ubicación del Material Traducido <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"La ubicación del juego que ha sido traducido. La ubicación predeterminada para la inyección de la traducción.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","Traductor <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Traductor preferido para este proyecto. Si no está definido, se usará la configuración global.\"></i>"],["Translate From","Traducir Desde"],["Translate Into","Traducir A"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","Ruta de Preparación <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"La ruta de preparación es la ubicación de algunos archivos necesarios para exportar/construir traducciones. Los archivos de preparación se generan cuando creas el proyecto.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","Objetos <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Número de objetos/archivos disponibles en el panel izquierdo\"></i>"],["Folders","Carpetas"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","Caracteres <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Número de caracteres en la columna de Texto Original\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","Palabras <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Puede mostrar un valor incorrecto en idiomas que no usan espacios (ej. japonés, chino).\"></i>"],["Total Rows","Filas Totales"],["Translated row","Fila traducida"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Traducción orgánica <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Los usuarios llenaron directamente en la cuadrícula. Lo cual es una buena señal. Puede ser traducción humana, MTL editado, etc.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","Progreso general <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","Ejecutar después de exportar<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Ejecutar una función de javascript después de que este proyecto se exporte exitosamente.\"></i>"],["Display this information when the project is opened.","Mostrar esta información cuando se abra el proyecto."],["Select Export Mode","Seleccionar modo de exportación"],["Export to a folder","Exportar a una carpeta"],["Export pre-compiled game data to a folder<br>Folder structures are retained","Exportar datos del juego precompilados a una carpeta<br>Las estructuras de carpetas se mantienen"],["Export as a Zip file","Exportar como un archivo Zip"],["Export pre-compiled game data to a single zipped archive","Exportar datos del juego precompilados a un único archivo comprimido"],["RPGMakerTrans Patch Files","Archivos de parche RPGMakerTrans"],["Export to RPGMakerTrans formatted *.txt files in a folder","Exportar a archivos *.txt con formato RPGMakerTrans en una carpeta"],["Comma Separated Values","Valores separados por comas"],["Export to Comma Separated Values (csv) files in a folder","Exportar a archivos de Valores Separados por Comas (csv) en una carpeta"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 y superior"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","Exportar a archivos de Hoja de Cálculo de Microsoft Excel (xlsx) en una carpeta"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 y superior"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","Exportar a archivos de Hoja de Cálculo de Microsoft Excel (xls) en una carpeta"],["HTML Spreadsheet","Hoja de cálculo HTML"],["Export to HTML files in a folder","Exportar a archivos HTML en una carpeta"],["Open Document Format/OASIS (.ods)","Formato de Documento Abierto/OASIS (.ods)"],["Export to ODS files in a folder","Exportar a archivos ODS en una carpeta"],["Select Import Mode","Seleccionar modo de importación"],["Import translation from another .trans file","Importar traducción desde otro archivo .trans"],["Open another Translator++ file<br>Apply translation into current project.","Abrir otro archivo de Translator++<br>Aplicar traducción al proyecto actual."],["Import translation from spreadsheets","Importar traducción desde hojas de cálculo"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","Importar traducción desde varios archivos de hojas de cálculo<br>(.xls, .xlsx, .ods, .html, .xml, etc.)"],["Import translation from RPGMakerTrans Patch format","Importar traducción desde formato de parche RPGMakerTrans"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","Importar traducción desde archivos de parche de RPGMaker Trans<br>(.txt)"],["Source :","Fuente :"],["Select objects to import","Seleccionar objetos para importar"],["Import mode :","Modo de importación :"],["Import translations","Importar traducciones"],["Import data object","Importar objeto de datos"],["Destination :","Destino :"],["Currently selected : ","Seleccionado actualmente : "],["Options :","Opciones :"],["Import the context translations","Importar las traducciones de contexto"],["Case insensitive","Insensible a mayúsculas"],["Overwrite target","Sobrescribir destino"],["Destination column : ","Columna de destino : "],["Translation mode :","Modo de traducción :"],["Row by row translation","Traducción fila por fila"],["Line by line translation","Traducción línea por línea"],["Select translation by context address","Seleccionar traducción por dirección de contexto"],["Just copy translation into the same row (No checking)","Solo copiar traducción en la misma fila (Sin verificación)"],["Merge data","Combinar datos"],["Import translation from spreadsheet into project","Importar traducción desde hoja de cálculo al proyecto"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","Importar traducción desde cualquier formato de hoja de cálculo (xls, xlsx, odx, html, csv, etc)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>La hoja de cálculo debe tener al menos 2 columnas.</b> La columna más importante es la primera columna (la más a la izquierda) que contiene los textos originales. Las siguientes columnas contienen las traducciones. Translator++ usará el texto en la celda más a la derecha que no esté vacía."],["Please click the radio button to select files/folder to import","Por favor, haga clic en el botón de radio para seleccionar archivos/carpeta a importar"],["Import file(s)","Importar archivo(s)"],["Import folder","Importar carpeta"],["Import translation from RPG Maker Trans into project","Importar traducción desde RPG Maker Trans al proyecto"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">Seleccionar tipo de proyecto</span>"],["Select project type","Seleccionar tipo de proyecto"],["Spreadsheet","Hoja de cálculo"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","Iniciar un proyecto de traducción desde datos de hoja de cálculo (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","Proyecto en blanco"],["Create a new .trans file from scratch.","Crear un nuevo archivo .trans desde cero."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Hoja de cálculo</span>"],["Fetch type","Tipo de obtención"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","Las primeras columnas son texto traducible, el resto de las columnas son traducciones predefinidas (Crea datos de cuadrícula que coincidan con la tabla original)"],["All columns are translatable text","Todas las columnas son texto traducible"],["Custom","Personalizado"],["Custom Options","Opciones Personalizadas"],["Which column do you want to fetch?","¿Qué columna quieres obtener?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","Por favor especifica qué columna quieres obtener y en qué columna quieres poner la traducción. <b>Es un índice basado en 0 (la primera columna es 0)</b>."],["Column to be translated","Columna a traducir"],["Column to put translation into","Columna para poner la traducción"],["Action","Acción"],["Enable Row Header Text Column","Habilitar Columna de Texto de Encabezado de Fila"],["If enabled, the parser will process the following Row Header Text Column rule","Si está habilitado, el analizador procesará la siguiente regla de Columna de Texto de Encabezado de Fila"],["Row Header Text Column","Columna de Texto de Encabezado de Fila"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","Si se especifica, el valor en esta columna se aplicará al encabezado de la fila. Esto es útil para determinar el hablante o actor actual, etc. Es un índice basado en cero."],["Options","Opciones"],["Calculate cell value","Calcular valor de celda"],["Cell value in the form of formula will be transpiled","El valor de celda en forma de fórmula será transpilado"],["Get formatted value","Obtener valor formateado"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","Procesar valores de celda después del formateo. (Por ejemplo, el entero 100000 en cierta localidad se convertirá en USD 100,000)"],["Parse CSV in EXCEL format","Analizar CSV en formato EXCEL"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","Forzar al analizador a analizar CSV a la manera de MS EXCEL. (solo para archivos CSV)"],["Skip the first <i>n</i> row(s)","Saltar las primeras <i>n</i> fila(s)"],["Use this option if you want to skip the row header.","Usa esta opción si quieres saltar el encabezado de la fila."],["Select File(s)","Seleccionar Archivo(s)"],["Select a directory","Seleccionar un directorio"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Crear un nuevo archivo Trans</span>"],["Create a new Trans file","Crear un nuevo archivo Trans"],["The title of this project","El título de este proyecto"],["Engine type","Tipo de motor"],["Type of the engine","Tipo del motor"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">¡Marcador de posición para algo genial en un futuro cercano!</span>"],["Placeholder for something great at the near future!","¡Marcador de posición para algo genial en un futuro cercano!"],["This module will be created when the patron count reach 500!","¡Este módulo se creará cuando el conteo de patrocinadores alcance 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tUn proyecto con el mismo título <br>\"<span class=\"dialogGameTitle\"></span>\"<br> ya existe en la caché procesada posteriormente.<br>\n\t\tPuedes reutilizar esta caché para acortar significativamente el tiempo de carga.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","Si estás confundido, siempre puedes hacer clic con seguridad en el botón <strong><a href=\"#\">\"Crear nuevo proyecto\"</a></strong>."],["Existed cache","Caché existente"],["Select Translator","Seleccionar Traductor"],["Source column","Columna fuente"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","¿En qué columna está el texto fuente para traducir?<br>(por defecto es la columna clave / columna más a la izquierda)."],["Target column","Columna destino"],["Which column is the translated text put into.<br>(Can not same with source column)","En qué columna se coloca el texto traducido.<br>(No puede ser la misma que la columna fuente)."],["Translator's Options","Opciones del Traductor"],["Also try to translate other object","También intenta traducir otros objetos"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","Si esta opción está marcada, Translator++ también intentará traducir otros objetos que no seleccionaste y que no requieren traducción automática. Este es el comportamiento predeterminado en Translator++ versión 2.3.23 o inferior."],["Ignore if already translated","Ignorar si ya está traducido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Si esta opción está marcada, Translator++ ignorará cualquier fila que ya tenga traducciones en su columna."],["Overwrite cells","Sobrescribir celdas"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","Sobrescribir celdas objetivo. Si no está marcado, las celdas no se tocarán cuando no estén vacías."],["Save project on each batch.","Guardar proyecto en cada lote."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","Guarda tu proyecto al completar cada lote.<br>Esta opción es para evitar la pérdida de datos cuando la aplicación falla debido a ejecutar tareas pesadas desde la aplicación de traducción local. Probablemente no necesites esto si estás ejecutando un traductor basado en la nube."],["Play sound when completed.","Reproducir sonido al completar."],["Tags","Etiquetas"],["Select Context(s)","Seleccionar Contexto(s)"],["Manual Query","Consulta Manual"],["Match all words","Coincidir todas las palabras"],["Remove selected","Eliminar seleccionado"],["Remove all but selected","Eliminar todo excepto seleccionado"],["Select Context","Seleccionar Contexto"],["Source Column","Columna de Origen"],["Target Column","Columna de Destino"],["Maximum length","Longitud máxima"],["Export into","Exportar a"],["What to do with tagged rows?","¿Qué hacer con las filas etiquetadas?"],["Select Color Tag","Seleccionar etiqueta de color"],["On the fly word wrap","Ajuste de línea en tiempo real"],["Inject all files (ignoring selection)","Inyectar todos los archivos (ignorando la selección)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","Estás a punto de inyectar traducción mediante el botón <b>Inyectar todo</b>. Esto inyectará la traducción sin importar el objeto seleccionado en el panel izquierdo. Usa el menú contextual del panel izquierdo si deseas inyectar el objeto seleccionado."],["Select the source material to be translated","Selecciona el material fuente a traducir"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tSelecciona el material o contenido específico que deseas traducir, como un archivo, directorio u otra entrada relevante. Asegúrate de que el material elegido sea accesible y esté formateado apropiadamente para el analizador correspondiente.<br>\n\t\t\t\tPor defecto, algunos analizadores usan el directorio de ensayo como material fuente.\n\t\t\t"],["Path is inaccessible.","La ruta es inaccesible."],["Target Directory","Directorio de destino"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tSe generará una copia de tu aplicación traducida en esta carpeta.\n\t\t\t"],["Field can not be empty!","¡El campo no puede estar vacío!"],["Target to apply translation","Destino para aplicar la traducción"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tPor favor, selecciona el archivo ejecutable.\n\t\t\t"],["Copy materials","Copiar materiales"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","Las opciones de copia desde el Material Fuente al Directorio de Destino. (experimental, no todos los motores son compatibles)"],["Word Wrap by Tags","Ajuste de línea por etiquetas"],["Directory name","Nombre del directorio"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tEl objeto se agrupará bajo este directorio.<br>\n\t\t\t\tIngresa un asterisco \"<code>*</code>\" para agregar un nuevo <b>objeto de referencia</b>.\n\t\t\t"],["Invalid directory  name","Nombre de directorio inválido"],["Object name","Nombre del objeto"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tEl nombre del objeto.\n\t\t\t"],["Invalid object name","Nombre de objeto inválido"],["New Project","Nuevo Proyecto"],["Save","Guardar"],["Save as...","Guardar como..."],["Open...","Abrir..."],["Recent","Recientes"],["None...","Ninguno..."],["Export Project","Exportar Proyecto"],["To a folder","A una carpeta"],["As a zip file","Como archivo zip"],["To portable .tpp file","A archivo portátil .tpp"],["To RPGMakerTrans file (*.txt)","A archivo RPGMakerTrans (*.txt)"],["To CSV file","A archivo CSV"],["To XLSX file","A archivo XLSX"],["To XLS file","A archivo XLS"],["To ODS file","A archivo ODS"],["To HTML file","A archivo HTML"],["Import","Importar"],["Project from .tpp file","Proyecto desde archivo .tpp"],["Translation from .trans file","Traducción desde archivo .trans"],["Translation Spreadsheet","Hoja de cálculo de traducción"],["Translation RPGMKTRANSPATCH Format","Formato RPGMKTRANSPATCH de traducción"],["Automation","Automatización"],["Batch translation","Traducción por lotes"],["Context tool","Herramienta de contexto"],["Batch word wrapping","Ajuste de línea por lotes"],["Trim","Recortar"],["Auto padding","Relleno automático"],["Tools","Herramientas"],["Third Party Application Installer","Instalador de aplicaciones de terceros"],["Close project","Cerrar proyecto"],["Exit","Salir"],["Start here","Comienza aquí"],["Start a New Project","Iniciar un nuevo proyecto"],["Continue your work","Continuar tu trabajo"],["Open Project","Abrir proyecto"],["Your recent translation","Tu traducción reciente"],["Tips for you","Consejos para ti"],["Next tip! <span class=\"icon-angle-double-right\"></span>","¡Siguiente consejo! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","La celda más a la derecha en una fila tendrá prioridad."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","No puedes compartir tu proyecto con otros solo con un archivo trans. Necesitas generar un archivo TPP."],["Always make backups of your trans files.","Siempre haz copias de seguridad de tus archivos trans."],["You can rename and reorder the column with the coulumn header's context menu.","Puedes renombrar y reordenar la columna con el menú contextual del encabezado de columna."],["Always backup your game before working with Translator++!","¡Siempre haz una copia de seguridad de tu juego antes de trabajar con Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","Si encuentras una función que no funciona normalmente, intenta reiniciar Translator++, en la mayoría de los casos solucionará el problema."],["Always create a backup of your game before patching with a translation.","Siempre crea una copia de seguridad de tu juego antes de aplicar una traducción con un parche."],["Thank you for supporting Translator++.","Gracias por apoyar Translator++."],["Please check Translator++'s online documentation at","Por favor, consulta la documentación en línea de Translator++ en"],["working","trabajando"],["Open","Abrir"],["Save file","Guardar archivo"],["Save As","Guardar como"],["Import Project","Importar Proyecto"],["Inject / apply all translation","Inyectar / aplicar toda la traducción"],["Execute Global Level Custom Script","Ejecutar Script Personalizado de Nivel Global"],["Toggle Active Cell Info","Alternar Información de Celda Activa"],["Project Properties","Propiedades del Proyecto"],["Get Help (F1)","Obtener Ayuda (F1)"],["Batch translation (crl+b)","Traducción por lotes (ctrl+b)"],["File list","Lista de archivos"],["Live Translation Pane","Panel de traducción en vivo"],["Toggle selection","Alternar selección"],["Invert selection","Invertir selección"],["Add A New Object","Agregar un nuevo objeto"],["Connect to auto translator","Conectar a traductor automático"],["Undock pane","Desacoplar panel"],["Collapse / restore left panel","Contraer/restaurar panel izquierdo"],["Add new key (alt+n)","Agregar nueva clave (alt+n)"],["Import Here","Importar aquí"],["Add a note to this file","Agregar una nota a este archivo"],["Open search menu","Abrir menú de búsqueda"],["Toggle grid information","Alternar información de cuadrícula"],["Object Properties","Propiedades del objeto"],["Automatically set selected original text to clipboard","Establecer automáticamente el texto original seleccionado en el portapapeles"],["Resize Font","Redimensionar fuente"],["Toggle word wrapping & Explicit white spaces","Alternar ajuste de línea y espacios en blanco explícitos"],["Use Monospace font","Usar fuente monoespaciada"],["Remove all translation from this file","Eliminar todas las traducciones de este archivo"],["Remove this file from project","Eliminar este archivo del proyecto"],["file path","ruta del archivo"],["Quick find","Búsqueda rápida"],["Active cell's info","Información de la celda activa"],["View original untranslated text","Ver texto original sin traducir"],["View raw data","Ver datos sin procesar"],["View row properties","Ver propiedades de la fila"],["Go to current cell","Ir a la celda actual"],["Current coordinate","Coordenada actual"],["Word wraping (for non Japanese text)","Ajuste de línea (para texto no japonés)"],["Speak original text (alt+,)","Hablar texto original (alt+,)"],["Copy original text into current cell (ctrl+0)","Copiar texto original en la celda actual (ctrl+0)"],["Default translation for all occurrence","Traducción predeterminada para todas las ocurrencias"],["Translations by context","Traducciones por contexto"],["This cell has a comment","Esta celda tiene un comentario"],["This cell has an organic content","Esta celda tiene contenido orgánico"],["This cell has been visited","Esta celda ha sido visitada"],["This is the first time this cell has been visited","Esta es la primera vez que se visita esta celda"],["Word wraping","Ajuste de línea"],["Speak current translation text (alt+.)","Hablar texto de traducción actual (alt+.)"],["Current Cell Editor options","Opciones del editor de celdas actual"],["Clear context translation for current row","Limpiar traducción de contexto para la fila actual"],["Get help about translation by context","Obtener ayuda sobre traducción por contexto"],["Open menu","Abrir menú"],["Path not accessible","Ruta no accesible"],["The location of the original material. You should not modify anything inside this folder.","La ubicación del material original. No debes modificar nada dentro de esta carpeta."],["The location of the game that has been translated. The default location of the translation injection.","La ubicación del juego que ha sido traducido. La ubicación predeterminada para la inyección de traducción."],["Prefered translator for this project. If not defined, global setting will be used.","Traductor preferido para este proyecto. Si no está definido, se usará la configuración global."],["-use default-","-usar predeterminado-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","La ruta de preparación es la ubicación de algunos archivos necesarios para exportar/construir traducciones. Los archivos de preparación se generaron cuando creaste el proyecto."],["Number of objects/files available on the left pane","Número de objetos/archivos disponibles en el panel izquierdo"],["Number of characters in the Original Text column","Número de caracteres en la columna de Texto Original"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","Puede mostrar un valor incorrecto en idiomas que no usan espacios (ej. japonés, chino)."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","Usuarios llenaron directamente en la cuadrícula. Lo cual es una buena señal. Puede ser traducción humana, MTL editado, etc."],["Run a javascript function after this project is successfully exported.","Ejecutar una función de javascript después de que este proyecto se exporte exitosamente."],["Import .TRANS into project","Importar .TRANS al proyecto"],["Import Spreadsheet Options","Opciones de importación de hoja de cálculo"],["Import RPGMTransPatch Options","Opciones de importación de RPGMTransPatch"],["Start a new project","Iniciar un nuevo proyecto"],["Search project type...","Buscar tipo de proyecto..."],["Remove row","Eliminar fila"],["Add row","Agregar fila"],["Project is exist","El proyecto existe"],["Context Tool","Herramienta de contexto"],["Your list of context separated by new line","Tu lista de contexto separada por nueva línea"],["Wrap text","Ajustar texto"],["Export Options","Opciones de exportación"],["Tagging","Etiquetado"],["Apply Translation","Aplicar traducción"],["Add new Object","Agregar nuevo objeto"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText","idx/56/innerText"],["idx/29/innerText","idx/152/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText","idx/41/innerText"],["idx/40/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["