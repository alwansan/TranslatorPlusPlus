e/StringLiteral"],["tid/608422/type/StringLiteral"],["tid/621955/type/StringLiteral","tid/629854/type/StringLiteral"],["tid/621975/type/StringLiteral"],["tid/622292/type/StringLiteral"],["tid/622315/type/StringLiteral"],["tid/629235/type/StringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","modelosPersonalizados.etiquetaPersonalizada"],["model","modelo"],["|","|"],["promptLibrary","bibliotecaIndicaciones"],["search","buscar"],["downloadChat","descargarChat"],["newChat","nuevoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","apiEndpoint.etiquetaEntrada"],["apiKey.inputLabel","apiKey.etiquetaEntrada"],["apiVersion.inputLabel","apiVersion.etiquetaEntrada"],["apiVersion.description","apiVersion.descripción"],["securityMessage","mensajeSeguridad"],["apiEndpoint.description","apiEndpoint.descripción"],["apiEndpoint.warn","apiEndpoint.advertencia"],["partialImportMessages","mensajesImportaciónParcial"],["import","importar"],["name","nombre"],["prompt","prompt"],["clearPrompts","limpiarPrompts"],["morePrompts","másPrompts"],["toast.sync","toast.sincronizar"],["toast.stop","toast.detener"],["button.sync","botón.sincronizar"],["button.stop","botón.detener"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Traducir con ChatGPT Batch API"],["Model","Modelo"],["The pre-trained model.","El modelo preentrenado."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Parece que la API Batch de OpenAI usa una convención de nombres de modelos ligeramente diferente a la API general. Los modelos usados en la API Batch tienen un prefijo “-batch”. Por ejemplo, si usas <code>gpt-4.1-mini</code>, el modelo automáticamente se convierte en <code>gpt-4.1-mini-batch</code>.<br />\nSin embargo, al momento de crear este complemento, los modelos batch no están listados en los límites de uso de modelos de OpenAI, lo que imposibilita que los usuarios usen la API Batch si han configurado el filtro de uso de modelos en “Permitir” (lista blanca).<br />\nEsto probablemente es un error en la interfaz de OpenAI que podría corregirse en el futuro.<br />\nPor lo tanto, asegúrate de configurar los límites de uso en OpenAI en modo “Bloquear” (lista negra) para usar la API Batch.<br />\nHaz clic aquí para cambiar los límites de uso del modelo: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Columna Fuente"],["The column of the original texts you want to translate.","La columna de los textos originales que desea traducir."],["Add actor name","Añadir nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Agregar el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Ignore if already translated","Ignorar si ya está traducido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Si esta opción está marcada, Translator++ ignorará cualquier fila que ya tenga traducciones en su columna."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Use el comando de plantilla para cargar la referencia del actor en el mensaje de solicitud."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puede incluir más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["System Message Template","Plantilla de Mensaje del Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","El mensaje del sistema es el encabezado del mensaje que indicará cuál es el rol de su asistente chatGPT. Este mensaje se enviará como el primer mensaje de cada lote que envíe a chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Puede incluir las siguientes variables con el estilo de Literal de Plantilla de JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variables:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma fuente</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma objetivo</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nombre completo del idioma fuente</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nombre completo del idioma objetivo</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto fuente</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensaje predefinido del algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Cadena que representa nueva línea (sustituto de línea).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensajes en el lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Agregar información de los actores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCE[Referencia Común]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Incluir algunas líneas anteriores como contexto</li>"],["Body Message Template","Plantilla del Mensaje del Cuerpo"],["Template of the body of your chat.","Plantilla del cuerpo de tu chat."],["Sample conversation","Conversación de ejemplo"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","La API Batch de ChatGPT te permite traducir tu proyecto de forma asincrónica con un 50% menos de costos, lo que significa que recibirás los resultados de tu traducción <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:red\">la mitad del costo normal</b>. Esto es particularmente útil para proyectos grandes que no requieren resultados de traducción inmediatos."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Lee más sobre la API Batch de ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Configuración General"],["This form is using your existing ChatGPT configuration.<br>","Este formulario está usando tu configuración existente de ChatGPT.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Puedes cambiar la configuración yendo a los ajustes del Traductor ChatGPT en la ventana de opciones.<br>"],["There you can set the API key, model, and other settings.<br />","Allí puedes configurar la clave API, el modelo y otros ajustes.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Tu Clave API de OpenAI\"}});' value=\"Abrir ajustes de ChatGPT\" />"],["Append actor name to the translatable text","Agregar nombre del actor al texto traducible"],["Ignore translated rows","Ignorar filas traducidas"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar sobrecargar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt Template","Plantilla del Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensaje del Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aquí puedes explicarle al asistente cuál es su rol.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Tu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este es el prompt real para el asistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Costo general</h3>\n                        El costo general es el costo del mensaje del prompt que envías al asistente sin los textos de traducción reales. El costo se calcula basado en el número de tokens en el mensaje del prompt. Cuantos más tokens tengas, mayor será el costo.<br>\n                        <b>Costo general actual:</b> <span class=\"overheadCost\">0</span> tokens / solicitud."],["Are you sure you want to reset the form?","¿Estás seguro de que quieres restablecer el formulario?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","¿Estás seguro de que quieres procesar el lote?\nSe incurrirá en costos por esta operación."],["The batch is successfully created. Do you want to open the batch manager?","El lote se creó exitosamente. ¿Quieres abrir el gestor de lotes?"],["OpenAI Batch API Queue","Cola de la API de Lotes de OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nombre del objeto] : Generar referencia desde un objeto de Translator++. <br />Ejemplo : <code>REFERENCE[Referencia Común]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor selecciona las filas para aplicar la traducción"],["Target Column","Columna Destino"],["The column to put the translation result.","La columna para poner el resultado de la traducción."],["Import translation from ChatGPT Batch","Importar traducción desde Lote de ChatGPT"],["Translation applied to selected rows","Traducción aplicada a las filas seleccionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Desajuste"],["Failed to load batch list with error: \n","Error al cargar la lista de lotes: \n"],["Download Error File","Descargar Archivo de Error"],["Batch is not completed yet","El lote aún no está completado"],["Are you sure you want to cancel this batch?","¿Estás seguro de que quieres cancelar este lote?"],["Cannot cancel completed batch.","No se puede cancelar un lote completado."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Error al cancelar el lote"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar traducción"],["Cancel batch","Cancelar lote"],["Status","Estado"],["Batch ID","ID del lote"],["Input File ID","ID del archivo de entrada"],["End point","Punto final"],["Created at","Creado en"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Caduca en <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Los lotes que no se completan a tiempo eventualmente pasan a un estado expirado; las solicitudes sin terminar dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas está disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada.\"></i>"],["Completed at","Completado en"],["Errors","Errores"],["Batch Item Detail of","Detalle del elemento del lote de"],["ID","ID"],["Completed on","Completado el"],["Model","Modelo"],["Prompt Token","Token de entrada"],["Completion Token","Token de salida"],["Total Token","Token total"],["Status Code","Código de Estado"],["error","error"],["Conversation","Conversación"],["Response Validation","Validación de Respuesta"],["Raw Payload","Carga Útil Bruta"],["View raw payload","Ver carga útil bruta"],["Response Preview","Vista Previa de la Respuesta"],["Apply translations from selected rows","Aplicar traducciones de las filas seleccionadas"],["Here you can edit the translation result individually and send it into Translator++","Aquí puedes editar el resultado de la traducción individualmente y enviarlo a Translator++"],["Open ChatGPT Settings","Abrir Configuración de ChatGPT"],["Help","Ayuda"],["File list","Lista de Archivos"],["Collapse / restore left panel","Contraer / restaurar panel izquierdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Los lotes que no se completen a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas está disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información del actor. (Solo si la opción de información del actor está habilitada en modo por lotes)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nombre del objeto] : Generar referencia desde un objeto de Translator++. <br />Ejemplo : <code>REFERENCE[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>No desperdicies tu dinero en Modelos de Razonamiento</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Varios estudios han demostrado que los modelos de razonamiento son mucho peores que los modelos normales para realizar tareas de escritura creativa y traducción.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>No obtienes nada más que un costo más caro y tiempos de respuesta más lentos al usar modelos de razonamiento.</p>"],["<h2>Sample dialogue</h2>","<h2>Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Always separate file","Siempre separar archivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separa el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Añadir nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Agregar el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si habilitas esta opción, también necesitas incluir la variable <code>ACTOR_INFO</code> en la plantilla de prompt para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Referencia de Traducción del Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que se agregará al mensaje de prompt. Esto se agregará después del mensaje del sistema y antes del mensaje de prompt real."],["General Settings","Configuraciones Generales"],["Always separate file for each batch","Siempre archivo separado para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta característica te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La característica intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Prompt"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>E</u>nviar"],["Toggle word wrap","Alternar ajuste de línea"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ayuda"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Esta función solo está disponible si estás usando la versión Desarrollador de Translator++. Puedes cambiar a la versión Desarrollador usando Utilidades Básicas -> Cambiar Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información del actor. (Solo si la opción de información del actor está habilitada en el modo lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de muestra</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de muestra. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Always separate file","Siempre separar archivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separa el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Agregar nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añade el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje del prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si habilitas esta opción, también necesitas incluir la variable <code>ACTOR_INFO</code> en la plantilla del prompt para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene la información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que se agregará al mensaje del prompt. Esto se agregará después del mensaje del sistema y antes del mensaje del prompt real."],["General Settings","Configuración General"],["Always separate file for each batch","Siempre separar archivo para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","Chatear con la API de ChatGPT"],["Batch Manager","Gestor de Lotes"],["This feature is only available if you have a project open.","Esta función solo está disponible si tienes un proyecto abierto."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","Esta acción abrirá una ventana del navegador. Asegúrate de que tu navegador predeterminado esté configurado como Chrome. ¿Quieres continuar?"],["Gemini Nano server is already running. Do you want to restart it?","El servidor Gemini Nano ya está en ejecución. ¿Deseas reiniciarlo?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","Esta acción abrirá una ventana del navegador. Asegúrate de que tu navegador predeterminado esté configurado como Chrome. Y el servidor Gemini Nano está iniciado. ¿Deseas continuar?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":true,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información del actor. (Solo si la opción de información del actor está habilitada en modo por lotes)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Always separate file","Siempre separar archivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separar el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Agregar nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añadir el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia del Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de solicitud."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si habilitas esta opción, también necesitas incluir la variable <code>INFO_ACTOR</code> en la plantilla de solicitud para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de Referencia del Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["General Settings","Configuración General"],["Always separate file for each batch","Archivo separado siempre para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a añadir automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","Nombre del Servicio"],["Service provider for your Batch API.","Proveedor de servicio para tu Batch API."],["Your API Key","Tu Clave API"],["Please enter your API key for the Batch API service.","Por favor, ingresa tu clave API para el servicio Batch API."],["Model","Modelo"],["The model for your translation.","El modelo para tu traducción."],["Source Column","Columna Fuente"],["The column of the original texts you want to translate.","La columna de los textos originales que deseas traducir."],["Add actor name","Añadir nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añadir el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Ignore if already translated","Ignorar si ya está traducido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Si esta opción está marcada, Translator++ ignorará cualquier fila que ya tenga traducciones en su columna."],["Filter Tag","Etiqueta de Filtro"],["If set, only rows with this tag will be translated.","Si se establece, solo las filas con esta etiqueta serán traducidas."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de solicitud."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Enable Context","Habilitar Contexto"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Habilitar contexto para la traducción. El material traducido previamente arriba del lote actual se incluirá como contexto. <b>También necesitas incluir explícitamente el CONTEXTO en la plantilla</b>"],["Context Character Limit","Límite de Caracteres del Contexto"],["Character limit for the context.","Límite de caracteres para el contexto."],["System Message Template","Plantilla de Mensaje del Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","El mensaje del sistema es el encabezado del mensaje que indicará cuál es el rol de tu asistente chatGPT. Este mensaje se enviará como el primer mensaje de cada lote que envíes a chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Puedes incluir las siguientes variables con el estilo de Literal de Plantilla de JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variables:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origen</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nombre completo del idioma de origen</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nombre completo del idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origen</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensaje predefinido del algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Cadena que representa una nueva línea (sustituto de línea).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensajes en el lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Agregar información de los actores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCE[Referencia Común]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Incluir algunas líneas anteriores como contexto</li>"],["Body Message Template","Plantilla del Mensaje del Cuerpo"],["Template of the body of your chat.","Plantilla del cuerpo de tu chat."],["Sample conversation","Conversación de ejemplo"],["User message","Mensaje del usuario"],["Assistant's response","Respuesta del asistente"],["Enable JailBreak","Habilitar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Habilitar Jailbreak para la traducción. Esto hará que la traducción sea más precisa y menos sesgada. Algunos modelos pueden querer relacionar eventos ficticios con eventos de la vida real, por lo que intentarán alterar la traducción para ajustarla a su propia narrativa. Esta opción evitará eso."],["Jailbreak Template","Plantilla de Jailbreak"],["Template of the Jailbreak message.","Plantilla del mensaje de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","El número máximo de tokens a generar en la completación.<br>El conteo de tokens de tu prompt más max_tokens no puede exceder la longitud de contexto del modelo. La mayoría de los modelos tienen una longitud de contexto de 2048 tokens (excepto los modelos más nuevos, que soportan 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","¿Qué temperatura de muestreo usar, entre 0 y 2? Valores más altos como 0.8 harán que la salida sea más aleatoria, mientras que valores más bajos como 0.2 la harán más enfocada y determinista. <br>OpenAI generalmente recomienda alterar esto o top_p, pero no ambos."],["Nucleus sampling (top_p)","Muestreo de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Una alternativa al muestreo con temperatura, llamada muestreo de núcleo, donde el modelo considera los resultados de los tokens con masa de probabilidad top_p. Así que 0.1 significa que solo se consideran los tokens que comprenden el 10% superior de la masa de probabilidad. <br>OpenAI generalmente recomienda alterar esto o la temperatura, pero no ambos."],["Frequency Penalty","Penalización de Frecuencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Los valores positivos penalizan nuevos tokens según su frecuencia existente en el texto hasta ahora, disminuyendo la probabilidad del modelo de repetir la misma línea textualmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalización de Presencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Los valores positivos penalizan nuevos tokens según si aparecen en el texto hasta ahora, aumentando la probabilidad del modelo de hablar sobre nuevos temas. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","Parámetro Personalizado"],["Key","Clave"],["Value","Valor"],["Type","Tipo"],["Type of the value.","Tipo del valor."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Para el tipo <b>javascript</b>, el valor será evaluado como código JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","El alcance del código JavaScript es <code>window</code>. Así que básicamente puedes obtener cualquier valor."],["Example: <code>trans.project.title</code>","Ejemplo: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Eliminar parámetros que no se enviarán a la API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","La API de OpenAI sigue cambiando, algunos modelos nuevos pueden no admitir los parámetros antiguos y devolverán un error HTTP para parámetros de solicitud no reconocidos."],["You can drop the parameters that are not supported by the model here.","Puedes eliminar aquí los parámetros que no son compatibles con el modelo."],["Batch API settings","Configuración de API por lotes"],["General","General"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","La API por lotes de OpenAI te permite traducir tu proyecto de forma asincrónica con un 50% menos de costos, lo que significa que recibirás los resultados de tu traducción <b style=\"color:red\">en 24 horas</b> a <b style=\"color:blue\">la mitad del costo normal</b>. Esto es especialmente útil para proyectos grandes que no requieren resultados de traducción inmediatos."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Lee más sobre la API por lotes <a href=\"https://platform.openai.com/docs/guides/batch\" external>aquí</a>.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />Servicios soportados: <b>OpenAI</b> y <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>Más configuraciones se encuentran en Configuraciones de Complementos</h2>"],["Open Add-on Settings","Abrir Configuraciones del Complemento"],["Import Configuration from OpenAI Setting","Importar Configuración desde Configuración de OpenAI"],["General Settings","Configuraciones Generales"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>No malgastes tu dinero en Modelos de Razonamiento</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Varios estudios han demostrado que los modelos de razonamiento son mucho peores que los modelos normales para realizar tareas de escritura creativa y traducción.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>No ganas nada más que costos más caros y tiempos de respuesta más lentos al usar modelos de razonamiento.</p>"],["<h2>If you're using OpenAI</h2>","<h2>Si estás usando OpenAI</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","La API por lotes de OpenAI utiliza una convención de nombres de modelos ligeramente diferente en comparación con la API estándar. Los modelos en modo por lotes incluyen un sufijo -batch. Por ejemplo, si especificas <code>gpt-4.1-mini</code>, se interpretará automáticamente como <code>gpt-4.1-mini-batch</code>.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","Sin embargo, en el momento en que se desarrolló este complemento, los modelos por lotes no estaban listados bajo los límites de uso de modelos de OpenAI. Esto significa que los usuarios que han configurado su filtro de uso de modelos como \"Permitir\" (lista blanca) no podrán acceder a la API por lotes.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","Haz clic <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>aquí</a> para cambiar los límites de uso del modelo."],["Explore more models","Explorar más modelos"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Ignore translated rows","Ignorar filas traducidas"],["Templates","Plantillas"],["<h2>1. System Message</h2>","<h2>1. Mensaje del Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aquí puedes explicarle al asistente cuál es su rol.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Tu indicación real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Esta es la indicación real para el asistente.</p>"],["Enable Jailbreak","Habilitar Jailbreak"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a agregar automáticamente un glosario en la indicación. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu indicación.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Enable context","Habilitar contexto"],["Advanced","Avanzado"],["Custom Parameters","Parámetros Personalizados"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Puedes agregar parámetros personalizados al cuerpo de la solicitud de la API de Chat de OpenAI. Esto es útil si deseas agregar parámetros adicionales que no están disponibles en el formulario."],["<h2>Warning</h2>","<h2>Advertencia</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Configurar incorrectamente parámetros personalizados puede hacer que la solicitud de la API falle. Asegúrate de saber lo que estás haciendo antes de agregar parámetros personalizados. Algunos servicios como OpenAI son estrictos sobre qué parámetros envías, y devolverán un error HTTP para parámetros de solicitud no reconocidos.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Si se usa la misma clave múltiples veces, solo se usará el último valor.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Si se usa la misma clave en la configuración existente, entonces el parámetro de configuración existente será sobrescrito por el parámetro personalizado.</li>"],["String","Cadena"],["Number","Número"],["Boolean","Booleano"],["JavaScript","JavaScript"],["Drop Parameters","Eliminar Parámetros"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Costo general</h3>\n                        El costo general es el costo del mensaje de solicitud que envías al asistente sin los textos de traducción reales. El costo se calcula según el número de tokens en el mensaje de solicitud. Cuantos más tokens tengas, mayor será el costo.<br>\n                        <b>Costo general estimado:</b> <span class=\"overheadCost\">0</span> tokens / solicitud."],["Are you sure you want to reset the form?","¿Estás seguro de que quieres restablecer el formulario?"],["Translate with Batch API","Traducir con API por Lotes"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","¿Estás seguro de que quieres procesar el lote?\nSe incurrirá en costos por esta operación."],["The batch is successfully created. Do you want to open the batch manager?","El lote se creó exitosamente. ¿Quieres abrir el gestor de lotes?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","¿Estás seguro de que quieres importar la configuración desde los ajustes de OpenAI? Esto sobrescribirá la configuración actual."],["chatGPT engine is not found","Motor chatGPT no encontrado"],["Configuration imported successfully.","Configuración importada exitosamente."],["Batch API Queue","Cola de API por Lotes"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor, selecciona las filas para aplicar la traducción"],["Target Column","Columna Destino"],["The column to put the translation result.","La columna donde se pondrá el resultado de la traducción."],["Import translation from ChatGPT Batch","Importar traducción desde Lote de ChatGPT"],["Translation applied to selected rows","Traducción aplicada a las filas seleccionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Desajuste"],["Failed to load batch list with error: \n","Error al cargar la lista de lotes: \n"],["Download Error File","Descargar Archivo de Error"],["Batch is not completed yet","El lote aún no está completado"],["Are you sure you want to cancel this batch?","¿Estás seguro de que quieres cancelar este lote?"],["Cannot cancel completed batch.","No se puede cancelar un lote completado."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Error al cancelar el lote"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar traducción"],["Cancel batch","Cancelar lote"],["Status","Estado"],["Batch ID","ID del Lote"],["Input File ID","ID del Archivo de Entrada"],["End point","Punto Final"],["Created at","Creado en"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira en <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Los lotes que no se completan a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas está disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada.\"></i>"],["Completed at","Completado en"],["Errors","Errores"],["Batch Item Detail of","Detalle del Elemento del Lote de"],["ID","ID"],["Completed on","Completado el"],["Model","Modelo"],["Prompt Token","Token del Prompt"],["Completion Token","Token de Completación"],["Total Token","Token Total"],["Status Code","Código de Estado"],["error","error"],["Conversation","Conversación"],["Response Validation","Validación de Respuesta"],["Raw Payload","Carga Útil en Bruto"],["View raw payload","Ver carga útil sin procesar"],["Response Preview","Vista previa de respuesta"],["Apply translations from selected rows","Aplicar traducciones de filas seleccionadas"],["Here you can edit the translation result individually and send it into Translator++","Aquí puedes editar el resultado de la traducción individualmente y enviarlo a Translator++"],["Open ChatGPT Settings","Abrir configuración de ChatGPT"],["Help","Ayuda"],["File list","Lista de archivos"],["Collapse / restore left panel","Contraer / restaurar panel izquierdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Los lotes que no se completen a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas se hace disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","Nombre del Servicio"],["Service provider for your Batch API.","Proveedor de servicio para tu API por Lotes."],["API Key","Clave API"],["Please enter your API key for the Batch API service.","Por favor ingresa tu clave API para el servicio de API por Lotes."],["Model","Modelo"],["The pre-trained model","El modelo preentrenado"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","En ChatGPT, es posible que necesites configurar el modelo permitido para ser usado (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","Habilitar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Habilitar Jailbreak para la traducción. Esto hará que la traducción sea más precisa y menos sesgada. Algunos modelos pueden querer relacionar eventos ficticios con eventos de la vida real, por lo que intentarán alterar la traducción para ajustarse a su propia narrativa. Esta opción evitará eso."],["Jailbreak Template","Plantilla de Jailbreak"],["Template of the Jailbreak message.","Plantilla del mensaje de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","El número máximo de tokens a generar en la completación.<br>El conteo de tokens de tu prompt más max_tokens no puede exceder la longitud de contexto del modelo. La mayoría de los modelos tienen una longitud de contexto de 2048 tokens (excepto los modelos más nuevos, que soportan 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qué temperatura de muestreo usar, entre 0 y 2. Valores más altos como 0.8 harán la salida más aleatoria, mientras que valores más bajos como 0.2 la harán más enfocada y determinística. <br>OpenAI generalmente recomienda alterar esto o top_p pero no ambos."],["Nucleus sampling (top_p)","Muestreo de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Una alternativa al muestreo con temperatura, llamada muestreo de núcleo, donde el modelo considera los resultados de los tokens con masa de probabilidad top_p. Así que 0.1 significa que solo se consideran los tokens que comprenden el 10% superior de masa de probabilidad. <br>OpenAI generalmente recomienda alterar esto o la temperatura pero no ambos."],["Frequency Penalty","Penalización de Frecuencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Valores positivos penalizan nuevos tokens basados en su frecuencia existente en el texto hasta ahora, disminuyendo la probabilidad del modelo de repetir la misma línea textualmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalización de Presencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Valores positivos penalizan nuevos tokens basados en si aparecen en el texto hasta ahora, aumentando la probabilidad del modelo de hablar sobre nuevos temas. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","Máximo de Caracteres por Lote"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Límite máximo de caracteres por lote de traducción.\nEsta opción contará solo la longitud de caracteres del texto original, y no la longitud de caracteres del mensaje de prompt."],["Max row per concurrent requests","Máximo de filas por solicitudes concurrentes"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Cuántas filas se permiten para cada solicitud concurrente. Configúralo en <b>0</b> para desactivar esta función.<br />Si esta opción está desactivada, no importa cuántas <b>Solicitudes concurrentes máximas</b> configures, Translator++ procesará la solicitud como un solo fragmento.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Cuántas más filas configures, más traducción puedes obtener en un solo lote. Por lo tanto, reduce el costo general y aumenta la posibilidad de que la IA devuelva resultados erróneos.<br />Cuanto menor sea el número, menos probable será que la traducción falle, pero te costará extra por prompts generales."],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Algoritmo de escape para código en línea dentro de los diálogos. Puede que necesites cambiar la <b>Plantilla de Mensaje del Sistema</b> y la <b>Plantilla de Mensaje del Cuerpo</b> según el algoritmo de escape de tu elección.<br />Cuando eliges <b>JSONCloaking</b>, el parámetro response_format: { type: 'json_object' } se enviará a ChatGPT automáticamente. <b>JSONCloaking</b> es muy preciso, pero no funciona con todos los modelos, prueba con <b>gpt-3.5-turbo-1106</b>."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","La <b>API por Lotes</b> te permite enviar muchas solicitudes a la vez, que se procesan asincrónicamente en segundo plano. No recibirás resultados inmediatamente, pero el proceso <b>se completará dentro de 24 horas</b>—y a menudo mucho más rápido. Este método <b>cuesta solo la mitad que el enfoque estándar</b>."],["Batch API settings","Configuración de la API por lotes"],["General","General"],["Explore more models","Explorar más modelos"],["Templates","Plantillas"],["Enable Jailbreak","Habilitar Jailbreak"],["Advanced","Avanzado"],["Batch Translation Setting","Configuración de traducción por lotes"],["Default","Predeterminado"],["JavaScript template cloaking","Enmascaramiento de plantilla con JavaScript"],["None (no escaping)","Ninguno (sin escape)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información de actores. (Solo si la opción de información de actores está habilitada en modo por lotes)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Always separate file","Siempre archivo separado"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separa el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Añadir nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añade el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia del Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada lote de elementos. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de solicitud."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si activas esta opción, también necesitas incluir la variable <code>ACTOR_INFO</code> en la plantilla de solicitud para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de la Referencia del Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Solicitud Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Solicitud extra que se añadirá al mensaje de solicitud. Esto se añadirá después del mensaje del sistema y antes del mensaje de solicitud real."],["General Settings","Configuración General"],["Always separate file for each batch","Siempre archivo separado para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta característica te ayudará a añadir automáticamente un glosario en la solicitud. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La característica intentará cargar solo los términos relevantes para evitar inflar tu solicitud.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Solicitud"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","Abrir Gestor de Lotes"],["This feature is only available if you have a project open.","Esta función solo está disponible si tienes un proyecto abierto."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":true,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","URL del proxy de LiteLLM. La dirección URL de tu proxy LiteLLM. El valor predeterminado es: <code>http://localhost:8890/chat/completions</code>"],["API's base URL","URL base de la API"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","La URL base de tu servicio seleccionado. Solo llena este campo si estás usando una URL de endpoint personalizada. LiteLLM detectará automáticamente la URL base basada en el modelo dado.<br />La forma en que LiteLLM agrega la ruta a la URL depende del servicio. Por ejemplo, para endpoints compatibles con OpenAI, LiteLLM agregará <code>/chat/completions</code> a la URL dada. Así que, si tu endpoint es <code>https://api.fast-tunnel.one/v1/chat/completions</code>, llena el campo con <code>https://api.fast-tunnel.one/v1</code>."],["API Version","Versión de la API"],["Optional. The API version parameter needed for some services.","Opcional. El parámetro de versión de la API necesario para algunos servicios."],["API Key","Clave de API"],["Optional. The API key used for authenticating your access to the service.","Opcional. La clave de API utilizada para autenticar tu acceso al servicio."],["Model","Modelo"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","Pre-entrena el modelo de tu elección. Utiliza el formato de conveniencia de modelo de LiteLLM para especificar tu modelo preferido. El formato es {nombre del servicio}/{modelo}. Por ejemplo:"],["your deployment name","tu nombre de implementación"],["However, some models have unique names that can be directly identified, like:","Sin embargo, algunos modelos tienen nombres únicos que pueden identificarse directamente, como:"],["Azure AD Token","Token de Azure AD"],["AWS Access Key ID","ID de clave de acceso de AWS"],["AWS secret access key","Clave de acceso secreta de AWS"],["Open router site URL","URL del sitio de Open Router"],["Open router APP name","Nombre de la APP de Open Router"],["Enable Context","Habilitar Contexto"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Habilitar el contexto para la traducción. El material previamente traducido arriba del lote actual se incluirá como contexto. <b>También necesitas incluir explícitamente el CONTEXTO en la plantilla</b>"],["Context Character Limit","Límite de Caracteres del Contexto"],["Character limit for the context.","Límite de caracteres para el contexto."],["System Message Template","Plantilla del Mensaje del Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","El mensaje del sistema es el encabezado del mensaje que indicará cuál es el rol de tu asistente de chatGPT. Este mensaje se enviará como el primer mensaje de cada lote que envíes a chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Puedes incluir las siguientes variables con el estilo de Literal de Plantilla de JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variables:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origen</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origen</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensaje predefinido del algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Cadena que representa nueva línea (sustituto de línea).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensajes en el lote.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información del actor. (Solo si la opción de información del actor está habilitada en modo por lotes)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["User message","Mensaje del usuario"],["Assistant's response","Respuesta del asistente"],["Body Message Template","Plantilla del mensaje del cuerpo"],["Template of the body of your message.","Plantilla del cuerpo de tu mensaje."],["Enable JailBreak","Habilitar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Habilitar Jailbreak para la traducción. Esto hará que la traducción sea más precisa y menos sesgada. Algunos modelos pueden querer relacionar eventos ficticios con eventos de la vida real, por lo que intentarán alterar la traducción para ajustarse a su propia narrativa. Esta opción evitará eso."],["Jailbreak Template","Plantilla de Jailbreak"],["Template of the Jailbreak message.","Plantilla del mensaje de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","El número máximo de tokens a generar en la completación.<br>El conteo de tokens de tu prompt más max_tokens no puede exceder la longitud de contexto del modelo. La mayoría de los modelos tienen una longitud de contexto de 2048 tokens (excepto los modelos más nuevos, que soportan 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qué temperatura de muestreo usar, entre 0 y 2. Valores más altos como 0.8 harán que la salida sea más aleatoria, mientras que valores más bajos como 0.2 la harán más enfocada y determinista. <br>OpenAI generalmente recomienda alterar esto o top_p pero no ambos."],["Nucleus sampling (top_p)","Muestreo de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Una alternativa al muestreo con temperatura, llamada muestreo de núcleo, donde el modelo considera los resultados de los tokens con masa de probabilidad top_p. Así que 0.1 significa que solo se consideran los tokens que comprenden el 10% superior de la masa de probabilidad. <br>OpenAI generalmente recomienda alterar esto o la temperatura pero no ambos."],["Frequency Penalty","Penalización de Frecuencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Los valores positivos penalizan nuevos tokens basados en su frecuencia existente en el texto hasta ahora, disminuyendo la probabilidad del modelo de repetir la misma línea textualmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalización por Presencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Los valores positivos penalizan nuevos tokens basados en si aparecen en el texto hasta ahora, aumentando la probabilidad del modelo de hablar sobre nuevos temas. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Usar Esquema JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Usa <code>json_schema</code> para el campo <code>response_format.type</code> en lugar del antiguo <code>json_object</code>. <code>json_schema</code> es requerido por algunos de los últimos modelos y algunos servidores como <b>LM Studio</b>, pero algunos modelos antiguos aún usan <code>json_object</code>."],["Stop","Detener"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","Ingresa una palabra clave donde la API dejará de generar más tokens. Separa cada entrada con una nueva línea."],["Additional argument variables","Variables de argumentos adicionales"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","Variables de argumentos adicionales que se agregarán al iniciar el servidor.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","Tiempo de Espera por Lote"],["Timeout for each batch in milisecond","Tiempo de espera para cada lote en milisegundos"],["Max Request Length","Longitud Máxima de Solicitud"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","La longitud máxima de caracteres para cada lote de traducción.\nCada traductor tiene especificaciones diferentes.\nRecomiendo menos de 2000 para traductores de interfaz web que usan parámetros GET."],["Max concurrent requests","Máximo de solicitudes concurrentes"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","Cuántas solicitudes concurrentes se permiten conectar simultáneamente. Configúralo en <b>0</b> para desactivar esta función.<br />Combina esta opción con <b>Máximo de filas por solicitud concurrente</b> para aumentar la velocidad de traducción."],["Max row per concurrent requests","Máximo de filas por solicitudes concurrentes"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","Cuántas filas se permiten para cada solicitud concurrente. Configúralo en <b>0</b> para desactivar esta función.<br />Si esta opción está desactivada, no importa cuántas <b>Máximo de solicitudes concurrentes</b> configures, Translator++ procesará la solicitud como un solo bloque."],["Batch delay","Retraso entre lotes"],["Delay between batch (in miliseconds)","Retraso entre lotes (en milisegundos)"],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","Algoritmo de escape para código en línea dentro de diálogos. Es posible que necesites cambiar la <b>Plantilla de Mensaje del Sistema</b> y la <b>Plantilla de Mensaje del Cuerpo</b> según el algoritmo de escape que elijas."],["Number of retry","Número de reintentos"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Cuántas veces el motor debe reintentar cuando la validación de la salida de traducción falla. Si es nulo (vacío), entonces no hay reintento."],["Retry when the number of translated rows doesn't match original","Reintentar cuando el número de filas traducidas no coincide con el original"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Si está habilitado, el motor reintentará cuando el modelo devuelva un número diferente de filas de traducción en comparación con la carga útil original."],["Retry when the number of lines for each translated row doesn't match original","Reintentar cuando el número de líneas para cada fila traducida no coincide con el original"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Si está habilitado, el motor reintentará cuando cualquier fila traducida tenga un número diferente de líneas que su fila original."],["Prompt: Row count mismatch","Prompt: Desajuste en el conteo de filas"],["Prompt used when retrying due to row/element count mismatch.","Prompt utilizado al reintentar debido a un desajuste en el conteo de filas/elementos."],["Prompt: Line count mismatch","Prompt: Desajuste en el conteo de líneas"],["Prompt used when retrying due to per-row line count mismatch.","Prompt utilizado al reintentar debido a un desajuste en el conteo de líneas por fila."],["Prompt: Error / Retry instruction","Prompt: Error / Instrucción de reintento"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","Prompt añadido después del/los prompt(s) de desajuste para instruir al modelo a reintentar."],["Custom Parameter","Parámetro Personalizado"],["Key","Clave"],["Value","Valor"],["Type","Tipo"],["Type of the value.","Tipo del valor."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Para el tipo <b>javascript</b>, el valor se evaluará como código JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","El alcance del código JavaScript es <code>window</code>. Así que básicamente puedes tomar cualquier valor."],["<br />Example: <code>trans.project.title</code>","<br />Ejemplo: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Elimina los parámetros que no se enviarán a la API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","La API de OpenAI sigue cambiando, algunos modelos nuevos pueden no admitir los parámetros antiguos y devolverán un error HTTP por parámetro de solicitud no reconocido."],["You can drop the parameters that are not supported by the model here.","Puedes eliminar aquí los parámetros que no son compatibles con el modelo."],["Manage configuration","Gestionar configuración"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","Algunas funciones de este motor requieren que el complemento ChatGPT esté instalado. Asegúrate de haber instalado el complemento ChatGPT antes de usar este motor."],["Text Completion Setting","Configuración de completación de texto"],["General","General"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>No malgastes tu dinero en modelos de razonamiento</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Varios estudios han demostrado que los modelos de razonamiento son mucho peores que los modelos normales para realizar tareas de escritura creativa y traducción.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>No obtienes nada más que un costo más caro y tiempos de respuesta más lentos al usar modelos de razonamiento.</p>"],["Platform specific","Específico de la plataforma"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","Plantillas"],["Enable context","Habilitar contexto"],["<h2>Sample dialogue</h2>","<h2>Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Retry prompts","Reintentar indicaciones"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Estos mensajes se añaden como mensajes adicionales del <b>usuario</b> durante los reintentos, justo después de la salida anterior del modelo.</p>"],["<p>Available variables:</p>","<p>Variables disponibles:</p>"],["Enable Jailbreak","Habilitar Jailbreak"],["Advanced","Avanzado"],["Custom Parameters","Parámetros Personalizados"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Puedes añadir parámetros personalizados al cuerpo de la solicitud de la API de Chat de OpenAI. Esto es útil si deseas agregar parámetros adicionales que no están disponibles en el formulario."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>Advertencia</h2><ul><li>Configurar incorrectamente los parámetros personalizados puede hacer que la solicitud de la API falle. Asegúrate de saber lo que estás haciendo antes de añadir parámetros personalizados. Algunos servicios como OpenAI son estrictos sobre qué parámetros envías, y devolverán un error HTTP por parámetros de solicitud no reconocidos.</li><li>Si se usa la misma clave múltiples veces, solo se usará el último valor.</li><li>Si se usa la misma clave en la configuración existente, entonces el parámetro de configuración existente será sobrescrito por el parámetro personalizado.</li></ul>"],["Drop Parameters","Eliminar Parámetros"],["LiteLLM Proxy Configuration","Configuración del Proxy LiteLLM"],["Start LiteLLM server","Iniciar servidor LiteLLM"],["Processing...","Procesando..."],["Server started on port ","Servidor iniciado en el puerto "],["Check LiteLLM Status","Verificar Estado de LiteLLM"],["Change LiteLLM Version","Cambiar Versión de LiteLLM"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","Ingresa la nueva versión de LiteLLM que deseas instalar.\nVersiones conocidas que funcionan: 1.38.0, 1.49.4 \nLa versión sugerida es: "],["Are you sure you want to install LiteLLM version ","¿Estás seguro de que deseas instalar la versión "],["Failed to install LiteLLM. Please check the console for more details.","Error al instalar LiteLLM. Por favor, revisa la consola para más detalles."],["LiteLLM has been successfully updated to version ","LiteLLM se ha actualizado exitosamente a la versión "],["Batch Translation Setting","Configuración de Traducción por Lotes"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Lo siento, este complemento solo está disponible para patrocinadores activos.\nPuedes desbloquear esta función convirtiéndote en un patrocinador de $1."],["Retries and Refinement","Reintentos y Refinamiento"],["<h2>Retries and Refinement</h2>","<h2>Reintentos y Refinamiento</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Cuando la salida de traducción falla la validación, Translator++ puede pedirle al modelo que reintente la traducción. Puedes configurar cuántas veces debe reintentar el modelo y también establecer la condición para el reintento.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Establecer un número razonable de reintentos con condiciones adecuadas puede mejorar significativamente la calidad de la traducción mientras se controlan los costos y el tiempo.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Cada reintento te cuesta tiempo y dinero adicionales</b>. Si tu lote termina reintentando con frecuencia, es posible que desees ajustar tu indicación para hacer las instrucciones más claras para el modelo.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Usa la herramienta de desarrollo o el Gestor de Lotes para depurar tu traducción por lotes.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Algoritmo de Escape de Código</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>El escape de código es una técnica para evitar que la MTL altere los fragmentos de código dentro de los diálogos. Esto es útil cuando tus diálogos contienen fragmentos de código como etiquetas HTML, etiquetas XML, objetos JSON o plantillas JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Elige el algoritmo de escape que coincida con los fragmentos de código dentro de tus diálogos. Es posible que necesites ajustar las plantillas de <b>mensaje del sistema</b>, <b>indicación de muestra</b> y <b>mensaje del cuerpo</b> en consecuencia.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Haz clic <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>aquí</a> para leer más sobre algoritmos de escape de código y cómo usarlos efectivamente.</p>"],["JavaScript template cloaking","Ocultación de plantilla JavaScript"],["None (no escaping)","Ninguno (sin escape)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","¿Deseas cargar el diálogo de muestra preestablecido para el algoritmo de escape seleccionado? Esto sobrescribirá tu diálogo de muestra existente."],["Always separate file","Siempre archivo separado"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separa el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Agregar nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añade el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de indicación."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si activas esta opción, también necesitas incluir la variable <code>ACTOR_INFO</code> en la plantilla del prompt para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de Referencia del Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene la información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que se agregará al mensaje del prompt. Esto se agregará después del mensaje del sistema y antes del mensaje del prompt real."],["General Settings","Configuración General"],["Always separate file for each batch","Siempre archivo separado para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Prompt"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":true,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","Traducir con la API de Lotes de OpenAI"],["Model","Modelo"],["The pre-trained model.","El modelo preentrenado."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Parece que la API de Lotes de OpenAI usa una convención de nombres de modelos ligeramente diferente a la API generalmente usada. Los modelos usados en la API de Lotes tienen un prefijo “-batch”. Por ejemplo, si usas <code>gpt-4.1-mini</code>, el modelo automáticamente se convierte en <code>gpt-4.1-mini-batch</code>.<br />\nSin embargo, al momento de crear este complemento, los modelos de lotes no están listados en los límites de uso de modelos de OpenAI, lo que hace imposible que los usuarios usen la API de Lotes si han configurado el filtro de uso de modelos a “Permitir” (lista blanca).<br />\nEsto probablemente sea un error en la interfaz de usuario de OpenAI que podría corregirse en el futuro.<br />\nAsí que, asegúrate de configurar los límites de uso en OpenAI en modo “Bloquear” (lista negra) para poder usar la API de Lotes.<br />\nHaz clic aquí para cambiar los límites de uso del modelo: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Columna de Origen"],["The column of the original texts you want to translate.","La columna de los textos originales que quieres traducir."],["Add actor name","Agregar nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añadir el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Ignore if already translated","Ignorar si ya está traducido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Si esta opción está marcada, Translator++ ignorará cualquier fila que ya tenga traducciones en su columna."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de instrucción."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene la información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["System Message Template","Plantilla de Mensaje del Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","El mensaje del sistema es el encabezado del mensaje que indicará cuál es el rol de tu asistente chatGPT. Este mensaje se enviará como el primer mensaje de cada lote que envíes a chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Puedes incluir las siguientes variables con el estilo de Literal de Plantilla de JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variables:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origen</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nombre completo del idioma de origen</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nombre completo del idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>TEXTO_FUENTE : Texto fuente</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>PROMPT_ALGORITMO_ESCAPE : Mensaje predefinido del algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>CADENA_NUEVA_LÍNEA : Cadena que representa nueva línea (sustituto de línea).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>CONTADOR_MENSAJES : Número de mensajes en el lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>INFORMACIÓN_ACTOR : Agregar información de los actores.</li>"],["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXTO : Incluir algunas líneas anteriores como contexto</li>"],["Body Message Template","Plantilla de Mensaje del Cuerpo"],["Template of the body of your chat.","Plantilla del cuerpo de tu chat."],["Sample conversation","Conversación de ejemplo"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","La API por Lotes de OpenAI te permite traducir tu proyecto de forma asincrónica con un 50% menos de costo, lo que significa que recibirás los resultados de tu traducción <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:blue\">la mitad del costo normal</b>. Esto es especialmente útil para proyectos grandes que no requieren resultados de traducción inmediatos."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />Lee más sobre la API por Lotes de OpenAI <a href=\"https://platform.openai.com/docs/guides/batch\" external>aquí</a>."],["General Settings","Configuración General"],["This form is using your OpenAI Batch API configuration.<br>","Este formulario está usando tu configuración de la API por Lotes de OpenAI.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","Puedes cambiar la configuración yendo a los ajustes del complemento <b>API por Lotes de OpenAI</b> en la ventana de opciones.<br>"],["There you can set the API key, model, and other settings.<br />","Allí puedes establecer la clave API, el modelo y otros ajustes.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Tu Clave API de OpenAI\"}});' value=\"Abrir ajustes de ChatGPT\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>No desperdicies tu dinero en Modelos de Razonamiento</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Se ha comprobado mediante diversos estudios que los modelos de razonamiento son mucho peores que los modelos normales al realizar tareas de escritura creativa y traducción.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>No ganas nada más que un costo más caro y tiempos de respuesta más lentos al usar modelos de razonamiento.</p>"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Ignore translated rows","Ignorar filas traducidas"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a añadir automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt Template","Plantilla del Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensaje del Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aquí puedes explicar al asistente cuál es su rol.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Tu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este es el prompt real para el asistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Costo indirecto</h3>\n                        El costo indirecto es el costo del mensaje del prompt que envías al asistente sin los textos de traducción reales. El costo se calcula basándose en el número de tokens en el mensaje del prompt. Cuantos más tokens tengas, mayor será el costo.<br>\n                        <b>Costo indirecto estimado:</b> <span class=\"overheadCost\">0</span> tokens / solicitud."],["Are you sure you want to reset the form?","¿Estás seguro de que quieres restablecer el formulario?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","¿Estás seguro de que quieres procesar el lote?\nSe incurrirá en un costo por esta operación."],["The batch is successfully created. Do you want to open the batch manager?","El lote se ha creado exitosamente. ¿Quieres abrir el gestor de lotes?"],["OpenAI Batch API Queue","Cola de la API de Lotes de OpenAI"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor selecciona las filas para aplicar la traducción"],["Target Column","Columna Objetivo"],["The column to put the translation result.","La columna para poner el resultado de la traducción."],["Import translation from ChatGPT Batch","Importar traducción desde Lote de ChatGPT"],["Translation applied to selected rows","Traducción aplicada a las filas seleccionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Desajuste"],["Failed to load batch list with error: \n","Error al cargar la lista de lotes: \n"],["Download Error File","Archivo de Error de Descarga"],["Batch is not completed yet","El lote aún no está completado"],["Are you sure you want to cancel this batch?","¿Estás seguro de que quieres cancelar este lote?"],["Cannot cancel completed batch.","No se puede cancelar un lote completado."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Error al cancelar el lote"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar traducción"],["Cancel batch","Cancelar lote"],["Status","Estado"],["Batch ID","ID del Lote"],["Input File ID","ID del Archivo de Entrada"],["End point","Punto final"],["Created at","Creado en"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira en <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Los lotes que no se completan a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas está disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada.\"></i>"],["Completed at","Completado en"],["Errors","Errores"],["Batch Item Detail of","Detalle del Elemento del Lote de"],["ID","ID"],["Completed on","Completado el"],["Model","Modelo"],["Prompt Token","Token de entrada"],["Completion Token","Token de salida"],["Total Token","Token total"],["Status Code","Código de estado"],["error","error"],["Conversation","Conversación"],["Response Validation","Validación de respuesta"],["Raw Payload","Carga útil en bruto"],["View raw payload","Ver carga útil en bruto"],["Response Preview","Vista previa de respuesta"],["Apply translations from selected rows","Aplicar traducciones de las filas seleccionadas"],["Here you can edit the translation result individually and send it into Translator++","Aquí puedes editar el resultado de la traducción individualmente y enviarlo a Translator++"],["Open ChatGPT Settings","Abrir configuración de ChatGPT"],["Help","Ayuda"],["File list","Lista de archivos"],["Collapse / restore left panel","Contraer / restaurar panel izquierdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Los lotes que no se completen a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas está disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información del actor. (Solo si la opción de información del actor está habilitada en modo por lotes)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Always separate file","Siempre separar archivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separa el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Añadir nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Agrega el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de aviso."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si habilitas esta opción, también necesitas incluir la variable <code>INFO_ACTOR</code> en la plantilla de aviso para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que se agregará al mensaje de prompt. Esto se agregará después del mensaje del sistema y antes del mensaje de prompt real."],["General Settings","Configuración General"],["Always separate file for each batch","Siempre archivo separado para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","Gestor de Lotes"],["This feature is only available if you have a project open.","Esta función solo está disponible si tienes un proyecto abierto."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":true,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","Iniciar servidor"],["Server started","Servidor iniciado"],["Reinstall server","Reinstalar servidor"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","Introduzca la nueva versión de la biblioteca de Traductores que desea instalar.\nLa última versión es: "],["Are you sure you want to install Translators version ","¿Está seguro de que desea instalar la versión de Traductores "],["Failed to install Translators. Please check the console for more details.","Error al instalar Traductores. Por favor, revise la consola para más detalles."],["Translators has been successfully updated to version ","Traductores se ha actualizado exitosamente a la versión "],["General Settings","Configuración General"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":true,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","¿Está seguro de que desea abortar?"],["Process paused!\nPress OK to continue!","¡Proceso pausado!\n¡Presione OK para continuar!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":true,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","Nunca descargar diccionarios de la RAM"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":true,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","¡No se puede iniciar el Proxy de Traducción!\nEl Proxy de Traducción está actualmente disponible solo para patrocinadores de $3 o más."],["Please enter the port number:","Por favor, introduzca el número de puerto:"],["Invalid port : ","Puerto inválido: "],["Port must be a numeric.","El puerto debe ser numérico."],["Port has successfully changed to: ","El puerto se ha cambiado exitosamente a: "],["Connection Info","Información de Conexión"],["Do you want to copy the base URL into the clipboard?","¿Desea copiar la URL base al portapapeles?"],["Use secure protocol(HTTPS)","Usar protocolo seguro (HTTPS)"],["Port","Puerto"],["Connection info","Información de conexión"],["Help","Ayuda"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":true,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","Forzará la codificación del texto a la seleccionada al escribir los scripts. (en blanco = automático)<br />. Puedes usar este campo para convertir el script a <b>UTF-16</b> para que el juego sea jugable sin cambiar tu configuración regional a japonés."],["Use legacy parser","Usar analizador legado"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","Usar analizador legado (antiguo) en lugar del nuevo.<br />El analizador legado es más rápido, pero poco confiable en algunos juegos.<br />El nuevo analizador es más confiable, pero más lento."],["Select TyranoBuilder packaged game","Seleccionar juego empaquetado de TyranoBuilder"],["Select the exe file of your packaged game.","Selecciona el archivo exe de tu juego empaquetado."],["Target folder","Carpeta de destino"],["Select destination folder. The process will replace the existing files.","Selecciona la carpeta de destino. El proceso reemplazará los archivos existentes."],["Extraction completed","Extracción completada"],["Close","Cerrar"],["Next","Siguiente"],["Please select game executable file","Por favor selecciona el archivo ejecutable del juego"],["Back","Atrás"],["The game is fully loaded, proceed!","El juego está completamente cargado, ¡procede!"],["Extract data","Extraer datos"],["Open extracted folder","Abrir carpeta extraída"],["Extract resources","Extraer recursos"],["Select the game executable","Selecciona el ejecutable del juego"],["Select the game executable or asar file to extract","Selecciona el archivo ejecutable o asar del juego para extraer"],["Target directory","Directorio de destino"],["Select the target directory to store the unpacked files","Selecciona el directorio de destino para almacenar los archivos descomprimidos"],["Electron archive file detected. Do you want to extract the asar file instead?","Archivo de archivo Electron detectado. ¿Quieres extraer el archivo asar en su lugar?"],["Tyranobuilder Game Extractor","Extractor de Juegos Tyranobuilder"],["Before you create a new project, please make sure that :","Antes de crear un nuevo proyecto, por favor asegúrate de que:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","El complemento <b>Kirikiri Adventure Game parser</b> está instalado en tu Translator++"],["Your game is fully extracted.","Tu juego está completamente extraído."],["Extract TyranoBuilder package","Extraer paquete TyranoBuilder"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Todos los archivos .ks & .tjs están en texto plano (sin compilar, sin codificar y sin encriptar)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Algunas de las acciones modificarán tu juego. <b>¡Así que asegúrate de crear una copia de seguridad de tu juego!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Selecciona el archivo ejecutable del juego. Este archivo es el archivo principal del juego que se usará para extraer los datos del juego."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","En juegos Tyrano, usualmente es el archivo <b>index.html</b> o <b>exe</b>."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Lista de las posibles codificaciones de caracteres. <b>¡El orden importa!</b>. Puedes arrastrar para ordenar la lista."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","El juego creado con TyranoBuilder está en codificación <b>UTF-8</b>"],["Literal tags are the tags that will be escaped into Translator++ editor.","Las etiquetas literales son las etiquetas que se escaparán en el editor de Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> son obligatorios."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","Las etiquetas <b>[r]</b> serán interpoladas por Translator++ en una nueva línea. Así que no necesitas escribir <b>[r]</b> explícitamente."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","El script Kirikiri (.ks) es altamente personalizable y permite a los desarrolladores crear sus propias etiquetas."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ puede manejar etiquetas estándar como nombres de personajes que comienzan con un numeral (#)."],["However, Translator++ may not be able to handle custom tags created by developers.","Sin embargo, Translator++ puede no ser capaz de manejar etiquetas personalizadas creadas por desarrolladores."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Por lo tanto, puede que necesites definir las etiquetas y atributos que necesitan ser traducidos y aquellos que necesitan ser marcados como nombres de actores."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>Por favor, visita la <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">referencia de etiquetas de TyranoBuilder</a> para más información sobre las etiquetas.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","Puede que necesites <input type=\"button\" value=\"extraer tu juego\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> y analizar el script <b>ks</b> dentro de él antes de comenzar el proyecto."],["Create Project","Crear Proyecto"],["Play last build","Reproducir última compilación"],["Extract TyranoBuilder","Extraer TyranoBuilder"],["Create playable package","Crear paquete jugable"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":true,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","General"],["Executable file location","Ubicación del archivo ejecutable"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tRuta al archivo ejecutable de la aplicación.\n\t\t\t"],["Field can not be empty!","¡El campo no puede estar vacío!"],["Service","Servicio"],["End Point","Punto Final"],["Auto translation service to use.","Servicio de traducción automática a utilizar."],["Target Language","Idioma Objetivo"],["The language to translate into","El idioma al que se traducirá"],["Source Language","Idioma Fuente"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","El idioma original del juego. \"auto\" también es compatible con algunos puntos finales, pero generalmente no se recomienda"],["Files","Archivos"],["Directory","Directorio"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Directorio para buscar archivos de traducción en caché. Puede usar marcadores de posición: {GameExeName}, {Lang}"],["Output File","Archivo de Salida"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","Archivo en el que se insertarán las traducciones generadas. Se pueden usar marcadores de posición: {GameExeName}, {Lang}"],["Substitution File","Archivo de Sustitución"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","Archivo que contiene sustituciones aplicadas antes de las traducciones. Se pueden usar marcadores de posición: {GameExeName}, {Lang}"],["Preprocessors File","Archivo de Preprocesadores"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","Archivo que contiene preprocesadores para aplicar antes de enviar un texto a un traductor. Se pueden usar marcadores de posición: {GameExeName}, {Lang}"],["Text Frameworks","Marcos de Texto"],["Enable/Disable auto translation for Unity's text frameworks.","Activar/Desactivar la traducción automática para los marcos de texto de Unity."],["Behaviour","Comportamiento"],["Max Characters Per Translation","Máximo de Caracteres por Traducción"],["Max characters per text to translate. Max 2500.","Máximo de caracteres por texto a traducir. Máximo 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Si se debe ignorar o no los espacios en blanco, incluyendo saltos de línea, en las claves de diálogo"],["Whether or not to ignore whitespace, including newlines, in NGUI","Si se debe ignorar o no los espacios en blanco, incluyendo saltos de línea, en NGUI"],["Minimum Dialogue Chars","Mínimo de Caracteres de Diálogo"],["The length of the text for it to be considered a dialogue","La longitud del texto para que se considere un diálogo"],["Force Split Text After Characters","Forzar División de Texto Después de Caracteres"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Dividir el texto en múltiples líneas una vez que el texto traducido exceda este número de caracteres. (0 significa sin división)"],["Whether or not to copy hooked texts to clipboard","Si se debe copiar o no los textos enganchados al portapapeles"],["MaxClipboardCopyCharacters","Máximo de Caracteres para Copiar al Portapapeles"],["Max number of characters to hook to clipboard at a time","Número máximo de caracteres para enganchar al portapapeles a la vez"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Si el complemento debe intentar \"redimensionar lo mejor posible\" los componentes de la interfaz de usuario tras la traducción"],["Indicates whether batching of translations should be enabled for supported endpoints","Indica si se debe habilitar el procesamiento por lotes de traducciones para los endpoints compatibles"],["Indicates whether or not to use translations from the included static translation cache","Indica si se deben usar traducciones de la caché de traducción estática incluida"],["Override Font","Anular Fuente"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Anula las fuentes utilizadas para los textos al actualizar componentes de texto. NOTA: Solo funciona para UGUI"],["Override Font TextMeshPro","Anular Fuente TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Anula las fuentes utilizadas para los textos al actualizar componentes de texto. NOTA: Solo funciona para TextMeshPro"],["Resize UI Line Spacing Scale","Escala de Espaciado de Línea de Interfaz de Usuario"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","Un valor decimal por el que se debe escalar el espaciado de línea predeterminado durante el redimensionamiento de la interfaz, por ejemplo: 0.80. NOTA: Solo funciona para UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","Indica si el comportamiento de redimensionamiento de la interfaz debe aplicarse a todos los componentes de la interfaz, independientemente de si están traducidos."],["Ignore Text Starting With","Ignorar Texto que Comience Con"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Indica que el complemento debe ignorar cualquier cadena que comience con ciertos caracteres. Esta es una lista separada por ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","Indica si se debe habilitar el \"Modo de Compatibilidad de Obtención de Texto\". Solo debe habilitarse si el juego lo requiere."],["GameLog Text Paths","Rutas de Texto de Registro del Juego"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Indica rutas específicas para objetos del juego que el juego usa como \"componentes de registro\", donde añade o antepone texto continuamente. Requiere conocimiento experto para configurar. Esta es una lista separada por ';'."],["Romaji Post Processing","Procesamiento Posterior de Romaji"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","Indica qué tipo de procesamiento posterior realizar en textos 'traducidos' de romaji. Esto puede ser importante en ciertos juegos porque la fuente utilizada no soporta correctamente varios diacríticos. Esta es una lista separada por ';'. Valores posibles: [\"EliminarTodosLosDiacríticos\", \"ReemplazarMacronConCircunflejo\", \"EliminarApóstrofes\"]"],["Translation Post Processing","Procesamiento Posterior de Traducción"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Indica qué tipo de procesamiento posterior realizar en textos traducidos (no romaji). Valores posibles: [\"EliminarTodosLosDiacríticos\", \"ReemplazarMacronConCircunflejo\", \"EliminarApóstrofes\", \"ReemplazarCaracteresAnchos\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Indica si los resultados de las búsquedas de expresiones regulares deben enviarse al archivo de salida especificado."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Indica si las diferencias de espacios en blanco deben enviarse al Archivo de Salida especificado."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Indica si el resultado completo de las traducciones divididas por regex debe enviarse al Archivo de Salida especificado."],["Indicates that the plugin should generate translations without variables when using substitutions.","Indica que el complemento debe generar traducciones sin variables al usar sustituciones."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Indica que el complemento debe generar traducciones parciales para soportar traducciones de texto mientras se \"desplaza hacia adentro\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Indica que el complemento debe analizar directivas 'TARC' y delimitar traducciones basadas en estas."],["Indicates the plugin should not print out success messages in relation to translations.","Indica que el complemento no debe mostrar mensajes de éxito relacionados con traducciones."],["Blacklisted IMGUI Plugins","Complementos IMGUI en lista negra"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","Si una ventana IMGUI contiene alguno de los strings en esta lista (sin distinguir mayúsculas/minúsculas) en su ensamblado/clase/método, esa interfaz no será traducida. Requiere enlaces MonoMod. Esta es una lista separada por ';'"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Indica si los textos que el complemento considera no traducibles deben enviarse al Archivo de Salida especificado."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Indica que se deben ignorar las reglas para llamadas de métodos virtuales al intentar establecer el texto de un componente de texto. Puede ayudar en algunos casos a establecer el texto de componentes obstinados."],["Max Text Parser Recursion","Máxima Recursión del Analizador de Texto"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Indica cuántos niveles de recursión se permiten cuando se analiza el texto para que pueda traducirse en diferentes partes. Esto puede usarse con regex divisores en escenarios avanzados. El valor predeterminado de uno esencialmente significa que la recursión está deshabilitada."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Preprocesará y decodificará entidades HTML antes de enviarlas para traducción. Algunos traductores fallan cuando se envían entidades HTML."],["Will enable automated handling of rich text (text with markup).","Habilitará el manejo automatizado de texto enriquecido (texto con marcado)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Indica si deben habilitarse mensajes de registro útiles relacionados con el traductor. Puede ser útil al traducir basándose en recursos redirigidos."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Indica que el complemento debe usar enlaces MonoMod en lugar de enlaces harmony."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Indica que el complemento debe inicializar el puente de desvío harmony, lo que permite que los enlaces harmony funcionen en un entorno donde System.Reflection.Emit no existe (generalmente tales configuraciones son manejadas por administradores de complementos, así que no lo uses cuando uses un administrador de complementos)."],["Redirected Resource Detection Strategy","Estrategia de Detección de Recursos Redirigidos"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Indica si y cómo el complemento debe intentar reconocer recursos redirigidos para evitar traducciones dobles."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Indica si el complemento debe enviar texto que exceda <b>'Máximo de Caracteres por Traducción'</b> sin traducirlo."],["Texture","Textura"],["Texture Directory","Directorio de Texturas"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Directorio para volcar texturas y raíz de directorios para cargar imágenes. Puede usar marcadores: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Indica si el plugin intentará reemplazar imágenes en el juego con las del Directorio de Texturas."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Indica si el plugin volcará texturas que puede reemplazar al Directorio de Texturas. Tiene un impacto significativo en el rendimiento."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","Indica si activar/desactivar la traducción con el atajo ALT+T también afectará a las texturas. No garantizado para todas las texturas. Tiene un impacto significativo en el rendimiento."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Indica si el plugin debe escanear texturas al cargar la escena. Esto permite al plugin encontrar y (posiblemente) reemplazar más texturas."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Indica si el plugin debe intentar enlazar SpriteRenderer. Es una opción separada porque SpriteRenderer no se puede enlazar correctamente y la solución implementada podría tener un impacto teórico en el rendimiento en ciertas situaciones."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Indica si se deben cargar texturas no modificadas. Las modificaciones se determinan basándose en el hash en el nombre del archivo. Solo habilite esto para depuración, ya que puede causar rarezas."],["Texture Hash Generation Strategy","Estrategia de Generación de Hash de Textura"],["Indicates how the mod identifies pictures through hashes.","Indica cómo el mod identifica imágenes a través de hashes."],["Duplicate Texture Names","Nombres de Textura Duplicados"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Indica nombres específicos de textura que están duplicados en el juego. La lista está separada por ';'"],["Indicates if the plugin should detect duplicate texture names.","Indica si el plugin debe detectar nombres de textura duplicados."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Indica que el plugin debe usar una estrategia diferente para cargar imágenes, que puede ser relevante si el motor del juego es antiguo."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Indica que todas las texturas cargadas deben mantenerse en memoria para un rendimiento óptimo. Deshabilite para disminuir el uso de memoria."],["Resource Redirector","Redireccionador de Recursos"],["Preferred Storage Path","Ruta de Almacenamiento Preferida"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Indica el almacenamiento preferido para recursos redirigidos en relación con el Traductor Automático. Puede usar marcadores: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","Indica si los TextAssets deben ser redirigidos"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Indica si el complemento debe registrar en la consola todos los recursos cargados. Útil para determinar qué se puede enganchar"],["Indicates if translatable resources that are found should be dumped","Indica si los recursos traducibles que se encuentran deben ser volcados"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","Cuando los archivos están en archivos ZIP en PreferredStoragePath, estos archivos se indexan en memoria para evitar realizar comprobaciones de E/S al cargarlos. Habilitar esta opción hará lo mismo para archivos físicos"],["HTTP","HTTP"],["User Agent","Agente de Usuario"],["Override the user agent used by APIs requiring a user agent","Anular el agente de usuario utilizado por las APIs que requieren uno"],["Indiciates whether certificate validations for the .NET API should be disabled","Indica si deben deshabilitarse las validaciones de certificado para la API .NET"],["Translation Aggregator","Agregador de Traducción"],["Width","Ancho"],["The total width of the translation aggregator window","El ancho total de la ventana del agregador de traducción"],["Height","Altura"],["The width (per translator) of the translation aggregator window.","El ancho (por traductor) de la ventana del agregador de traducción."],["Enabled Translators","Traductores Habilitados"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","Los IDs de los puntos finales de traducción que han sido habilitados en la ventana del agregador de traducción. La lista está separada por ';'"],["Google","Google"],["ServiceUrl","URL del Servicio"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","OPCIONAL, puede usarse para dirigir las solicitudes de la API de Google a una URL diferente. Puede usarse para eludir GFWoC"],["Google Legitimate","Google Legítimo"],["Google API Key","Clave de la API de Google"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","OPCIONAL, necesaria si GoogleTranslateLegitimate está configurado"],["Bing Legitimate","Bing Legítimo"],["OcpApim Subscription Key","Clave de Suscripción OcpApim"],["OPTIONAL, needed if BingTranslateLegitimate is configured","OPCIONAL, necesario si BingTranslateLegitimate está configurado"],["Baidu","Baidu"],["Baidu App Id","ID de Aplicación Baidu"],["OPTIONAL, needed if BaiduTranslate is configured","OPCIONAL, necesario si BaiduTranslate está configurado"],["BaiduAppSecret","Secreto de Aplicación Baidu"],["Yandex","Yandex"],["Yandex API Key","Clave API de Yandex"],["OPTIONAL, needed if YandexTranslate is configured","OPCIONAL, necesario si YandexTranslate está configurado"],["Watson","Watson"],["Url","URL"],["OPTIONAL, needed if WatsonTranslate is configured","OPCIONAL, necesario si WatsonTranslate está configurado"],["Key","Clave"],["DeepL","DeepL"],["MinDelay","Retraso Mínimo"],["OPTIONAL, used for throttling DeepL","OPCIONAL, usado para limitar DeepL"],["MaxDelay","Retraso Máximo"],["DeepL Legitimate","DeepL Legítimo"],["OPTIONAL, required if DeepLLegitimate is configured","OPCIONAL, requerido si DeepLLegitimate está configurado"],["Custom","Personalizado"],["Optional, needed if Custom Translated is configured","Opcional, necesario si Traducción Personalizada está configurada"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","Ruta de Instalación"],["Optional, needed if Lec Power Translator 15 is configured","Opcional, necesario si Lec Power Translator 15 está configurado"],["Debug","Depuración"],["Enables the console. Do not enable if other plugins (managers) handles this","Habilita la consola. No habilites si otros complementos (gestores) manejan esto"],["Enables extra logging for debugging purposes","Habilita registro adicional para fines de depuración"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","Ruta de Instalación de ezTrans."],["Migrations","Migraciones"],["Used to enable automatic migrations of this configuration file","Usado para habilitar migraciones automáticas de este archivo de configuración"],["Tag","Etiqueta"],["Tag representing the last version this plugin was executed under. Do not edit","Etiqueta que representa la última versión bajo la cual se ejecutó este complemento. No edites"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":true,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","¡Se necesita XUnity Translator para realizar esta acción\nPor favor, instálalo a través del Instalador de Aplicaciones de Terceros!"],["XUnity.AutoTranslator is found!","¡XUnity.AutoTranslator encontrado!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++ detecta que XUnity.AutoTranslator ya está instalado. Translator++ usará los datos de traducción existentes para iniciar un nuevo proyecto de traducción."],["XUnity.AutoTranslator is not found!","¡XUnity.AutoTranslator no encontrado!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","El asistente te guiará para instalar XUnity.AutoTranslator en el juego."],["Next","Siguiente"],["Given path: ","Ruta dada: "],["\nis not an Unity game. Do you still want to proceed?","\nno es un juego de Unity. ¿Aún quieres continuar?"],["Patch successfully installed!\r\n","¡Parche instalado exitosamente!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","La configuración se generará cuando juegues por primera vez.\r\n"],["Open the game now?","¿Abrir el juego ahora?"],["Finish","Finalizar"],["Update current project?","¿Actualizar el proyecto actual?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":true,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","Número máximo de líneas en el cuadro de mensaje."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","El valor predeterminado es 4. Escribe 0 para desactivar esta función. Si el número de líneas en el cuadro de mensaje es mayor que este número, Translator++ generará un nuevo cuadro de mensaje para evitar que los textos desborden los cuadros."],["Use shell copy if possible","Usar copia de shell si es posible"],["Use shell copy instead of native NodeJS copy handler.","Usar copia de shell en lugar del manejador de copia nativo de NodeJS."],["Use shell copy","Usar copia de shell"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","El editor WRPGE no está instalado\r\nPor favor, instálalo desde el menú T++ > Instalador de aplicaciones de terceros\r\n\r\n¿Abrir el instalador de aplicaciones de terceros ahora?"],["Unable to determina WRPGE path.","No se puede determinar la ruta de WRPGE."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++ está a punto de instalar el editor WRPGE en la carpeta de destino.\r\n¿Continuar?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","La ruta de desarrollo no está definida.\nDeberías inyectar tu juego una vez para generar la ruta de desarrollo."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","Traduce un juego Wolf RPG hasta la versión 3.330 con la biblioteca WolfJs. El analizador predeterminado de Wolf RPG para Translator++."],["Wolf RPG Editor games","Juegos de Wolf RPG Editor"],["Parsing Wolf RPG Game with","Analizando juego Wolf RPG con"],["Wolf RPG Editor game","Juego de Wolf RPG Editor"],["Select the game's executable file","Selecciona el archivo ejecutable del juego"],["Engine version","Versión del motor"],["Detected WolfRPG Engine version of the selected game","Versión del motor WolfRPG detectada para el juego seleccionado"],["Heads up!\r\n","¡Atención!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\n¡No parece ser un archivo ejecutable de Wolf RPG!\r\n¿Estás seguro de querer iniciar un proyecto Wolf RPG desde este punto de entrada?"],["Create a new project","Crear un nuevo proyecto"],["Please specify a game to be processed!","¡Por favor, especifica un juego para procesar!"],["Set dev path. Path to the directory of the translated game.","Establecer ruta de desarrollo. Ruta al directorio del juego traducido."],["Play last build","Jugar la última compilación"],["Open editor","Abrir editor"],["Open Wolf RPG Editor online manual","Abrir manual en línea del editor Wolf RPG"],["Open Wolf RPG Editor english manual","Abrir manual en inglés del editor Wolf RPG"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","No se puede encontrar el archivo del manual.\nPor favor, instala el editor Wolf RPG a través del instalador de aplicaciones de terceros."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":true,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","Iniciar traducción desde documentos similares a XML. Soporta formatos XML y HTML."],["Create project","Crear proyecto"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":true,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","Traductor del motor YU-RIS"],["Checking up requirements...","Verificando requisitos..."],["Create a new translation project from YU-RIS visual novel engine","Crear un nuevo proyecto de traducción desde el motor de novela visual YU-RIS"],["Next","Siguiente"],["Select YU-RIS game","Seleccionar juego YU-RIS"],["Select the game's executable file","Selecciona el archivo ejecutable del juego"],["Engine version","Versión del motor"],["Detected YU-RIS version of the selected game","Versión YU-RIS detectada del juego seleccionado"],["Create a new project","Crear un nuevo proyecto"],["Invalid target game :","Juego objetivo inválido :"],["Source material do not match the current translation project!","¡El material fuente no coincide con el proyecto de traducción actual!"],["Select the repack method.","Selecciona el método de reempaquetado."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>Reempaquetar en el archivo(s) YPF original</b><br />Reempaquetará la traducción al paquete original. Puede tomar más tiempo extraer el paquete original, aplicar la traducción y reempaquetarlo nuevamente.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>Reempaquetar como un archivo de parche YPF</b><br>Reempaquetará la traducción como un archivo de parche separado (ej. update9.ypf). De esta manera, es posible traducir el juego sin modificar los archivos ypf originales. Combina esto con la opción <b>No copiar material, solo inyectar traducción</b> de Copiar material para un proceso de parche más rápido.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","La versión de reempaquetado objetivo debe coincidir con la versión de tu juego. Ingresa la versión mayor y menor separadas por un punto. Por ejemplo: <b>0.466</b>. Por defecto, Translator++ detectará la versión del motor cuando crees el proyecto."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":true,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","Constructor de formularios"],["Run","Ejecutar"],["New Project (ctrl+n)","Nuevo proyecto (ctrl+n)"],["Open (ctrl+o)","Abrir (ctrl+o)"],["Save file (ctrl+s)","Guardar archivo (ctrl+s)"],["Save As (ctrl+shift+s)","Guardar como (ctrl+shift+s)"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ayuda"],["Select file in the current workspace","Seleccionar archivo en el espacio de trabajo actual"],["file path","ruta del archivo"],["Create shortcut of the current script","Crear acceso directo del script actual"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":true,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"parameters":[]},"/find.html":{"data":[["Find","Buscar"],["Replace","Reemplazar"],["Put","Poner"],["Target","Objetivo"],["Grid","Cuadrícula"],["Context","Contexto"],["Tag","Etiqueta"],["Comment","Comentario"],["Untranslated rows","Filas no traducidas"],["Refine","Refinar"],["Case sensitive","Sensible a mayúsculas"],["Transpile \\r\\n\\t","Transpilar \\r\\n\\t"],["RegExp","Expresión regular"],["All files","Todos los archivos"],["Select All Columns","Seleccionar todas las columnas"],["Find all string above and replace with :","Buscar todas las cadenas arriba y reemplazar con:"],["Original text:","Texto original:"],["Text to put :","Texto a poner:"],["into: ","en:"],["Search all files","Buscar en todos los archivos"],["Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)","Escribe la palabra clave y presiona enter. Puedes usar patrones glob (ej.: *.png)"],["Drag to select, Shift+Drag to unselect","Arrastra para seleccionar, Shift+Arrastra para deseleccionar"],["Select target column","Seleccionar columna objetivo"],["A line in the original text to find. Press alt+enter to add a new line.","Una línea en el texto original para encontrar. Presiona alt+enter para añadir una nueva línea."],["Translation","Traducción"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":true,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","No se puede encontrar el archivo relacionado con los datos"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Para solucionar esto, corrige el campo <b>Ubicación del material crudo</b> en las <a href=\"#\" class=\"openProjectProperties\">Propiedades del proyecto</a>"],["Copy path to clipboard","Copiar ruta al portapapeles"],["Path has been copied to clipboard.","La ruta ha sido copiada al portapapeles."],["Open folder","Abrir carpeta"],["Open with external application","Abrir con aplicación externa"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","Abrir con..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~usar traducción predeterminada~"],["Column","Columna"],["Do you want to delete all context translation on the currently selected row?","¿Quieres eliminar todas las traducciones de contexto en la fila seleccionada actualmente?"],["Do you want to delete all translation on the currently active row?","¿Quieres eliminar todas las traducciones en la fila activa actualmente?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":true,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","tipo inválido addonObj"],["invalid type addonObj.addons","tipo inválido addonObj.addons"],["You are not eligible to get this addon","No eres elegible para obtener este complemento"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":true,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Debes guardar el proyecto actual primero antes de crear un acceso directo a Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Esta función solo está disponible si estás usando la versión Developer de Translator++. Puedes cambiar a la versión Developer usando Utilidades Básicas -> Cambiar Core NWJS."]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/find.js":{"data":[["Action","Acción"],["Append tags","Añadir etiquetas"],["Remove tags","Eliminar etiquetas"],["Set tags","Establecer etiquetas"],["Do nothing","No hacer nada"],["Close","Cerrar"],["Proceed","Proceder"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","¡Palabra clave muy corta!\n¿Estás intentando buscar todas las filas? Prueba usando asterisco '*' como palabra clave."],["Found nothing!<br />Don't forget to set the Target search field.","¡No se encontró nada!<br />No olvides configurar el campo de búsqueda de destino."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","¡No se encontró nada para reemplazar!<br />La función de reemplazo no reemplaza nada en la columna de clave."],["Replace '","Reemplazar '"],["' with '","' con '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","¿?\r\n¡Aún no hemos creado la función de deshacer para esto!\n¿Estás seguro de que quieres proceder?"],["click to go","haz clic para ir"],["This will replace any translation found in target colum,\nAre you sure?","Esto reemplazará cualquier traducción encontrada en la columna objetivo,\n¿Estás seguro?"],["Keyword too short!","¡Palabra clave demasiado corta!"],["Not found!","¡No encontrado!"],["Are you sure want to execute the following script?","¿Estás seguro de que quieres ejecutar el siguiente script?"],["For ","Para "],[" selected item(s)?"," ¿elemento(s) seleccionado(s)?"],[" Select all"," Seleccionar todo"],[" Invert selection"," Invertir selección"],[" Clear selection"," Limpiar selección"],[" Set Red tag"," Establecer etiqueta Roja"],[" Set Yellow tag"," Establecer etiqueta Amarilla"],[" Set Green tag"," Establecer etiqueta Verde"],[" Set Blue tag"," Establecer etiqueta Azul"],[" Set Gold tag"," Establecer etiqueta Dorada"],[" More tags..."," Más etiquetas..."],[" Clear tags"," Limpiar etiquetas"],[" Create Automation"," Crear Automatización"],[" Run Automation"," Ejecutar Automatización"],[" Clear Automation","Limpiar automatización"],["Are you sure want to clear all quick launch scripts?","¿Estás seguro de que quieres limpiar todos los scripts de lanzamiento rápido?"],[" Clear translation","Limpiar traducción"],["Do you want to clear translations of the selected items?","¿Quieres limpiar las traducciones de los elementos seleccionados?"],[" Delete rows","Eliminar filas"],["Do you want to remove selected rows?\nYou can not undo this action!","¿Quieres eliminar las filas seleccionadas?\n¡No puedes deshacer esta acción!"],[" With selection ...","Con selección ..."],["Always on top","Siempre visible"],["Default","Predeterminado"],["Blur opacity","Opacidad de desenfoque"],["Type regex with the modifier","Escribe regex con el modificador"],["Use $n to replace a group. e.g. $1","Usa $n para reemplazar un grupo. ej. $1"],["Find","Buscar"],["Replace","Reemplazar"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":true,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","Ocultar contraseña"],["Show password","Mostrar contraseña"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":true,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","Algunas configuraciones requieren que reinicies la aplicación para que surtan efecto.\nPor favor, guarda tu trabajo y reinicia Translator++."],["Pleae select the name for your configuration.","Por favor, selecciona el nombre para tu configuración."],["Translator Engine configuration","Configuración del motor de traducción"],["Translator engine version.","Versión del motor de traducción."],["By.","Por."],["No option for this engine","Sin opción para este motor"],["License","Licencia"],["Can not disable this addon","No se puede desactivar este complemento"],["Requirements","Requisitos"],["What is this?","¿Qué es esto?"],["Uninstall","Desinstalar"],["Update","Actualizar"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","Complemento instalado con éxito.\r\nEs posible que sea necesario reiniciar Translator++ para que algunos complementos surtan efecto."],["WARNING!\n","¡ADVERTENCIA!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","Este complemento está marcado como \"cambio de analizador\". Tus proyectos antiguos relacionados con este complemento podrían no funcionar como se esperaba. Se recomienda hacer una copia de seguridad de tu proyecto antes de instalar este complemento.\nPuedes importar tus traducciones existentes al nuevo proyecto creado.\n\n¿Deseas instalar "],["Do you want to install ","¿Quieres instalar "],["Add-on","Complemento"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","se instaló con éxito.\r\nEs posible que sea necesario reiniciar Translator++ para que algunos complementos surtan efecto."],["Add-on version.","Versión del complemento."],["No option for this add-on","Sin opción para este complemento"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++ escribirá en el registro de Windows.\r\n¿Estás seguro?"],["Error parsing patterns:","Error al analizar patrones:"],["Do you really want to clear the custom escaper?","¿Realmente quieres borrar el escapador personalizado?"],["Do you really want to reset the custom escaper?","¿Realmente quieres restablecer el escapador personalizado?"],["You are currently on the latest version.\nDo you still want to update?","Actualmente estás en la última versión.\n¿Aún quieres actualizar?"],["This option will open your default browser to login.\nDo you want to continue?","Esta opción abrirá tu navegador predeterminado para iniciar sesión.\n¿Quieres continuar?"],["Login with Browser","Iniciar sesión con el navegador"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","Tu navegador se ha abierto en <b>dreamsavior.net/gettoken/</b>.<br>El inicio de sesión se completará automáticamente una vez que inicies sesión.<br><br>Si el inicio automático no funciona, copia tu token de esa página y pégalo abajo:"],["There is no default translator selected.\nChange the default translator to Google!","No hay un traductor predeterminado seleccionado.\n¡Cambia el traductor predeterminado a Google!"],["Change Stagging Path to :","Cambiar la ruta de ensayo a:"],["Move the content of current Stagging Path into the new one?","¿Mover el contenido de la ruta de ensayo actual a la nueva?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","Se ha instalado el/los complemento(s).\nTranslator++ necesita reiniciarse para que surta efecto."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","¿Realmente quieres borrar toda la configuración y restablecer Translator++ a los valores predeterminados?\nTen en cuenta que esta acción es irreversible.\nPor favor, haz una copia de seguridad de tu proyecto antes de proceder."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","Translator++ podría no funcionar normalmente si no corriges el error.\n¿Quieres cerrar la ventana de opciones?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":true,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Deberías guardar el proyecto actual primero antes de crear un acceso directo a Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Esta función solo está disponible si estás usando la versión Developer de Translator++. Puedes cambiarte a la versión Developer usando Utilidades Básicas -> Cambiar Core NWJS."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>¡No se puede ejecutar el intérprete PHP!</b><br />\n\t\t\t\tTranslator++ necesita PHP CLI para ejecutar algunos procedimientos obligatorios.<br />\n\t\t\t\tEste error suele ocurrir porque tu computadora <b>no tiene instalada la <a href=\"http://dreamsavior.net/download/#TPPSysreq\">versión correcta de Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Por favor, instala el <a href=\"http://dreamsavior.net/download/#TPPSysreq\">tiempo de ejecución requerido</a>.</li>\n\t\t\t\t\t\t<li>Y por favor, mueve el directorio de instalación de Translator++ a otra carpeta si has instalado todo el tiempo de ejecución y aún tienes este error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPor favor, revisa la <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentación</a> para más información sobre este síntoma."],["Initialization Error!","¡Error de inicialización!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":true,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"parameters":[]},"/js/trans.js":{"data":[["Original Text","Texto original"],["Initial","Inicial"],["Machine translation","Traducción automática"],["Better translation","Traducción mejorada"],["Best translation","Mejor traducción"],["Loading","Cargando"],["Error!","¡Error!"],["Error processing init file : ","Error procesando archivo de inicio: "],["Error! File list not found in init file at : ","¡Error! Lista de archivos no encontrada en el archivo de inicio en: "],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","Esto significa que tu juego no fue analizado exitosamente. Por favor, visita https://dreamsavior.net/?p=1311 para posibles soluciones a este problema."],["Done!","¡Hecho!"],["All done!","¡Todo listo!"],["Error opening file : ","Error abriendo archivo: "],["error opening file (open): ","error abriendo archivo (abrir): "],["Project properties - Staging path error!","Propiedades del proyecto - ¡Error en la ruta de preparación!"],["Project properties","Propiedades del proyecto"],["untitled project","proyecto sin título"],["create file list","crear lista de archivos"],["Finished","Terminado"],["All process finished!","¡Todo el proceso terminado!"],["Open Explorer","Abrir Explorador"],["Opening file!","¡Abriendo archivo!"],["Assigning new staging path : ","Asignando nueva ruta de preparación: "],["Success!","¡Éxito!"],["Failed!","¡Fallido!"],["Collecting paths","Recolectando rutas"],["Path : '","Ruta: '"],["' doesn't exist","' no existe"],[" file(s) collected!"," ¡archivo(s) recolectado(s)!"],["Start importing data!","¡Comenzar a importar datos!"],["Importing : ","Importando: "],["All Done!","¡Todo listo!"],[" is not a valid object name"," no es un nombre de objeto válido"],[" is not a valid directory name"," no es un nombre de directorio válido"],[" is already exist"," ya existe"],["Error opening file :","Error al abrir el archivo:"],["Error executing :","Error al ejecutar:"],["Are you sure want to execute the following script?","¿Estás seguro de que quieres ejecutar el siguiente script?"],["Clear quick launch","Limpiar lanzamiento rápido"],["Are you sure want to clear quick launch?","¿Estás seguro de que quieres limpiar el lanzamiento rápido?"],["How to add Automation here","Cómo agregar Automatización aquí"],["Select all","Seleccionar todo"],["Clear selection","Limpiar selección"],["Select 100%","Seleccionar 100%"],["Select <100%","Seleccionar <100%"],["Select progress ≥ ...","Seleccionar progreso ≥ ..."],["Select completed","Seleccionar completados"],["Invert selection","Invertir selección"],["Toggle mark as complete","Alternar marcar como completado"],["With all","Con todos"],["With ","Con "],[" selected"," seleccionados"],["Mark as complete","Marcar como completado"],["Un-mark as complete","Desmarcar como completado"],["Batch translation","Traducción por lotes"],["Send to...","Enviar a..."],["Wrap texts","Envolver textos"],["Trim","Recortar"],["Auto padding","Relleno automático"],["Context Tool","Herramienta de contexto"],["Create Automation","Crear automatización"],["For each object","Para cada objeto"],["For each row","Para cada fila"],["Run Automation","Ejecutar automatización"],["Import from...","Importar desde..."],["Trans File","Archivo de traducción"],["Spreadsheets","Hojas de cálculo"],["RPGMTransPatch Files","Archivos de Parche RPGMTrans"],["Export into...","Exportar a..."],["A folder","Una carpeta"],["Zipped Game Patch","Parche de Juego Comprimido"],["Comma Separated Value (csv)","Valores Separados por Coma (csv)"],["Excel 2007 Spreadsheets (xlsx)","Hojas de cálculo Excel 2007 (xlsx)"],["Excel Spreadsheets (xls)","Hojas de cálculo Excel (xls)"],["ODS Spreadsheets","Hojas de cálculo ODS"],["Html Spreadsheets","Hojas de cálculo Html"],["RMTrans Patch","Parche RMTrans"],["Inject Translation","Inyectar Traducción"],["Revert to original","Revertir al original"],["Clear translation","Limpiar traducción"],["Delete files","Eliminar archivos"],["Properties","Propiedades"],["Select progress greater than","Seleccionar progreso mayor que"],["Please input a number","Por favor ingrese un número"],["Do you want to clear translation?","¿Desea limpiar la traducción?"],["Add comment","Agregar comentario"],["Remove comment","Eliminar comentario"],["added to reference table!","¡agregado a la tabla de referencia!"],["Can not modify Column 0","No se puede modificar la Columna 0"],["Unable to delete table : ","No se puede eliminar la tabla: "],["Can not remove key column!","¡No se puede eliminar la columna clave!"],["Please open or create a project first","Por favor, abre o crea un proyecto primero"],["Column name can not be empty!","¡El nombre de la columna no puede estar vacío!"],["Invalid column index!","¡Índice de columna inválido!"],["Please open or create a new project first!","¡Por favor, abre o crea un nuevo proyecto primero!"],["You should not edit key value","No deberías editar el valor clave"],["Ilegal value","Valor ilegal"],["That value already exist!","¡Ese valor ya existe!"],["The maximum number of columns for this project has been reached, so you cannot add any more.","Se ha alcanzado el número máximo de columnas para este proyecto, por lo que no puedes agregar más."],["Are you sure want to abort this process?","¿Estás seguro de que quieres abortar este proceso?"],["Process paused!\nPress OK to continue!","¡Proceso pausado!\nPresiona OK para continuar!"],["Unable to process, project not found","No se puede procesar, proyecto no encontrado"],["Unable to process, data not found","No se puede procesar, datos no