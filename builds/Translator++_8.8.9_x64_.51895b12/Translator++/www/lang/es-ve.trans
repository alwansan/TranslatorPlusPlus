nc":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","customModels.etiquetaPersonalizada"],["model","modelo"],["|","|"],["promptLibrary","bibliotecaDePrompts"],["search","buscar"],["downloadChat","descargarChat"],["newChat","nuevoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","etiquetaDeEntradaDeEndpointApi"],["apiKey.inputLabel","etiquetaDeEntradaDeClaveApi"],["apiVersion.inputLabel","etiquetaDeEntradaDeVersiónApi"],["apiVersion.description","descripciónDeVersiónApi"],["securityMessage","mensajeDeSeguridad"],["apiEndpoint.description","descripciónDeEndpointApi"],["apiEndpoint.warn","advertenciaDeEndpointApi"],["partialImportMessages","mensajesDeImportaciónParcial"],["import","importar"],["name","nombre"],["prompt","prompt"],["clearPrompts","limpiarPrompts"],["morePrompts","másSolicitudes"],["toast.sync","toast.sincronizar"],["toast.stop","toast.detener"],["button.sync","botón.sincronizar"],["button.stop","botón.detener"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Traducir con ChatGPT API por Lotes"],["Model","Modelo"],["The pre-trained model.","El modelo preentrenado."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Parece que la API por Lotes de OpenAI usa una convención de nombres de modelos ligeramente diferente a la API general. Los modelos usados en la API por Lotes tienen un prefijo “-batch”. Por ejemplo, si usas <code>gpt-4.1-mini</code>, el modelo automáticamente se convierte en <code>gpt-4.1-mini-batch</code>.<br />\nSin embargo, al momento de crear este complemento, los modelos por lotes no están listados en los límites de uso de modelos de OpenAI, lo que imposibilita a los usuarios usar la API por Lotes si han configurado el filtro de uso de modelos en “Permitir” (lista blanca).<br />\nEsto probablemente sea un error en la interfaz de usuario de OpenAI que podría corregirse en el futuro.<br />\nPor lo tanto, asegúrate de configurar los límites de uso en OpenAI en modo “Bloquear” (lista negra) para usar la API por Lotes.<br />\nHaz clic aquí para cambiar los límites de uso del modelo: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Columna Fuente"],["The column of the original texts you want to translate.","La columna de los textos originales que deseas traducir."],["Add actor name","Añadir nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añade el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Ignore if already translated","Ignorar si ya está traducido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Si esta opción está marcada, Translator++ ignorará cualquier fila que ya tenga traducciones en su columna."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de solicitud."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene información adicional del actor. Puedes agregar más datos como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["System Message Template","Plantilla de Mensaje del Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","El mensaje del sistema es el encabezado que indica el rol de tu asistente chatGPT. Este mensaje se enviará como el primero en cada lote que envíes a chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Puedes incluir las siguientes variables con el estilo de Literal de Plantilla de JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variables:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origen</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nombre completo del idioma de origen</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nombre completo del idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origen</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensaje predefinido del algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Cadena que representa nueva línea (sustituto de línea).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensajes en el lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Agrega información de los actores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nombre del objeto] : Genera referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCE[Referencia Común]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Incluye algunas líneas anteriores como contexto</li>"],["Body Message Template","Plantilla de Mensaje del Cuerpo"],["Template of the body of your chat.","Plantilla del cuerpo de tu chat."],["Sample conversation","Conversación de ejemplo"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","La API por lotes de ChatGPT te permite traducir tu proyecto de forma asíncrona con un 50% menos de costos, lo que significa que recibirás los resultados de tu traducción <b style=\"color:red\">en un plazo de 24 horas</b> a <b style=\"color:red\">la mitad del costo normal</b>. Esto es particularmente útil para proyectos grandes que no requieren resultados de traducción inmediatos."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Lee más sobre la API por lotes de ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Configuración General"],["This form is using your existing ChatGPT configuration.<br>","Este formulario está utilizando tu configuración existente de ChatGPT.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Puedes cambiar la configuración yendo a los ajustes del Traductor ChatGPT en la ventana de opciones.<br>"],["There you can set the API key, model, and other settings.<br />","Allí puedes establecer la clave API, el modelo y otros ajustes.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Abrir ajustes de ChatGPT\" />"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Ignore translated rows","Ignorar filas traducidas"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a añadir automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt Template","Plantilla del Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensaje del Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aquí puedes explicarle al asistente cuál es su rol.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Tu indicación real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Esta es la indicación real para el asistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Costo general</h3>\n                        El costo general es el costo del mensaje de indicación que envías al asistente sin los textos de traducción reales. El costo se calcula basado en el número de tokens en el mensaje de indicación. Cuantos más tokens tengas, mayor será el costo.<br>\n                        <b>Costo general actual:</b> <span class=\"overheadCost\">0</span> tokens / solicitud."],["Are you sure you want to reset the form?","¿Estás seguro de que quieres reiniciar el formulario?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","¿Estás seguro de que quieres procesar el lote?\nSe incurrirá en costo por esta operación."],["The batch is successfully created. Do you want to open the batch manager?","El lote se creó exitosamente. ¿Quieres abrir el gestor de lotes?"],["OpenAI Batch API Queue","Cola de API de Lotes de OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor selecciona las filas para aplicar la traducción"],["Target Column","Columna Destino"],["The column to put the translation result.","La columna donde poner el resultado de la traducción."],["Import translation from ChatGPT Batch","Importar traducción desde Lote de ChatGPT"],["Translation applied to selected rows","Traducción aplicada a las filas seleccionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Desajuste"],["Failed to load batch list with error: \n","Error al cargar la lista de lotes con error: \n"],["Download Error File","Descargar Archivo de Error"],["Batch is not completed yet","El lote aún no está completado"],["Are you sure you want to cancel this batch?","¿Estás seguro de que quieres cancelar este lote?"],["Cannot cancel completed batch.","No se puede cancelar un lote completado."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Error al cancelar el lote"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar traducción"],["Cancel batch","Cancelar lote"],["Status","Estado"],["Batch ID","ID del lote"],["Input File ID","ID del archivo de entrada"],["End point","Punto final"],["Created at","Creado en"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira en <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Los lotes que no se completan a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas se hace disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada.\"></i>"],["Completed at","Completado en"],["Errors","Errores"],["Batch Item Detail of","Detalle del elemento del lote de"],["ID","ID"],["Completed on","Completado el"],["Model","Modelo"],["Prompt Token","Token del mensaje"],["Completion Token","Token de finalización"],["Total Token","Token total"],["Status Code","Código de estado"],["error","error"],["Conversation","Conversación"],["Response Validation","Validación de respuesta"],["Raw Payload","Carga útil en bruto"],["View raw payload","Ver carga útil en bruto"],["Response Preview","Vista previa de respuesta"],["Apply translations from selected rows","Aplicar traducciones de las filas seleccionadas"],["Here you can edit the translation result individually and send it into Translator++","Aquí puedes editar el resultado de la traducción individualmente y enviarlo a Translator++"],["Open ChatGPT Settings","Abrir configuración de ChatGPT"],["Help","Ayuda"],["File list","Lista de archivos"],["Collapse / restore left panel","Contraer / restaurar panel izquierdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Los lotes que no se completen a tiempo eventualmente pasan a un estado expirado; las solicitudes no terminadas dentro de ese lote se cancelan, y cualquier respuesta a solicitudes completadas está disponible a través del archivo de salida del lote. Se te cobrará por los tokens consumidos de cualquier solicitud completada."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","Chat de OpenAI"],["Target URL","URL objetivo"],["Target end point. You can use any service that supports OpenAI API.","Punto final objetivo. Puedes usar cualquier servicio que soporte la API de OpenAI."],["Sample endpoints","Puntos finales de ejemplo"],["Use this endpoint","Usar este punto final"],["Copy to clipboard","Copiar al portapapeles"],["e.g.","p.ej."],["API Key","Clave de API"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","Ingresa tu Clave de API aquí.<br>El método para obtener la clave de API es diferente para cada servicio.<br>"],["Leave it blank if the service doesn't require API key.","Déjalo en blanco si el servicio no requiere clave de API."],["Model","Modelo"],["The pre-trained model","El modelo preentrenado"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","Para OpenAI, es posible que necesites configurar el modelo permitido para usar (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","Habilitar Contexto"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Habilita el contexto para la traducción. El material previamente traducido arriba del lote actual se incluirá como contexto. <b>También necesitas incluir explícitamente el CONTEXTO en la plantilla</b>"],["Context Character Limit","Límite de Caracteres del Contexto"],["Character limit for the context.","Límite de caracteres para el contexto."],["System Message Template","Plantilla del Mensaje del Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","El mensaje del sistema es el encabezado del mensaje que indicará cuál es el rol de tu asistente chatGPT. Este mensaje se enviará como el primer mensaje de cada lote que envíes a chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Puedes incluir las siguientes variables con el estilo de Literal de Plantilla de JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variables:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origen</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origen</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensaje predefinido del algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Cadena que representa nueva línea (Sustituto de línea).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensajes en el lote.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosario de información de actores. (Solo si la opción de información de actores está habilitada en modo lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde un objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["User message","Mensaje del usuario"],["Assistant's response","Respuesta del asistente"],["Body Message Template","Plantilla del mensaje del cuerpo"],["Template of the body of your chat.","Plantilla del cuerpo de tu chat."],["Enable JailBreak","Habilitar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Habilitar Jailbreak para la traducción. Esto hará que la traducción sea más precisa y menos sesgada. Algunos modelos pueden querer relacionar eventos ficticios con eventos de la vida real, por lo que intentarán alterar la traducción para ajustarse a su propia narrativa. Esta opción evitará eso."],["Jailbreak Template","Plantilla de Jailbreak"],["Template of the Jailbreak message.","Plantilla del mensaje de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","El número máximo de tokens a generar en la completación.<br>El conteo de tokens de tu prompt más max_tokens no puede exceder la longitud de contexto del modelo. La mayoría de los modelos tienen una longitud de contexto de 2048 tokens (excepto los modelos más nuevos, que soportan 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qué temperatura de muestreo usar, entre 0 y 2. Valores más altos como 0.8 harán que la salida sea más aleatoria, mientras que valores más bajos como 0.2 la harán más enfocada y determinista. <br>OpenAI generalmente recomienda alterar esto o top_p pero no ambos."],["Nucleus sampling (top_p)","Muestreo de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Una alternativa al muestreo con temperatura, llamada muestreo de núcleo, donde el modelo considera los resultados de los tokens con la masa de probabilidad top_p. Así, 0.1 significa que solo se consideran los tokens que comprenden el 10% superior de la masa de probabilidad. <br>OpenAI generalmente recomienda alterar esto o la temperatura pero no ambos."],["Frequency Penalty","Penalización de Frecuencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Los valores positivos penalizan nuevos tokens basados en su frecuencia existente en el texto hasta ahora, disminuyendo la probabilidad del modelo de repetir la misma línea textualmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalización de Presencia"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2.0 y 2.0. Los valores positivos penalizan nuevos tokens basándose en si aparecen en el texto hasta ahora, aumentando la probabilidad del modelo de hablar sobre nuevos temas. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Usar Esquema JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Usa <code>json_schema</code> para el campo <code>response_format.type</code> en lugar del antiguo <code>json_object</code>. <code>json_schema</code> es requerido por algunos de los modelos más recientes y algunos servidores como <b>LM Studio</b>, pero algunos modelos antiguos aún usan <code>json_object</code>."],["Max Characters per Batch","Máximo de Caracteres por Lote"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Límite máximo de caracteres por lote de traducción.\nEsta opción solo contará la longitud de caracteres del texto original, y no la longitud de caracteres del mensaje de prompt."],["Max concurrent requests","Máximo de solicitudes concurrentes"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","¿Cuántas solicitudes concurrentes se permiten conectarse simultáneamente? Cada conexión concurrente adicional multiplicará tu velocidad de traducción, pero también agotará rápidamente tu límite de tokens establecido por tu proveedor.<br />Establécelo en <b>0</b> para desactivar esta función.<br />Combina esta opción con <b>Máximo de filas por solicitud concurrente</b> para aumentar aún más la velocidad de traducción.<br />Establecer esta opción en más de 1 afectará el <b>Contexto</b> porque habrá una solicitud procesada antes de que la anterior termine. Por lo tanto, el contexto se enviará sin el resultado de traducción de la solicitud previa."],["Max row per concurrent requests","Máximo de filas por solicitudes concurrentes"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","¿Cuántas filas se permiten por cada solicitud concurrente? Establécelo en <b>0</b> para desactivar esta función.<br />Si esta opción está desactivada, no importa cuántas <b>Máximo de solicitudes concurrentes</b> establezcas, Translator++ procesará la solicitud como un solo fragmento.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Cuantas más filas establezcas, más traducción puedes obtener en un solo lote. Por lo tanto, reduce el costo de sobrecarga y aumenta la posibilidad de que la IA devuelva resultados erróneos.<br />Cuanto menor sea el número, menos probable es que la traducción falle, pero te costará extra por prompts de sobrecarga."],["Preserve translations from invalid returned number of rows","Preservar traducciones de número de filas devueltas inválido"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","Preservar traducciones de respuestas que tienen recuentos de filas inválidos.<br />Si está marcado, Translator++ intentará corregir el recuento de filas e insertar traducciones en la cuadrícula.<br />Si no está marcado, las celdas permanecerán en blanco.<br />Se recomienda dejar esta opción desmarcada para propósitos de retraducción."],["Batch delay","Retraso por lote"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","Retraso entre lotes (en milisegundos).<br />Usa esta configuración para controlar tus solicitudes y no exceder el límite de RPM (solicitudes por minuto)."],["Batch Timeout","Tiempo de espera por lote"],["Timeout for each batch in milisecond","Tiempo de espera para cada lote en milisegundos"],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Algoritmo de escape para código en línea dentro de diálogos. Es posible que necesites cambiar la <b>Plantilla de Mensaje del Sistema</b> y la <b>Plantilla de Mensaje del Cuerpo</b> según el algoritmo de escape que elijas.<br />Cuando eliges <b>JSONCloaking</b> o <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> se enviará automáticamente (a menos que actives <b>Usar Esquema JSON</b>, que enviará un esquema JSON en su lugar). <b>JSONCloaking</b> es muy preciso, pero no funciona con todos los modelos, prueba con <b>gpt-3.5-turbo-1106</b>."],["Number of retry","Número de reintentos"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Cuántas veces el motor debe reintentar cuando falla la validación de salida de traducción. Si es nulo (vacío), entonces no hay reintento."],["Retry when the number of translated rows doesn't match original","Reintentar cuando el número de filas traducidas no coincide con el original"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Si está habilitado, el motor reintentará cuando el modelo devuelva un número diferente de filas de traducción en comparación con la carga útil original."],["Retry when the number of lines for each translated row doesn't match original","Reintentar cuando el número de líneas para cada fila traducida no coincide con el original"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Si está habilitado, el motor reintentará cuando cualquier fila traducida tenga un número diferente de líneas que su fila original."],["Prompt: Row count mismatch","Prompt: Desajuste en el recuento de filas"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt utilizado al reintentar debido a desajuste en el recuento de filas/elementos. Las variables de plantilla disponibles incluyen: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","Prompt: Desajuste en el recuento de líneas"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt utilizado al reintentar debido a desajuste en el recuento de líneas por fila. Las variables de plantilla disponibles incluyen: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","Prompt: Error / Instrucción de reintento"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt añadido después del/los prompt(s) de desajuste para instruir al modelo a reintentar. Las variables de plantilla disponibles incluyen: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","Parámetro Personalizado"],["Key","Clave"],["Value","Valor"],["Type","Tipo"],["Type of the value.","Tipo del valor."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Para el tipo <b>javascript</b>, el valor se evaluará como código JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","El alcance del código javascript es <code>window</code>. Así que básicamente puedes obtener cualquier valor."],["<br />Example: <code>trans.project.title</code>","<br />Ejemplo: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Eliminar parámetros que no se enviarán a la API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","La API de OpenAI sigue cambiando, algunos modelos nuevos pueden no soportar los parámetros antiguos y devolverán un error HTTP por parámetro de solicitud no reconocido."],["You can drop the parameters that are not supported by the model here.","Puedes dejar aquí los parámetros que no son compatibles con el modelo."],["Manage configuration","Gestionar configuración"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","Ocultación HTML Envuelta"],["JSONObject Cloaking","Ocultación JSONObject"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","Este complemento habilita la traducción a través de cualquier servicio que soporte la API de Chat de OpenAI, como Deepseek, LlamaCPP, Google Gemini, etc., y, por supuesto, OpenAI ChatGPT."],["OpenAI API settings","Configuración de la API de OpenAI"],["General","General"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>No desperdicies tu dinero en Modelos de Razonamiento</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Varios estudios han demostrado que los modelos de razonamiento son mucho peores que los modelos normales en tareas de escritura creativa y traducción.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>No obtienes nada más que un costo más caro y tiempos de respuesta más lentos al usar modelos de razonamiento.</p>"],["Explore more models","Explorar más modelos"],["Templates","Plantillas"],["Enable context","Habilitar contexto"],["<h2>Sample dialogue</h2>","<h2>Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Add Example: Translate Japanese to English","Añadir Ejemplo: Traducir japonés a inglés"],["Retry prompts","Reintentar prompts"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Estos prompts se añaden como mensajes extra de <b>usuario</b> durante los reintentos, justo después de la salida anterior del modelo.</p>"],["<p>Available variables:</p>","<p>Variables disponibles:</p>"],["Enable Jailbreak","Habilitar Jailbreak"],["Advanced","Avanzado"],["Custom Parameters","Parámetros Personalizados"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Puedes agregar parámetros personalizados al cuerpo de la solicitud de la API de Chat de OpenAI. Esto es útil si deseas agregar parámetros adicionales que no están disponibles en el formulario."],["<h2>Warning</h2>","<h2>Advertencia</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Configurar incorrectamente los parámetros personalizados puede causar que la solicitud de la API falle. Asegúrate de saber lo que estás haciendo antes de agregar parámetros personalizados. Algunos servicios como OpenAI son estrictos sobre qué parámetros envías, y devolverán un error HTTP por parámetros de solicitud no reconocidos.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Si se usa la misma clave múltiples veces, solo se usará el último valor.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Si se usa la misma clave en la configuración existente, entonces el parámetro de configuración existente será sobrescrito por el parámetro personalizado.</li>"],["Drop Parameters","Eliminar Parámetros"],["Open chatGPT tester","Abrir probador de chatGPT"],["Batch Translation Setting","Configuración de Traducción por Lotes"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Lo siento, este complemento solo está disponible para patrocinadores activos.\nPuedes desbloquear esta función convirtiéndote en un patrocinador de $1."],["Preserve invalid returned rows","Preservar filas devueltas inválidas"],["Retries and Refinement","Reintentos y Refinamiento"],["<h2>Retries and Refinement</h2>","<h2>Reintentos y Refinamiento</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Cuando la salida de traducción falla en la validación, Translator++ puede pedirle al modelo que reintente la traducción. Puedes establecer cuántas veces el modelo debe reintentar y también establecer la condición para el reintento.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Configurar un número razonable de reintentos con condiciones adecuadas puede mejorar significativamente la calidad de la traducción mientras se controlan los costos y el tiempo.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Cada reintento te cuesta tiempo y dinero adicional</b>. Si tus lotes terminan reintentando con frecuencia, es posible que desees ajustar tu prompt para que las instrucciones sean más claras para el modelo.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Usa la herramienta de desarrollo o el Gestor de Lotes para depurar tu traducción por lotes.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Algoritmo de Escape de Código</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>El escape de código es una técnica para evitar que la MTL altere los fragmentos de código dentro de los diálogos. Esto es útil cuando tus diálogos contienen fragmentos de código como etiquetas HTML, etiquetas XML, objetos JSON o plantillas JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Elige el algoritmo de escape que coincida con los fragmentos de código dentro de tus diálogos. Es posible que necesites ajustar las plantillas de <b>mensaje del sistema</b>, <b>prompt de ejemplo</b> y <b>mensaje del cuerpo</b> en consecuencia.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Haz clic <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>aquí</a> para leer más sobre algoritmos de escape de código y cómo usarlos efectivamente.</p>"],["Default","Predeterminado"],["JavaScript template cloaking","Ocultamiento de plantilla JavaScript"],["None (no escaping)","Ninguno (sin escape)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","¿Quieres cargar el preset de diálogo de ejemplo para el algoritmo de escape seleccionado? Esto sobrescribirá tu diálogo de ejemplo existente."],["Always separate file","Siempre archivo separado"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separa el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Agregar nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añade el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje del prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si habilitas esta opción, también necesitas incluir la variable <code>ACTOR_INFO</code> en la plantilla del prompt para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene la información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt adicional que se agregará al mensaje de prompt. Esto se agregará después del mensaje del sistema y antes del mensaje de prompt real."],["<br />","<br />"],["General Settings","Configuración General"],["Always separate file for each batch","Siempre archivo separado para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta función te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La función intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Prompt"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":true,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>E</u>nviar"],["Toggle word wrap","Alternar ajuste de línea"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ayuda"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Esta función solo está disponible si estás usando la versión Desarrollador de Translator++. Puedes cambiar a la versión Desarrollador usando Utilidades Básicas -> Cambiar Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ACTOR : Glosario de información del actor. (Solo si la opción de información del actor está habilitada en modo lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto de la traducción anterior (si el contexto está habilitado)</li>"],["Sample conversation","Conversación de ejemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de ejemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de ejemplo. Puedes escribir un ejemplo de respuestas buenas o malas para ayudar al traductor a entender tu objetivo y el contexto de la conversación.</p>"],["Always separate file","Siempre archivo separado"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Siempre separar el archivo para cada lote. Esto puede mantener los contextos de cada archivo sin contaminarse con otros archivos."],["Add actor name","Agregar nombre del actor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Añadir el nombre del actor desde la información de la fila al texto traducible. Esto ayudará a los traductores a seguir el diálogo y los pronombres. Translator++ luego eliminará el nombre del actor del resultado de la traducción. Esto obviamente aumentará el costo de la traducción."],["Load Actor Reference as Glossary","Cargar Referencia de Actor como Glosario"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Si está marcado, Translator++ cargará la referencia del actor como glosario. Esto ayudará al traductor a entender el contexto de la conversación. La referencia del actor es el nombre del actor en el diálogo. Esto se cargará como un glosario para el traductor. Esto aumentará el costo de la traducción."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Solo los personajes que existen en la conversación se cargarán como glosario para cada elemento del lote. Usa el comando de plantilla para cargar la referencia del actor en el mensaje de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Si habilitas esta opción, también necesitas incluir la variable <code>ACTOR_INFO</code> en la plantilla de prompt para colocar los datos de información del personaje."],["Actor Reference Translation Column","Columna de Traducción de Referencia de Actor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","La columna de la traducción del nombre del actor. Esta columna se usará como la traducción de la referencia del actor. Esto mejorará la consistencia de la traducción del nombre del actor en la conversación."],["Actor's Information Column","Columna de Información del Actor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","La columna que contiene la información adicional del actor. Puedes poner más información como género, edad, etc. Esto mejorará la traducción de los pronombres en la conversación."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que se agregará al mensaje de prompt. Esto se añadirá después del mensaje del sistema y antes del mensaje de prompt real."],["General Settings","Configuración General"],["Always separate file for each batch","Siempre archivo separado para cada lote"],["Append actor name to the translatable text","Añadir nombre del actor al texto traducible"],["Glossary","Glosario"],["<h2>Glossary</h2>","<h2>Glosario</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Esta característica te ayudará a agregar automáticamente un glosario en el prompt. El glosario se cargará para cada lote de elementos para mejorar la calidad de la traducción. La característica intentará cargar solo los términos relevantes para evitar inflar tu prompt.</p>"],["The Column of Actor's Additional Information","La Columna de Información Adicional del Actor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","Chatear con la API de ChatGPT"],["Batch Manager","Administrador de Lotes"],["This feature is only available if you have a project open.","Esta función solo está disponible si tienes un proyecto abierto."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","¿Quieres instalar DazedMTLTool?"],["Ignore if already translated","Ignorar si ya está traducido"],["OpenAI Translation with DazedMTL","Traducción OpenAI con DazedMTL"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":true,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","El servidor DeepL no está instalado. ¿Quieres instalarlo ahora?"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":true,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","Uso de caracteres:\n"],["Failed to fetch quota: ","Error al obtener la cuota: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":true,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>E</u>nviar"],["Toggle word wrap","Alternar ajuste de línea"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ayuda"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Esta función solo está disponible si estás usando la versión Desarrollador de Translator++. Puedes cambiar a la versión Desarrollador usando Utilidades Básicas -> Cambiar Core NWJS."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título del juego</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor del juego</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCIA[nombre del objeto] : Generar referencia desde el objeto de Translator++. <br />Ejemplo : <code>REFERENCIA[Referencia Común]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>API Nativa de Gemini</h2><p>Este motor usa la API nativa de Google Gemini para traducción. <br />También puedes usar el complemento de OpenAI para Google Gemini. Hay más funciones en el complemento de OpenAI, por eso <b style='color:green;'>recomiendo usar el complemento de OpenAI en su lugar</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI requiere algunos módulos de la biblioteca de OpenAI. Por favor, asegúrate de que el complemento <b>transChatGPT (ChatGPT para Translator++)</b> esté instalado."],["Explore more models","Explorar más modelos"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","etiquetaPersonalizada.modelosPersonalizados"],["model","modelo"],["|","|"],["promptLibrary","bibliotecaDePrompts"],["search","buscar"],["downloadChat","descargarChat"],["newChat","nuevoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","etiquetaEntrada.endpointAPI"],["apiKey.inputLabel","etiquetaEntrada.clave