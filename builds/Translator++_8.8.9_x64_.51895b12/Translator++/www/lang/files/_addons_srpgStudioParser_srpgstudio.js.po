# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"0","tags":null}
#. tid/2574/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:0"
msgid "Start a translation project from SRPG Studio Engine."
msgstr "Bắt đầu dự án dịch từ SRPG Studio Engine."

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"1","tags":null}
#. tid/2579/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:1"
msgid "The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253.."
msgstr "Bộ phân tích có thể xử lý dịch từ <b>data.dts</b> (tệp srpgs); tệp <b>localization.dat</b> và các tệp localization (.json, .txt, .js) được tạo bởi công cụ localization của SRPG Studio giới thiệu từ phiên bản 1.253."

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"2","tags":null}
#. tid/2648/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:2"
msgid "Create project"
msgstr "Tạo dự án"

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"3","tags":null}
#. tid/2685/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:3"
msgid "Error: customField is not defined. This should not happen!"
msgstr "Lỗi: customField không được định nghĩa. Điều này không nên xảy ra!"

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"4","tags":null}
#. tid/2745/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:4"
msgid "Please select the entry point to translate."
msgstr "Vui lòng chọn điểm nhập để dịch."

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"5","tags":null}
#. tid/3047/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:5"
msgid "There are currently two known locations of translatable text within the SRPG Studio game. <br />"
msgstr "Hiện có hai vị trí đã biết của văn bản có thể dịch trong trò chơi SRPG Studio. <br />"

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"6","tags":null}
#. tid/3054/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:6"
msgid "The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both."
msgstr "Đầu tiên được viết trực tiếp trong tệp .srpgs, và thứ hai là trong tệp localization.dat. Bộ phân tích này hiện có thể xử lý cả hai."

# {"path":"/addons/srpgStudioParser/srpgstudio.js","row":"7","tags":null}
#. tid/3061/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/srpgStudioParser/srpgstudio.js:7"
msgid "<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format."
msgstr "<br />Ngoài ra, bạn cũng có thể dịch các tệp localization được tạo bởi công cụ localization của SRPG Studio. Các tệp này ở định dạng JSON, TXT và JS."
