msgstr "Khóa API"

# {"path":"/addons/transChatGPT/options.js","row":"8","tags":null}
#. tid/886/type/StringLiteral
msgctxt "tpp:/addons/transChatGPT/options.js:8"
msgid "Enter your API Key here.<br>The method to get the API key is different for each service.<br>"
msgstr "Nhập khóa API của bạn vào đây.<br>Phương pháp lấy khóa API khác nhau cho mỗi dịch vụ.<br>"

# {"path":"/addons/transChatGPT/options.js","row":"9","tags":null}
#. tid/937/type/NoSubstitutionTemplate
