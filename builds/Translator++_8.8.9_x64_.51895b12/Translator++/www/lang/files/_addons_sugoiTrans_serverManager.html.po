msgid "Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>"
msgstr "Vị trí Sugoi translator <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Trỏ đến tệp .bat hoặc .exe trong thư mục gốc của ứng dụng.\"></i>"

# {"path":"/addons/sugoiTrans/serverManager.html","row":"1","tags":null}
#. idx/1/innerText
msgctxt "tpp:/addons/sugoiTrans/serverManager.html:1"
msgid "<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed."
msgstr "<i class=\"icon-attention red\"></i> Đường dẫn không hợp lệ.<br>Một số tính năng sẽ bị vô hiệu hóa cho đến khi sửa lỗi này."

