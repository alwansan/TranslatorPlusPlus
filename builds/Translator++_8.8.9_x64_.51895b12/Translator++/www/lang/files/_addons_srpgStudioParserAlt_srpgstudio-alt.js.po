# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"0","tags":null}
#. tid/4165/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:0"
msgid "Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe."
msgstr "Phân tích kho lưu trữ SRPG Studio và JSON dump dịch được tạo bởi SRPG_Unpacker.exe."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"1","tags":null}
#. tid/4208/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:1"
msgid "Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version."
msgstr "Bắt đầu dịch từ data.dts, project.dat của SRPG Studio hoặc JSON dump dịch.<br />Đây là bộ phân tích mới nhất—nhanh hơn và ổn định hơn đáng kể—sẽ thay thế phiên bản trước."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"2","tags":null}
#. tid/4279/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:2"
msgid "Create Project"
msgstr "Tạo Dự án"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"3","tags":null}
#. tid/4550/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:3"
msgid "Source mode"
msgstr "Chế độ nguồn"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"4","tags":null}
#. tid/4582/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:4"
msgid "Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON."
msgstr "Chọn chế độ EXE để bắt đầu từ tệp thực thi trò chơi, chế độ kho lưu trữ cho data.dts / project.dat, hoặc chế độ dump cho JSON dump dịch."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"5","tags":null}
#. tid/4608/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:5"
msgid "Select executable"
msgstr "Chọn tệp thực thi"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"6","tags":null}
#. tid/4618/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:6"
msgid "Select the game executable. Translator++ will look for data.dts in the same folder."
msgstr "Chọn tệp thực thi trò chơi. Translator++ sẽ tìm data.dts trong cùng thư mục."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"7","tags":null}
#. tid/4651/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:7"
msgid "Select archive file"
msgstr "Chọn tệp lưu trữ"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"8","tags":null}
#. tid/4661/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:8"
msgid "Select data.dts directly."
msgstr "Chọn trực tiếp data.dts."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"9","tags":null}
#. tid/4694/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:9"
msgid "Select dump folder"
msgstr "Chọn thư mục dump"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"10","tags":null}
#. tid/4704/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:10"
msgid "Select the translation dump folder generated by SRPG_Unpacker.exe."
msgstr "Chọn thư mục dump dịch được tạo bởi SRPG_Unpacker.exe."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"11","tags":null}
#. tid/4737/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:11"
msgid "Filters"
msgstr "Bộ lọc"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"12","tags":null}
#. tid/4747/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:12"
msgid "Glob pattern used to select JSON files from the dump folder."
msgstr "Mẫu glob dùng để chọn tệp JSON từ thư mục dump."

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"13","tags":null}
#. tid/4780/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:13"
msgid "ProjectTitle"
msgstr "Tiêu đề dự án"

# {"path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","row":"14","tags":null}
#. tid/4790/type/StringLiteral
msgctxt "tpp:/addons/srpgStudioParserAlt/srpgstudio-alt.js:14"
msgid "Your project title"
msgstr "Tiêu đề dự án của bạn"
