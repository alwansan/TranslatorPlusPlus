msgstr "Nâng cấp cơ sở dữ liệu"

# {"path":"/addons/tm/tm.js","row":"40","tags":null}
#. tid/4123/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:40"
msgid ""
"This action will upgrade your database.\n"
"Do you want to upgrade your translation memory database?"
msgstr ""
"Hành động này sẽ nâng cấp cơ sở dữ liệu của bạn.\n"
"Bạn có muốn nâng cấp cơ sở dữ liệu bộ nhớ dịch?"

# {"path":"/addons/tm/tm.js","row":"41","tags":null}
#. tid/4203/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:41"
msgid ""
"The translation memory database has been upgraded!\n"
"Please restart Translator++!"
msgstr ""
"Cơ sở dữ liệu bộ nhớ dịch đã được nâng cấp!\n"
"Vui lòng khởi động lại Translator++!"
