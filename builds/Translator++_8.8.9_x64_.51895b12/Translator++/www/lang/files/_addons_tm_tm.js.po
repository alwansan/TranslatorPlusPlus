# {"path":"/addons/tm/tm.js","row":"0","tags":null}
#. tid/292/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:0"
msgid "Automatic organic translation memorization"
msgstr "Ghi nhớ bản dịch hữu cơ tự động"

# {"path":"/addons/tm/tm.js","row":"1","tags":null}
#. tid/302/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:1"
msgid "If checked, all organic translation (manually inputted translation) will be memorized automatically."
msgstr "Nếu được chọn, tất cả bản dịch hữu cơ (bản dịch được nhập thủ công) sẽ được ghi nhớ tự động."

# {"path":"/addons/tm/tm.js","row":"2","tags":null}
#. tid/340/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:2"
msgid "Memorize translation by automation script"
msgstr "Ghi nhớ bản dịch bằng kịch bản tự động"

# {"path":"/addons/tm/tm.js","row":"3","tags":null}
#. tid/350/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:3"
msgid ""
"If checked, Translator++ will remember the translation created from automation scripts. \n"
"All changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization."
msgstr ""
"Nếu được chọn, Translator++ sẽ ghi nhớ bản dịch được tạo từ kịch bản tự động. \n"
"Tất cả thay đổi qua 'this.cells' sẽ được ghi nhớ. Nhưng có thể chúng tôi sửa đổi nội dung của lưới trực tiếp bằng API trans, những thay đổi đó sẽ không kích hoạt việc ghi nhớ tự động."

# {"path":"/addons/tm/tm.js","row":"4","tags":null}
#. tid/388/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:4"
msgid "Remind translation on cell translate"
msgstr "Nhắc bản dịch khi dịch ô"

# {"path":"/addons/tm/tm.js","row":"5","tags":null}
#. tid/398/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:5"
msgid "If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell."
msgstr "Nếu được chọn, Translator++ sẽ tải bản dịch từ bộ nhớ dịch trước khi thực hiện dịch tự động trên ô được chọn."

# {"path":"/addons/tm/tm.js","row":"6","tags":null}
#. tid/436/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:6"
msgid "Default memorization behavior"
msgstr "Hành vi ghi nhớ mặc định"

# {"path":"/addons/tm/tm.js","row":"7","tags":null}
#. tid/446/type/StringLiteral
msgctxt "tpp:/addons/tm/tm.js:7"
msgid "Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record."
msgstr "Ghi đè bản ghi trước đó khi thực hiện dịch hữu cơ. Nếu không chọn, TM sẽ không ghi nhớ bản dịch mới cho bản ghi hiện có."

