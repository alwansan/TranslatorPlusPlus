#. tid/614/type/StringLiteral
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:0"
msgid "Start a translation project from RPG Developer Bakin localization sheet (xlsx)."
msgstr "Bắt đầu một dự án dịch từ bảng địa phương hóa RPG Developer Bakin (xlsx)."

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"1","tags":null}
#. tid/683/type/StringLiteral
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:1"
msgid "Create project"
msgstr "Tạo dự án"

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"2","tags":null}
#. tid/720/type/StringLiteral
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:2"
msgid "Error: customField is not defined. This should not happen!"
msgstr "Lỗi: customField không được định nghĩa. Điều này không nên xảy ra!"

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"3","tags":null}
#. tid/756/type/StringLiteral
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:3"
msgid "Please select the entry point to translate."
msgstr "Vui lòng chọn điểm vào để dịch."

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"4","tags":null}
#. tid/1034/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:4"
msgid "<h2>RPG Developer Bakin editor is required</h2>"
msgstr "<h2>Trình chỉnh sửa RPG Developer Bakin là bắt buộc</h2>"

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"5","tags":null}
#. tid/1041/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:5"
msgid "RPG Developer Bakin editor is required to start the translation project."
msgstr "Trình chỉnh sửa RPG Developer Bakin là bắt buộc để bắt đầu dự án dịch."

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"6","tags":null}
#. tid/1064/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:6"
msgid "<h2>Before you start</h2>"
msgstr "<h2>Trước khi bạn bắt đầu</h2>"

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"7","tags":null}
#. tid/1077/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:7"
msgid "<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project."
msgstr "<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Giải nén trò chơi của bạn</a> thành dự án RPG Developer Bakin có thể chỉnh sửa."

# {"path":"/addons/bakinParser/bakin-xlsx.js","row":"8","tags":null}
#. tid/1088/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/bakinParser/bakin-xlsx.js:8"
msgid "Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>."
msgstr "Xuất các chuỗi bản địa hóa bằng cách sử dụng ứng dụng RPG Developer Bakin vào một tệp xlsx. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">Xem hướng dẫn ở đây về cách dịch trò chơi Bakin</a>."
