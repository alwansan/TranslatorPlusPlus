#. tid/99/type/StringLiteral
#. tid/12843/type/StringLiteral
msgctxt "tpp:/addons/wolfJs/wolfJs.js:0"
msgid "Maximum number of line in message box."
msgstr "Số dòng tối đa trong hộp thông báo."

# {"path":"/addons/wolfJs/wolfJs.js","row":"1","tags":null}
#. tid/109/type/StringLiteral
#. tid/12853/type/StringLiteral
msgctxt "tpp:/addons/wolfJs/wolfJs.js:1"
msgid "Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes."
msgstr "Giá trị mặc định là 4. Nhập 0 để tắt tính năng này. Nếu số dòng trong hộp thông báo lớn hơn số này, Translator++ sẽ tạo một hộp thông báo mới để ngăn văn bản tràn ra ngoài hộp."

