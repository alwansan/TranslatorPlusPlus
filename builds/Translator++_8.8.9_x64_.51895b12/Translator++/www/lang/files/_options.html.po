# {"path":"/options.html","row":"32","tags":null}
#. idx/33/innerText
msgctxt "tpp:/options.html:32"
msgid "Custom escape"
msgstr "Thoát tùy chỉnh"

# {"path":"/options.html","row":"33","tags":null}
#. idx/34/innerText
msgctxt "tpp:/options.html:33"
msgid "Patterns"
msgstr "Mẫu"

# {"path":"/options.html","row":"34","tags":null}
#. idx/35/innerText
msgctxt "tpp:/options.html:34"
msgid ""
"\n"
"\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n"
"\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n"
"\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n"
"\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n"
"\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n"
"\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n"
"\t\t\t\t\t\tfor example :\n"
"\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n"
"\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\tTất cả từ khớp với mẫu dưới đây sẽ không được dịch bởi công cụ dịch máy. \n"
"\t\t\t\t\t\tPhần này phù hợp để ẩn thẻ và tập lệnh khỏi công cụ dịch. <br>\n"
"\t\t\t\t\t\tMỗi mục nhập là một biểu thức chính quy javaScript hợp lệ, hàm, hoặc literal string được phân tách bằng <b>dấu phẩy</b>.<br>\n"
"\t\t\t\t\t\tThoát tùy chỉnh chỉ hoạt động cho <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">thuật toán thoát được hỗ trợ</a>.\n"
"\t\t\t\t\t\t<b>Gợi ý:</b>Bạn cũng có thể yêu cầu ChatGPT tạo biểu thức chính quy cho bạn. <br>\n"
"\t\t\t\t\t\tVui lòng viết mẫu regex cùng với bộ sửa đổi của nó.<br>\n"
"\t\t\t\t\t\tví dụ:\n"
"\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n"
"\t\t\t\t\t"

# {"path":"/options.html","row":"35","tags":null}
#. idx/36/innerText
