msgctxt "tpp:/options.html:52"
msgid "Apply"
msgstr "Áp dụng"

# {"path":"/options.html","row":"53","tags":null}
#. idx/56/innerText
msgctxt "tpp:/options.html:53"
msgid "Update"
msgstr "Cập nhật"

# {"path":"/options.html","row":"54","tags":null}
#. idx/57/innerText
msgctxt "tpp:/options.html:54"
msgid "Auto update"
msgstr "Tự động cập nhật"

# {"path":"/options.html","row":"55","tags":null}
#. idx/58/innerText
msgctxt "tpp:/options.html:55"
msgid "Automatically update Translator++ if possible."
msgstr "Tự động cập nhật Translator++ nếu có thể."

# {"path":"/options.html","row":"56","tags":null}
#. idx/59/innerText
msgctxt "tpp:/options.html:56"
msgid "Allow reinstall the same version"
msgstr "Cho phép cài đặt lại cùng phiên bản"

# {"path":"/options.html","row":"57","tags":null}
#. idx/60/innerText
msgctxt "tpp:/options.html:57"
msgid "Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program."
msgstr "Cho phép Translator++ cài đặt lại cùng phiên bản đã được cài đặt. Vui lòng giữ tùy chọn này tắt sau khi bạn đã cài đặt bản cập nhật, đặc biệt khi cài đặt <b>Tự động cập nhật</b> của bạn đang bật. Nếu không, Translator++ sẽ tiếp tục tự cập nhật mỗi khi bạn mở chương trình."

# {"path":"/options.html","row":"58","tags":null}
#. idx/61/innerText
msgctxt "tpp:/options.html:58"
msgid "Use default browser to login"
msgstr "Sử dụng trình duyệt mặc định để đăng nhập"

# {"path":"/options.html","row":"59","tags":null}
#. idx/62/innerText
msgctxt "tpp:/options.html:59"
msgid "Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used."
msgstr "Sử dụng trình duyệt mặc định đáng tin cậy của hệ thống để đăng nhập vào tài khoản Patreon của bạn. Trừ khi tùy chọn này được chọn, trình duyệt nhúng của Translator++ sẽ được sử dụng."

# {"path":"/options.html","row":"60","tags":null}
#. idx/63/innerText
msgctxt "tpp:/options.html:60"
msgid "Multi threading"
msgstr "Đa luồng"

# {"path":"/options.html","row":"61","tags":null}
#. idx/64/innerText
msgctxt "tpp:/options.html:61"
msgid "Number of thread"
msgstr "Số luồng"

# {"path":"/options.html","row":"62","tags":null}
#. idx/65/innerText
msgctxt "tpp:/options.html:62"
msgid ""
"The number of child processes that are opened simultaneously.<br>\n"
"\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n"
"\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n"
"\t\t\t\t\t\t"
msgstr ""
"Số lượng tiến trình con được mở đồng thời.<br>\n"
"\t\t\t\t\t\t\t0 = tắt đa luồng. Tất cả tiến trình sẽ được thực hiện bởi tiến trình renderer.<br>\n"
"\t\t\t\t\t\t\tSố lượng tối ưu thường là số lõi vật lý của bạn - 1.\n"
"\t\t\t\t\t\t"

# {"path":"/options.html","row":"63","tags":null}
#. idx/66/innerText
msgctxt "tpp:/options.html:63"
msgid "Backup"
msgstr "Sao lưu"

# {"path":"/options.html","row":"64","tags":null}
#. idx/67/innerText
msgctxt "tpp:/options.html:64"
msgid "Enable backup"
msgstr "Bật sao lưu"

# {"path":"/options.html","row":"65","tags":null}
#. idx/68/innerText
msgctxt "tpp:/options.html:65"
msgid "Automatically create backup every time you save your project."
msgstr "Tự động tạo sao lưu mỗi khi bạn lưu dự án."

# {"path":"/options.html","row":"66","tags":null}
#. idx/69/innerText
msgctxt "tpp:/options.html:66"
msgid "Backup level history"
msgstr "Lịch sử cấp độ sao lưu"

# {"path":"/options.html","row":"67","tags":null}
#. idx/70/innerText
msgctxt "tpp:/options.html:67"
msgid "How many history of backup do you want to keep?"
msgstr "Bạn muốn giữ bao nhiêu lịch sử sao lưu?"

# {"path":"/options.html","row":"68","tags":null}
#. idx/71/innerText
msgctxt "tpp:/options.html:68"
msgid "Log &amp; Debugging"
msgstr "Nhật ký &amp; Gỡ lỗi"

# {"path":"/options.html","row":"69","tags":null}
#. idx/72/innerText
msgctxt "tpp:/options.html:69"
msgid "Log to file"
msgstr "Ghi nhật ký vào tệp"

# {"path":"/options.html","row":"70","tags":null}
#. idx/73/innerText
msgctxt "tpp:/options.html:70"
msgid "Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder."
msgstr "Ghi nhật ký vào tệp thay vì cửa sổ console mặc định.<br>Điều này hữu ích nếu bạn muốn gỡ lỗi Translator++ và không có quyền truy cập vào cửa sổ console. Bật tùy chọn này sẽ ảnh hưởng nhẹ đến hiệu suất. Vì vậy, bạn nên tắt tùy chọn này mọi lúc, trừ khi bạn đang gỡ lỗi hoặc báo cáo sự cố.<br>Nhật ký được lưu trong thư mục data/logs/."

# {"path":"/options.html","row":"71","tags":null}
#. idx/74/innerText
msgctxt "tpp:/options.html:71"
msgid "Truncate log file each session"
msgstr "Cắt ngắn tệp nhật ký mỗi phiên"

# {"path":"/options.html","row":"72","tags":null}
#. idx/75/innerText
msgctxt "tpp:/options.html:72"
msgid "When checked your log file will be truncated each time you re open the application."
msgstr "Khi được chọn, tệp nhật ký của bạn sẽ bị cắt ngắn mỗi khi bạn mở lại ứng dụng."

# {"path":"/options.html","row":"73","tags":null}
#. idx/76/innerText
msgctxt "tpp:/options.html:73"
msgid "Application Settings"
msgstr "Cài đặt ứng dụng"

# {"path":"/options.html","row":"74","tags":null}
#. idx/77/innerText
msgctxt "tpp:/options.html:74"
msgid "Enable remote debugging"
msgstr "Bật gỡ lỗi từ xa"

# {"path":"/options.html","row":"75","tags":null}
#. idx/78/innerText
msgctxt "tpp:/options.html:75"
msgid "Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes."
msgstr "Kích hoạt giao thức gỡ lỗi từ xa Chrome DevTools trên cổng 9222. Điều này cho phép bạn kiểm tra và gỡ lỗi Translator++ bằng trình duyệt bên ngoài bằng cách điều hướng đến <code>chrome://inspect</code>. Cờ này thêm <code>--remote-debugging-port=9222</code> vào các đối số khởi động ứng dụng. Cần khởi động lại để áp dụng thay đổi."

# {"path":"/options.html","row":"76","tags":null}
#. idx/79/innerText
msgctxt "tpp:/options.html:76"
msgid "Disable GPU"
msgstr "Tắt GPU"

# {"path":"/options.html","row":"77","tags":null}
#. idx/80/innerText
msgctxt "tpp:/options.html:77"
msgid "Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes."
msgstr "Tắt tăng tốc GPU phần cứng. Điều này hữu ích nếu bạn gặp lỗi hình ảnh, sự cố hoặc vấn đề kết xuất trên một số phần cứng hoặc trình điều khiển đồ họa. Cờ này thêm <code>--disable-gpu</code> vào các đối số khởi động ứng dụng. Cần khởi động lại để áp dụng thay đổi."

# {"path":"/options.html","row":"78","tags":null}
#. idx/81/innerText
msgctxt "tpp:/options.html:78"
msgid "Dangerous Area"
msgstr "Khu vực nguy hiểm"

# {"path":"/options.html","row":"79","tags":null}
#. idx/83/innerText
msgctxt "tpp:/options.html:79"
msgid "Interface Language"
msgstr "Ngôn ngữ giao diện"

# {"path":"/options.html","row":"80","tags":null}
#. idx/84/innerText
msgctxt "tpp:/options.html:80"
msgid "UI Language"
msgstr "Ngôn ngữ UI"

# {"path":"/options.html","row":"81","tags":null}
#. idx/85/innerText
msgctxt "tpp:/options.html:81"
msgid "Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder."
msgstr "Đặt ngôn ngữ cho giao diện người dùng. Bạn có thể tạo bản địa hóa riêng nếu Translator++ không có sẵn bằng ngôn ngữ của bạn. Dữ liệu ngôn ngữ nằm trong thư mục www/lang."

# {"path":"/options.html","row":"82","tags":null}
#. idx/86/innerText
msgctxt "tpp:/options.html:82"
msgid "Spell checker Language"
msgstr "Ngôn ngữ kiểm tra chính tả"

# {"path":"/options.html","row":"83","tags":null}
#. idx/87/innerText
msgctxt "tpp:/options.html:83"
msgid "Set the default spell checker language."
msgstr "Thiết lập ngôn ngữ kiểm tra chính tả mặc định."

# {"path":"/options.html","row":"84","tags":null}
#. idx/88/innerText
msgctxt "tpp:/options.html:84"
msgid "Environment Variables"
msgstr "Biến môi trường"

# {"path":"/options.html","row":"85","tags":null}
#. idx/89/innerText
msgctxt "tpp:/options.html:85"
msgid "Staging Directory"
msgstr "Thư mục Staging"

# {"path":"/options.html","row":"86","tags":null}
#. idx/90/innerText
msgctxt "tpp:/options.html:86"
msgid "Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts."
msgstr "Thư mục Staging là bộ nhớ cache cứng của các dự án đang được xử lý. Một phần dữ liệu từ nguyên liệu thô được sao chép vào thư mục này để các tập lệnh thông dịch truy cập."

# {"path":"/options.html","row":"87","tags":null}
