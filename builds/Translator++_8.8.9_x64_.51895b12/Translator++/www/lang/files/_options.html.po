# {"path":"/options.html","row":"17","tags":null}
#. idx/17/innerText
msgctxt "tpp:/options.html:17"
msgid "Payment status <div class=\"infoHeadNote\">(Current payment status)</div>"
msgstr "Trạng thái thanh toán <div class=\"infoHeadNote\">(Trạng thái thanh toán hiện tại)</div>"

# {"path":"/options.html","row":"18","tags":null}
#. idx/18/innerText
msgctxt "tpp:/options.html:18"
msgid ""
"\n"
"\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n"
"\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n"
"\t\t\t\t\t\t\t\t"
msgstr ""
"\n"
"\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Đừng hoảng sợ!</span></h4>\n"
"\t\t\t\t\t\t\t\t\t<h5>Và vui lòng đọc thông tin sau.</h5>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Cờ này cho biết Patreon chưa nhận được tiền từ cam kết của bạn. Hệ thống thanh toán gặp trễ là điều bình thường. Tùy theo phương thức thanh toán và quốc gia, trễ có thể lên đến 24 giờ.</p>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Trong thời gian trễ này, bạn có thể thấy ghi nợ từ thẻ tín dụng. Đừng lo—Patreon sẽ thử lại định kỳ để kiểm tra xem họ đã nhận thanh toán chưa. Điều này thường tự giải quyết trong vòng 24 giờ.</p>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Nếu vấn đề kéo dài hơn, vui lòng đăng trong chủ đề <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> trên máy chủ Translator++ trên Discord. Tôi sẽ hỗ trợ bạn nhiều nhất có thể.</p>\n"
"\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Xin hiểu rằng để ngăn gian lận, <b><span class=\"userInfoPoints\">điểm</span> và <span class=\"userInfoLevel\">Cấp độ</span> sẽ không được tính cho đến khi Patreon nhận thanh toán thành công</b>.</p>\n"
"\t\t\t\t\t\t\t\t"

# {"path":"/options.html","row":"19","tags":null}
#. idx/19/innerText
msgctxt "tpp:/options.html:19"
msgid "<span class=\"blue\">Don't panic!</span>"
msgstr "<span class=\"blue\">Đừng hoảng sợ!</span>"

# {"path":"/options.html","row":"20","tags":null}
#. idx/20/innerText
msgctxt "tpp:/options.html:20"
msgid "This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours."
msgstr "Cờ này cho biết Patreon chưa nhận được tiền từ cam kết của bạn. Hệ thống thanh toán gặp trễ là điều bình thường. Tùy theo phương thức thanh toán và quốc gia, trễ có thể lên đến 24 giờ."

# {"path":"/options.html","row":"21","tags":null}
#. idx/21/innerText
msgctxt "tpp:/options.html:21"
msgid "During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours."
msgstr "Trong thời gian trễ này, bạn có thể thấy ghi nợ từ thẻ tín dụng. Đừng lo—Patreon sẽ thử lại định kỳ để kiểm tra xem họ đã nhận thanh toán chưa. Điều này thường tự giải quyết trong vòng 24 giờ."

# {"path":"/options.html","row":"22","tags":null}
#. idx/22/innerText
msgctxt "tpp:/options.html:22"
msgid "If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible."
msgstr "Nếu vấn đề vẫn tiếp diễn sau khoảng thời gian này, vui lòng đăng trong <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">luồng account-problem</a> trên máy chủ Translator++ trên Discord. Tôi sẽ hỗ trợ bạn nhiều nhất có thể."

# {"path":"/options.html","row":"23","tags":null}
#. idx/23/innerText
msgctxt "tpp:/options.html:23"
msgid "Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>."
msgstr "Vui lòng hiểu rằng để ngăn chặn gian lận, <b><span class=\"userInfoPoints\">điểm</span> và <span class=\"userInfoLevel\">Cấp độ</span> sẽ không được tính cho đến khi thanh toán của bạn được Patreon nhận thành công</b>."

# {"path":"/options.html","row":"24","tags":null}
