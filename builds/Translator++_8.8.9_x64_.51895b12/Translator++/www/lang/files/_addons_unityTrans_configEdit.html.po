msgctxt "tpp:/addons/unityTrans/configEdit.html:105"
msgid "The width (per translator) of the translation aggregator window."
msgstr "Chiều rộng (mỗi trình dịch) của cửa sổ tổng hợp dịch thuật."

# {"path":"/addons/unityTrans/configEdit.html","row":"106","tags":null}
#. idx/115/innerText
msgctxt "tpp:/addons/unityTrans/configEdit.html:106"
msgid "Enabled Translators"
msgstr "Trình dịch đã bật"

# {"path":"/addons/unityTrans/configEdit.html","row":"107","tags":null}
#. idx/116/innerText
msgctxt "tpp:/addons/unityTrans/configEdit.html:107"
msgid "The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'"
msgstr "ID của các điểm cuối dịch thuật đã được bật trong cửa sổ tổng hợp dịch thuật. Danh sách được phân tách bằng ';'"

# {"path":"/addons/unityTrans/configEdit.html","row":"108","tags":null}
