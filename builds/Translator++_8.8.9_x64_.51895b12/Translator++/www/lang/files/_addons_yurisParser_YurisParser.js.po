# {"path":"/addons/yurisParser/YurisParser.js","row":"11","tags":null}
#. tid/6550/type/StringLiteral
msgctxt "tpp:/addons/yurisParser/YurisParser.js:11"
msgid "Select the repack method."
msgstr "Chọn phương pháp đóng gói lại."

# {"path":"/addons/yurisParser/YurisParser.js","row":"12","tags":null}
#. tid/6557/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/yurisParser/YurisParser.js:12"
msgid "<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>"
msgstr "<ul><li><b>Đóng gói lại vào tệp YPF gốc</b><br />Sẽ đóng gói lại bản dịch vào bản gốc. Có thể mất nhiều thời gian hơn để trích xuất bản gốc, vá nó với bản dịch và đóng gói lại.</li>"

# {"path":"/addons/yurisParser/YurisParser.js","row":"13","tags":null}
#. tid/6561/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/yurisParser/YurisParser.js:13"
msgid "<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>"
msgstr "<li><b>Đóng gói lại dưới dạng tệp vá YPF</b><br>Sẽ đóng gói lại bản dịch thành một tệp vá riêng biệt (ví dụ: update9.ypf). Bằng cách này, có thể dịch trò chơi mà không cần sửa đổi các tệp ypf gốc. Kết hợp điều này với tùy chọn <b>Không sao chép tài liệu, chỉ tiêm bản dịch</b> trong Sao chép tài liệu để quá trình vá nhanh hơn.</li></ul>"

# {"path":"/addons/yurisParser/YurisParser.js","row":"14","tags":null}
#. tid/6613/type/StringLiteral
msgctxt "tpp:/addons/yurisParser/YurisParser.js:14"
msgid "The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project."
msgstr "Phiên bản đóng gói lại mục tiêu phải khớp với phiên bản trò chơi của bạn. Nhập phiên bản chính và phụ cách nhau bằng dấu chấm. Ví dụ: <b>0.466</b>. Mặc định, Translator++ sẽ phát hiện phiên bản động cơ khi bạn tạo dự án."
