"          <ul>\n"
"            <li><pre>undefined</pre></li>\n"
"            <li data-tran=\"\">Offset of the captured text, for example:\n"
"<pre>  {\n"
"    start:100,\n"
"    end:120,\n"
"    rowInfoText:\"Character Name\", // Character name. optional\n"
"    context: [\"some\", \"context\", \"here\"] // Context. optional\n"
"  }\n"
"</pre>\n"
"            </li>\n"
"            <li data-tran=\"\">Array of the offset of the captured text, for example:\n"
"<pre>  [\n"
"    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n"
"    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n"
"    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n"
"  ]\n"
"</pre>              \n"
"            </li>\n"
"          </ul>\n"
"        "
msgstr ""
"\n"
"          <h2 data-tran=\"\">Giá trị trả về mong đợi</h2>\n"
"          <p data-tran=\"\">Mã của bạn phải <b>trả về</b> một trong các giá trị sau:</p>\n"
"          <ul>\n"
"            <li><pre>undefined</pre></li>\n"
"            <li data-tran=\"\">Độ lệch của văn bản đã chụp, ví dụ:\n"
"<pre>  {\n"
"    start:100,\n"
"    end:120,\n"
"    rowInfoText:\"Tên nhân vật\", // Tên nhân vật. tùy chọn\n"
"    context: [\"một số\", \"ngữ cảnh\", \"ở đây\"] // Ngữ cảnh. tùy chọn\n"
"  }\n"
"</pre>\n"
"            </li>\n"
"            <li data-tran=\"\">Mảng độ lệch của văn bản đã chụp, ví dụ:\n"
"<pre>  [\n"
"    {start:0, end:5, rowInfoText:\"Tên nhân vật\", context: [\"một số\", \"ngữ cảnh\", \"ở đây\"]},\n"
"    {start:12, end:30, rowInfoText:\"Nhân vật khác\", context: [\"ngữ cảnh\", \"khác\"]},\n"
"    {start:4581, end:4593, rowInfoText:\"Nhân vật thứ ba\", context: [\"ngữ cảnh\", \"thứ ba\"]}\n"
"  ]\n"
"</pre>              \n"
"            </li>\n"
"          </ul>\n"
"        "

