msgstr "Hành động mà mẫu sẽ thực hiện."

# {"path":"/addons/customParser/modelEditor/modelEditor.html","row":"51","tags":null}
#. idx/54/innerText
msgctxt "tpp:/addons/customParser/modelEditor/modelEditor.html:51"
msgid "Javascript function"
msgstr "Hàm Javascript"

# {"path":"/addons/customParser/modelEditor/modelEditor.html","row":"52","tags":null}
#. idx/55/innerText
msgctxt "tpp:/addons/customParser/modelEditor/modelEditor.html:52"
msgid "Guide"
msgstr "Hướng dẫn"

# {"path":"/addons/customParser/modelEditor/modelEditor.html","row":"53","tags":null}
#. idx/56/innerText
msgctxt "tpp:/addons/customParser/modelEditor/modelEditor.html:53"
msgid ""
"\n"
"          <h2 data-tran=\"\">Arguments</h2>\n"
"          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n"
"          <ul>\n"
"            <li>\n"
"              <h3>text</h3>\n"
"              <p><b>String</b></p>\n"
"              <p data-tran=\"\">A string of the entire content of the file.</p>\n"
"            </li>\n"
"            <li>\n"
"              <h3>thisModel</h3>\n"
"              <p><b>Object</b></p>\n"
"              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n"
"            </li>\n"
"          </ul>\n"
"          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n"
"          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n"
"\n"
"        "
msgstr ""
"\n"
"          <h2 data-tran=\"\">Đối số</h2>\n"
"          <p data-tran=\"\">Mã bạn viết sẽ nằm trong một hàm với 2 đối số có thể truy cập ở bất kỳ đâu trong mã của bạn:</p>\n"
"          <ul>\n"
"            <li>\n"
"              <h3>text</h3>\n"
"              <p><b>Chuỗi</b></p>\n"
"              <p data-tran=\"\">Một chuỗi chứa toàn bộ nội dung của tệp.</p>\n"
"            </li>\n"
"            <li>\n"
"              <h3>thisModel</h3>\n"
"              <p><b>Đối tượng</b></p>\n"
"              <p data-tran=\"\">Đối tượng quy tắc hiện đang được sử dụng bởi tệp.</p>\n"
"            </li>\n"
"          </ul>\n"
"          <h2 data-tran=\"\">Từ khóa <i>this</i></h2>\n"
"          <p data-tran=\"\"><b>this</b> sẽ tham chiếu đến thể hiện của lớp CustomParser.</p>\n"
"\n"
"        "

