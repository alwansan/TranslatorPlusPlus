# {"path":"/addons/customParser/modelEditor/modelEditor.html","row":"65","tags":null}
#. idx/68/innerText
msgctxt "tpp:/addons/customParser/modelEditor/modelEditor.html:65"
msgid ""
"\n"
"          <h2 data-tran=\"\">Example</h2>\n"
"          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n"
"<pre><code class=\"language-javascript\">\n"
"/*\n"
"  Translator++ is using regexp-match-indices\n"
"  by that all RegExp.exec() method will return their group offset\n"
"  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n"
"*/\n"
"\n"
"var result \t\t\t= [];\n"
"var captureGroup \t= 1;\n"
"var regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\n"
"while(null != (matches=regex.exec(text))) {\n"
"  console.log(matches);\n"
"  if (!matches?.indices?.[captureGroup]) continue;\n"
"  result.push({\n"
"    start\t: matches.indices[captureGroup][0],\n"
"    end\t\t: matches.indices[captureGroup][1]\n"
"  })\n"
"}\n"
"return result;             \n"
"</code>\n"
"</pre>\n"
"        "
msgstr ""
"\n"
"          <h2 data-tran=\"\">Ví dụ</h2>\n"
"          <p data-tran=\"\">Mã sau đây là một ví dụ để phân tích phụ đề srt.</p>\n"
"<pre><code class=\"language-javascript\">\n"
"/*\n"
"  Translator++ đang sử dụng regexp-match-indices\n"
"  do đó tất cả phương thức RegExp.exec() sẽ trả về độ lệch nhóm của chúng\n"
"  đọc thêm về Chỉ số Biểu thức Chính quy tại đây: https://v8.dev/features/regexp-match-indices\n"
"*/\n"
"\n"
"var result \t\t\t= [];\n"
"var captureGroup \t= 1;\n"
"var regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\n"
"while(null != (matches=regex.exec(text))) {\n"
"  console.log(matches);\n"
"  if (!matches?.indices?.[captureGroup]) continue;\n"
"  result.push({\n"
"    start\t: matches.indices[captureGroup][0],\n"
"    end\t\t: matches.indices[captureGroup][1]\n"
"  })\n"
"}\n"
"return result;             \n"
"</code>\n"
"</pre>\n"
"        "

