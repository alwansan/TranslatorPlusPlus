# {"path":"/trans.html","row":"180","tags":null}
#. idx/199/innerText
msgctxt "tpp:/trans.html:180"
msgid ""
"\n"
"\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n"
"\t\t\t\tBy default, some parsers use the staging directory as the source material.\n"
"\t\t\t"
msgstr ""
"\n"
"\t\t\t\tChọn tài liệu hoặc nội dung cụ thể bạn muốn dịch, chẳng hạn như tệp, thư mục hoặc đầu vào liên quan khác. Đảm bảo tài liệu đã chọn có thể truy cập và được định dạng phù hợp cho trình phân tích tương ứng.<br>\n"
"\t\t\t\tMặc định, một số trình phân tích sử dụng thư mục staging làm tài liệu nguồn.\n"
"\t\t\t"

