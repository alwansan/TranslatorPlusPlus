# {"path":"/trans.html","row":"178","tags":null}
#. idx/197/innerText
msgctxt "tpp:/trans.html:178"
msgid "You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object."
msgstr "Bạn sắp tiêm bản dịch qua nút <b>Tiêm tất cả</b>. Điều này sẽ tiêm bản dịch bất kể đối tượng bạn chọn ở khung bên trái. Sử dụng menu ngữ cảnh của khung trái nếu bạn muốn tiêm đối tượng đã chọn."

# {"path":"/trans.html","row":"179","tags":null}
#. idx/198/innerText
msgctxt "tpp:/trans.html:179"
msgid "Select the source material to be translated"
