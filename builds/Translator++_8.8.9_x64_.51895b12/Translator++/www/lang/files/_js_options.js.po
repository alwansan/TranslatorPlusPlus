msgstr "Lỗi phân tích mẫu:"

# {"path":"/js/options.js","row":"22","tags":null}
#. tid/16519/type/NoSubstitutionTemplate
msgctxt "tpp:/js/options.js:22"
msgid "Do you really want to clear the custom escaper?"
msgstr "Bạn thực sự muốn xóa trình thoát tùy chỉnh?"

# {"path":"/js/options.js","row":"23","tags":null}
#. tid/16597/type/NoSubstitutionTemplate
