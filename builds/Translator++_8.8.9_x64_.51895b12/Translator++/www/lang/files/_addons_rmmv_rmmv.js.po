msgstr "Sử dụng phiên bản 32-bit"

# {"path":"/addons/rmmv/rmmv.js","row":"32","tags":null}
#. tid/22570/type/StringLiteral
msgctxt "tpp:/addons/rmmv/rmmv.js:32"
msgid "Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude)."
msgstr "Sử dụng phiên bản 32-bit của NWJS. Phiên bản 32-bit hữu ích cho khả năng tương thích với các hệ thống cũ. Khuyến nghị bỏ chọn tùy chọn này nếu có thể (chỉ cần nâng cấp máy của bạn, anh bạn)."

