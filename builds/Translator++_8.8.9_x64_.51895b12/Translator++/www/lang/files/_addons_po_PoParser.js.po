# {"path":"/addons/po/PoParser.js","row":"0","tags":null}
#. tid/907/type/StringLiteral
msgctxt "tpp:/addons/po/PoParser.js:0"
msgid ".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading."
msgstr "Tệp .po và .mo là định dạng tệp văn bản và nhị phân tiêu chuẩn được sử dụng cùng nhau để bản địa hóa phần mềm, đặc biệt trong WordPress, để dịch chủ đề và plugin. Tệp PO (Đối tượng di động) là văn bản có thể đọc được chứa bản dịch, trong khi tệp MO (Đối tượng máy) là tệp nhị phân đã biên dịch, có thể đọc được bằng máy, được phần mềm sử dụng để tải nhanh hơn."

# {"path":"/addons/po/PoParser.js","row":"1","tags":null}
#. tid/951/type/StringLiteral
msgctxt "tpp:/addons/po/PoParser.js:1"
msgid "Start translation from PO (Portable Object) and MO (Machine Object) translation scripts"
msgstr "Bắt đầu dịch từ kịch bản dịch PO (Đối tượng di động) và MO (Đối tượng máy)"

# {"path":"/addons/po/PoParser.js","row":"2","tags":null}
