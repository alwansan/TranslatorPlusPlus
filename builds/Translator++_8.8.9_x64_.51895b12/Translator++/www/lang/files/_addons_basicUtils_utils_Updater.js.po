msgctxt "tpp:/addons/basicUtils/utils/Updater.js:0"
msgid "An update is being installed. Please do not close the application until the installation is completed."
msgstr "Đang cài đặt bản cập nhật. Vui lòng không đóng ứng dụng cho đến khi cài đặt hoàn tất."

# {"path":"/addons/basicUtils/utils/Updater.js","row":"1","tags":null}
#. tid/6562/type/StringLiteral
msgctxt "tpp:/addons/basicUtils/utils/Updater.js:1"
msgid "Package Path"
msgstr "Đường Dẫn Gói"

# {"path":"/addons/basicUtils/utils/Updater.js","row":"2","tags":null}
#. tid/6572/type/StringLiteral
msgctxt "tpp:/addons/basicUtils/utils/Updater.js:2"
msgid "Select the package file."
msgstr "Chọn tệp gói."

# {"path":"/addons/basicUtils/utils/Updater.js","row":"3","tags":null}
#. tid/6612/type/StringLiteral
msgctxt "tpp:/addons/basicUtils/utils/Updater.js:3"
msgid "Package Key"
msgstr "Khóa Gói"

# {"path":"/addons/basicUtils/utils/Updater.js","row":"4","tags":null}
#. tid/6622/type/StringLiteral
msgctxt "tpp:/addons/basicUtils/utils/Updater.js:4"
msgid "If you have the key, please enter it here. If not, leave it empty."
msgstr "Nếu bạn có khóa, hãy nhập vào đây. Nếu không, hãy để trống."

# {"path":"/addons/basicUtils/utils/Updater.js","row":"5","tags":null}
#. tid/6661/type/NoSubstitutionTemplate
msgctxt "tpp:/addons/basicUtils/utils/Updater.js:5"
msgid "Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>."
msgstr "Thông qua biểu mẫu này, bạn có thể cập nhật Translator++ bằng tệp gói cập nhật. Bạn có thể tải gói cập nhật <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>tại đây</a>."

# {"path":"/addons/basicUtils/utils/Updater.js","row":"6","tags":null}
