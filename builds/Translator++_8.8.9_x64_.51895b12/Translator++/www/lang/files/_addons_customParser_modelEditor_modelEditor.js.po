msgctxt "tpp:/addons/customParser/modelEditor/modelEditor.js:5"
msgid ""
"Please specify what kind of file you want to parse.\n"
"You can use semicolon separated glob pattens. For example: *.txt;*.js;*.json"
msgstr ""
"Vui lòng chỉ định loại tệp bạn muốn phân tích.\n"
"Bạn có thể sử dụng các mẫu glob phân cách bằng dấu chấm phẩy. Ví dụ: *.txt;*.js;*.json"

# {"path":"/addons/customParser/modelEditor/modelEditor.js","row":"6","tags":null}
