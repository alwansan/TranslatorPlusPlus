 here":128,"Translate here using ":129,"Translate using...":130,"Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?":131," cell(s) has been written!":132,"Column width":133,"Width must greater than 0":134,"Insert column right":135,"Duplicate column":136,"Remove this column":137,"Remove selected column?\nThis can not be undone!":138,"Rename this column":139,"Please enter new name":140,"Tags":141,"Red":142,"Yellow":143,"Green":144,"Blue":145,"Gold":146,"More tags...":147,"Clear tags":148,"Delete Row":149,"Do you want to remove the currently selected row(s)?":150,"Clear Context Translation":151,"Clear Automation":152,"Are you sure want to clear all quick launch scripts?":153,"Append rows to reference":154,"Row properties":155},"tags":[],"relPath":"/js/trans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":156,"length":156,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.js":{"data":[["`You cannot close the application at this moment, reason: \\n${","`Anda tidak dapat menutup aplikasi saat ini, alasan: \\n${"],["}`","}`"],["Do you really want to exit Translator++?\nAll unsaved changes will be discarded!","Apakah Anda benar-benar ingin keluar dari Translator++?\nSemua perubahan yang belum disimpan akan dibuang!"],["Trans file","File trans"],["Translator++ Project Package (TPP) file","File Paket Proyek Translator++ (TPP)"],["Select all","Pilih semua"],["Select none","Tidak pilih apa pun"],["Invert","Balikkan"],["Match destination selection","Cocokkan dengan pilihan tujuan"],["use mouse drag to do bulk selection","gunakan seret mouse untuk melakukan pemilihan massal"],["Invalid trans data","Data trans tidak valid"],["Inject / Apply translation","Suntikkan / Terapkan terjemahan"],["Inject / Apply translation to all","Suntikkan / Terapkan terjemahan ke semua"],["Cancel","Batal"],["Apply Translation","Terapkan Terjemahan"],["Target path cannot be a parent or child of the source material's path.\nPlease select another path.","Jalur target tidak boleh menjadi induk atau anak dari jalur materi sumber.\nSilakan pilih jalur lain."],["Help","Bantuan"],["Import","Impor"],["Revert to origin data","Kembalikan ke data asli"],["Select target directory.","Pilih direktori target."],["The existing files will be overwritten!","File yang ada akan ditimpa!"],["Process","Proses"],["Path to the directory can not be empty!","Jalur ke direktori tidak boleh kosong!"],["Invalid directory:","Direktori tidak valid:"],["Rebuild translation table from this cache","Bangun ulang tabel terjemahan dari cache ini"],["Create new project","Buat proyek baru"],["-nothing-","-tidak ada-"],["Ok","Oke"],["No action selected, are you sure?","Tidak ada aksi yang dipilih, Anda yakin?"],["No context's keyword specified!","Kata kunci konteks tidak ditentukan!"],["Remove context containing keyword :\n","Hapus konteks yang mengandung kata kunci :\n"],["\nfrom selected files?","\ndari file yang dipilih?"],["Remove every rows except rows that has a context containing keyword :\n","Hapus setiap baris kecuali baris yang memiliki konteks mengandung kata kunci :\n"],["items","item"],["Select Context","Pilih Konteks"],["Manual Query","Kueri Manual"],["Tag filter","Filter Tag"],["Merging option","Opsi Penggabungan"],["Source Column","Kolom Sumber"],["Target Column","Kolom Target"],["Maximum length","Panjang Maksimum"],["Query","Kueri"],["Select how you want to filter the rows to be wrapped based on their context.","Pilih cara Anda ingin memfilter baris yang akan dibungkus berdasarkan konteksnya."],["Your list of context separated by new line","Daftar konteks Anda yang dipisahkan oleh baris baru"],["Optionally filter rows by their color tags.","Opsional, filter baris berdasarkan tag warna mereka."],["Options","Opsi"],["No merging","Tidak ada penggabungan"],["Merge lines","Gabungkan baris"],["Merge lines except first line","Gabungkan baris kecuali baris pertama"],["General setup","Pengaturan Umum"],["Wrap text","Bungkus teks"],["Source & target column can not be same!","Kolom sumber dan target tidak boleh sama!"],["No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?","Tidak ada file yang dipilih di panel pemilih file.\nTranslator++ akan menganggap bahwa semua file akan diproses\nApakah Anda yakin dengan ini?"],["One or more required options are not set for ","Satu atau lebih opsi yang diperlukan tidak diatur untuk "],["One or more settings required by the translator engine are not set. If you continue, the translation process may fail.","Satu atau lebih pengaturan yang diperlukan oleh mesin penerjemah tidak diatur. Jika Anda melanjutkan, proses penerjemahan mungkin gagal."],["Required options :","Opsi yang diperlukan :"],["Open the settings","Buka pengaturan"],["Continue anyway","Lanjutkan saja"],["Translate Now","Terjemahkan Sekarang"],["Please select translator engine","Silakan pilih mesin penerjemah"],["Can not process your request because the source column and target column are same!","Tidak dapat memproses permintaan Anda karena kolom sumber dan target sama!"],["Tags","Tag"],["Merge Option","Opsi Gabung"],["Add rows","Tambahkan baris"],["None","Tidak ada"],["Merge","Gabung"],["Merge except the first line","Gabung kecuali baris pertama"],["No export path specified","Tidak ada jalur ekspor yang ditentukan"],["Export path can not be inside or the same with the project folder.\nYour export path: ","Jalur ekspor tidak boleh di dalam atau sama dengan folder proyek.\nJalur ekspor Anda: "],["\nYour project path: ","\nJalur proyek Anda: "],["\n\nPlease choose another folder!","\n\nSilakan pilih folder lain!"],["Export Now","Ekspor Sekarang"],["Action","Aksi"],["Append tags","Tambahkan tag"],["Remove tags","Hapus tag"],["Set tags","Atur tag"],["Do nothing","Tidak melakukan apa-apa"],["-unknown title-","-judul tidak diketahui-"],["Can not open file. File not exist.","Tidak dapat membuka file. File tidak ada."],["Go to online documentation.","Buka dokumentasi online."],["No projects yet","Belum ada proyek"],["Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t","Apakah Anda baru mengenal Translator++?<br />\n\t\t\tSilakan baca dokumentasi online kami di <b>dreamsavior.net</b>.<br />\n\t\t\tTekan <b>F1</b> untuk membuka bantuan online.<br />\n\t\t\tHubungi saya di <b>patreon.com/dreamsavior</b> untuk pertanyaan dan laporan bug.\n\t\t\t"],["Warning","Peringatan"],["Close","Tutup"],["You are about to run a user script!","Anda akan menjalankan skrip pengguna!"],["Execute the script","Jalankan skrip"],["Bring to main screen","Bawa ke layar utama"],["Show row header info","Tampilkan info header baris"],["Row header width","Lebar header baris"],["Display marker on organic cells","Tampilkan penanda pada sel organik"],["Leave trail on cell visit","Tinggalkan jejak pada kunjungan sel"],["Display trails on visited cells","Tampilkan jejak pada sel yang dikunjungi"],["Row Properties","Properti Baris"],["Project Properties","Properti Proyek"],["Project Properties : ","Properti Proyek : "],["Stage path do not exist!","Jalur panggung tidak ada!"],["Select dev folder","Pilih folder dev"],["Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.","Di mana direktori game yang diterjemahkan berada?<br />Ini adalah folder yang sama dengan direktori tujuan saat menyuntikkan game Anda."],["Select folder","Pilih folder"],["Submit","Kirim"],["File Properties","Properti File"],["File Properties : ","Properti File : "],["Target column","Kolom target"],["Trim Whitespaces","Pangkas Spasi"],["Please select a column","Silakan pilih kolom"],["Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!","Apakah Anda yakin ingin memangkas spasi pada kolom yang dipilih?\nTindakan ini tidak dapat dibatalkan!"],["Are you sure want commit autopadding on selected column?\nThis action can not be undone!","Apakah Anda yakin ingin melakukan autopadding pada kolom yang dipilih?\nTindakan ini tidak dapat dibatalkan!"],["Markers","Penanda"],["Markers are visual guidelines for the number of characters in a line.","Penanda adalah panduan visual untuk jumlah karakter dalam satu baris."],["The marker will only be visible if wordwrap in the text area is disabled.","Penanda hanya akan terlihat jika wordwrap di area teks dinonaktifkan."],["Add","Tambah"],["Clear all","Hapus semua"],["Enable suggestion","Aktifkan saran"],["Speech Synthesizer","Sintesis Suara"],["Reading speed:","Kecepatan membaca:"],["Pitch:","Nada:"],["Volume:","Volume:"],["Mark at","Tandai pada"],["Units","Satuan"],["Half width character (ie. Alphabet, etc)","Karakter setengah lebar (mis. Alfabet, dll)"],["Full width character (ie. Hiragana, Kanji, 漢字, etc)","Karakter lebar penuh (mis. Hiragana, Kanji, 漢字, dll)"],["Color","Warna"],["Remove","Hapus"],["Current Cell's Editor Options","Opsi Editor Sel Saat Ini"],["Auto Padding","Padding Otomatis"],["Create","Buat"],["Unable to open that file!","Tidak dapat membuka file itu!"],["Are you sure want to close the project?\nYou will lost any unsaved changes!","Apakah Anda yakin ingin menutup proyek?\nAnda akan kehilangan perubahan yang belum disimpan!"],["Are you sure want to exit Translator++?\nYou will lost any unsaved changes!","Apakah Anda yakin ingin keluar dari Translator++?\nAnda akan kehilangan perubahan yang belum disimpan!"],["Do not show this message again!","Jangan tampilkan pesan ini lagi!"],["Back","Kembali"],["Are you sure want to execute the following script?","Apakah Anda yakin ingin menjalankan skrip berikut?"],["No script found","Tidak ada skrip ditemukan"],["Open Script Editor","Buka Editor Skrip"],["How to add Automation here","Cara menambahkan Otomatisasi di sini"],["Clear Quick Launch","Hapus Peluncur Cepat"],["Are you sure want to clear all quick launch scripts?","Apakah Anda yakin ingin menghapus semua skrip peluncur cepat?"],["Remove selected objects?","Hapus objek yang dipilih?"],["Do you wish to remove related staging files too?\nWarning: This is can not be undone!","Apakah Anda ingin menghapus file pementasan terkait juga?\nPeringatan: Ini tidak dapat dibatalkan!"],["Error!\r\nTranslator++ is unable to detect the type of ","Kesalahan!\r\nTranslator++ tidak dapat mendeteksi jenis "],["`Required application to parse ${","`Aplikasi yang diperlukan untuk memproses ${"],["} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`","} tidak terinstal.\\nHarap instal melalui penginstal aplikasi pihak ketiga.\\nApakah Anda ingin membuka jendela Penginstal Aplikasi Pihak Ketiga?`"],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","Game ini dikemas dengan Enigma.\r\nApakah Anda ingin mengekstrak paket?\r\nIni akan memakan waktu beberapa menit, tergantung ukuran game Anda."],["Copy & extract data into ","Salin & ekstrak data ke "],["Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!","Apakah Anda benar-benar yakin ingin menghapus semua terjemahan di halaman saat ini?\nPeringatan: ini adalah tindakan yang tidak dapat dibatalkan!"],["Are you realy sure want to delete current file?\nWarning: this is irreversible action!","Apakah Anda benar-benar yakin ingin menghapus file saat ini?\nPeringatan: ini adalah tindakan yang tidak dapat dibatalkan!"],["Please enter the title","Silakan masukkan judul"],["Do you want to remove the currently selected row(s)?","Apakah Anda ingin menghapus baris yang dipilih saat ini?"]],"context":[["tid/154/ty