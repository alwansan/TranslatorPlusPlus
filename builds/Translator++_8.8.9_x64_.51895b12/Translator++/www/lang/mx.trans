{"data":[[null]],"columns":[{"readOnly":false,"wordWrap":true,"width":200},{"readOnly":false,"wordWrap":true,"width":339},{"readOnly":false,"wordWrap":true,"width":134},{"readOnly":false,"wordWrap":true,"width":120},{"readOnly":false,"wordWrap":true,"width":109}],"colHeaders":["Original Text","Initial","Machine translation","Better translation","Best translation"],"project":{"indexOriginal":0,"gameEngine":"APPUI","files":{"/addons/VNTextPatch/vntextpatch.js":{"data":[["I have extracted the game data","Saya telah mengekstrak data permainan"],["Load game's data folder","Muat folder data permainan"],["Select the game's data folder","Pilih folder data permainan"],["Engine Info","Info Mesin"],["Currently detected engine","Mesin yang terdeteksi saat ini"],["Manually Specify Format","Tentukan Format Secara Manual"],["Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.","Tentukan format permainan secara manual.<br />VNTranslationTools akan mendeteksi format secara otomatis berdasarkan ekstensi file. Namun, jika Anda menemukan ekstensi file yang ambigu, harap berikan format secara eksplisit."],["Interface","Antarmuka"],["VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.","VNTextPatch dapat mengurai permainan ke dalam dua format: JSON atau spreadsheet XLSX. Silakan pilih antarmuka yang ingin Anda gunakan."],["Warning: There is a row limit if you're choosing XLSX spreadsheet.","Peringatan: Ada batas baris jika Anda memilih spreadsheet XLSX."],["Create a new project","Buat proyek baru"],["Invalid destination directory:","Direktori tujuan tidak valid:"],["Close","Tutup"]],"context":[["tid/8164/type/StringLiteral"],["tid/8228/type/StringLiteral"],["tid/8233/type/StringLiteral"],["tid/8246/type/StringLiteral"],["tid/8251/type/StringLiteral"],["tid/8256/type/StringLiteral"],["tid/8261/type/StringLiteral"],["tid/8266/type/StringLiteral"],["tid/8271/type/StringLiteral"],["tid/8276/type/StringLiteral"],["tid/8455/type/StringLiteral"],["tid/8516/type/NoSubstitutionTemplate"],["tid/11110/type/StringLiteral"]],"basename":"vntextpatch.js","dirname":"/addons/VNTextPatch","extension":".js","filename":"vntextpatch.js","path":"/addons/VNTextPatch/vntextpatch.js","indexIsBuilt":false,"indexIds":{"I have extracted the game data":0,"Load game's data folder":1,"Select the game's data folder":2,"Engine Info":3,"Currently detected engine":4,"Manually Specify Format":5,"Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.":6,"Interface":7,"VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.":8,"Warning: There is a row limit if you're choosing XLSX spreadsheet.":9,"Create a new project":10,"Invalid destination directory:":11,"Close":12},"tags":[],"relPath":"/addons/VNTextPatch/vntextpatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}]],"lastSelectedCell":[0,1]},"/addons/actionEditorParser/ae4parser.js":{"data":[["Start translation from Action Editor 4 Game","Mulai terjemahan dari Action Editor 4 Game"],["Create Project","Buat Proyek"]],"context":[["tid/920/type/StringLiteral"],["tid/997/type/StringLiteral"]],"basename":"ae4parser.js","dirname":"/addons/actionEditorParser","extension":".js","filename":"ae4parser.js","path":"/addons/actionEditorParser/ae4parser.js","indexIsBuilt":false,"indexIds":{"Start translation from Action Editor 4 Game":0,"Create Project":1},"tags":[],"relPath":"/addons/actionEditorParser/ae4parser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/adminTools/!post.html":{"data":[["Actions","Aksi"],["Build for 32bit system","Bangun untuk sistem 32bit"],["Build for non developer build too","Bangun juga untuk build non-pengembang"],["Custom Version","Versi Kustom"],["Custom version (leave blank to autogenerate version)","Versi kustom (biarkan kosong untuk menghasilkan versi otomatis)"],["Generate minor versioning?","Buat versi minor?"],["Save patch to","Simpan patch ke"],["Destination folder of generated patch","Folder tujuan patch yang dihasilkan"],["Overider template","Template pengganti"],["Release template","Template rilis"],["Select file to be available live and excluded from the package","Pilih file yang tersedia langsung dan dikecualikan dari paket"],["The file will be excluded from package, but available online","File akan dikecualikan dari paket, tetapi tersedia online"],["Make the process does not require user input","Buat proses tidak memerlukan input pengguna"],["Patch Type","Jenis Patch"],["The file will be excluded from package, but available online. Select the file you want to substitute.","File akan dikecualikan dari paket, tetapi tersedia online. Pilih file yang ingin Anda ganti."],["Substitute trans.js with a fake one.","Ganti trans.js dengan yang palsu."],["Select Patch File","Pilih File Patch"],["Select the generated patch file (*.tpch).","Pilih file patch yang dihasilkan (*.tpch)."],["Patches Links","Tautan Patch"],["Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.","Pembaruan otomatis akan mengunduh dari tautan ini. <b>Harus unduhan langsung!</b> Pisahkan setiap tautan unduhan dengan baris baru."],["Download Links","Tautan Unduhan"],["Downloadable package for manual download. Separate each download link with newline.","Paket yang dapat diunduh untuk unduhan manual. Pisahkan setiap tautan unduhan dengan baris baru."],["Release Category","Kategori Rilis"],["Category of the release.","Kategori dari rilis."],["Upload log along with this submission.","Unggah log bersama dengan pengiriman ini."],["Remove the same version found on database.","Hapus versi yang sama yang ditemukan di basis data."],["Whether this release is enabled or not.","Apakah rilis ini diaktifkan atau tidak."],["Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.","Apakah rilis ini disembunyikan atau tidak. Jika rilis disembunyikan, hanya Administrator dan anggota dengan kemampuan <code>view_hidden_releases</code> (Pengembang) yang dapat menginstal rilis melalui penginstal paket."],["Release Name","Nama Rilis"],["Release Number","Nomor Rilis"],["Release Date","Tanggal Rilis"],["Release Key","Kunci Rilis"],["Release Type","Tipe Rilis"],["CRC","CRC"],["Required Version","Versi yang Diperlukan"],["Minimum Version","Versi Minimum"],["Release Note","Catatan Rilis"],["Release Info","Info Rilis"],["On Before Install","Sebelum Instal"],["On After Install","Setelah Instal"],["Extra parameters","Parameter tambahan"],["Remote file","File jarak jauh"],["List of remote file, separate by new line","Daftar file jarak jauh, dipisahkan dengan baris baru"],["Patron Level","Tingkat Patron"],["Post title","Judul Posting"],["Release post","Rilis pos"],["Excerpt of the post","Kutipan dari pos"]],"context":[["idx/0/innerText","idx/14/innerText","idx/29/innerText","idx/79/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/16/innerText"],["idx/5/innerText","idx/17/innerText"],["idx/6/innerText","idx/18/innerText"],["idx/7/innerText","idx/19/innerText"],["idx/8/innerText","idx/20/innerText"],["idx/9/innerText","idx/21/innerText"],["idx/10/innerText","idx/22/innerText"],["idx/11/innerText","idx/25/innerText"],["idx/12/innerText"],["idx/13/innerText","idx/28/innerText"],["idx/23/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/45/innerText"],["idx/47/innerText"],["idx/49/innerText"],["idx/51/innerText"],["idx/53/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/59/innerText"],["idx/61/innerText"],["idx/63/innerText"],["idx/65/innerText"],["idx/67/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/73/innerText"],["idx/75/innerText"],["idx/77/innerText"]],"basename":"!post.html","dirname":"/addons/adminTools","extension":".html","filename":"!post.html","path":"/addons/adminTools/!post.html","indexIsBuilt":false,"indexIds":{"Actions":0,"Build for 32bit system":1,"Build for non developer build too":2,"Custom Version":3,"Custom version (leave blank to autogenerate version)":4,"Generate minor versioning?":5,"Save patch to":6,"Destination folder of generated patch":7,"Overider template":8,"Release template":9,"Select file to be available live and excluded from the package":10,"The file will be excluded from package, but available online":11,"Make the process does not require user input":12,"Patch Type":13,"The file will be excluded from package, but available online. Select the file you want to substitute.":14,"Substitute trans.js with a fake one.":15,"Select Patch File":16,"Select the generated patch file (*.tpch).":17,"Patches Links":18,"Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.":19,"Download Links":20,"Downloadable package for manual download. Separate each download link with newline.":21,"Release Category":22,"Category of the release.":23,"Upload log along with this submission.":24,"Remove the same version found on database.":25,"Whether this release is enabled or not.":26,"Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.":27,"Release Name":28,"Release Number":29,"Release Date":30,"Release Key":31,"Release Type":32,"CRC":33,"Required Version":34,"Minimum Version":35,"Release Note":36,"Release Info":37,"On Before Install":38,"On After Install":39,"Extra parameters":40,"Remote file":41,"List of remote file, separate by new line":42,"Patron Level":43,"Post title":44,"Release post":45,"Excerpt of the post":46},"tags":[],"relPath":"/addons/adminTools/!post.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":47,"length":47,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/!postPackage.html":{"data":[["Select package json file","Pilih file package json"],["Select the generated patch file","Pilih file patch yang dihasilkan"],["Or Select Destination File","Atau Pilih File Tujuan"],["Or Download location","Atau Lokasi Unduhan"],["Icon","Ikon"],["Author","Penulis"],["Name","Nama"],["name of the package.","nama paket."],["Title","Judul"],["Title of the package.","Judul paket."],["Version","Versi"],["Version of the package.","Versi paket."],["Description","Deskripsi"],["Description of the package.","Deskripsi paket."],["Whether this release is active or not.","Apakah rilis ini aktif atau tidak."],["Whether this release is hidden or not.","Apakah rilis ini tersembunyi atau tidak."],["Patron Level","Tingkat Patron"],["Current month's pledge in $","Sumbangan bulan ini dalam $"],["Patron Points","Poin Patron"],["100pts = 1$","100 poin = 1$"],["Purchase type","Jenis pembelian"],["Type of the purchase.","Jenis pembelian."],["On Before Install","Sebelum Instal"],["Javascript code to be run before install","Kode Javascript yang akan dijalankan sebelum instal"],["On After Install","Setelah Instal"],["Javascript code to be run after install","Kode Javascript yang akan dijalankan setelah instal"],["Manifest","Manifest"],["Manifest data","Data manifest"],["Minimum version","Versi minimum"],["Minimum version of Translator++ to be able to insatall this addon.","Versi minimum Translator++ yang diperlukan untuk dapat menginstal addon ini."],["Release Date","Tanggal Rilis"],["Is parser changed?","Apakah parser berubah?"],["Mark as parser change. Would warn the user to backup their project before updating to this addon.","Tandai sebagai perubahan parser. Akan memperingatkan pengguna untuk mencadangkan proyek mereka sebelum memperbarui ke addon ini."],["Remove the same version found on database.","Hapus versi yang sama yang ditemukan di database."],["Excluded files","File yang dikecualikan"],["Files listed here will be excluded from the distribution packages","File yang terdaftar di sini akan dikecualikan dari paket distribusi"],["Script URL","URL Skrip"],["Script of the URL.","Skrip dari URL."],["Upload script","Unggah skrip"],["This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t","Skrip ini akan diunggah ke back-end dan diproses dengan template skrip [php]Scripts.\n\t\t\t\t\tUntuk menggunakan fitur ini:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Buat halaman wordpress dengan template <b>[php]Scripts template</b>.<br>Anda juga dapat mengatur persyaratan patreon untuk melihat postingan.</li>\n\t\t\t\t\t\t<li>Tambahkan URL ke halaman tersebut ke dalam file package.json dengan parameter GET <b>l</b> yang menunjuk ke file lokal.<br>\n\t\t\t\t\t\tContoh: <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t"],["Actions","Aksi"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/3/innerText"],["idx/2/innerText"],["idx/4/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/47/innerText"]],"basename":"!postPackage.html","dirname":"/addons/adminTools","extension":".html","filename":"!postPackage.html","path":"/addons/adminTools/!postPackage.html","indexIsBuilt":false,"indexIds":{"Select package json file":0,"Select the generated patch file":1,"Or Select Destination File":2,"Or Download location":3,"Icon":4,"Author":5,"Name":6,"name of the package.":7,"Title":8,"Title of the package.":9,"Version":10,"Version of the package.":11,"Description":12,"Description of the package.":13,"Whether this release is active or not.":14,"Whether this release is hidden or not.":15,"Patron Level":16,"Current month's pledge in $":17,"Patron Points":18,"100pts = 1$":19,"Purchase type":20,"Type of the purchase.":21,"On Before Install":22,"Javascript code to be run before install":23,"On After Install":24,"Javascript code to be run after install":25,"Manifest":26,"Manifest data":27,"Minimum version":28,"Minimum version of Translator++ to be able to insatall this addon.":29,"Release Date":30,"Is parser changed?":31,"Mark as parser change. Would warn the user to backup their project before updating to this addon.":32,"Remove the same version found on database.":33,"Excluded files":34,"Files listed here will be excluded from the distribution packages":35,"Script URL":36,"Script of the URL.":37,"Upload script":38,"This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t":39,"Actions":40},"tags":[],"relPath":"/addons/adminTools/!postPackage.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":41,"length":41,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/adminTools.js":{"data":[["Close","Tutup"],[null,null,null,null,null]],"context":[["tid/588/type/StringLiteral"]],"basename":"adminTools.js","dirname":"/addons/adminTools","extension":".js","filename":"adminTools.js","path":"/addons/adminTools/adminTools.js","indexIsBuilt":true,"indexIds":{"Close":0},"tags":[],"relPath":"/addons/adminTools/adminTools.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}]],"lastSelectedCell":[0,1]},"/addons/aec/aec.js":{"data":[["Universal Archive Unpacker","Universal Archive Unpacker"]],"context":[["tid/1001/type/StringLiteral","tid/1239/type/StringLiteral"]],"basename":"aec.js","dirname":"/addons/aec","extension":".js","filename":"aec.js","path":"/addons/aec/aec.js","indexIsBuilt":false,"indexIds":{"Universal Archive Unpacker":0},"tags":[],"relPath":"/addons/aec/aec.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/bakinParser/bakin-proxy.js":{"data":[["Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.","Ekstrak kamus game Bakin dari data.rbpack, terjemahkan dic.txt, dan patch pemutar secara otomatis."],["Create project","Buat proyek"],["Error: customField is not defined. This should not happen!","Kesalahan: customField tidak terdefinisi. Ini seharusnya tidak terjadi!"],["Please select the Bakin game executable.","Silakan pilih file eksekutif game Bakin."],["<h2>Proxy workflow</h2>","<h2>Alur kerja proxy</h2>"],["Translator++ unpacks data.rbpack into a temporary folder.","Translator++ membongkar data.rbpack ke dalam folder sementara."],["Split Dictionary uses dump-split and creates one .txt file per source area by default.","Pisahkan Kamus menggunakan dump-split dan membuat satu file .txt per area sumber secara default."],["Merge Dictionary uses a single dic.txt.","Gabungkan Kamus menggunakan satu dic.txt."],["Injection merges split dictionaries back into data/dic.txt and patches the player executable.","Injeksi menggabungkan kamus yang terpisah kembali ke data/dic.txt dan mem-patch file eksekutif pemutar."],["Split Dictionary (default)","Pisahkan Kamus (default)"],["Merge Dictionary","Gabungkan Kamus"]],"context":[["tid/2860/type/StringLiteral"],["tid/2929/type/StringLiteral"],["tid/2966/type/StringLiteral"],["tid/3002/type/StringLiteral"],["tid/3253/type/NoSubstitutionTemplate"],["tid/3266/type/StringLiteral"],["tid/3277/type/StringLiteral"],["tid/3288/type/StringLiteral"],["tid/3299/type/StringLiteral"],["tid/3383/type/StringLiteral"],["tid/3393/type/StringLiteral"]],"basename":"bakin-proxy.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-proxy.js","path":"/addons/bakinParser/bakin-proxy.js","indexIsBuilt":false,"indexIds":{"Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the Bakin game executable.":3,"<h2>Proxy workflow</h2>":4,"Translator++ unpacks data.rbpack into a temporary folder.":5,"Split Dictionary uses dump-split and creates one .txt file per source area by default.":6,"Merge Dictionary uses a single dic.txt.":7,"Injection merges split dictionaries back into data/dic.txt and patches the player executable.":8,"Split Dictionary (default)":9,"Merge Dictionary":10},"tags":[],"relPath":"/addons/bakinParser/bakin-proxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/bakinParser/bakin-xlsx.js":{"data":[["Start a translation project from RPG Developer Bakin localization sheet (xlsx).","Mulai proyek terjemahan dari lembar lokalisasi RPG Developer Bakin (xlsx)."],["Create project","Buat proyek"],["Error: customField is not defined. This should not happen!","Kesalahan: customField tidak terdefinisi. Ini seharusnya tidak terjadi!"],["Please select the entry point to translate.","Silakan pilih titik masuk untuk diterjemahkan."],["<h2>RPG Developer Bakin editor is required</h2>","<h2>Editor RPG Developer Bakin diperlukan</h2>"],["RPG Developer Bakin editor is required to start the translation project.","Editor RPG Developer Bakin diperlukan untuk memulai proyek penerjemahan."],["<h2>Before you start</h2>","<h2>Sebelum Anda memulai</h2>"],["<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.","<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Ekstrak game Anda</a> menjadi proyek RPG Developer Bakin yang dapat diedit."],["Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.","Ekspor string lokalisasi dengan menggunakan aplikasi RPG Developer Bakin ke dalam file xlsx. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">Lihat panduan di sini tentang cara menerjemahkan game Bakin</a>."]],"context":[["tid/614/type/StringLiteral"],["tid/683/type/StringLiteral"],["tid/720/type/StringLiteral"],["tid/756/type/StringLiteral"],["tid/1034/type/NoSubstitutionTemplate"],["tid/1041/type/NoSubstitutionTemplate"],["tid/1064/type/NoSubstitutionTemplate"],["tid/1077/type/NoSubstitutionTemplate"],["tid/1088/type/NoSubstitutionTemplate"]],"basename":"bakin-xlsx.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-xlsx.js","path":"/addons/bakinParser/bakin-xlsx.js","indexIsBuilt":false,"indexIds":{"Start a translation project from RPG Developer Bakin localization sheet (xlsx).":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the entry point to translate.":3,"<h2>RPG Developer Bakin editor is required</h2>":4,"RPG Developer Bakin editor is required to start the translation project.":5,"<h2>Before you start</h2>":6,"<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.":7,"Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.":8},"tags":[],"relPath":"/addons/bakinParser/bakin-xlsx.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/basicUtils.js":{"data":[["NWJS Version","Versi NWJS"],["Change into this NWJS version","Ubah ke versi NWJS ini"],["Use Developer version","Gunakan versi Pengembang"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","Gunakan versi NWJS Pengembang. Versi Pengembang memiliki alat pengembang yang tersedia. Cocok untuk debugging dan pengembangan."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Dalam versi Pengembang, Anda dapat menggunakan <b>Konsol Pengembang</b>. Konsol Pengembang dapat diakses dengan menekan F12 atau mengklik kanan aplikasi dan memilih 'Periksa'."],["Use 32-bit version","Gunakan versi 32-bit"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","Gunakan versi NWJS 32-bit. Versi 32-bit berguna untuk kompatibilitas dengan sistem lama. Disarankan untuk tidak mencentang opsi ini jika memungkinkan (tingkatkan saja mesin Anda, bro)."],["Some Translator++ feature may not work across NWJS version","Beberapa fitur Translator++ mungkin tidak berfungsi di semua versi NWJS"],["Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.","Harap perhatikan bahwa beberapa fitur Translator++ mungkin tidak berfungsi di semua versi NWJS. Pastikan untuk menguji proyek Anda setelah mengubah versi NWJS."],["You're currently running on NWJS ver.","Anda saat ini menjalankan pada NWJS ver."],["Change Translator++ Core NWJS version","Ubah versi NWJS Inti Translator++"],["You're already using the selected NWJS version.","Anda sudah menggunakan versi NWJS yang dipilih."],["This operation will close Translator++ and change the current NW.js version into","Operasi ini akan menutup Translator++ dan mengubah versi NW.js saat ini menjadi"],["If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?","Jika Anda memiliki perubahan yang belum disimpan, pilih 'Batal' dan simpan proyek Anda terlebih dahulu.\nApakah Anda ingin melanjutkan?"]],"context":[["tid/1342/type/StringLiteral"],["tid/1352/type/StringLiteral"],["tid/1428/type/StringLiteral","tid/1617/type/StringLiteral"],["tid/1438/type/StringLiteral"],["tid/1449/type/StringLiteral"],["tid/1482/type/StringLiteral","tid/1641/type/StringLiteral"],["tid/1492/type/StringLiteral"],["tid/1532/type/NoSubstitutionTemplate"],["tid/1537/type/NoSubstitutionTemplate"],["tid/1542/type/StringLiteral"],["tid/1669/type/NoSubstitutionTemplate"],["tid/1745/type/NoSubstitutionTemplate"],["tid/1769/type/NoSubstitutionTemplate"],["tid/1782/type/NoSubstitutionTemplate"]],"basename":"basicUtils.js","dirname":"/addons/basicUtils","extension":".js","filename":"basicUtils.js","path":"/addons/basicUtils/basicUtils.js","indexIsBuilt":false,"indexIds":{"NWJS Version":0,"Change into this NWJS version":1,"Use Developer version":2,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":3,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":4,"Use 32-bit version":5,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":6,"Some Translator++ feature may not work across NWJS version":7,"Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.":8,"You're currently running on NWJS ver.":9,"Change Translator++ Core NWJS version":10,"You're already using the selected NWJS version.":11,"This operation will close Translator++ and change the current NW.js version into":12,"If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?":13},"tags":[],"relPath":"/addons/basicUtils/basicUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/basicUtils/mainMenu.js":{"data":[["Change Language","Ubah Bahasa"],["No MTL available for this language pair","Tidak ada MTL tersedia untuk pasangan bahasa ini"],["Change default MTL for this project","Ubah MTL default untuk proyek ini"],["???","???"],["Search in a folder","Cari di folder"],["Search in Staging Files","Cari di File Staging"],["Search in Original Files","Cari di File Asli"],["No original files path is set for this project.","Tidak ada jalur file asli yang ditetapkan untuk proyek ini."],["Search in Translated Files","Cari di File Terjemahan"],["No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.","Tidak ada jalur file terjemahan yang ditetapkan untuk proyek ini.\nAnda perlu menyuntikkan terjemahan Anda sekali untuk menetapkan jalur file terjemahan."],["Chat with AI Assistant","Berkirim pesan dengan Asisten AI"],["AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.","Asisten AI tidak tersedia karena fitur baru belum dimuat.\nSilakan instal ulang atau perbarui ulang Translator++."]],"context":[["tid/442/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/974/type/StringLiteral"],["tid/1182/type/StringLiteral"],["tid/1339/type/StringLiteral"],["tid/1404/type/StringLiteral"],["tid/1501/type/StringLiteral"],["tid/1539/type/StringLiteral"],["tid/1624/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1777/type/StringLiteral"],["tid/1812/type/StringLiteral"]],"basename":"mainMenu.js","dirname":"/addons/basicUtils","extension":".js","filename":"mainMenu.js","path":"/addons/basicUtils/mainMenu.js","indexIsBuilt":false,"indexIds":{"Change Language":0,"No MTL available for this language pair":1,"Change default MTL for this project":2,"???":3,"Search in a folder":4,"Search in Staging Files":5,"Search in Original Files":6,"No original files path is set for this project.":7,"Search in Translated Files":8,"No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.":9,"Chat with AI Assistant":10,"AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.":11},"tags":[],"relPath":"/addons/basicUtils/mainMenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":12,"length":12,"percent":100},"parameters":[]},"/addons/basicUtils/utils/HTMLPacker.js":{"data":[["Path is not a file:","Jalur bukan file:"],["Icon path is not a file:","Jalur ikon bukan file:"],["Path is not an exe file:","Jalur bukan file exe:"],["Icon path is not an ico file:","Jalur ikon bukan file ico:"],["Html entry point","Titik masuk Html"],["Select the html entry point file (usually index.html)","Pilih file titik masuk html (biasanya index.html)"],["Destination folder","Folder tujuan"],["Select destination folder. The process will replace the existing files.","Pilih folder tujuan. Proses ini akan menggantikan file yang ada."],["NWJS version","Versi NWJS"],["Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.","Opsional. Pilih versi NWJS dan arsitektur.<br />Versi terbaru tidak selalu lebih baik, gunakan saja yang berfungsi untuk Anda."],["Application ID","ID Aplikasi"],["Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.","Atur ID aplikasi untuk game. ID harus dalam huruf kecil dan hanya boleh berisi huruf, angka, dan garis bawah."],["Application description","Deskripsi aplikasi"],["Set the application description for the game.","Atur deskripsi aplikasi untuk game."],["Window title","Judul jendela"],["Set the default window title for the game.<br />This value may be overridden by the game engine.","Atur judul jendela default untuk game.<br />Nilai ini mungkin ditimpa oleh mesin game."],["Window width","Lebar jendela"],["Set the default window width for the game.","Atur lebar jendela default untuk game."],["Window height","Tinggi jendela"],["Set the default window height for the game.","Atur tinggi jendela default untuk game."],["Full screen","Layar penuh"],["Set the game to start in full screen mode.","Atur game untuk memulai dalam mode layar penuh."],["Resizable","Dapat diubah ukuran"],["Set the game window to be resizable.","Atur jendela game agar dapat diubah ukurannya."],["Game icon","Ikon game"],["Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.","Pilih file ikon untuk eksekutabel game. File ikon harus dalam format .ico. Ikon akan disematkan dalam eksekutabel game."],["Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.","Melalui formulir ini, Anda dapat membuat paket game yang dapat dimainkan. <br />Proses ini akan menggantikan file yang ada di folder tujuan."],["Start the application in full screen mode","Mulai aplikasi dalam mode layar penuh"],["Allow the application to be resizable","Izinkan aplikasi untuk dapat diubah ukurannya"],["HTML Compiler","Kompilator HTML"],["Compile","Kompilasi"],["Source path can not empty","Jalur sumber tidak boleh kosong"],["Destination path can not empty","Jalur tujuan tidak boleh kosong"]],"context":[["tid/86/type/StringLiteral","tid/4136/type/StringLiteral"],["tid/116/type/StringLiteral"],["tid/151/type/StringLiteral"],["tid/186/type/StringLiteral"],["tid/2424/type/StringLiteral"],["tid/2434/type/StringLiteral"],["tid/2474/type/StringLiteral"],["tid/2484/type/StringLiteral"],["tid/2524/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2587/type/StringLiteral"],["tid/2597/type/StringLiteral"],["tid/2631/type/StringLiteral","tid/3795/type/StringLiteral"],["tid/2641/type/StringLiteral","tid/3805/type/StringLiteral"],["tid/2675/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2722/type/StringLiteral"],["tid/2732/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2810/type/StringLiteral"],["tid/2820/type/StringLiteral"],["tid/2854/type/StringLiteral"],["tid/2864/type/StringLiteral"],["tid/2899/type/StringLiteral"],["tid/2909/type/StringLiteral"],["tid/2950/type/NoSubstitutionTemplate"],["tid/3900/type/StringLiteral"],["tid/3924/type/StringLiteral"],["tid/4020/type/StringLiteral"],["tid/4037/type/StringLiteral"],["tid/4083/type/StringLiteral"],["tid/4104/type/StringLiteral"]],"basename":"HTMLPacker.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"HTMLPacker.js","path":"/addons/basicUtils/utils/HTMLPacker.js","indexIsBuilt":false,"indexIds":{"Path is not a file:":0,"Icon path is not a file:":1,"Path is not an exe file:":2,"Icon path is not an ico file:":3,"Html entry point":4,"Select the html entry point file (usually index.html)":5,"Destination folder":6,"Select destination folder. The process will replace the existing files.":7,"NWJS version":8,"Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.":9,"Application ID":10,"Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.":11,"Application description":12,"Set the application description for the game.":13,"Window title":14,"Set the default window title for the game.<br />This value may be overridden by the game engine.":15,"Window width":16,"Set the default window width for the game.":17,"Window height":18,"Set the default window height for the game.":19,"Full screen":20,"Set the game to start in full screen mode.":21,"Resizable":22,"Set the game window to be resizable.":23,"Game icon":24,"Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.":25,"Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.":26,"Start the application in full screen mode":27,"Allow the application to be resizable":28,"HTML Compiler":29,"Compile":30,"Source path can not empty":31,"Destination path can not empty":32},"tags":[],"relPath":"/addons/basicUtils/utils/HTMLPacker.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/basicUtils/utils/Updater.js":{"data":[["An update is being installed. Please do not close the application until the installation is completed.","Pembaruan sedang dipasang. Jangan tutup aplikasi hingga pemasangan selesai."],["Package Path","Jalur Paket"],["Select the package file.","Pilih file paket."],["Package Key","Kunci Paket"],["If you have the key, please enter it here. If not, leave it empty.","Jika Anda memiliki kuncinya, masukkan di sini. Jika tidak, biarkan kosong."],["Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.","Melalui formulir ini, Anda dapat memperbarui Translator++ dengan file paket pembaruan. Anda dapat mengunduh paket pembaruan <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>di sini</a>."],["Update from package","Perbarui dari paket"],["Update","Perbarui"],["Update Translator++","Perbarui Translator++"]],"context":[["tid/4918/type/StringLiteral"],["tid/6562/type/StringLiteral"],["tid/6572/type/StringLiteral"],["tid/6612/type/StringLiteral"],["tid/6622/type/StringLiteral"],["tid/6661/type/NoSubstitutionTemplate"],["tid/6753/type/StringLiteral","tid/7195/type/StringLiteral"],["tid/6770/type/StringLiteral","tid/7091/type/StringLiteral"],["tid/7120/type/StringLiteral"]],"basename":"Updater.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"Updater.js","path":"/addons/basicUtils/utils/Updater.js","indexIsBuilt":false,"indexIds":{"An update is being installed. Please do not close the application until the installation is completed.":0,"Package Path":1,"Select the package file.":2,"Package Key":3,"If you have the key, please enter it here. If not, leave it empty.":4,"Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.":5,"Update from package":6,"Update":7,"Update Translator++":8},"tags":[],"relPath":"/addons/basicUtils/utils/Updater.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/utils/info.js":{"data":[["You have ","Anda memiliki "],[" missed update(s)!"," pembaruan terlewat!"],["Translator++ will update itself if auto-update is enabled.","Translator++ akan memperbarui dirinya sendiri jika pembaruan otomatis diaktifkan."],["You can download the latest core version of Translator++ at","Anda dapat mengunduh versi inti terbaru Translator++ di"],["This update is available for all patrons.","Pembaruan ini tersedia untuk semua patron."],["This update is available for tier $","Pembaruan ini tersedia untuk tier $"],[" patrons or greater."," patron atau lebih tinggi."],["You're up-to-date!","Anda sudah mutakhir!"],["Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!","Terima kasih telah tetap mutakhir dengan Translator++! Anda menggunakan versi terbaru, dan kami menghargai dukungan Anda. Selamat menerjemahkan!"],["Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.","Beberapa informasi pembaruan mungkin ditampilkan dari cache. Anda dapat mengklik <b>'Periksa pembaruan'</b> untuk memuat detail versi terbaru."],["When the same version is available","Ketika versi yang sama tersedia"],["Allow Translator++ to reinstall the same version of Translator++.","Izinkan Translator++ untuk menginstal ulang versi Translator++ yang sama."],["Allow reinstall the same version","Izinkan instal ulang versi yang sama"],["Update Settings","Pengaturan Pembaruan"],["Update Now","Perbarui Sekarang"],["Updater is not available, please update Translator++ manually.","Pembaruan tidak tersedia, harap perbarui Translator++ secara manual."],["Updating Translator++","Memperbarui Translator++"],["Please don't close Translator++ until the update process is finished.","Jangan tutup Translator++ hingga proses pembaruan selesai."],["Can not update, reason :\n","Tidak dapat memperbarui, alasan :\n"],["You may need to reconnect Translator++ with your Patreon account (logout and login again).","Anda mungkin perlu menyambungkan ulang Translator++ dengan akun Patreon Anda (keluar dan masuk lagi)."],["Also, it has been reported that some countries such as mainland China are blocking dropbox repository.","Juga, dilaporkan bahwa beberapa negara seperti Tiongkok daratan memblokir repositori dropbox."],["If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:","Jika karena alasan tertentu Anda tidak dapat mengakses repositori kami, harap unduh paket pembaruan (file tpch) secara manual menggunakan proxy atau VPN di sini:"],["After that, please use the \"Update from package\" feature to update your Translator++.","Setelah itu, harap gunakan fitur \"Perbarui dari paket\" untuk memperbarui Translator++ Anda."],["If you still have problems, please contact us at our Discord server : ","Jika Anda masih mengalami masalah, harap hubungi kami di server Discord kami : "],["Restart","Mulai Ulang"],["Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.","Apakah Anda ingin memulai ulang Translator++ sekarang?\nJika Anda memiliki pekerjaan yang belum disimpan, batalkan dialog ini dan simpan pekerjaan Anda terlebih dahulu."],["Check for Update","Periksa Pembaruan"],["Close","Tutup"]],"context":[["tid/649/type/StringLiteral"],["tid/660/type/StringLiteral"],["tid/665/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/1033/type/StringLiteral"],["tid/1077/type/StringLiteral"],["tid/1088/type/StringLiteral"],["tid/1665/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1675/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1765/type/StringLiteral"],["tid/1811/type/StringLiteral"],["tid/1873/type/StringLiteral"],["tid/2021/type/StringLiteral"],["tid/2066/type/StringLiteral"],["tid/2116/type/StringLiteral"],["tid/2130/type/StringLiteral"],["tid/2176/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2220/type/StringLiteral"],["tid/2245/type/NoSubstitutionTemplate"],["tid/2259/type/StringLiteral"],["tid/2357/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2449/type/StringLiteral"],["tid/2512/type/StringLiteral"]],"basename":"info.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"info.js","path":"/addons/basicUtils/utils/info.js","indexIsBuilt":false,"indexIds":{"You have ":0," missed update(s)!":1,"Translator++ will update itself if auto-update is enabled.":2,"You can download the latest core version of Translator++ at":3,"This update is available for all patrons.":4,"This update is available for tier $":5," patrons or greater.":6,"You're up-to-date!":7,"Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!":8,"Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.":9,"When the same version is available":10,"Allow Translator++ to reinstall the same version of Translator++.":11,"Allow reinstall the same version":12,"Update Settings":13,"Update Now":14,"Updater is not available, please update Translator++ manually.":15,"Updating Translator++":16,"Please don't close Translator++ until the update process is finished.":17,"Can not update, reason :\n":18,"You may need to reconnect Translator++ with your Patreon account (logout and login again).":19,"Also, it has been reported that some countries such as mainland China are blocking dropbox repository.":20,"If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:":21,"After that, please use the \"Update from package\" feature to update your Translator++.":22,"If you still have problems, please contact us at our Discord server : ":23,"Restart":24,"Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.":25,"Check for Update":26,"Close":27},"tags":[],"relPath":"/addons/basicUtils/utils/info.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":28,"length":28,"percent":100},"parameters":[]},"/addons/basicUtils/utils/uiTags.js":{"data":[["Do not process row with selected tag (blacklist)","Jangan proses baris dengan tag yang dipilih (daftar hitam)"],["Only process row with selected tag (whitelist)","Hanya proses baris dengan tag yang dipilih (daftar putih)"],["Ignore tag","Abaikan tag"],["Load last selection","Muat pilihan terakhir"],["Reset","Atur ulang"],["Cancel","Batal"],["Confirm","Konfirmasi"]],"context":[["tid/55/type/StringLiteral"],["tid/60/type/StringLiteral"],["tid/65/type/StringLiteral"],["tid/410/type/StringLiteral"],["tid/415/type/StringLiteral"],["tid/2085/type/StringLiteral"],["tid/2137/type/StringLiteral"]],"basename":"uiTags.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"uiTags.js","path":"/addons/basicUtils/utils/uiTags.js","indexIsBuilt":false,"indexIds":{"Do not process row with selected tag (blacklist)":0,"Only process row with selected tag (whitelist)":1,"Ignore tag":2,"Load last selection":3,"Reset":4,"Cancel":5,"Confirm":6},"tags":[],"relPath":"/addons/basicUtils/utils/uiTags.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/customParser/CustomParserLoader.js":{"data":[["List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.","Daftar kemungkinan pengkodean karakter. <b>Urutan penting!</b>. Pisahkan setiap nilai dengan koma.<br />Translator++ akan membaca file asli dengan pengkodean berikut, memperbaiki file, dan menulis dengan opsi <b>Pengkodean Karakter Tulis</b>. Biarkan kosong untuk menggunakan pengkodean karakter asli saat proyek dibuat."],["For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>","Untuk dukungan BOM, tambahkan spasi setelah pengkodean. Contoh: <code>utf8 bom</code>"],["Example: utf8,utf8 bom,utf16le,ascii","Contoh: utf8,utf8 bom,utf16le,ascii"],["Select the target character encoding.","Pilih pengkodean karakter target."]],"context":[["tid/3375/type/NoSubstitutionTemplate"],["tid/3383/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/4740/type/StringLiteral"]],"basename":"CustomParserLoader.js","dirname":"/addons/customParser","extension":".js","filename":"CustomParserLoader.js","path":"/addons/customParser/CustomParserLoader.js","indexIsBuilt":false,"indexIds":{"List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.":0,"For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>":1,"Example: utf8,utf8 bom,utf16le,ascii":2,"Select the target character encoding.":3},"tags":[],"relPath":"/addons/customParser/CustomParserLoader.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.html":{"data":[["<i class=\"icon-edit\"></i>","<i class=\"icon-edit\"></i>"],["<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>","<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Tambahkan grup file baru</label>"],["Add a new file group","Tambahkan grup file baru"],["<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>","<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Hapus grup file saat ini</label>"],["Remove current file group","Hapus grup file saat ini"],["Rules","Aturan"],["Hooks","Kait"],["Options","Opsi"],["Testing","Pengujian"],["Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>","Interpolasi string sebelum ditampilkan di sel. <b>Ke Grid</b> adalah antitesis dari <b>Dari Grid</b>"],["Example","Contoh"],["For example, the text obtained from the parser is as follows:","Misalnya, teks yang diperoleh dari parser adalah sebagai berikut:"],["In this grid it will look like this:","Di grid ini akan terlihat seperti ini:"],["That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n","Itu bukan teks termudah untuk dikerjakan.<br>\n  Kita bisa memperbaikinya dengan mendeklarasikan <span class=\"inlineCode\">To Grid hooks</span> sebagai berikut:\n"],["With the hook above the text in the grid will be :","Dengan hook di atas, teks di grid akan menjadi:"],["Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.","Interpolasi string dari sel ke dalam hasil terjemahan. <b>Dari Grid</b> adalah antitesis dari <b>Ke Grid</b>."],["\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n","\n  Misalnya, string terjemahan yang diharapkan harus dalam format JSON.<br>\n  Namun menulis terjemahan dalam format JSON bukanlah hal yang paling mudah dilakukan. <br>\n  Jadi, alih-alih meminta penerjemah kami untuk menerjemahkan dalam format JSON, kita bisa meminta mereka mengetik secara normal, dan menambahkan <span class=\"inlineCode\">From Grid hook</span> sebagai berikut:\n"],["\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n","\n  Dengan <span class=\"inlineCode\">From Grid hook</span> di atas, terjemahan berikut ...\n"],["...will be converted into desired format: ","...akan dikonversi ke format yang diinginkan: "],["Edit the translated text just before writing it into a file.","Edit teks terjemahan tepat sebelum menulisnya ke file."],["Parameters","Parameter"],["\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ","\n              <h3 data-tran=\"\">teks</h3>\n              <p data-tran=\"\">Teks yang akan ditulis ke file.</p>\n            "],["text","teks"],["The text that is about to be written into a file.","Teks yang akan ditulis ke file."],["Return value","Nilai kembali"],["\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ","\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">Teks yang akan ditulis ke file.</p>\n            "],["The text that will be written into a file.","Teks yang akan ditulis ke file."],["General","Umum"],["Read character encoding","Baca pengkodean karakter"],["Force parser to use the following character encoding when reading the file(s).","Paksa parser untuk menggunakan pengkodean karakter berikut saat membaca berkas."],["Write character encoding","Tulis pengkodean karakter"],["Force parser to use the following character encoding when writing the file(s).","Paksa parser untuk menggunakan pengkodean karakter berikut saat menulis berkas."],["You are editing:","Anda sedang mengedit:"],["Please select the mode of your pattern","Silakan pilih mode pola Anda"],["Regular expression Pattern","Pola ekspresi reguler"],["A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.","Ekspresi reguler ECMA Script yang valid beserta modifikasinya.<br>Anda dapat menggunakan <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> untuk membuat dan menguji pola Anda."],["Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ","Perhatikan penggunaan carriage return (\\r) dalam teks yang akan diterjemahkan. regex101.com akan menghapus carriage return sehingga pola Anda mungkin memiliki efek berbeda dari yang Anda lihat di regex101."],["<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.","<strong>Tentang quantifier yang menangkap string dengan panjang nol.</strong><br>\n            <i>Null</i> string akan menyebabkan masalah bagi parser. Oleh karena itu, alih-alih menggunakan quantifier <strong>*</strong> yang juga akan menangkap <i>null</i>, sangat disarankan untuk menggunakan quantifier <strong>+</strong> yang hanya akan menangkap string jika ada."],["Translatable Capture groups","Grup tangkapan yang dapat diterjemahkan"],["Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.","Indeks grup ekspresi reguler (Integer) untuk teks yang dapat diterjemahkan. Bisa lebih dari satu. Pisahkan dengan koma."],["Row Info Capture group","Grup tangkapan info baris"],["\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ","\n            Indeks grup ekspresi reguler (Integer) untuk info baris (misalnya nama karakter). <b>Hanya satu grup</b> yang diizinkan. <br>\n            Nilai info baris dapat dibawa ke aturan turunan dan akan ditimpa oleh nilai info baris aturan turunan jika ada.\n          "],["Context template","Template konteks"],["\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ","\n            Konteks adalah pengidentifikasi unik untuk teks yang dapat diterjemahkan. <br>\n            Anda dapat menggunakan template literal Javascript untuk menambahkan informasi ke konteks.<br>\n            <b>Variabel yang tersedia:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Tangkapan grup.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - ID aturan.</li> -->\n            </ul>\n            <br>\n            <b>Contoh:</b>\n            <pre>item/${GROUP[2]}</pre>\n          "],["Action","Aksi"],["Capture value","Tangkap nilai"],["Capture then mask value","Tangkap lalu masker nilai"],["Mask value","Masker nilai"],["Send to inner rule","Kirim ke aturan dalam"],["Edit inner rule <i class=\"icon-angle-double-right\"></i>","Edit aturan dalam <i class=\"icon-angle-double-right\"></i>"],["What action the pattern is going to do.","Aksi apa yang akan dilakukan oleh pola."],["Javascript function","Fungsi Javascript"],["Guide","Panduan"],["\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ","\n          <h2 data-tran=\"\">Argumen</h2>\n          <p data-tran=\"\">Kode yang Anda tulis akan berada di dalam fungsi dengan 2 argumen yang dapat diakses di mana saja dalam kode Anda:</p>\n          <ul>\n            <li>\n              <h3>teks</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">Sebuah string dari seluruh konten file.</p>\n            </li>\n            <li>\n              <h3>modelIni</h3>\n              <p><b>Objek</b></p>\n              <p data-tran=\"\">Objek aturan yang saat ini digunakan oleh file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\">Kata Kunci <i>this</i></h2>\n          <p data-tran=\"\"><b>this</b> akan merujuk pada instance kelas CustomParser.</p>\n\n        "],["Arguments","Argumen"],["The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:","Kode yang Anda tulis akan berada di dalam fungsi dengan 2 argumen yang dapat diakses di mana saja dalam kode Anda:"],["A string of the entire content of the file.","Sebuah string dari seluruh konten file."],["The rule object that is currently used by the file.","Objek aturan yang saat ini digunakan oleh file."],["<i>this</i> Keyword","Kata Kunci <i>this</i>"],["<b>this</b> will reffer to the instance of CustomParser class.","<b>this</b> akan merujuk pada instance kelas CustomParser."],["\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ","\n          <h2 data-tran=\"\">Nilai Pengembalian yang Diharapkan</h2>\n          <p data-tran=\"\">Kode Anda harus <b>mengembalikan</b> salah satu nilai berikut:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset dari teks yang ditangkap, contoh:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Nama Karakter\", // Nama karakter. opsional\n    context: [\"beberapa\", \"konteks\", \"di sini\"] // Konteks. opsional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array dari offset teks yang ditangkap, contoh:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Nama Karakter\", context: [\"beberapa\", \"konteks\", \"di sini\"]},\n    {start:12, end:30, rowInfoText:\"Karakter Lain\", context: [\"lain\", \"konteks\"]},\n    {start:4581, end:4593, rowInfoText:\"Karakter Ketiga\", context: [\"ketiga\", \"konteks\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        "],["Expected Return Value","Nilai Pengembalian yang Diharapkan"],["Your code must <b>return</b> one of the following value:","Kode Anda harus <b>mengembalikan</b> salah satu nilai berikut:"],["Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ","Offset dari teks yang ditangkap, contoh:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Nama Karakter\", // Nama karakter. opsional\n    context: [\"beberapa\", \"konteks\", \"di sini\"] // Konteks. opsional\n  }\n</pre>\n            "],["Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ","Array dari offset teks yang ditangkap, contoh:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Nama Karakter\", context: [\"beberapa\", \"konteks\", \"di sini\"]},\n    {start:12, end:30, rowInfoText:\"Karakter Lain\", context: [\"lain\", \"konteks\"]},\n    {start:4581, end:4593, rowInfoText:\"Karakter Ketiga\", context: [\"ketiga\", \"konteks\"]}\n  ]\n</pre>              \n            "],["\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ","\n          <h2 data-tran=\"\">Contoh</h2>\n          <p data-tran=\"\">Kode berikut adalah contoh untuk mengurai subtitle srt.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ menggunakan regexp-match-indices\n  sehingga semua metode RegExp.exec() akan mengembalikan offset grup mereka\n  baca lebih lanjut tentang Indeks Ekspresi Reguler di sini: https://v8.dev/features/regexp-match-indices\n*/\n\nvar hasil \t\t\t= [];\nvar grupTangkap \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (cocok=regex.exec(teks))) {\n  console.log(cocok);\n  if (!cocok?.indices?.[grupTangkap]) continue;\n  hasil.push({\n    start\t: cocok.indices[grupTangkap][0],\n    end\t\t: cocok.indices[grupTangkap][1]\n  })\n}\nreturn hasil;             \n</code>\n</pre>\n        "],["The following code is an example to parse srt subtitle.","Kode berikut adalah contoh untuk mengurai subtitle srt."],["Welcome to the Custom Parser Model Creator","Selamat datang di Pembuat Model Parser Kustom"],["Please start by creating a new File Group.","Silakan mulai dengan membuat Grup File baru."],["Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ","Silakan tentukan jenis file yang ingin Anda parsing dengan mengklik tombol\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Tambah grup file baru</button>.\n    "],["Press F1 to open the help dialog.","Tekan F1 untuk membuka dialog bantuan."],["New File","File Baru"],["Open file","Buka file"],["Save file","Simpan file"],["Save As","Simpan Sebagai"],["Open debugger (F12)","Buka debugger (F12)"],["Help","Bantuan"],["Edit current file pattern","Edit pola file saat ini"],["Add a new file pattern","Tambahkan pola file baru"],["Remove current file pattern","Hapus pola file saat ini"],["Rule's order does matter, especially when you use masking! Drag to reorder.","Urutan aturan penting, terutama saat Anda menggunakan masking! Seret untuk mengatur ulang."]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText","idx/29/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/28/innerText","idx/69/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"],["idx/9/attr/title"]],"basename":"modelEditor.html","dirname":"/addons/customParser/modelEditor","extension":".html","filename":"modelEditor.html","path":"/addons/customParser/modelEditor/modelEditor.html","indexIsBuilt":false,"indexIds":{"<i class=\"icon-edit\"></i>":0,"<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>":1,"Add a new file group":2,"<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>":3,"Remove current file group":4,"Rules":5,"Hooks":6,"Options":7,"Testing":8,"Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>":9,"Example":10,"For example, the text obtained from the parser is as follows:":11,"In this grid it will look like this:":12,"That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n":13,"With the hook above the text in the grid will be :":14,"Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.":15,"\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n":16,"\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n":17,"...will be converted into desired format: ":18,"Edit the translated text just before writing it into a file.":19,"Parameters":20,"\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ":21,"text":22,"The text that is about to be written into a file.":23,"Return value":24,"\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ":25,"The text that will be written into a file.":26,"General":27,"Read character encoding":28,"Force parser to use the following character encoding when reading the file(s).":29,"Write character encoding":30,"Force parser to use the following character encoding when writing the file(s).":31,"You are editing:":32,"Please select the mode of your pattern":33,"Regular expression Pattern":34,"A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.":35,"Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ":36,"<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.":37,"Translatable Capture groups":38,"Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.":39,"Row Info Capture group":40,"\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ":41,"Context template":42,"\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ":43,"Action":44,"Capture value":45,"Capture then mask value":46,"Mask value":47,"Send to inner rule":48,"Edit inner rule <i class=\"icon-angle-double-right\"></i>":49,"What action the pattern is going to do.":50,"Javascript function":51,"Guide":52,"\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ":53,"Arguments":54,"The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:":55,"A string of the entire content of the file.":56,"The rule object that is currently used by the file.":57,"<i>this</i> Keyword":58,"<b>this</b> will reffer to the instance of CustomParser class.":59,"\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ":60,"Expected Return Value":61,"Your code must <b>return</b> one of the following value:":62,"Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ":63,"Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ":64,"\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ":65,"The following code is an example to parse srt subtitle.":66,"Welcome to the Custom Parser Model Creator":67,"Please start by creating a new File Group.":68,"Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ":69,"Press F1 to open the help dialog.":70,"New File":71,"Open file":72,"Save file":73,"Save As":74,"Open debugger (F12)":75,"Help":76,"Edit current file pattern":77,"Add a new file pattern":78,"Remove current file pattern":79,"Rule's order does matter, especially when you use masking! Drag to reorder.":80},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":81,"length":81,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.js":{"data":[["Do you want to close Model editor?\rAll unsaved changes will be discarded.","Apakah Anda ingin menutup Editor Model?\rSemua perubahan yang belum disimpan akan dibuang."],["Translate here using ","Terjemahkan di sini menggunakan "],["Do you want to discard your changes and open\n","Apakah Anda ingin membuang perubahan Anda dan membuka\n"],["Error when trying to open file :","Kesalahan saat mencoba membuka file:"],["Parser Model Creator","Pembuat Model Parser"],["Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json","Silakan tentukan jenis file yang ingin Anda parsing.\nAnda dapat menggunakan pola glob yang dipisahkan titik koma. Contoh: *.txt;*.js;*.json"],["Failed to create new file group. Please check your pattern!","Gagal membuat grup file baru. Harap periksa pola Anda!"],["Do you wish to remove current file group?\nYou can not undo this action!","Apakah Anda ingin menghapus grup file saat ini?\nTindakan ini tidak dapat dibatalkan!"],["Do you want to discard your changes and create a new blank model?","Apakah Anda ingin membuang perubahan Anda dan membuat model kosong baru?"],["Do you want to discard your changes and open a file?","Apakah Anda ingin membuang perubahan Anda dan membuka file?"],["Clear history","Hapus riwayat"],["Open latest file","Buka file terbaru"],["Open from history","Buka dari riwayat"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Developer dari Translator++. Anda dapat beralih ke versi Developer dengan menggunakan Basic Utilities -> Change Core NWJS."]],"context":[["tid/156/type/StringLiteral"],["tid/5647/type/StringLiteral"],["tid/9760/type/StringLiteral"],["tid/10037/type/StringLiteral"],["tid/10099/type/StringLiteral"],["tid/10622/type/StringLiteral","tid/10941/type/StringLiteral"],["tid/10665/type/StringLiteral","tid/10987/type/StringLiteral"],["tid/11026/type/StringLiteral"],["tid/11104/type/StringLiteral"],["tid/11174/type/StringLiteral","tid/12080/type/StringLiteral"],["tid/11459/type/StringLiteral"],["tid/11525/type/StringLiteral"],["tid/11607/type/StringLiteral"],["tid/11750/type/StringLiteral"]],"basename":"modelEditor.js","dirname":"/addons/customParser/modelEditor","extension":".js","filename":"modelEditor.js","path":"/addons/customParser/modelEditor/modelEditor.js","indexIsBuilt":false,"indexIds":{"Do you want to close Model editor?\rAll unsaved changes will be discarded.":0,"Translate here using ":1,"Do you want to discard your changes and open\n":2,"Error when trying to open file :":3,"Parser Model Creator":4,"Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json":5,"Failed to create new file group. Please check your pattern!":6,"Do you wish to remove current file group?\nYou can not undo this action!":7,"Do you want to discard your changes and create a new blank model?":8,"Do you want to discard your changes and open a file?":9,"Clear history":10,"Open latest file":11,"Open from history":12,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":13},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string","String bahasa tidak valid"],["Required field Project ID is blank!","Bidang wajib Project ID kosong!"],["Required field Service Account Key is blank!","Bidang wajib Service Account Key kosong!"],["Required field Server Location is blank!","Bidang wajib Server Location kosong!"],["Required field Location of the glossary file is blank!","Bidang wajib Lokasi file glosarium kosong!"],["Required field Glossary Languages is blank!","Bidang wajib Glossary Languages kosong!"],["Invalid glossary language value","Nilai bahasa glosarium tidak valid"],["Currently active glossary on this project: ","Glosarium aktif saat ini pada proyek ini: "],["Error when retreiving glossary info: ","Kesalahan saat mengambil info glosarium: "],["Error when removing glossary : ","Kesalahan saat menghapus glosarium: "],["Glossary removed successfully.","Glosarium berhasil dihapus."],["Error when creating glossary : ","Kesalahan saat membuat glosarium: "],["Glossary created successfully.","Glosarium berhasil dibuat."],["Configuration error:\r\n","Kesalahan konfigurasi:\r\n"],["No error found!","Tidak ditemukan kesalahan!"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js","Node JS diperlukan untuk menggunakan Google Cloud Translate Advanced. Silakan unduh dan instal dari https://node.js"]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?","Eksekutabel JCap tidak ditemukan di lokasi yang ditentukan. Apakah Anda ingin menginstal JCap?"],["JCap agent started successfully. Press ","Agen JCap berhasil dimulai. Tekan "],["jcapKey","jcapKey"],["Please set the JCap executable path in the addon settings.","Silakan atur jalur eksekutabel JCap di pengaturan addon."],["JCap executable already exists at the specified location.","Eksekutabel JCap sudah ada di lokasi yang ditentukan."],["JCap executable downloaded successfully.","Eksekutabel JCap berhasil diunduh."],["Failed to download JCap package. Please check the console for details.","Gagal mengunduh paket JCap. Silakan periksa konsol untuk detailnya."],["JCap executable unpacked successfully.","Eksekutabel JCap berhasil diekstrak."],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.","Anda sekarang dapat memulai agen JCap dari Menu Utama - Alat - Alat OCR JCap - Mulai Agen JCap."],["Start JCap OCR Agent","Mulai Agen OCR JCap"],["Failed to unpack JCap package. Please check the console for details.","Gagal mengekstrak paket JCap. Silakan periksa konsol untuk detailnya."],["JCap executable not found at the specified location.","Eksekutabel JCap tidak ditemukan di lokasi yang ditentukan."],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.","Apakah Anda yakin ingin menghapus instalasi JCap? Ini akan menghapus eksekutabel JCap dan konfigurasinya."],["JCap uninstalled successfully.","JCap berhasil dihapus instalasinya."],["Failed to uninstall JCap. Please check the console for details.","Gagal menghapus instalasi JCap. Silakan periksa konsol untuk detailnya."],["Help","Bantuan"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.","JCap OCR adalah alat OCR yang memungkinkan Anda menangkap teks dari layar dan menerjemahkannya menggunakan JCap. Untuk menggunakannya, mulai JCap dengan mengklik tombol OCR di menu utama.\nKemudian tekan tombol yang dikonfigurasi (default: F9) untuk menangkap teks."]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data","Perindah data JSON"],["When checked the generated data will be beautified.","Saat dicentang, data yang dihasilkan akan diperindah."],["Start a new translation project from any JSON file.","Mulai proyek terjemahan baru dari file JSON apa pun."],["Translator++ will translate any translatable texts found in the JSON files.","Translator++ akan menerjemahkan semua teks yang dapat diterjemahkan yang ditemukan dalam file JSON."],["Read the guide on how to start a new JSON translation project here","Baca panduan tentang cara memulai proyek terjemahan JSON baru di sini"],["Translator++ will scan through this folder for any JSON files.","Translator++ akan memindai folder ini untuk file JSON apa pun."],["How do you want to get the data from the JSON object?","Bagaimana Anda ingin mendapatkan data dari objek JSON?"],["Parser mode","Mode parser"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>","<h2>Mode Sederhana</h2><p>Dalam mode sederhana, Anda dapat menerjemahkan semua nilai string secara rekursif di dalam objek JSON.<br />Dalam mode sederhana, teks asli selalu berupa nilai.</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>","<h2>Mode Lanjutan</h2><p>Dalam mode lanjutan, Anda dapat mengkueri JSON dan menangani tabel terjemahan tipe pasangan kunci-nilai di mana teks asli adalah kuncinya.</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>","<h2>Info</h2><p>Anda dapat menggunakan bidang kueri berikut untuk memilih bagian tertentu dari objek JSON. Hasil kueri harus berupa objek atau array teks.</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>","<h3>Untuk objek</h3><p><b>Kunci akan digunakan sebagai teks asli</b> dan <b>nilai sebagai terjemahan default</b>.</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />","Parser akan otomatis mendaftar jika nilainya adalah string, null, atau undefined.<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>","<h3>Untuk array</h3><p>Parser akan mendaftar semua nilai string dalam array sebagai teks yang dapat diterjemahkan.</p>"],["Start project","Mulai proyek"],["`Invalid destination directory:\\n${","`Direktori tujuan tidak valid:\\n${"],["}`","}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label","label"],["is duplicated in the same scenario file","terduplikasi dalam file skenario yang sama"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory","Pilih direktori"],["Select a directory to repack","Pilih direktori untuk mengemas ulang"],["Target xp3","Target xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.","Pilih nama file. Nama file khusus seperti <b>patch.xp3</b>, <b>patch2.xp3</b>...dll mendapatkan prioritas atas data.xp3 saat dimuat."],["Patch to allow folder structure","Tambalan untuk mengizinkan struktur folder"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.","Secara default, mesin KAG tidak membaca file di dalam folder dalam file xp3. Opsi ini akan secara otomatis menambahkan definisi struktur folder ke Config.tjs. Tidak berpengaruh jika file Config.tjs tidak ditemukan."],["Repack into xp3","Kemas ulang ke xp3"],["Close","Tutup"],["Process","Proses"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.","<b>Urutan penting</b> jika Anda membongkar beberapa file sekaligus! File akan dibongkar secara berurutan. Jika file sudah ada, akan ditimpa."],["Unpack XP3 files","Bongkar file XP3"],["Repack a folder to xp3","Kemas ulang folder ke xp3"],["Unpack xp3 file","Bongkar file xp3"],["Before you create a new project, please make sure that :","Sebelum membuat proyek baru, pastikan bahwa:"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Semua file .ks & .tjs dalam teks biasa (tidak dikompilasi, tidak diacak, dan tidak dienkripsi)"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.","Game KAG harus dapat dimainkan bahkan tanpa dikemas ulang. Jadi, Anda harus memeriksa apakah game Anda dapat dimainkan atau tidak setelah diekstrak."],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Beberapa tindakan akan memodifikasi game Anda. <b>Jadi pastikan untuk membuat cadangan game Anda!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Pilih file eksekutif game. File ini adalah file utama game yang akan digunakan untuk mengekstrak data game."],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.","Translator++ dapat mengekstrak file XP3 dengan addon AEC. <b>Tapi ekstraktor bukan solusi pasti untuk semua jenis XP3</b>."],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.","Beberapa file skenario dienkripsi. Centang opsi ini jika Anda ingin Translator++ mencoba mendekripsinya."],["This may not work on some projects.","Ini mungkin tidak berfungsi pada beberapa proyek."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Daftar pengkodean karakter yang mungkin. <b>Urutan penting!</b> Anda dapat menyeret untuk mengurutkan daftar."],["Literal tags are the tags that will be escaped into Translator++ editor.","Tag literal adalah tag yang akan di-escape ke dalam editor Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> wajib."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Tag akan diinterpolasi oleh Translator++ ke baris baru. Jadi Anda tidak perlu menulis <b>[r]</b> secara eksplisit."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Skrip Kirikiri (.ks) sangat dapat disesuaikan dan memungkinkan pengembang membuat tag mereka sendiri."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ dapat menangani tag standar seperti nama karakter yang diawali dengan tanda pagar (#)."],["However, Translator++ cannot handle custom tags created by developers.","Namun, Translator++ tidak dapat menangani tag kustom yang dibuat oleh pengembang."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Oleh karena itu, Anda mungkin perlu mendefinisikan tag dan atribut yang perlu diterjemahkan dan yang perlu ditandai sebagai nama aktor."],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.","Anda mungkin perlu <input type=\"button\" value=\"ekstrak game xp3 Anda\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> dan menganalisis skrip ks di dalamnya sebelum memulai proyek."],["Create Project","Buat Proyek"],["Pack a folder into xp3","Kemas folder menjadi xp3"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.","Pilih pengkodean karakter target.<br />Kebanyakan game KAG Jepang ditulis dengan SHIFT-JIS, tetapi KAG sebenarnya mendukung unicode UTF16LE. Banyak penerjemah mengatur pengkodean karakter ke UTF16LE agar game dapat dimainkan di Windows non-Jepang tanpa emulator lokal. Dan yang terpenting, dapat menampilkan karakter di luar SHIFT-JIS seperti \"café\".<br />Secara default, Translator++ akan menulis ke pengkodean karakter aslinya."],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference.","Ada beberapa cara untuk menghasilkan game terlokalisasi yang dapat dimainkan untuk KAG. Silakan pilih yang sesuai dengan preferensi Anda."]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode","Pilih mode"],["Select how do you want to start your project. By selecting files or folders.","Pilih bagaimana Anda ingin memulai proyek Anda. Dengan memilih file atau folder."],["Select Folder","Pilih Folder"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","Pilih folder untuk diproses. Translator++ akan mengambil file PO secara rekursif dari folder yang ditentukan."],["Select File","Pilih File"],["Select the files you want to process.","Pilih file yang ingin Anda proses."],["Filters","Filter"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Filter nama file dengan pola glob. Default adalah <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Semua file .po di folder yang dipilih dan subfoldernya."],["All .mo files in the selected folder and its subfolders.","Semua file .mo di folder yang dipilih dan subfoldernya."],["PO Files","File PO"],["MO Files","File MO"],["You are about to export the translations as MO files.\n","Anda akan mengekspor terjemahan sebagai file MO.\n"],["- MO files are binary files that cannot be edited manually.\n","- File MO adalah file biner yang tidak dapat diedit secara manual.\n"],["- Only translated entries are stored in MO files.\n","- Hanya entri yang diterjemahkan yang disimpan dalam file MO.\n"],["Are you sure you want to proceed?","Apakah Anda yakin ingin melanjutkan?"],["PO / MO Files","File PO / MO"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.","File .po dan .mo adalah format file berbasis teks dan biner standar yang digunakan bersama untuk pelokalan perangkat lunak, terutama di WordPress, untuk menerjemahkan tema dan plugin. File PO (Portable Object) adalah teks yang dapat dibaca manusia yang berisi terjemahan, sedangkan file MO (Machine Object) adalah file biner yang dikompilasi dan dapat dibaca mesin yang digunakan oleh perangkat lunak untuk pemuatan yang lebih cepat."],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts","Mulai terjemahan dari skrip terjemahan PO (Portable Object) dan MO (Machine Object)"],["Create Project","Buat Proyek"],["Select mode","Pilih mode"],["Select how do you want to start your project. By selecting files or folders.","Pilih bagaimana Anda ingin memulai proyek Anda. Dengan memilih file atau folder."],["Select Folder","Pilih Folder"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","Pilih folder untuk diproses. Translator++ akan mengambil file PO secara rekursif dari folder yang ditentukan."],["Select File","Pilih File"],["Select the files you want to process.","Pilih file yang ingin Anda proses."],["Filters","Filter"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Filter nama file dengan pola glob. Default adalah <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Semua file .po di folder yang dipilih dan subfoldernya."],["All .mo files in the selected folder and its subfolders.","Semua file .mo di folder yang dipilih dan subfoldernya."],["ProjectTitle","JudulProyek"],["Your project title","Judul proyek Anda"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor","Ekstraktor Game Livemaker"],["Half width character patch","Patch karakter setengah lebar"],["Patch half-width character","Patch karakter setengah lebar"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings","Mesin Livemaker memiliki batasan terkait dukungan bahasa. Ini memerlukan pengaturan lokal sistem non-unicode Windows ke Jepang untuk menjalankan aplikasi LiveMaker dan LiveNovel. Selain itu, mesin ini dikodekan keras untuk hanya menggunakan font sistem Windows yang terinstal yang mendukung Windows Shift-JIS (MS CP932), yang berarti mungkin tidak mendukung lokal atau pengkodean lain"],["Next","Selanjutnya"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?","Tidak dapat mendeteksi tipe RPG Maker!\nApakah Anda yakin game ini adalah RPG Maker XP, VX, atau VX Ace?"],["Create a new project","Buat proyek baru"],["Invalid destination file:","File tujuan tidak valid:"],[" doesn't seems to be a LiveMaker game."," sepertinya bukan game LiveMaker."]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path.","Path dev tidak ditentukan.\nAnda harus menyuntikkan game Anda sekali untuk menghasilkan path dev."],["Decompile all rpyc files","Dekompilasi semua file rpyc"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.","Coba dekompilasi semua file rpyc menjadi .rpy.<br />Translator++ memiliki dekompilatornya sendiri. Namun dilaporkan bahwa terkadang gagal mendekompilasi beberapa game yang dibuat dengan Renpy 7. Anda dapat membiarkan bidang ini tidak dicentang dan mendekompilasi game sendiri dengan alat Anda sebelum memulai proyek."],["Overwrite rpy","Timpa rpy"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.","Jika dicentang, dekompilator <b>akan menimpa file rpy yang belum dikompilasi yang sudah ada</b>."],["Exclude command","Kecualikan perintah"],["This option will allow us to skip some command for being processed and translated","Opsi ini akan memungkinkan kita untuk melewati beberapa perintah agar tidak diproses dan diterjemahkan"],["Separate entries with a space","Pisahkan entri dengan spasi"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored","Misalnya, jika Anda memasukkan <b>old</b> maka semua baris di rpy yang dimulai dengan <b>old</b> akan diabaikan"],["Are you sure want to start a project without decompiling the rpyc files?","Apakah Anda yakin ingin memulai proyek tanpa mendekompilasi file rpyc?"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?","File yang Anda pilih bukan file eksekutif game Ren'Py.\nApakah Anda ingin melanjutkan?"],["Play last build","Mainkan build terakhir"],["Open Ren'Py documentation","Buka dokumentasi Ren'Py"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","Opsi telah diatur untuk menggunakan parser lama.\nAnda dapat beralih kembali ke parser baru kapan saja melalui menu opsi."]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator","Penerjemah file biner Windows"],["Parsing Windows binary file with","Mengurai file biner Windows dengan"],["Sellect supported files","Pilih file yang didukung"],["Select supported file type to translate.","Pilih jenis file yang didukung untuk diterjemahkan."],["Create a new project","Buat proyek baru"],["Please select a supported file to parse","Silakan pilih file yang didukung untuk diurai"],["Please enter your project title!","Silakan masukkan judul proyek Anda!"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player","Gunakan Pemain RPG Native"],["Use native RPG Player instead of Easy RPG Player","Gunakan Pemain RPG Native alih-alih Pemain RPG Mudah"],["Use native RPG Player","Gunakan Pemain RPG Native"],["Target folder","Folder target"],["Select destination folder.","Pilih folder tujuan."],["Install Easy RPG Player","Instal Easy RPG Player"],["Close","Tutup"],["Install","Instal"],["Process completed!","Proses selesai!"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin.","Parser RPG Maker 2000 & 2003 dengan plugin xmlTrans."],["Play last build","Mainkan build terakhir"],["Apply translation then play","Terapkan terjemahan lalu mainkan"],["Setup Easy RPG in the current directory","Atur Easy RPG di direktori saat ini"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine","Mulai terjemahan dari mesin RM2k / RM2k3"],["Create project","Buat proyek"],["Please select RPG Maker 2000/2003 game!","Silakan pilih game RPG Maker 2000/2003!"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?","Tidak dapat mendeteksi tipe RPG Maker!\nApakah Anda yakin game ini adalah RPG Maker 2000 / 2003?"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder","Folder target"],["Select destination folder.","Pilih folder tujuan."],["Install Easy RPG Player","Instal Easy RPG Player"],["Close","Tutup"],["Install","Instal"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/","Cara menambahkan font kustom.\n\nFont harus ditempatkan di folder Font di direktori game dan harus diberi nama Font.ttf atau Font2.ttf. Font file mana yang digunakan tergantung pada pengaturan font grafis sistem. Selain ttf, fon dan banyak font lainnya didukung (apa pun yang didukung oleh FreeType, pustaka sumber terbuka terbaik yang tersedia untuk rendering font).\n\nSumber: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!","Proses selesai!"],["Play last build","Mainkan build terakhir"],["Apply translation then play","Terapkan terjemahan lalu mainkan"],["Setup Easy RPG in the current directory","Siapkan Easy RPG di direktori saat ini"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data","Perindah data JSON"],["When checked the generated data will be beautified.","Ketika dicentang, data yang dihasilkan akan diperindah."],["Error loading system.json","Kesalahan memuat system.json"],["Loading","Memuat"],["index.html not found in","index.html tidak ditemukan di"],["Encrypted game","Game terenkripsi"],["Select the index.html of your encrypted game.","Pilih index.html dari game terenkripsi Anda."],["Target folder","Folder target"],["Select destination folder. The process will replace the existing files.","Pilih folder tujuan. Proses akan menggantikan file yang ada."],["Decrypt Resources","Dekripsi Sumber Daya"],["Close","Tutup"],["Process","Proses"],["Source path can not empty","Jalur sumber tidak boleh kosong"],["Destination path can not empty","Jalur tujuan tidak boleh kosong"],["Path is not a file:","Jalur bukan file:"],["Invalid directory:","Direktori tidak valid:"],["Extract enigma","Ekstrak enigma"],["Select enigma file.","Pilih file enigma."],["Extract Enigma","Ekstrak Enigma"],["Selected file is not an Enigma Virtual Box package.","File yang dipilih bukan paket Enigma Virtual Box."],["Plugins are already fetched for this project. Want to re-fetch the plugins?","Plugin sudah diambil untuk proyek ini. Ingin mengambil ulang plugin?"],["Translate Javascript File?","Terjemahkan File Javascript?"],["Cancel","Batal"],["I know the risk, Proceed!","Saya tahu risikonya, Lanjutkan!"],["Game Executable Path","Jalur Eksekusi Game"],["Path to the game executable file (.exe)","Jalur ke file eksekusi game (.exe)"],["NWJS Version","Versi NWJS"],["Change into this NWJS version","Ubah ke versi NWJS ini"],["Use Developer version","Gunakan versi Pengembang"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","Gunakan versi Pengembang NWJS. Versi Pengembang memiliki alat pengembang yang tersedia. Cocok untuk debugging dan pengembangan."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Dalam versi Pengembang, Anda dapat menggunakan <b>Konsol Pengembang</b>. Konsol Pengembang dapat diakses dengan menekan F12 atau klik kanan aplikasi dan pilih 'Periksa'."],["Use 32-bit version","Gunakan versi 32-bit"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","Gunakan versi 32-bit NWJS. Versi 32-bit berguna untuk kompatibilitas dengan sistem lama. Disarankan untuk tidak mencentang opsi ini jika memungkinkan (tingkatkan saja mesin Anda, bro)."],["Some game feature may not work across NWJS version","Beberapa fitur game mungkin tidak berfungsi di berbagai versi NWJS"],["Please be aware that some game feature may not work across NWJS version.","Harap perhatikan bahwa beberapa fitur game mungkin tidak berfungsi di berbagai versi NWJS."],["Change RPG Maker MV / RPG Maker MZ / NWJS version","Ubah versi RPG Maker MV / RPG Maker MZ / NWJS"],["This operation will change the NW.js version into","Operasi ini akan mengubah versi NW.js menjadi"],["Please close the application first before continuing.\nDo you want to continue?","Harap tutup aplikasi terlebih dahulu sebelum melanjutkan.\nApakah Anda ingin melanjutkan?"],["The selected file is not a valid NW.js application.","File yang dipilih bukan aplikasi NW.js yang valid."],["Could not find index.html in the game directory.","Tidak dapat menemukan index.html di direktori game."],["Debug menu script not found in addon directory.","Skrip menu debug tidak ditemukan di direktori addon."],["Debug menu script is already installed in index.html.","Skrip menu debug sudah terpasang di index.html."],["Debug options installed successfully!","Opsi debug berhasil dipasang!"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n","Game yang dipilih tidak berjalan dalam Mode Pengembang NW.js (SDK).\n\n"],["Developer Mode provides additional debugging features:\n","Mode Pengembang menyediakan fitur debug tambahan:\n"],["• Developer Console (F12)\n","• Konsol Pengembang (F12)\n"],["• Inspect Element (Right-click)\n","• Periksa Elemen (Klik kanan)\n"],["• Network Monitor\n","• Monitor Jaringan\n"],["• Performance Profiler\n\n","• Profiler Kinerja\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n","Apakah Anda ingin meningkatkan ke Mode Pengembang NW.js?\n"],["(Recommended for better debugging experience)","(Direkomendasikan untuk pengalaman debug yang lebih baik)"],["The game will be upgraded to NW.js SDK version","Game akan ditingkatkan ke versi SDK NW.js"],["This may take a few minutes. Please wait...","Ini mungkin memerlukan beberapa menit. Harap tunggu..."],["NW.js has been upgraded to Developer Mode successfully!","NW.js telah berhasil ditingkatkan ke Mode Pengembang!"],["Failed to upgrade to Developer Mode:\n","Gagal meningkatkan ke Mode Pengembang:\n"],["Error installing debug options: ","Kesalahan memasang opsi debug: "],["Install Debug Options","Pasang Opsi Debug"],["This will install a debug menu into your RPG Maker MV/MZ game.","Ini akan memasang menu debug ke dalam game RPG Maker MV/MZ Anda."],["Select the game executable file to install debug options.","Pilih file eksekutif permainan untuk menginstal opsi debug."],["Compile HTML to Executable","Kompilasi HTML ke Eksekutif"],["Change Existing NWJS Version","Ubah Versi NWJS yang Ada"],["Install debug options","Instal opsi debug"],["Find next","Cari berikutnya"],["Open folder","Buka folder"],["Open with external application","Buka dengan aplikasi eksternal"],["Raw JSON data. Right click to open menu.","Data JSON mentah. Klik kanan untuk membuka menu."],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)","Patch tersedia untuk data trans ini. Patch ini akan membuat data trans Anda kompatibel dengan versi Translator++ saat ini.\nApakah Anda ingin mem-patch data Trans Anda?\n(Beberapa fitur mungkin tidak berfungsi dengan baik jika Anda tidak mem-patch data trans Anda)"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.","Tidak dapat menemukan eksekutif untuk menginstal opsi debug. Pastikan permainan Anda dikemas untuk Windows dengan NW.js."],["Error while installing debug options: ","Kesalahan saat menginstal opsi debug: "],["Play last build","Mainkan build terakhir"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Path dev tidak didefinisikan.\nAnda harus menyuntikkan permainan Anda sekali untuk menghasilkan path dev."],["Open editor","Buka editor"],["Load Plugins Into Project","Muat Plugin ke Proyek"],["Compile Game","Kompilasi Permainan"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","Opsi telah diatur untuk menggunakan parser lama.\nAnda dapat beralih kembali ke parser baru kapan saja melalui menu opsi."],["Unable to find the file related to the data","Tidak dapat menemukan file terkait dengan data"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Untuk memperbaikinya, perbaiki bidang <b>Lokasi bahan mentah</b> di <a href=\"#\" class=\"openProjectProperties\">Properti proyek</a>"],["Maximum dialog line","Baris dialog maksimum"],["Maximum line in the dialog box. Default is 4.","Jumlah baris maksimum dalam kotak dialog. Default adalah 4."],["Add debug options","Tambahkan opsi debug"],["Add debug options into the game to help testing.","Tambahkan opsi debug ke dalam game untuk membantu pengujian."],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>","Aktifkan opsi ini untuk menambahkan alat debugging ke game. Fitur ini dapat membantu Anda menguji terjemahan Anda.<br/><b>⚠️ Catatan: Opsi ini hanya tersedia jika game Anda dikemas dengan NWJS untuk Windows.</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/type/StringLiteral","tid/21410/type/StringLiteral"],["tid/20865/type/StringLiteral","tid/21461/type/StringLiteral"],["tid/20925/type/StringLiteral"],["tid/20962/type/StringLiteral"],["tid/20992/type/StringLiteral"],["tid/21023/type/StringLiteral"],["tid/21215/type/StringLiteral"],["tid/21220/type/StringLiteral"],["tid/21309/type/StringLiteral"],["tid/21564/type/StringLiteral"],["tid/21678/type/StringLiteral"],["tid/22062/type/StringLiteral"],["tid/22163/type/StringLiteral"],["tid/22214/type/StringLiteral"],["tid/22424/type/StringLiteral","tid/24166/type/StringLiteral"],["tid/22434/type/StringLiteral","tid/24176/type/StringLiteral"],["tid/22468/type/StringLiteral"],["tid/22478/type/StringLiteral"],["tid/22512/type/StringLiteral","tid/22962/type/StringLiteral"],["tid/22522/type/StringLiteral"],["tid/22533/type/StringLiteral"],["tid/22560/type/StringLiteral","tid/22986/type/StringLiteral"],["tid/22570/type/StringLiteral"],["tid/22605/type/NoSubstitutionTemplate"],["tid/22610/type/NoSubstitutionTemplate"],["tid/23014/type/NoSubstitutionTemplate"],["tid/23119/type/NoSubstitutionTemplate"],["tid/23148/type/NoSubstitutionTemplate"],["tid/23298/type/StringLiteral"],["tid/23453/type/StringLiteral"],["tid/23555/type/StringLiteral"],["tid/23696/type/StringLiteral"],["tid/23770/type/StringLiteral"],["tid/23812/type/StringLiteral"],["tid/23820/type/StringLiteral"],["tid/23828/type/StringLiteral"],["tid/23836/type/StringLiteral"],["tid/23844/type/StringLiteral"],["tid/23852/type/StringLiteral"],["tid/23860/type/StringLiteral"],["tid/23868/type/StringLiteral"],["tid/23922/type/NoSubstitutionTemplate"],["tid/23931/type/NoSubstitutionTemplate"],["tid/23972/type/StringLiteral"],["tid/24005/type/StringLiteral"],["tid/24068/type/StringLiteral"],["tid/24217/type/NoSubstitutionTemplate","tid/24282/type/NoSubstitutionTemplate"],["tid/24222/type/NoSubstitutionTemplate"],["tid/24227/type/NoSubstitutionTemplate"],["tid/24482/type/StringLiteral"],["tid/24546/type/StringLiteral"],["tid/24598/type/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":82,"length":82,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Developer NWJS."]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js.","Fitur ini hanya tersedia jika Anda menggunakan versi developer NW.js."]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser","Gunakan parser lama"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.","Gunakan parser lama sebelum (Translator++ ver. 3.8.12). Parser lama tidak mendukung beberapa fitur yang baru ditambahkan."],["Use old parser","Gunakan parser lama"],["Event's thread concurrency","Konkurensi thread event"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.","<b>Peringatan! Fitur eksperimental!</b><br />Opsi ini menentukan jumlah maksimum thread pekerja yang dapat secara bersamaan mem-parsing data event di Map dan CommonEvents. <b>Atur ke 0 untuk menonaktifkan thread pekerja</b>. <br />Opsi ini berpotensi mempercepat proses parsing dalam game yang lebih besar. Namun, penting untuk dicatat bahwa dalam game yang lebih kecil, mengaktifkan opsi ini mungkin justru memperlambat proses parsing karena overhead eksekusi yang lebih tinggi dibandingkan waktu parsing untuk setiap data."],["The minimum number of command in an event that allowed in thread worker","Jumlah minimum perintah dalam event yang diizinkan dalam thread pekerja"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.","<b>Peringatan! Fitur eksperimental!</b><br />Thread pekerja menimbulkan overhead selama eksekusi, yang berarti memproses event kosong atau event dengan jumlah perintah rendah justru dapat menghambat proses keseluruhan. Opsi ini memungkinkan Anda menentukan jumlah minimum perintah yang harus dimiliki event untuk diparsing dalam thread pekerja. <br />Penting untuk dicatat bahwa bahkan event kosong mengandung satu perintah, dan lebih efisien memproses event seperti itu di thread utama daripada di thread pekerja. Oleh karena itu, disarankan untuk mengatur angka ini ke nilai <b>lebih besar dari 1</b>.<br />Atur ke 0 untuk menonaktifkan pemisahan tugas berdasarkan perintah."],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.","Perhatikan bahwa event kosong sebenarnya mengandung satu perintah, dan Anda pasti ingin memproses event kosong di thread utama daripada di thread pekerja. Anda harus mengatur angka ini ke nilai lebih besar dari 1."],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3","RPG Maker XP, VX, Ace, MV & MZ Parser V.3"],["Start translation from RPG Maker game using the latest parser.","Mulai terjemahan dari game RPG Maker menggunakan parser terbaru."],["Error!\r\nTranslator++ is unable to detect the type of ","Kesalahan!\r\nTranslator++ tidak dapat mendeteksi jenis "],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.","Anda harus mengubah jalur!\r\nDirektori Dev tidak boleh berada di dalam direktori game asli, karena ini akan menyebabkan masalah jika Anda menyuntikkan game nanti."],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","Game dikemas dengan Enigma.\r\nApakah Anda ingin mengekstrak paket?\r\nIni akan memakan waktu beberapa menit, tergantung pada ukuran game Anda."],["Unable to extract the Enigma package!","Tidak dapat mengekstrak paket Enigma!"],["Copy & extract data into ","Salin & ekstrak data ke dalam"]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?","RPGMakertrans CLI Gateway diperlukan untuk menjalankan tindakan ini.\nRPGMakertrans CLI Gateway dilisensikan di bawah GPL-3 dan tidak dapat didistribusikan bersama program.\nNamun, Translator++ dapat mengaturnya atas nama Anda.\n\nApakah Anda ingin Translator++ menginstal RPGMakertrans CLI Gateway untuk Anda?"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?","RPGMakertrans CLI Gateway perlu diperbarui.\nApakah Anda ingin Translator++ memperbarui RPGMakertrans CLI Gateway untuk Anda?"],["Maximum dialog line","Baris dialog maksimum"],["Maximum line in the dialog box. Default is 4.","Baris maksimum dalam kotak dialog. Default adalah 4."]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine.","Mulai proyek terjemahan dari SRPG Studio Engine."],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..","Parser dapat menangani terjemahan dari <b>data.dts</b> (file srpgs); file <b>localization.dat</b> dan file lokal (.json, .txt, .js) yang dihasilkan oleh alat lokal SRPG Studio yang diperkenalkan dalam versi 1.253."],["Create project","Buat proyek"],["Error: customField is not defined. This should not happen!","Kesalahan: customField tidak terdefinisi. Ini seharusnya tidak terjadi!"],["Please select the entry point to translate.","Silakan pilih titik masuk untuk diterjemahkan."],["There are currently two known locations of translatable text within the SRPG Studio game. <br />","Saat ini ada dua lokasi teks yang dapat diterjemahkan dalam game SRPG Studio yang diketahui. <br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.","Pertama adalah yang tertulis langsung di dalam file .srpgs, dan kedua adalah di file localization.dat. Parser ini saat ini dapat menangani keduanya."],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.","<br />Selain itu, Anda juga dapat menerjemahkan file lokal yang dihasilkan oleh alat lokal SRPG Studio. File ini dalam format JSON, TXT, dan JS."]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.","Parse arsip SRPG Studio dan dump terjemahan JSON yang dihasilkan oleh SRPG_Unpacker.exe."],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.","Mulai terjemahan dari data.dts SRPG Studio, project.dat, atau dump terjemahan JSON.<br />Ini adalah parser terbaru—jauh lebih cepat dan stabil—yang akan menggantikan versi sebelumnya."],["Create Project","Buat Proyek"],["Source mode","Mode sumber"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.","Pilih mode EXE untuk memulai dari executable game, mode arsip untuk data.dts / project.dat, atau mode dump untuk dump terjemahan JSON."],["Select executable","Pilih executable"],["Select the game executable. Translator++ will look for data.dts in the same folder.","Pilih executable game. Translator++ akan mencari data.dts di folder yang sama."],["Select archive file","Pilih file arsip"],["Select data.dts directly.","Pilih data.dts secara langsung."],["Select dump folder","Pilih folder dump"],["Select the translation dump folder generated by SRPG_Unpacker.exe.","Pilih folder dump terjemahan yang dihasilkan oleh SRPG_Unpacker.exe."],["Filters","Filter"],["Glob pattern used to select JSON files from the dump folder.","Pola glob yang digunakan untuk memilih file JSON dari folder dump."],["ProjectTitle","Judul Proyek"],["Your project title","Judul proyek Anda"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>","Lokasi Sugoi translator <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Arahkan ke file .bat atau .exe di direktori root aplikasi.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Jalur tidak valid.<br>Beberapa fitur akan dinonaktifkan hingga ini diperbaiki."],["Server Type :","Tipe Server :"],["Installed Model :","Model Terpasang :"],["Install Sugoi Translator","Instal Sugoi Translator"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ","Tidak punya Sugoi Translator?\n            Instal server Sugoi Translator yang dikustomisasi &amp; dioptimalkan sekarang!\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>","Jumlah server untuk dijalankan (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Jumlah server yang dijalankan secara bersamaan\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%","Jumlah server yang akan dijalankan secara bersamaan.<br>Lebih banyak proses tidak selalu berarti lebih cepat, perhatikan kapasitas RAM &amp; CPU Anda.<br>Anda mungkin tidak akan mendapat manfaat jika dengan menjalankan hanya satu server penggunaan CPU telah mencapai 100%"],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ","\n                    Sugoi Translator Anda tidak mendukung pemrosesan GPU.<br>\n                    Anda perlu menambal server Anda untuk mendukung pemrosesan GPU.<br>\n                    <h3 data-tran=\"\">Pilih opsi berikut untuk menginstal tambalan yang sesuai untuk sistem Anda</h3>\n                    <div>\n                        <span data-tran=\"\">GPU Anda adalah:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Instal tambalan Untuk NVIDIA seri 30xx atau lebih tinggi</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Instal tambalan Untuk NVIDIA seri 20xx atau lebih rendah</button>\n    \n                    </div>\n                "],["Select the following option to install the suitable patch for your system","Pilih opsi berikut untuk menginstal tambalan yang sesuai untuk sistem Anda"],["Your GPU is:","GPU Anda adalah:"],["Install patch For NVIDIA series 30xx or greater","Instal tambalan Untuk NVIDIA seri 30xx atau lebih tinggi"],["Install patch For NVIDIA series 20xx or lower","Pasang patch Untuk seri NVIDIA 20xx atau lebih rendah"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>","Jumlah server untuk memulai (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Jumlah server yang dimulai secara bersamaan menggunakan GPU. Server Anda harus dipatch untuk mengaktifkan pemrosesan GPU.\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.","Berapa banyak server yang ingin Anda mulai di <b>GPU</b> Anda. Dimungkinkan untuk menjalankan layanan berbasis CPU dan GPU secara bersamaan. Namun harap diingat bahwa jika penggunaan CPU tinggi, hal ini dapat menghambat kinerja GPU.<br>Server Anda harus dipatch untuk mengaktifkan mode ini."],["Starting port number","Nomor port awal"],["The port numbers will be generated incrementaly starting from the value below","Nomor port akan dihasilkan secara bertahap mulai dari nilai di bawah"],["Keep console window open","Jaga jendela konsol terbuka"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.","mencegah jendela konsol tertutup saat server menutup. Opsi ini berguna untuk memeriksa kesalahan yang menyebabkan server crash."],["Action","Aksi"],["Set Sugoi Trans config based on this setting","Atur konfigurasi Sugoi Trans berdasarkan pengaturan ini"],["Start All Server","Mulai Semua Server"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":22,"length":22,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder","Pilih folder instalasi"],["Where do you want to install the CT2 Sugoi Translator into?","Di mana Anda ingin menginstal CT2 Sugoi Translator?"],["Cancel","Batal"],["Install now!","Instal sekarang!"],["Path to the directory can not be empty!","Path ke direktori tidak boleh kosong!"],["Invalid directory:","Direktori tidak valid:"],["Failed to download file. Repository do not exist. Please see the console log for more information.","Gagal mengunduh file. Repositori tidak ada. Silakan lihat log konsol untuk informasi lebih lanjut."],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series","Apakah Anda yakin ingin memperbarui server Anda?\nSkrip pembaruan ini akan bekerja untuk seri NVIDIA 3XXX"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier","Apakah Anda yakin ingin memperbarui server Anda?\nSkrip pembaruan ini akan bekerja untuk seri NVIDIA 2XXX dan sebelumnya"],["Install CT2 Sugoi Translator","Instal CT2 Sugoi Translator"],["Installation completed\nDo you want to set the Server Manager with this installed server?","Instalasi selesai\nApakah Anda ingin mengatur Server Manager dengan server yang terpasang ini?"],["Sugoi Translator Installed","Sugoi Translator Terpasang"],["Server started\nPlease wait until the server(s) are ready before you translate things.","Server dimulai\nHarap tunggu hingga server(s) siap sebelum Anda menerjemahkan sesuatu."],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?","Tindakan ini akan menimpa nilai saat ini dari pengaturan Addon Sugoi Trans.\nApakah Anda yakin?"],["Do you want to reset the current configuration?","Apakah Anda ingin mengatur ulang konfigurasi saat ini?"],["Configuration refreshed!","Konfigurasi disegarkan!"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter","Pemisah baris"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.","Isi dengan karakter atau frasa yang akan dihindari oleh penerjemah (frasa asli dan terjemahan akan selalu sama). Ini akan menjamin bahwa jumlah baris teks terjemahan sama dengan jumlah baris teks asli.\nSaat ini tidak ada frasa/karakter yang Sugoi akan hindari dengan tingkat keberhasilan 100%.\nAnda dapat mencoba menggunakan &#x3C;br&#x3E; dengan tingkat keberhasilan yang cukup baik.\nBiarkan kosong jika Anda ingin menggabungkan baris menjadi satu baris tunggal."],["Target URL(s)","URL target"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.","URL target penerjemah. Anda dapat memasukkan satu atau lebih URL back-end Sugoi Translator. Translator++ akan menyeimbangkan beban permintaan di semua instance layanan. Pisahkan setiap entri dengan baris baru."],["Max Parallel job","Pekerjaan paralel maksimum"],["Maximum parallel job that run simultaneously.","Pekerjaan paralel maksimum yang berjalan secara bersamaan."],["Send requests in batch","Kirim permintaan dalam batch"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.","Kirim beberapa teks (sesuai Pekerjaan paralel maksimum) dalam array.\nLebih cepat dan dapat mengurangi overhead eksekusi secara signifikan. Anda harus menjalankan server dari server manager untuk mengaktifkan opsi ini."],["Check First Line in Common Reference","Periksa Baris Pertama di Referensi Umum"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.","Jangan sertakan baris pertama dalam payload jika baris pertama ditemukan di Referensi Umum.\nIni sangat berguna jika nama karakter ada di baris pertama."],["Check Last Line in Common Reference","Periksa Baris Terakhir di Referensi Umum"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.","Jangan sertakan baris terakhir dalam payload jika baris terakhir ditemukan di Referensi Umum.\nIni sangat berguna jika nama karakter ada di baris terakhir."],["Automatic splitting","Pemecahan otomatis"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.","Secara otomatis membagi terjemahan menjadi jumlah baris yang sesuai dengan aslinya. Panjang setiap baris akan berukuran serupa."],["Code Escaping Algorithm","Algoritme Pelolosan Kode"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)","Algoritme pelolosan untuk kode sebaris di dalam dialog (belum diimplementasikan, harap tunggu pembaruan mendatang)"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya penerjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat memasukkan informasi lebih lanjut seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["System Message Template","Templat Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nama lengkap bahasa sumber</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nama lengkap bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan pra-tentukan algoritme pelolosan.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (Pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Tambahkan informasi para aktor.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["Body Message Template","Templat Pesan Tubuh"],["Template of the body of your chat.","Templat untuk badan percakapan Anda."],["Sample conversation","Contoh percakapan"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch ChatGPT memungkinkan Anda menerjemahkan proyek secara asinkron dengan biaya 50% lebih rendah, artinya Anda akan menerima hasil terjemahan <b style=\"color:red\">dalam 24 jam</b> dengan <b style=\"color:red\">setengah biaya normal</b>. Ini sangat berguna untuk proyek besar yang tidak memerlukan hasil terjemahan segera."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Baca lebih lanjut tentang API Batch ChatGPT: https://platform.openai.com/docs/guides/batch ."],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>","<p>Anda dapat menggunakan atau tidak menggunakan glosarium. Glosarium akan dimuat untuk setiap item batch untuk meningkatkan kualitas terjemahan.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt Template","Templat Prompt"],["<h2>1. System Message</h2>","<h2>1. Pesan Sistem</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Di sini Anda dapat menjelaskan kepada asisten, apa peran mereka.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Prompt aktual Anda</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Ini adalah perintah sebenarnya kepada asisten.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Biaya overhead</h3>\n                        Biaya overhead adalah biaya pesan perintah yang Anda kirim ke asisten tanpa teks terjemahan sebenarnya. Biaya dihitung berdasarkan jumlah token dalam pesan perintah. Semakin banyak token yang Anda miliki, semakin tinggi biayanya.<br>\n                        <b>Biaya overhead saat ini:</b> <span class=\"overheadCost\">0</span> token / permintaan."]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":40,"length":40,"percent":100},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?","Server TinyRPA tidak terpasang. Apakah Anda ingin memasangnya sekarang?"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization","Hafalan terjemahan organik otomatis"],["If checked, all organic translation (manually inputted translation) will be memorized automatically.","Jika dicentang, semua terjemahan organik (terjemahan yang dimasukkan secara manual) akan dihafal secara otomatis."],["Memorize translation by automation script","Hafal terjemahan dengan skrip otomasi"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.","Jika dicentang, Translator++ akan mengingat terjemahan yang dibuat dari skrip otomasi. \nSemua perubahan melalui 'this.cells' akan dihafal. Namun, kami dapat memodifikasi isi grid secara langsung menggunakan API trans, perubahan seperti itu tidak akan memicu penghafalan otomatis."],["Remind translation on cell translate","Ingatkan terjemahan pada sel terjemah"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.","Jika dicentang, Translator++ akan memuat terjemahan dari memori terjemahan terlebih dahulu sebelum melakukan terjemahan otomatis pada sel yang dipilih."],["Default memorization behavior","Perilaku hafalan default"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.","Timpa catatan sebelumnya saat melakukan terjemahan organik. Jika tidak dicentang, TM tidak akan menghafal terjemahan baru untuk catatan yang ada."],["MySQL host","Host MySQL"],["The host name or IP address of your MySQL server","Nama host atau alamat IP server MySQL Anda"],["MySQL port","Port MySQL"],["MySQL Port. Default is 3306.","Port MySQL. Default adalah 3306."],["MySQL user name","Nama pengguna MySQL"],["Username to access the DB.","Nama pengguna untuk mengakses DB."],["MySQL password","Kata sandi MySQL"],["Password to access the DB.","Kata sandi untuk mengakses DB."],["Database Name","Nama Database"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.","Nama basis data. Translator++ akan mencoba membuat basis data jika tidak ada. Namun keberhasilannya bergantung pada hak akses kredensial yang diberikan."],["Database Type","Tipe Basis Data"],["Automatically memorize manually inputted translations?","Hafalkan secara otomatis terjemahan yang dimasukkan manual?"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Maaf, addon ini hanya tersedia untuk patron aktif saja.\nAnda dapat membuka fitur ini dengan menjadi patron $1."],["Automatically memorize translation made by automation scripts?","Hafalkan secara otomatis terjemahan yang dibuat oleh skrip otomatisasi?"],["Remind translations when performing translate selection?","Ingatkan terjemahan saat melakukan pemilihan terjemahan?"],["Use rememorize in organic translation","Gunakan penghafalan ulang dalam terjemahan organik"],["default","bawaan"],["Indexed DB (experimental)","Basis Data Terindeks (eksperimental)"],["MySQL","MySQL"],["Database Setting","Pengaturan Basis Data"],["IndexedDB","IndexedDB"],["Generate","Hasilkan"],["Escaping algorithm for inline code inside dialogues","Algoritma pelolosan untuk kode sebaris di dalam dialog"],["Test connection","Uji koneksi"],["Connection success!","Koneksi berhasil!"],["MySql","MySql"],["Connection failed!\nError:","Koneksi gagal!\nKesalahan:"],["Install MySQL Server","Instal Server MySQL"],["How to setup MySQL Server","Cara menyiapkan Server MySQL"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?","Beberapa terjemahan untuk satu kalimat kunci terdeteksi.\nHanya terjemahan terakhir yang ditemukan akan diingat oleh Memori Terjemahan.\nApakah Anda ingin melanjutkan?"],["Your database structure need to be updated.","Struktur basis data Anda perlu diperbarui."],["Upgrade database","Tingkatkan basis data"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?","Tindakan ini akan meningkatkan basis data Anda.\nApakah Anda ingin meningkatkan basis data memori terjemahan Anda?"],["The translation memory database has been upgraded!\nPlease restart Translator++!","Basis data memori terjemahan telah ditingkatkan!\nHarap mulai ulang Translator++!"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":42,"length":42,"percent":100},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory","Memori"],["Fix the problem!","Perbaiki masalahnya!"],["No exact matches found!","Tidak ditemukan kecocokan yang tepat!"],["Original","Asli"],["Translation","Terjemahan"],["Do you want Translator++ to forget the selected cell(s)?","Apakah Anda ingin Translator++ melupakan sel yang dipilih?"],["Auto recall","Ingat otomatis"],["Auto memorize organic translation","Ingat otomatis terjemahan organik"],["Auto memorize automation","Ingat otomatis otomatisasi"],["Use rememorize in organic translation","Gunakan ingat ulang dalam terjemahan organik"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["tid/2391/type/StringLiteral"],["tid/2543/type/StringLiteral"],["tid/2686/type/StringLiteral"],["tid/2838/type/StringLiteral"]],"basename":"tmUI.js","dirname":"/addons/tm","extension":".js","filename":"tmUI.js","path":"/addons/tm/tmUI.js","indexIsBuilt":false,"indexIds":{"Memory":0,"Fix the problem!":1,"No exact matches found!":2,"Original":3,"Translation":4,"Do you want Translator++ to forget the selected cell(s)?":5,"Auto recall":6,"Auto memorize organic translation":7,"Auto memorize automation":8,"Use rememorize in organic translation":9},"tags":[],"relPath":"/addons/tm/tmUI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/tpp-localizationTool/fetchtrans.js":{"data":[["Preparing download file...","Mempersiapkan file unduhan..."],["Translation template downloaded successfully!","Template terjemahan berhasil diunduh!"],["Building translation data...","Membangun data terjemahan..."],["Processing: ","Memproses: "],["Fetching directory content...","Mengambil konten direktori..."],["Parsing: ","Penguraian:"]],"context":[["tid/2001/type/StringLiteral"],["tid/2228/type/StringLiteral"],["tid/2286/type/StringLiteral"],["tid/2439/type/StringLiteral"],["tid/2623/type/StringLiteral"],["tid/2825/type/StringLiteral"]],"basename":"fetchtrans.js","dirname":"/addons/tpp-localizationTool","extension":".js","filename":"fetchtrans.js","path":"/addons/tpp-localizationTool/fetchtrans.js","indexIsBuilt":false,"indexIds":{"Preparing download file...":0,"Translation template downloaded successfully!":1,"Building translation data...":2,"Processing: ":3,"Fetching directory content...":4,"Parsing: ":5},"tags":[],"relPath":"/addons/tpp-localizationTool/fetchtrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","model"],["|","|"],["promptLibrary","promptLibrary"],["search","cari"],["downloadChat","unduhChat"],["newChat","chatBaru"],["api","api"],["customEndpoint","customEndp