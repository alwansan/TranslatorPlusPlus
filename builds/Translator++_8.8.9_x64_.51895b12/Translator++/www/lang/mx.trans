model"],["|","|"],["promptLibrary","perpustakaanPetunjuk"],["search","cari"],["downloadChat","unduhObrolan"],["newChat","obrolanBaru"],["api","api"],["customEndpoint","titikAkhirKustom"],["apiEndpoint.inputLabel","labelInputTitikAkhirApi"],["apiKey.inputLabel","apiKey.labelInput"],["apiVersion.inputLabel","apiVersion.labelInput"],["apiVersion.description","apiVersion.deskripsi"],["securityMessage","pesanKeamanan"],["apiEndpoint.description","apiEndpoint.deskripsi"],["apiEndpoint.warn","apiEndpoint.peringatan"],["partialImportMessages","pesanImporParsial"],["import","impor"],["name","nama"],["prompt","prompt"],["clearPrompts","hapusPrompts"],["morePrompts","lebihBanyakPrompts"],["toast.sync","toast.sinkron"],["toast.stop","toast.berhenti"],["button.sync","tombol.sinkron"],["button.stop","tombol.berhenti"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Terjemahkan dengan ChatGPT Batch API"],["Model","Model"],["The pre-trained model.","Model yang telah dilatih sebelumnya."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Tampaknya OpenAI Batch API menggunakan konvensi penamaan model yang sedikit berbeda dari API umum. Model yang digunakan dalam Batch API memiliki awalan \"-batch\". Misalnya, jika Anda menggunakan <code>gpt-4.1-mini</code>, model otomatis menjadi <code>gpt-4.1-mini-batch</code>.<br />\nNamun, hingga saat add-on ini dibuat, model batch tidak tercantum dalam batas penggunaan model OpenAI, sehingga pengguna tidak dapat menggunakan Batch API jika mereka telah menyetel filter Penggunaan Model ke \"Izinkan\" (daftar putih).<br />\nIni kemungkinan bug di UI OpenAI yang mungkin diperbaiki di masa depan.<br />\nJadi, pastikan untuk menyetel batas penggunaan di OpenAI ke mode \"Blokir\" (daftar hitam) agar dapat menggunakan Batch API.<br />\nKlik di sini untuk mengubah batas penggunaan model: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Kolom Sumber"],["The column of the original texts you want to translate.","Kolom dari teks asli yang ingin Anda terjemahkan."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Ignore if already translated","Abaikan jika sudah diterjemahkan"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Jika opsi ini dicentang, Translator++ akan mengabaikan baris apa pun yang sudah memiliki terjemahan di kolomnya."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom dari terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan lebih banyak informasi seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["System Message Template","Templat Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama dari setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nama lengkap bahasa sumber</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nama lengkap bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan yang telah ditentukan dari algoritma pelolosan.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Tambahkan informasi tentang para aktor.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Sertakan beberapa baris sebelumnya sebagai konteks</li>"],["Body Message Template","Template Pesan Badan"],["Template of the body of your chat.","Template untuk badan percakapan Anda."],["Sample conversation","Contoh percakapan"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch ChatGPT memungkinkan Anda menerjemahkan proyek Anda secara asinkron dengan biaya 50% lebih rendah, artinya Anda akan menerima hasil terjemahan <b style=\"color:red\">dalam 24 jam</b> dengan <b style=\"color:red\">setengah biaya normal</b>. Ini sangat berguna untuk proyek besar yang tidak memerlukan hasil terjemahan segera."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Baca lebih lanjut tentang API Batch ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Pengaturan Umum"],["This form is using your existing ChatGPT configuration.<br>","Formulir ini menggunakan konfigurasi ChatGPT yang sudah ada.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Anda dapat mengubah konfigurasi dengan pergi ke pengaturan Penerjemah ChatGPT di jendela opsi.<br>"],["There you can set the API key, model, and other settings.<br />","Di sana Anda dapat mengatur kunci API, model, dan pengaturan lainnya.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Buka pengaturan ChatGPT\" />"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Ignore translated rows","Abaikan baris yang sudah diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap kumpulan item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari membengkaknya prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt Template","Template Prompt"],["<h2>1. System Message</h2>","<h2>1. Pesan Sistem</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Di sini Anda dapat menjelaskan kepada asisten, apa peran mereka.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Prompt aktual Anda</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Ini adalah prompt aktual ke asisten.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Biaya overhead</h3>\n                        Biaya overhead adalah biaya dari pesan prompt yang Anda kirim ke asisten tanpa teks terjemahan aktual. Biaya dihitung berdasarkan jumlah token dalam pesan prompt. Semakin banyak token yang Anda miliki, semakin tinggi biayanya.<br>\n                        <b>Biaya overhead saat ini:</b> <span class=\"overheadCost\">0</span> token / permintaan."],["Are you sure you want to reset the form?","Apakah Anda yakin ingin mereset formulir?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Apakah Anda yakin ingin memproses kumpulan?\nBiaya akan dikenakan untuk operasi ini."],["The batch is successfully created. Do you want to open the batch manager?","Kumpulan berhasil dibuat. Apakah Anda ingin membuka pengelola kumpulan?"],["OpenAI Batch API Queue","Antrean API Batch OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transGeminiAi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>JUDUL : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>MESIN : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transGeminiAi/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Silakan pilih baris untuk menerapkan terjemahan"],["Target Column","Kolom Target"],["The column to put the translation result.","Kolom untuk menempatkan hasil terjemahan."],["Import translation from ChatGPT Batch","Impor terjemahan dari Batch ChatGPT"],["Translation applied to selected rows","Terjemahan diterapkan pada baris yang dipilih"],["Invalid format","Format tidak valid"],["OK","OK"],["Mismatch","Tidak Cocok"],["Failed to load batch list with error: \n","Gagal memuat daftar batch dengan kesalahan: \n"],["Download Error File","Unduh File Kesalahan"],["Batch is not completed yet","Batch belum selesai"],["Are you sure you want to cancel this batch?","Apakah Anda yakin ingin membatalkan batch ini?"],["Cannot cancel completed batch.","Tidak dapat membatalkan batch yang sudah selesai."],["Batch cancelled","Batch dibatalkan"],["Failed to cancel batch","Gagal membatalkan batch"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","Batch"],["Apply translation","Terapkan terjemahan"],["Cancel batch","Batalkan batch"],["Status","Status"],["Batch ID","ID Batch"],["Input File ID","ID File Input"],["End point","Titik akhir"],["Created at","Dibuat pada"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Kadaluarsa pada <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batch yang tidak selesai tepat waktu akhirnya berpindah ke status kadaluarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons untuk permintaan yang selesai tersedia melalui file output batch. Anda akan dikenakan biaya untuk token yang dikonsumsi dari permintaan yang selesai.\"></i>"],["Completed at","Selesai pada"],["Errors","Kesalahan"],["Batch Item Detail of","Detail Item Batch dari"],["ID","ID"],["Completed on","Selesai pada"],["Model","Model"],["Prompt Token","Token Prompt"],["Completion Token","Token Penyelesaian"],["Total Token","Total Token"],["Status Code","Kode Status"],["error","kesalahan"],["Conversation","Percakapan"],["Response Validation","Validasi Respons"],["Raw Payload","Payload Mentah"],["View raw payload","Lihat payload mentah"],["Response Preview","Pratinjau Respons"],["Apply translations from selected rows","Terapkan terjemahan dari baris yang dipilih"],["Here you can edit the translation result individually and send it into Translator++","Di sini Anda dapat mengedit hasil terjemahan secara individual dan mengirimkannya ke Translator++"],["Open ChatGPT Settings","Buka Pengaturan ChatGPT"],["Help","Bantuan"],["File list","Daftar File"],["Collapse / restore left panel","Ciutkan / kembalikan panel kiri"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Batch yang tidak selesai tepat waktu akhirnya berpindah ke status kedaluwarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons apa pun untuk permintaan yang selesai tersedia melalui file keluaran batch. Anda akan dikenai biaya untuk token yang dikonsumsi dari permintaan yang selesai."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Contoh percakapan"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Jangan buang uang Anda pada Model Penalaran</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Berbagai studi telah membuktikan bahwa model penalaran jauh lebih buruk daripada model biasa dalam melakukan penulisan kreatif dan tugas terjemahan.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Anda tidak mendapatkan apa-apa selain biaya yang lebih mahal dan waktu respons yang lebih lambat saat menggunakan model penalaran.</p>"],["<h2>Sample dialogue</h2>","<h2>Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons yang baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan.</p>"],["Always separate file","Selalu pisahkan berkas"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan berkas untuk setiap batch. Ini dapat menjaga konteks setiap berkas tidak tercampur dengan berkas lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium ke penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Referensi Terjemahan Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom untuk terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menambahkan informasi seperti gender, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt sebenarnya."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu pisahkan file untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari membebani prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"relPath":"/addons/transGeminiAi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>K</u>irim"],["Toggle word wrap","Alihkan bungkus kata"],["Open debugger (F12)","Buka debugger (F12)"],["Help","Bantuan"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Pengembang Translator++. Anda dapat beralih ke versi Pengembang dengan menggunakan Utilitas Dasar -> Ubah Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks dari terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Contoh percakapan"],["<h2>Sample dialogue</h2>","<h2>Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Dialog contoh yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan.</p>"],["Always separate file","Selalu pisahkan file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan file untuk setiap batch. Ini dapat menjaga konteks setiap file tidak tercampur dengan file lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya penerjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya penerjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan informasi lebih lanjut seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt sebenarnya."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu pisahkan file untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap kumpulan item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari membebani prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transGeminiAi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","Chat dengan API ChatGPT"],["Batch Manager","Manajer Batch"],["This feature is only available if you have a project open.","Fitur ini hanya tersedia jika Anda memiliki proyek yang terbuka."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transGeminiAi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","Tindakan ini akan membuka jendela browser. Pastikan browser default Anda diatur ke browser Chrome. Apakah Anda ingin melanjutkan?"],["Gemini Nano server is already running. Do you want to restart it?","Server Gemini Nano sudah berjalan. Apakah Anda ingin me-restart-nya?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","Tindakan ini akan membuka jendela browser. Pastikan browser default Anda diatur ke browser Chrome. Dan Server Gemini Nano telah dimulai. Apakah Anda ingin melanjutkan?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":false,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"relPath":"/addons/transGeminiNano/geminiNanoUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Always separate file","Selalu pisahkan file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan file untuk setiap batch. Ini dapat menjaga konteks setiap file tidak tercampur dengan file lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan informasi lebih seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu pisahkan file untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari pembengkakan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"relPath":"/addons/transKoboldAI/Llama3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":24,"length":24,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","Nama Layanan"],["Service provider for your Batch API.","Penyedia layanan untuk Batch API Anda."],["Your API Key","Kunci API Anda"],["Please enter your API key for the Batch API service.","Silakan masukkan kunci API Anda untuk layanan Batch API."],["Model","Model"],["The model for your translation.","Model untuk terjemahan Anda."],["Source Column","Kolom Sumber"],["The column of the original texts you want to translate.","Kolom teks asli yang ingin Anda terjemahkan."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Ignore if already translated","Abaikan jika sudah diterjemahkan"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Jika opsi ini dicentang, Translator++ akan mengabaikan baris apa pun yang sudah memiliki terjemahan di kolomnya."],["Filter Tag","Filter Tag"],["If set, only rows with this tag will be translated.","Jika diatur, hanya baris dengan tag ini yang akan diterjemahkan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya penerjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah template untuk memuat referensi aktor dalam pesan prompt."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menambahkan informasi seperti gender, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Enable Context","Aktifkan Konteks"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Aktifkan konteks untuk penerjemahan. Materi yang telah diterjemahkan sebelumnya di atas batch saat ini akan disertakan sebagai konteks. <b>Anda juga perlu menyertakan CONTEXT secara eksplisit ke dalam template</b>"],["Context Character Limit","Batas Karakter Konteks"],["Character limit for the context.","Batas karakter untuk konteks."],["System Message Template","Template Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama dari setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nama lengkap bahasa sumber</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nama lengkap bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan yang telah ditentukan dari algoritma pelarian.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Tambahkan informasi tentang aktor.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Sertakan beberapa baris sebelumnya sebagai konteks</li>"],["Body Message Template","Template Pesan Tubuh"],["Template of the body of your chat.","Template dari tubuh percakapan Anda."],["Sample conversation","Contoh percakapan"],["User message","Pesan pengguna"],["Assistant's response","Tanggapan asisten"],["Enable JailBreak","Aktifkan JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Aktifkan Jailbreak untuk terjemahan. Ini akan membuat terjemahan lebih akurat dan kurang bias. Beberapa model mungkin ingin menghubungkan peristiwa fiksi dengan peristiwa kehidupan nyata, sehingga mereka akan mencoba mengubah terjemahan agar sesuai dengan narasi mereka sendiri. Opsi ini akan mencegah hal itu."],["Jailbreak Template","Template Jailbreak"],["Template of the Jailbreak message.","Template dari pesan Jailbreak."],["Maximum Tokens","Token Maksimum"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Jumlah maksimum token yang akan dihasilkan dalam penyelesaian.<br>Jumlah token dari prompt Anda ditambah max_tokens tidak boleh melebihi panjang konteks model. Kebanyakan model memiliki panjang konteks 2048 token (kecuali model terbaru, yang mendukung 4096)."],["Temperature","Suhu"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Suhu sampling apa yang akan digunakan, antara 0 dan 2. Nilai lebih tinggi seperti 0,8 akan membuat output lebih acak, sementara nilai lebih rendah seperti 0,2 akan membuatnya lebih fokus dan deterministik. <br>OpenAI umumnya merekomendasikan mengubah ini atau top_p tetapi tidak keduanya."],["Nucleus sampling (top_p)","Sampling nukleus (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Alternatif untuk sampling dengan suhu, disebut sampling nukleus, di mana model mempertimbangkan hasil token dengan massa probabilitas top_p. Jadi 0,1 berarti hanya token yang mencakup 10% massa probabilitas teratas yang dipertimbangkan. <br>OpenAI umumnya merekomendasikan mengubah ini atau suhu tetapi tidak keduanya."],["Frequency Penalty","Penalti Frekuensi"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2,0 dan 2,0. Nilai positif memberikan penalti pada token baru berdasarkan frekuensi yang ada dalam teks sejauh ini, mengurangi kemungkinan model untuk mengulangi baris yang sama secara verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalti Kehadiran"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2,0 dan 2,0. Nilai positif memberikan penalti pada token baru berdasarkan apakah mereka muncul dalam teks sejauh ini, meningkatkan kemungkinan model untuk membicarakan topik baru. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","Parameter Kustom"],["Key","Kunci"],["Value","Nilai"],["Type","Tipe"],["Type of the value.","Tipe dari nilai."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Untuk tipe <b>javascript</b>, nilai akan dievaluasi sebagai kode JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Cakupan kode JavaScript adalah <code>window</code>. Jadi Anda bisa mengambil hampir semua nilai."],["Example: <code>trans.project.title</code>","Contoh: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Hapus parameter yang tidak akan dikirim ke API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI terus berubah, beberapa model baru mungkin tidak mendukung parameter lama dan akan mengembalikan error HTTP untuk parameter permintaan yang tidak dikenali."],["You can drop the parameters that are not supported by the model here.","Anda dapat menghapus parameter yang tidak didukung oleh model di sini."],["Batch API settings","Pengaturan API Batch"],["General","Umum"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch OpenAI memungkinkan Anda menerjemahkan proyek secara asinkron dengan biaya 50% lebih rendah, artinya Anda akan menerima hasil terjemahan <b style=\"color:red\">dalam 24 jam</b> dengan <b style=\"color:blue\">setengah biaya normal</b>. Ini sangat berguna untuk proyek besar yang tidak memerlukan hasil terjemahan segera."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Baca lebih lanjut tentang API Batch <a href=\"https://platform.openai.com/docs/guides/batch\" external>di sini</a>.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />Layanan yang didukung: <b>OpenAI</b> dan <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>Konfigurasi lebih lanjut ditemukan di Pengaturan Addon</h2>"],["Open Add-on Settings","Buka Pengaturan Add-on"],["Import Configuration from OpenAI Setting","Impor Konfigurasi dari Pengaturan OpenAI"],["General Settings","Pengaturan Umum"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Jangan buang uang Anda pada Model Penalaran</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Berbagai studi telah membuktikan bahwa model penalaran jauh lebih buruk daripada model normal dalam melakukan tugas penulisan kreatif dan terjemahan.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Anda tidak mendapatkan apa-apa selain biaya yang lebih mahal dan waktu respons yang lebih lambat saat menggunakan model penalaran.</p>"],["<h2>If you're using OpenAI</h2>","<h2>Jika Anda menggunakan OpenAI</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","API Batch OpenAI menggunakan konvensi penamaan model yang sedikit berbeda dibandingkan API standar. Model dalam Mode Batch menyertakan akhiran -batch. Misalnya, jika Anda menentukan <code>gpt-4.1-mini</code>, itu akan secara otomatis diinterpretasikan sebagai <code>gpt-4.1-mini-batch</code>.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","Namun, pada saat add-on ini dikembangkan, model batch tidak tercantum dalam batas penggunaan model OpenAI. Artinya, pengguna yang telah mengatur filter Penggunaan Model ke \"Izinkan\" (daftar putih) tidak akan dapat mengakses API Batch.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","Klik <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>di sini</a> untuk mengubah batas penggunaan model."],["Explore more models","Jelajahi lebih banyak model"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Ignore translated rows","Abaikan baris yang telah diterjemahkan"],["Templates","Template"],["<h2>1. System Message</h2>","<h2>1. Pesan Sistem</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Di sini Anda dapat menjelaskan kepada asisten, apa peran mereka.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Prompt aktual Anda</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Ini adalah prompt aktual untuk asisten.</p>"],["Enable Jailbreak","Aktifkan Jailbreak"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap kumpulan item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari pembengkakan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Enable context","Aktifkan konteks"],["Advanced","Lanjutan"],["Custom Parameters","Parameter Kustom"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Anda dapat menambahkan parameter kustom ke badan permintaan API Chat OpenAI. Ini berguna jika Anda ingin menambahkan parameter tambahan yang tidak tersedia dalam formulir."],["<h2>Warning</h2>","<h2>Peringatan</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Pengaturan parameter kustom yang salah dapat menyebabkan permintaan API gagal. Pastikan Anda tahu apa yang Anda lakukan sebelum menambahkan parameter kustom. Beberapa layanan seperti OpenAI ketat tentang parameter apa yang Anda kirim, dan mereka akan mengembalikan kesalahan HTTP untuk parameter permintaan yang tidak dikenali.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Jika kunci yang sama digunakan beberapa kali, hanya nilai terakhir yang akan digunakan.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Jika kunci yang sama dalam konfigurasi yang ada digunakan, maka parameter konfigurasi yang ada akan ditimpa oleh parameter kustom.</li>"],["String","String"],["Number","Angka"],["Boolean","Boolean"],["JavaScript","JavaScript"],["Drop Parameters","Hapus Parameter"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Biaya overhead</h3>\n                        Biaya overhead adalah biaya dari pesan prompt yang Anda kirim ke asisten tanpa teks terjemahan aktual. Biaya dihitung berdasarkan jumlah token dalam pesan prompt. Semakin banyak token yang Anda miliki, semakin tinggi biayanya.<br>\n                        <b>Perkiraan biaya overhead:</b> <span class=\"overheadCost\">0</span> token / permintaan."],["Are you sure you want to reset the form?","Apakah Anda yakin ingin mengatur ulang formulir?"],["Translate with Batch API","Terjemahkan dengan Batch API"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Apakah Anda yakin ingin memproses batch?\nBiaya akan dikenakan untuk operasi ini."],["The batch is successfully created. Do you want to open the batch manager?","Batch berhasil dibuat. Apakah Anda ingin membuka manajer batch?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","Apakah Anda yakin ingin mengimpor konfigurasi dari pengaturan OpenAI? Ini akan menimpa konfigurasi saat ini."],["chatGPT engine is not found","Mesin chatGPT tidak ditemukan"],["Configuration imported successfully.","Konfigurasi berhasil diimpor."],["Batch API Queue","Antrian Batch API"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"relPath":"/addons/transLLMBatchApi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":125,"length":125,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Silakan pilih baris untuk menerapkan terjemahan"],["Target Column","Kolom Target"],["The column to put the translation result.","Kolom untuk menempatkan hasil terjemahan."],["Import translation from ChatGPT Batch","Impor terjemahan dari ChatGPT Batch"],["Translation applied to selected rows","Terjemahan diterapkan pada baris yang dipilih"],["Invalid format","Format tidak valid"],["OK","OK"],["Mismatch","Tidak Cocok"],["Failed to load batch list with error: \n","Gagal memuat daftar batch dengan kesalahan: \n"],["Download Error File","Unduh File Kesalahan"],["Batch is not completed yet","Batch belum selesai"],["Are you sure you want to cancel this batch?","Apakah Anda yakin ingin membatalkan batch ini?"],["Cannot cancel completed batch.","Tidak dapat membatalkan batch yang sudah selesai."],["Batch cancelled","Batch dibatalkan"],["Failed to cancel batch","Gagal membatalkan batch"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","Batch"],["Apply translation","Terapkan terjemahan"],["Cancel batch","Batalkan batch"],["Status","Status"],["Batch ID","ID Batch"],["Input File ID","ID File Input"],["End point","Titik akhir"],["Created at","Dibuat pada"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Kadaluarsa pada <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batch yang tidak selesai tepat waktu akhirnya akan berpindah ke status kadaluarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons untuk permintaan yang selesai tersedia melalui file output batch. Anda akan dikenakan biaya untuk token yang dikonsumsi dari permintaan yang selesai.\"></i>"],["Completed at","Selesai pada"],["Errors","Kesalahan"],["Batch Item Detail of","Detail Item Batch dari"],["ID","ID"],["Completed on","Selesai pada"],["Model","Model"],["Prompt Token","Token Prompt"],["Completion Token","Token Penyelesaian"],["Total Token","Total Token"],["Status Code","Kode Status"],["error","kesalahan"],["Conversation","Percakapan"],["Response Validation","Validasi Respons"],["Raw Payload","Payload Mentah"],["View raw payload","Lihat muatan mentah"],["Response Preview","Pratinjau Respons"],["Apply translations from selected rows","Terapkan terjemahan dari baris yang dipilih"],["Here you can edit the translation result individually and send it into Translator++","Di sini Anda dapat mengedit hasil terjemahan secara individual dan mengirimkannya ke Translator++"],["Open ChatGPT Settings","Buka Pengaturan ChatGPT"],["Help","Bantuan"],["File list","Daftar file"],["Collapse / restore left panel","Ciutkan / pulihkan panel kiri"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Batch yang tidak selesai tepat waktu akhirnya akan berpindah ke status kedaluwarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons apa pun untuk permintaan yang selesai tersedia melalui file keluaran batch. Anda akan dikenai biaya untuk token yang dikonsumsi dari permintaan yang selesai."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","Nama Layanan"],["Service provider for your Batch API.","Penyedia layanan untuk Batch API Anda."],["API Key","Kunci API"],["Please enter your API key for the Batch API service.","Silakan masukkan kunci API Anda untuk layanan Batch API."],["Model","Model"],["The pre-trained model","Model yang telah dilatih sebelumnya"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","Di ChatGPT, Anda mungkin perlu mengatur model yang diizinkan untuk digunakan (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","Aktifkan JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Aktifkan Jailbreak untuk terjemahan. Ini akan membuat terjemahan lebih akurat dan kurang bias. Beberapa model mungkin ingin menghubungkan peristiwa fiksi dengan peristiwa kehidupan nyata, sehingga mereka akan mencoba mengubah terjemahan agar sesuai dengan narasi mereka sendiri. Opsi ini akan mencegah hal itu."],["Jailbreak Template","Template Jailbreak"],["Template of the Jailbreak message.","Template pesan Jailbreak."],["Maximum Tokens","Token Maksimum"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Jumlah maksimum token yang akan dihasilkan dalam penyelesaian.<br>Jumlah token dari prompt Anda ditambah max_tokens tidak boleh melebihi panjang konteks model. Kebanyakan model memiliki panjang konteks 2048 token (kecuali model terbaru, yang mendukung 4096)."],["Temperature","Suhu"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Suhu sampling yang digunakan, antara 0 dan 2. Nilai lebih tinggi seperti 0,8 akan membuat keluaran lebih acak, sementara nilai lebih rendah seperti 0,2 akan membuatnya lebih fokus dan deterministik. <br>OpenAI umumnya merekomendasikan mengubah ini atau top_p tetapi tidak keduanya."],["Nucleus sampling (top_p)","Sampling nukleus (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Alternatif untuk sampling dengan suhu, disebut sampling nukleus, di mana model mempertimbangkan hasil token dengan massa probabilitas top_p. Jadi 0,1 berarti hanya token yang mencakup 10% massa probabilitas teratas yang dipertimbangkan. <br>OpenAI umumnya merekomendasikan mengubah ini atau suhu tetapi tidak keduanya."],["Frequency Penalty","Penalti Frekuensi"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2,0 dan 2,0. Nilai positif memberikan penalti pada token baru berdasarkan frekuensi yang ada dalam teks sejauh ini, mengurangi kemungkinan model untuk mengulangi baris yang sama secara verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalti Kehadiran"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2,0 dan 2,0. Nilai positif memberikan penalti pada token baru berdasarkan apakah mereka muncul dalam teks sejauh ini, meningkatkan kemungkinan model untuk membicarakan topik baru. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","Karakter Maksimum per Batch"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Batas karakter maksimum per batch terjemahan.\nOpsi ini hanya akan menghitung panjang karakter teks asli, dan bukan panjang karakter pesan prompt."],["Max row per concurrent requests","Baris maksimum per permintaan bersamaan"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Berapa banyak baris yang diizinkan untuk setiap permintaan bersamaan. Atur ke <b>0</b> untuk menonaktifkan fitur ini.<br />Jika opsi ini dinonaktifkan maka tidak peduli berapa banyak <b>Permintaan bersamaan maksimum</b> yang Anda atur, Translator++ akan memproses permintaan sebagai satu bagian.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Semakin banyak baris yang Anda atur, semakin banyak terjemahan yang bisa Anda dapatkan dalam satu batch. Oleh karena itu mengurangi biaya overhead dan meningkatkan kemungkinan AI mengembalikan hasil error.<br />Semakin rendah angkanya, semakin kecil kemungkinan terjemahan akan error tetapi akan menambah biaya untuk prompt overhead."],["Code Escaping Algorithm","Algoritma Pelolosan Kode"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Algoritma pelolosan untuk kode inline di dalam dialog. Anda mungkin perlu mengubah <b>Template Pesan Sistem</b> dan <b>Template Pesan Badan</b> sesuai dengan algoritma pelolosan pilihan Anda.<br />Ketika Anda memilih <b>JSONCloaking</b>, parameter response_format: { type: 'json_object' } akan dikirim ke ChatGPT secara otomatis. <b>JSONCloaking</b> sangat akurat, tetapi tidak bekerja dengan semua model, coba <b>gpt-3.5-turbo-1106</b>."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>API Batch</b> memungkinkan Anda mengirim banyak permintaan sekaligus, yang diproses secara asinkron di latar belakang. Anda tidak akan menerima hasil segera, tetapi proses <b>akan selesai dalam 24 jam</b>—dan seringkali lebih cepat. Metode ini <b>hanya memakan biaya setengah dari pendekatan standar</b>."],["Batch API settings","Pengaturan API Batch"],["General","Umum"],["Explore more models","Jelajahi lebih banyak model"],["Templates","Templat"],["Enable Jailbreak","Aktifkan Jailbreak"],["Advanced","Lanjutan"],["Batch Translation Setting","Pengaturan Terjemahan Batch"],["Default","Bawaan"],["JavaScript template cloaking","Penyamaran templat JavaScript"],["None (no escaping)","Tidak ada (tanpa pelolosan)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"relPath":"/addons/transLLMBatchApi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":39,"length":39,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Percakapan contoh"],["<h2>Sample dialogue</h2>","<h2>Dialog contoh</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Dialog yang ada sebagai contoh. Anda dapat menulis contoh respons yang baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["Always separate file","Selalu pisahkan berkas"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan berkas untuk setiap batch. Ini dapat menjaga konteks setiap berkas tidak tercampur dengan berkas lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan lebih banyak informasi seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt sebenarnya."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu file terpisah untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur akan mencoba memuat hanya istilah yang relevan untuk menghindari membengkakkan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transLLMBatchApi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","Buka Pengelola Batch"],["This feature is only available if you have a project open.","Fitur ini hanya tersedia jika Anda memiliki proyek terbuka."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":false,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transLLMBatchApi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","URL proxy LiteLLM. Alamat URL dari proxy LiteLLM Anda. Defaultnya adalah: <code>http://localhost:8890/chat/completions</code>"],["API's base URL","URL dasar API"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","URL dasar dari layanan yang Anda pilih. Isi bidang ini hanya jika Anda menggunakan URL endpoint kustom. LiteLLM akan secara otomatis mendeteksi URL dasar berdasarkan model yang diberikan.<br />Cara LiteLLM menambahkan jalur ke URL bergantung pada layanan. Misalnya, untuk endpoint yang kompatibel dengan OpenAI, LiteLLM akan menambahkan <code>/chat/completions</code> ke URL yang diberikan. Jadi, jika endpoint Anda adalah <code>https://api.fast-tunnel.one/v1/chat/completions</code>, isi bidang dengan <code>https://api.fast-tunnel.one/v1</code>."],["API Version","Versi API"],["Optional. The API version parameter needed for some services.","Opsional. Parameter versi API yang diperlukan untuk beberapa layanan."],["API Key","Kunci API"],["Optional. The API key used for authenticating your access to the service.","Opsional. Kunci API yang digunakan untuk mengautentikasi akses Anda ke layanan."],["Model","Model"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","Pra-latih model pilihan Anda. Gunakan format kenyamanan model LiteLLM untuk menentukan model yang Anda sukai. Formatnya adalah {nama layanan}/{model}. Contoh:"],["your deployment name","nama penyebaran Anda"],["However, some models have unique names that can be directly identified, like:","Namun, beberapa model memiliki nama unik yang dapat langsung diidentifikasi, seperti:"],["Azure AD Token","Token Azure AD"],["AWS Access Key ID","ID Kunci Akses AWS"],["AWS secret access key","Kunci akses rahasia AWS"],["Open router site URL","Buka URL situs router"],["Open router APP name","Buka nama APP router"],["Enable Context","Aktifkan Konteks"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Aktifkan konteks untuk terjemahan. Materi yang telah diterjemahkan sebelumnya di atas batch saat ini akan disertakan sebagai konteks. <b>Anda juga perlu secara eksplisit menyertakan KONTEKS ke dalam templat</b>"],["Context Character Limit","Batas Karakter Konteks"],["Character limit for the context.","Batas karakter untuk konteks."],["System Message Template","Templat Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama dari setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan yang telah ditentukan dari algoritma pelarian.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (Pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks dari terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Contoh percakapan"],["User message","Pesan pengguna"],["Assistant's response","Tanggapan asisten"],["Body Message Template","Templat Pesan Isi"],["Template of the body of your message.","Templat isi pesan Anda."],["Enable JailBreak","Aktifkan JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Aktifkan Jailbreak untuk terjemahan. Ini akan membuat terjemahan lebih akurat dan kurang bias. Beberapa model mungkin ingin menghubungkan peristiwa fiksi dengan peristiwa kehidupan nyata, sehingga mereka akan mencoba mengubah terjemahan agar sesuai dengan narasi mereka sendiri. Opsi ini akan mencegah hal itu."],["Jailbreak Template","Templat Jailbreak"],["Template of the Jailbreak message.","Templat pesan Jailbreak."],["Maximum Tokens","Token Maksimum"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Jumlah maksimum token yang dihasilkan dalam penyelesaian.<br>Jumlah token dari prompt Anda ditambah max_tokens tidak boleh melebihi panjang konteks model. Kebanyakan model memiliki panjang konteks 2048 token (kecuali model terbaru, yang mendukung 4096)."],["Temperature","Suhu"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Suhu pengambilan sampel yang digunakan, antara 0 dan 2. Nilai lebih tinggi seperti 0,8 akan membuat keluaran lebih acak, sementara nilai lebih rendah seperti 0,2 akan membuatnya lebih fokus dan deterministik. <br>OpenAI umumnya merekomendasikan mengubah ini atau top_p tetapi tidak keduanya."],["Nucleus sampling (top_p)","Pengambilan sampel nukleus (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Alternatif untuk pengambilan sampel dengan suhu, disebut pengambilan sampel nukleus, di mana model mempertimbangkan hasil token dengan massa probabilitas top_p. Jadi 0,1 berarti hanya token yang terdiri dari 10% massa probabilitas teratas yang dipertimbangkan. <br>OpenAI umumnya merekomendasikan mengubah ini atau suhu tetapi tidak keduanya."],["Frequency Penalty","Penalti Frekuensi"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2.0 dan 2.0. Nilai positif memberikan penalti pada token baru berdasarkan frekuensi yang ada dalam teks sejauh ini, mengurangi kemungkinan model untuk mengulangi baris yang sama secara verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalti Kehadiran"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2.0 dan 2.0. Nilai positif memberikan penalti pada token baru berdasarkan apakah mereka muncul dalam teks sejauh ini, meningkatkan kemungkinan model untuk membicarakan topik baru. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Gunakan Skema JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Gunakan <code>json_schema</code> untuk bidang <code>response_format.type</code> alih-alih <code>json_object</code> yang lama. <code>json_schema</code> diperlukan oleh beberapa model terbaru dan beberapa server seperti <b>LM Studio</b>, tetapi beberapa model lama masih menggunakan <code>json_object</code>."],["Stop","Berhenti"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","Masukkan kata kunci di mana API akan berhenti menghasilkan token lebih lanjut. Pisahkan setiap entri dengan baris baru."],["Additional argument variables","Variabel argumen tambahan"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","Variabel argumen tambahan yang akan ditambahkan saat memulai server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","Waktu Habis Batch"],["Timeout for each batch in milisecond","Waktu habis untuk setiap batch dalam milidetik"],["Max Request Length","Panjang Maksimum Permintaan"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","Panjang maksimum karakter untuk setiap batch terjemahan.\nSetiap penerjemah memiliki spesifikasi yang berbeda.\nSaya merekomendasikan kurang dari 2000 untuk penerjemah front-end WEB yang menggunakan parameter GET."],["Max concurrent requests","Permintaan Bersamaan Maksimum"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","Berapa banyak permintaan bersamaan yang diizinkan untuk terhubung secara bersamaan. Atur ke <b>0</b> untuk menonaktifkan fitur ini.<br />Gabungkan opsi ini dengan <b>Baris maksimum per permintaan bersamaan</b> untuk meningkatkan kecepatan terjemahan."],["Max row per concurrent requests","Baris Maksimum per Permintaan Bersamaan"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","Berapa banyak baris yang diizinkan untuk setiap permintaan bersamaan. Atur ke <b>0</b> untuk menonaktifkan fitur ini.<br />Jika opsi ini dinonaktifkan maka tidak peduli berapa banyak <b>Permintaan Bersamaan Maksimum</b> yang Anda atur, Translator++ akan memproses permintaan sebagai satu potongan."],["Batch delay","Penundaan Batch"],["Delay between batch (in miliseconds)","Penundaan antar batch (dalam milidetik)"],["Code Escaping Algorithm","Algoritma Pelolosan Kode"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","Algoritma pelolosan untuk kode sebaris di dalam dialog. Anda mungkin perlu mengubah <b>Template Pesan Sistem</b> dan <b>Template Pesan Isi</b> sesuai dengan algoritma pelolosan pilihan Anda."],["Number of retry","Jumlah percobaan ulang"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Berapa kali mesin harus mencoba ulang ketika validasi keluaran terjemahan gagal. Jika nullish (kosong), maka tidak ada percobaan ulang."],["Retry when the number of translated rows doesn't match original","Coba ulang ketika jumlah baris terjemahan tidak cocok dengan aslinya"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Jika diaktifkan, mesin akan mencoba ulang ketika model mengembalikan jumlah baris terjemahan yang berbeda dibandingkan dengan payload asli."],["Retry when the number of lines for each translated row doesn't match original","Coba ulang ketika jumlah baris untuk setiap baris terjemahan tidak cocok dengan aslinya"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Jika diaktifkan, mesin akan mencoba ulang ketika setiap baris terjemahan memiliki jumlah baris yang berbeda dari baris aslinya."],["Prompt: Row count mismatch","Prompt: Ketidakcocokan jumlah baris"],["Prompt used when retrying due to row/element count mismatch.","Prompt yang digunakan ketika mencoba ulang karena ketidakcocokan jumlah baris/elemen."],["Prompt: Line count mismatch","Prompt: Ketidakcocokan jumlah baris per baris"],["Prompt used when retrying due to per-row line count mismatch.","Prompt yang digunakan ketika mencoba ulang karena ketidakcocokan jumlah baris per baris."],["Prompt: Error / Retry instruction","Prompt: Kesalahan / Instruksi coba ulang"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","Prompt yang ditambahkan setelah prompt ketidakcocokan untuk menginstruksikan model untuk mencoba ulang."],["Custom Parameter","Parameter Kustom"],["Key","Kunci"],["Value","Nilai"],["Type","Tipe"],["Type of the value.","Jenis nilai."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Untuk tipe <b>javascript</b>, nilai akan dievaluasi sebagai kode JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Ruang lingkup kode javascript adalah <code>window</code>. Jadi Anda dapat mengambil hampir semua nilai."],["<br />Example: <code>trans.project.title</code>","<br />Contoh: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Hapus parameter yang tidak akan dikirim ke API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI terus berubah, beberapa model baru mungkin tidak mendukung parameter lama dan akan mengembalikan kesalahan HTTP untuk parameter permintaan yang tidak dikenali."],["You can drop the parameters that are not supported by the model here.","Anda dapat menghapus parameter yang tidak didukung oleh model di sini."],["Manage configuration","Kelola konfigurasi"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","Beberapa fitur mesin ini memerlukan add-on ChatGPT untuk diinstal. Pastikan Anda telah menginstal add-on ChatGPT sebelum menggunakan mesin ini."],["Text Completion Setting","Pengaturan Penyelesaian Teks"],["General","Umum"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Jangan buang uang Anda pada Model Penalaran</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Telah terbukti oleh berbagai studi bahwa model penalaran jauh lebih buruk daripada model normal dalam melakukan tugas penulisan kreatif dan penerjemahan.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Anda tidak mendapatkan apa-apa selain biaya yang lebih mahal dan waktu respons yang lebih lambat saat menggunakan model penalaran.</p>"],["Platform specific","Spesifik platform"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","Template"],["Enable context","Aktifkan konteks"],["<h2>Sample dialogue</h2>","<h2>Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["Retry prompts","Ulangi perintah"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Prompt ini ditambahkan sebagai pesan <b>pengguna</b> tambahan selama percobaan ulang, tepat setelah output model sebelumnya.</p>"],["<p>Available variables:</p>","<p>Variabel yang tersedia:</p>"],["Enable Jailbreak","Aktifkan Jailbreak"],["Advanced","Lanjutan"],["Custom Parameters","Parameter Kustom"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Anda dapat menambahkan parameter kustom ke badan permintaan OpenAI Chat API. Ini berguna jika Anda ingin menambahkan parameter tambahan yang tidak tersedia dalam formulir."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>Peringatan</h2><ul><li>Pengaturan parameter kustom yang salah dapat menyebabkan permintaan API gagal. Pastikan Anda tahu apa yang Anda lakukan sebelum menambahkan parameter kustom. Beberapa layanan seperti OpenAI ketat tentang parameter yang Anda kirim, dan mereka akan mengembalikan kesalahan HTTP untuk parameter permintaan yang tidak dikenali.</li><li>Jika kunci yang sama digunakan beberapa kali, hanya nilai terakhir yang akan digunakan.</li><li>Jika kunci yang sama dalam konfigurasi yang ada digunakan, maka parameter konfigurasi yang ada akan ditimpa oleh parameter kustom.</li></ul>"],["Drop Parameters","Hapus Parameter"],["LiteLLM Proxy Configuration","Konfigurasi Proxy LiteLLM"],["Start LiteLLM server","Mulai server LiteLLM"],["Processing...","Memproses..."],["Server started on port ","Server dimulai di port "],["Check LiteLLM Status","Periksa Status LiteLLM"],["Change LiteLLM Version","Ubah Versi LiteLLM"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","Masukkan versi baru LiteLLM yang ingin Anda instal.\nVersi yang diketahui berfungsi: 1.38.0, 1.49.4 \nVersi yang disarankan adalah: "],["Are you sure you want to install LiteLLM version ","Apakah Anda yakin ingin menginstal LiteLLM versi "],["Failed to install LiteLLM. Please check the console for more details.","Gagal menginstal LiteLLM. Silakan periksa konsol untuk detail lebih lanjut."],["LiteLLM has been successfully updated to version ","LiteLLM telah berhasil diperbarui ke versi "],["Batch Translation Setting","Pengaturan Terjemahan Batch"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Maaf, addon ini hanya tersedia untuk patron aktif saja.\nAnda dapat membuka kunci fitur ini dengan menjadi patron $1."],["Retries and Refinement","Ulangi dan Perbaikan"],["<h2>Retries and Refinement</h2>","<h2>Ulangi dan Perbaikan</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Ketika keluaran terjemahan gagal dalam validasi, Translator++ dapat meminta model untuk mengulangi terjemahan. Anda dapat mengatur berapa kali model harus mengulang dan juga menetapkan kondisi untuk pengulangan.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Menetapkan jumlah pengulangan yang wajar dengan kondisi pengulangan yang tepat dapat meningkatkan kualitas terjemahan secara signifikan sambil mengendalikan biaya dan waktu.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Setiap pengulangan membutuhkan waktu dan biaya tambahan</b>. Jika batch Anda sering mengulang, Anda mungkin perlu menyesuaikan prompt untuk membuat instruksi lebih jelas bagi model.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Gunakan alat pengembang atau Pengelola Batch untuk men-debug terjemahan batch Anda.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Algoritma Pelolosan Kode</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Pelolosan kode adalah teknik untuk mencegah MTL mengubah cuplikan kode di dalam dialog. Ini berguna ketika dialog Anda berisi cuplikan kode seperti tag HTML, tag XML, objek JSON, atau template JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Pilih algoritma pelolosan yang sesuai dengan cuplikan kode di dalam dialog Anda. Anda mungkin perlu menyesuaikan template <b>pesan sistem</b>, <b>Prompt sampel</b>, dan <b>pesan tubuh</b> sesuai kebutuhan.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Klik <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>di sini</a> untuk membaca lebih lanjut tentang algoritma pelolosan kode dan cara menggunakannya secara efektif.</p>"],["JavaScript template cloaking","Penyamaran template JavaScript"],["None (no escaping)","Tidak ada (tanpa pelolosan)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Apakah Anda ingin memuat preset dialog sampel untuk algoritma pelolosan yang dipilih? Ini akan menimpa dialog sampel Anda yang ada."],["Always separate file","Selalu pisahkan file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan file untuk setiap batch. Ini dapat menjaga konteks setiap file tidak tercampur dengan file lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah template untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menambahkan informasi lebih lanjut seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt sebenarnya."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu pisahkan file untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur akan mencoba memuat hanya istilah yang relevan untuk menghindari membengkaknya prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":false,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"relPath":"/addons/transLitellm/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":166,"length":166,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","Terjemahkan dengan OpenAI Batch API"],["Model","Model"],["The pre-trained model.","Model yang telah dilatih sebelumnya."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Tampaknya OpenAI Batch API menggunakan konvensi penamaan model yang sedikit berbeda dari API yang umum digunakan. Model yang digunakan dalam Batch API memiliki awalan \"-batch\". Misalnya, jika Anda menggunakan <code>gpt-4.1-mini</code>, model secara otomatis menjadi <code>gpt-4.1-mini-batch</code>.<br />\nNamun, pada saat add-on ini dibuat, model batch tidak tercantum dalam batas penggunaan model OpenAI, yang membuat pengguna tidak dapat menggunakan Batch API jika mereka telah mengatur filter Penggunaan Model ke \"Izinkan\" (daftar putih).<br />\nIni kemungkinan adalah bug di antarmuka OpenAI yang mungkin diperbaiki di masa depan.<br />\nJadi, pastikan untuk mengatur batas penggunaan di OpenAI ke mode \"Blokir\" (daftar hitam) agar dapat menggunakan Batch API.<br />\nKlik di sini untuk mengubah batas penggunaan model: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Kolom Sumber"],["The column of the original texts you want to translate.","Kolom teks asli yang ingin Anda terjemahkan."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Ignore if already translated","Abaikan jika sudah diterjemahkan"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Jika opsi ini dicentang, Translator++ akan mengabaikan baris apa pun yang sudah memiliki terjemahan di kolomnya."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menambahkan informasi lebih lanjut seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["System Message Template","Templat Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama dari setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nama lengkap bahasa sumber</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nama lengkap bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan yang telah ditentukan dari algoritma pelarian.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (Pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Tambahkan informasi tentang aktor.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Sertakan beberapa baris sebelumnya sebagai konteks</li>"],["Body Message Template","Template Pesan Tubuh"],["Template of the body of your chat.","Template dari badan percakapan Anda."],["Sample conversation","Contoh percakapan"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI Batch API memungkinkan Anda menerjemahkan proyek Anda secara asinkron dengan biaya 50% lebih rendah, artinya Anda akan menerima hasil terjemahan <b style=\"color:red\">dalam 24 jam</b> dengan <b style=\"color:blue\">setengah biaya normal</b>. Ini sangat berguna untuk proyek besar yang tidak memerlukan hasil terjemahan segera."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />Baca lebih lanjut tentang OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>di sini</a>."],["General Settings","Pengaturan Umum"],["This form is using your OpenAI Batch API configuration.<br>","Formulir ini menggunakan konfigurasi OpenAI Batch API Anda.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","Anda dapat mengubah konfigurasi dengan pergi ke pengaturan add-on <b>OpenAI Batch API</b> di jendela opsi.<br>"],["There you can set the API key, model, and other settings.<br />","Di sana Anda dapat mengatur kunci API, model, dan pengaturan lainnya.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Buka pengaturan ChatGPT\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Jangan buang uang Anda untuk Model Penalaran</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Berbagai penelitian telah membuktikan bahwa model penalaran jauh lebih buruk daripada model normal dalam melakukan tugas penulisan kreatif dan penerjemahan.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Anda tidak mendapatkan apa-apa selain biaya yang lebih mahal dan waktu respons yang lebih lambat saat menggunakan model penalaran.</p>"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Ignore translated rows","Abaikan baris yang sudah diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap kumpulan item untuk meningkatkan kualitas penerjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari membengkakkan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt Template","Template Prompt"],["<h2>1. System Message</h2>","<h2>1. Pesan Sistem</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Di sini Anda dapat menjelaskan kepada asisten, apa peran mereka.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Prompt aktual Anda</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Ini adalah prompt aktual kepada asisten.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Biaya overhead</h3>\n                        Biaya overhead adalah biaya dari pesan prompt yang Anda kirim ke asisten tanpa teks penerjemahan aktual. Biaya dihitung berdasarkan jumlah token dalam pesan prompt. Semakin banyak token yang Anda miliki, semakin tinggi biayanya.<br>\n                        <b>Perkiraan biaya overhead:</b> <span class=\"overheadCost\">0</span> token / permintaan."],["Are you sure you want to reset the form?","Apakah Anda yakin ingin mengatur ulang formulir?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Apakah Anda yakin ingin memproses batch ini?\nBiaya akan dikenakan untuk operasi ini."],["The batch is successfully created. Do you want to open the batch manager?","Batch berhasil dibuat. Apakah Anda ingin membuka pengelola batch?"],["OpenAI Batch API Queue","Antrian OpenAI Batch API"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"relPath":"/addons/transOpenAIBatch/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":65,"length":65,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Silakan pilih baris untuk menerapkan terjemahan"],["Target Column","Kolom Target"],["The column to put the translation result.","Kolom untuk menempatkan hasil terjemahan."],["Import translation from ChatGPT Batch","Impor terjemahan dari Batch ChatGPT"],["Translation applied to selected rows","Terjemahan diterapkan pada baris yang dipilih"],["Invalid format","Format tidak valid"],["OK","OK"],["Mismatch","Tidak cocok"],["Failed to load batch list with error: \n","Gagal memuat daftar batch dengan kesalahan: \n"],["Download Error File","Unduh File Kesalahan"],["Batch is not completed yet","Batch belum selesai"],["Are you sure you want to cancel this batch?","Apakah Anda yakin ingin membatalkan batch ini?"],["Cannot cancel completed batch.","Tidak dapat membatalkan batch yang sudah selesai."],["Batch cancelled","Batch dibatalkan"],["Failed to cancel batch","Gagal membatalkan batch"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","Batch"],["Apply translation","Terapkan terjemahan"],["Cancel batch","Batalkan batch"],["Status","Status"],["Batch ID","ID Batch"],["Input File ID","ID File Input"],["End point","Titik akhir"],["Created at","Dibuat pada"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Kadaluarsa pada <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batch yang tidak selesai tepat waktu akhirnya berpindah ke status kedaluwarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons apa pun untuk permintaan yang sudah selesai tersedia melalui file output batch. Anda akan dikenakan biaya untuk token yang digunakan dari permintaan yang sudah selesai.\"></i>"],["Completed at","Selesai pada"],["Errors","Kesalahan"],["Batch Item Detail of","Detail Item Batch dari"],["ID","ID"],["Completed on","Selesai pada"],["Model","Model"],["Prompt Token","Token Prompt"],["Completion Token","Token Penyelesaian"],["Total Token","Total Token"],["Status Code","Kode Status"],["error","kesalahan"],["Conversation","Percakapan"],["Response Validation","Validasi Respons"],["Raw Payload","Payload Mentah"],["View raw payload","Lihat payload mentah"],["Response Preview","Pratinjau Respons"],["Apply translations from selected rows","Terapkan terjemahan dari baris yang dipilih"],["Here you can edit the translation result individually and send it into Translator++","Di sini Anda dapat mengedit hasil terjemahan secara individual dan mengirimkannya ke Translator++"],["Open ChatGPT Settings","Buka Pengaturan ChatGPT"],["Help","Bantuan"],["File list","Daftar file"],["Collapse / restore left panel","Ciutkan / kembalikan panel kiri"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Batch yang tidak selesai tepat waktu akhirnya berpindah ke status kedaluwarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons apa pun untuk permintaan yang selesai tersedia melalui file output batch. Anda akan dikenakan biaya untuk token yang dikonsumsi dari permintaan yang selesai."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Contoh percakapan"],["<h2>Sample dialogue</h2>","<h2>Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan.</p>"],["Always separate file","Selalu pisahkan file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan file untuk setiap batch. Ini dapat menjaga konteks setiap file tidak tercampur dengan file lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan informasi lebih lanjut seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt aktual."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu file terpisah untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari membengkaknya prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transOpenAIBatch/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","Manajer Batch"],["This feature is only available if you have a project open.","Fitur ini hanya tersedia jika Anda memiliki proyek terbuka."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":false,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transOpenAIBatch/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","Mulai server"],["Server started","Server dimulai"],["Reinstall server","Pasang ulang server"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","Masukkan versi baru pustaka Translators yang ingin Anda instal.\nVersi terbaru adalah: "],["Are you sure you want to install Translators version ","Apakah Anda yakin ingin menginstal versi Translators "],["Failed to install Translators. Please check the console for more details.","Gagal menginstal Translators. Silakan periksa konsol untuk detail lebih lanjut."],["Translators has been successfully updated to version ","Translators telah berhasil diperbarui ke versi "],["General Settings","Pengaturan Umum"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":false,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"relPath":"/addons/transPyTranslators/pyTranslators.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","Apakah Anda yakin ingin membatalkan?"],["Process paused!\nPress OK to continue!","Proses dijeda!\nTekan OK untuk melanjutkan!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":false,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"relPath":"/addons/transRedBatch/transredbatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","Jangan pernah membongkar kamus dari RAM"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":false,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"relPath":"/addons/transRikaikun/transRikaikun.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","Tidak dapat memulai Proxy Terjemahan!\nProxy Terjemahan saat ini hanya tersedia untuk patron $3 atau lebih."],["Please enter the port number:","Silakan masukkan nomor port:"],["Invalid port : ","Port tidak valid: "],["Port must be a numeric.","Port harus berupa angka."],["Port has successfully changed to: ","Port telah berhasil diubah menjadi: "],["Connection Info","Info Koneksi"],["Do you want to copy the base URL into the clipboard?","Apakah Anda ingin menyalin URL dasar ke papan klip?"],["Use secure protocol(HTTPS)","Gunakan protokol aman (HTTPS)"],["Port","Port"],["Connection info","Info koneksi"],["Help","Bantuan"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":false,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"relPath":"/addons/translationProxy/translationProxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","Akan memaksa pengkodean teks ke yang dipilih saat menulis skrip. (kosong = otomatis)<br />. Anda dapat menggunakan bidang ini untuk mengonversi skrip menjadi <b>UTF-16</b> agar game dapat dimainkan tanpa mengubah lokal Anda ke Jepang."],["Use legacy parser","Gunakan parser lama"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","Gunakan parser lama (parser lama) alih-alih parser baru.<br />Parser lama lebih cepat, tetapi tidak dapat diandalkan pada beberapa game.<br />Parser baru lebih dapat diandalkan, tetapi lebih lambat."],["Select TyranoBuilder packaged game","Pilih game yang dikemas TyranoBuilder"],["Select the exe file of your packaged game.","Pilih file exe dari game yang dikemas Anda."],["Target folder","Folder target"],["Select destination folder. The process will replace the existing files.","Pilih folder tujuan. Proses akan mengganti file yang ada."],["Extraction completed","Ekstraksi selesai"],["Close","Tutup"],["Next","Lanjut"],["Please select game executable file","Silakan pilih file eksekutif game"],["Back","Kembali"],["The game is fully loaded, proceed!","Game telah dimuat sepenuhnya, lanjutkan!"],["Extract data","Ekstrak data"],["Open extracted folder","Buka folder yang diekstrak"],["Extract resources","Ekstrak sumber daya"],["Select the game executable","Pilih eksekutif game"],["Select the game executable or asar file to extract","Pilih eksekutif game atau file asar untuk diekstrak"],["Target directory","Direktori target"],["Select the target directory to store the unpacked files","Pilih direktori target untuk menyimpan file yang diekstrak"],["Electron archive file detected. Do you want to extract the asar file instead?","File arsip Electron terdeteksi. Apakah Anda ingin mengekstrak file asar saja?"],["Tyranobuilder Game Extractor","Ekstraktor Game Tyranobuilder"],["Before you create a new project, please make sure that :","Sebelum membuat proyek baru, pastikan bahwa:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","Add-on <b>Kirikiri Adventure Game parser</b> terinstal di Translator++ Anda"],["Your game is fully extracted.","Game Anda telah sepenuhnya diekstrak."],["Extract TyranoBuilder package","Ekstrak paket TyranoBuilder"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Semua file .ks & .tjs dalam teks biasa (tidak dikompilasi, tidak diacak, dan tidak dienkripsi)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Beberapa tindakan akan mengubah game Anda. <b>Jadi pastikan untuk membuat cadangan game Anda!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Pilih file eksekutif game. File ini adalah file utama game yang akan digunakan untuk mengekstrak data game."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","Dalam game Tyrano, biasanya file <b>index.html</b> atau <b>exe</b>."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Daftar kemungkinan pengkodean karakter. <b>Urutan penting!</b>. Anda dapat menyeret untuk mengurutkan daftar."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","Game yang dibuat dengan TyranoBuilder menggunakan pengkodean <b>UTF-8</b>"],["Literal tags are the tags that will be escaped into Translator++ editor.","Tag literal adalah tag yang akan di-escape ke dalam editor Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> wajib."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","Tag <b>[r]</b> akan diinterpolasi oleh Translator++ menjadi baris baru. Jadi Anda tidak perlu menulis <b>[r]</b> secara eksplisit."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Skrip Kirikiri (.ks) sangat dapat disesuaikan dan memungkinkan pengembang membuat tag mereka sendiri."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ dapat menangani tag standar seperti nama karakter yang dimulai dengan tanda pagar (#)."],["However, Translator++ may not be able to handle custom tags created by developers.","Namun, Translator++ mungkin tidak dapat menangani tag kustom yang dibuat oleh pengembang."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Oleh karena itu, Anda mungkin perlu mendefinisikan tag dan atribut yang perlu diterjemahkan dan yang perlu ditandai sebagai nama aktor."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>Silakan kunjungi <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">referensi tag TyranoBuilder</a> untuk informasi lebih lanjut tentang tag.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","Anda mungkin perlu <input type=\"button\" value=\"ekstrak game Anda\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> dan menganalisis skrip <b>ks</b> di dalamnya sebelum memulai proyek."],["Create Project","Buat Proyek"],["Play last build","Mainkan build terakhir"],["Extract TyranoBuilder","Ekstrak TyranoBuilder"],["Create playable package","Buat paket yang dapat dimainkan"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":false,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"relPath":"/addons/tyranoTrans/tyranoTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":45,"length":45,"percent":100},"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","Umum"],["Executable file location","Lokasi file eksekusi"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tPath ke file eksekusi aplikasi.\n\t\t\t"],["Field can not be empty!","Bidang tidak boleh kosong!"],["Service","Layanan"],["End Point","Titik Akhir"],["Auto translation service to use.","Layanan terjemahan otomatis yang akan digunakan."],["Target Language","Bahasa Target"],["The language to translate into","Bahasa untuk diterjemahkan"],["Source Language","Bahasa Sumber"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","Bahasa asli game. \"otomatis\" juga didukung untuk beberapa titik akhir, tetapi umumnya tidak direkomendasikan"],["Files","File"],["Directory","Direktori"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Direktori untuk mencari file terjemahan yang di-cache. Dapat menggunakan placeholder: {GameExeName}, {Lang}"],["Output File","File Output"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","File untuk menyisipkan terjemahan yang dihasilkan. Dapat menggunakan placeholder: {GameExeName}, {Lang}"],["Substitution File","File Substitusi"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","File yang berisi substitusi diterapkan sebelum terjemahan. Dapat menggunakan placeholder: {GameExeName}, {Lang}"],["Preprocessors File","File Preprosesor"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","File yang berisi preprosesor untuk diterapkan sebelum mengirim teks ke penerjemah. Dapat menggunakan placeholder: {GameExeName}, {Lang}"],["Text Frameworks","Kerangka Teks"],["Enable/Disable auto translation for Unity's text frameworks.","Aktifkan/Nonaktifkan terjemahan otomatis untuk kerangka teks Unity."],["Behaviour","Perilaku"],["Max Characters Per Translation","Maks Karakter Per Terjemahan"],["Max characters per text to translate. Max 2500.","Maks karakter per teks untuk diterjemahkan. Maks 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Apakah mengabaikan spasi, termasuk baris baru, dalam kunci dialog"],["Whether or not to ignore whitespace, including newlines, in NGUI","Apakah mengabaikan spasi, termasuk baris baru, dalam NGUI"],["Minimum Dialogue Chars","Min Karakter Dialog"],["The length of the text for it to be considered a dialogue","Panjang teks agar dianggap sebagai dialog"],["Force Split Text After Characters","Paksa Pisah Teks Setelah Karakter"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Pisah teks menjadi beberapa baris setelah teks terjemahan melebihi jumlah karakter ini. (0 berarti tidak dipisah)"],["Whether or not to copy hooked texts to clipboard","Apakah menyalin teks yang di-hook ke clipboard"],["MaxClipboardCopyCharacters","MaksKarakterSalinClipboard"],["Max number of characters to hook to clipboard at a time","Jumlah maks karakter untuk di-hook ke clipboard sekaligus"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Apakah plugin harus memberikan \"upaya terbaik\" dalam mengubah ukuran komponen UI setelah penerjemahan"],["Indicates whether batching of translations should be enabled for supported endpoints","Menunjukkan apakah pengelompokan terjemahan harus diaktifkan untuk titik akhir yang didukung"],["Indicates whether or not to use translations from the included static translation cache","Menunjukkan apakah akan menggunakan terjemahan dari cache terjemahan statis yang disertakan"],["Override Font","Ganti Font"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Mengganti font yang digunakan untuk teks saat memperbarui komponen teks. CATATAN: Hanya berfungsi untuk UGUI"],["Override Font TextMeshPro","Ganti Font TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Mengganti font yang digunakan untuk teks saat memperbarui komponen teks. CATATAN: Hanya berfungsi untuk TextMeshPro"],["Resize UI Line Spacing Scale","Skala Jarak Baris UI Ubah Ukuran"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","Nilai desimal yang harus digunakan untuk menskalakan jarak baris default selama pengubahan ukuran UI, contoh: 0.80. CATATAN: Hanya berfungsi untuk UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","Menunjukkan apakah perilaku pengubahan ukuran UI harus diterapkan ke semua komponen UI terlepas dari apakah mereka diterjemahkan."],["Ignore Text Starting With","Abaikan Teks yang Dimulai Dengan"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Menunjukkan bahwa plugin harus mengabaikan string apa pun yang dimulai dengan karakter tertentu. Ini adalah daftar yang dipisahkan oleh ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","Menunjukkan apakah akan mengaktifkan \"Mode Kompatibilitas Pengambil Teks\". Hanya harus diaktifkan jika diperlukan oleh game."],["GameLog Text Paths","Jalur Teks GameLog"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Menunjukkan jalur spesifik untuk objek game yang digunakan game sebagai \"komponen log\", di mana teks terus ditambahkan atau diawali. Membutuhkan pengetahuan ahli untuk menyiapkannya. Ini adalah daftar yang dipisahkan oleh ';'."],["Romaji Post Processing","Pemrosesan Pasca Romaji"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","Menunjukkan jenis pemrosesan pasca yang harus dilakukan pada teks romaji yang 'diterjemahkan'. Ini dapat penting dalam game tertentu karena font yang digunakan tidak mendukung berbagai diakritik dengan baik. Ini adalah daftar yang dipisahkan oleh ';'. Nilai yang mungkin: [\"HapusSemuaDiakritik\", \"GantiMakronDenganCircumflex\", \"HapusApostrof\"]"],["Translation Post Processing","Pemrosesan Pasca Terjemahan"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Menunjukkan jenis pemrosesan pasca yang harus dilakukan pada teks yang diterjemahkan (bukan romaji). Nilai yang mungkin: [\"HapusSemuaDiakritik\", \"GantiMakronDenganCircumflex\", \"HapusApostrof\", \"GantiKarakterLebar\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Menunjukkan apakah hasil pencarian regex harus dikeluarkan ke FileKeluaran yang ditentukan."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Menunjukkan apakah perbedaan spasi putih harus dikeluarkan ke OutputFile yang ditentukan."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Menunjukkan apakah hasil lengkap dari terjemahan yang dipisahkan regex harus dikeluarkan ke OutputFile yang ditentukan."],["Indicates that the plugin should generate translations without variables when using substitutions.","Menunjukkan bahwa plugin harus menghasilkan terjemahan tanpa variabel saat menggunakan substitusi."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Menunjukkan bahwa plugin harus menghasilkan terjemahan parsial untuk mendukung terjemahan teks saat \"bergulir masuk\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Menunjukkan bahwa plugin harus mem-parsing direktif 'TARC' dan membatasi terjemahan berdasarkan ini."],["Indicates the plugin should not print out success messages in relation to translations.","Menunjukkan bahwa plugin tidak boleh mencetak pesan keberhasilan terkait terjemahan."],["Blacklisted IMGUI Plugins","Plugin IMGUI yang Diblokir"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","Jika rakitan/kelas/metode jendela IMGUI mengandung salah satu string dalam daftar ini (tidak peka huruf besar-kecil), UI tersebut tidak akan diterjemahkan. Membutuhkan kait MonoMod. Ini adalah daftar yang dipisahkan oleh ';'"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Menunjukkan apakah teks yang dianggap oleh plugin sebagai tidak dapat diterjemahkan harus dikeluarkan ke OutputFile yang ditentukan."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Menunjukkan bahwa aturan untuk panggilan metode virtual harus diabaikan saat mencoba mengatur teks dari komponen teks. Mungkin dalam beberapa kasus membantu mengatur teks dari komponen yang keras kepala."],["Max Text Parser Recursion","Rekursi Parser Teks Maksimum"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Menunjukkan berapa tingkat rekursi yang diizinkan saat teks di-parsing sehingga dapat diterjemahkan dalam bagian yang berbeda. Ini dapat digunakan dengan regex pemisah dalam skenario lanjutan. Nilai default satu pada dasarnya berarti rekursi dinonaktifkan."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Akan memproses dan mendekode entitas html sebelum dikirim untuk diterjemahkan. Beberapa penerjemah akan gagal ketika entitas html dikirim."],["Will enable automated handling of rich text (text with markup).","Akan mengaktifkan penanganan otomatis teks kaya (teks dengan markup)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Menunjukkan apakah pesan log bermanfaat terkait penerjemah harus diaktifkan. Mungkin berguna saat menerjemahkan berdasarkan sumber daya yang dialihkan."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Menunjukkan bahwa plugin harus menggunakan kait MonoMod alih-alih kait harmony."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Menunjukkan bahwa plugin harus menginisialisasi jembatan detour harmony yang memungkinkan kait harmony bekerja di lingkungan di mana System.Reflection.Emit tidak ada (biasanya pengaturan seperti itu ditangani oleh pengelola plugin, jadi jangan gunakan saat menggunakan pengelola plugin)."],["Redirected Resource Detection Strategy","Strategi Deteksi Sumber Daya yang Dialihkan"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Menunjukkan apakah dan bagaimana plugin harus mencoba mengenali sumber daya yang dialihkan untuk mencegah terjemahan ganda."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Menunjukkan apakah plugin harus mengeluarkan teks yang melebihi <b>'Karakter Maksimum Per Terjemahan'</b> tanpa menerjemahkannya."],["Texture","Tekstur"],["Texture Directory","Direktori Tekstur"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Direktori untuk membuang tekstur, dan akar direktori untuk memuat gambar. Dapat menggunakan placeholder: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Menunjukkan apakah plugin akan mencoba mengganti gambar dalam game dengan yang dari direktori TextureDirectory."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Menunjukkan apakah plugin akan membuang tekstur yang mampu diganti ke TextureDirectory. Memiliki dampak kinerja yang signifikan."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","Menunjukkan apakah menyalakan/mematikan terjemahan dengan hotkey ALT+T juga akan mempengaruhi tekstur. Tidak dijamin bekerja untuk semua tekstur. Memiliki dampak kinerja yang signifikan."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Menunjukkan apakah plugin harus memindai tekstur saat pemuatan adegan. Ini memungkinkan plugin menemukan dan (mungkin) mengganti lebih banyak tekstur."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Menunjukkan apakah plugin harus mencoba mengaitkan SpriteRenderer. Ini adalah opsi terpisah karena SpriteRenderer sebenarnya tidak dapat dikaitkan dengan benar dan solusi yang diterapkan dapat berdampak teoritis pada kinerja dalam situasi tertentu."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Menunjukkan apakah tekstur yang tidak dimodifikasi harus dimuat. Modifikasi ditentukan berdasarkan hash dalam nama file. Hanya aktifkan ini untuk tujuan debugging karena kemungkinan menyebabkan keanehan."],["Texture Hash Generation Strategy","Strategi Pembuatan Hash Tekstur"],["Indicates how the mod identifies pictures through hashes.","Menunjukkan bagaimana mod mengidentifikasi gambar melalui hash."],["Duplicate Texture Names","Nama Tekstur Duplikat"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Menunjukkan nama tekstur spesifik yang diduplikasi dalam game. Daftar dipisahkan oleh ';'"],["Indicates if the plugin should detect duplicate texture names.","Menunjukkan apakah plugin harus mendeteksi nama tekstur duplikat."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Menunjukkan plugin harus menggunakan strategi berbeda untuk memuat gambar, yang mungkin relevan jika mesin game sudah tua."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Menunjukkan bahwa semua tekstur yang dimuat harus disimpan dalam memori untuk kinerja optimal. Nonaktifkan untuk mengurangi penggunaan memori."],["Resource Redirector","Pengalihan Sumber Daya"],["Preferred Storage Path","Jalur Penyimpanan Pilihan"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Menunjukkan penyimpanan pilihan untuk sumber daya yang dialihkan dalam kaitannya dengan Auto Translator. Dapat menggunakan placeholder: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","Menunjukkan apakah TextAssets harus dialihkan"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Menunjukkan apakah plugin harus mencatat ke konsol semua aset yang dimuat. Berguna untuk menentukan apa yang dapat dihubungkan"],["Indicates if translatable resources that are found should be dumped","Menunjukkan apakah sumber daya yang dapat diterjemahkan yang ditemukan harus dibuang"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","Ketika file berada dalam file ZIP di PreferredStoragePath, file-file ini diindeks dalam memori untuk menghindari pemeriksaan IO file saat memuatnya. Mengaktifkan opsi ini akan melakukan hal yang sama untuk file fisik"],["HTTP","HTTP"],["User Agent","Agen Pengguna"],["Override the user agent used by APIs requiring a user agent","Timpa agen pengguna yang digunakan oleh API yang memerlukan agen pengguna"],["Indiciates whether certificate validations for the .NET API should be disabled","Menunjukkan apakah validasi sertifikat untuk API .NET harus dinonaktifkan"],["Translation Aggregator","Agregator Terjemahan"],["Width","Lebar"],["The total width of the translation aggregator window","Total lebar jendela agregator terjemahan"],["Height","Tinggi"],["The width (per translator) of the translation aggregator window.","Lebar (per penerjemah) dari jendela agregator terjemahan."],["Enabled Translators","Penerjemah yang Diaktifkan"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","ID dari titik akhir terjemahan yang telah diaktifkan di jendela agregator terjemahan. Daftar dipisahkan oleh ';'"],["Google","Google"],["ServiceUrl","URL Layanan"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","OPSIONAL, dapat digunakan untuk mengarahkan permintaan API Google ke URL yang berbeda. Dapat digunakan untuk menghindari GFWoC"],["Google Legitimate","Google Sah"],["Google API Key","Kunci API Google"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","OPSIONAL, diperlukan jika GoogleTranslateLegitimate dikonfigurasi"],["Bing Legitimate","Bing Sah"],["OcpApim Subscription Key","Kunci Langganan OcpApim"],["OPTIONAL, needed if BingTranslateLegitimate is configured","OPSIONAL, diperlukan jika BingTranslateSah dikonfigurasi"],["Baidu","Baidu"],["Baidu App Id","ID Aplikasi Baidu"],["OPTIONAL, needed if BaiduTranslate is configured","OPSIONAL, diperlukan jika BaiduTranslate dikonfigurasi"],["BaiduAppSecret","Rahasia Aplikasi Baidu"],["Yandex","Yandex"],["Yandex API Key","Kunci API Yandex"],["OPTIONAL, needed if YandexTranslate is configured","OPSIONAL, diperlukan jika YandexTranslate dikonfigurasi"],["Watson","Watson"],["Url","Url"],["OPTIONAL, needed if WatsonTranslate is configured","OPSIONAL, diperlukan jika WatsonTranslate dikonfigurasi"],["Key","Kunci"],["DeepL","DeepL"],["MinDelay","Penundaan Minimum"],["OPTIONAL, used for throttling DeepL","OPSIONAL, digunakan untuk membatasi DeepL"],["MaxDelay","Penundaan Maksimum"],["DeepL Legitimate","DeepL Sah"],["OPTIONAL, required if DeepLLegitimate is configured","OPSIONAL, diperlukan jika DeepLSah dikonfigurasi"],["Custom","Kustom"],["Optional, needed if Custom Translated is configured","Opsional, diperlukan jika Terjemahan Kustom dikonfigurasi"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","Jalur Instalasi"],["Optional, needed if Lec Power Translator 15 is configured","Opsional, diperlukan jika Lec Power Translator 15 dikonfigurasi"],["Debug","Debug"],["Enables the console. Do not enable if other plugins (managers) handles this","Mengaktifkan konsol. Jangan aktifkan jika plugin (manajer) lain menanganinya"],["Enables extra logging for debugging purposes","Mengaktifkan pencatatan ekstra untuk tujuan debugging"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","Jalur Instalasi ezTrans."],["Migrations","Migrasi"],["Used to enable automatic migrations of this configuration file","Digunakan untuk mengaktifkan migrasi otomatis dari file konfigurasi ini"],["Tag","Tag"],["Tag representing the last version this plugin was executed under. Do not edit","Tag yang mewakili versi terakhir plugin ini dijalankan. Jangan edit"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":false,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"relPath":"/addons/unityTrans/configEdit.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","XUnity Translator diperlukan untuk melakukan tindakan ini\nHarap instal melalui Penginstal Aplikasi Pihak Ketiga!"],["XUnity.AutoTranslator is found!","XUnity.AutoTranslator ditemukan!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++ mendeteksi bahwa XUnity.AutoTranslator sudah terinstal. Translator++ akan menggunakan data terjemahan yang ada untuk memulai proyek terjemahan baru."],["XUnity.AutoTranslator is not found!","XUnity.AutoTranslator tidak ditemukan!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","Wizard akan memandu Anda untuk menginstal XUnity.AutoTranslator ke dalam game."],["Next","Selanjutnya"],["Given path: ","Path yang diberikan: "],["\nis not an Unity game. Do you still want to proceed?","\nbukan game Unity. Apakah Anda masih ingin melanjutkan?"],["Patch successfully installed!\r\n","Patch berhasil diinstal!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","Konfigurasi akan dibuat saat Anda memainkan game untuk pertama kalinya.\r\n"],["Open the game now?","Buka game sekarang?"],["Finish","Selesai"],["Update current project?","Perbarui proyek saat ini?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":false,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"relPath":"/addons/unityTrans/unityTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","Jumlah baris maksimum dalam kotak pesan."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","Nilai default adalah 4. Ketik 0 untuk menonaktifkan fitur ini. Jika jumlah baris dalam kotak pesan lebih besar dari angka ini, Translator++ akan membuat kotak pesan baru untuk mencegah teks meluap dari kotak."],["Use shell copy if possible","Gunakan salinan shell jika memungkinkan"],["Use shell copy instead of native NodeJS copy handler.","Gunakan salinan shell alih-alih penangan salinan NodeJS asli."],["Use shell copy","Gunakan salinan shell"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","Editor WRPGE tidak diinstal\r\nHarap instal dari menu T++ > Penginstal aplikasi pihak ketiga\r\n\r\nBuka penginstal aplikasi pihak ketiga sekarang?"],["Unable to determina WRPGE path.","Tidak dapat menentukan path WRPGE."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++ akan menginstal editor WRPGE di folder tujuan.\r\nLanjutkan?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Path dev tidak ditentukan.\nAnda harus menyuntikkan game Anda sekali untuk menghasilkan path dev."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","Terjemahkan game Wolf RPG hingga ver. 3.330 dengan pustaka WolfJs. Parser Wolf RPG default untuk Translator++."],["Wolf RPG Editor games","Game Wolf RPG Editor"],["Parsing Wolf RPG Game with","Mengurai Game Wolf RPG dengan"],["Wolf RPG Editor game","Game Wolf RPG Editor"],["Select the game's executable file","Pilih file eksekutif game"],["Engine version","Versi mesin"],["Detected WolfRPG Engine version of the selected game","Versi mesin WolfRPG yang terdeteksi dari game yang dipilih"],["Heads up!\r\n","Perhatian!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nsepertinya bukan file eksekutif Wolf RPG!\r\nApakah Anda yakin ingin memulai Proyek Wolf RPG dari titik masuk ini?"],["Create a new project","Buat proyek baru"],["Please specify a game to be processed!","Harap tentukan game yang akan diproses!"],["Set dev path. Path to the directory of the translated game.","Atur jalur dev. Jalur ke direktori game yang diterjemahkan."],["Play last build","Mainkan build terakhir"],["Open editor","Buka editor"],["Open Wolf RPG Editor online manual","Buka manual online Wolf RPG Editor"],["Open Wolf RPG Editor english manual","Buka manual bahasa Inggris Wolf RPG Editor"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","Tidak dapat menemukan file manual.\nHarap instal Wolf RPG Editor melalui penginstal aplikasi pihak ketiga."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":false,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"relPath":"/addons/wolfJs/wolfJs.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","Mulai terjemahan dari dokumen mirip XML. Mendukung format XML dan HTML."],["Create project","Buat proyek"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":false,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"relPath":"/addons/xmlTrans/xml.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","Penerjemah mesin YU-RIS"],["Checking up requirements...","Memeriksa persyaratan..."],["Create a new translation project from YU-RIS visual novel engine","Buat proyek terjemahan baru dari mesin novel visual YU-RIS"],["Next","Selanjutnya"],["Select YU-RIS game","Pilih game YU-RIS"],["Select the game's executable file","Pilih file eksekutif game"],["Engine version","Versi mesin"],["Detected YU-RIS version of the selected game","Versi YU-RIS terdeteksi dari game yang dipilih"],["Create a new project","Buat proyek baru"],["Invalid target game :","Target game tidak valid:"],["Source material do not match the current translation project!","Bahan sumber tidak cocok dengan proyek terjemahan saat ini!"],["Select the repack method.","Pilih metode repack."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>Repack ke file YPF asli</b><br />Akan repack terjemahan ke paket asli. Mungkin memerlukan waktu lebih lama untuk mengekstrak paket asli, menambal dengan terjemahan, dan repack lagi.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>Repack sebagai file patch YPF</b><br>Akan repack terjemahan sebagai file patch terpisah (misalnya update9.ypf). Dengan cara ini, memungkinkan untuk menerjemahkan game tanpa memodifikasi file ypf asli. Gabungkan dengan opsi <b>Jangan salin bahan, hanya injeksi terjemahan</b> di Copy material untuk proses patching yang lebih cepat.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","Versi repack target harus sesuai dengan versi game Anda. Masukkan versi mayor dan minor dipisahkan dengan titik. Contoh: <b>0.466</b>. Secara default, Translator++ akan mendeteksi versi mesin saat Anda membuat proyek."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":false,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"relPath":"/addons/yurisParser/YurisParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","Pembuat Formulir"],["Run","Jalankan"],["New Project (ctrl+n)","Proyek Baru (ctrl+n)"],["Open (ctrl+o)","Buka (ctrl+o)"],["Save file (ctrl+s)","Simpan file (ctrl+s)"],["Save As (ctrl+shift+s)","Simpan Sebagai (ctrl+shift+s)"],["Open debugger (F12)","Buka debugger (F12)"],["Help","Bantuan"],["Select file in the current workspace","Pilih file di ruang kerja saat ini"],["file path","jalur file"],["Create shortcut of the current script","Buat pintasan skrip saat ini"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":false,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"relPath":"/automationEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/find.html":{"data":[["Find","Temukan"],["Replace","Ganti"],["Put","Masukkan"],["Target","Target"],["Grid","Grid"],["Context","Konteks"],["Tag","Tag"],["Comment","Komentar"],["Untranslated rows","Baris yang belum diterjemahkan"],["Refine","Perbaiki"],["Case sensitive","Sensitif huruf besar/kecil"],["Transpile \\r\\n\\t","Transpile \\r\\n\\t"],["RegExp","RegExp"],["All files","Semua file"],["Select All Columns","Pilih Semua Kolom"],["Find all string above and replace with :","Temukan semua string di atas dan ganti dengan:"],["Original text:","Teks asli:"],["Text to put :","Teks untuk dimasukkan:"],["into: ","ke dalam:"],["Search all files","Cari semua file"],["Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)","Ketik kata kunci lalu tekan enter. Anda dapat menggunakan pola glob (misalnya: *.png)"],["Drag to select, Shift+Drag to unselect","Seret untuk memilih, Shift+Seret untuk membatalkan pilihan"],["Select target column","Pilih kolom target"],["A line in the original text to find. Press alt+enter to add a new line.","Sebaris teks asli untuk dicari. Tekan alt+enter untuk menambahkan baris baru."],["Translation","Terjemahan"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":false,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"relPath":"/find.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":25,"length":25,"percent":100},"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","Tidak dapat menemukan file terkait dengan data"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Untuk memperbaikinya, perbaiki bidang <b>Lokasi bahan mentah</b> di <a href=\"#\" class=\"openProjectProperties\">Properti proyek</a>"],["Copy path to clipboard","Salin jalur ke papan klip"],["Path has been copied to clipboard.","Jalur telah disalin ke papan klip."],["Open folder","Buka folder"],["Open with external application","Buka dengan aplikasi eksternal"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","Buka dengan..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":false,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"relPath":"/js/RawViewer.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~gunakan terjemahan default~"],["Column","Kolom"],["Do you want to delete all context translation on the currently selected row?","Apakah Anda ingin menghapus semua terjemahan konteks pada baris yang dipilih saat ini?"],["Do you want to delete all translation on the currently active row?","Apakah Anda ingin menghapus semua terjemahan pada baris yang aktif saat ini?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":false,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"relPath":"/js/TranslationByContext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","tipe addonObj tidak valid"],["invalid type addonObj.addons","tipe addonObj.addons tidak valid"],["You are not eligible to get this addon","Anda tidak memenuhi syarat untuk mendapatkan addon ini"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":false,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"relPath":"/js/addon.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Anda harus menyimpan proyek saat ini terlebih dahulu sebelum membuat pintasan ke Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Developer dari Translator++. Anda dapat beralih ke versi Developer dengan menggunakan Basic Utilities -> Change Core NWJS."]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/automationEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/find.js":{"data":[["Action","Aksi"],["Append tags","Tambahkan tag"],["Remove tags","Hapus tag"],["Set tags","Atur tag"],["Do nothing","Tidak melakukan apa-apa"],["Close","Tutup"],["Proceed","Lanjutkan"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","Kata kunci terlalu pendek!\nApakah Anda mencoba mencari semua baris? Coba gunakan tanda bintang '*' sebagai kata kunci."],["Found nothing!<br />Don't forget to set the Target search field.","Tidak menemukan apa pun!<br />Jangan lupa untuk mengatur bidang pencarian Target."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","Tidak menemukan apa pun untuk diganti!<br />Fungsi penggantian tidak mengganti apa pun pada kolom kunci."],["Replace '","Ganti '"],["' with '","' dengan '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'?\r\nKami belum membuat fungsi undo untuk hal ini!\nApakah Anda yakin ingin melanjutkan?"],["click to go","klik untuk pergi"],["This will replace any translation found in target colum,\nAre you sure?","Ini akan menggantikan terjemahan apa pun yang ditemukan di kolom target,\nApakah Anda yakin?"],["Keyword too short!","Kata kunci terlalu pendek!"],["Not found!","Tidak ditemukan!"],["Are you sure want to execute the following script?","Apakah Anda yakin ingin menjalankan skrip berikut?"],["For ","Untuk "],[" selected item(s)?"," item yang dipilih?"],[" Select all"," Pilih semua"],[" Invert selection"," Balik pilihan"],[" Clear selection"," Hapus pilihan"],[" Set Red tag"," Atur tag Merah"],[" Set Yellow tag"," Atur tag Kuning"],[" Set Green tag"," Atur tag Hijau"],[" Set Blue tag"," Atur tag Biru"],[" Set Gold tag"," Atur tag Emas"],[" More tags..."," Tag lainnya..."],[" Clear tags"," Hapus tag"],[" Create Automation"," Buat Otomasi"],[" Run Automation"," Jalankan Otomasi"],[" Clear Automation","Hapus Otomasi"],["Are you sure want to clear all quick launch scripts?","Apakah Anda yakin ingin menghapus semua skrip peluncur cepat?"],[" Clear translation","Hapus terjemahan"],["Do you want to clear translations of the selected items?","Apakah Anda ingin menghapus terjemahan dari item yang dipilih?"],[" Delete rows","Hapus baris"],["Do you want to remove selected rows?\nYou can not undo this action!","Apakah Anda ingin menghapus baris yang dipilih?\nTindakan ini tidak dapat dibatalkan!"],[" With selection ...","Dengan pilihan ..."],["Always on top","Selalu di atas"],["Default","Bawaan"],["Blur opacity","Opasitas kabur"],["Type regex with the modifier","Ketik regex dengan pengubah"],["Use $n to replace a group. e.g. $1","Gunakan $n untuk mengganti grup. misalnya $1"],["Find","Cari"],["Replace","Ganti"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":false,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"relPath":"/js/find.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":46,"percent":100},"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","Sembunyikan kata sandi"],["Show password","Tampilkan kata sandi"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":false,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"relPath":"/js/jsonform.ext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","Beberapa konfigurasi memerlukan restart aplikasi untuk berlaku.\nHarap simpan pekerjaan Anda, dan restart Translator++."],["Pleae select the name for your configuration.","Harap pilih nama untuk konfigurasi Anda."],["Translator Engine configuration","Konfigurasi mesin penerjemah"],["Translator engine version.","Versi mesin penerjemah."],["By.","Oleh."],["No option for this engine","Tidak ada opsi untuk mesin ini"],["License","Lisensi"],["Can not disable this addon","Tidak dapat menonaktifkan addon ini"],["Requirements","Persyaratan"],["What is this?","Apa ini?"],["Uninstall","Hapus instalasi"],["Update","Perbarui"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","Addon berhasil diinstal.\r\nTranslator++ mungkin perlu dimulai ulang agar beberapa addon dapat berfungsi."],["WARNING!\n","PERINGATAN!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","Add-on ini telah ditandai sebagai \"perubahan parser\". Proyek lama Anda yang terkait dengan add-on ini mungkin tidak lagi berfungsi seperti yang diharapkan. Disarankan untuk mencadangkan proyek Anda sebelum menginstal add-on ini.\nAnda dapat mengimpor terjemahan yang ada ke dalam proyek yang baru dibuat.\n\nApakah Anda ingin menginstal "],["Do you want to install ","Apakah Anda ingin menginstal "],["Add-on","Add-on"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","berhasil diinstal.\r\nTranslator++ mungkin perlu dimulai ulang agar beberapa addon dapat berfungsi."],["Add-on version.","Versi add-on."],["No option for this add-on","Tidak ada opsi untuk add-on ini"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++ akan menulis registry Windows.\r\nApakah Anda yakin?"],["Error parsing patterns:","Kesalahan dalam mengurai pola:"],["Do you really want to clear the custom escaper?","Apakah Anda benar-benar ingin menghapus escaper kustom?"],["Do you really want to reset the custom escaper?","Apakah Anda benar-benar ingin mengatur ulang escaper kustom?"],["You are currently on the latest version.\nDo you still want to update?","Anda saat ini menggunakan versi terbaru.\nApakah Anda masih ingin memperbarui?"],["This option will open your default browser to login.\nDo you want to continue?","Opsi ini akan membuka browser default Anda untuk login.\nApakah Anda ingin melanjutkan?"],["Login with Browser","Login dengan Browser"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","Browser Anda telah dibuka ke <b>dreamsavior.net/gettoken/</b>.<br>Login akan selesai secara otomatis setelah Anda login.<br><br>Jika login otomatis tidak berfungsi, salin token Anda dari halaman tersebut dan tempel di bawah ini:"],["There is no default translator selected.\nChange the default translator to Google!","Tidak ada penerjemah default yang dipilih.\nUbah penerjemah default ke Google!"],["Change Stagging Path to :","Ubah Jalur Stagging ke:"],["Move the content of current Stagging Path into the new one?","Pindahkan konten dari Jalur Stagging saat ini ke yang baru?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","Addon(s) telah diinstal.\nTranslator++ perlu dimulai ulang untuk berfungsi."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","Apakah Anda benar-benar ingin menghapus semua pengaturan dan mengatur ulang Translator++ ke default?\nHarap dicatat bahwa tindakan ini tidak dapat dibatalkan.\nHarap cadangkan proyek Anda sebelum melanjutkan."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","Translator++ mungkin tidak berfungsi normal jika Anda tidak memperbaiki kesalahan.\nApakah Anda ingin menutup jendela Opsi?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":false,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"relPath":"/js/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Anda harus menyimpan proyek saat ini terlebih dahulu sebelum membuat pintasan ke Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Developer Translator++. Anda dapat beralih ke versi Developer dengan menggunakan Utilitas Dasar -> Ubah Core NWJS."],[null,null,null,null,null]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/scriptEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>Tidak dapat menjalankan PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ memerlukan PHP CLI untuk menjalankan beberapa prosedur wajib.<br />\n\t\t\t\tKesalahan ini biasanya terjadi karena komputer Anda <b>tidak diinstal dengan <a href=\"http://dreamsavior.net/download/#TPPSysreq\">versi yang benar dari Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Harap instal <a href=\"http://dreamsavior.net/download/#TPPSysreq\">runtime yang diperlukan</a>.</li>\n\t\t\t\t\t\t<li>Dan harap pindahkan direktori instalasi Translator++ ke folder lain jika Anda telah menginstal semua runtime dan masih mengalami kesalahan ini.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tHarap periksa <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>dokumentasi</a> untuk informasi lebih lanjut tentang gejala ini."],["Initialization Error!","Kesalahan Inisialisasi!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":false,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"relPath":"/js/sys.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/trans.js":{"data":[["Original Text","Teks Asli"],["Initial","Awal"],["Machine translation","Terjemahan mesin"],["Better translation","Terjemahan lebih baik"],["Best translation","Terjemahan terbaik"],["Loading","Mem