il"],["tid/69811/type/StringLiteral"],["tid/70151/type/StringLiteral"],["tid/74815/type/StringLiteral"],["tid/74898/type/StringLiteral"],["tid/75985/type/StringLiteral"],["tid/77908/type/StringLiteral"]],"basename":"ui.js","dirname":"/js","extension":".js","filename":"ui.js","path":"/js/ui.js","indexIsBuilt":false,"indexIds":{"`You cannot close the application at this moment, reason: \\n${":0,"}`":1,"Do you really want to exit Translator++?\nAll unsaved changes will be discarded!":2,"Trans file":3,"Translator++ Project Package (TPP) file":4,"Select all":5,"Select none":6,"Invert":7,"Match destination selection":8,"use mouse drag to do bulk selection":9,"Invalid trans data":10,"Inject / Apply translation":11,"Inject / Apply translation to all":12,"Cancel":13,"Apply Translation":14,"Target path cannot be a parent or child of the source material's path.\nPlease select another path.":15,"Help":16,"Import":17,"Revert to origin data":18,"Select target directory.":19,"The existing files will be overwritten!":20,"Process":21,"Path to the directory can not be empty!":22,"Invalid directory:":23,"Rebuild translation table from this cache":24,"Create new project":25,"-nothing-":26,"Ok":27,"No action selected, are you sure?":28,"No context's keyword specified!":29,"Remove context containing keyword :\n":30,"\nfrom selected files?":31,"Remove every rows except rows that has a context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"relPath":"/js/ui.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","Anda dapat melihat informasi lebih rinci di log konsol (F12)"],["Close","Tutup"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","Anda dapat melihat informasi lebih detail di log konsol (F12)"],["Close","Tutup"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.parts.js":{"data":[["Form","Formulir"],["Cancel","Batal"],["Ok","Oke"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/jsoneditor.html":{"data":[["Remove note","Hapus catatan"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/login.html":{"data":[["working","sedang bekerja"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/note.html":{"data":[["Remove note","Hapus catatan"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/options.html":{"data":[["Click to login","Klik untuk masuk"],["Translator &amp; Language","Penerjemah &amp; Bahasa"],["Proofreader","Pemeriksa"],["Assistant","Asisten"],["General","Umum"],["Preferences","Preferensi"],["Add-ons","Pengaya"],["About","Tentang"],["User Information","Informasi Pengguna"],["Login to your Patreon account to get access to the latest features and updates.","Masuk ke akun Patreon Anda untuk mendapatkan akses ke fitur dan pembaruan terbaru."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> Masuk"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> Masuk dengan browser"],["Welcome,","Selamat datang,"],["Name","Nama"],["Email","Email"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Level <div class=\"infoHeadNote\">(Langganan saat ini dalam sen USD)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Poin <div class=\"infoHeadNote\">(Total langganan seumur hidup dalam sen USD)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","Status pembayaran <div class=\"infoHeadNote\">(Status pembayaran saat ini)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Jangan panik!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>Dan silakan baca informasi berikut.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Bendera ini menunjukkan bahwa Patreon belum berhasil menerima dana untuk sumbangan Anda. Normal bagi sistem pembayaran mengalami penundaan. Bergantung pada metode pembayaran dan negara asal Anda, penundaan dapat terjadi hingga 24 jam.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Selama penundaan ini, Anda mungkin melihat debit dari kartu kredit Anda. Jangan khawatir—Patreon akan mencoba secara berkala untuk memeriksa apakah mereka telah menerima pembayaran Anda. Ini biasanya terselesaikan dalam 24 jam.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Jika masalah berlanjut melebihi periode ini, silakan posting di thread <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">masalah-akun</a> di server Translator++ di Discord. Saya akan membantu Anda sebisa mungkin.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Harap pahami bahwa untuk mencegah penipuan, <b><span class=\"userInfoPoints\">poin</span> dan <span class=\"userInfoLevel\">Level</span> tidak akan dihitung sampai pembayaran Anda berhasil diterima oleh Patreon</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">Jangan panik!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","Bendera ini menunjukkan bahwa Patreon belum berhasil menerima dana untuk sumbangan Anda. Normal bagi sistem pembayaran mengalami penundaan. Bergantung pada metode pembayaran dan negara asal Anda, penundaan dapat terjadi hingga 24 jam."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","Selama penundaan ini, Anda mungkin melihat debit dari kartu kredit Anda. Jangan khawatir—Patreon akan mencoba secara berkala untuk memeriksa apakah mereka telah menerima pembayaran Anda. Ini biasanya terselesaikan dalam 24 jam."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","Jika masalah berlanjut melebihi periode ini, silakan posting di thread <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">masalah-akun</a> di server Translator++ di Discord. Saya akan membantu Anda sebisa mungkin."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","Harap pahami bahwa untuk mencegah penipuan, <b><span class=\"userInfoPoints\">poin</span> dan <span class=\"userInfoLevel\">Level</span> tidak akan dihitung sampai pembayaran Anda berhasil diterima oleh Patreon</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> Keluar"],["Primary Translator","Penerjemah Utama"],["Default Translator Engine","Mesin Penerjemah Bawaan"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tMesin Penerjemah ini akan digunakan saat Anda menekan <span class=\"keyboardHint\">Ctrl+g</span> pada sel yang dipilih untuk <strong>m</strong>enghasilkan terjemahan di sel yang dipilih.\n\t\t\t\t"],["Default Language","Bahasa Bawaan"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\tPengaturan bahasa bawaan di seluruh proyek!<br>\n\t\t\t\tPengaturan di properti proyek akan menggantikan nilai ini.\n\t\t\t"],["Default Source Language","Bahasa Sumber Bawaan"],["Default Target Language","Bahasa Target Default"],["Custom escape","Escape Kustom"],["Patterns","Pola"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tSemua kata yang cocok dengan pola di bawah ini tidak akan diterjemahkan oleh penerjemah mesin. \n\t\t\t\t\t\tBagian ini cocok untuk menyembunyikan tag dan skrip dari mesin penerjemah. <br>\n\t\t\t\t\t\tSetiap entri adalah ekspresi reguler, fungsi, atau literal string JavaScript yang valid, dipisahkan dengan <b>koma</b>.<br>\n\t\t\t\t\t\tEscape kustom hanya bekerja untuk <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">algoritma escape</a> yang didukung.\n\t\t\t\t\t\t<b>Petunjuk:</b> Anda juga dapat meminta ChatGPT untuk membuatkan ekspresi reguler. <br>\n\t\t\t\t\t\tHarap tulis pola regex beserta modifikatornya.<br>\n\t\t\t\t\t\tcontoh:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","Penguji"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tTempel teks Anda di sini untuk memeriksa pola.\n\t\t\t\t\t\tSemua pola yang cocok akan disorot.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>Dalam Pembangunan</h2>\n\t\t\t\t<p>Area ini akan menjadi tempat pengaturan dan opsi pemeriksa otomatis dikonfigurasi.</p>\n\t\t\t"],["AI Assistant","Asisten AI"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hai! Saya MIRAI, asisten AI Anda untuk Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Cukup klik ikon saya <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> di menu Beranda untuk mengobrol dengan saya. Saya dapat membantu Anda dengan:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Peningkatan dan saran terjemahan</li>\n\t\t\t\t\t\t\t<li>Pemeriksaan dan pengecekan kualitas</li>\n\t\t\t\t\t\t\t<li>Menyiapkan alur kerja terjemahan Anda</li>\n\t\t\t\t\t\t\t<li>Membuat skrip otomatisasi</li>\n\t\t\t\t\t\t\t<li>Dan masih banyak lagi!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Mari kita buat pekerjaan terjemahan Anda lebih mudah dan efisien bersama!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. Saya masih baru, jadi harap bersabar dengan saya.🙇‍♀️ Tapi saya belajar dan berkembang setiap hari!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","Konfigurasi AI"],["Model Endpoint","Endpoint Model"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","URL endpoint API untuk model AI Anda. Contoh: https://api.openai.com/v1/chat/completions"],["API Key","Kunci API"],["Your API key for authenticating with the AI service. This will be stored securely.","Kunci API Anda untuk autentikasi dengan layanan AI. Ini akan disimpan dengan aman."],["Model Name","Nama Model"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","Pilih atau masukkan model AI yang akan digunakan. Model dengan dukungan alat direkomendasikan untuk hasil terbaik."],["File Association","Asosiasi Berkas"],["Extension","Ekstensi"],["Associate","Asosiasikan"],["Set All","Atur Semua"],["Unset All","Hapus Semua"],["Apply","Terapkan"],["Update","Perbarui"],["Auto update","Perbarui otomatis"],["Automatically update Translator++ if possible.","Perbarui Translator++ secara otomatis jika memungkinkan."],["Allow reinstall the same version","Izinkan instal ulang versi yang sama"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Izinkan Translator++ untuk menginstal ulang versi yang sama yang sudah terpasang. Harap jaga opsi ini dinonaktifkan setelah Anda menginstal pembaruan, terutama ketika pengaturan <b>Perbarui otomatis</b> Anda aktif. Jika tidak, Translator++ Anda akan terus memperbarui dirinya sendiri setiap kali Anda membuka program."],["Use default browser to login","Gunakan browser default untuk login"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","Gunakan browser default sistem tepercaya Anda untuk login ke akun Patreon Anda. Kecuali opsi ini dicentang, browser tertanam Translator++ akan digunakan."],["Multi threading","Multi threading"],["Number of thread","Jumlah thread"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","Jumlah proses anak yang dibuka secara bersamaan.<br>\n\t\t\t\t\t\t\t0 = nonaktifkan multi threading. Semua proses akan dilakukan oleh proses renderer.<br>\n\t\t\t\t\t\t\tJumlah optimal biasanya adalah jumlah inti fisik Anda - 1.\n\t\t\t\t\t\t"],["Backup","Cadangan"],["Enable backup","Aktifkan cadangan"],["Automatically create backup every time you save your project.","Buat cadangan secara otomatis setiap kali Anda menyimpan proyek Anda."],["Backup level history","Riwayat level cadangan"],["How many history of backup do you want to keep?","Berapa banyak riwayat cadangan yang ingin Anda simpan?"],["Log &amp; Debugging","Log &amp; Debugging"],["Log to file","Log ke file"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","Log ke file alih-alih jendela konsol default.<br>Ini berguna jika Anda ingin debug Translator++ dan Anda tidak memiliki akses ke jendela konsol. Mengaktifkan opsi ini akan sedikit memengaruhi kinerja. Jadi, Anda ingin opsi ini dimatikan sepanjang waktu, kecuali saat Anda sedang debug atau melaporkan masalah.<br>Log disimpan di folder data/logs/."],["Truncate log file each session","Potong file log setiap sesi"],["When checked your log file will be truncated each time you re open the application.","Ketika dicentang, file log Anda akan dipotong setiap kali Anda membuka kembali aplikasi."],["Application Settings","Pengaturan Aplikasi"],["Enable remote debugging","Aktifkan debug jarak jauh"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","Mengaktifkan protokol debug jarak jauh Chrome DevTools di port 9222. Ini memungkinkan Anda memeriksa dan mendebug Translator++ menggunakan browser eksternal dengan menavigasi ke <code>chrome://inspect</code>. Flag ini menambahkan <code>--remote-debugging-port=9222</code> ke argumen startup aplikasi. Restart diperlukan untuk menerapkan perubahan."],["Disable GPU","Nonaktifkan GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","Menonaktifkan akselerasi GPU perangkat keras. Ini berguna jika Anda mengalami masalah visual, crash, atau masalah rendering pada perangkat keras atau driver grafis tertentu. Flag ini menambahkan <code>--disable-gpu</code> ke argumen startup aplikasi. Restart diperlukan untuk menerapkan perubahan."],["Dangerous Area","Area Berbahaya"],["Interface Language","Bahasa Antarmuka"],["UI Language","Bahasa UI"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","Atur bahasa antarmuka pengguna. Anda dapat membuat pelokalan sendiri jika Translator++ tidak tersedia dalam bahasa Anda. Data bahasa terletak di dalam folder www/lang."],["Spell checker Language","Bahasa Pemeriksa Ejaan"],["Set the default spell checker language.","Atur bahasa pemeriksa ejaan default."],["Environment Variables","Variabel Lingkungan"],["Staging Directory","Direktori Staging"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","Direktori Staging adalah cache keras dari proyek yang sedang dikerjakan. Sebagian data dari bahan mentah disalin ke direktori ini untuk diakses oleh skrip interpreter."],["Project creation","Pembuatan Proyek"],["Auto Load Common Reference","Muat Referensi Umum Otomatis"],["Auto load common reference from .trans file.","Muat referensi umum otomatis dari file .trans."],["Project settings","Pengaturan Proyek"],["Progress Column Indices","Indeks Kolom Kemajuan"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","Di sini, Anda dapat menentukan kolom mana yang akan disertakan dalam perhitungan kemajuan proyek.\n\t\t\t\t\t\t\t<br>Indeks kolom adalah bilangan bulat berbasis nol, di mana kolom paling kiri adalah 0.\n\t\t\t\t\t\t\t<br>Gunakan koma untuk menentukan beberapa kolom. Contoh: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Kosong</b>. Jika dibiarkan kosong, Translator++ akan menghitung kemajuan dari semua kolom yang tersedia.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>Aktifkan/Nonaktifkan"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>Instal"],["Install from a package","Instal dari paket"],["Visit our website &amp; documentation : ","Kunjungi situs web &amp; dokumentasi kami : "],["Fork Translator++ at : ","Fork Translator++ di : "],["Support Translator++ at : ","Dukung Translator++ di : "],["Join our discord channel at : ","Bergabunglah dengan saluran discord kami di : "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) Jika Anda adalah patron, Anda harus <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">tautkan akun discord Anda pada profil Patreon Anda</a>. Anda akan diundang secara otomatis, dan ada manfaat yang menunggu Anda!"],["Version Info","Info Versi"],["Last checked at : ","Terakhir diperiksa pada : "],["Check now!","Periksa sekarang!"],["You have a pending update","Anda memiliki pembaruan tertunda"],["Update now","Perbarui sekarang"],["Your Translator++ is up to date 😃.","Translator++ Anda sudah mutakhir 😃."],["Architecture","Arsitektur"],["License","Lisensi"],["Click here to read the license.","Klik di sini untuk membaca lisensi."],["Credits","Kredit"],["Localization","Lokalisasi"],["About Third Party Software","Tentang Perangkat Lunak Pihak Ketiga"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tPerangkat lunak ini menggunakan perangkat lunak pihak ketiga yang terletak di /3rdParty. Perangkat lunak pihak ketiga ini memiliki lisensi masing-masing dan \n\t\t\t\tdimasukkan semata-mata untuk kemudahan penggunaan dan \n\t\t\t\tdisediakan \"sebagaimana adanya\" tanpa jaminan apa pun, baik tersurat maupun tersirat dan perangkat lunak tersebut digunakan atas risiko Anda sendiri.\n\t\t\t\t"],["Special Thanks","Terima Kasih Khusus"],["Want to explicitly support Translator++ by putting your name on this section?","Ingin mendukung Translator++ secara eksplisit dengan menempatkan nama Anda di bagian ini?"],["Click here to learn more about how to do that!","Klik di sini untuk mempelajari lebih lanjut cara melakukannya!"],["Changelog","Catatan Perubahan"],["Feeds","Umpan"],["Click connect button, to connect translator with Translator++ table","Klik tombol sambung, untuk menghubungkan penerjemah dengan tabel Translator++"],["working","bekerja"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Tingkat Patreon/Sumbangan Anda bulan ini dalam sen (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","Poin/Sumbangan seumur hidup+bonus Anda dalam sen (1 USD = 100 pts)"],["Filter...","Filter..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":124,"length":124,"percent":100},"parameters":[]},"/scriptEditor.html":{"data":[["Run","Jalankan"],["New Project (ctrl+n)","Proyek Baru (ctrl+n)"],["Open (ctrl+o)","Buka (ctrl+o)"],["Save file (ctrl+s)","Simpan berkas (ctrl+s)"],["Save As (ctrl+shift+s)","Simpan Sebagai (ctrl+shift+s)"],["Open debugger (F12)","Buka debugger (F12)"],["Help","Bantuan"],["Select file in the current workspace","Pilih file di ruang kerja saat ini"],["file path","jalur file"],["Create shortcut of the current script","Buat pintasan dari skrip saat ini"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/tableEditor.html":{"data":[["Reset","Atur ulang"],["Clear","Hapus"],["Search","Cari"],["Help","Bantuan"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/trans.html":{"data":[["Start","Mulai"],["Home","Beranda"],["Translator","Penerjemah"],["Objects","Objek"],["Live translation","Terjemahan langsung"],["Original","Asli"],["Raw","Mentah"],["Row Properties","Properti Baris"],["Default translation","Terjemahan bawaan"],["Context translation","Terjemahan konteks"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\tJalur <a class=\"problemPath\"></a> tidak dapat diakses oleh interpreter PHP.<br>\n\t\tHarap ubah nama jalur dan gunakan hanya penamaan alfanumerik.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>Lokasi</span>"],["File :","File :"],["Row ID :","ID Baris :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>Konteks</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>Aktor</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>Teks Kunci</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>Terjemahan Terbaik</span>"],["File ID","ID Berkas"],["Path","Lokasi"],["Original Format","Format Asli"],["Data Length","Panjang Data"],["Translated","Diterjemahkan"],["General","Umum"],["Language","Bahasa"],["Staging","Staging"],["Stats","Statistik"],["Advanced","Lanjutan"],["Info","Info"],["Title","Judul"],["File Location","Lokasi Berkas"],["Project ID","ID Proyek"],["Built on","Dibangun pada"],["Editor Name","Nama Editor"],["Editor Version","Versi Editor"],["Engine","Mesin"],["Parser","Parser"],["Parser version","Versi Parser"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","Lokasi Bahan Mentah <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Lokasi materi asli. Jangan mengubah apa pun di dalam folder ini.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Jalur tidak valid.<br>Beberapa fitur akan dinonaktifkan hingga diperbaiki."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","Lokasi Materi Terjemahan <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Lokasi permainan yang telah diterjemahkan. Lokasi default untuk injeksi terjemahan.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","Penerjemah <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Penerjemah yang disukai untuk proyek ini. Jika tidak ditentukan, pengaturan global akan digunakan.\"></i>"],["Translate From","Terjemahkan Dari"],["Translate Into","Terjemahkan Ke"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","Jalur Staging <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Jalur staging adalah lokasi beberapa file yang diperlukan untuk mengekspor/membangun terjemahan. File staging dibuat saat Anda membuat proyek.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","Objek <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Jumlah objek/file yang tersedia di panel kiri\"></i>"],["Folders","Folder"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","Karakter <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Jumlah karakter di kolom Teks Asli\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","Kata <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Mungkin menampilkan nilai yang salah dalam bahasa yang tidak menggunakan spasi (mis. Jepang, Cina).\"></i>"],["Total Rows","Total Baris"],["Translated row","Baris yang diterjemahkan"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Terjemahan organik <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Diisi langsung oleh pengguna ke dalam grid. Ini adalah tanda yang baik. Bisa berupa terjemahan manusia, MTL yang diedit, dll.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","Kemajuan keseluruhan <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","Setelah ekspor<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Jalankan fungsi javascript setelah proyek ini berhasil diekspor.\"></i>"],["Display this information when the project is opened.","Tampilkan informasi ini saat proyek dibuka."],["Select Export Mode","Pilih Mode Ekspor"],["Export to a folder","Ekspor ke folder"],["Export pre-compiled game data to a folder<br>Folder structures are retained","Ekspor data game yang telah dikompilasi sebelumnya ke folder<br>Struktur folder dipertahankan"],["Export as a Zip file","Ekspor sebagai file Zip"],["Export pre-compiled game data to a single zipped archive","Ekspor data game yang telah dikompilasi sebelumnya ke arsip zip tunggal"],["RPGMakerTrans Patch Files","File Patch RPGMakerTrans"],["Export to RPGMakerTrans formatted *.txt files in a folder","Ekspor ke file *.txt berformat RPGMakerTrans dalam folder"],["Comma Separated Values","Nilai Terpisah Koma"],["Export to Comma Separated Values (csv) files in a folder","Ekspor ke file Nilai Terpisah Koma (csv) dalam folder"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 dan di atasnya"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","Ekspor ke file Spreadsheet Microsoft Excel (xlsx) dalam folder"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 dan di atasnya"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","Ekspor ke file Spreadsheet Microsoft Excel (xls) dalam folder"],["HTML Spreadsheet","Spreadsheet HTML"],["Export to HTML files in a folder","Ekspor ke file HTML dalam folder"],["Open Document Format/OASIS (.ods)","Format Dokumen Terbuka/OASIS (.ods)"],["Export to ODS files in a folder","Ekspor ke file ODS dalam folder"],["Select Import Mode","Pilih Mode Impor"],["Import translation from another .trans file","Impor terjemahan dari file .trans lain"],["Open another Translator++ file<br>Apply translation into current project.","Buka file Translator++ lain<br>Terapkan terjemahan ke proyek saat ini."],["Import translation from spreadsheets","Impor terjemahan dari spreadsheet"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","Impor terjemahan dari berbagai file spreadsheet<br>(.xls, .xlsx, .ods, .html, .xml, dll)"],["Import translation from RPGMakerTrans Patch format","Impor terjemahan dari format Patch RPGMakerTrans"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","Impor terjemahan dari file patch RPGMaker Trans<br>(.txt)"],["Source :","Sumber :"],["Select objects to import","Pilih objek untuk diimpor"],["Import mode :","Mode impor :"],["Import translations","Impor terjemahan"],["Import data object","Impor objek data"],["Destination :","Tujuan :"],["Currently selected : ","Saat ini dipilih : "],["Options :","Opsi :"],["Import the context translations","Impor terjemahan konteks"],["Case insensitive","Tidak peka huruf besar/kecil"],["Overwrite target","Timpa target"],["Destination column : ","Kolom tujuan : "],["Translation mode :","Mode terjemahan :"],["Row by row translation","Terjemahan baris per baris"],["Line by line translation","Terjemahan baris demi baris"],["Select translation by context address","Pilih terjemahan berdasarkan alamat konteks"],["Just copy translation into the same row (No checking)","Salin terjemahan ke baris yang sama (Tanpa pengecekan)"],["Merge data","Gabungkan data"],["Import translation from spreadsheet into project","Impor terjemahan dari spreadsheet ke proyek"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","Impor terjemahan dari format spreadsheet apa pun (xls, xlsx, odx, html, csv, dll)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>Spreadsheet harus memiliki setidaknya 2 kolom.</b> Kolom terpenting adalah kolom pertama (kolom paling kiri) yang berisi teks asli. Kolom berikutnya berisi terjemahan. Translator++ akan menggunakan teks di sel paling kanan yang tidak kosong."],["Please click the radio button to select files/folder to import","Silakan klik tombol radio untuk memilih file/folder yang akan diimpor"],["Import file(s)","Impor file"],["Import folder","Impor folder"],["Import translation from RPG Maker Trans into project","Impor terjemahan dari RPG Maker Trans ke proyek"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">Pilih tipe proyek</span>"],["Select project type","Pilih tipe proyek"],["Spreadsheet","Spreadsheet"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","Mulai proyek terjemahan dari data spreadsheet (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","Proyek kosong"],["Create a new .trans file from scratch.","Buat file .trans baru dari awal."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>"],["Fetch type","Jenis pengambilan"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","Kolom pertama adalah teks yang dapat diterjemahkan, sisa kolom adalah terjemahan yang telah ditentukan (Buat data grid yang sesuai dengan tabel asli)"],["All columns are translatable text","Semua kolom adalah teks yang dapat diterjemahkan"],["Custom","Kustom"],["Custom Options","Opsi Kustom"],["Which column do you want to fetch?","Kolom mana yang ingin Anda ambil?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","Harap tentukan kolom mana yang ingin Anda ambil dan kolom mana yang ingin Anda masukkan terjemahannya. <b>Ini adalah indeks berbasis 0 (kolom pertama adalah 0)</b>."],["Column to be translated","Kolom yang akan diterjemahkan"],["Column to put translation into","Kolom untuk menempatkan terjemahan"],["Action","Aksi"],["Enable Row Header Text Column","Aktifkan Kolom Teks Header Baris"],["If enabled, the parser will process the following Row Header Text Column rule","Jika diaktifkan, parser akan memproses aturan Kolom Teks Header Baris berikut"],["Row Header Text Column","Kolom Teks Header Baris"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","Jika ditentukan, nilai di kolom ini akan diterapkan ke header baris. Ini berguna untuk menentukan pembicara atau aktor saat ini, dll. Ini adalah indeks berbasis nol."],["Options","Opsi"],["Calculate cell value","Hitung nilai sel"],["Cell value in the form of formula will be transpiled","Nilai sel dalam bentuk rumus akan ditranspilasi"],["Get formatted value","Dapatkan nilai yang diformat"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","Proses nilai sel setelah pemformatan. (Misalnya, bilangan bulat 100000 dalam lokal tertentu akan menjadi USD 100,000)"],["Parse CSV in EXCEL format","Parsing CSV dalam format EXCEL"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","Paksa parser untuk memparsing CSV dengan cara MS EXCEL. (hanya untuk file CSV)"],["Skip the first <i>n</i> row(s)","Lewati <i>n</i> baris pertama"],["Use this option if you want to skip the row header.","Gunakan opsi ini jika ingin melewati baris header."],["Select File(s)","Pilih File"],["Select a directory","Pilih direktori"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Buat file Trans baru</span>"],["Create a new Trans file","Buat file Trans baru"],["The title of this project","Judul proyek ini"],["Engine type","Jenis mesin"],["Type of the engine","Jenis mesin"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Tempat untuk sesuatu hebat di masa depan dekat!</span>"],["Placeholder for something great at the near future!","Tempat untuk sesuatu hebat di masa depan dekat!"],["This module will be created when the patron count reach 500!","Modul ini akan dibuat saat jumlah patron mencapai 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tProyek dengan judul yang sama <br>\"<span class=\"dialogGameTitle\"></span>\"<br> sudah ada di cache pasca-proses.<br>\n\t\tAnda dapat menggunakan kembali cache ini untuk memperpendek waktu pemuatan secara signifikan.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","Jika bingung, Anda selalu dapat mengklik tombol <strong><a href=\"#\">\"Buat proyek baru\"</a></strong> dengan aman."],["Existed cache","Cache yang ada"],["Select Translator","Pilih Penerjemah"],["Source column","Kolom sumber"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","Kolom mana yang berisi teks sumber untuk diterjemahkan?<br>(default adalah kolom kunci / kolom paling kiri)."],["Target column","Kolom target"],["Which column is the translated text put into.<br>(Can not same with source column)","Kolom mana yang digunakan untuk menempatkan teks terjemahan.<br>(Tidak boleh sama dengan kolom sumber)"],["Translator's Options","Opsi Penerjemah"],["Also try to translate other object","Coba terjemahkan objek lain juga"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","Jika opsi ini dicentang, Translator++ juga akan mencoba menerjemahkan objek lain yang tidak Anda pilih yang tidak memerlukan terjemahan mesin. Ini adalah perilaku bawaan di Translator++ versi 2.3.23 atau lebih rendah."],["Ignore if already translated","Abaikan jika sudah diterjemahkan"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Jika opsi ini dicentang, Translator++ akan mengabaikan baris apa pun yang sudah memiliki terjemahan di kolomnya."],["Overwrite cells","Timpa sel"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","Timpa sel target. Jika tidak dicentang, sel tidak akan disentuh saat tidak kosong."],["Save project on each batch.","Simpan proyek di setiap batch."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","Simpan proyek Anda setiap kali batch selesai.<br>Opsi ini untuk menghindari kehilangan data saat aplikasi crash karena menjalankan tugas berat dari aplikasi penerjemah lokal. Anda mungkin tidak memerlukan ini jika menggunakan penerjemah berbasis cloud."],["Play sound when completed.","Putar suara saat selesai."],["Tags","Tag"],["Select Context(s)","Pilih Konteks"],["Manual Query","Kueri Manual"],["Match all words","Cocokkan semua kata"],["Remove selected","Hapus yang dipilih"],["Remove all but selected","Hapus semua kecuali yang dipilih"],["Select Context","Pilih Konteks"],["Source Column","Kolom Sumber"],["Target Column","Kolom Target"],["Maximum length","Panjang maksimum"],["Export into","Ekspor ke"],["What to do with tagged rows?","Apa yang harus dilakukan dengan baris yang ditandai?"],["Select Color Tag","Pilih Tag Warna"],["On the fly word wrap","Pembungkusan kata secara langsung"],["Inject all files (ignoring selection)","Suntik semua file (mengabaikan pilihan)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","Anda akan menyuntikkan terjemahan melalui tombol <b>Suntik semua</b>. Ini akan menyuntikkan terjemahan tanpa mempertimbangkan objek yang Anda pilih di panel kiri. Gunakan menu konteks panel kiri jika ingin menyuntik objek yang dipilih."],["Select the source material to be translated","Pilih materi sumber yang akan diterjemahkan"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tPilih materi atau konten spesifik yang ingin Anda terjemahkan, seperti file, direktori, atau input relevan lainnya. Pastikan materi yang dipilih dapat diakses dan diformat dengan tepat untuk parser yang sesuai.<br>\n\t\t\t\tSecara default, beberapa parser menggunakan direktori staging sebagai materi sumber.\n\t\t\t"],["Path is inaccessible.","Jalur tidak dapat diakses."],["Target Directory","Direktori Target"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tSalinan aplikasi yang telah diterjemahkan akan dibuat di folder ini.\n\t\t\t"],["Field can not be empty!","Bidang tidak boleh kosong!"],["Target to apply translation","Target untuk menerapkan terjemahan"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tSilakan pilih file yang dapat dieksekusi.\n\t\t\t"],["Copy materials","Salin materi"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","Opsi penyalinan dari Materi Sumber ke Direktori Target. (eksperimental, tidak semua mesin didukung)"],["Word Wrap by Tags","Pembungkusan Kata berdasarkan Tag"],["Directory name","Nama direktori"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tObjek akan dikelompokkan di bawah direktori ini.<br>\n\t\t\t\tMasukkan bintang \"<code>*</code>\" untuk menambahkan <b>objek referensi</b> baru.\n\t\t\t"],["Invalid directory  name","Nama direktori tidak valid"],["Object name","Nama objek"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tNama objek.\n\t\t\t"],["Invalid object name","Nama objek tidak valid"],["New Project","Proyek Baru"],["Save","Simpan"],["Save as...","Simpan sebagai..."],["Open...","Buka..."],["Recent","Terbaru"],["None...","Tidak ada..."],["Export Project","Ekspor Proyek"],["To a folder","Ke folder"],["As a zip file","Sebagai file zip"],["To portable .tpp file","Ke file .tpp portabel"],["To RPGMakerTrans file (*.txt)","Ke file RPGMakerTrans (*.txt)"],["To CSV file","Ke file CSV"],["To XLSX file","Ke file XLSX"],["To XLS file","Ke file XLS"],["To ODS file","Ke file ODS"],["To HTML file","Ke file HTML"],["Import","Impor"],["Project from .tpp file","Proyek dari file .tpp"],["Translation from .trans file","Terjemahan dari file .trans"],["Translation Spreadsheet","Spreadsheet Terjemahan"],["Translation RPGMKTRANSPATCH Format","Format RPGMKTRANSPATCH Terjemahan"],["Automation","Otomatisasi"],["Batch translation","Terjemahan batch"],["Context tool","Alat konteks"],["Batch word wrapping","Pembungkusan kata batch"],["Trim","Pemangkasan"],["Auto padding","Padding otomatis"],["Tools","Alat"],["Third Party Application Installer","Pemasang Aplikasi Pihak Ketiga"],["Close project","Tutup proyek"],["Exit","Keluar"],["Start here","Mulai di sini"],["Start a New Project","Mulai Proyek Baru"],["Continue your work","Lanjutkan pekerjaan Anda"],["Open Project","Buka Proyek"],["Your recent translation","Terjemahan terbaru Anda"],["Tips for you","Tips untuk Anda"],["Next tip! <span class=\"icon-angle-double-right\"></span>","Tip berikutnya! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","Sel paling kanan dalam baris akan mendapatkan prioritas."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","Anda tidak dapat berbagi proyek Anda dengan orang lain hanya dengan file trans. Anda perlu menghasilkan file TPP."],["Always make backups of your trans files.","Selalu buat cadangan file trans Anda."],["You can rename and reorder the column with the coulumn header's context menu.","Anda dapat mengganti nama dan mengurutkan ulang kolom dengan menu konteks header kolom."],["Always backup your game before working with Translator++!","Selalu buat cadangan game Anda sebelum bekerja dengan Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","Jika Anda menemukan fitur yang tidak berjalan normal, coba restart Translator++, itu akan memperbaiki masalah dalam kebanyakan kasus."],["Always create a backup of your game before patching with a translation.","Selalu buat cadangan game Anda sebelum menambal dengan terjemahan."],["Thank you for supporting Translator++.","Terima kasih telah mendukung Translator++."],["Please check Translator++'s online documentation at","Silakan periksa dokumentasi online Translator++ di"],["working","bekerja"],["Open","Buka"],["Save file","Simpan file"],["Save As","Simpan Sebagai"],["Import Project","Impor Proyek"],["Inject / apply all translation","Suntikkan / terapkan semua terjemahan"],["Execute Global Level Custom Script","Jalankan Skrip Kustom Tingkat Global"],["Toggle Active Cell Info","Alihkan Info Sel Aktif"],["Project Properties","Properti Proyek"],["Get Help (F1)","Dapatkan Bantuan (F1)"],["Batch translation (crl+b)","Terjemahan batch (ctrl+b)"],["File list","Daftar file"],["Live Translation Pane","Panel Terjemahan Langsung"],["Toggle selection","Alihkan pilihan"],["Invert selection","Balikkan pilihan"],["Add A New Object","Tambahkan Objek Baru"],["Connect to auto translator","Hubungkan ke penerjemah otomatis"],["Undock pane","Lepaskan panel"],["Collapse / restore left panel","Ciutkan / pulihkan panel kiri"],["Add new key (alt+n)","Tambahkan kunci baru (alt+n)"],["Import Here","Impor di Sini"],["Add a note to this file","Tambahkan catatan ke file ini"],["Open search menu","Buka menu pencarian"],["Toggle grid information","Alihkan informasi grid"],["Object Properties","Properti Objek"],["Automatically set selected original text to clipboard","Secara otomatis atur teks asli yang dipilih ke clipboard"],["Resize Font","Ubah Ukuran Font"],["Toggle word wrapping & Explicit white spaces","Alihkan pembungkusan kata & Spasi putih eksplisit"],["Use Monospace font","Gunakan font Monospace"],["Remove all translation from this file","Hapus semua terjemahan dari file ini"],["Remove this file from project","Hapus file ini dari proyek"],["file path","jalur file"],["Quick find","Temukan cepat"],["Active cell's info","Info sel aktif"],["View original untranslated text","Lihat teks asli yang belum diterjemahkan"],["View raw data","Lihat data mentah"],["View row properties","Lihat properti baris"],["Go to current cell","Pergi ke sel saat ini"],["Current coordinate","Koordinat saat ini"],["Word wraping (for non Japanese text)","Pembungkusan kata (untuk teks non-Jepang)"],["Speak original text (alt+,)","Ucapkan teks asli (alt+,)"],["Copy original text into current cell (ctrl+0)","Salin teks asli ke sel saat ini (ctrl+0)"],["Default translation for all occurrence","Terjemahan default untuk semua kemunculan"],["Translations by context","Terjemahan berdasarkan konteks"],["This cell has a comment","Sel ini memiliki komentar"],["This cell has an organic content","Sel ini memiliki konten organik"],["This cell has been visited","Sel ini telah dikunjungi"],["This is the first time this cell has been visited","Ini pertama kalinya sel ini dikunjungi"],["Word wraping","Pembungkusan kata"],["Speak current translation text (alt+.)","Ucapkan teks terjemahan saat ini (alt+.)"],["Current Cell Editor options","Opsi Editor Sel Saat Ini"],["Clear context translation for current row","Hapus terjemahan konteks untuk baris saat ini"],["Get help about translation by context","Dapatkan bantuan tentang terjemahan berdasarkan konteks"],["Open menu","Buka menu"],["Path not accessible","Jalur tidak dapat diakses"],["The location of the original material. You should not modify anything inside this folder.","Lokasi materi asli. Anda seharusnya tidak mengubah apapun di dalam folder ini."],["The location of the game that has been translated. The default location of the translation injection.","Lokasi game yang telah diterjemahkan. Lokasi default untuk injeksi terjemahan."],["Prefered translator for this project. If not defined, global setting will be used.","Penerjemah yang disukai untuk proyek ini. Jika tidak ditentukan, pengaturan global akan digunakan."],["-use default-","-gunakan default-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","Jalur staging adalah lokasi beberapa file yang diperlukan untuk mengekspor/membangun terjemahan. File staging dihasilkan saat Anda membuat proyek."],["Number of objects/files available on the left pane","Jumlah objek/file yang tersedia di panel kiri"],["Number of characters in the Original Text column","Jumlah karakter di kolom Teks Asli"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","Mungkin menampilkan nilai yang salah dalam bahasa yang tidak menggunakan spasi (misalnya, Jepang, Cina)."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","Pengguna mengisi langsung ke dalam grid. Ini adalah tanda yang baik. Bisa berupa terjemahan manusia, bisa berupa MTL yang diedit, dll."],["Run a javascript function after this project is successfully exported.","Jalankan fungsi javascript setelah proyek ini berhasil diekspor."],["Import .TRANS into project","Impor .TRANS ke dalam proyek"],["Import Spreadsheet Options","Opsi Impor Spreadsheet"],["Import RPGMTransPatch Options","Opsi Impor RPGMTransPatch"],["Start a new project","Mulai proyek baru"],["Search project type...","Cari tipe proyek..."],["Remove row","Hapus baris"],["Add row","Tambahkan baris"],["Project is exist","Proyek sudah ada"],["Context Tool","Alat Konteks"],["Your list of context separated by new line","Daftar konteks Anda dipisahkan oleh baris baru"],["Wrap text","Bungkus teks"],["Export Options","Opsi Ekspor"],["Tagging","Penandaan"],["Apply Translation","Terapkan Terjemahan"],["Add new Object","Tambahkan Objek Baru"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText