l","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","pesanKeamanan"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","pesanImporParsial"],["import","impor"],["name","nama"],["prompt","prompt"],["clearPrompts","hapusPrompt"],["morePrompts","lebihBanyakPrompt"],["toast.sync","toast.sinkron"],["toast.stop","toast.berhenti"],["button.sync","tombol.sinkron"],["button.stop","tombol.berhenti"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Terjemahkan dengan ChatGPT Batch API"],["Model","Model"],["The pre-trained model.","Model yang telah dilatih sebelumnya."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Tampaknya OpenAI Batch API menggunakan konvensi penamaan model yang sedikit berbeda dari API yang umum digunakan. Model yang digunakan dalam Batch API memiliki awalan \"-batch\". Misalnya, jika Anda menggunakan <code>gpt-4.1-mini</code>, model secara otomatis menjadi <code>gpt-4.1-mini-batch</code>.<br />\nNamun, pada saat add-on ini dibuat, model batch tidak tercantum dalam batas penggunaan model OpenAI, yang membuat pengguna tidak dapat menggunakan Batch API jika mereka telah menyetel filter Penggunaan Model ke \"Izinkan\" (whitelist).<br />\nIni kemungkinan adalah bug di UI OpenAI yang mungkin diperbaiki di masa depan.<br />\nJadi, pastikan untuk menyetel batas penggunaan di OpenAI ke mode \"Blokir\" (blacklist) agar dapat menggunakan Batch API.<br />\nKlik di sini untuk mengubah batas penggunaan model: https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","Kolom Sumber"],["The column of the original texts you want to translate.","Kolom teks asli yang ingin Anda terjemahkan."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya terjemahan."],["Ignore if already translated","Abaikan jika sudah diterjemahkan"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Jika opsi ini dicentang, Translator++ akan mengabaikan baris apa pun yang sudah memiliki terjemahan di kolomnya."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya terjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah template untuk memuat referensi aktor dalam pesan prompt."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menambahkan informasi seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["System Message Template","Template Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama di setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nama lengkap bahasa sumber</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nama lengkap bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan yang telah ditentukan dari algoritma escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (Pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Tambahkan informasi aktor.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Sertakan beberapa baris sebelumnya sebagai konteks</li>"],["Body Message Template","Template Pesan Tubuh"],["Template of the body of your chat.","Template dari badan percakapan Anda."],["Sample conversation","Contoh percakapan"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch ChatGPT memungkinkan Anda menerjemahkan proyek secara asinkron dengan biaya 50% lebih rendah, artinya Anda akan menerima hasil terjemahan <b style=\"color:red\">dalam 24 jam</b> dengan <b style=\"color:red\">setengah biaya normal</b>. Ini sangat berguna untuk proyek besar yang tidak memerlukan hasil terjemahan segera."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Baca lebih lanjut tentang API Batch ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Pengaturan Umum"],["This form is using your existing ChatGPT configuration.<br>","Formulir ini menggunakan konfigurasi ChatGPT yang sudah ada.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Anda dapat mengubah konfigurasi dengan pergi ke pengaturan Penerjemah ChatGPT di jendela opsi.<br>"],["There you can set the API key, model, and other settings.<br />","Di sana Anda dapat mengatur kunci API, model, dan pengaturan lainnya.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Buka pengaturan ChatGPT\" />"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Ignore translated rows","Abaikan baris yang sudah diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap kumpulan item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari pembengkakan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt Template","Template Prompt"],["<h2>1. System Message</h2>","<h2>1. Pesan Sistem</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Di sini Anda dapat menjelaskan kepada asisten, apa peran mereka.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Prompt Anda yang sebenarnya</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Ini adalah prompt sebenarnya kepada asisten.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Biaya overhead</h3>\n                        Biaya overhead adalah biaya dari pesan prompt yang Anda kirim ke asisten tanpa teks terjemahan sebenarnya. Biaya dihitung berdasarkan jumlah token dalam pesan prompt. Semakin banyak token yang Anda miliki, semakin tinggi biayanya.<br>\n                        <b>Biaya overhead saat ini:</b> <span class=\"overheadCost\">0</span> token / permintaan."],["Are you sure you want to reset the form?","Apakah Anda yakin ingin mengatur ulang formulir?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Apakah Anda yakin ingin memproses batch?\nBiaya akan dikenakan untuk operasi ini."],["The batch is successfully created. Do you want to open the batch manager?","Batch berhasil dibuat. Apakah Anda ingin membuka manajer batch?"],["OpenAI Batch API Queue","Antrian API Batch OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transChatGPT/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>JUDUL : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>MESIN : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENSI[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENSI[Referensi Umum]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transChatGPT/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Silakan pilih baris untuk menerapkan terjemahan"],["Target Column","Kolom Target"],["The column to put the translation result.","Kolom untuk menempatkan hasil terjemahan."],["Import translation from ChatGPT Batch","Impor terjemahan dari ChatGPT Batch"],["Translation applied to selected rows","Terjemahan diterapkan pada baris yang dipilih"],["Invalid format","Format tidak valid"],["OK","OK"],["Mismatch","Tidak cocok"],["Failed to load batch list with error: \n","Gagal memuat daftar batch dengan kesalahan: \n"],["Download Error File","Unduh File Kesalahan"],["Batch is not completed yet","Batch belum selesai"],["Are you sure you want to cancel this batch?","Apakah Anda yakin ingin membatalkan batch ini?"],["Cannot cancel completed batch.","Tidak dapat membatalkan batch yang sudah selesai."],["Batch cancelled","Batch dibatalkan"],["Failed to cancel batch","Gagal membatalkan batch"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","Batch"],["Apply translation","Terapkan terjemahan"],["Cancel batch","Batalkan batch"],["Status","Status"],["Batch ID","ID Batch"],["Input File ID","ID File Input"],["End point","Titik akhir"],["Created at","Dibuat pada"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Kadaluarsa pada <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batch yang tidak selesai tepat waktu akhirnya berpindah ke status kadaluarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons untuk permintaan yang selesai tersedia melalui file output batch. Anda akan dikenakan biaya untuk token yang dikonsumsi dari permintaan yang selesai.\"></i>"],["Completed at","Selesai pada"],["Errors","Kesalahan"],["Batch Item Detail of","Detail Item Batch dari"],["ID","ID"],["Completed on","Selesai pada"],["Model","Model"],["Prompt Token","Token Prompt"],["Completion Token","Token Penyelesaian"],["Total Token","Total Token"],["Status Code","Kode Status"],["error","kesalahan"],["Conversation","Percakapan"],["Response Validation","Validasi Respons"],["Raw Payload","Payload Mentah"],["View raw payload","Lihat payload mentah"],["Response Preview","Pratinjau Respons"],["Apply translations from selected rows","Terapkan terjemahan dari baris yang dipilih"],["Here you can edit the translation result individually and send it into Translator++","Di sini Anda dapat mengedit hasil terjemahan secara individual dan mengirimkannya ke Translator++"],["Open ChatGPT Settings","Buka Pengaturan ChatGPT"],["Help","Bantuan"],["File list","Daftar file"],["Collapse / restore left panel","Ciutkan / pulihkan panel kiri"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Batch yang tidak selesai tepat waktu akhirnya berpindah ke status kedaluwarsa; permintaan yang belum selesai dalam batch tersebut dibatalkan, dan respons apa pun untuk permintaan yang selesai tersedia melalui file output batch. Anda akan dikenai biaya untuk token yang dikonsumsi dari permintaan yang selesai."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","Obrolan OpenAI"],["Target URL","URL Target"],["Target end point. You can use any service that supports OpenAI API.","Titik akhir target. Anda dapat menggunakan layanan apa pun yang mendukung API OpenAI."],["Sample endpoints","Contoh titik akhir"],["Use this endpoint","Gunakan titik akhir ini"],["Copy to clipboard","Salin ke papan klip"],["e.g.","misalnya"],["API Key","Kunci API"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","Masukkan Kunci API Anda di sini.<br>Cara mendapatkan kunci API berbeda untuk setiap layanan.<br>"],["Leave it blank if the service doesn't require API key.","Biarkan kosong jika layanan tidak memerlukan kunci API."],["Model","Model"],["The pre-trained model","Model yang telah dilatih sebelumnya"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","Untuk OpenAI, Anda mungkin perlu mengatur model yang diizinkan untuk digunakan (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","Aktifkan Konteks"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Aktifkan konteks untuk terjemahan. Materi yang telah diterjemahkan sebelumnya di atas batch saat ini akan disertakan sebagai konteks. <b>Anda juga perlu secara eksplisit menyertakan KONTEKS ke dalam templat</b>"],["Context Character Limit","Batas Karakter Konteks"],["Character limit for the context.","Batas karakter untuk konteks."],["System Message Template","Templat Pesan Sistem"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Pesan sistem adalah header pesan yang akan memberi tahu peran asisten chatGPT Anda. Pesan ini akan dikirim sebagai pesan pertama dari setiap batch yang Anda kirim ke chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Anda dapat menyertakan variabel berikut dengan gaya Template Literal JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Variabel:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Bahasa sumber</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Bahasa target</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Teks sumber</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Pesan yang telah ditentukan dari algoritma pelarian.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String yang mewakili baris baru (Pengganti baris).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Jumlah pesan dalam batch.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin permainan</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>KONTEKS : Konteks dari terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Contoh percakapan"],["User message","Pesan pengguna"],["Assistant's response","Tanggapan asisten"],["Body Message Template","Template Pesan Tubuh"],["Template of the body of your chat.","Template dari tubuh percakapan Anda."],["Enable JailBreak","Aktifkan JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Aktifkan Jailbreak untuk terjemahan. Ini akan membuat terjemahan lebih akurat dan kurang bias. Beberapa model mungkin ingin menghubungkan peristiwa fiksi dengan peristiwa kehidupan nyata, sehingga mereka akan mencoba mengubah terjemahan agar sesuai dengan narasi mereka sendiri. Opsi ini akan mencegah hal itu."],["Jailbreak Template","Template Jailbreak"],["Template of the Jailbreak message.","Template dari pesan Jailbreak."],["Maximum Tokens","Token Maksimum"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Jumlah maksimum token yang dihasilkan dalam penyelesaian.<br>Jumlah token dari prompt Anda ditambah max_tokens tidak boleh melebihi panjang konteks model. Kebanyakan model memiliki panjang konteks 2048 token (kecuali model terbaru, yang mendukung 4096)."],["Temperature","Suhu"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Suhu pengambilan sampel yang digunakan, antara 0 dan 2. Nilai lebih tinggi seperti 0,8 akan membuat keluaran lebih acak, sementara nilai lebih rendah seperti 0,2 akan membuatnya lebih fokus dan deterministik. <br>OpenAI umumnya merekomendasikan mengubah ini atau top_p tetapi tidak keduanya."],["Nucleus sampling (top_p)","Pengambilan sampel nukleus (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Alternatif untuk pengambilan sampel dengan suhu, disebut pengambilan sampel nukleus, di mana model mempertimbangkan hasil token dengan massa probabilitas top_p. Jadi 0,1 berarti hanya token yang terdiri dari 10% massa probabilitas teratas yang dipertimbangkan. <br>OpenAI umumnya merekomendasikan mengubah ini atau suhu tetapi tidak keduanya."],["Frequency Penalty","Penalti Frekuensi"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2,0 dan 2,0. Nilai positif memberikan penalti pada token baru berdasarkan frekuensi yang ada dalam teks sejauh ini, mengurangi kemungkinan model untuk mengulangi baris yang sama secara verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalti Kehadiran"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Angka antara -2.0 dan 2.0. Nilai positif memberikan penalti pada token baru berdasarkan apakah mereka muncul dalam teks sejauh ini, meningkatkan kemungkinan model untuk membahas topik baru. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Gunakan Skema JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Gunakan <code>json_schema</code> untuk bidang <code>response_format.type</code> alih-alih <code>json_object</code> yang lama. <code>json_schema</code> diperlukan oleh beberapa model terbaru dan server seperti <b>LM Studio</b>, tetapi beberapa model lama masih menggunakan <code>json_object</code>."],["Max Characters per Batch","Maksimum Karakter per Batch"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Batas karakter maksimum per batch terjemahan.\nOpsi ini hanya menghitung panjang karakter teks asli, bukan panjang karakter pesan prompt."],["Max concurrent requests","Permintaan bersamaan maksimum"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","Berapa banyak permintaan bersamaan yang diizinkan untuk terhubung secara simultan? Setiap koneksi bersamaan tambahan akan melipatgandakan kecepatan terjemahan Anda, tetapi juga akan cepat menghabiskan batas token yang ditetapkan oleh penyedia Anda.<br />Atur ke <b>0</b> untuk menonaktifkan fitur ini.<br />Gabungkan opsi ini dengan <b>Baris maksimum per permintaan bersamaan</b> untuk meningkatkan kecepatan terjemahan lebih lanjut.<br />Mengatur opsi ini lebih dari 1 akan memengaruhi <b>Konteks</b> karena akan ada permintaan yang diproses sebelum yang sebelumnya selesai. Dengan demikian, konteks akan dikirim tanpa hasil terjemahan dari permintaan sebelumnya."],["Max row per concurrent requests","Baris maksimum per permintaan bersamaan"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Berapa banyak baris yang diizinkan untuk setiap permintaan bersamaan. Atur ke <b>0</b> untuk menonaktifkan fitur ini.<br />Jika opsi ini dinonaktifkan, maka tidak peduli berapa banyak <b>Permintaan bersamaan maksimum</b> yang Anda atur, Translator++ akan memproses permintaan sebagai satu bagian.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Semakin banyak baris yang Anda atur, semakin banyak terjemahan yang bisa Anda dapatkan dalam satu batch. Dengan demikian mengurangi biaya overhead dan meningkatkan kemungkinan AI mengembalikan hasil error.<br />Semakin rendah angkanya, semakin kecil kemungkinan terjemahan akan error tetapi akan membebani Anda dengan biaya tambahan untuk prompt overhead."],["Preserve translations from invalid returned number of rows","Pertahankan terjemahan dari jumlah baris yang dikembalikan tidak valid"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","Pertahankan terjemahan dari respons yang memiliki jumlah baris tidak valid.<br />Jika dicentang, Translator++ akan mencoba memperbaiki jumlah baris dan menyisipkan terjemahan ke dalam grid.<br />Jika tidak dicentang, sel akan tetap kosong.<br />Disarankan untuk membiarkan opsi ini tidak dicentang untuk tujuan terjemahan ulang."],["Batch delay","Penundaan batch"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","Penundaan antar batch (dalam milidetik).<br />Gunakan pengaturan ini untuk mengontrol permintaan Anda agar tidak melebihi batas RPM (permintaan per menit)."],["Batch Timeout","Waktu habis batch"],["Timeout for each batch in milisecond","Waktu habis untuk setiap batch dalam milidetik"],["Code Escaping Algorithm","Algoritma Pelolosan Kode"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Algoritma pelolosan untuk kode sebaris di dalam dialog. Anda mungkin perlu mengubah <b>Templat Pesan Sistem</b> dan <b>Templat Pesan Badan</b> sesuai dengan algoritma pelolosan pilihan Anda.<br />Ketika Anda memilih <b>JSONCloaking</b> atau <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> akan dikirim secara otomatis (kecuali Anda mengaktifkan <b>Gunakan Skema JSON</b>, yang akan mengirim skema JSON sebagai gantinya). <b>JSONCloaking</b> sangat akurat, tetapi tidak bekerja dengan semua model, coba <b>gpt-3.5-turbo-1106</b>."],["Number of retry","Jumlah percobaan ulang"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Berapa kali mesin harus mencoba ulang ketika validasi output terjemahan gagal. Jika nullish (kosong), maka tidak ada percobaan ulang."],["Retry when the number of translated rows doesn't match original","Ulangi jika jumlah baris terjemahan tidak cocok dengan aslinya"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Jika diaktifkan, mesin akan mengulangi ketika model mengembalikan jumlah baris terjemahan yang berbeda dibandingkan dengan muatan asli."],["Retry when the number of lines for each translated row doesn't match original","Ulangi jika jumlah baris untuk setiap baris terjemahan tidak cocok dengan aslinya"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Jika diaktifkan, mesin akan mengulangi ketika ada baris terjemahan yang memiliki jumlah baris berbeda dari baris aslinya."],["Prompt: Row count mismatch","Prompt: Ketidakcocokan jumlah baris"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt yang digunakan saat mengulangi karena ketidakcocokan jumlah baris/elemen. Variabel template yang tersedia termasuk: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","Prompt: Ketidakcocokan jumlah baris per baris"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt yang digunakan saat mengulangi karena ketidakcocokan jumlah baris per baris. Variabel template yang tersedia termasuk: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","Prompt: Kesalahan / Instruksi ulangi"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt yang ditambahkan setelah prompt ketidakcocokan untuk menginstruksikan model agar mengulangi. Variabel template yang tersedia termasuk: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","Parameter Kustom"],["Key","Kunci"],["Value","Nilai"],["Type","Tipe"],["Type of the value.","Tipe dari nilai."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Untuk tipe <b>javascript</b>, nilai akan dievaluasi sebagai kode JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Ruang lingkup kode javascript adalah <code>window</code>. Jadi Anda dapat mengambil hampir semua nilai."],["<br />Example: <code>trans.project.title</code>","<br />Contoh: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Hapus parameter yang tidak akan dikirim ke API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI terus berubah, beberapa model baru mungkin tidak mendukung parameter lama dan akan mengembalikan kesalahan HTTP untuk parameter permintaan yang tidak dikenali."],["You can drop the parameters that are not supported by the model here.","Anda dapat membuang parameter yang tidak didukung oleh model di sini."],["Manage configuration","Kelola konfigurasi"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","HTML Cloaking Wrapped"],["JSONObject Cloaking","JSONObject Cloaking"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","Addon ini memungkinkan terjemahan melalui layanan apa pun yang mendukung OpenAI Chat API, seperti Deepseek, LlamaCPP, Google Gemini, dll., dan tentu saja, OpenAI ChatGPT."],["OpenAI API settings","Pengaturan OpenAI API"],["General","Umum"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Jangan buang uang Anda untuk Model Penalaran</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Berbagai penelitian telah membuktikan bahwa model penalaran jauh lebih buruk daripada model biasa dalam melakukan tugas penulisan kreatif dan terjemahan.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Anda tidak mendapatkan apa-apa selain biaya yang lebih mahal dan waktu respons yang lebih lambat saat menggunakan model penalaran.</p>"],["Explore more models","Jelajahi lebih banyak model"],["Templates","Template"],["Enable context","Aktifkan konteks"],["<h2>Sample dialogue</h2>","<h2>Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan Anda.</p>"],["Add Example: Translate Japanese to English","Tambahkan Contoh: Terjemahkan Jepang ke Inggris"],["Retry prompts","Ulangi prompt"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Prompt ini ditambahkan sebagai pesan <b>pengguna</b> tambahan selama pengulangan, tepat setelah output model sebelumnya.</p>"],["<p>Available variables:</p>","<p>Variabel yang tersedia:</p>"],["Enable Jailbreak","Aktifkan Jailbreak"],["Advanced","Lanjutan"],["Custom Parameters","Parameter Kustom"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Anda dapat menambahkan parameter kustom ke badan permintaan API Chat OpenAI. Ini berguna jika Anda ingin menambahkan parameter tambahan yang tidak tersedia dalam formulir."],["<h2>Warning</h2>","<h2>Peringatan</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Pengaturan parameter kustom yang salah dapat menyebabkan permintaan API gagal. Pastikan Anda tahu apa yang Anda lakukan sebelum menambahkan parameter kustom. Beberapa layanan seperti OpenAI ketat tentang parameter yang Anda kirim, dan mereka akan mengembalikan kesalahan HTTP untuk parameter permintaan yang tidak dikenali.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Jika kunci yang sama digunakan beberapa kali, hanya nilai terakhir yang akan digunakan.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Jika kunci yang sama dalam konfigurasi yang ada digunakan, maka parameter konfigurasi yang ada akan ditimpa oleh parameter kustom.</li>"],["Drop Parameters","Hapus Parameter"],["Open chatGPT tester","Buka penguji chatGPT"],["Batch Translation Setting","Pengaturan Terjemahan Batch"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Maaf, addon ini hanya tersedia untuk patron aktif saja.\nAnda dapat membuka fitur ini dengan menjadi patron $1."],["Preserve invalid returned rows","Pertahankan baris yang dikembalikan tidak valid"],["Retries and Refinement","Percobaan Ulang dan Penyempurnaan"],["<h2>Retries and Refinement</h2>","<h2>Percobaan Ulang dan Penyempurnaan</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Ketika keluaran terjemahan gagal dalam validasi, Translator++ dapat meminta model untuk mencoba ulang terjemahan. Anda dapat mengatur berapa kali model harus mencoba ulang dan juga mengatur kondisi untuk percobaan ulang.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Mengatur jumlah percobaan ulang yang wajar dengan kondisi percobaan ulang yang tepat dapat secara signifikan meningkatkan kualitas terjemahan sambil mengendalikan biaya dan waktu.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Setiap percobaan ulang memakan waktu dan uang tambahan</b>. Jika batch Anda sering mencoba ulang, Anda mungkin ingin menyesuaikan prompt Anda untuk membuat instruksi lebih jelas bagi model.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Gunakan alat pengembang atau Pengelola Batch untuk men-debug terjemahan batch Anda.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Algoritma Pelolosan Kode</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Pelolosan kode adalah teknik untuk mencegah MTL mengubah potongan kode di dalam dialog. Ini berguna ketika dialog Anda berisi potongan kode seperti tag HTML, tag XML, objek JSON, atau templat JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Pilih algoritma pelolosan yang sesuai dengan potongan kode di dalam dialog Anda. Anda mungkin perlu menyesuaikan templat <b>pesan sistem</b>, <b>Prompt sampel</b>, dan <b>pesan tubuh</b> sesuai kebutuhan.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Klik <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>di sini</a> untuk membaca lebih lanjut tentang algoritma pelolosan kode dan cara menggunakannya secara efektif.</p>"],["Default","Bawaan"],["JavaScript template cloaking","Penyamaran templat JavaScript"],["None (no escaping)","Tidak ada (tanpa pelolosan)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Apakah Anda ingin memuat preset dialog sampel untuk algoritma pelolosan yang dipilih? Ini akan menimpa dialog sampel Anda yang ada."],["Always separate file","Selalu file terpisah"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan file untuk setiap batch. Ini dapat menjaga konteks setiap file tidak tercampur dengan file lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya penerjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya penerjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan yang akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah templat untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam templat prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan lebih banyak informasi seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt sebenarnya."],["<br />","<br />"],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu pisahkan file untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur ini akan mencoba memuat hanya istilah yang relevan untuk menghindari pembengkakan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":false,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"relPath":"/addons/transChatGPT/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":160,"length":160,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>K</u>irim"],["Toggle word wrap","Alihkan pembungkusan kata"],["Open debugger (F12)","Buka debugger (F12)"],["Help","Bantuan"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Pengembang Translator++. Anda dapat beralih ke versi Pengembang dengan menggunakan Utilitas Dasar -> Ubah Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Judul game</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Mesin game</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glosarium informasi aktor. (Hanya jika opsi informasi aktor diaktifkan dalam mode batch)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENCE[Referensi Umum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Konteks terjemahan sebelumnya (jika konteks diaktifkan)</li>"],["Sample conversation","Contoh percakapan"],["<h2>Sample dialogue</h2>","<h2>Contoh dialog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Contoh dialog yang ada. Anda dapat menulis contoh respons baik atau buruk untuk membantu penerjemah memahami tujuan dan konteks percakapan.</p>"],["Always separate file","Selalu pisahkan file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Selalu pisahkan file untuk setiap batch. Ini dapat menjaga konteks setiap file tidak tercampur dengan file lain."],["Add actor name","Tambahkan nama aktor"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Tambahkan nama aktor dari info baris ke teks yang dapat diterjemahkan. Ini akan membantu penerjemah melacak dialog dan kata ganti. Translator++ kemudian akan menghapus nama aktor dari hasil terjemahan. Ini jelas akan meningkatkan biaya penerjemahan."],["Load Actor Reference as Glossary","Muat Referensi Aktor sebagai Glosarium"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Jika dicentang, Translator++ akan memuat referensi aktor sebagai glosarium. Ini akan membantu penerjemah memahami konteks percakapan. Referensi aktor adalah nama aktor dalam dialog. Ini akan dimuat sebagai glosarium untuk penerjemah. Ini akan meningkatkan biaya penerjemahan."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Hanya karakter yang ada dalam percakapan akan dimuat sebagai glosarium untuk setiap item batch. Gunakan perintah template untuk memuat referensi aktor dalam pesan prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Jika Anda mengaktifkan opsi ini, Anda juga perlu menyertakan variabel <code>ACTOR_INFO</code> dalam template prompt untuk menempatkan data informasi karakter."],["Actor Reference Translation Column","Kolom Terjemahan Referensi Aktor"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Kolom terjemahan nama aktor. Kolom ini akan digunakan sebagai terjemahan referensi aktor. Ini akan meningkatkan konsistensi terjemahan nama aktor dalam percakapan."],["Actor's Information Column","Kolom Informasi Aktor"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Kolom yang berisi informasi tambahan aktor. Anda dapat menempatkan informasi lebih lanjut seperti jenis kelamin, usia, dll. Ini akan meningkatkan terjemahan kata ganti dalam percakapan."],["Extra Prompt","Prompt Tambahan"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt tambahan yang akan ditambahkan ke pesan prompt. Ini akan ditambahkan setelah pesan sistem dan sebelum pesan prompt sebenarnya."],["General Settings","Pengaturan Umum"],["Always separate file for each batch","Selalu file terpisah untuk setiap batch"],["Append actor name to the translatable text","Tambahkan nama aktor ke teks yang dapat diterjemahkan"],["Glossary","Glosarium"],["<h2>Glossary</h2>","<h2>Glosarium</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Fitur ini akan membantu Anda secara otomatis menambahkan glosarium ke dalam prompt. Glosarium akan dimuat untuk setiap batch item untuk meningkatkan kualitas terjemahan. Fitur akan mencoba memuat hanya istilah yang relevan untuk menghindari membengkakkan prompt Anda.</p>"],["The Column of Actor's Additional Information","Kolom Informasi Tambahan Aktor"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transChatGPT/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","Obrolan dengan API ChatGPT"],["Batch Manager","Manajer Batch"],["This feature is only available if you have a project open.","Fitur ini hanya tersedia jika Anda memiliki proyek yang terbuka."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transChatGPT/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","Apakah Anda ingin menginstal DazedMTLTool?"],["Ignore if already translated","Abaikan jika sudah diterjemahkan"],["OpenAI Translation with DazedMTL","Terjemahan OpenAI dengan DazedMTL"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":false,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"relPath":"/addons/transDazedMTL/transdazedmtl.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","Server DeepL tidak terpasang. Apakah Anda ingin menginstalnya sekarang?"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":false,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/transDeepl/DeepLUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","Penggunaan karakter:\n"],["Failed to fetch quota: ","Gagal mengambil kuota: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":false,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"relPath":"/addons/transDeeplPro/deepl-pro.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>K</u>irim"],["Toggle word wrap","Alihkan pembungkusan kata"],["Open debugger (F12)","Buka debugger (F12)"],["Help","Bantuan"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Fitur ini hanya tersedia jika Anda menggunakan versi Pengembang Translator++. Anda dapat beralih ke versi Pengembang dengan menggunakan Utilitas Dasar -> Ubah Core NWJS."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>JUDUL : Judul permainan</li>"],["<li>ENGINE : Engine of the game</li>","<li>MESIN : Mesin permainan</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENSI[nama objek] : Hasilkan referensi dari objek Translator++. <br />Contoh : <code>REFERENSI[Referensi Umum]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>API Native Gemini</h2><p>Mesin ini menggunakan API native Google Gemini untuk terjemahan. <br />Anda juga dapat menggunakan add-on OpenAI untuk Google Gemini. Ada lebih banyak fitur di add-on OpenAI, Itulah sebabnya <b style='color:green;'>saya merekomendasikan menggunakan add-on OpenAI sebagai gantinya</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI memerlukan beberapa modul dari pustaka OpenAI. Pastikan add-on <b>transChatGPT (ChatGPT untuk Translator++)</b> terinstal."],["Explore more models","Jelajahi lebih banyak model"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"relPath":"/addons/transGemini/gemini.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","model"],["|","|"],["promptLibrary","promptLibrary"],["search","cari"],["downloadChat","unduhChat"],["newChat","chatBaru"],["api","api"],["customEndpoint","titikAkhirKustom"],["apiEndpoint.inputLabel","apiEndpoint.labelInput"],["apiKey.inputLabel","apiKey.labelInput"],["apiVersion.inputLabel","apiVersion.labelInput"],["apiVersion.description","apiVersion.deskripsi"],["securityMessage","pesanKeamanan"],["apiEndpoint.description","apiEndpoint.deskripsi"],["apiEndpoint.warn","apiEndpoint.peringatan"],["partialImportMessages","pesanImporParsial"],["import","impor"],["name","nama"],["prompt","petunjuk"],["clearPrompts","hapusPetunjuk"],["morePrompts","lebihBanyakPetunjuk"],["toast.sync","toast.sinkronisasi"],["toast.stop","toast.berhenti"],["button.sync","tombol.sinkronisasi"],["button.stop","tombol.berhenti"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLitera