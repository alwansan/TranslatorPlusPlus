.inputLabel":12,"apiVersion.description":13,"securityMessage":14,"apiEndpoint.description":15,"apiEndpoint.warn":16,"partialImportMessages":17,"import":18,"name":19,"prompt":20,"clearPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","özelModeller.özelEtiket"],["model","model"],["|","|"],["promptLibrary","istem kitaplığı"],["search","ara"],["downloadChat","sohbeti indir"],["newChat","yeni sohbet"],["api","api"],["customEndpoint","özel uç nokta"],["apiEndpoint.inputLabel","apiUçNoktası.girdiEtiketi"],["apiKey.inputLabel","apiAnahtarı.girdiEtiketi"],["apiVersion.inputLabel","apiSürümü.girdiEtiketi"],["apiVersion.description","apiVersion.açıklama"],["securityMessage","güvenlikMesajı"],["apiEndpoint.description","apiEndpoint.açıklama"],["apiEndpoint.warn","apiEndpoint.uyarı"],["partialImportMessages","kısmiİçeAktarmaMesajları"],["import","içe aktar"],["name","ad"],["prompt","istem"],["clearPrompts","istemleri temizle"],["morePrompts","daha fazla istem"],["toast.sync","toast.senkronizasyon"],["toast.stop","toast.durdur"],["button.sync","düğme.senkronizasyon"],["button.stop","düğme.durdur"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":3,"promptLibrary":4,"search":5,"downloadChat":6,"newChat":7,"api":8,"customEndpoint":9,"apiEndpoint.inputLabel":10,"apiKey.inputLabel":11,"apiVersion.inputLabel":12,"apiVersion.description":13,"securityMessage":14,"apiEndpoint.description":15,"apiEndpoint.warn":16,"partialImportMessages":17,"import":18,"name":19,"prompt":20,"clearPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ChatGPT Toplu API ile Çevir"],["Model","Model"],["The pre-trained model.","Önceden eğitilmiş model."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI Toplu API'sinin, genel olarak kullanılan API'den biraz farklı bir model adlandırma kuralı kullandığı görülüyor. Toplu API'de kullanılan modellerin \"-batch\" öneki var. Örneğin, <code>gpt-4.1-mini</code> kullanırsanız, model otomatik olarak <code>gpt-4.1-mini-batch</code> olur.<br />\nAncak, bu eklenti oluşturulduğu sırada, toplu modeller OpenAI'nin model kullanım limitlerinde listelenmiyor, bu da kullanıcıların Model Kullanım filtresini \"İzin Ver\" (beyaz liste) olarak ayarladıysa Toplu API'yi kullanmasını imkansız kılıyor.<br />\nBu muhtemelen OpenAI UI'ında bir hata olup gelecekte düzeltilebilir.<br />\nBu nedenle, Toplu API'yi kullanmak için OpenAI'daki kullanım limitlerini \"Engelle\" (kara liste) moduna ayarladığınızdan emin olun.<br />\nModelin kullanım limitlerini değiştirmek için buraya tıklayın: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Kaynak Sütun"],["The column of the original texts you want to translate.","Çevirmek istediğiniz orijinal metinlerin sütunu."],["Add actor name","Aktör adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Çevrilebilir metne satır bilgisinden aktör adı ekleyin. Bu, çevirmenlerin diyalogu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra aktör adını çeviri sonucundan kaldıracaktır. Bu, çeviri maliyetini artıracaktır."],["Ignore if already translated","Zaten çevrilmişse yoksay"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Bu seçenek işaretlenirse, Translator++ sütununda zaten çevirileri olan herhangi bir satırı yoksayacaktır."],["Load Actor Reference as Glossary","Aktör Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ aktör referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Aktör referansı, diyalogdaki aktörün adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler her bir toplu öğe için sözlük olarak yüklenecektir. Aktör referansını prompt mesajında yüklemek için şablon komutunu kullanın."],["Actor Reference Translation Column","Aktör Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin bulunduğu sütun. Bu sütun, aktör referansının çevirisi olarak kullanılacaktır. Bu, konuşmada aktör adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Aktör Bilgisi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş vb. daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, chatGPT asistanınızın rolünün ne olduğunu söyleyen mesajın başlığıdır. Bu mesaj, chatGPT'ye gönderdiğiniz her toplu işin en ilk mesajı olarak gönderilecektir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Şablon Değişmez stili ile aşağıdaki değişkenleri ekleyebilirsiniz <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tam kaynak dil adı</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tam hedef dil adı</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yerine geçen).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Toplu işteki mesaj sayısı.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Aktörlerin bilgilerini ekle.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nesne adı] : Translator++ nesnesinden referans oluştur. <br />Örnek : <code>REFERENCE[Ortak Referans]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bağlam olarak bazı önceki satırları dahil et</li>"],["Body Message Template","Gövde Mesaj Şablonu"],["Template of the body of your chat.","Sohbetinizin gövdesinin şablonu."],["Sample conversation","Örnek konuşma"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT Toplu API'si, projenizi %50 daha düşük maliyetle asenkron olarak çevirmenize olanak tanır, yani çeviri sonuçlarınızı <b style=\"color:red\">24 saat içinde</b> ve <b style=\"color:red\">normal maliyetin yarısına</b> alırsınız. Bu, acil çeviri sonuçları gerektirmeyen büyük projeler için özellikle kullanışlıdır."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />ChatGPT Toplu API'si hakkında daha fazla bilgi edinin: https://platform.openai.com/docs/guides/batch ."],["General Settings","Genel Ayarlar"],["This form is using your existing ChatGPT configuration.<br>","Bu form mevcut ChatGPT yapılandırmanızı kullanıyor.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Yapılandırmayı, seçenekler penceresindeki ChatGPT Çevirmen ayarlarına giderek değiştirebilirsiniz.<br>"],["There you can set the API key, model, and other settings.<br />","Orada API anahtarını, modeli ve diğer ayarları yapabilirsiniz.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT ayarlarını aç\" />"],["Append actor name to the translatable text","Çevrilebilir metne aktör adını ekle"],["Ignore translated rows","Çevrilmiş satırları yoksay"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, sözlüğü otomatik olarak isteme eklemenize yardımcı olur. Sözlük, çeviri kalitesini artırmak için her öğe grubu için yüklenecektir. Özellik, yalnızca ilgili terimleri yüklemeye çalışarak isteminizin şişmesini önler.</p>"],["The Column of Actor's Additional Information","Oyuncunun Ek Bilgileri Sütunu"],["Prompt Template","İstek Şablonu"],["<h2>1. System Message</h2>","<h2>1. Sistem Mesajı</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Burada asistanın rolünü açıklayabilirsiniz.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut diyalog örneği. Amacınızı ve konuşmanın bağlamını çevirmenin anlamasına yardımcı olmak için iyi veya kötü yanıt örnekleri yazabilirsiniz.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Gerçek isteğiniz</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Bu, asistana gönderilen gerçek istektir.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Genel maliyet</h3>\n                        Genel maliyet, gerçek çeviri metinleri olmadan asistan gönderdiğiniz istem mesajının maliyetidir. Maliyet, istem mesajındaki token sayısına göre hesaplanır. Ne kadar çok tokenınız varsa, maliyet o kadar yüksek olur.<br>\n                        <b>Mevcut genel maliyet:</b> <span class=\"overheadCost\">0</span> token / istek."],["Are you sure you want to reset the form?","Formu sıfırlamak istediğinizden emin misiniz?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Grubu işlemek istediğinizden emin misiniz?\nBu işlem için maliyet oluşacaktır."],["The batch is successfully created. Do you want to open the batch manager?","Grup başarıyla oluşturuldu. Grup yöneticisini açmak istiyor musunuz?"],["OpenAI Batch API Queue","OpenAI Toplu API Kuyruğu"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transChatGPT/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transChatGPT/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Lütfen çeviriyi uygulamak için satırları seçin"],["Target Column","Hedef Sütun"],["The column to put the translation result.","Çeviri sonucunu koymak için sütun."],["Import translation from ChatGPT Batch","ChatGPT Grubundan çeviri içe aktar"],["Translation applied to selected rows","Seçilen satırlara uygulanan çeviri"],["Invalid format","Geçersiz biçim"],["OK","Tamam"],["Mismatch","Uyuşmazlık"],["Failed to load batch list with error: \n","Toplu listesi yüklenemedi, hata: \n"],["Download Error File","Hata Dosyasını İndir"],["Batch is not completed yet","Toplu işlem henüz tamamlanmadı"],["Are you sure you want to cancel this batch?","Bu toplu işlemi iptal etmek istediğinizden emin misiniz?"],["Cannot cancel completed batch.","Tamamlanmış toplu işlem iptal edilemez."],["Batch cancelled","Toplu işlem iptal edildi"],["Failed to cancel batch","Toplu işlem iptal edilemedi"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","Toplu İşlemler"],["Apply translation","Çeviriyi uygula"],["Cancel batch","Toplu işlemi iptal et"],["Status","Durum"],["Batch ID","Toplu İşlem Kimliği"],["Input File ID","Girdi Dosya Kimliği"],["End point","Uç nokta"],["Created at","Oluşturulma tarihi"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Son kullanma tarihi <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Zamanında tamamlanmayan toplu işlemler sonunda süresi dolmuş duruma geçer; bu toplu işlemdeki tamamlanmamış istekler iptal edilir ve tamamlanmış isteklere yanıtlar, toplu işlemin çıktı dosyası üzerinden kullanılabilir hale getirilir. Tamamlanmış isteklerden tüketilen tokenlar için ücretlendirilirsiniz.\"></i>"],["Completed at","Tamamlanma tarihi"],["Errors","Hatalar"],["Batch Item Detail of","Toplu İşlem Öğesi Detayı"],["ID","Kimlik"],["Completed on","Tamamlandığı tarih"],["Model","Model"],["Prompt Token","İstek Token'ı"],["Completion Token","Tamamlama Token'ı"],["Total Token","Toplam Token"],["Status Code","Durum Kodu"],["error","hata"],["Conversation","Konuşma"],["Response Validation","Yanıt Doğrulama"],["Raw Payload","Ham Yük"],["View raw payload","Ham yükü görüntüle"],["Response Preview","Yanıt Önizleme"],["Apply translations from selected rows","Seçili satırlardan çevirileri uygula"],["Here you can edit the translation result individually and send it into Translator++","Burada çeviri sonucunu tek tek düzenleyebilir ve Translator++'a gönderebilirsiniz"],["Open ChatGPT Settings","ChatGPT Ayarlarını Aç"],["Help","Yardım"],["File list","Dosya listesi"],["Collapse / restore left panel","Sol paneli daralt / geri yükle"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Zamanında tamamlanmayan toplu işlemler sonunda süresi dolmuş duruma geçer; bu toplu işlemdeki tamamlanmamış istekler iptal edilir ve tamamlanan isteklere yanıtlar, toplu işlemin çıktı dosyası üzerinden kullanılabilir hale getirilir. Tamamlanan isteklerden tüketilen token'lar için ücretlendirilirsiniz."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","OpenAI Sohbet"],["Target URL","Hedef URL"],["Target end point. You can use any service that supports OpenAI API.","Hedef uç noktası. OpenAI API'yi destekleyen herhangi bir hizmeti kullanabilirsiniz."],["Sample endpoints","Örnek uç noktalar"],["Use this endpoint","Bu uç noktayı kullan"],["Copy to clipboard","Panoya kopyala"],["e.g.","örn."],["API Key","API Anahtarı"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","API Anahtarınızı buraya girin.<br>API anahtarını alma yöntemi her hizmet için farklıdır.<br>"],["Leave it blank if the service doesn't require API key.","Hizmet API anahtarı gerektirmiyorsa boş bırakın."],["Model","Model"],["The pre-trained model","Önceden eğitilmiş model"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","OpenAI için, kullanılacak izin verilen modeli ayarlamanız gerekebilir (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","Bağlamı Etkinleştir"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Çeviri için bağlamı etkinleştir. Mevcut parti üzerindeki daha önce çevrilmiş materyal bağlam olarak dahil edilecektir. <b>Ayrıca bağlamı şablona açıkça dahil etmeniz gerekir</b>"],["Context Character Limit","Bağlam Karakter Sınırı"],["Character limit for the context.","Bağlam için karakter sınırı."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, chatGPT asistanınızın rolünün ne olduğunu söyleyen mesajın başlığıdır. Bu mesaj, chatGPT'ye gönderdiğiniz her partinin en ilk mesajı olarak gönderilecektir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Şablon Değişmez stiliyle aşağıdaki değişkenleri dahil edebilirsiniz <span class='inlineCode'><b>${</b>DEĞİŞKEN<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yedeği).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Toplu işteki mesaj sayısı.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Oyuncu bilgileri sözlüğü. (Yalnızca toplu modda oyuncu bilgisi seçeneği etkinse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERENCE[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Önceki çevirinin bağlamı (bağlam etkinse)</li>"],["Sample conversation","Örnek konuşma"],["User message","Kullanıcı mesajı"],["Assistant's response","Asistanın yanıtı"],["Body Message Template","Gövde Mesajı Şablonu"],["Template of the body of your chat.","Sohbetinizin gövdesinin şablonu."],["Enable JailBreak","JailBreak'i Etkinleştir"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Çeviri için Jailbreak'i etkinleştirin. Bu, çeviriyi daha doğru ve daha az önyargılı hale getirecektir. Bazı modeller kurgusal olayları gerçek hayat olaylarıyla ilişkilendirmek isteyebilir, bu nedenle kendi anlatılarına uyacak şekilde çeviriyi değiştirmeye çalışırlar. Bu seçenek bunu önleyecektir."],["Jailbreak Template","Jailbreak Şablonu"],["Template of the Jailbreak message.","Jailbreak mesajının şablonu."],["Maximum Tokens","Maksimum Token"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Tamamlamada oluşturulacak maksimum token sayısı.<br>İsteminizin token sayısı artı max_tokens, modelin bağlam uzunluğunu aşamaz. Çoğu model 2048 token bağlam uzunluğuna sahiptir (en yeni modeller hariç, bunlar 4096 destekler)."],["Temperature","Sıcaklık"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0 ile 2 arasında kullanılacak örnekleme sıcaklığı. 0.8 gibi yüksek değerler çıktıyı daha rastgele yaparken, 0.2 gibi düşük değerler daha odaklı ve belirleyici yapar. <br>OpenAI genellikle bunu veya top_p'yi değiştirmeyi önerir, ancak ikisini birden değil."],["Nucleus sampling (top_p)","Çekirdek örnekleme (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Sıcaklıkla örneklemeye alternatif, çekirdek örnekleme adı verilen, modelin top_p olasılık kütlesine sahip tokenların sonuçlarını dikkate aldığı yöntem. Yani 0.1, yalnızca en yüksek %10 olasılık kütlesini oluşturan tokenların dikkate alındığı anlamına gelir. <br>OpenAI genellikle bunu veya sıcaklığı değiştirmeyi önerir, ancak ikisini birden değil."],["Frequency Penalty","Frekans Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni tokenları metindeki mevcut frekanslarına göre cezalandırır, böylece modelin aynı satırı kelimesi kelimesine tekrarlama olasılığını azaltır. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Varlık Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni tokenları metinde daha önce görünüp görünmediklerine göre cezalandırır, böylece modelin yeni konulardan bahsetme olasılığını artırır. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","JSON Şeması Kullan"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Eski <code>json_object</code> yerine <code>response_format.type</code> alanı için <code>json_schema</code> kullanın. <code>json_schema</code>, bazı en yeni modeller ve <b>LM Studio</b> gibi bazı sunucular tarafından gereklidir, ancak bazı eski modeller hala <code>json_object</code> kullanıyor."],["Max Characters per Batch","Toplu Başına Maksimum Karakter"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Çeviri toplu başına maksimum karakter sınırı.\nBu seçenek yalnızca orijinal metnin karakter uzunluğunu sayar, istem mesajının karakter uzunluğunu saymaz."],["Max concurrent requests","Maksimum eşzamanlı istek"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","Aynı anda kaç eşzamanlı isteğin bağlanmasına izin verilir? Her ek eşzamanlı bağlantı, çeviri hızınızı çarpacak, ancak aynı zamanda sağlayıcınızın belirlediği token sınırınızı hızla tüketecektir.<br />Bu özelliği devre dışı bırakmak için <b>0</b> olarak ayarlayın.<br />Çeviri hızını daha da artırmak için bu seçeneği <b>Eşzamanlı istek başına maksimum satır</b> ile birleştirin.<br />Bu seçeneği 1'den fazla yapmak, <b>Bağlam</b>ı etkileyecektir çünkü önceki istek bitmeden bir istek işlenecektir. Bu nedenle, bağlam önceki isteğin çeviri sonucu olmadan gönderilecektir."],["Max row per concurrent requests","Eşzamanlı istek başına maksimum satır"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Her eşzamanlı istek için kaç satıra izin verilir. Bu özelliği devre dışı bırakmak için <b>0</b> olarak ayarlayın.<br />Bu seçenek devre dışı bırakılırsa, <b>Maksimum eşzamanlı istek</b>i ne kadar ayarlarsanız ayarlayın, Translator++ isteği tek bir parça olarak işleyecektir.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Ne kadar çok satır ayarlarsanız, tek bir toplu işte o kadar çok çeviri alabilirsiniz. Böylece ek yük maliyeti azalır ve AI'nın hatalı sonuç döndürme şansı artar.<br />Sayı ne kadar düşükse, çevirinin hata verme olasılığı o kadar az olur ancak ek yük istemleri için ekstra maliyet ödersiniz."],["Preserve translations from invalid returned number of rows","Geçersiz döndürülen satır sayısından çevirileri koru"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","Geçersiz satır sayısına sahip yanıtlardan çevirileri koru.<br />İşaretlenirse, Translator++ satır sayısını düzeltmeye ve çevirileri tabloya eklemeye çalışacaktır.<br />İşaretlenmezse, hücreler boş kalacaktır.<br />Yeniden çeviri amacıyla bu seçeneğin işaretlenmemesi önerilir."],["Batch delay","Toplu gecikme"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","Toplu işlemler arasındaki gecikme (milisaniye cinsinden).<br />Bu ayarı, RPM (dakika başına istek) sınırını aşmamak için isteklerinizi kontrol etmek üzere kullanın."],["Batch Timeout","Toplu zaman aşımı"],["Timeout for each batch in milisecond","Her toplu işlem için zaman aşımı (milisaniye cinsinden)"],["Code Escaping Algorithm","Kod Kaçış Algoritması"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Diyaloglar içindeki satır içi kodlar için kaçış algoritması. Seçtiğiniz kaçış algoritmasına göre <b>Sistem Mesajı Şablonu</b> ve <b>Gövde Mesajı Şablonu</b>'nu değiştirmeniz gerekebilir.<br /><b>JSONCloaking</b> veya <b>JSONObjectCloaking</b> seçildiğinde, <code>response_format: { type: 'json_object' }</code> otomatik olarak gönderilir (<b>JSON Şeması Kullan</b> etkinleştirilmediği sürece, bu durumda JSON şeması gönderilir). <b>JSONCloaking</b> çok doğrudur, ancak tüm modellerle çalışmaz, <b>gpt-3.5-turbo-1106</b>'yı deneyin."],["Number of retry","Yeniden deneme sayısı"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Çeviri çıktısı doğrulaması başarısız olduğunda motorun kaç kez yeniden denemesi gerektiği. Boşsa (nullish), yeniden deneme yapılmaz."],["Retry when the number of translated rows doesn't match original","Çevrilen satır sayısı orijinalle eşleşmediğinde yeniden dene"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Etkinleştirilirse, model orijinal yükten farklı sayıda çeviri satırı döndürdüğünde motor yeniden deneyecektir."],["Retry when the number of lines for each translated row doesn't match original","Her çevrilen satırın satır sayısı orijinalle eşleşmediğinde yeniden dene"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Etkinleştirilirse, herhangi bir çevrilen satırın satır sayısı orijinal satırından farklı olduğunda motor yeniden deneyecektir."],["Prompt: Row count mismatch","İstem: Satır sayısı uyumsuzluğu"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","Satır/öğe sayısı uyumsuzluğu nedeniyle yeniden deneme sırasında kullanılan istem. Kullanılabilir şablon değişkenleri: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","İstem: Satır sayısı uyumsuzluğu"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","Satır başına satır sayısı uyumsuzluğu nedeniyle yeniden deneme sırasında kullanılan istem. Kullanılabilir şablon değişkenleri: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","İstem: Hata / Yeniden deneme talimatı"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","Uyumsuzluk istem(ler)inden sonra eklenen, modeli yeniden denemeye yönlendiren istem. Kullanılabilir şablon değişkenleri: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","Özel Parametre"],["Key","Anahtar"],["Value","Değer"],["Type","Tür"],["Type of the value.","Değerin türü."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b> türü için, değer JavaScript kodu olarak değerlendirilir."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript kodunun kapsamı <code>window</code>'dur. Bu nedenle neredeyse her değeri alabilirsiniz."],["<br />Example: <code>trans.project.title</code>","<br />Örnek: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","API'ye gönderilmeyecek parametreleri düşürün.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API sürekli değişiyor, bazı yeni modeller eski parametreleri desteklemeyebilir ve tanınmayan istek parametreleri için HTTP hatası döndürebilir."],["You can drop the parameters that are not supported by the model here.","Model tarafından desteklenmeyen parametreleri burada düşürebilirsiniz."],["Manage configuration","Yapılandırmayı yönet"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","HTML Gizleme Sarılmış"],["JSONObject Cloaking","JSONObject Gizleme"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","Bu eklenti, Deepseek, LlamaCPP, Google Gemini vb. ve tabii ki OpenAI ChatGPT gibi OpenAI Chat API'yi destekleyen herhangi bir hizmet aracılığıyla çeviri yapmayı sağlar."],["OpenAI API settings","OpenAI API ayarları"],["General","Genel"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Akıl Yürütme Modellerine Paranızı Boşa Harcamayın</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Çeşitli çalışmalar, akıl yürütme modellerinin yaratıcı yazma ve çeviri görevlerinde normal modellerden çok daha kötü olduğunu kanıtlamıştır.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Akıl yürütme modellerini kullanırken daha pahalı maliyet ve daha yavaş yanıt sürelerinden başka bir şey kazanmazsınız.</p>"],["Explore more models","Daha fazla model keşfedin"],["Templates","Şablonlar"],["Enable context","Bağlamı etkinleştir"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["Add Example: Translate Japanese to English","Örnek Ekle: Japoncadan İngilizceye Çevir"],["Retry prompts","İstemleri yeniden dene"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Bu istemler, önceki model çıktısından hemen sonra, ek <b>kullanıcı</b> mesajları olarak yeniden denemeler sırasında eklenir.</p>"],["<p>Available variables:</p>","<p>Kullanılabilir değişkenler:</p>"],["Enable Jailbreak","Jailbreak'i Etkinleştir"],["Advanced","Gelişmiş"],["Custom Parameters","Özel Parametreler"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API istek gövdesine özel parametreler ekleyebilirsiniz. Bu, formda mevcut olmayan ek parametreler eklemek istediğinizde kullanışlıdır."],["<h2>Warning</h2>","<h2>Uyarı</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Özel parametreleri yanlış ayarlamak API isteğinin başarısız olmasına neden olabilir. Özel parametre eklemeden önce ne yaptığınızı bildiğinizden emin olun. OpenAI gibi bazı hizmetler gönderdiğiniz parametreler konusunda katıdır ve tanınmayan istek parametreleri için HTTP hatası döndürürler.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Aynı anahtar birden fazla kez kullanılırsa, sadece son değer kullanılır.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Mevcut yapılandırmada aynı anahtar kullanılırsa, mevcut yapılandırma parametresi özel parametre tarafından üzerine yazılır.</li>"],["Drop Parameters","Parametreleri Bırak"],["Open chatGPT tester","ChatGPT test cihazını aç"],["Batch Translation Setting","Toplu Çeviri Ayarları"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Üzgünüm, bu eklenti yalnızca aktif destekçilere açıktır.\nBu özelliği $1 destekçi olarak kilitleyebilirsiniz."],["Preserve invalid returned rows","Geçersiz dönen satırları koru"],["Retries and Refinement","Tekrar Denemeler ve İyileştirme"],["<h2>Retries and Refinement</h2>","<h2>Tekrar Denemeler ve İyileştirme</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Çeviri çıktısı doğrulamayı geçemediğinde, Translator++ modelden çeviriyi tekrar denemesini isteyebilir. Modelin kaç kez tekrar deneyeceğini ve tekrar deneme koşullarını ayarlayabilirsiniz.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Uygun tekrar deneme koşullarıyla makul sayıda tekrar ayarlamak, maliyet ve zamanı kontrol altında tutarken çeviri kalitesini önemli ölçüde artırabilir.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Her tekrar deneme size ek zaman ve para maliyeti getirir</b>. Toplu işiniz sık sık tekrar deniyorsa, model için talimatları daha net hale getirmek amacıyla isteminizi ayarlamak isteyebilirsiniz.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Toplu çevirinizi hata ayıklamak için geliştirici aracını veya Toplu Yönetici'yi kullanın.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Kod Kaçış Algoritması</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Kod kaçışı, MTL'nin diyaloglar içindeki kod parçacıklarını değiştirmesini önlemek için kullanılan bir tekniktir. Bu, diyaloglarınızda HTML etiketleri, XML etiketleri, JSON nesneleri veya JavaScript şablonları gibi kod parçacıkları içerdiğinde kullanışlıdır.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Diyaloglarınızın içindeki kod parçacıklarına uyan kaçış algoritmasını seçin. <b>Sistem mesajı</b>, <b>Örnek istem</b> ve <b>Gövde mesajı</b> şablonlarını buna göre ayarlamanız gerekebilir.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Kod kaçış algoritmaları ve bunları etkili kullanma hakkında daha fazla bilgi için <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>buraya</a> tıklayın.</p>"],["Default","Varsayılan"],["JavaScript template cloaking","JavaScript şablonu gizleme"],["None (no escaping)","Hiçbiri (kaçış yok)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Seçilen kaçış algoritması için örnek diyalog ön ayarını yüklemek istiyor musunuz? Bu, mevcut örnek diyaloğunuzun üzerine yazacaktır."],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her toplu iş için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının başka dosyalarla karışmamasını sağlayabilir."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgisinden oyuncu adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Aktör Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ aktör referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Aktör referansı, diyalogdaki aktörün adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler her parti öğesi için sözlük olarak yüklenecektir. Aktör referansını istem mesajına yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, karakter bilgisi verisini yerleştirmek için istem şablonuna <code>ACTOR_INFO</code> değişkenini de eklemeniz gerekir."],["Actor Reference Translation Column","Aktör Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin bulunduğu sütun. Bu sütun, aktör referansının çevirisi olarak kullanılacaktır. Bu, konuşmadaki aktör adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Aktörün Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş vb. daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Extra Prompt","Ek İstem"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İstem mesajına eklenecek ek istem. Bu, sistem mesajından sonra ve gerçek istem mesajından önce eklenecektir."],["<br />","<br />"],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her parti için her zaman ayrı dosya"],["Append actor name to the translatable text","Çevrilebilir metne aktör adını ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, isteme otomatik olarak bir sözlük eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her parti öğesi için yüklenecektir. Özellik, isteminizi şişirmemek için sadece ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgi Sütunu"],["Prompt","İstem"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":false,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"relPath":"/addons/transChatGPT/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":160,"length":160,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>G</u>önder"],["Toggle word wrap","Sözcük kaydırmayı aç/kapat"],["Open debugger (F12)","Hata ayıklayıcıyı aç (F12)"],["Help","Yardım"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Bu özellik yalnızca Translator++'ın Geliştirici sürümünü kullanıyorsanız kullanılabilir. Temel Araçlar -> Çekirdek NWJS'yi Değiştir'i kullanarak Geliştirici sürümüne geçebilirsiniz."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>AKTÖR_BİLGİSİ : Aktör bilgileri sözlüğü.(Yalnızca toplu modda aktör bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluştur. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>BAĞLAM : Önceki çevirinin bağlamı (bağlam etkinleştirilmişse)</li>"],["Sample conversation","Örnek konuşma"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. İyi veya kötü yanıtların bir örneğini yazarak çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olabilirsiniz.</p>"],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her toplu işlem için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının diğer dosyalarla karışmamasını sağlayabilir."],["Add actor name","Aktör adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgisinden aktör adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra aktör adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Aktör Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ aktör referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Aktör referansı, diyalogdaki aktörün adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Yalnızca konuşmada bulunan karakterler her toplu öğe için sözlük olarak yüklenecektir. Aktör referansını istem mesajında yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>AKTÖR_BİLGİSİ</code> değişkenini de eklemeniz gerekir."],["Actor Reference Translation Column","Aktör Referans Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin sütunu. Bu sütun, aktör referansının çevirisi olarak kullanılacaktır. Bu, konuşmada aktör adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Aktörün Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş vb. daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Extra Prompt","Ek İstem"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İstem mesajına eklenecek ek istem. Bu, sistem mesajından sonra ve gerçek istem mesajından önce eklenecektir."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her grup için her zaman ayrı dosya"],["Append actor name to the translatable text","Aktör adını çevrilebilir metne ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, isteme otomatik olarak bir sözlük eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her öğe grubu için yüklenecektir. Özellik, isteminizi şişirmemek için yalnızca ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgileri Sütunu"],["Prompt","İstem"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transChatGPT/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","ChatGPT API ile Sohbet"],["Batch Manager","Grup Yöneticisi"],["This feature is only available if you have a project open.","Bu özellik yalnızca bir proje açıksa kullanılabilir."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transChatGPT/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","DazedMTLTool'u kurmak istiyor musunuz?"],["Ignore if already translated","Zaten çevrilmişse yoksay"],["OpenAI Translation with DazedMTL","DazedMTL ile OpenAI Çevirisi"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":false,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"relPath":"/addons/transDazedMTL/transdazedmtl.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","DeepL sunucusu kurulu değil. Şimdi kurmak istiyor musunuz?"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":false,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/transDeepl/DeepLUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","Karakter kullanımı:\n"],["Failed to fetch quota: ","Kota alınamadı: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":false,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"relPath":"/addons/transDeeplPro/deepl-pro.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>G</u>önder"],["Toggle word wrap","Sözcük kaydırmayı aç/kapat"],["Open debugger (F12)","Hata ayıklayıcıyı aç (F12)"],["Help","Yardım"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Bu özellik yalnızca Translator++'ın Geliştirici sürümünü kullanıyorsanız kullanılabilir. Temel Araçlar -> Çekirdek NWJS'yi Değiştir'i kullanarak Geliştirici sürümüne geçebilirsiniz."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluştur. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>Yerel Gemini API</h2><p>Bu motor çeviri için Google Gemini yerel API'sini kullanır. <br />Ayrıca Google Gemini için OpenAI eklentisini de kullanabilirsiniz. OpenAI eklentisinde daha fazla özellik vardır, bu yüzden <b style='color:green;'>OpenAI eklentisini kullanmanızı öneririm</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI, OpenAI kütüphanesinden bazı modüller gerektirir. Lütfen <b>transChatGPT (Translator++ için ChatGPT)</b> eklentisinin kurulu olduğundan emin olun."],["Explore more models","Daha fazla model keşfet"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"relPath":"/addons/transGemini/gemini.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","özelModeller.özelEtiket"],["model","model"],["|","|"],["promptLibrary","komutKütüphanesi"],["search","ara"],["downloadChat","sohbetİndir"],["newChat","yeniSohbet"],["api","api"],["customEndpoint","özelUçNokta"],["apiEndpoint.inputLabel","apiUçNoktası.girişEtiketi"],["apiKey.inputLabel","apiAnahtarı.girişEtiketi"],["apiVersion.inputLabel","apiSürümü.girişEtiketi"],["apiVersion.description","apiSürümü.açıklama"],["secu