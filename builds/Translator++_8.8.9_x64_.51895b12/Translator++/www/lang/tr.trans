r.özelEtiket"],["model","model"],["|","|"],["promptLibrary","istekKütüphanesi"],["search","ara"],["downloadChat","sohbetİndir"],["newChat","yeniSohbet"],["api","api"],["customEndpoint","özelUçNokta"],["apiEndpoint.inputLabel","apiUçNoktası.girişEtiketi"],["apiKey.inputLabel","apiAnahtarı.girişEtiketi"],["apiVersion.inputLabel","apiSürümü.girişEtiketi"],["apiVersion.description","apiSürümü.açıklama"],["securityMessage","güvenlikMesajı"],["apiEndpoint.description","apiUçNoktası.açıklama"],["apiEndpoint.warn","apiUçNoktası.uyarı"],["partialImportMessages","kısmiİçeAktarMesajları"],["import","içeAktar"],["name","isim"],["prompt","istem"],["clearPrompts","istemleriTemizle"],["morePrompts","dahaFazlaİstem"],["toast.sync","bildirim.senkronize"],["toast.stop","bildirim.durdur"],["button.sync","düğme.senkronize"],["button.stop","düğme.durdur"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/