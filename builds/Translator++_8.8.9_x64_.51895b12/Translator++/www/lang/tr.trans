x/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":false,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"relPath":"/find.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":25,"length":25,"percent":100},"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","Veriyle ilgili dosya bulunamadı"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Bunu düzeltmek için <a href=\"#\" class=\"openProjectProperties\">Proje özellikleri</a>'ndeki <b>Ham madde konumu</b> alanını düzeltin"],["Copy path to clipboard","Yolu panoya kopyala"],["Path has been copied to clipboard.","Yol panoya kopyalandı."],["Open folder","Klasörü aç"],["Open with external application","Harici uygulamayla aç"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","Şununla aç..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":false,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"relPath":"/js/RawViewer.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~varsayılan çeviriyi kullan~"],["Column","Sütun"],["Do you want to delete all context translation on the currently selected row?","Şu anda seçili satırdaki tüm bağlam çevirilerini silmek istiyor musunuz?"],["Do you want to delete all translation on the currently active row?","Şu anda aktif satırdaki tüm çevirileri silmek istiyor musunuz?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":false,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"relPath":"/js/TranslationByContext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","geçersiz tür addonObj"],["invalid type addonObj.addons","geçersiz tür addonObj.addons"],["You are not eligible to get this addon","Bu eklentiyi almaya uygun değilsiniz"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":false,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"relPath":"/js/addon.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Translator++'a kısayol oluşturmadan önce mevcut projeyi kaydetmelisiniz"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Bu özellik yalnızca Translator++'ın Geliştirici sürümünü kullanıyorsanız kullanılabilir. Temel Araçlar -> Çekirdek NWJS'yi Değiştir'i kullanarak Geliştirici sürümüne geçebilirsiniz."]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/automationEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/find.js":{"data":[["Action","Eylem"],["Append tags","Etiketleri ekle"],["Remove tags","Etiketleri kaldır"],["Set tags","Etiketleri ayarla"],["Do nothing","Hiçbir şey yapma"],["Close","Kapat"],["Proceed","Devam et"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","Anahtar kelime çok kısa!\nTüm satırları mı aramaya çalışıyorsunuz? Anahtar kelime olarak yıldız '*' kullanmayı deneyin."],["Found nothing!<br />Don't forget to set the Target search field.","Hiçbir şey bulunamadı!<br />Hedef arama alanını ayarlamayı unutmayın."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","Değiştirilecek hiçbir şey bulunamadı!<br />Değiştirme işlevi anahtar sütununda hiçbir şeyi değiştirmez."],["Replace '","'"],["' with '","' ile '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","' değiştirilsin mi?\r\nBu işlem için henüz geri alma işlevi oluşturmadık!\nDevam etmek istediğinizden emin misiniz?"],["click to go","gitmek için tıkla"],["This will replace any translation found in target colum,\nAre you sure?","Bu, hedef sütunda bulunan herhangi bir çeviriyi değiştirecektir,\nEmin misiniz?"],["Keyword too short!","Anahtar kelime çok kısa!"],["Not found!","Bulunamadı!"],["Are you sure want to execute the following script?","Aşağıdaki betiği çalıştırmak istediğinizden emin misiniz?"],["For ","İçin "],[" selected item(s)?"," seçili öğe(ler)?"],[" Select all"," Tümünü seç"],[" Invert selection"," Seçimi ters çevir"],[" Clear selection"," Seçimi temizle"],[" Set Red tag","Kırmızı etiket ayarla"],[" Set Yellow tag","Sarı etiket ayarla"],[" Set Green tag","Yeşil etiket ayarla"],[" Set Blue tag","Mavi etiket ayarla"],[" Set Gold tag","Altın etiket ayarla"],[" More tags...","Daha fazla etiket..."],[" Clear tags","Etiketleri temizle"],[" Create Automation","Otomasyon oluştur"],[" Run Automation","Otomasyonu çalıştır"],[" Clear Automation","Otomasyonu temizle"],["Are you sure want to clear all quick launch scripts?","Tüm hızlı başlatma betiklerini temizlemek istediğinize emin misiniz?"],[" Clear translation","Çeviriyi temizle"],["Do you want to clear translations of the selected items?","Seçili öğelerin çevirilerini temizlemek istiyor musunuz?"],[" Delete rows","Satırları sil"],["Do you want to remove selected rows?\nYou can not undo this action!","Seçili satırları kaldırmak istiyor musunuz?\nBu işlem geri alınamaz!"],[" With selection ...","Seçimle..."],["Always on top","Her zaman üstte"],["Default","Varsayılan"],["Blur opacity","Bulanıklık opaklığı"],["Type regex with the modifier","Değiştirici ile regex yazın"],["Use $n to replace a group. e.g. $1","$n kullanarak bir grubu değiştirin. Örneğin: $1"],["Find","Bul"],["Replace","Değiştir"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":false,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"relPath":"/js/find.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":46,"percent":100},"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","Şifreyi gizle"],["Show password","Şifreyi göster"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":false,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"relPath":"/js/jsonform.ext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","Bazı yapılandırmaların etkili olması için uygulamayı yeniden başlatmanız gerekebilir.\nLütfen çalışmanızı kaydedin ve Translator++'ı yeniden başlatın."],["Pleae select the name for your configuration.","Lütfen yapılandırmanız için bir ad seçin."],["Translator Engine configuration","Çeviri Motoru yapılandırması"],["Translator engine version.","Çeviri motoru sürümü."],["By.","Tarafından."],["No option for this engine","Bu motor için seçenek yok"],["License","Lisans"],["Can not disable this addon","Bu eklentiyi devre dışı bırakamazsınız"],["Requirements","Gereksinimler"],["What is this?","Bu nedir?"],["Uninstall","Kaldır"],["Update","Güncelle"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","Eklenti başarıyla kuruldu.\r\nBazı eklentilerin etkili olması için Translator++'ın yeniden başlatılması gerekebilir."],["WARNING!\n","UYARI!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","Bu eklenti \"ayrıştırıcı değişikliği\" olarak işaretlenmiştir. Bu eklentiyle ilgili eski projeniz beklenildiği gibi çalışmayabilir. Bu eklentiyi kurmadan önce projenizi yedeklemeniz önerilir.\nMevcut çevirilerinizi yeni oluşturulan projeye aktarabilirsiniz.\n\nKurmak istiyor musunuz?"],["Do you want to install ","Kurulum yapmak istiyor musunuz? "],["Add-on","Eklenti"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","başarıyla kuruldu.\r\nBazı eklentilerin etkin olması için Translator++'ın yeniden başlatılması gerekebilir."],["Add-on version.","Eklenti sürümü."],["No option for this add-on","Bu eklenti için seçenek yok"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++ Windows kayıt defterine yazacak.\r\nEmin misiniz?"],["Error parsing patterns:","Desenler ayrıştırılırken hata:"],["Do you really want to clear the custom escaper?","Özel kaçış karakterini gerçekten temizlemek istiyor musunuz?"],["Do you really want to reset the custom escaper?","Özel kaçış karakterini gerçekten sıfırlamak istiyor musunuz?"],["You are currently on the latest version.\nDo you still want to update?","Şu anda en son sürümdesiniz.\nYine de güncellemek istiyor musunuz?"],["This option will open your default browser to login.\nDo you want to continue?","Bu seçenek, oturum açmak için varsayılan tarayıcınızı açacaktır.\nDevam etmek istiyor musunuz?"],["Login with Browser","Tarayıcı ile Giriş Yap"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","Tarayıcınız <b>dreamsavior.net/gettoken/</b> adresine açıldı.<br>Giriş yaptığınızda oturum otomatik olarak tamamlanacaktır.<br><br>Otomatik giriş çalışmazsa, token'ınızı o sayfadan kopyalayıp aşağıya yapıştırın:"],["There is no default translator selected.\nChange the default translator to Google!","Varsayılan çevirmen seçilmedi.\nVarsayılan çevirmeni Google'a değiştirin!"],["Change Stagging Path to :","Stagging Yolunu Şuna Değiştir:"],["Move the content of current Stagging Path into the new one?","Mevcut Stagging Yolunun içeriğini yeni yola taşıyayım mı?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","Eklenti(ler) kuruldu.\nEtkin olması için Translator++'ın yeniden başlatılması gerekiyor."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","Tüm ayarları gerçekten temizleyip Translator++'ı varsayılana sıfırlamak istiyor musunuz?\nLütfen bu işlemin geri alınamaz olduğunu unutmayın.\nDevam etmeden önce projenizi yedekleyin."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","Hatayı düzeltmezseniz Translator++ normal çalışmayabilir.\nSeçenekler penceresini kapatmak istiyor musunuz?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":false,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"relPath":"/js/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Translator++'a kısayol oluşturmadan önce mevcut projeyi kaydetmelisiniz."],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Bu özellik yalnızca Translator++'ın Geliştirici sürümünü kullanıyorsanız mevcuttur. Temel Araçlar -> Çekirdek NWJS'yi Değiştir'i kullanarak Geliştirici sürümüne geçebilirsiniz."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/scriptEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>PHP Yorumlayıcısı çalıştırılamıyor!</b><br />\n\t\t\t\tTranslator++ bazı zorunlu işlemleri çalıştırmak için PHP CLI'ya ihtiyaç duyar.<br />\n\t\t\t\tBu hata genellikle bilgisayarınızda <b><a href=\"http://dreamsavior.net/download/#TPPSysreq\">doğru sürüm Microsoft Visual C++ yeniden dağıtılabilir bileşeninin</a> kurulu olmamasından</b> kaynaklanır.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Lütfen <a href=\"http://dreamsavior.net/download/#TPPSysreq\">gerekli çalışma zamanını</a> kurun.</li>\n\t\t\t\t\t\t<li>Ve tüm çalışma zamanlarını kurduysanız ve hala bu hatayı alıyorsanız, lütfen Translator++ kurulum dizinini başka bir klasöre taşıyın.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tBu belirti hakkında daha fazla bilgi için lütfen <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>belgelendirmeyi</a> kontrol edin."],["Initialization Error!","Başlatma Hatası!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":false,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"relPath":"/js/sys.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/trans.js":{"data":[["Original Text","Orijinal Metin"],["Initial","Başlangıç"],["Machine translation","Makine çevirisi"],["Better translation","Daha iyi çeviri"],["Best translation","En iyi çeviri"],["Loading","Yükleniyor"],["Error!","Hata!"],["Error processing init file : ","Başlatma dosyası işlenirken hata: "],["Error! File list not found in init file at : ","Hata! Başlatma dosyasında dosya listesi bulunamadı: "],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","Bu, oyununuzun başarıyla ayrıştırılmadığı anlamına gelir. Bu sorun için olası çözüm için lütfen https://dreamsavior.net/?p=1311 adresini ziyaret edin."],["Done!","Tamamlandı!"],["All done!","Hepsi tamamlandı!"],["Error opening file : ","Dosya açılırken hata: "],["error opening file (open): ","dosya açılırken hata (aç): "],["Project properties - Staging path error!","Proje özellikleri - Hazırlama yolu hatası!"],["Project properties","Proje özellikleri"],["untitled project","adsız proje"],["create file list","dosya listesi oluştur"],["Finished","Tamamlandı"],["All process finished!","Tüm işlemler tamamlandı!"],["Open Explorer","Explorer'ı Aç"],["Opening file!","Dosya açılıyor!"],["Assigning new staging path : ","Yeni hazırlama yolu atanıyor : "],["Success!","