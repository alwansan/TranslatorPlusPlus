{"data":[[null]],"columns":[{"readOnly":false,"wordWrap":true,"width":200},{"readOnly":false,"wordWrap":true,"width":50},{"readOnly":false,"wordWrap":true,"width":134},{"readOnly":false,"wordWrap":true,"width":120},{"readOnly":false,"wordWrap":true,"width":109}],"colHeaders":["Original Text","Initial","Machine translation","Better translation","Best translation"],"project":{"indexOriginal":0,"gameEngine":"APPUI","files":{"/addons/VNTextPatch/vntextpatch.js":{"data":[["I have extracted the game data","Oyun verilerini çıkardım"],["Load game's data folder","Oyunun veri klasörünü yükle"],["Select the game's data folder","Oyunun veri klasörünü seç"],["Engine Info","Motor Bilgisi"],["Currently detected engine","Şu anda algılanan motor"],["Manually Specify Format","Formatı Manuel Belirt"],["Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.","Oyun formatını manuel olarak belirtin.<br />VNTranslationTools, dosya uzantısına göre formatı otomatik olarak algılar. Ancak, belirsiz dosya uzantılarıyla karşılaşırsanız, lütfen formatı açıkça belirtin."],["Interface","Arayüz"],["VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.","VNTextPatch oyunu iki formatta ayrıştırabilir: JSON veya XLSX elektronik tablosu. Lütfen kullanmak istediğiniz arayüzü seçin."],["Warning: There is a row limit if you're choosing XLSX spreadsheet.","Uyarı: XLSX elektronik tablosunu seçerseniz bir satır sınırı vardır."],["Create a new project","Yeni bir proje oluştur"],["Invalid destination directory:","Geçersiz hedef dizin:"],["Close","Kapat"],[null,null,null,null,null]],"context":[["tid/8164/type/StringLiteral"],["tid/8228/type/StringLiteral"],["tid/8233/type/StringLiteral"],["tid/8246/type/StringLiteral"],["tid/8251/type/StringLiteral"],["tid/8256/type/StringLiteral"],["tid/8261/type/StringLiteral"],["tid/8266/type/StringLiteral"],["tid/8271/type/StringLiteral"],["tid/8276/type/StringLiteral"],["tid/8455/type/StringLiteral"],["tid/8516/type/NoSubstitutionTemplate"],["tid/11110/type/StringLiteral"]],"basename":"vntextpatch.js","dirname":"/addons/VNTextPatch","extension":".js","filename":"vntextpatch.js","path":"/addons/VNTextPatch/vntextpatch.js","indexIsBuilt":true,"indexIds":{"I have extracted the game data":0,"Load game's data folder":1,"Select the game's data folder":2,"Engine Info":3,"Currently detected engine":4,"Manually Specify Format":5,"Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.":6,"Interface":7,"VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.":8,"Warning: There is a row limit if you're choosing XLSX spreadsheet.":9,"Create a new project":10,"Invalid destination directory:":11,"Close":12},"tags":[],"relPath":"/addons/VNTextPatch/vntextpatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[],"lastSelectedCell":[0,0]},"/addons/actionEditorParser/ae4parser.js":{"data":[["Start translation from Action Editor 4 Game","Action Editor 4 Game'dan çeviriye başla"],["Create Project","Proje Oluştur"]],"context":[["tid/920/type/StringLiteral"],["tid/997/type/StringLiteral"]],"basename":"ae4parser.js","dirname":"/addons/actionEditorParser","extension":".js","filename":"ae4parser.js","path":"/addons/actionEditorParser/ae4parser.js","indexIsBuilt":false,"indexIds":{"Start translation from Action Editor 4 Game":0,"Create Project":1},"tags":[],"relPath":"/addons/actionEditorParser/ae4parser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/adminTools/!post.html":{"data":[["Actions","Eylemler"],["Build for 32bit system","32 bit sistem için oluştur"],["Build for non developer build too","Geliştirici olmayan derleme için de oluştur"],["Custom Version","Özel Sürüm"],["Custom version (leave blank to autogenerate version)","Özel sürüm (otomatik oluşturulması için boş bırakın)"],["Generate minor versioning?","Küçük sürüm oluşturulsun mu?"],["Save patch to","Yamayı kaydet"],["Destination folder of generated patch","Oluşturulan yamanın hedef klasörü"],["Overider template","Geçersiz kılma şablonu"],["Release template","Yayın şablonu"],["Select file to be available live and excluded from the package","Paket dışında bırakılacak ve çevrimiçi kullanılabilir olacak dosyayı seçin"],["The file will be excluded from package, but available online","Dosya paketten hariç tutulacak, ancak çevrimiçi kullanılabilir olacak"],["Make the process does not require user input","İşlemin kullanıcı girişi gerektirmemesini sağla"],["Patch Type","Yama Türü"],["The file will be excluded from package, but available online. Select the file you want to substitute.","Dosya paketten hariç tutulacak, ancak çevrimiçi kullanılabilir olacak. Yerine geçmek istediğiniz dosyayı seçin."],["Substitute trans.js with a fake one.","trans.js'yi sahte bir dosyayla değiştir."],["Select Patch File","Yama Dosyasını Seç"],["Select the generated patch file (*.tpch).","Oluşturulan yama dosyasını (*.tpch) seçin."],["Patches Links","Yama Bağlantıları"],["Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.","Otomatik güncelleme bu bağlantılardan indirecektir. <b>Doğrudan indirme bağlantısı olmalı!</b> Her indirme bağlantısını yeni satırla ayırın."],["Download Links","İndirme Bağlantıları"],["Downloadable package for manual download. Separate each download link with newline.","Manuel indirme için indirilebilir paket. Her indirme bağlantısını yeni satırla ayırın."],["Release Category","Yayın Kategorisi"],["Category of the release.","Yayının kategorisi."],["Upload log along with this submission.","Bu gönderiyle birlikte günlük yükle."],["Remove the same version found on database.","Veritabanında bulunan aynı sürümü kaldır."],["Whether this release is enabled or not.","Bu sürümün etkin olup olmadığı."],["Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.","Bu sürümün gizli olup olmadığı. Bir sürüm gizliyse, yalnızca Yöneticiler ve <code>view_hidden_releases</code> (Geliştirici) yetkisine sahip üyeler paket yükleyici aracılığıyla sürümü yükleyebilir."],["Release Name","Sürüm Adı"],["Release Number","Sürüm Numarası"],["Release Date","Sürüm Tarihi"],["Release Key","Sürüm Anahtarı"],["Release Type","Sürüm Türü"],["CRC","CRC"],["Required Version","Gerekli Sürüm"],["Minimum Version","Minimum Sürüm"],["Release Note","Sürüm Notu"],["Release Info","Sürüm Bilgisi"],["On Before Install","Yüklemeden Önce"],["On After Install","Yüklemeden Sonra"],["Extra parameters","Ek parametreler"],["Remote file","Uzak dosya"],["List of remote file, separate by new line","Uzak dosya listesi, yeni satırla ayrılmış"],["Patron Level","Destekçi Seviyesi"],["Post title","Gönderi başlığı"],["Release post","Yayın gönderisi"],["Excerpt of the post","Gönderi özeti"]],"context":[["idx/0/innerText","idx/14/innerText","idx/29/innerText","idx/79/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/16/innerText"],["idx/5/innerText","idx/17/innerText"],["idx/6/innerText","idx/18/innerText"],["idx/7/innerText","idx/19/innerText"],["idx/8/innerText","idx/20/innerText"],["idx/9/innerText","idx/21/innerText"],["idx/10/innerText","idx/22/innerText"],["idx/11/innerText","idx/25/innerText"],["idx/12/innerText"],["idx/13/innerText","idx/28/innerText"],["idx/23/innerText"],["idx/26/innerText"],["idx/27/inn