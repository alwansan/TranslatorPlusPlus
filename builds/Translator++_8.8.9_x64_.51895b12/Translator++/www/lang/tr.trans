ated":14,"length":14,"percent":100},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string","Geçersiz dil dizesi"],["Required field Project ID is blank!","Zorunlu alan Proje Kimliği boş!"],["Required field Service Account Key is blank!","Zorunlu alan Hizmet Hesabı Anahtarı boş!"],["Required field Server Location is blank!","Zorunlu alan Sunucu Konumu boş!"],["Required field Location of the glossary file is blank!","Zorunlu alan Sözlük dosyasının konumu boş!"],["Required field Glossary Languages is blank!","Zorunlu alan Sözlük Dilleri boş!"],["Invalid glossary language value","Geçersiz sözlük dili değeri"],["Currently active glossary on this project: ","Bu projede şu anda aktif sözlük: "],["Error when retreiving glossary info: ","Sözlük bilgisi alınırken hata: "],["Error when removing glossary : ","Sözlük kaldırılırken hata: "],["Glossary removed successfully.","Sözlük başarıyla kaldırıldı."],["Error when creating glossary : ","Sözlük oluşturulurken hata: "],["Glossary created successfully.","Sözlük başarıyla oluşturuldu."],["Configuration error:\r\n","Yapılandırma hatası:\r\n"],["No error found!","Hata bulunamadı!"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js","Google Cloud Translate Advanced'ı kullanmak için Node JS gereklidir. Lütfen https://node.js adresinden indirip kurun."]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?","JCap çalıştırılabilir dosyası belirtilen konumda bulunamadı. JCap'ı kurmak istiyor musunuz?"],["JCap agent started successfully. Press ","JCap aracısı başarıyla başlatıldı. Basın "],["jcapKey","jcapKey"],["Please set the JCap executable path in the addon settings.","Lütfen JCap çalıştırılabilir dosya yolunu eklenti ayarlarında belirleyin."],["JCap executable already exists at the specified location.","JCap çalıştırılabilir dosyası belirtilen konumda zaten mevcut."],["JCap executable downloaded successfully.","JCap çalıştırılabilir dosyası başarıyla indirildi."],["Failed to download JCap package. Please check the console for details.","JCap paketi indirilemedi. Lütfen ayrıntılar için konsolu kontrol edin."],["JCap executable unpacked successfully.","JCap çalıştırılabilir dosyası başarıyla açıldı."],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.","Artık JCap aracısını Ana Menü - Araçlar - OCR Araçları JCap - JCap Aracısını Başlat'tan başlatabilirsiniz."],["Start JCap OCR Agent","JCap OCR Aracısını Başlat"],["Failed to unpack JCap package. Please check the console for details.","JCap paketi açılamadı. Lütfen ayrıntılar için konsolu kontrol edin."],["JCap executable not found at the specified location.","JCap çalıştırılabilir dosyası belirtilen konumda bulunamadı."],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.","JCap'ı kaldırmak istediğinizden emin misiniz? Bu, JCap çalıştırılabilir dosyasını ve yapılandırmasını silecektir."],["JCap uninstalled successfully.","JCap başarıyla kaldırıldı."],["Failed to uninstall JCap. Please check the console for details.","JCap kaldırılamadı. Lütfen ayrıntılar için konsolu kontrol edin."],["Help","Yardım"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.","JCap OCR, ekrandan metin yakalayıp JCap kullanarak çevirmenizi sağlayan bir OCR aracıdır. Kullanmak için ana menüdeki OCR düğmesine tıklayarak JCap'ı başlatın.\nArdından yapılandırılmış tuşa (varsayılan: F9) basarak metni yakalayın."]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data","JSON verilerini güzelleştir"],["When checked the generated data will be beautified.","İşaretlendiğinde oluşturulan veriler güzelleştirilecektir."],["Start a new translation project from any JSON file.","Herhangi bir JSON dosyasından yeni bir çeviri projesi başlatın."],["Translator++ will translate any translatable texts found in the JSON files.","Translator++, JSON dosyalarında bulunan tüm çevrilebilir metinleri çevirecektir."],["Read the guide on how to start a new JSON translation project here","Yeni bir JSON çeviri projesi nasıl başlatılır rehberini buradan okuyun"],["Translator++ will scan through this folder for any JSON files.","Translator++, bu klasördeki tüm JSON dosyalarını tarayacaktır."],["How do you want to get the data from the JSON object?","JSON nesnesinden verileri nasıl almak istiyorsunuz?"],["Parser mode","Ayrıştırıcı modu"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>","<h2>Basit Mod</h2><p>Basit modda, JSON nesnesi içindeki tüm dize değerlerini yinelemeli olarak çevirebilirsiniz.<br />Basit modda, orijinal metinler her zaman değerdir.</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>","<h2>Gelişmiş Mod</h2><p>Gelişmiş modda, JSON'u sorgulayabilir ve orijinal metnin anahtar olduğu anahtar-değer çiftli çeviri tablosunu işleyebilirsiniz.</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>","<h2>Bilgi</h2><p>JSON nesnesinin belirli bir bölümünü seçmek için aşağıdaki sorgu alanını kullanabilirsiniz. Sorgunun sonucu bir nesne veya metin dizisi olmalıdır.</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>","<h3>Nesneler için</h3><p><b>Anahtar, orijinal metin olarak kullanılacaktır</b> ve <b>değer, varsayılan çeviri olacaktır</b>.</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />","Ayrıştırıcı, değer bir dize, null veya undefined ise otomatik olarak kaydedecektir.<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>","<h3>Diziler için</h3><p>Ayrıştırıcı, dizideki tüm dize değerlerini çevrilebilir metinler olarak kaydedecektir.</p>"],["Start project","Projeyi başlat"],["`Invalid destination directory:\\n${","`Geçersiz hedef dizini:\\n${"],["}`","}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label","etiket"],["is duplicated in the same scenario file","aynı senaryo dosyasında yineleniyor"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory","Dizin seç"],["Select a directory to repack","Yeniden paketlemek için bir dizin seçin"],["Target xp3","Hedef xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.","Dosya adı seçin. <b>patch.xp3</b>, <b>patch2.xp3</b>...gibi özel dosya adları, yüklendiğinde data.xp3'ün önceliğine sahiptir."],["Patch to allow folder structure","Klasör yapısına izin vermek için yama"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.","Varsayılan olarak KAG motoru, xp3 dosyaları içindeki bir klasördeki dosyaları okumaz. Bu seçenek, Config.tjs dosyasına otomatik olarak klasör yapısı tanımı ekler. Config.tjs dosyası bulunmazsa etkisi olmaz."],["Repack into xp3","xp3'e yeniden paketle"],["Close","Kapat"],["Process","İşlem"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.","Birden fazla dosyayı aynı anda açarsanız <b>Sıra önemlidir</b>! Dosyalar sıralı şekilde açılacaktır. Dosyalar mevcutsa üzerine yazılacaktır."],["Unpack XP3 files","XP3 dosyalarını aç"],["Repack a folder to xp3","Bir klasörü xp3'e yeniden paketle"],["Unpack xp3 file","xp3 dosyasını aç"],["Before you create a new project, please make sure that :","Yeni bir proje oluşturmadan önce, lütfen şunları kontrol edin:"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Tüm .ks ve .tjs dosyaları düz metindir (derlenmemiş, şifrelenmemiş ve şifreli değil)"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.","KAG Oyunları, yeniden paketlenmeden de oynanabilir olmalıdır. Bu nedenle, oyununuzun çıkarıldıktan sonra oynanabilir olup olmadığını kontrol etmelisiniz."],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Bazı işlemler oyununuzu değiştirecektir. <b>Bu yüzden oyununuzun yedeğini oluşturduğunuzdan emin olun!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Oyun yürütülebilir dosyasını seçin. Bu dosya, oyun verilerini çıkarmak için kullanılacak ana oyun dosyasıdır."],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.","Translator++, AEC eklentisi ile XP3 dosyalarını çıkarabilir. <b>Ancak çıkarıcı, her türlü XP3 için kesin bir çözüm değildir</b>."],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.","Bazı senaryo dosyaları şifrelidir. Translator++'ın bunları şifresini çözmeyi denemesini istiyorsanız bu seçeneği işaretleyin."],["This may not work on some projects.","Bu, bazı projelerde çalışmayabilir."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Olası karakter kodlamalarının listesi. <b>Sıra önemlidir!</b> Listeyi sıralamak için sürükleyebilirsiniz."],["Literal tags are the tags that will be escaped into Translator++ editor.","Değişmez etiketler, Translator++ düzenleyicisine kaçış yapılacak etiketlerdir."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> zorunludur."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Etiketleri, Translator++ tarafından yeni bir satıra dönüştürülecektir. Bu nedenle <b>[r]</b>'yi açıkça yazmanıza gerek yoktur."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kirikiri betiği (.ks) oldukça özelleştirilebilir ve geliştiricilerin kendi etiketlerini oluşturmasına izin verir."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++, kesme işareti (#) ile başlayan karakter adları gibi standart etiketleri işleyebilir."],["However, Translator++ cannot handle custom tags created by developers.","Ancak, Translator++, geliştiriciler tarafından oluşturulan özel etiketleri işleyemez."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Bu nedenle, çevrilmesi gereken etiketleri ve öznitelikleri ile oyuncu adı olarak işaretlenmesi gerekenleri tanımlamanız gerekebilir."],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.","Projeye başlamadan önce, <input type=\"button\" value=\"xp3 oyununuzu çıkarın\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> ve içindeki ks betiğini analiz etmeniz gerekebilir."],["Create Project","Proje Oluştur"],["Pack a folder into xp3","Bir klasörü xp3'e paketle"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.","Hedef karakter kodlamasını seçin.<br />Çoğu Japonca KAG oyunu SHIFT-JIS ile yazılmıştır, ancak KAG aslında UTF16LE unicode'u destekler. Birçok çevirmen, oyunun yerel ayar öykünücüsü olmadan Japonca olmayan Windows'ta oynanabilir olması için karakter kodlamasını UTF16LE olarak ayarlar. Ve en önemlisi, \"café\" gibi SHIFT-JIS dışındaki karakterleri gösterebilir.<br />Varsayılan olarak Translator++, orijinal karakter kodlamasına yazacaktır."],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference.","KAG için oynanabilir yerelleştirilmiş oyun üretmenin birkaç yolu vardır. Lütfen tercihinize uygun olanı seçin."]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode","Mod Seç"],["Select how do you want to start your project. By selecting files or folders.","Projenize nasıl başlamak istediğinizi seçin. Dosya veya klasör seçerek."],["Select Folder","Klasör Seç"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","İşlem için klasörü seçin. Translator++, belirtilen klasörden PO dosyalarını özyinelemeli olarak alacaktır."],["Select File","Dosya Seç"],["Select the files you want to process.","İşlemek istediğiniz dosyaları seçin."],["Filters","Filtreler"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Dosya adını glob deseniyle filtreleyin. Varsayılan <code>**/*.{po,mo}</code> şeklindedir."],["All .po files in the selected folder and its subfolders.","Seçilen klasördeki ve alt klasörlerindeki tüm .po dosyaları."],["All .mo files in the selected folder and its subfolders.","Seçilen klasördeki ve alt klasörlerindeki tüm .mo dosyaları."],["PO Files","PO Dosyaları"],["MO Files","MO Dosyaları"],["You are about to export the translations as MO files.\n","Çevirileri MO dosyaları olarak dışa aktarmak üzeresiniz.\n"],["- MO files are binary files that cannot be edited manually.\n","- MO dosyaları, elle düzenlenemeyen ikili dosyalardır.\n"],["- Only translated entries are stored in MO files.\n","- MO dosyalarında yalnızca çevrilmiş girdiler saklanır.\n"],["Are you sure you want to proceed?","Devam etmek istediğinizden emin misiniz?"],["PO / MO Files","PO / MO Dosyaları"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.",".po ve .mo dosyaları, özellikle WordPress'te temaları ve eklentileri çevirmek için yazılım yerelleştirmesinde birlikte kullanılan standart metin tabanlı ve ikili dosya formatlarıdır. PO (Portable Object) dosyası, çevirileri içeren insan tarafından okunabilir bir metindir, MO (Machine Object) dosyası ise yazılım tarafından daha hızlı yükleme için kullanılan derlenmiş, makine tarafından okunabilir bir ikili dosyadır."],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts","PO (Portable Object) ve MO (Machine Object) çeviri betiklerinden çeviriye başlayın"],["Create Project","Proje Oluştur"],["Select mode","Mod Seç"],["Select how do you want to start your project. By selecting files or folders.","Projenizi nasıl başlatmak istediğinizi seçin. Dosya veya klasör seçerek."],["Select Folder","Klasör Seç"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","İşlem için klasörü seçin. Translator++, belirtilen klasörden PO dosyalarını özyinelemeli olarak alacaktır."],["Select File","Dosya Seç"],["Select the files you want to process.","İşlemek istediğiniz dosyaları seçin."],["Filters","Filtreler"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Dosya adını glob deseniyle filtreleyin. Varsayılan <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Seçilen klasördeki ve alt klasörlerindeki tüm .po dosyaları."],["All .mo files in the selected folder and its subfolders.","Seçilen klasördeki ve alt klasörlerindeki tüm .mo dosyaları."],["ProjectTitle","ProjeBaşlığı"],["Your project title","Projenizin başlığı"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor","Livemaker Oyun Çıkarıcı"],["Half width character patch","Yarım genişlik karakter düzeltmesi"],["Patch half-width character","Yarım genişlik karakterleri düzelt"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings","Livemaker motorunun dil desteği konusunda sınırlamaları vardır. LiveMaker ve LiveNovel uygulamalarını çalıştırmak için Windows'un Unicode olmayan sistem yerel ayarını Japonca olarak ayarlamayı gerektirir. Ayrıca, motor, yalnızca Windows Shift-JIS (MS CP932) destekleyen yüklü Windows sistem yazı tiplerini kullanacak şekilde sabit kodlanmıştır, bu da diğer yerel ayarları veya kodlamaları desteklemeyebileceği anlamına gelir."],["Next","Sonraki"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?","RPG Maker türü algılanamadı!\nOyunun RPG Maker XP, VX veya VX Ace olduğundan emin misiniz?"],["Create a new project","Yeni bir proje oluştur"],["Invalid destination file:","Geçersiz hedef dosya:"],[" doesn't seems to be a LiveMaker game."," bir LiveMaker oyunu gibi görünmüyor."]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path.","Geliştirme yolu tanımlanmamış.\nGeliştirme yolunu oluşturmak için oyununuzu bir kez enjekte etmelisiniz."],["Decompile all rpyc files","Tüm rpyc dosyalarını ayrıştır"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.","Tüm rpyc dosyalarını .rpy'ye ayrıştırmayı dene.<br />Translator++'ın kendi ayrıştırıcısı vardır. Ancak, Renpy 7 ile oluşturulan bazı oyunları ayrıştırmada bazen başarısız olduğu bildirilmiştir. Bu alanı işaretlemeden bırakabilir ve projeye başlamadan önce oyunu kendi araçlarınızla kendiniz ayrıştırabilirsiniz."],["Overwrite rpy","rpy'yi üzerine yaz"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.","İşaretlenirse, ayrıştırıcı <b>mevcut derlenmemiş rpy dosyalarını üzerine yazar</b>."],["Exclude command","Komutu hariç tut"],["This option will allow us to skip some command for being processed and translated","Bu seçenek, bazı komutların işlenmesini ve çevrilmesini atlamamıza izin verecek"],["Separate entries with a space","Girdileri bir boşlukla ayırın"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored","Örneğin, <b>old</b> koyarsanız, rpy'de <b>old</b> ile başlayan tüm satırlar göz ardı edilecek"],["Are you sure want to start a project without decompiling the rpyc files?","Rpyc dosyalarını ayrıştırmadan bir projeye başlamak istediğinizden emin misiniz?"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?","Seçtiğiniz dosya bir Ren'Py oyun çalıştırılabilir dosyası değil.\nYine de devam etmek istiyor musunuz?"],["Play last build","Son yapıyı oynat"],["Open Ren'Py documentation","Ren'Py belgelerini aç"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","Seçenek, eski ayrıştırıcıyı kullanmak üzere ayarlandı.\nİstediğiniz zaman seçenek menüsü üzerinden yeni ayrıştırıcıya geri dönebilirsiniz."]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator","Windows ikili dosya çeviricisi"],["Parsing Windows binary file with","Windows ikili dosyasını ayrıştırıyor"],["Sellect supported files","Desteklenen dosyaları seç"],["Select supported file type to translate.","Çevrilecek desteklenen dosya türünü seçin."],["Create a new project","Yeni bir proje oluştur"],["Please select a supported file to parse","Lütfen ayrıştırılacak desteklenen bir dosya seçin"],["Please enter your project title!","Lütfen proje başlığınızı girin!"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player","Yerel RPG Oynatıcı Kullan"],["Use native RPG Player instead of Easy RPG Player","Easy RPG Oynatıcı yerine yerel RPG Oynatıcı kullan"],["Use native RPG Player","Yerel RPG Oynatıcı kullan"],["Target folder","Hedef klasör"],["Select destination folder.","Hedef klasörü seçin."],["Install Easy RPG Player","Easy RPG Player'ı Kur"],["Close","Kapat"],["Install","Kur"],["Process completed!","İşlem tamamlandı!"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin.","xmlTrans eklentisi ile RPG Maker 2000 & 2003 Ayrıştırıcısı."],["Play last build","Son derlemeyi oyna"],["Apply translation then play","Çeviriyi uygula ve oyna"],["Setup Easy RPG in the current directory","Mevcut dizinde Easy RPG'yi kur"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine","RM2k / RM2k3 motorundan çeviriye başla"],["Create project","Proje oluştur"],["Please select RPG Maker 2000/2003 game!","Lütfen RPG Maker 2000/2003 oyunu seçin!"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?","RPG Maker türü algılanamadı!\nOyunun RPG Maker 2000 / 2003 olduğundan emin misiniz?"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder","Hedef klasör"],["Select destination folder.","Hedef klasörü seçin."],["Install Easy RPG Player","Easy RPG Player'ı Kur"],["Close","Kapat"],["Install","Kur"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/","Özel yazı tipi nasıl eklenir.\n\nYazı tipleri, oyun dizinindeki Font klasörüne yerleştirilmeli ve Font.ttf veya Font2.ttf olarak adlandırılmalıdır. Hangi yazı tipi dosyasının kullanılacağı, sistem grafik yazı tipi ayarına bağlıdır. Ttf'nin yanı sıra fon ve diğer birçok yazı tipi desteklenir (FreeType tarafından desteklenen her şey, yazı tipi işleme için mevcut en iyi açık kaynak kütüphanesi).\n\nKaynak: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!","İşlem tamamlandı!"],["Play last build","Son derlemeyi oyna"],["Apply translation then play","Çeviriyi uygula sonra oyna"],["Setup Easy RPG in the current directory","Mevcut dizinde Easy RPG'yi kur"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data","JSON verisini güzelleştir"],["When checked the generated data will be beautified.","İşaretlendiğinde oluşturulan veri güzelleştirilecektir."],["Error loading system.json","system.json yüklenirken hata"],["Loading","Yükleniyor"],["index.html not found in","index.html bulunamadı"],["Encrypted game","Şifreli oyun"],["Select the index.html of your encrypted game.","Şifreli oyununuzun index.html dosyasını seçin."],["Target folder","Hedef klasör"],["Select destination folder. The process will replace the existing files.","Hedef klasörü seçin. İşlem mevcut dosyaları değiştirecektir."],["Decrypt Resources","Kaynakları Şifresini Çöz"],["Close","Kapat"],["Process","İşlem"],["Source path can not empty","Kaynak yolu boş olamaz"],["Destination path can not empty","Hedef yolu boş olamaz"],["Path is not a file:","Yol bir dosya değil:"],["Invalid directory:","Geçersiz dizin:"],["Extract enigma","Enigma'yı çıkar"],["Select enigma file.","Enigma dosyasını seçin."],["Extract Enigma","Enigma Çıkar"],["Selected file is not an Enigma Virtual Box package.","Seçilen dosya bir Enigma Sanal Kutu paketi değil."],["Plugins are already fetched for this project. Want to re-fetch the plugins?","Bu proje için eklentiler zaten alınmış. Eklentileri yeniden almak ister misiniz?"],["Translate Javascript File?","Javascript Dosyasını Çevir?"],["Cancel","İptal"],["I know the risk, Proceed!","Riski biliyorum, Devam et!"],["Game Executable Path","Oyun Çalıştırılabilir Yolu"],["Path to the game executable file (.exe)","Oyun çalıştırılabilir dosyasının yolu (.exe)"],["NWJS Version","NWJS Sürümü"],["Change into this NWJS version","Bu NWJS sürümüne değiştir"],["Use Developer version","Geliştirici sürümünü kullan"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","NWJS Geliştirici sürümünü kullanın. Geliştirici sürümünde geliştirici araçları mevcuttur. Hata ayıklama ve geliştirme için uygundur."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Geliştirici sürümünde <b>Geliştirici Konsolu</b>'nu kullanabilirsiniz. Geliştirici Konsolu'na F12 tuşuna basarak veya uygulamaya sağ tıklayıp 'İncele'yi seçerek erişebilirsiniz."],["Use 32-bit version","32-bit sürümünü kullan"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","NWJS'in 32-bit sürümünü kullanın. 32-bit sürümü eski sistemlerle uyumluluk için kullanışlıdır. Mümkünse bu seçeneği işaretlememeniz önerilir (sadece makinenizi yükseltin, dostum)."],["Some game feature may not work across NWJS version","Bazı oyun özellikleri NWJS sürümleri arasında çalışmayabilir"],["Please be aware that some game feature may not work across NWJS version.","Lütfen bazı oyun özelliklerinin NWJS sürümleri arasında çalışmayabileceğinin farkında olun."],["Change RPG Maker MV / RPG Maker MZ / NWJS version","RPG Maker MV / RPG Maker MZ / NWJS sürümünü değiştir"],["This operation will change the NW.js version into","Bu işlem NW.js sürümünü şuna değiştirecek"],["Please close the application first before continuing.\nDo you want to continue?","Devam etmeden önce lütfen uygulamayı kapatın.\nDevam etmek istiyor musunuz?"],["The selected file is not a valid NW.js application.","Seçilen dosya geçerli bir NW.js uygulaması değil."],["Could not find index.html in the game directory.","Oyun dizininde index.html bulunamadı."],["Debug menu script not found in addon directory.","Eklenti dizininde hata ayıklama menüsü betiği bulunamadı."],["Debug menu script is already installed in index.html.","Hata ayıklama menüsü betiği zaten index.html'de yüklü."],["Debug options installed successfully!","Hata ayıklama seçenekleri başarıyla yüklendi!"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n","Seçilen oyun NW.js Geliştirici Modunda (SDK) çalışmıyor.\n\n"],["Developer Mode provides additional debugging features:\n","Geliştirici Modu ek hata ayıklama özellikleri sağlar:\n"],["• Developer Console (F12)\n","• Geliştirici Konsolu (F12)\n"],["• Inspect Element (Right-click)\n","• Öğeyi İncele (Sağ tık)\n"],["• Network Monitor\n","• Ağ İzleyicisi\n"],["• Performance Profiler\n\n","• Performans Profilleyicisi\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n","NW.js Geliştirici Moduna yükseltmek istiyor musunuz?\n"],["(Recommended for better debugging experience)","(Daha iyi hata ayıklama deneyimi için önerilir)"],["The game will be upgraded to NW.js SDK version","Oyun, NW.js SDK sürümüne yükseltilecek"],["This may take a few minutes. Please wait...","Bu birkaç dakika sürebilir. Lütfen bekleyin..."],["NW.js has been upgraded to Developer Mode successfully!","NW.js başarıyla Geliştirici Moduna yükseltildi!"],["Failed to upgrade to Developer Mode:\n","Geliştirici Moduna yükseltme başarısız:\n"],["Error installing debug options: ","Hata ayıklama seçenekleri yüklenirken hata: "],["Install Debug Options","Hata Ayıklama Seçeneklerini Yükle"],["This will install a debug menu into your RPG Maker MV/MZ game.","Bu, RPG Maker MV/MZ oyununuza bir hata ayıklama menüsü yükleyecektir."],["Select the game executable file to install debug options.","Hata ayıklama seçeneklerini yüklemek için oyun yürütülebilir dosyasını seçin."],["Compile HTML to Executable","HTML'yi Yürütülebilire Derle"],["Change Existing NWJS Version","Mevcut NWJS Sürümünü Değiştir"],["Install debug options","Hata ayıklama seçeneklerini yükle"],["Find next","Sonrakini bul"],["Open folder","Klasörü aç"],["Open with external application","Harici uygulamayla aç"],["Raw JSON data. Right click to open menu.","Ham JSON verisi. Menüyü açmak için sağ tıklayın."],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)","Bu çeviri verisi için yama mevcut. Bu yama, çeviri verinizi Translator++'ın mevcut sürümüyle uyumlu hale getirecektir.\nÇeviri verinizi yamalamak istiyor musunuz?\n(Yamalamazsanız bazı özellikler düzgün çalışmayabilir)"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.","Hata ayıklama seçeneklerini yüklemek için yürütülebilir dosya bulunamadı. Oyununuzun Windows için NW.js ile paketlendiğinden emin olun."],["Error while installing debug options: ","Hata ayıklama seçenekleri yüklenirken hata: "],["Play last build","Son derlemeyi oynat"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Geliştirme yolu tanımlanmamış.\nGeliştirme yolu oluşturmak için oyununuzu bir kez enjekte etmelisiniz."],["Open editor","Düzenleyiciyi aç"],["Load Plugins Into Project","Projeye Eklentileri Yükle"],["Compile Game","Oyunu Derle"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","Seçenek, eski ayrıştırıcıyı kullanacak şekilde ayarlandı.\nİstediğiniz zaman seçenek menüsü üzerinden yeni ayrıştırıcıya geri dönebilirsiniz."],["Unable to find the file related to the data","Veriyle ilgili dosya bulunamadı"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Bunu düzeltmek için <a href=\"#\" class=\"openProjectProperties\">Proje özellikleri</a>ndeki <b>Ham malzeme konumu</b> alanını düzeltin"],["Maximum dialog line","Maksimum diyalog satırı"],["Maximum line in the dialog box. Default is 4.","Diyalog kutusundaki maksimum satır. Varsayılan 4'tür."],["Add debug options","Hata ayıklama seçeneklerini ekle"],["Add debug options into the game to help testing.","Test etmeye yardımcı olmak için oyuna hata ayıklama seçenekleri ekleyin."],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>","Oyuna hata ayıklama araçları eklemek için bu seçeneği etkinleştirin. Bu özellikler çevirinizi test etmenize yardımcı olabilir.<br/><b>⚠️ Not: Bu seçenek yalnızca oyununuz NWJS for Windows ile paketlenmişse kullanılabilir.</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/type/StringLiteral","tid/21410/type/StringLiteral"],["tid/20865/type/StringLiteral","tid/21461/type/StringLiteral"],["tid/20925/type/StringLiteral"],["tid/20962/type/StringLiteral"],["tid/20992/type/StringLiteral"],["tid/21023/type/StringLiteral"],["tid/21215/type/StringLiteral"],["tid/21220/type/StringLiteral"],["tid/21309/type/StringLiteral"],["tid/21564/type/StringLiteral"],["tid/21678/type/StringLiteral"],["tid/22062/type/StringLiteral"],["tid/22163/type/StringLiteral"],["tid/22214/type/StringLiteral"],["tid/22424/type/StringLiteral","tid/24166/type/StringLiteral"],["tid/22434/type/StringLiteral","tid/24176/type/StringLiteral"],["tid/22468/type/StringLiteral"],["tid/22478/type/StringLiteral"],["tid/22512/type/StringLiteral","tid/22962/type/StringLiteral"],["tid/22522/type/StringLiteral"],["tid/22533/type/StringLiteral"],["tid/22560/type/StringLiteral","tid/22986/type/StringLiteral"],["tid/22570/type/StringLiteral"],["tid/22605/type/NoSubstitutionTemplate"],["tid/22610/type/NoSubstitutionTemplate"],["tid/23014/type/NoSubstitutionTemplate"],["tid/23119/type/NoSubstitutionTemplate"],["tid/23148/type/NoSubstitutionTemplate"],["tid/23298/type/StringLiteral"],["tid/23453/type/StringLiteral"],["tid/23555/type/StringLiteral"],["tid/23696/type/StringLiteral"],["tid/23770/type/StringLiteral"],["tid/23812/type/StringLiteral"],["tid/23820/type/StringLiteral"],["tid/23828/type/StringLiteral"],["tid/23836/type/StringLiteral"],["tid/23844/type/StringLiteral"],["tid/23852/type/StringLiteral"],["tid/23860/type/StringLiteral"],["tid/23868/type/StringLiteral"],["tid/23922/type/NoSubstitutionTemplate"],["tid/23931/type/NoSubstitutionTemplate"],["tid/23972/type/StringLiteral"],["tid/24005/type/StringLiteral"],["tid/24068/type/StringLiteral"],["tid/24217/type/NoSubstitutionTemplate","tid/24282/type/NoSubstitutionTemplate"],["tid/24222/type/NoSubstitutionTemplate"],["tid/24227/type/NoSubstitutionTemplate"],["tid/24482/type/StringLiteral"],["tid/24546/type/StringLiteral"],["tid/24598/type/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":82,"length":82,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS.","Bu özellik yalnızca NWJS'nin Geliştirici sürümünü kullanıyorsanız mevcuttur."]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js.","Bu özellik yalnızca NW.js'in geliştirici sürümünü kullanıyorsanız mevcuttur."]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser","Eski ayrıştırıcıyı kullan"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.","(Translator++ sür. 3.8.12) öncesindeki eski ayrıştırıcıyı kullanın. Eski ayrıştırıcı bazı yeni eklenen özellikleri desteklemez."],["Use old parser","Eski ayrıştırıcıyı kullan"],["Event's thread concurrency","Olayın iş parçacığı eşzamanlılığı"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.","<b>Uyarı! Deneysel özellik!</b><br />Bu seçenek, Harita ve CommonEvents üzerinde olay verilerini eşzamanlı olarak ayrıştırabilecek maksimum çalışan iş parçacığı sayısını belirler. <b>İş parçacığını devre dışı bırakmak için 0 olarak ayarlayın</b>. <br />Bu seçenek, daha büyük oyunlarda ayrıştırma sürecini hızlandırma potansiyeline sahiptir. Ancak, daha küçük oyunlarda bu seçeneği etkinleştirmenin, her veri için ayrıştırma süresine kıyasla daha yüksek yürütme ek yükü nedeniyle ayrıştırma sürecini yavaşlatabileceğini unutmayın."],["The minimum number of command in an event that allowed in thread worker","Bir iş parçacığı çalışanında izin verilen bir olaydaki minimum komut sayısı"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.","<b>Uyarı! Deneysel özellik!</b><br />İş parçacığı çalışanları yürütme sırasında ek yük oluşturur, bu da boş olayları veya düşük komut sayısına sahip olayları işlemenin genel süreci engelleyebileceği anlamına gelir. Bu seçenek, bir olayın bir iş parçacığı çalışanında ayrıştırılabilmesi için sahip olması gereken minimum komut sayısını belirlemenizi sağlar. <br />Boş olayların bile bir komut içerdiğini ve bu tür olayların bir iş parçacığı çalışanı yerine ana iş parçacığında işlenmesinin daha verimli olduğunu unutmayın. Bu nedenle, bu sayının <b>1'den büyük</b> bir değere ayarlanması önerilir.<br />Görev bölmeyi devre dışı bırakmak için 0 olarak ayarlayın."],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.","Boş bir olayın aslında bir komut içerdiğini ve boş olayları kesinlikle bir iş parçacığı çalışanı yerine ana iş parçacığında işlemek istediğinizi unutmayın. Bu sayıyı 1'den büyük bir değere ayarlamalısınız."],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3","RPG Maker XP, VX, Ace, MV & MZ Ayrıştırıcı V.3"],["Start translation from RPG Maker game using the latest parser.","En son ayrıştırıcıyı kullanarak RPG Maker oyunundan çeviriye başlayın."],["Error!\r\nTranslator++ is unable to detect the type of ","Hata!\r\nTranslator++, türünü algılayamıyor "],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.","Yolu değiştirmelisiniz!\r\nGeliştirme dizini, orijinal oyun dizininin içinde olmamalıdır, çünkü bu daha sonra oyunu enjekte ederseniz sorunlara neden olabilir."],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","Oyun Enigma ile paketlenmiş.\r\nPaketi çıkarmak istiyor musunuz?\r\nBu, oyununuzun boyutuna bağlı olarak dakikalar sürecektir."],["Unable to extract the Enigma package!","Enigma paketi çıkarılamadı!"],["Copy & extract data into ","Verileri kopyala ve içine çıkar "]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?","Bu işlemi çalıştırmak için RPGMakertrans CLI Gateway gereklidir.\nRPGMakertrans CLI Gateway GPL-3 lisansı altındadır ve programla birlikte dağıtılamaz.\nAncak Translator++ bunu sizin adınıza kurabilir.\n\nTranslator++'ın RPGMakertrans CLI Gateway'i sizin için kurmasını ister misiniz?"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?","RPGMakertrans CLI Gateway'in güncellenmesi gerekiyor.\nTranslator++'ın RPGMakertrans CLI Gateway'i sizin için güncellemesini ister misiniz?"],["Maximum dialog line","Maksimum diyalog satırı"],["Maximum line in the dialog box. Default is 4.","Diyalog kutusundaki maksimum satır. Varsayılan 4'tür."]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine.","SRPG Studio Motorundan bir çeviri projesi başlat."],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..","Ayrıştırıcı, <b>data.dts</b> (srpgs dosyası); <b>localization.dat</b> dosyası ve SRPG Studio'nun 1.253 sürümünde tanıtılan yerelleştirme aracı tarafından oluşturulan yerelleştirme dosyalarını (.json, .txt, .js) çevirebilir."],["Create project","Proje oluştur"],["Error: customField is not defined. This should not happen!","Hata: customField tanımlanmamış. Bu olmamalı!"],["Please select the entry point to translate.","Lütfen çevrilecek giriş noktasını seçin."],["There are currently two known locations of translatable text within the SRPG Studio game. <br />","SRPG Studio oyununda şu anda bilinen iki çevrilebilir metin konumu vardır. <br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.","Birincisi doğrudan .srpgs dosyasının içine yazılmıştır, ikincisi ise localization.dat dosyasındadır. Bu ayrıştırıcı şu anda her ikisini de işleyebilir."],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.","<br />Buna ek olarak, SRPG Studio'nun yerelleştirme aracı tarafından oluşturulan yerelleştirme dosyalarını da çevirebilirsiniz. Bu dosyalar JSON, TXT ve JS formatındadır."]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.","SRPG Studio arşivlerini ve SRPG_Unpacker.exe tarafından oluşturulan çeviri döküm JSON'larını ayrıştır."],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.","SRPG Studio data.dts, project.dat veya çeviri döküm JSON'dan çeviri başlat.<br />Bu, önceki sürümün yerini alacak olan—önemli ölçüde daha hızlı ve kararlı—en son ayrıştırıcıdır."],["Create Project","Proje Oluştur"],["Source mode","Kaynak modu"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.","Oyun yürütülebilirinden başlamak için EXE modunu, data.dts / project.dat için arşiv modunu veya çeviri döküm JSON için döküm modunu seçin."],["Select executable","Yürütülebilir seç"],["Select the game executable. Translator++ will look for data.dts in the same folder.","Oyun yürütülebilirini seçin. Translator++, aynı klasörde data.dts dosyasını arayacaktır."],["Select archive file","Arşiv dosyasını seç"],["Select data.dts directly.","data.dts dosyasını doğrudan seç."],["Select dump folder","Döküm klasörünü seç"],["Select the translation dump folder generated by SRPG_Unpacker.exe.","SRPG_Unpacker.exe tarafından oluşturulan çeviri döküm klasörünü seç."],["Filters","Filtreler"],["Glob pattern used to select JSON files from the dump folder.","Döküm klasöründen JSON dosyalarını seçmek için kullanılan glob deseni."],["ProjectTitle","Proje Başlığı"],["Your project title","Proje başlığınız"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>","Sugoi çevirmen konumu <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Uygulamanın kök dizinindeki .bat veya .exe dosyasını gösterin.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Geçersiz yol.<br>Bu düzeltilene kadar bazı özellikler devre dışı kalacak."],["Server Type :","Sunucu Türü :"],["Installed Model :","Yüklü Model :"],["Install Sugoi Translator","Sugoi Çevirmeni Yükle"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ","Sugoi Çevirmeniniz yok mu?\n            Özelleştirilmiş ve optimize edilmiş Sugoi Çevirmen sunucusunu şimdi yükleyin!\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>","Başlatılacak sunucu sayısı (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Aynı anda başlatılan sunucu sayısı\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%","Aynı anda başlatılacak sunucu sayısı.<br>Daha fazla işlem her zaman daha hızlı anlamına gelmez, RAM ve CPU kapasitenizi göz önünde bulundurun.<br>Sadece bir sunucu çalıştırarak CPU kullanımı %100'e ulaştıysa fayda göremeyebilirsiniz."],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ","\n                    Sugoi Çevirmeniniz GPU işlemeyi desteklemiyor.<br>\n                    GPU işlemeyi desteklemek için sunucunuzu yamalamanız gerekiyor.<br>\n                    <h3 data-tran=\"\">Sisteminiz için uygun yamayı yüklemek için aşağıdaki seçeneği seçin</h3>\n                    <div>\n                        <span data-tran=\"\">GPU'nuz:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">NVIDIA serisi 30xx veya daha yüksek için yama yükle</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">NVIDIA serisi 20xx veya daha düşük için yama yükle</button>\n    \n                    </div>\n                "],["Select the following option to install the suitable patch for your system","Sisteminiz için uygun yamayı yüklemek için aşağıdaki seçeneği seçin"],["Your GPU is:","GPU'nuz:"],["Install patch For NVIDIA series 30xx or greater","NVIDIA serisi 30xx veya daha yüksek için yama yükle"],["Install patch For NVIDIA series 20xx or lower","NVIDIA serisi 20xx veya daha düşük için yama yükle"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>","Başlatılacak sunucu sayısı (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"GPU kullanılarak aynı anda başlatılan sunucu sayısı. GPU işlemini etkinleştirmek için sunucunuzun yamalanmış olması gerekir.\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.","<b>GPU</b>'nuzda kaç sunucu başlatmak istiyorsunuz. Hem CPU hem de GPU tabanlı hizmeti aynı anda çalıştırmak mümkündür. Ancak CPU kullanımınız yüksekse GPU performansını engelleyebileceğini lütfen unutmayın.<br>Bu modu etkinleştirmek için sunucunuzun yamalanmış olması gerekir."],["Starting port number","Başlangıç port numarası"],["The port numbers will be generated incrementaly starting from the value below","Port numaraları aşağıdaki değerden başlayarak artan şekilde oluşturulacaktır"],["Keep console window open","Konsol penceresini açık tut"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.","sunucu kapandığında konsol penceresinin kapanmasını önler. Bu seçenek, sunucunun çökmesine neden olan hataları kontrol etmek için kullanışlıdır."],["Action","Eylem"],["Set Sugoi Trans config based on this setting","Bu ayara dayalı olarak Sugoi Trans yapılandırmasını ayarla"],["Start All Server","Tüm Sunucuyu Başlat"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":22,"length":22,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder","Kurulum klasörünü seç"],["Where do you want to install the CT2 Sugoi Translator into?","CT2 Sugoi Translator'ı nereye kurmak istiyorsunuz?"],["Cancel","İptal"],["Install now!","Şimdi kur!"],["Path to the directory can not be empty!","Dizin yolu boş olamaz!"],["Invalid directory:","Geçersiz dizin:"],["Failed to download file. Repository do not exist. Please see the console log for more information.","Dosya indirilemedi. Depo mevcut değil. Daha fazla bilgi için konsol günlüğüne bakın."],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series","Sunucunuzu güncellemek istediğinizden emin misiniz?\nBu güncelleme betiği NVIDIA 3XXX serisi için çalışacaktır"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier","Sunucunuzu güncellemek istediğinizden emin misiniz?\nBu güncelleme betiği NVIDIA 2XXX serisi ve öncekiler için çalışacaktır"],["Install CT2 Sugoi Translator","CT2 Sugoi Translator'ı Kur"],["Installation completed\nDo you want to set the Server Manager with this installed server?","Kurulum tamamlandı\nBu kurulu sunucu ile Sunucu Yöneticisi'ni ayarlamak istiyor musunuz?"],["Sugoi Translator Installed","Sugoi Translator Kuruldu"],["Server started\nPlease wait until the server(s) are ready before you translate things.","Sunucu başlatıldı\nLütfen çeviri yapmadan önce sunucu(lar)ın hazır olmasını bekleyin."],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?","Bu işlem Sugoi Trans Addon ayarlarının mevcut değerini üzerine yazacaktır.\nEmin misiniz?"],["Do you want to reset the current configuration?","Mevcut yapılandırmayı sıfırlamak istiyor musunuz?"],["Configuration refreshed!","Yapılandırma yenilendi!"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter","Satır ayırıcı"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.","Çevirmen tarafından kaçırılacak karakterleri veya ifadeleri doldurun (orijinal ifade ve çeviri her zaman aynı olacaktır). Bu, çevrilen metnin satır sayısının orijinal metnin satır sayısıyla aynı olmasını garanti eder.\nŞu anda Sugoi'nin %100 başarı oranıyla kaçıracağı ifade/karakter yoktur.\n&#x3C;br&#x3E; kullanarak makul bir başarı oranıyla deneyebilirsiniz.\nSatırları tek bir satırda birleştirmek istiyorsanız boş bırakın."],["Target URL(s)","Hedef URL(ler)"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.","Çevirmen hedef URL'si. Bir veya daha fazla Sugoi Translator arka uç URL'si girebilirsiniz. Translator++ istekleri tüm servis örnekleri arasında yük dengelemesi yapacaktır. Her girişi yeni bir satırla ayırın."],["Max Parallel job","Maksimum Paralel İş"],["Maximum parallel job that run simultaneously.","Aynı anda çalışan maksimum paralel iş sayısı."],["Send requests in batch","Toplu olarak istek gönder"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.","Birkaç metni (Maksimum Paralel İş'e göre) dizi olarak gönderin.\nDaha hızlıdır ve yürütme yükünü önemli ölçüde azaltabilir. Bu seçeneği etkinleştirmek için sunucuyu sunucu yöneticisinden çalıştırmalısınız."],["Check First Line in Common Reference","Ortak Referansta İlk Satırı Kontrol Et"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.","İlk satır Ortak Referansta bulunursa yükte dahil etmeyin.\nBu, karakter adı ilk satırda olduğunda çok kullanışlıdır."],["Check Last Line in Common Reference","Ortak Referansta Son Satırı Kontrol Et"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.","Son satır Ortak Referansta bulunursa yükte dahil etmeyin.\nBu, karakter adı son satırda olduğunda çok kullanışlıdır."],["Automatic splitting","Otomatik bölme"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.","Çeviriyi otomatik olarak orijinalle eşleşen satır sayısına bölün. Her satırın uzunluğu benzer boyutta olacaktır."],["Code Escaping Algorithm","Kod Kaçış Algoritması"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)","Diyaloglar içindeki satır içi kod için kaçış algoritması (henüz uygulanmadı, lütfen gelecek güncellemeleri bekleyin)"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary","Aktör Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ aktör referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Aktör referansı, diyalogdaki aktörün adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler, her grup öğesi için sözlük olarak yüklenecektir. İstem mesajında aktör referansını yüklemek için şablon komutunu kullanın."],["Actor Reference Translation Column","Aktör Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin bulunduğu sütun. Bu sütun, aktör referansının çevirisi olarak kullanılacaktır. Bu, konuşmadaki aktör adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Aktör Bilgisi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş gibi daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, chatGPT asistanınızın rolünün ne olduğunu söyleyen mesajın başlığıdır. Bu mesaj, chatGPT'ye gönderdiğiniz her grubun en ilk mesajı olarak gönderilecektir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Şablon Değişmezleri stiliyle aşağıdaki değişkenleri ekleyebilirsiniz <span class='inlineCode'><b>${</b>DEĞİŞKEN<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tam kaynak dil adı</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tam hedef dil adı</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yerine geçen).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Toplu işteki mesaj sayısı.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Aktörlerin bilgilerini ekleyin.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERENCE[Common Reference]</code></li>"],["Body Message Template","Gövde Mesaj Şablonu"],["Template of the body of your chat.","Sohbetinizin gövdesinin şablonu."],["Sample conversation","Örnek konuşma"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT Batch API, projenizi %50 daha düşük maliyetlerle asenkron olarak çevirmenize olanak tanır, yani çeviri sonuçlarınızı <b style=\"color:red\">24 saat içinde</b> <b style=\"color:red\">normal maliyetin yarısına</b> alırsınız. Bu, acil çeviri sonuçları gerektirmeyen büyük projeler için özellikle kullanışlıdır."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />ChatGPT Batch API hakkında daha fazla bilgi edinin: https://platform.openai.com/docs/guides/batch ."],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>","<p>Sözlüğü kullanabilir veya kullanmayabilirsiniz. Sözlük, çeviri kalitesini artırmak için her toplu iş öğesi için yüklenecektir.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgilerinin Sütunu"],["Prompt Template","İstek Şablonu"],["<h2>1. System Message</h2>","<h2>1. Sistem Mesajı</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Burada asistanın rolünün ne olduğunu açıklayabilirsiniz.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut diyalog örneği. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Gerçek isteğiniz</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Bu, asistan için gerçek istemdir.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Genel gider maliyeti</h3>\n                        Genel gider maliyeti, gerçek çeviri metinleri olmadan asistanınıza gönderdiğiniz istem mesajının maliyetidir. Maliyet, istem mesajındaki belirteç sayısına göre hesaplanır. Ne kadar çok belirteç olursa, maliyet o kadar yüksek olur.<br>\n                        <b>Mevcut genel gider maliyeti:</b> <span class=\"overheadCost\">0</span> belirteç / istek."]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":40,"length":40,"percent":100},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?","TinyRPA sunucusu kurulu değil. Şimdi kurmak ister misiniz?"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization","Otomatik organik çeviri ezberleme"],["If checked, all organic translation (manually inputted translation) will be memorized automatically.","İşaretlenirse, tüm organik çeviriler (manuel girilen çeviriler) otomatik olarak ezberlenecektir."],["Memorize translation by automation script","Otomasyon betiği ile çeviriyi ezberle"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.","İşaretlenirse, Translator++ otomasyon betiklerinden oluşturulan çevirileri hatırlayacaktır. \n'this.cells' aracılığıyla yapılan tüm değişiklikler ezberlenecektir. Ancak, trans API gibi araçlarla doğrudan ızgaranın içeriğini değiştirmemiz mümkündür, bu tür değişiklikler otomatik ezberlemeyi tetiklemeyecektir."],["Remind translation on cell translate","Hücre çevirisinde çeviriyi hatırlat"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.","İşaretlenirse, Translator++ seçili hücrede otomatik çeviri yapmadan önce önce çeviri belleğinden çeviriyi yükleyecektir."],["Default memorization behavior","Varsayılan ezberleme davranışı"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.","Organik çeviri yaparken önceki kaydın üzerine yaz. İşaretlenmezse, TM mevcut kayıt için yeni çeviriyi ezberlemeyecektir."],["MySQL host","MySQL ana bilgisayarı"],["The host name or IP address of your MySQL server","MySQL sunucunuzun ana bilgisayar adı veya IP adresi"],["MySQL port","MySQL bağlantı noktası"],["MySQL Port. Default is 3306.","MySQL Bağlantı Noktası. Varsayılan 3306'dır."],["MySQL user name","MySQL kullanıcı adı"],["Username to access the DB.","Veritabanına erişmek için kullanıcı adı."],["MySQL password","MySQL şifresi"],["Password to access the DB.","Veritabanına erişmek için şifre."],["Database Name","Veritabanı Adı"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.","Veritabanı adı. Translator++, eğer yoksa veritabanı oluşturmaya çalışacaktır. Ancak başarı, verilen kimlik bilgilerinin yetkilerine bağlıdır."],["Database Type","Veritabanı Türü"],["Automatically memorize manually inputted translations?","Manuel girilen çevirileri otomatik olarak ezberlesin mi?"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Üzgünüz, bu eklenti yalnızca aktif destekçiler için mevcuttur.\nBu özelliği $1 destekçisi olarak kilitleyebilirsiniz."],["Automatically memorize translation made by automation scripts?","Otomasyon betikleriyle yapılan çevirileri otomatik olarak ezberlesin mi?"],["Remind translations when performing translate selection?","Çeviri seçimi yaparken çevirileri hatırlatsın mı?"],["Use rememorize in organic translation","Organik çeviride yeniden ezberlemeyi kullan"],["default","varsayılan"],["Indexed DB (experimental)","İndeksli DB (deneysel)"],["MySQL","MySQL"],["Database Setting","Veritabanı Ayarları"],["IndexedDB","IndexedDB"],["Generate","Oluştur"],["Escaping algorithm for inline code inside dialogues","Diyaloglar içindeki satır içi kod için kaçış algoritması"],["Test connection","Bağlantıyı test et"],["Connection success!","Bağlantı başarılı!"],["MySql","MySql"],["Connection failed!\nError:","Bağlantı başarısız!\nHata:"],["Install MySQL Server","MySQL Sunucusu Kur"],["How to setup MySQL Server","MySQL Sunucusu Nasıl Kurulur"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?","Bir anahtar cümle için birden fazla çeviri tespit edildi.\nYalnızca son bulunan çeviri Çeviri Belleği tarafından hatırlanacaktır.\nDevam etmek istiyor musunuz?"],["Your database structure need to be updated.","Veritabanı yapınızın güncellenmesi gerekiyor."],["Upgrade database","Veritabanını yükselt"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?","Bu işlem veritabanınızı yükseltecektir.\nÇeviri belleği veritabanınızı yükseltmek istiyor musunuz?"],["The translation memory database has been upgraded!\nPlease restart Translator++!","Çeviri belleği veritabanı yükseltildi!\nLütfen Translator++'ı yeniden başlatın!"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":42,"length":42,"percent":100},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory","Bellek"],["Fix the problem!","Sorunu düzelt!"],["No exact matches found!","Tam eşleşme bulunamadı!"],["Original","Orijinal"],["Translation","Çeviri"],["Do you want Translator++ to forget the selected cell(s)?","Translator++'ın seçili hücre(ler)i unutmasını istiyor musunuz?"],["Auto recall","Otomatik hatırlama"],["Auto memorize organic translation","Organik çeviriyi otomatik hatırla"],["Auto memorize automation","Otomasyonu otomatik hatırla"],["Use rememorize in organic translation","Organik çeviride yeniden hatırlamayı kullan"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["tid/2391/type/StringLiteral"],["tid/2543/type/StringLiteral"],["tid/2686/type/StringLiteral"],["tid/2838/type/StringLiteral"]],"basename":"tmUI.js","dirname":"/addons/tm","extension":".js","filename":"tmUI.js","path":"/addons/tm/tmUI.js","indexIsBuilt":false,"indexIds":{"Memory":0,"Fix the problem!":1,"No exact matches found!":2,"Original":3,"Translation":4,"Do you want Translator++ to forget the selected cell(s)?":5,"Auto recall":6,"Auto memorize organic translation":7,"Auto memorize automation":8,"Use rememorize in organic translation":9},"tags":[],"relPath":"/addons/tm/tmUI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/tpp-localizationTool/fetchtrans.js":{"data":[["Preparing download file...","İndirme dosyası hazırlanıyor..."],["Translation template downloaded successfully!","Çeviri şablonu başarıyla indirildi!"],["Building translation data...","Çeviri verisi oluşturuluyor..."],["Processing: ","İşleniyor: "],["Fetching directory content...","Dizin içeriği alınıyor..."],["Parsing: ","Ayrıştırılıyor: "],["Localization Tools","Yerelleştirme Araçları"],["Generate UI Translation Template","UI Çeviri Şablonu Oluştur"],["Update Translation Table","Çeviri Tablosunu Güncelle"],["This will overwrite www/lang/template.trans and update all localization files listed in www/lang/options.json.\n\nExisting translations will be preserved. New strings from the current source will be added.\n\nContinue?","Bu, www/lang/template.trans dosyasını üzerine yazacak ve www/lang/options.json'da listelenen tüm yerelleştirme dosyalarını güncelleyecektir.\n\nMevcut çeviriler korunacaktır. Mevcut kaynaktan yeni dizeler eklenecektir.\n\nDevam edilsin mi?"],["Saving template.trans...","template.trans kaydediliyor..."],["Loading language options...","Dil seçenekleri yükleniyor..."],["Updating: ","Güncelleniyor: "],["Failed to update: ","Güncellenemedi: "],["Translation tables updated successfully!","Çeviri tabloları başarıyla güncellendi!"]],"context":[["tid/2001/type/StringLiteral"],["tid/2228/type/StringLiteral"],["tid/2286/type/StringLiteral"],["tid/2439/type/StringLiteral"],["tid/2623/type/StringLiteral"],["tid/2825/type/StringLiteral"],["tid/3098/type/StringLiteral"],["tid/3131/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3244/type/StringLiteral"],["tid/3358/type/StringLiteral"],["tid/3408/type/StringLiteral"],["tid/3657/type/StringLiteral"],["tid/3812/type/StringLiteral"],["tid/3852/type/StringLiteral"]],"basename":"fetchtrans.js","dirname":"/addons/tpp-localizationTool","extension":".js","filename":"fetchtrans.js","path":"/addons/tpp-localizationTool/fetchtrans.js","indexIsBuilt":false,"indexIds":{"Preparing download file...":0,"Translation template downloaded successfully!":1,"Building translation data...":2,"Processing: ":3,"Fetching directory content...":4,"Parsing: ":5,"Localization Tools":6,"Generate UI Translation Template":7,"Update Translatio