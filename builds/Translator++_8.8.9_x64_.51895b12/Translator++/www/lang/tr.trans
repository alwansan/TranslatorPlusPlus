t.description","apiUçNoktası.açıklama"],["apiEndpoint.warn","apiUçNoktası.uyarı"],["partialImportMessages","kısmiİçeAktarMesajları"],["import","içeAktar"],["name","isim"],["prompt","prompt"],["clearPrompts","promptlarıTemizle"],["morePrompts","dahaFazlaİstem"],["toast.sync","toast.senkronizasyon"],["toast.stop","toast.durdur"],["button.sync","buton.senkronizasyon"],["button.stop","buton.durdur"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":3,"promptLibrary":4,"search":5,"downloadChat":6,"newChat":7,"api":8,"customEndpoint":9,"apiEndpoint.inputLabel":10,"apiKey.inputLabel":11,"apiVersion.inputLabel":12,"apiVersion.description":13,"securityMessage":14,"apiEndpoint.description":15,"apiEndpoint.warn":16,"partialImportMessages":17,"import":18,"name":19,"prompt":20,"clearPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ChatGPT Toplu API ile Çevir"],["Model","Model"],["The pre-trained model.","Önceden eğitilmiş model."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI Toplu API'si, genel olarak kullanılan API'den biraz farklı bir model adlandırma kuralı kullanıyor gibi görünüyor. Toplu API'de kullanılan modellerde “-batch” öneki bulunur. Örneğin, <code>gpt-4.1-mini</code> kullanırsanız, model otomatik olarak <code>gpt-4.1-mini-batch</code> olur.<br />\nAncak, bu eklenti oluşturulduğu sırada, toplu modeller OpenAI'nin model kullanım limitlerinde listelenmiyor, bu da kullanıcıların Model Kullanım filtresini “İzin Ver” (beyaz liste) olarak ayarladıysa Toplu API'yi kullanmasını imkansız kılıyor.<br />\nBu muhtemelen OpenAI arayüzündeki bir hata olup gelecekte düzeltilebilir.<br />\nBu nedenle, Toplu API'yi kullanabilmek için OpenAI'daki kullanım limitlerini “Engelle” (kara liste) moduna ayarladığınızdan emin olun.<br />\nModelin kullanım limitlerini değiştirmek için buraya tıklayın: https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","Kaynak Sütun"],["The column of the original texts you want to translate.","Çevirmek istediğiniz orijinal metinlerin sütunu."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgilerinden oyuncu adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Ignore if already translated","Zaten çevrilmişse yoksay"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Bu seçenek işaretlenirse, Translator++ sütununda zaten çevirileri olan herhangi bir satırı yoksayacaktır."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler, her toplu öğe için sözlük olarak yüklenecektir. İstem mesajında oyuncu referansını yüklemek için şablon komutunu kullanın."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Oyuncu adının çevirisinin sütunu. Bu sütun, oyuncu referansının çevirisi olarak kullanılacaktır. Bu, konuşmadaki oyuncu adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Oyuncu Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Oyuncunun ek bilgilerini içeren sütun. Cinsiyet, yaş gibi daha fazla bilgi ekleyebilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, ChatGPT asistanınızın rolünü belirten mesajın başlığıdır. Bu mesaj, ChatGPT'ye gönderdiğiniz her grubun en ilk mesajı olarak gönderilecektir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Şablon Değişkeni stiliyle aşağıdaki değişkenleri ekleyebilirsiniz <span class='inlineCode'><b>${</b>DEĞİŞKEN<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tam kaynak dil adı</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tam hedef dil adı</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yerine geçen).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Grubun mesaj sayısı.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Oyuncuların bilgilerini ekleyin.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERENCE[Ortak Referans]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bağlam olarak bazı önceki satırları ekleyin</li>"],["Body Message Template","Gövde Mesajı Şablonu"],["Template of the body of your chat.","Sohbetinizin gövdesinin şablonu."],["Sample conversation","Örnek konuşma"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT Batch API, projenizi %50 daha düşük maliyetle asenkron olarak çevirmenize olanak tanır, yani çeviri sonuçlarınızı <b style=\"color:red\">24 saat içinde</b> ve <b style=\"color:red\">normal maliyetin yarısına</b> alırsınız. Bu, acil çeviri sonuçları gerektirmeyen büyük projeler için özellikle kullanışlıdır."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />ChatGPT Batch API hakkında daha fazla bilgi: https://platform.openai.com/docs/guides/batch ."],["General Settings","Genel Ayarlar"],["This form is using your existing ChatGPT configuration.<br>","Bu form mevcut ChatGPT yapılandırmanızı kullanıyor.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Yapılandırmayı, seçenekler penceresindeki ChatGPT Çevirmen ayarlarına giderek değiştirebilirsiniz.<br>"],["There you can set the API key, model, and other settings.<br />","Orada API anahtarını, modeli ve diğer ayarları yapabilirsiniz.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT ayarlarını aç\" />"],["Append actor name to the translatable text","Çevrilebilir metne aktör adını ekle"],["Ignore translated rows","Çevrilmiş satırları yoksay"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, sözlüğü otomatik olarak isteme eklemenize yardımcı olacak. Sözlük, çeviri kalitesini artırmak için her öğe grubu için yüklenecek. Özellik, yalnızca ilgili terimleri yüklemeye çalışarak isteminizin şişmesini önleyecektir.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgilerinin Sütunu"],["Prompt Template","İstek Şablonu"],["<h2>1. System Message</h2>","<h2>1. Sistem Mesajı</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Burada asistanın rolünün ne olduğunu açıklayabilirsiniz.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Gerçek isteminiz</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Bu, asistan için gerçek istemdir.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Genel gider maliyeti</h3>\n                        Genel gider maliyeti, aslında çeviri metinleri olmadan asistana gönderdiğiniz istem mesajının maliyetidir. Maliyet, istem mesajındaki token sayısına göre hesaplanır. Ne kadar çok tokeniniz varsa, maliyet o kadar yüksek olacaktır.<br>\n                        <b>Mevcut genel gider maliyeti:</b> <span class=\"overheadCost\">0</span> token / istek."],["Are you sure you want to reset the form?","Formu sıfırlamak istediğinizden emin misiniz?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Toplu işlemi işlemek istediğinizden emin misiniz?\nBu işlem için maliyet oluşacaktır."],["The batch is successfully created. Do you want to open the batch manager?","Toplu işlem başarıyla oluşturuldu. Toplu işlem yöneticisini açmak ister misiniz?"],["OpenAI Batch API Queue","OpenAI Toplu API Kuyruğu"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transGeminiAi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transGeminiAi/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Çeviriyi uygulamak için satırları seçin"],["Target Column","Hedef Sütun"],["The column to put the translation result.","Çeviri sonucunun konulacağı sütun."],["Import translation from ChatGPT Batch","ChatGPT Partisinden çeviri içe aktar"],["Translation applied to selected rows","Seçili satırlara çeviri uygulandı"],["Invalid format","Geçersiz biçim"],["OK","Tamam"],["Mismatch","Uyumsuzluk"],["Failed to load batch list with error: \n","Toplu liste yüklenirken hata oluştu: \n"],["Download Error File","Hata Dosyasını İndir"],["Batch is not completed yet","Toplu işlem henüz tamamlanmadı"],["Are you sure you want to cancel this batch?","Bu toplu işlemi iptal etmek istediğinizden emin misiniz?"],["Cannot cancel completed batch.","Tamamlanmış toplu işlem iptal edilemez."],["Batch cancelled","Toplu işlem iptal edildi"],["Failed to cancel batch","Toplu işlem iptal edilemedi"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","Toplu İşlemler"],["Apply translation","Çeviriyi uygula"],["Cancel batch","Toplu işlemi iptal et"],["Status","Durum"],["Batch ID","Toplu İşlem Kimliği"],["Input File ID","Girdi Dosya Kimliği"],["End point","Uç nokta"],["Created at","Oluşturulma tarihi"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Son kullanma tarihi <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Zamanında tamamlanmayan toplu işlemler sonunda süresi dolmuş duruma geçer; bu toplu işlemdeki tamamlanmamış istekler iptal edilir ve tamamlanmış isteklere yanıtlar toplu işlemin çıktı dosyası üzerinden kullanılabilir hale getirilir. Tamamlanmış isteklerden tüketilen token'lar için ücretlendirilirsiniz.\"></i>"],["Completed at","Tamamlandı tarihi"],["Errors","Hatalar"],["Batch Item Detail of","Toplu Öğe Detayı"],["ID","Kimlik"],["Completed on","Tamamlandığı tarih"],["Model","Model"],["Prompt Token","İstek Token'ı"],["Completion Token","Tamamlama Token'ı"],["Total Token","Toplam Token"],["Status Code","Durum Kodu"],["error","hata"],["Conversation","Konuşma"],["Response Validation","Yanıt Doğrulama"],["Raw Payload","Ham Veri"],["View raw payload","Ham veriyi görüntüle"],["Response Preview","Yanıt Önizleme"],["Apply translations from selected rows","Seçili satırlardan çevirileri uygula"],["Here you can edit the translation result individually and send it into Translator++","Burada çeviri sonucunu bireysel olarak düzenleyip Translator++'a gönderebilirsiniz"],["Open ChatGPT Settings","ChatGPT Ayarlarını Aç"],["Help","Yardım"],["File list","Dosya listesi"],["Collapse / restore left panel","Sol paneli daralt / geri yükle"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Zamanında tamamlanmayan toplu işlemler sonunda süresi dolmuş duruma geçer; o toplu işlemdeki tamamlanmamış istekler iptal edilir ve tamamlanan isteklere yanıtlar, toplu işlemin çıktı dosyası üzerinden kullanılabilir hale gelir. Tamamlanan isteklerden tüketilen token'lar için ücretlendirilirsiniz."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>OYUNCU_BİLGİSİ : Oyuncu bilgileri sözlüğü. (Yalnızca toplu modda oyuncu bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>BAĞLAM : Önceki çevirinin bağlamı (bağlam etkinleştirilmişse)</li>"],["Sample conversation","Örnek konuşma"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Akıl Yürütme Modellerine Paranızı Boşa Harcamayın</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Çeşitli çalışmalar, akıl yürütme modellerinin yaratıcı yazma ve çeviri görevlerinde normal modellerden çok daha kötü olduğunu kanıtlamıştır.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Akıl yürütme modellerini kullanırken daha pahalı maliyet ve daha yavaş yanıt sürelerinden başka bir şey elde etmezsiniz.</p>"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut diyalog örneği. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["Always separate file","Dosyayı her zaman ayır"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her parti için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının diğer dosyalarla karışmadan kalmasını sağlayabilir."],["Add actor name","Aktör adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgisinden aktör adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra aktör adını çeviri sonucundan kaldıracaktır. Bu, açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Aktör Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ aktör referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Aktör referansı, diyalogdaki aktörün adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler, her parti öğesi için sözlük olarak yüklenecektir. Aktör referansını yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, ayrıca karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>ACTOR_INFO</code> değişkenini eklemeniz gerekir."],["Actor Reference Translation Column","Aktör Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin sütunu. Bu sütun, aktör referansının çevirisi olarak kullanılacaktır. Bu, konuşmadaki aktör adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Aktörün Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş vb. gibi daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Extra Prompt","Ek İstem"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İstem mesajına eklenecek ek istem. Bu, sistem mesajından sonra ve gerçek istem mesajından önce eklenecektir."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her parti için dosyayı her zaman ayır"],["Append actor name to the translatable text","Çevrilebilir metne aktör adını ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, sözlüğü otomatik olarak isteme eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her öğe grubu için yüklenecektir. Özellik, yalnızca ilgili terimleri yüklemeye çalışarak isteminizin şişmesini önleyecektir.</p>"],["The Column of Actor's Additional Information","Oyuncunun Ek Bilgi Sütunu"],["Prompt","İstek"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"relPath":"/addons/transGeminiAi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>G</u>önder"],["Toggle word wrap","Kelime kaydırmayı aç/kapat"],["Open debugger (F12)","Hata ayıklayıcıyı aç (F12)"],["Help","Yardım"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Bu özellik yalnızca Translator++'ın Geliştirici sürümünü kullanıyorsanız kullanılabilir. Temel Araçlar -> Çekirdek NWJS'yi Değiştir'i kullanarak Geliştirici sürümüne geçebilirsiniz."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>OYUNCU_BİLGİSİ : Oyuncu bilgisi sözlüğü. (Yalnızca toplu modda oyuncu bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>BAĞLAM : Önceki çevirinin bağlamı (bağlam etkinse)</li>"],["Sample conversation","Örnek konuşma"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her grup için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının başka dosyalarla karışmamasını sağlayabilir."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Çevrilebilir metne satır bilgisinden oyuncu adını ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Yalnızca konuşmada bulunan karakterler, her grup öğesi için sözlük olarak yüklenecektir. Oyuncu referansını istem mesajında yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, ayrıca karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>OYUNCU_BİLGİSİ</code> değişkenini eklemeniz gerekir."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin bulunduğu sütun. Bu sütun, aktör referansının çevirisi olarak kullanılacak. Bu, konuşmadaki aktör adı çevirilerinin tutarlılığını artıracak."],["Actor's Information Column","Aktör Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş vb. daha fazla bilgi ekleyebilirsiniz. Bu, konuşmadaki zamir çevirilerini iyileştirecek."],["Extra Prompt","Ek İpucu"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İpucu mesajına eklenecek ek ipucu. Sistem mesajından sonra ve asıl ipucu mesajından önce eklenecek."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her parti için her zaman ayrı dosya"],["Append actor name to the translatable text","Çevrilebilir metne aktör adını ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, ipucuna otomatik olarak bir sözlük eklemenize yardımcı olacak. Çeviri kalitesini artırmak için sözlük her parti öğe için yüklenecek. Özellik, ipucunuzu şişirmemek için yalnızca ilgili terimleri yüklemeye çalışacak.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgileri Sütunu"],["Prompt","İpucu"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transGeminiAi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","ChatGPT API ile Sohbet"],["Batch Manager","Parti Yöneticisi"],["This feature is only available if you have a project open.","Bu özellik yalnızca açık bir projeniz varsa kullanılabilir."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transGeminiAi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","Bu işlem bir tarayıcı penceresi başlatacaktır. Varsayılan tarayıcınızın Chrome tarayıcısı olarak ayarlandığından emin olun. Devam etmek istiyor musunuz?"],["Gemini Nano server is already running. Do you want to restart it?","Gemini Nano sunucusu zaten çalışıyor. Yeniden başlatmak istiyor musunuz?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","Bu işlem bir tarayıcı penceresi başlatacaktır. Varsayılan tarayıcınızın Chrome tarayıcısı olarak ayarlandığından emin olun. Ve Gemini Nano Sunucusu başlatıldı. Devam etmek istiyor musunuz?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":false,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"relPath":"/addons/transGeminiNano/geminiNanoUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>OYUNCU_BİLGİSİ : Oyuncu bilgilerinin sözlüğü. (Yalnızca toplu modda oyuncu bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluştur. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>BAĞLAM : Önceki çevirinin bağlamı (eğer bağlam etkinse)</li>"],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her toplu işlem için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının başka dosyalarla karışmasını önleyebilir."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Çevrilebilir metne satır bilgisinden oyuncu adını ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Aktör Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ aktör referansını sözlük olarak yükleyecek. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Aktör referansı, diyalogdaki aktörün adıdır. Bu, çevirmene bir sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Yalnızca konuşmada bulunan karakterler her bir toplu öğe için sözlük olarak yüklenecektir. Aktör referansını istem mesajında yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>ACTOR_INFO</code> değişkenini de eklemeniz gerekir."],["Actor Reference Translation Column","Aktör Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Aktör adının çevirisinin bulunduğu sütun. Bu sütun, aktör referansının çevirisi olarak kullanılacaktır. Bu, konuşmada aktör adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Aktörün Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Aktörün ek bilgilerini içeren sütun. Cinsiyet, yaş vb. daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her toplu işlem için daima ayrı dosya"],["Append actor name to the translatable text","Çevrilebilir metne aktör adını ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, isteme otomatik olarak bir sözlük eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her toplu öğe grubu için yüklenecektir. Özellik, isteminizi şişirmemek için yalnızca ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgi Sütunu"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"relPath":"/addons/transKoboldAI/Llama3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":24,"length":24,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","Hizmet Adı"],["Service provider for your Batch API.","Toplu API'niz için hizmet sağlayıcı."],["Your API Key","API Anahtarınız"],["Please enter your API key for the Batch API service.","Lütfen Toplu API hizmeti için API anahtarınızı girin."],["Model","Model"],["The model for your translation.","Çeviri modeliniz."],["Source Column","Kaynak Sütun"],["The column of the original texts you want to translate.","Çevirmek istediğiniz orijinal metinlerin bulunduğu sütun."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgisinden oyuncu adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olur. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldırır. Bu, çeviri maliyetini artıracaktır."],["Ignore if already translated","Zaten çevrilmişse yoksay"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Bu seçenek işaretlenirse, Translator++ sütununda zaten çeviri bulunan satırları yoksayacaktır."],["Filter Tag","Filtre Etiketi"],["If set, only rows with this tag will be translated.","Ayarlanırsa, yalnızca bu etikete sahip satırlar çevrilecektir."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olur. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene bir sözlük olarak yüklenecek ve çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Yalnızca konuşmada bulunan karakterler, her toplu öğe için sözlük olarak yüklenecektir. Oyuncu referansını yüklemek için şablon komutunu kullanın."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Oyuncu adının çevirisinin bulunduğu sütun. Bu sütun, oyuncu referansının çevirisi olarak kullanılacak ve konuşmadaki oyuncu adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Oyuncu Bilgisi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Oyuncunun ek bilgilerini içeren sütun. Cinsiyet, yaş gibi daha fazla bilgi ekleyebilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Enable Context","Bağlamı Etkinleştir"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Çeviri için bağlamı etkinleştirin. Mevcut toplu öğenin üzerindeki daha önce çevrilmiş materyal bağlam olarak dahil edilecektir. <b>Ayrıca şablona BAĞLAM'ı açıkça eklemeniz gerekir</b>"],["Context Character Limit","Bağlam Karakter Sınırı"],["Character limit for the context.","Bağlam için karakter sınırı."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, ChatGPT asistanınızın rolünü belirten mesajın başlığıdır. Bu mesaj, ChatGPT'ye gönderdiğiniz her toplu işin en ilk mesajı olarak gönderilir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Şablon Değişmezleri stiliyle aşağıdaki değişkenleri ekleyebilirsiniz: <span class='inlineCode'><b>${</b>DEĞİŞKEN<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tam kaynak dil adı</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tam hedef dil adı</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yedeği).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Toplu işteki mesaj sayısı.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Aktörlerin bilgilerini ekleyin.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERENCE[Ortak Referans]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bağlam olarak bazı önceki satırları dahil edin</li>"],["Body Message Template","Gövde Mesajı Şablonu"],["Template of the body of your chat.","Sohbetinizin gövdesinin şablonu."],["Sample conversation","Örnek konuşma"],["User message","Kullanıcı mesajı"],["Assistant's response","Asistanın yanıtı"],["Enable JailBreak","JailBreak'i Etkinleştir"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Çeviri için Jailbreak'i etkinleştirin. Bu, çeviriyi daha doğru ve daha az önyargılı hale getirecektir. Bazı modeller kurgusal olayları gerçek hayat olaylarıyla ilişkilendirmek isteyebilir, bu nedenle kendi anlatılarına uyacak şekilde çeviriyi değiştirmeye çalışabilirler. Bu seçenek bunu engeller."],["Jailbreak Template","Jailbreak Şablonu"],["Template of the Jailbreak message.","Jailbreak mesajının şablonu."],["Maximum Tokens","Maksimum Token"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Tamamlamada oluşturulacak maksimum token sayısı.<br>İsteminizin token sayısı artı max_tokens, modelin bağlam uzunluğunu aşamaz. Çoğu modelin bağlam uzunluğu 2048 token'dır (en yeni modeller hariç, bunlar 4096'yi destekler)."],["Temperature","Sıcaklık"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0 ile 2 arasında kullanılacak örnekleme sıcaklığı. 0.8 gibi yüksek değerler çıktıyı daha rastgele yapar, 0.2 gibi düşük değerler ise daha odaklanmış ve belirleyici hale getirir. <br>OpenAI genellikle bunu veya top_p'yi değiştirmeyi önerir, ancak ikisini birden değil."],["Nucleus sampling (top_p)","Çekirdek örneklemesi (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Sıcaklıkla örneklemeye bir alternatif olan çekirdek örneklemesi, modelin top_p olasılık kütlesine sahip token'ların sonuçlarını dikkate alır. Yani 0.1, yalnızca en yüksek %10 olasılık kütlesini oluşturan token'ların dikkate alındığı anlamına gelir. <br>OpenAI genellikle bunu veya sıcaklığı değiştirmeyi önerir, ancak ikisini birden değil."],["Frequency Penalty","Frekans Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni token'ları metindeki mevcut frekanslarına göre cezalandırır, böylece modelin aynı satırı kelimesi kelimesine tekrarlama olasılığını azaltır. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Varlık Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni token'ları metinde şu ana kadar görünüp görünmediklerine göre cezalandırır, böylece modelin yeni konulardan bahsetme olasılığını artırır. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","Özel Parametre"],["Key","Anahtar"],["Value","Değer"],["Type","Tür"],["Type of the value.","Değerin türü."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b> türü için, değer JavaScript kodu olarak değerlendirilecektir."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript kodunun kapsamı <code>window</code>'dur. Bu nedenle neredeyse herhangi bir değeri alabilirsiniz."],["Example: <code>trans.project.title</code>","Örnek: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","API'ye gönderilmeyecek parametreleri bırakın.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API sürekli değişiyor, bazı yeni modeller eski parametreleri desteklemeyebilir ve tanınmayan istek parametreleri için HTTP hatası döndürebilir."],["You can drop the parameters that are not supported by the model here.","Model tarafından desteklenmeyen parametreleri burada bırakabilirsiniz."],["Batch API settings","Toplu API ayarları"],["General","Genel"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI Toplu API, projenizi asenkron olarak %50 daha düşük maliyetle çevirmenize olanak tanır, yani çeviri sonuçlarınızı <b style=\"color:red\">24 saat içinde</b> <b style=\"color:blue\">normal maliyetin yarısına</b> alırsınız. Bu, acil çeviri sonuçları gerektirmeyen büyük projeler için özellikle kullanışlıdır."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Toplu API hakkında daha fazla bilgiyi <a href=\"https://platform.openai.com/docs/guides/batch\" external>buradan</a> okuyun.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />Desteklenen hizmetler: <b>OpenAI</b> ve <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>Daha fazla yapılandırma Eklenti Ayarları'nda bulunur</h2>"],["Open Add-on Settings","Eklenti Ayarlarını Aç"],["Import Configuration from OpenAI Setting","OpenAI Ayarlarından Yapılandırmayı İçe Aktar"],["General Settings","Genel Ayarlar"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Mantıklı Modellere Paranızı Boşa Harcamayın</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Çeşitli çalışmalar, mantıklı modellerin yaratıcı yazma ve çeviri görevlerinde normal modellerden çok daha kötü olduğunu kanıtlamıştır.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Mantıklı modeller kullanırken, daha pahalı maliyet ve daha yavaş yanıt sürelerinden başka bir şey kazanmazsınız.</p>"],["<h2>If you're using OpenAI</h2>","<h2>OpenAI kullanıyorsanız</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","OpenAI Batch API, standart API'ye kıyasla biraz farklı bir model adlandırma kuralı kullanır. Toplu Mod'daki modeller -batch sonekini içerir. Örneğin, <code>gpt-4.1-mini</code> belirtirseniz, otomatik olarak <code>gpt-4.1-mini-batch</code> olarak yorumlanacaktır.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","Ancak, bu eklenti geliştirildiğinde, toplu modeller OpenAI'nin model kullanım limitleri altında listelenmiyordu. Bu, Model Kullanım filtresini \"İzin Ver\" (beyaz liste) olarak ayarlayan kullanıcıların Batch API'ye erişemeyeceği anlamına gelir.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","Modelin kullanım limitlerini değiştirmek için <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>buraya</a> tıklayın."],["Explore more models","Daha fazla model keşfedin"],["Append actor name to the translatable text","Aktör adını çevrilebilir metne ekle"],["Ignore translated rows","Çevrilmiş satırları yoksay"],["Templates","Şablonlar"],["<h2>1. System Message</h2>","<h2>1. Sistem Mesajı</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Burada, asistana rollerinin ne olduğunu açıklayabilirsiniz.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut diyalog örneği. Amacınızı ve konuşmanın bağlamını çevirmenin anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Gerçek isteminiz</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Bu, asistana yönelik gerçek istemdir.</p>"],["Enable Jailbreak","Jailbreak'i Etkinleştir"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, çeviri kalitesini artırmak için her öğe grubu için bir sözlüğü otomatik olarak isteme eklemenize yardımcı olacaktır. Özellik, isteminizi şişirmemek için yalnızca ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgilerinin Sütunu"],["Enable context","Bağlamı etkinleştir"],["Advanced","Gelişmiş"],["Custom Parameters","Özel Parametreler"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API istek gövdesine özel parametreler ekleyebilirsiniz. Bu, formda mevcut olmayan ek parametreler eklemek istediğinizde kullanışlıdır."],["<h2>Warning</h2>","<h2>Uyarı</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Özel parametreleri yanlış ayarlamak API isteğinin başarısız olmasına neden olabilir. Özel parametreler eklemeden önce ne yaptığınızdan emin olun. OpenAI gibi bazı hizmetler gönderdiğiniz parametreler konusunda katıdır ve tanınmayan istek parametreleri için HTTP hatası döndürebilir.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Aynı anahtar birden fazla kez kullanılırsa, sadece son değer kullanılacaktır.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Mevcut yapılandırmada aynı anahtar kullanılırsa, mevcut yapılandırma parametresi özel parametre tarafından üzerine yazılacaktır.</li>"],["String","Dize"],["Number","Sayı"],["Boolean","Boolean"],["JavaScript","JavaScript"],["Drop Parameters","Parametreleri Bırak"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Genel maliyet</h3>\n                        Genel maliyet, asıl çeviri metinleri olmadan asistana gönderdiğiniz prompt mesajının maliyetidir. Maliyet, prompt mesajındaki token sayısına göre hesaplanır. Ne kadar çok tokenınız varsa, maliyet o kadar yüksek olacaktır.<br>\n                        <b>Tahmini genel maliyet:</b> <span class=\"overheadCost\">0</span> token / istek."],["Are you sure you want to reset the form?","Formu sıfırlamak istediğinizden emin misiniz?"],["Translate with Batch API","Toplu API ile Çevir"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Toplu işlemi işlemek istediğinizden emin misiniz?\nBu işlem için maliyet oluşacaktır."],["The batch is successfully created. Do you want to open the batch manager?","Toplu işlem başarıyla oluşturuldu. Toplu yöneticiyi açmak ister misiniz?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","OpenAI ayarlarından yapılandırmayı içe aktarmak istediğinizden emin misiniz? Bu, mevcut yapılandırmayı üzerine yazacaktır."],["chatGPT engine is not found","chatGPT motoru bulunamadı"],["Configuration imported successfully.","Yapılandırma başarıyla içe aktarıldı."],["Batch API Queue","Toplu API Kuyruğu"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"relPath":"/addons/transLLMBatchApi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":125,"length":125,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Lütfen çeviriyi uygulamak için satırları seçin"],["Target Column","Hedef Sütun"],["The column to put the translation result.","Çeviri sonucunu koymak için sütun."],["Import translation from ChatGPT Batch","ChatGPT Partisinden çeviriyi içe aktar"],["Translation applied to selected rows","Seçilen satırlara çeviri uygulandı"],["Invalid format","Geçersiz biçim"],["OK","Tamam"],["Mismatch","Uyuşmazlık"],["Failed to load batch list with error: \n","Parti listesi yüklenemedi, hata: \n"],["Download Error File","Hata Dosyasını İndir"],["Batch is not completed yet","Toplu işlem henüz tamamlanmadı"],["Are you sure you want to cancel this batch?","Bu toplu işlemi iptal etmek istediğinizden emin misiniz?"],["Cannot cancel completed batch.","Tamamlanmış toplu işlem iptal edilemez."],["Batch cancelled","Toplu işlem iptal edildi"],["Failed to cancel batch","Toplu işlem iptal edilemedi"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","Toplu İşlemler"],["Apply translation","Çeviriyi uygula"],["Cancel batch","Toplu işlemi iptal et"],["Status","Durum"],["Batch ID","Toplu İşlem Kimliği"],["Input File ID","Giriş Dosyası Kimliği"],["End point","Uç Nokta"],["Created at","Oluşturulma tarihi"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Son kullanma tarihi <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Zamanında tamamlanmayan toplu işlemler sonunda süresi dolmuş duruma geçer; bu toplu işlemdeki tamamlanmamış istekler iptal edilir ve tamamlanmış isteklere yanıtlar toplu işlemin çıktı dosyası üzerinden kullanılabilir hale getirilir. Tamamlanmış isteklerden tüketilen tokenler için ücretlendirilirsiniz.\"></i>"],["Completed at","Tamamlanma tarihi"],["Errors","Hatalar"],["Batch Item Detail of","Toplu İşlem Öğesi Detayı"],["ID","Kimlik"],["Completed on","Tamamlanma tarihi"],["Model","Model"],["Prompt Token","İstek Belirteci"],["Completion Token","Tamamlama Belirteci"],["Total Token","Toplam Belirteci"],["Status Code","Durum Kodu"],["error","hata"],["Conversation","Konuşma"],["Response Validation","Yanıt Doğrulama"],["Raw Payload","Ham Yük"],["View raw payload","Ham yükü görüntüle"],["Response Preview","Yanıt Önizleme"],["Apply translations from selected rows","Seçili satırlardan çevirileri uygula"],["Here you can edit the translation result individually and send it into Translator++","Burada çeviri sonucunu bireysel olarak düzenleyebilir ve Translator++'a gönderebilirsiniz"],["Open ChatGPT Settings","ChatGPT Ayarlarını Aç"],["Help","Yardım"],["File list","Dosya listesi"],["Collapse / restore left panel","Sol paneli daralt / geri yükle"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Zamanında tamamlanmayan toplu işlemler sonunda süresi dolmuş duruma geçer; o toplu işlemdeki tamamlanmamış istekler iptal edilir ve tamamlanmış isteklere yanıtlar, toplu işlemin çıktı dosyası üzerinden kullanılabilir hale getirilir. Tamamlanmış isteklerden tüketilen belirteçler için ücretlendirilirsiniz."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","Hizmet Adı"],["Service provider for your Batch API.","Batch API'niz için hizmet sağlayıcı."],["API Key","API Anahtarı"],["Please enter your API key for the Batch API service.","Lütfen Batch API hizmeti için API anahtarınızı girin."],["Model","Model"],["The pre-trained model","Önceden eğitilmiş model"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","ChatGPT'de, kullanılacak izin verilen modeli ayarlamanız gerekebilir (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","JailBreak'i Etkinleştir"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Çeviri için Jailbreak'i etkinleştirin. Bu, çeviriyi daha doğru ve daha az önyargılı yapar. Bazı modeller kurgusal olayları gerçek hayat olaylarıyla ilişkilendirmek isteyebilir, bu nedenle kendi anlatımlarına uyacak şekilde çeviriyi değiştirmeye çalışır. Bu seçenek bunu engeller."],["Jailbreak Template","Jailbreak Şablonu"],["Template of the Jailbreak message.","Jailbreak mesajının şablonu."],["Maximum Tokens","Maksimum Token"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Tamamlamada üretilecek maksimum token sayısı.<br>İstek token sayınız artı max_tokens, modelin bağlam uzunluğunu aşamaz. Çoğu modelin bağlam uzunluğu 2048 token'dır (4096 destekleyen en yeni modeller hariç)."],["Temperature","Sıcaklık"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","0 ile 2 arasında kullanılacak örnekleme sıcaklığı. 0.8 gibi yüksek değerler çıktıyı daha rastgele yapar, 0.2 gibi düşük değerler ise daha odaklı ve belirleyici yapar. <br>OpenAI genellikle bunu veya top_p'yi değiştirmenizi önerir, ancak ikisini birden değil."],["Nucleus sampling (top_p)","Çekirdek örneklemesi (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Sıcaklıkla örneklemeye bir alternatif olan çekirdek örneklemesi, modelin top_p olasılık kütlesine sahip token'ların sonuçlarını dikkate alır. Yani 0.1, yalnızca en üst %10 olasılık kütlesini oluşturan token'ların dikkate alındığı anlamına gelir. <br>OpenAI genellikle bunu veya sıcaklığı değiştirmenizi önerir, ancak ikisini birden değil."],["Frequency Penalty","Frekans Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni token'ları metindeki mevcut frekanslarına göre cezalandırır, böylece modelin aynı satırı kelimesi kelimesine tekrarlama olasılığını azaltır. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Varlık Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni token'ların metinde daha önce görünüp görünmediğine bağlı olarak cezalandırır, böylece modelin yeni konulardan bahsetme olasılığını artırır. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","Parti Başına Maksimum Karakter"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Çeviri partisi başına maksimum karakter sınırı.\nBu seçenek yalnızca orijinal metnin karakter uzunluğunu sayar, istem mesajının karakter uzunluğunu saymaz."],["Max row per concurrent requests","Eşzamanlı İstek Başına Maksimum Satır"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Her eşzamanlı istek için kaç satıra izin verildiği. Bu özelliği devre dışı bırakmak için <b>0</b> olarak ayarlayın.<br />Bu seçenek devre dışı bırakılırsa, kaç <b>Maksimum eşzamanlı istek</b> ayarlarsanız ayarlayın, Translator++ isteği tek bir parça olarak işler.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Ne kadar çok satır ayarlarsanız, tek bir partide o kadar çok çeviri alırsınız. Bu, ek yük maliyetini azaltır ve AI'nın hata sonuçları döndürme şansını artırır.<br />Sayı ne kadar düşükse, çevirinin hata verme olasılığı o kadar az olur, ancak ek yük istemleri için ekstra maliyet ödersiniz."],["Code Escaping Algorithm","Kod Kaçış Algoritması"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Diyaloglar içindeki satır içi kodlar için kaçış algoritması. Seçtiğiniz kaçış algoritmasına göre <b>Sistem Mesajı Şablonu</b> ve <b>Gövde Mesajı Şablonu</b>'nu değiştirmeniz gerekebilir.<br /><b>JSONCloaking</b> seçtiğinizde, response_format: { type: 'json_object' } parametresi ChatGPT'ye otomatik olarak gönderilir. <b>JSONCloaking</b> çok doğrudur, ancak tüm modellerle çalışmaz, <b>gpt-3.5-turbo-1106</b> ile deneyin."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>Toplu API</b>, bir seferde birçok istek göndermenize olanak tanır; bu istekler arka planda eşzamansız olarak işlenir. Sonuçları hemen almazsınız, ancak işlem <b>24 saat içinde tamamlanır</b>—ve genellikle çok daha hızlı. Bu yöntem <b>standart yaklaşımdan sadece yarısı kadar maliyetlidir</b>."],["Batch API settings","Toplu API ayarları"],["General","Genel"],["Explore more models","Daha fazla model keşfedin"],["Templates","Şablonlar"],["Enable Jailbreak","Jailbreak'i Etkinleştir"],["Advanced","Gelişmiş"],["Batch Translation Setting","Toplu Çeviri Ayarı"],["Default","Varsayılan"],["JavaScript template cloaking","JavaScript şablon gizleme"],["None (no escaping)","Hiçbiri (kaçış yok)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"relPath":"/addons/transLLMBatchApi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":39,"length":39,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>OYUNCU_BİLGİSİ : Oyuncu bilgilerinin sözlüğü.(Yalnızca toplu işlem modunda oyuncu bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluştur. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>BAĞLAM : Önceki çevirinin bağlamı (eğer bağlam etkinse)</li>"],["Sample conversation","Örnek konuşma"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her toplu işlem için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının başka dosyalarla karışmasını önleyebilir."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgisinden oyuncu adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene bir sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Yalnızca konuşmada bulunan karakterler, her toplu işlem öğesi için sözlük olarak yüklenecektir. Oyuncu referansını istem mesajına yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>OYUNCU_BİLGİSİ</code> değişkenini de dahil etmeniz gerekir."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Oyuncu adının çevirisinin bulunduğu sütun. Bu sütun, oyuncu referansının çevirisi olarak kullanılacaktır. Bu, konuşmadaki oyuncu adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Oyuncunun Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Oyuncunun ek bilgilerini içeren sütun. Cinsiyet, yaş vb. gibi daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Extra Prompt","Ek İstem"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İleti mesajına eklenecek ek istem. Bu, sistem mesajından sonra ve gerçek istem mesajından önce eklenecektir."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her parti için her zaman ayrı dosya"],["Append actor name to the translatable text","Aktör adını çevrilebilir metne ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, otomatik olarak isteme bir sözlük eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her parti öğe için yüklenecektir. Özellik, isteminizi şişirmemek için yalnızca ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgilerinin Sütunu"],["Prompt","İstem"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transLLMBatchApi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","Parti Yöneticisini Aç"],["This feature is only available if you have a project open.","Bu özellik yalnızca açık bir projeniz varsa kullanılabilir."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":false,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transLLMBatchApi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","LiteLLM'nin proxy URL'si. LiteLLM proxy'nizin URL adresi. Varsayılan: <code>http://localhost:8890/chat/completions</code>"],["API's base URL","API'nin temel URL'si"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","Seçtiğiniz hizmetin temel URL'si. Bu alanı yalnızca özel bir uç nokta URL'si kullanıyorsanız doldurun. LiteLLM, verilen modele göre temel URL'yi otomatik olarak algılayacaktır.<br />LiteLLM'in URL'ye yol ekleme şekli hizmete bağlıdır. Örneğin, OpenAI uyumlu uç noktalar için LiteLLM, verilen URL'ye <code>/chat/completions</code> ekleyecektir. Bu nedenle, uç noktanız <code>https://api.fast-tunnel.one/v1/chat/completions</code> ise, bu alanı <code>https://api.fast-tunnel.one/v1</code> ile doldurun."],["API Version","API Sürümü"],["Optional. The API version parameter needed for some services.","İsteğe bağlı. Bazı hizmetler için gerekli olan API sürümü parametresi."],["API Key","API Anahtarı"],["Optional. The API key used for authenticating your access to the service.","İsteğe bağlı. Hizmete erişiminizi doğrulamak için kullanılan API anahtarı."],["Model","Model"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","Tercih ettiğiniz modeli önceden eğitin. Tercih ettiğiniz modeli belirtmek için LiteLLM model kolaylık formatını kullanın. Format {hizmet adı}/{model} şeklindedir. Örneğin:"],["your deployment name","dağıtım adınız"],["However, some models have unique names that can be directly identified, like:","Ancak, bazı modellerin doğrudan tanımlanabilen benzersiz adları vardır, örneğin:"],["Azure AD Token","Azure AD Token"],["AWS Access Key ID","AWS Erişim Anahtarı Kimliği"],["AWS secret access key","AWS gizli erişim anahtarı"],["Open router site URL","Open router site URL'si"],["Open router APP name","Open router uygulama adı"],["Enable Context","Bağlamı Etkinleştir"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Çeviri için bağlamı etkinleştirin. Mevcut toplu işin üzerindeki önceden çevrilmiş materyal bağlam olarak dahil edilecektir. <b>Ayrıca bağlamı şablona açıkça dahil etmeniz gerekir</b>"],["Context Character Limit","Bağlam Karakter Sınırı"],["Character limit for the context.","Bağlam için karakter sınırı."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, chatGPT asistanınızın rolünün ne olduğunu söyleyen mesajın başlığıdır. Bu mesaj, chatGPT'ye gönderdiğiniz her toplu işin ilk mesajı olarak gönderilecektir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Şablon Değişmezleri stiliyle aşağıdaki değişkenleri kullanabilirsiniz <span class='inlineCode'><b>${</b>DEĞİŞKEN<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yedeği).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Toplu işteki mesaj sayısı.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Oyuncu bilgilerinin sözlüğü. (Yalnızca toplu modda oyuncu bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERENCE[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Önceki çevirinin bağlamı (bağlam etkinse)</li>"],["Sample conversation","Örnek konuşma"],["User message","Kullanıcı mesajı"],["Assistant's response","Asistanın yanıtı"],["Body Message Template","Gövde Mesajı Şablonu"],["Template of the body of your message.","Mesajınızın gövdesinin şablonu."],["Enable JailBreak","JailBreak'i Etkinleştir"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Çeviri için Jailbreak'i etkinleştirin. Bu, çeviriyi daha doğru ve daha az yanlı hale getirecektir. Bazı modeller kurgusal olayları gerçek hayat olaylarıyla ilişkilendirmek isteyebilir, bu nedenle kendi anlatılarına uyacak şekilde çeviriyi değiştirmeye çalışacaklardır. Bu seçenek bunu engeller."],["Jailbreak Template","Jailbreak Şablonu"],["Template of the Jailbreak message.","Jailbreak mesajının şablonu."],["Maximum Tokens","Maksimum Token"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Tamamlamada oluşturulacak maksimum token sayısı.<br>İsteminizin token sayısı artı maksimum token, modelin bağlam uzunluğunu aşamaz. Çoğu model 2048 token bağlam uzunluğuna sahiptir (en yeni modeller hariç, bunlar 4096 destekler)."],["Temperature","Sıcaklık"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Kullanılacak örnekleme sıcaklığı, 0 ile 2 arasında. 0.8 gibi yüksek değerler çıktıyı daha rastgele yapar, 0.2 gibi düşük değerler ise daha odaklı ve belirleyici yapar.<br>OpenAI genellikle bunu veya top_p'yi değiştirmeyi önerir, ancak her ikisini birden değil."],["Nucleus sampling (top_p)","Çekirdek örnekleme (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Sıcaklıkla örnekleme yerine kullanılan bir alternatif, çekirdek örnekleme, modelin top_p olasılık kütlesine sahip tokenların sonuçlarını dikkate alır. Yani 0.1, yalnızca en yüksek %10 olasılık kütlesini oluşturan tokenların dikkate alındığı anlamına gelir.<br>OpenAI genellikle bunu veya sıcaklığı değiştirmeyi önerir, ancak her ikisini birden değil."],["Frequency Penalty","Frekans Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni tokenları metindeki mevcut frekanslarına göre cezalandırır, böylece modelin aynı satırı kelimesi kelimesine tekrarlama olasılığını azaltır.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Varlık Cezası"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0 ile 2.0 arasında bir sayı. Pozitif değerler, yeni tokenları metinde daha önce görünüp görünmediklerine göre cezalandırır, böylece modelin yeni konulardan bahsetme olasılığını artırır.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","JSON Şeması Kullan"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Eski <code>json_object</code> yerine <code>response_format.type</code> alanı için <code>json_schema</code> kullanın. <code>json_schema</code>, bazı en yeni modeller ve <b>LM Studio</b> gibi bazı sunucular tarafından gereklidir, ancak bazı eski modeller hala <code>json_object</code> kullanıyor."],["Stop","Durdur"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","API'nin daha fazla token oluşturmayı durduracağı bir anahtar kelime girin. Her girişi yeni bir satırla ayırın."],["Additional argument variables","Ek argüman değişkenleri"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","Sunucu başlatılırken eklenen ek argüman değişkenleri.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","Toplu İşlem Zaman Aşımı"],["Timeout for each batch in milisecond","Her toplu işlem için milisaniye cinsinden zaman aşımı."],["Max Request Length","Maksimum İstek Uzunluğu"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","Her çeviri grubu için maksimum karakter uzunluğu.\nHer çevirmenin farklı özellikleri vardır.\nGET parametresi kullanan WEB ön uç çevirmenleri için 2000'den az öneririm."],["Max concurrent requests","Maksimum eşzamanlı istek"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","Aynı anda kaç eşzamanlı isteğin bağlanmasına izin verildiği. Bu özelliği devre dışı bırakmak için <b>0</b> olarak ayarlayın.<br />Çeviri hızını artırmak için bu seçeneği <b>Eşzamanlı istek başına maksimum satır</b> ile birleştirin."],["Max row per concurrent requests","Eşzamanlı istek başına maksimum satır"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","Her eşzamanlı istek için kaç satıra izin verildiği. Bu özelliği devre dışı bırakmak için <b>0</b> olarak ayarlayın.<br />Bu seçenek devre dışıysa, <b>Maksimum eşzamanlı istek</b> ne kadar ayarlanırsa ayarlansın, Translator++ isteği tek bir parça olarak işler."],["Batch delay","Toplu gecikme"],["Delay between batch (in miliseconds)","Toplular arası gecikme (milisaniye cinsinden)"],["Code Escaping Algorithm","Kod Kaçış Algoritması"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","Diyaloglar içindeki satır içi kod için kaçış algoritması. Seçtiğiniz kaçış algoritmasına göre <b>Sistem Mesajı Şablonu</b> ve <b>Gövde Mesajı Şablonu</b>'nu değiştirmeniz gerekebilir."],["Number of retry","Yeniden deneme sayısı"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Çeviri çıktısı doğrulaması başarısız olduğunda motorun kaç kez yeniden denemesi gerektiği. Boş (nullish) ise, yeniden deneme yapılmaz."],["Retry when the number of translated rows doesn't match original","Çevrilen satır sayısı orijinalle eşleşmediğinde yeniden dene"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Etkinleştirilirse, model orijinal yük ile karşılaştırıldığında farklı sayıda çeviri satırı döndürdüğünde motor yeniden dener."],["Retry when the number of lines for each translated row doesn't match original","Her çevrilen satırın satır sayısı orijinalle eşleşmediğinde yeniden dene"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Etkinleştirilirse, herhangi bir çevrilen satırın orijinal satırından farklı sayıda satırı olduğunda motor yeniden dener."],["Prompt: Row count mismatch","İstem: Satır sayısı uyumsuzluğu"],["Prompt used when retrying due to row/element count mismatch.","Satır/öğe sayısı uyumsuzluğu nedeniyle yeniden deneme için kullanılan istem."],["Prompt: Line count mismatch","İstem: Satır sayısı uyumsuzluğu"],["Prompt used when retrying due to per-row line count mismatch.","Satır başına satır sayısı uyumsuzluğu nedeniyle yeniden deneme için kullanılan istem."],["Prompt: Error / Retry instruction","İstem: Hata / Yeniden Dene talimatı"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","Uyuşmazlık istem(ler)inden sonra eklenen, modeli yeniden denemeye yönlendiren istem."],["Custom Parameter","Özel Parametre"],["Key","Anahtar"],["Value","Değer"],["Type","Tür"],["Type of the value.","Değerin türü."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b> türü için, değer JavaScript kodu olarak değerlendirilecektir."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript kodunun kapsamı <code>window</code>'dur. Bu nedenle neredeyse her değeri alabilirsiniz."],["<br />Example: <code>trans.project.title</code>","<br />Örnek: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","API'ye gönderilmeyecek parametreleri bırakın.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API sürekli değişiyor, bazı yeni modeller eski parametreleri desteklemeyebilir ve tanınmayan istek parametresi için HTTP hatası döndürebilir."],["You can drop the parameters that are not supported by the model here.","Model tarafından desteklenmeyen parametreleri burada bırakabilirsiniz."],["Manage configuration","Yapılandırmayı yönet"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","Bu motorun bazı özellikleri ChatGPT eklentisinin kurulu olmasını gerektirir. Lütfen bu motoru kullanmadan önce ChatGPT eklentisini kurduğunuzdan emin olun."],["Text Completion Setting","Metin Tamamlama Ayarı"],["General","Genel"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Akıl Yürütme Modellerine Paranızı Boşa Harcamayın</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Çeşitli çalışmalar, akıl yürütme modellerinin yaratıcı yazma ve çeviri görevlerinde normal modellerden çok daha kötü olduğunu kanıtlamıştır.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Akıl yürütme modellerini kullanırken, daha pahalı maliyet ve daha yavaş yanıt sürelerinden başka bir şey kazanmazsınız.</p>"],["Platform specific","Platforma özel"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","Şablonlar"],["Enable context","Bağlamı etkinleştir"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Çevirmenin amacınızı ve konuşmanın bağlamını anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["Retry prompts","Yeniden deneme istemleri"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Bu istemler, önceki model çıktısının hemen ardından, yeniden denemeler sırasında ek <b>kullanıcı</b> mesajları olarak eklenir.</p>"],["<p>Available variables:</p>","<p>Kullanılabilir değişkenler:</p>"],["Enable Jailbreak","Jailbreak'i etkinleştir"],["Advanced","Gelişmiş"],["Custom Parameters","Özel Parametreler"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API istek gövdesine özel parametreler ekleyebilirsiniz. Bu, formda mevcut olmayan ek parametreler eklemek istediğinizde kullanışlıdır."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>Uyarı</h2><ul><li>Özel parametreleri yanlış ayarlamak API isteğinin başarısız olmasına neden olabilir. Özel parametre eklemeden önce ne yaptığınızı bildiğinizden emin olun. OpenAI gibi bazı hizmetler gönderdiğiniz parametrelere katıdır ve tanınmayan istek parametreleri için HTTP hatası döndürür.</li><li>Aynı anahtar birden fazla kez kullanılırsa, yalnızca son değer kullanılır.</li><li>Mevcut yapılandırmada aynı anahtar kullanılırsa, mevcut yapılandırma parametresi özel parametre tarafından üzerine yazılır.</li></ul>"],["Drop Parameters","Parametreleri Bırak"],["LiteLLM Proxy Configuration","LiteLLM Proxy Yapılandırması"],["Start LiteLLM server","LiteLLM sunucusunu başlat"],["Processing...","İşleniyor..."],["Server started on port ","Sunucu başlatıldı, port: "],["Check LiteLLM Status","LiteLLM Durumunu Kontrol Et"],["Change LiteLLM Version","LiteLLM Sürümünü Değiştir"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","Kurulumu istediğiniz yeni LiteLLM sürümünü girin.\nBilinen çalışan sürümler: 1.38.0, 1.49.4 \nÖnerilen sürüm: "],["Are you sure you want to install LiteLLM version ","LiteLLM sürüm "],["Failed to install LiteLLM. Please check the console for more details.","LiteLLM kurulumu başarısız oldu. Daha fazla ayrıntı için konsolu kontrol edin."],["LiteLLM has been successfully updated to version ","LiteLLM başarıyla sürüm "],["Batch Translation Setting","Toplu Çeviri Ayarları"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Üzgünüz, bu eklenti yalnızca aktif destekçiler için kullanılabilir.\nBu özelliği $1 destekçi olarak açabilirsiniz."],["Retries and Refinement","Tekrar Denemeler ve İyileştirme"],["<h2>Retries and Refinement</h2>","<h2>Tekrar Denemeler ve İyileştirme</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Çeviri çıktısı doğrulamayı geçemediğinde, Translator++ modelden çeviriyi tekrar denemesini isteyebilir. Modelin kaç kez tekrar deneyeceğini ve tekrar deneme koşullarını ayarlayabilirsiniz.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Uygun tekrar deneme koşullarıyla makul sayıda tekrar ayarlamak, maliyet ve süreyi kontrol altında tutarken çeviri kalitesini önemli ölçüde artırabilir.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Her tekrar deneme ek zaman ve para maliyeti getirir</b>. Toplu çeviriniz sık sık tekrar denerse, model için talimatları daha net hale getirmek amacıyla komutunuzu ayarlamak isteyebilirsiniz.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Toplu çevirinizi hata ayıklamak için geliştirici aracını veya Toplu Yönetici'yi kullanın.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Kod Kaçış Algoritması</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Kod kaçışı, MTL'nin diyaloglar içindeki kod parçacıklarını değiştirmesini önlemek için kullanılan bir tekniktir. Bu, diyaloglarınızda HTML etiketleri, XML etiketleri, JSON nesneleri veya JavaScript şablonları gibi kod parçacıkları içerdiğinde kullanışlıdır.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Diyaloglarınızın içindeki kod parçacıklarına uygun kaçış algoritmasını seçin. <b>Sistem mesajı</b>, <b>Örnek komut</b> ve <b>Gövde mesajı</b> şablonlarını buna göre ayarlamanız gerekebilir.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Kod kaçış algoritmaları ve bunları etkili bir şekilde nasıl kullanacağınız hakkında daha fazla bilgi için <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>buraya</a> tıklayın.</p>"],["JavaScript template cloaking","JavaScript şablonu gizleme"],["None (no escaping)","Hiçbiri (kaçış yok)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Seçilen kaçış algoritması için örnek diyalog ön ayarını yüklemek istiyor musunuz? Bu, mevcut örnek diyaloğunuzun üzerine yazacaktır."],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her parti için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının diğer dosyalarla karışmamasını sağlayabilir."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Satır bilgisinden oyuncu adını çevrilebilir metne ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler, her parti öğesi için sözlük olarak yüklenecektir. İstem mesajında oyuncu referansını yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, ayrıca karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>ACTOR_INFO</code> değişkenini dahil etmeniz gerekir."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Oyuncu adının çevirisinin sütunu. Bu sütun, oyuncu referansının çevirisi olarak kullanılacaktır. Bu, konuşmadaki oyuncu adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Oyuncunun Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Oyuncunun ek bilgilerini içeren sütun. Cinsiyet, yaş vb. daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Extra Prompt","Ek İstem"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İstem mesajına eklenecek ek istem. Bu, sistem mesajından sonra ve gerçek istem mesajından önce eklenecektir."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her parti için her zaman ayrı dosya"],["Append actor name to the translatable text","Çevrilebilir metne oyuncu adını ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, otomatik olarak bir sözlüğü isteme mesajına eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her bir öğe grubu için yüklenecektir. Bu özellik, yalnızca ilgili terimleri yüklemeye çalışarak isteme mesajınızın şişmesini önleyecektir.</p>"],["The Column of Actor's Additional Information","Oyuncunun Ek Bilgileri Sütunu"],["Prompt","İsteme Mesajı"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":false,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"relPath":"/addons/transLitellm/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":166,"length":166,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","OpenAI Toplu API ile Çevir"],["Model","Model"],["The pre-trained model.","Önceden eğitilmiş model."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI Toplu API'sinin, genel olarak kullanılan API'den biraz farklı bir model adlandırma kuralı kullandığı görülüyor. Toplu API'de kullanılan modeller “-batch” öneki taşır. Örneğin, <code>gpt-4.1-mini</code> kullanırsanız, model otomatik olarak <code>gpt-4.1-mini-batch</code> olur.<br />\nAncak, bu eklenti oluşturulduğu sırada, toplu modeller OpenAI'nin model kullanım limitlerinde listelenmemektedir, bu da kullanıcıların Model Kullanım filtresini “İzin Ver” (beyaz liste) olarak ayarlamışsa Toplu API'yi kullanmasını imkansız kılar.<br />\nBu muhtemelen OpenAI kullanıcı arayüzündeki bir hata olup gelecekte düzeltilebilir.<br />\nBu nedenle, Toplu API'yi kullanmak için OpenAI'deki kullanım limitlerini “Engelle” (kara liste) moduna ayarladığınızdan emin olun.<br />\nModelin kullanım limitlerini değiştirmek için buraya tıklayın: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Kaynak Sütun"],["The column of the original texts you want to translate.","Çevirmek istediğiniz orijinal metinlerin sütunu."],["Add actor name","Oyuncu adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Çevrilebilir metne satır bilgisinden oyuncu adını ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Ignore if already translated","Zaten çevrilmişse yoksay"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Bu seçenek işaretlenirse, Translator++ sütununda zaten çevirisi olan herhangi bir satırı yoksayacaktır."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Yalnızca konuşmada bulunan karakterler, her bir toplu öğe için sözlük olarak yüklenecektir. İsteme mesajında oyuncu referansını yüklemek için şablon komutunu kullanın."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Oyuncu adının çevirisinin bulunduğu sütun. Bu sütun, oyuncu referansının çevirisi olarak kullanılacaktır. Bu, konuşmada oyuncu adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Oyuncunun Bilgileri Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Oyuncunun ek bilgilerini içeren sütun. Cinsiyet, yaş vb. gibi daha fazla bilgi ekleyebilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["System Message Template","Sistem Mesajı Şablonu"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Sistem mesajı, ChatGPT asistanınızın rolünün ne olduğunu belirten mesajın başlığıdır. Bu mesaj, ChatGPT'ye gönderdiğiniz her partinin en ilk mesajı olarak gönderilecektir."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScript'in Template Literal stiliyle aşağıdaki değişkenleri ekleyebilirsiniz <span class='inlineCode'><b>${</b>DEĞİŞKEN<b>}</b></span><br>"],["Variables:<br>","Değişkenler:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Kaynak dil</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Hedef dil</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tam kaynak dil adı</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tam hedef dil adı</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Kaynak metin</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Kaçış algoritmasının önceden tanımlanmış mesajı.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Yeni satırı temsil eden dize (Satır yedeği).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Partideki mesaj sayısı.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Oyuncuların bilgilerini ekleyin.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Oyunun motoru</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nesne adı] : Translator++ nesnesinden referans oluşturun. <br />Örnek : <code>REFERENCE[Ortak Referans]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bağlam olarak bazı önceki satırları ekleyin</li>"],["Body Message Template","Gövde Mesajı Şablonu"],["Template of the body of your chat.","Sohbetinizin gövdesinin şablonu."],["Sample conversation","Örnek konuşma"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAI Batch API, projenizi %50 daha düşük maliyetle asenkron olarak çevirmenize olanak tanır, yani çeviri sonuçlarınızı <b style=\"color:red\">24 saat içinde</b> <b style=\"color:blue\">normal maliyetin yarısına</b> alırsınız. Bu, acil çeviri sonuçları gerektirmeyen büyük projeler için özellikle kullanışlıdır."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />OpenAI Batch API hakkında daha fazla bilgiyi <a href=\"https://platform.openai.com/docs/guides/batch\" external>buradan</a> okuyun."],["General Settings","Genel Ayarlar"],["This form is using your OpenAI Batch API configuration.<br>","Bu form, OpenAI Batch API yapılandırmanızı kullanıyor.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","Yapılandırmayı, seçenekler penceresindeki <b>OpenAI Batch API</b> eklentisinin ayarlarına giderek değiştirebilirsiniz.<br>"],["There you can set the API key, model, and other settings.<br />","Orada API anahtarını, modeli ve diğer ayarları yapabilirsiniz.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT ayarlarını aç\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Akıl Yürütme Modellerine Paranızı Boşa Harcamayın</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Çeşitli çalışmalar, akıl yürütme modellerinin yaratıcı yazma ve çeviri görevlerinde normal modellerden çok daha kötü olduğunu kanıtlamıştır.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Akıl yürütme modellerini kullanırken, sadece daha pahalı maliyet ve daha yavaş yanıt süreleri elde edersiniz.</p>"],["Append actor name to the translatable text","Aktör adını çevrilebilir metne ekle"],["Ignore translated rows","Çevrilmiş satırları yoksay"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, otomatik olarak bir sözlüğü isteme mesajına eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her öğe grubu için yüklenecektir. Özellik, isteme mesajınızı şişirmemek için yalnızca ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Aktörün Ek Bilgilerinin Sütunu"],["Prompt Template","İsteme Şablonu"],["<h2>1. System Message</h2>","<h2>1. Sistem Mesajı</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Burada asistanın rolünün ne olduğunu açıklayabilirsiniz.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Amaçlarınızı ve konuşmanın bağlamını çevirmenin anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Gerçek komutunuz</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Bu, asistan için gerçek komuttur.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Genel gider maliyeti</h3>\n                        Genel gider maliyeti, gerçek çeviri metinleri olmadan asistana gönderdiğiniz komut mesajının maliyetidir. Maliyet, komut mesajındaki token sayısına göre hesaplanır. Ne kadar çok tokenınız varsa, maliyet o kadar yüksek olur.<br>\n                        <b>Tahmini genel gider maliyeti:</b> <span class=\"overheadCost\">0</span> token / istek."],["Are you sure you want to reset the form?","Formu sıfırlamak istediğinize emin misiniz?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Toplu işlemi işlemek istediğinize emin misiniz?\nBu işlem için maliyet oluşacaktır."],["The batch is successfully created. Do you want to open the batch manager?","Toplu işlem başarıyla oluşturuldu. Toplu işlem yöneticisini açmak ister misiniz?"],["OpenAI Batch API Queue","OpenAI Toplu API Kuyruğu"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"relPath":"/addons/transOpenAIBatch/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":65,"length":65,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Lütfen çeviriyi uygulamak için satırları seçin"],["Target Column","Hedef Sütun"],["The column to put the translation result.","Çeviri sonucunun konulacağı sütun."],["Import translation from ChatGPT Batch","ChatGPT Toplu İşinden çeviri içe aktar"],["Translation applied to selected rows","Seçili satırlara çeviri uygulandı"],["Invalid format","Geçersiz format"],["OK","Tamam"],["Mismatch","Uyuşmazlık"],["Failed to load batch list with error: \n","Toplu iş listesi yüklenemedi, hata: \n"],["Download Error File","Hata Dosyasını İndir"],["Batch is not completed yet","Toplu iş henüz tamamlanmadı"],["Are you sure you want to cancel this batch?","Bu toplu işi iptal etmek istediğinizden emin misiniz?"],["Cannot cancel completed batch.","Tamamlanmış toplu iş iptal edilemez."],["Batch cancelled","Toplu iş iptal edildi"],["Failed to cancel batch","Toplu iş iptal edilemedi"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","Toplu İşler"],["Apply translation","Çeviriyi uygula"],["Cancel batch","Toplu işi iptal et"],["Status","Durum"],["Batch ID","Toplu İş Kimliği"],["Input File ID","Girdi Dosyası Kimliği"],["End point","Bitiş Noktası"],["Created at","Oluşturulma Tarihi"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Son Kullanma Tarihi <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Zamanında tamamlanmayan toplu işler sonunda süresi dolmuş duruma geçer; o toplu işteki tamamlanmamış istekler iptal edilir ve tamamlanan isteklere yanıtlar, toplu işin çıktı dosyası üzerinden erişilebilir hale getirilir. Tamamlanan isteklerden tüketilen tokenlar için ücretlendirilirsiniz.\"></i>"],["Completed at","Tamamlanma Tarihi"],["Errors","Hatalar"],["Batch Item Detail of","Toplu İş Öğesi Detayı"],["ID","Kimlik"],["Completed on","Tamamlanma Tarihi"],["Model","Model"],["Prompt Token","İstek Tokenı"],["Completion Token","Tamamlama Tokenı"],["Total Token","Toplam Token"],["Status Code","Durum Kodu"],["error","hata"],["Conversation","Konuşma"],["Response Validation","Yanıt Doğrulama"],["Raw Payload","Ham Yük"],["View raw payload","Ham yükü görüntüle"],["Response Preview","Yanıt Önizleme"],["Apply translations from selected rows","Seçili satırlardan çevirileri uygula"],["Here you can edit the translation result individually and send it into Translator++","Burada çeviri sonucunu tek tek düzenleyip Translator++'a gönderebilirsiniz"],["Open ChatGPT Settings","ChatGPT Ayarlarını Aç"],["Help","Yardım"],["File list","Dosya listesi"],["Collapse / restore left panel","Sol paneli daralt / geri yükle"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Zamanında tamamlanmayan toplu işler sonunda süresi dolmuş duruma geçer; o toplu işteki tamamlanmamış istekler iptal edilir ve tamamlanan isteklere verilen yanıtlar, toplu işin çıktı dosyası üzerinden kullanılabilir hale gelir. Tamamlanan isteklerden tüketilen tokenlar için ücretlendirilirsiniz."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>BAŞLIK : Oyunun başlığı</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Oyunun motoru</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>AKTÖR_BİLGİSİ : Aktör bilgilerinin sözlüğü. (Yalnızca toplu modda aktör bilgisi seçeneği etkinleştirilmişse)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERANS[nesne adı] : Translator++ nesnesinden referans oluştur. <br />Örnek : <code>REFERANS[Ortak Referans]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>BAĞLAM : Önceki çevirinin bağlamı (bağlam etkinleştirilmişse)</li>"],["Sample conversation","Örnek konuşma"],["<h2>Sample dialogue</h2>","<h2>Örnek diyalog</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mevcut örnek diyalog. Amaçlarınızı ve konuşmanın bağlamını çevirmenin anlamasına yardımcı olmak için iyi veya kötü yanıtların bir örneğini yazabilirsiniz.</p>"],["Always separate file","Her zaman ayrı dosya"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Her toplu işlem için dosyayı her zaman ayırın. Bu, her dosyanın bağlamlarının diğer dosyalarla karışmamasını sağlayabilir."],["Add actor name","Aktör adı ekle"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Çevrilebilir metne satır bilgisinden oyuncu adını ekleyin. Bu, çevirmenlerin diyaloğu ve zamirleri takip etmesine yardımcı olacaktır. Translator++ daha sonra oyuncu adını çeviri sonucundan kaldıracaktır. Bu açıkça çeviri maliyetini artıracaktır."],["Load Actor Reference as Glossary","Oyuncu Referansını Sözlük Olarak Yükle"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","İşaretlenirse, Translator++ oyuncu referansını sözlük olarak yükleyecektir. Bu, çevirmenin konuşmanın bağlamını anlamasına yardımcı olacaktır. Oyuncu referansı, diyalogdaki oyuncunun adıdır. Bu, çevirmene sözlük olarak yüklenecektir. Bu, çeviri maliyetini artıracaktır."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Sadece konuşmada bulunan karakterler her toplu öğe için sözlük olarak yüklenecektir. Oyuncu referansını yüklemek için şablon komutunu kullanın."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Bu seçeneği etkinleştirirseniz, ayrıca karakter bilgisi verilerini yerleştirmek için istem şablonunda <code>ACTOR_INFO</code> değişkenini dahil etmeniz gerekir."],["Actor Reference Translation Column","Oyuncu Referansı Çeviri Sütunu"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Oyuncu adının çevirisinin sütunu. Bu sütun, oyuncu referansının çevirisi olarak kullanılacaktır. Bu, konuşmada oyuncu adı çevirisinin tutarlılığını artıracaktır."],["Actor's Information Column","Oyuncunun Bilgi Sütunu"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Oyuncunun ek bilgilerini içeren sütun. Cinsiyet, yaş vb. gibi daha fazla bilgi koyabilirsiniz. Bu, konuşmadaki zamirlerin çevirisini iyileştirecektir."],["Extra Prompt","Ek İstem"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","İstem mesajına eklenecek ek istem. Bu, sistem mesajından sonra ve gerçek istem mesajından önce eklenecektir."],["General Settings","Genel Ayarlar"],["Always separate file for each batch","Her toplu işlem için her zaman ayrı dosya"],["Append actor name to the translatable text","Çevrilebilir metne oyuncu adını ekle"],["Glossary","Sözlük"],["<h2>Glossary</h2>","<h2>Sözlük</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Bu özellik, isteme otomatik olarak bir sözlük eklemenize yardımcı olacaktır. Sözlük, çeviri kalitesini artırmak için her toplu öğe için yüklenecektir. Özellik, isteminizi şişirmemek için sadece ilgili terimleri yüklemeye çalışacaktır.</p>"],["The Column of Actor's Additional Information","Oyuncunun Ek Bilgi Sütunu"],["Prompt","İstem"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transOpenAIBatch/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","Toplu Yönetici"],["This feature is only available if you have a project open.","Bu özellik yalnızca açık bir projeniz varsa kullanılabilir."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":false,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transOpenAIBatch/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","Sunucuyu başlat"],["Server started","Sunucu başlatıldı"],["Reinstall server","Sunucuyu yeniden yükle"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","Yüklemek istediğiniz Translators kütüphanesinin yeni sürümünü girin.\nEn son sürüm: "],["Are you sure you want to install Translators version ","Translators sürüm "],["Failed to install Translators. Please check the console for more details.","Translators yüklenemedi. Lütfen daha fazla ayrıntı için konsolu kontrol edin."],["Translators has been successfully updated to version ","Translators başarıyla sürüm "],["General Settings","Genel Ayarlar"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":false,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"relPath":"/addons/transPyTranslators/pyTranslators.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","İptal etmek istediğinize emin misiniz?"],["Process paused!\nPress OK to continue!","İşlem duraklatıldı!\nDevam etmek için Tamam'a basın!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":false,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"relPath":"/addons/transRedBatch/transredbatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","Sözlükleri RAM'den asla boşaltma"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":false,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"relPath":"/addons/transRikaikun/transRikaikun.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","Çeviri Proxy'si başlatılamıyor!\nÇeviri Proxy'si şu anda yalnızca $3 veya daha fazla patronlar için mevcuttur."],["Please enter the port number:","Lütfen port numarasını girin:"],["Invalid port : ","Geçersiz port: "],["Port must be a numeric.","Port sayısal olmalıdır."],["Port has successfully changed to: ","Port başarıyla şuna değiştirildi: "],["Connection Info","Bağlantı Bilgisi"],["Do you want to copy the base URL into the clipboard?","Temel URL'yi panoya kopyalamak istiyor musunuz?"],["Use secure protocol(HTTPS)","Güvenli protokol kullan (HTTPS)"],["Port","Port"],["Connection info","Bağlantı bilgisi"],["Help","Yardım"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":false,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"relPath":"/addons/translationProxy/translationProxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","Komut dosyalarını yazarken seçilen kodlamaya zorlayacaktır. (boş = otomatik)<br />. Bu alanı, oyunun Japonca yerel ayarını değiştirmeden oynanabilir olması için komut dosyasını <b>UTF-16</b>'ya dönüştürmek için kullanabilirsiniz."],["Use legacy parser","Eski ayrıştırıcı kullan"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","Yeni ayrıştırıcı yerine eski (eski ayrıştırıcı) kullanın.<br />Eski ayrıştırıcı daha hızlıdır, ancak bazı oyunlarda güvenilir değildir.<br />Yeni ayrıştırıcı daha güvenilirdir, ancak daha yavaştır."],["Select TyranoBuilder packaged game","TyranoBuilder paketlenmiş oyunu seçin"],["Select the exe file of your packaged game.","Paketlenmiş oyununuzun exe dosyasını seçin."],["Target folder","Hedef klasör"],["Select destination folder. The process will replace the existing files.","Hedef klasörü seçin. İşlem mevcut dosyaları değiştirecektir."],["Extraction completed","Çıkarma tamamlandı"],["Close","Kapat"],["Next","Sonraki"],["Please select game executable file","Lütfen oyun çalıştırılabilir dosyasını seçin"],["Back","Geri"],["The game is fully loaded, proceed!","Oyun tamamen yüklendi, devam et!"],["Extract data","Verileri çıkar"],["Open extracted folder","Çıkarılan klasörü aç"],["Extract resources","Kaynakları çıkar"],["Select the game executable","Oyun çalıştırılabilirini seç"],["Select the game executable or asar file to extract","Çıkarmak için oyun çalıştırılabilirini veya asar dosyasını seçin"],["Target directory","Hedef dizin"],["Select the target directory to store the unpacked files","Çıkarılan dosyaları saklamak için hedef dizini seçin"],["Electron archive file detected. Do you want to extract the asar file instead?","Electron arşiv dosyası tespit edildi. Bunun yerine asar dosyasını çıkarmak ister misiniz?"],["Tyranobuilder Game Extractor","Tyranobuilder Oyun Çıkarıcı"],["Before you create a new project, please make sure that :","Yeni bir proje oluşturmadan önce, lütfen şunları kontrol edin:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","<b>Kirikiri Macera Oyunu ayrıştırıcı</b> eklentisi Translator++'a yüklendi"],["Your game is fully extracted.","Oyununuz tamamen çıkarıldı."],["Extract TyranoBuilder package","TyranoBuilder paketini çıkar"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Tüm .ks ve .tjs dosyaları düz metindir (derlenmemiş, karıştırılmamış ve şifrelenmemiş)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Bazı işlemler oyununuzu değiştirecektir. <b>Bu nedenle oyununuzun yedeğini oluşturduğunuzdan emin olun!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Oyun çalıştırılabilir dosyasını seçin. Bu dosya, oyun verilerini çıkarmak için kullanılacak ana oyun dosyasıdır."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","Tyrano oyunlarında genellikle <b>index.html</b> veya <b>exe</b> dosyasıdır."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Olası karakter kodlamalarının listesi. <b>Sıra önemlidir!</b>. Listeyi sıralamak için sürükleyebilirsiniz."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","TyranoBuilder ile oluşturulan oyun <b>UTF-8</b> kodlamasındadır"],["Literal tags are the tags that will be escaped into Translator++ editor.","Kelime etiketleri, Translator++ düzenleyicisine kaçırılacak etiketlerdir."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> zorunludur."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Etiketleri, Translator++ tarafından yeni bir satıra dönüştürülür. Bu nedenle <b>[r]</b>'yi açıkça yazmanıza gerek yoktur."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kirikiri betiği (.ks) oldukça özelleştirilebilir ve geliştiricilerin kendi etiketlerini oluşturmasına izin verir."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++, kesme işareti (#) ile başlayan karakter isimleri gibi standart etiketleri işleyebilir."],["However, Translator++ may not be able to handle custom tags created by developers.","Ancak, Translator++ geliştiriciler tarafından oluşturulan özel etiketleri işleyemeyebilir."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Bu nedenle, çevrilmesi gereken etiketleri ve öznitelikleri ile oyuncu adı olarak işaretlenmesi gerekenleri tanımlamanız gerekebilir."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>Etiketler hakkında daha fazla bilgi için lütfen <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder etiket referansını</a> ziyaret edin.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","Projeye başlamadan önce, oyununuzu <input type=\"button\" value=\"çıkarmanız\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> ve içindeki <b>ks</b> betiğini analiz etmeniz gerekebilir."],["Create Project","Proje Oluştur"],["Play last build","Son yapımı oynat"],["Extract TyranoBuilder","TyranoBuilder'ı Çıkar"],["Create playable package","Oynanabilir paket oluştur"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":false,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"relPath":"/addons/tyranoTrans/tyranoTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":45,"length":45,"percent":100},"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","Genel"],["Executable file location","Çalıştırılabilir dosya konumu"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tUygulamanın çalıştırılabilir dosyasının yolu.\n\t\t\t"],["Field can not be empty!","Alan boş olamaz!"],["Service","Hizmet"],["End Point","Uç Nokta"],["Auto translation service to use.","Kullanılacak otomatik çeviri hizmeti."],["Target Language","Hedef Dil"],["The language to translate into","Çevrilecek dil."],["Source Language","Kaynak Dil"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","Oyunun orijinal dili. Bazı uç noktalar için \"otomatik\" de desteklenir, ancak genellikle önerilmez."],["Files","Dosyalar"],["Directory","Dizin"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Önbelleklenmiş çeviri dosyalarını aramak için dizin. Yer tutucu kullanılabilir: {GameExeName}, {Lang}"],["Output File","Çıktı Dosyası"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","Oluşturulan çevirilerin ekleneceği dosya. Yer tutucular kullanılabilir: {GameExeName}, {Lang}"],["Substitution File","Değiştirme Dosyası"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","Çevirilerden önce uygulanacak değiştirmeleri içeren dosya. Yer tutucular kullanılabilir: {GameExeName}, {Lang}"],["Preprocessors File","Ön İşlemci Dosyası"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","Metni çevirmeye göndermeden önce uygulanacak ön işlemcileri içeren dosya. Yer tutucular kullanılabilir: {GameExeName}, {Lang}"],["Text Frameworks","Metin Çerçeveleri"],["Enable/Disable auto translation for Unity's text frameworks.","Unity'nin metin çerçeveleri için otomatik çeviriyi etkinleştir/devre dışı bırak."],["Behaviour","Davranış"],["Max Characters Per Translation","Çeviri Başına Maksimum Karakter"],["Max characters per text to translate. Max 2500.","Çevrilecek metin başına maksimum karakter. Maksimum 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Diyalog anahtarlarında boşlukları (satır sonları dahil) yoksayıp yoksamama"],["Whether or not to ignore whitespace, including newlines, in NGUI","NGUI'de boşlukları (satır sonları dahil) yoksayıp yoksamama"],["Minimum Dialogue Chars","Minimum Diyalog Karakteri"],["The length of the text for it to be considered a dialogue","Bir metnin diyalog olarak kabul edilmesi için gereken uzunluk"],["Force Split Text After Characters","Karakter Sonrası Metni Zorla Böl"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Çevrilen metin bu karakter sayısını aştığında metni birden fazla satıra böl. (0 bölme yok demektir)"],["Whether or not to copy hooked texts to clipboard","Kancalanan metinleri panoya kopyalayıp kopyalamama"],["MaxClipboardCopyCharacters","Maksimum Pano Kopyalama Karakteri"],["Max number of characters to hook to clipboard at a time","Bir seferde panoya kancalanacak maksimum karakter sayısı"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Eklentinin, çeviri sırasında UI bileşenlerini yeniden boyutlandırmak için \"en iyi denemeyi\" sağlayıp sağlamaması"],["Indicates whether batching of translations should be enabled for supported endpoints","Desteklenen uç noktalar için çeviri toplu işleminin etkinleştirilip etkinleştirilmeyeceğini belirtir"],["Indicates whether or not to use translations from the included static translation cache","Dahili statik çeviri önbelleğinden çevirilerin kullanılıp kullanılmayacağını belirtir"],["Override Font","Yazı Tipini Geçersiz Kıl"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Metin bileşenlerini güncellerken metinler için kullanılan yazı tiplerini geçersiz kılar. NOT: Sadece UGUI için çalışır"],["Override Font TextMeshPro","TextMeshPro Yazı Tipini Geçersiz Kıl"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Metin bileşenlerini güncellerken metinler için kullanılan yazı tiplerini geçersiz kılar. NOT: Sadece TextMeshPro için çalışır"],["Resize UI Line Spacing Scale","UI Satır Aralığı Ölçeğini Yeniden Boyutlandır"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","UI yeniden boyutlandırma sırasında varsayılan satır aralığının ölçeklenmesi gereken ondalık değer, örneğin: 0.80. NOT: Sadece UGUI için çalışır"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","UI yeniden boyutlandırma davranışının, çevrilip çevrilmediklerine bakılmaksızın tüm UI bileşenlerine uygulanıp uygulanmayacağını belirtir."],["Ignore Text Starting With","Şununla Başlayan Metni Yoksay"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Eklentinin belirli karakterlerle başlayan dizeleri yoksayması gerektiğini belirtir. Bu, ';' ile ayrılmış bir listedir."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","\"Metin Alıcı Uyumluluk Modu\"nun etkinleştirilip etkinleştirilmeyeceğini belirtir. Yalnızca oyun tarafından gerekliyse etkinleştirilmelidir."],["GameLog Text Paths","Oyun Günlüğü Metin Yolları"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Oyunun \"günlük bileşenleri\" olarak kullandığı ve sürekli metin eklediği veya önüne eklediği oyun nesneleri için belirli yolları belirtir. Kurulum için uzman bilgisi gerektirir. Bu, ';' ile ayrılmış bir listedir."],["Romaji Post Processing","Romaji Son İşleme"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","'Çevrilmiş' romaji metinlerinde yapılacak son işleme türünü belirtir. Bu, bazı oyunlarda önemli olabilir çünkü kullanılan yazı tipi çeşitli diyakritikleri düzgün desteklemez. Bu, ';' ile ayrılmış bir listedir. Olası değerler: [\"TümDiyakritikleriKaldır\", \"MakronuŞapkaİleDeğiştir\", \"ApostrofKaldır\"]"],["Translation Post Processing","Çeviri Son İşleme"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Çevrilmiş metinlerde (romaji değil) yapılacak son işleme türünü belirtir. Olası değerler: [\"TümDiyakritikleriKaldır\", \"MakronuŞapkaİleDeğiştir\", \"ApostrofKaldır\", \"GenişKarakterleriDeğiştir\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Regex aramalarının sonuçlarının belirtilen ÇıktıDosyasına yazdırılıp yazdırılmayacağını belirtir."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Boşluk farklılıklarının belirtilen ÇıktıDosyasına yazdırılıp yazdırılmayacağını belirtir."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Regex ile bölünmüş çevirilerin tam sonucunun belirtilen ÇıktıDosyasına yazdırılıp yazdırılmayacağını belirtir."],["Indicates that the plugin should generate translations without variables when using substitutions.","Eklentinin, ikameler kullanırken değişkensiz çeviriler oluşturması gerektiğini belirtir."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Eklentinin, metin çevirilerini \"kaydırıldığı gibi\" desteklemek için kısmi çeviriler oluşturması gerektiğini belirtir."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Eklentinin 'TARC' yönergelerini ayrıştırması ve çevirileri bunlara göre kapsamlandırması gerektiğini belirtir."],["Indicates the plugin should not print out success messages in relation to translations.","Eklentinin, çevirilerle ilgili başarı mesajlarını yazdırmaması gerektiğini belirtir."],["Blacklisted IMGUI Plugins","Kara Listeye Alınmış IMGUI Eklentileri"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","Bir IMGUI penceresi derlemesi/sınıfı/metodu adı bu listedeki herhangi bir dizeyi içeriyorsa (büyük/küçük harf duyarsız) o kullanıcı arayüzü çevrilmeyecektir. MonoMod kancaları gerektirir. Bu, ';' ile ayrılmış bir listedir."],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Eklenti tarafından çevrilemez olarak değerlendirilen metinlerin belirtilen ÇıktıDosyasına yazdırılıp yazdırılmayacağını belirtir."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Bir metin bileşeninin metnini ayarlamaya çalışırken sanal yöntem çağrıları için kuralların yoksayılması gerektiğini belirtir. Bazı durumlarda inatçı bileşenlerin metnini ayarlamaya yardımcı olabilir."],["Max Text Parser Recursion","Maksimum Metin Ayrıştırıcı Özyinelemesi"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Metin farklı bölümlerde çevrilebilmesi için ayrıştırıldığında kaç seviye özyinelemeye izin verildiğini belirtir. Bu, gelişmiş senaryolarda bölücü-düzenli ifadelerle kullanılabilir. Bir olan varsayılan değer, özyinelemenin devre dışı olduğu anlamına gelir."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Çeviri için gönderilmeden önce html varlıklarını ön işleyecek ve çözecektir. Bazı çevirmenler html varlıkları gönderildiğinde başarısız olabilir."],["Will enable automated handling of rich text (text with markup).","Zengin metinlerin (işaretlemeli metinler) otomatik işlenmesini etkinleştirecektir."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Çeviriyle ilgili yardımcı günlük mesajlarının etkinleştirilip etkinleştirilmeyeceğini belirtir. Yönlendirilmiş kaynaklara dayalı çeviri yaparken yararlı olabilir."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Eklentinin harmony kancaları yerine MonoMod kancalarını kullanması gerektiğini belirtir."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Eklentinin System.Reflection.Emit'in bulunmadığı bir ortamda harmony kancalarının çalışmasını sağlayan harmony detour köprüsünü başlatması gerektiğini belirtir (genellikle bu tür ayarlar eklenti yöneticileri tarafından işlenir, bu nedenle bir eklenti yöneticisi kullanırken kullanmayın)."],["Redirected Resource Detection Strategy","Yönlendirilmiş Kaynak Tespit Stratejisi"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Eklentinin çift çevirileri önlemek için yönlendirilmiş kaynakları tanımaya çalışıp çalışmayacağını ve nasıl yapacağını belirtir."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Eklentinin <b>'Çeviri Başına Maksimum Karakter'</b> sınırını aşan metni çevirmeden çıktı verip vermeyeceğini belirtir."],["Texture","Doku"],["Texture Directory","Doku Dizini"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Dokuların döküleceği ve görüntülerin yükleneceği dizinlerin kökü olan dizin. Yer tutucu kullanılabilir: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Eklentinin oyun içi görüntüleri TextureDirectory dizinindekilerle değiştirmeye çalışıp çalışmayacağını belirtir."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Eklentinin değiştirebileceği dokuları TextureDirectory'ye döküp dökmeyeceğini belirtir. Performans üzerinde önemli etkisi vardır."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","ALT+T kısayoluyla çeviriyi açıp kapamanın dokuları da etkileyip etkilemeyeceğini belirtir. Tüm dokular için çalışması garanti edilmez. Performans üzerinde önemli etkisi vardır."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Eklentinin sahne yüklendiğinde dokuları tarayıp taramayacağını belirtir. Bu, eklentinin daha fazla doku bulmasını ve (muhtemelen) değiştirmesini sağlar."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Eklentinin SpriteRenderer'ı kancalamaya çalışıp çalışmayacağını belirtir. Bu ayrı bir seçenektir çünkü SpriteRenderer aslında düzgün şekilde kancalanamaz ve uygulanan geçici çözümün belirli durumlarda teorik olarak performans üzerinde etkisi olabilir."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Değiştirilmemiş dokuların yüklenip yüklenmeyeceğini belirtir. Değişiklikler dosya adındaki hash'e dayanarak belirlenir. Garip durumlara neden olma olasılığı yüksek olduğundan yalnızca hata ayıklama amaçları için etkinleştirin."],["Texture Hash Generation Strategy","Doku Hash Üretim Stratejisi"],["Indicates how the mod identifies pictures through hashes.","Modun resimleri hash'ler aracılığıyla nasıl tanımladığını belirtir."],["Duplicate Texture Names","Yinelenen Doku Adları"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Oyunda yinelenen belirli doku adlarını gösterir. Liste ';' ile ayrılır."],["Indicates if the plugin should detect duplicate texture names.","Eklentinin yinelenen doku adlarını tespit edip etmemesi gerektiğini belirtir."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Eklentinin, oyun motoru eskiyse ilgili olabilecek farklı bir strateji kullanarak görüntüleri yüklemesi gerektiğini belirtir."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Optimum performans için yüklenen tüm dokuların bellekte tutulması gerektiğini belirtir. Bellek kullanımını azaltmak için devre dışı bırakın."],["Resource Redirector","Kaynak Yönlendirici"],["Preferred Storage Path","Tercih Edilen Depolama Yolu"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Auto Translator ile ilişkili olarak yönlendirilen kaynaklar için tercih edilen depolamayı belirtir. Yer tutucu kullanılabilir: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","TextAsset'lerin yönlendirilip yönlendirilmemesi gerektiğini belirtir"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Eklentinin konsola yüklenen tüm varlıkları kaydedip etmemesi gerektiğini belirtir. Hangi öğelerin bağlanabileceğini belirlemek için kullanışlıdır"],["Indicates if translatable resources that are found should be dumped","Bulunan çevrilebilir kaynakların dökülüp dökülmemesi gerektiğini belirtir"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","PreferredStoragePath'taki ZIP dosyalarında dosyalar olduğunda, bu dosyalar bellekte indekslenir, böylece yüklenirken dosya kontrolü IO yapılmaz. Bu seçeneği etkinleştirmek fiziksel dosyalar için de aynısını yapar"],["HTTP","HTTP"],["User Agent","Kullanıcı Aracısı"],["Override the user agent used by APIs requiring a user agent","Kullanıcı aracısı gerektiren API'ler tarafından kullanılan kullanıcı aracısını geçersiz kılar"],["Indiciates whether certificate validations for the .NET API should be disabled",".NET API için sertifika doğrulamalarının devre dışı bırakılıp bırakılmaması gerektiğini belirtir"],["Translation Aggregator","Çeviri Toplayıcı"],["Width","Genişlik"],["The total width of the translation aggregator window","Çeviri toplayıcı penceresinin toplam genişliği"],["Height","Yükseklik"],["The width (per translator) of the translation aggregator window.","Çeviri toplayıcı penceresinin genişliği (çevirmen başına)."],["Enabled Translators","Etkin Çevirmenler"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","Çeviri toplayıcı penceresinde etkinleştirilmiş çeviri uç noktalarının kimlikleri. Liste ';' ile ayrılır."],["Google","Google"],["ServiceUrl","Servis URL'si"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","İSTEĞE BAĞLI, Google API isteklerini farklı bir URL'ye yönlendirmek için kullanılabilir. GFWoC'yi aşmak için kullanılabilir."],["Google Legitimate","Google Meşru"],["Google API Key","Google API Anahtarı"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","İSTEĞE BAĞLI, GoogleTranslateLegitimate yapılandırıldıysa gereklidir."],["Bing Legitimate","Bing Meşru"],["OcpApim Subscription Key","OcpApim Abonelik Anahtarı"],["OPTIONAL, needed if BingTranslateLegitimate is configured","İSTEĞE BAĞLI, BingTranslateLegitimate yapılandırıldıysa gereklidir."],["Baidu","Baidu"],["Baidu App Id","Baidu Uygulama Kimliği"],["OPTIONAL, needed if BaiduTranslate is configured","İSTEĞE BAĞLI, BaiduTranslate yapılandırıldıysa gereklidir."],["BaiduAppSecret","Baidu Uygulama Gizli Anahtarı"],["Yandex","Yandex"],["Yandex API Key","Yandex API Anahtarı"],["OPTIONAL, needed if YandexTranslate is configured","İSTEĞE BAĞLI, YandexTranslate yapılandırıldıysa gereklidir."],["Watson","Watson"],["Url","Url"],["OPTIONAL, needed if WatsonTranslate is configured","İSTEĞE BAĞLI, WatsonTranslate yapılandırılmışsa gerekli"],["Key","Anahtar"],["DeepL","DeepL"],["MinDelay","MinDelay"],["OPTIONAL, used for throttling DeepL","İSTEĞE BAĞLI, DeepL'i kısıtlamak için kullanılır"],["MaxDelay","MaxDelay"],["DeepL Legitimate","DeepL Meşru"],["OPTIONAL, required if DeepLLegitimate is configured","İSTEĞE BAĞLI, DeepLLegitimate yapılandırılmışsa gerekli"],["Custom","Özel"],["Optional, needed if Custom Translated is configured","İsteğe bağlı, Özel Çeviri yapılandırılmışsa gerekli"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","KurulumYolu"],["Optional, needed if Lec Power Translator 15 is configured","İsteğe bağlı, Lec Power Translator 15 yapılandırılmışsa gerekli"],["Debug","Hata Ayıklama"],["Enables the console. Do not enable if other plugins (managers) handles this","Konsolu etkinleştirir. Diğer eklentiler (yöneticiler) bunu işliyorsa etkinleştirmeyin"],["Enables extra logging for debugging purposes","Hata ayıklama amaçlı ekstra günlük kaydını etkinleştirir"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","ezTrans'ın Kurulum Yolu."],["Migrations","Göçler"],["Used to enable automatic migrations of this configuration file","Bu yapılandırma dosyasının otomatik göçlerini etkinleştirmek için kullanılır"],["Tag","Etiket"],["Tag representing the last version this plugin was executed under. Do not edit","Bu eklentinin en son çalıştırıldığı sürümü temsil eden etiket. Düzenlemeyin"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":false,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":23,"Max Characters Per Translation":24,"Max characters per text to translate. Max 2500.":25,"Whether or not to ignore whitespace, including newlines, in dialogue keys":26,"Whether or not to ignore whitespace, including newlines, in NGUI":27,"Minimum Dialogue Chars":28,"The length of the text for it to be considered a dialogue":29,"Force Split Text After Characters":30,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":31,"Whether or not to copy hooked texts to clipboard":32,"MaxClipboardCopyCharacters":33,"Max number of characters to hook to clipboard at a time":34,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":35,"Indicates whether batching of translations should be enabled for supported endpoints":36,"Indicates whether or not to use translations from the included static translation cache":37,"Override Font":38,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":39,"Override Font TextMeshPro":40,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":41,"Resize UI Line Spacing Scale":42,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":43,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":44,"Ignore Text Starting With":45,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":46,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":47,"GameLog Text Paths":48,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":49,"Romaji Post Processing":50,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":51,"Translation Post Processing":52,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":53,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":54,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":55,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":56,"Indicates that the plugin should generate translations without variables when using substitutions.":57,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":58,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":59,"Indicates the plugin should not print out success messages in relation to translations.":60,"Blacklisted IMGUI Plugins":61,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":62,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":63,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":64,"Max Text Parser Recursion":65,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":66,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":67,"Will enable automated handling of rich text (text with markup).":68,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":69,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":70,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":71,"Redirected Resource Detection Strategy":72,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":73,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":74,"Texture":75,"Texture Directory":76,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":77,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":78,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":79,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":80,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":81,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":82,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":83,"Texture Hash Generation Strategy":84,"Indicates how the mod identifies pictures through hashes.":85,"Duplicate Texture Names":86,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":87,"Indicates if the plugin should detect duplicate texture names.":88,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":89,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":90,"Resource Redirector":91,"Preferred Storage Path":92,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":93,"Indicates if TextAssets should be redirected":94,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":95,"Indicates if translatable resources that are found should be dumped":96,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":97,"HTTP":98,"User Agent":99,"Override the user agent used by APIs requiring a user agent":100,"Indiciates whether certificate validations for the .NET API should be disabled":101,"Translation Aggregator":102,"Width":103,"The total width of the translation aggregator window":104,"Height":105,"The width (per translator) of the translation aggregator window.":106,"Enabled Translators":107,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":108,"Google":109,"ServiceUrl":110,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":111,"Google Legitimate":112,"Google API Key":113,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":114,"Bing Legitimate":115,"OcpApim Subscription Key":116,"OPTIONAL, needed if BingTranslateLegitimate is configured":117,"Baidu":118,"Baidu App Id":119,"OPTIONAL, needed if BaiduTranslate is configured":120,"BaiduAppSecret":121,"Yandex":122,"Yandex API Key":123,"OPTIONAL, needed if YandexTranslate is configured":124,"Watson":125,"Url":126,"OPTIONAL, needed if WatsonTranslate is configured":127,"Key":128,"DeepL":129,"MinDelay":130,"OPTIONAL, used for throttling DeepL":131,"MaxDelay":132,"DeepL Legitimate":133,"OPTIONAL, required if DeepLLegitimate is configured":134,"Custom":135,"Optional, needed if Custom Translated is configured":136,"Lec Power Translator 15":137,"InstallationPath":138,"Optional, needed if Lec Power Translator 15 is configured":139,"Debug":140,"Enables the console. Do not enable if other plugins (managers) handles this":141,"Enables extra logging for debugging purposes":142,"ezTrans":143,"Installation Path of ezTrans.":144,"Migrations":145,"Used to enable automatic migrations of this configuration file":146,"Tag":147,"Tag representing the last version this plugin was executed under. Do not edit":148},"tags":[],"relPath":"/addons/unityTrans/configEdit.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","Bu eylemi gerçekleştirmek için XUnity Translator gereklidir\nLütfen Üçüncü Taraf Uygulama Yükleyicisi aracılığıyla yükleyin!"],["XUnity.AutoTranslator is found!","XUnity.AutoTranslator bulundu!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++, XUnity.AutoTranslator'ın zaten yüklü olduğunu tespit ediyor. Translator++, mevcut çeviri verilerini kullanarak yeni bir çeviri projesi başlatacak."],["XUnity.AutoTranslator is not found!","XUnity.AutoTranslator bulunamadı!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","Sihirbaz, XUnity.AutoTranslator'ı oyuna yüklemeniz için size rehberlik edecek."],["Next","Sonraki"],["Given path: ","Verilen yol: "],["\nis not an Unity game. Do you still want to proceed?","\n bir Unity oyunu değil. Yine de devam etmek istiyor musunuz?"],["Patch successfully installed!\r\n","Yama başarıyla yüklendi!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","Yapılandırma, oyunu ilk kez oynadığınızda oluşturulacaktır.\r\n"],["Open the game now?","Oyunu şimdi aç?"],["Finish","Bitir"],["Update current project?","Mevcut projeyi güncelle?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":false,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"relPath":"/addons/unityTrans/unityTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","Mesaj kutusundaki maksimum satır sayısı."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","Varsayılan değer 4'tür. Bu özelliği devre dışı bırakmak için 0 yazın. Mesaj kutusundaki satır sayısı bu sayıdan fazlaysa, Translator++ metinlerin kutuların dışına taşmasını önlemek için yeni bir mesaj kutusu oluşturacaktır."],["Use shell copy if possible","Mümkünse kabuk kopyasını kullan"],["Use shell copy instead of native NodeJS copy handler.","Yerel NodeJS kopya işleyicisi yerine kabuk kopyasını kullan."],["Use shell copy","Kabuk kopyasını kullan"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","WRPGE Düzenleyici yüklü değil\r\nLütfen T++ menüsü > Üçüncü taraf uygulama yükleyicisinden yükleyin\r\n\r\nÜçüncü taraf uygulama yükleyicisini şimdi aç?"],["Unable to determina WRPGE path.","WRPGE yolu belirlenemedi."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++, WRPGE düzenleyicisini hedef klasöre yüklemek üzere.\r\nDevam edilsin mi?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Geliştirme yolu tanımlanmamış.\nGeliştirme yolu oluşturmak için oyununuzu bir kez enjekte etmelisiniz."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","WolfJs kütüphanesi ile Wolf RPG oyununu 3.330 sürümüne kadar çevirin. Translator++ için varsayılan Wolf RPG ayrıştırıcısı."],["Wolf RPG Editor games","Wolf RPG Düzenleyici oyunları"],["Parsing Wolf RPG Game with","Wolf RPG Oyunu ayrıştırılıyor"],["Wolf RPG Editor game","Wolf RPG Düzenleyici oyunu"],["Select the game's executable file","Oyunun çalıştırılabilir dosyasını seçin"],["Engine version","Motor sürümü"],["Detected WolfRPG Engine version of the selected game","Seçilen oyunun tespit edilen WolfRPG Motor sürümü"],["Heads up!\r\n","Dikkat!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nbir Wolf RPG çalıştırılabilir dosyası gibi görünmüyor!\r\nWolf RPG Projesini bu giriş noktasından başlatmak istediğinizden emin misiniz?"],["Create a new project","Yeni bir proje oluştur"],["Please specify a game to be processed!","Lütfen işlenecek bir oyun belirtin!"],["Set dev path. Path to the directory of the translated game.","Geliştirme yolunu ayarla. Çevrilmiş oyunun dizinine giden yol."],["Play last build","Son derlemeyi oyna"],["Open editor","Düzenleyiciyi aç"],["Open Wolf RPG Editor online manual","Wolf RPG Düzenleyici çevrimiçi kılavuzunu aç"],["Open Wolf RPG Editor english manual","Wolf RPG Editor İngilizce kılavuzunu aç"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","Kılavuz dosyası bulunamadı.\nLütfen Wolf RPG Editor'ü 3. Taraf uygulama yükleyicisi ile yükleyin."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":false,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"relPath":"/addons/wolfJs/wolfJs.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","XML benzeri belgelerden çeviriye başla. Hem XML hem de HTML formatını destekler."],["Create project","Proje oluştur"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":false,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"relPath":"/addons/xmlTrans/xml.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","YU-RIS motoru çevirmeni"],["Checking up requirements...","Gereksinimler kontrol ediliyor..."],["Create a new translation project from YU-RIS visual novel engine","YU-RIS görsel roman motorundan yeni bir çeviri projesi oluştur"],["Next","İleri"],["Select YU-RIS game","YU-RIS oyunu seç"],["Select the game's executable file","Oyunun çalıştırılabilir dosyasını seç"],["Engine version","Motor sürümü"],["Detected YU-RIS version of the selected game","Seçilen oyunun algılanan YU-RIS sürümü"],["Create a new project","Yeni proje oluştur"],["Invalid target game :","Geçersiz hedef oyun:"],["Source material do not match the current translation project!","Kaynak materyal mevcut çeviri projesiyle eşleşmiyor!"],["Select the repack method.","Yeniden paketleme yöntemini seç."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>Orijinal YPF dosyasına yeniden paketle</b><br />Çeviriyi orijinal pakete yeniden paketleyecek. Orijinal paketi çıkarmak, çeviriyle yamalamak ve yeniden paketlemek daha uzun sürebilir.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>YPF yama dosyası olarak yeniden paketle</b><br>Çeviriyi ayrı bir yama dosyası olarak yeniden paketleyecek (örn. update9.ypf). Bu şekilde, orijinal ypf dosyalarını değiştirmeden oyunu çevirmek mümkündür. Daha hızlı yama işlemi için bunu, Materyal kopyala'nın <b>Materyal kopyalama, sadece çeviri enjekte et</b> seçeneğiyle birleştirin.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","Hedef yeniden paketleme sürümü oyun sürümünüzle eşleşmelidir. Ana ve alt sürümü nokta ile ayırarak girin. Örneğin: <b>0.466</b>. Varsayılan olarak, Translator++ proje oluşturduğunuzda motor sürümünü algılar."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":false,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"relPath":"/addons/yurisParser/YurisParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","Form Oluşturucu"],["Run","Çalıştır"],["New Project (ctrl+n)","Yeni Proje (ctrl+n)"],["Open (ctrl+o)","Aç (ctrl+o)"],["Save file (ctrl+s)","Dosyayı Kaydet (ctrl+s)"],["Save As (ctrl+shift+s)","Farklı Kaydet (ctrl+shift+s)"],["Open debugger (F12)","Hata Ayıklayıcıyı Aç (F12)"],["Help","Yardım"],["Select file in the current workspace","Mevcut çalışma alanındaki dosyayı seç"],["file path","dosya yolu"],["Create shortcut of the current script","Mevcut betiğin kısayolunu oluştur"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":false,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"relPath":"/auto