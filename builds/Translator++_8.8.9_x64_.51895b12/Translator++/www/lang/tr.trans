context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"relPath":"/js/ui.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","Daha ayrıntılı bilgiyi konsol günlüğünde (F12) görüntüleyebilirsiniz"],["Close","Kapat"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","Daha ayrıntılı bilgiyi konsol günlüğünde (F12) görüntüleyebilirsiniz"],["Close","Kapat"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/ui.parts.js":{"data":[["Form","Form"],["Cancel","İptal"],["Ok","Tamam"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","Notu kaldır"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/login.html":{"data":[["working","çalışıyor"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/note.html":{"data":[["Remove note","Notu kaldır"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/options.html":{"data":[["Click to login","Giriş yapmak için tıkla"],["Translator &amp; Language","Çevirmen &amp; Dil"],["Proofreader","Düzeltmen"],["Assistant","Asistan"],["General","Genel"],["Preferences","Tercihler"],["Add-ons","Eklentiler"],["About","Hakkında"],["User Information","Kullanıcı Bilgileri"],["Login to your Patreon account to get access to the latest features and updates.","En son özelliklere ve güncellemelere erişmek için Patreon hesabınıza giriş yapın."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> Giriş Yap"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> Tarayıcı ile Giriş Yap"],["Welcome,","Hoş geldiniz,"],["Name","İsim"],["Email","E-posta"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Seviye <div class=\"infoHeadNote\">(Mevcut abonelik USD sent cinsinden)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Puanlar <div class=\"infoHeadNote\">(Toplam ömür boyu abonelik USD sent cinsinden)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","Ödeme durumu <div class=\"infoHeadNote\">(Mevcut ödeme durumu)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Panik yapmayın!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>Ve lütfen aşağıdaki bilgileri okuyun.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Bu bayrak, Patreon'un bağışınız için fonları henüz başarıyla almadığını gösterir. Ödeme sisteminde gecikmeler olması normaldir. Ödeme yönteminize ve menşe ülkenize bağlı olarak gecikmeler 24 saate kadar sürebilir.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Bu gecikme sırasında, kredi kartınızdan bir borç görülebilir. Endişelenmeyin—Patreon ödemenizi alıp almadığını kontrol etmek için düzenli aralıklarla yeniden deneyecektir. Bu genellikle 24 saat içinde kendiliğinden çözülür.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Sorun bu süreyi aşarsa, lütfen Discord'daki Translator++ sunucusundaki <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">hesap-sorunu</a> başlığına yazın. Size mümkün olduğunca yardımcı olacağım.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Lütfen dolandırıcılığı önlemek için, <b><span class=\"userInfoPoints\">puanlar</span> ve <span class=\"userInfoLevel\">Seviye</span>, ödemeniz Patreon tarafından başarıyla alınana kadar sayılmayacaktır</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">Panik yapmayın!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","Bu bayrak, Patreon'un bağışınız için fonları henüz başarıyla almadığını gösterir. Ödeme sisteminde gecikmeler olması normaldir. Ödeme yönteminize ve menşe ülkenize bağlı olarak gecikmeler 24 saate kadar sürebilir."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","Bu gecikme sırasında, kredi kartınızdan bir borç görülebilir. Endişelenmeyin—Patreon ödemenizi alıp almadığını kontrol etmek için düzenli aralıklarla yeniden deneyecektir. Bu genellikle 24 saat içinde kendiliğinden çözülür."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","Bu süre sonunda sorun devam ederse, lütfen Translator++ Discord sunucusundaki <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">hesap-sorunu</a> başlığına mesaj yazın. Mümkün olduğunca size yardımcı olacağım."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","Lütfen anlayın ki, dolandırıcılığı önlemek için, <b><span class=\"userInfoPoints\">puanlar</span> ve <span class=\"userInfoLevel\">Seviye</span>, ödemeniz Patreon tarafından başarıyla alınana kadar sayılmayacaktır</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> Çıkış Yap"],["Primary Translator","Birincil Çevirmen"],["Default Translator Engine","Varsayılan Çeviri Motoru"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tBu Çeviri Motoru, seçili hücre(ler)de <span class=\"keyboardHint\">Ctrl+g</span> tuşuna bastığınızda, seçili hücrede çeviriyi <strong>g</strong>enerate etmek için kullanılacaktır.\n\t\t\t\t"],["Default Language","Varsayılan Dil"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\tProjeler arası varsayılan dil ayarları!<br>\n\t\t\t\tProjenin özelliklerindeki ayarlar bu değeri geçersiz kılacaktır.\n\t\t\t"],["Default Source Language","Varsayılan Kaynak Dil"],["Default Target Language","Varsayılan Hedef Dil"],["Custom escape","Özel kaçış"],["Patterns","Desenler"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tAşağıdaki desenle eşleşen tüm kelimeler makine çevirmenleri tarafından çevrilmeyecektir. \n\t\t\t\t\t\tBu bölüm, etiketleri ve komut dosyalarını çeviri motorlarından gizlemek için uygundur. <br>\n\t\t\t\t\t\tHer giriş, geçerli bir javaScript düzenli ifadesi, fonksiyonu veya <b>virgül</b> ile ayrılmış literal string'dir.<br>\n\t\t\t\t\t\tÖzel kaçış yalnızca desteklenen <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">kaçış algoritması</a> için çalışır.\n\t\t\t\t\t\t<b>İpucu:</b> ChatGPT'den düzenli ifade oluşturmasını da isteyebilirsiniz. <br>\n\t\t\t\t\t\tLütfen regex desenini ve değiştiricisini birlikte yazın.<br>\n\t\t\t\t\t\törneğin:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","Test Edici"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tDeseni kontrol etmek için metninizi buraya yapıştırın.\n\t\t\t\t\t\tEşleşen tüm desenler vurgulanacaktır.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>Yapım Aşamasında</h2>\n\t\t\t\t<p>Bu alan, otomatik düzeltme ayarlarının ve seçeneklerinin yapılandırılacağı yer olacaktır.</p>\n\t\t\t"],["AI Assistant","AI Asistanı"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Merhaba! Ben MIRAI, Translator++ için AI asistanınız.👋</strong></p>\n\t\t\t\t\t\t<p>Benimle sohbet etmek için Ana menünüzdeki simgeme <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> tıklamanız yeterli. Size şu konularda yardımcı olabilirim:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Çeviri iyileştirmeleri ve önerileri</li>\n\t\t\t\t\t\t\t<li>Düzeltme ve kalite kontrolleri</li>\n\t\t\t\t\t\t\t<li>Çeviri iş akışınızı kurma</li>\n\t\t\t\t\t\t\t<li>Otomasyon komut dosyaları oluşturma</li>\n\t\t\t\t\t\t\t<li>Ve çok daha fazlası!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Birlikte çeviri işinizi daha kolay ve verimli hale getirelim!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>Not: Ben hala yeniyim, bu yüzden lütfen bana karşı sabırlı olun.🙇‍♀️ Ama her gün öğreniyor ve gelişiyorum!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","AI Yapılandırması"],["Model Endpoint","Model Uç Noktası"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","AI modeliniz için API uç noktası URL'si. Örneğin: https://api.openai.com/v1/chat/completions"],["API Key","API Anahtarı"],["Your API key for authenticating with the AI service. This will be stored securely.","AI servisi ile kimlik doğrulama için API anahtarınız. Bu güvenli bir şekilde saklanacaktır."],["Model Name","Model Adı"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","Kullanılacak AI modelini seçin veya girin. En iyi sonuçlar için araç desteği olan modeller önerilir."],["File Association","Dosya İlişkilendirme"],["Extension","Uzantı"],["Associate","İlişkilendir"],["Set All","Tümünü Ayarla"],["Unset All","Tümünü Kaldır"],["Apply","Uygula"],["Update","Güncelle"],["Auto update","Otomatik güncelle"],["Automatically update Translator++ if possible.","Mümkünse Translator++'ı otomatik olarak güncelle."],["Allow reinstall the same version","Aynı sürümü yeniden yüklemeye izin ver"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Translator++'ın zaten yüklü olan aynı sürümü yeniden yüklemesine izin ver. Lütfen güncellemeyi yükledikten sonra, özellikle <b>Otomatik güncelle</b> ayarınız açıkken bu seçeneği devre dışı bırakın. Aksi takdirde, Translator++ programı her açtığınızda kendini güncellemeye devam edecektir."],["Use default browser to login","Giriş yapmak için varsayılan tarayıcıyı kullan"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","Patreon hesabınıza giriş yapmak için güvendiğiniz sistemin varsayılan tarayıcısını kullanın. Bu seçenek işaretlenmediği sürece, Translator++'ın gömülü tarayıcısı kullanılacaktır."],["Multi threading","Çoklu iş parçacığı"],["Number of thread","İş parçacığı sayısı"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","Aynı anda açılan alt işlem sayısı.<br>\n\t\t\t\t\t\t\t0 = çoklu iş parçacığı devre dışı. Tüm işlemler renderer işlemi tarafından yapılacak.<br>\n\t\t\t\t\t\t\tOptimum miktar genellikle fiziksel çekirdek sayınız - 1'dir.\n\t\t\t\t\t\t"],["Backup","Yedekleme"],["Enable backup","Yedeklemeyi etkinleştir"],["Automatically create backup every time you save your project.","Projenizi her kaydettiğinizde otomatik olarak yedek oluşturun."],["Backup level history","Yedek seviyesi geçmişi"],["How many history of backup do you want to keep?","Kaç tane yedek geçmişini saklamak istiyorsunuz?"],["Log &amp; Debugging","Günlük &amp; Hata Ayıklama"],["Log to file","Dosyaya günlük kaydet"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","Varsayılan konsol penceresi yerine dosyaya günlük kaydedin.<br>Bu, Translator++'ı hata ayıklamak istediğinizde ve konsol penceresine erişiminiz olmadığında kullanışlıdır. Bu seçeneği etkinleştirmek performansı hafifçe etkiler. Bu nedenle, hata ayıklama veya sorun bildirimi dışında bu seçeneğin her zaman kapalı olmasını istersiniz.<br>Günlükler data/logs/ klasörüne kaydedilir."],["Truncate log file each session","Her oturumda günlük dosyasını kes"],["When checked your log file will be truncated each time you re open the application.","İşaretlendiğinde, uygulamayı her yeniden açtığınızda günlük dosyanız kesilecektir."],["Application Settings","Uygulama Ayarları"],["Enable remote debugging","Uzaktan hata ayıklamayı etkinleştir"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","9222 numaralı portta Chrome DevTools uzaktan hata ayıklama protokolünü etkinleştirir. Bu, <code>chrome://inspect</code> adresine giderek harici bir tarayıcı kullanarak Translator++'ı incelemenize ve hata ayıklamanıza olanak tanır. Bu bayrak, uygulama başlangıç argümanlarına <code>--remote-debugging-port=9222</code> ekler. Değişikliklerin uygulanması için yeniden başlatma gereklidir."],["Disable GPU","GPU'yu devre dışı bırak"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","Donanım GPU hızlandırmasını devre dışı bırakır. Bu, belirli grafik donanımı veya sürücülerinde görsel hatalar, çökmeler veya işleme sorunları yaşarsanız kullanışlıdır. Bu bayrak, uygulama başlangıç argümanlarına <code>--disable-gpu</code> ekler. Değişikliklerin uygulanması için yeniden başlatma gereklidir."],["Dangerous Area","Tehlikeli Alan"],["Interface Language","Arayüz Dili"],["UI Language","Kullanıcı Arayüzü Dili"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","Kullanıcı arayüzünün dilini ayarlayın. Translator++ dilinizde mevcut değilse kendi yerelleştirmenizi oluşturabilirsiniz. Dil verileri www/lang klasörü içinde bulunur."],["Spell checker Language","Yazım Denetleyici Dili"],["Set the default spell checker language.","Varsayılan yazım denetleyici dilini ayarla."],["Environment Variables","Ortam Değişkenleri"],["Staging Directory","Hazırlama Dizini"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","Hazırlama Dizini, üzerinde çalışılan projelerin sabit bir önbelleğidir. Ham malzemelerden bir kısım veri, yorumlayıcı betikleri tarafından erişilmek üzere bu dizine kopyalanır."],["Project creation","Proje oluşturma"],["Auto Load Common Reference","Ortak Referansı Otomatik Yükle"],["Auto load common reference from .trans file.",".trans dosyasından ortak referansı otomatik yükle."],["Project settings","Proje ayarları"],["Progress Column Indices","İlerleme Sütun İndisleri"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","Burada, projenin ilerleme hesaplamasına hangi sütunların dahil edileceğini belirleyebilirsiniz.\n\t\t\t\t\t\t\t<br>Sütun indisi sıfır tabanlı bir tam sayıdır, en soldaki sütun 0'dır.\n\t\t\t\t\t\t\t<br>Birden fazla sütun belirtmek için virgül kullanın. Örneğin: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Varsayılan: Boş</b>. Boş bırakılırsa, Translator++ tüm mevcut sütunlardan ilerlemeyi hesaplar.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>Etkinleştir/Devre Dışı Bırak"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>Yükle"],["Install from a package","Bir paketten yükle"],["Visit our website &amp; documentation : ","Web sitemizi ve belgelerimizi ziyaret edin : "],["Fork Translator++ at : ","Translator++'ı fork edin : "],["Support Translator++ at : ","Translator++'ı destekleyin : "],["Join our discord channel at : ","Discord kanalımıza katılın : "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) Eğer bir patron iseniz, <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">Patreon profilinizde discord hesabınızı bağlamalısınız</a>. Otomatik olarak davet edileceksiniz ve sizi bekleyen avantajlar var!"],["Version Info","Sürüm Bilgisi"],["Last checked at : ","Son kontrol edildi: "],["Check now!","Şimdi kontrol et!"],["You have a pending update","Bekleyen bir güncellemeniz var"],["Update now","Şimdi güncelle"],["Your Translator++ is up to date 😃.","Translator++'ınız güncel 😃."],["Architecture","Mimari"],["License","Lisans"],["Click here to read the license.","Lisansı okumak için buraya tıklayın."],["Credits","Katkıda Bulunanlar"],["Localization","Yerelleştirme"],["About Third Party Software","Üçüncü Taraf Yazılımlar Hakkında"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tBu yazılım, /3rdParty dizininde bulunan üçüncü taraf yazılımları kullanmaktadır. Bu üçüncü taraf yazılımlar kendi lisanslarına sahiptir ve \n\t\t\t\tkullanım kolaylığı için dahil edilmiş olup, \n\t\t\t\therhangi bir açık veya örtülü garanti olmaksızın \"olduğu gibi\" sağlanmaktadır ve bu yazılımlar kendi riskinizle kullanılmalıdır.\n\t\t\t\t"],["Special Thanks","Özel Teşekkürler"],["Want to explicitly support Translator++ by putting your name on this section?","Translator++'a adınızı bu bölüme ekleyerek açıkça destek olmak ister misiniz?"],["Click here to learn more about how to do that!","Bunu nasıl yapacağınızı öğrenmek için buraya tıklayın!"],["Changelog","Değişiklik Günlüğü"],["Feeds","Beslemeler"],["Click connect button, to connect translator with Translator++ table","Çevirmeni Translator++ tablosuna bağlamak için bağlan düğmesine tıklayın"],["working","çalışıyor"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Patreon seviyesi/Bu ayki mevcut bağışınız cent cinsinden (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","Puanlar/Hayat boyu taahhüt+bonuslar sent cinsinden (1 USD = 100 puan)"],["Filter...","Filtrele..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":124,"length":124,"percent":100},"parameters":[]},"/scriptEditor.html":{"data":[["Run","Çalıştır"],["New Project (ctrl+n)","Yeni Proje (ctrl+n)"],["Open (ctrl+o)","Aç (ctrl+o)"],["Save file (ctrl+s)","Dosyayı Kaydet (ctrl+s)"],["Save As (ctrl+shift+s)","Farklı Kaydet (ctrl+shift+s)"],["Open debugger (F12)","Hata ayıklayıcıyı aç (F12)"],["Help","Yardım"],["Select file in the current workspace","Mevcut çalışma alanındaki dosyayı seç"],["file path","dosya yolu"],["Create shortcut of the current script","Mevcut betiğin kısayolunu oluştur"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/tableEditor.html":{"data":[["Reset","Sıfırla"],["Clear","Temizle"],["Search","Ara"],["Help","Yardım"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/trans.html":{"data":[["Start","Başlat"],["Home","Ana Sayfa"],["Translator","Çevirmen"],["Objects","Nesneler"],["Live translation","Canlı çeviri"],["Original","Orijinal"],["Raw","Ham"],["Row Properties","Satır Özellikleri"],["Default translation","Varsayılan çeviri"],["Context translation","Bağlam çevirisi"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\t<a class=\"problemPath\"></a> yolu PHP yorumlayıcısı tarafından erişilebilir değil.<br>\n\t\tLütfen yolu yeniden adlandırın ve yalnızca alfasayısal adlandırma kullanın.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>Konum</span>"],["File :","Dosya :"],["Row ID :","Satır Kimliği :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>Bağlam</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>Oyuncular</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>Anahtar Metin</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>En İyi Çeviri</span>"],["File ID","Dosya Kimliği"],["Path","Yol"],["Original Format","Orijinal Biçim"],["Data Length","Veri Uzunluğu"],["Translated","Çevrilmiş"],["General","Genel"],["Language","Dil"],["Staging","Hazırlık"],["Stats","İstatistikler"],["Advanced","Gelişmiş"],["Info","Bilgi"],["Title","Başlık"],["File Location","Dosya Konumu"],["Project ID","Proje Kimliği"],["Built on","Oluşturulma Tarihi"],["Editor Name","Editör Adı"],["Editor Version","Editör Sürümü"],["Engine","Motor"],["Parser","Ayrıştırıcı"],["Parser version","Ayrıştırıcı sürümü"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","Ham Materyal Konumu <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Orijinal materyalin konumu. Bu klasör içindeki hiçbir şeyi değiştirmemelisiniz.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Geçersiz yol.<br>Bu düzeltilene kadar bazı özellikler devre dışı kalacak."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","Çevrilmiş Materyal Konumu <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Çevrilmiş oyunun konumu. Çeviri enjeksiyonunun varsayılan konumu.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","Çevirmen <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Bu proje için tercih edilen çevirmen. Tanımlanmamışsa, genel ayar kullanılacak.\"></i>"],["Translate From","Çeviri Kaynağı"],["Translate Into","Çeviri Hedefi"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","Hazırlama Yolu <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Hazırlama yolu, çevirileri dışa aktarmak/oluşturmak için gerekli bazı dosyaların konumudur. Projeyi oluşturduğunuzda hazırlama dosyaları oluşturulur.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","Nesneler <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Sol panelde mevcut nesne/dosya sayısı\"></i>"],["Folders","Klasörler"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","Karakterler <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Orijinal Metin sütunundaki karakter sayısı\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","Kelimeler <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Boşluk kullanmayan dillerde (örn. Japonca, Çince) yanlış değer gösterebilir.\"></i>"],["Total Rows","Toplam Satır"],["Translated row","Çevrilmiş satır"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Organik çeviri <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Kullanıcılar tarafından doğrudan tabloya doldurulmuştur. Bu iyi bir işarettir. İnsan çevirisi, düzenlenmiş MTL vb. olabilir.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","Genel ilerleme <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","Dışa aktarma sonrasında çalıştır<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Bu proje başarıyla dışa aktarıldıktan sonra bir javascript işlevini çalıştır.\"></i>"],["Display this information when the project is opened.","Proje açıldığında bu bilgiyi görüntüle."],["Select Export Mode","Dışa Aktarma Modunu Seç"],["Export to a folder","Bir klasöre dışa aktar"],["Export pre-compiled game data to a folder<br>Folder structures are retained","Önceden derlenmiş oyun verilerini bir klasöre dışa aktar<br>Klasör yapıları korunur"],["Export as a Zip file","Zip dosyası olarak dışa aktar"],["Export pre-compiled game data to a single zipped archive","Önceden derlenmiş oyun verilerini tek bir zip arşivine dışa aktar"],["RPGMakerTrans Patch Files","RPGMakerTrans Yama Dosyaları"],["Export to RPGMakerTrans formatted *.txt files in a folder","Bir klasörde RPGMakerTrans biçimli *.txt dosyalarına dışa aktar"],["Comma Separated Values","Virgülle Ayrılmış Değerler"],["Export to Comma Separated Values (csv) files in a folder","Virgülle Ayrılmış Değerler (csv) dosyalarını bir klasöre aktar"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 ve üzeri"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","Microsoft Excel Elektronik Tablosu (xlsx) dosyalarını bir klasöre aktar"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 ve üzeri"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","Microsoft Excel Elektronik Tablosu (xls) dosyalarını bir klasöre aktar"],["HTML Spreadsheet","HTML Elektronik Tablosu"],["Export to HTML files in a folder","HTML dosyalarını bir klasöre aktar"],["Open Document Format/OASIS (.ods)","Open Document Format/OASIS (.ods)"],["Export to ODS files in a folder","ODS dosyalarını bir klasöre aktar"],["Select Import Mode","İçe Aktarma Modunu Seç"],["Import translation from another .trans file","Başka bir .trans dosyasından çeviriyi içe aktar"],["Open another Translator++ file<br>Apply translation into current project.","Başka bir Translator++ dosyasını aç<br>Mevcut projeye çeviriyi uygula."],["Import translation from spreadsheets","Elektronik tablolardan çeviriyi içe aktar"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","Çeşitli elektronik tablo dosyalarından çeviriyi içe aktar<br>(.xls, .xlsx, .ods, .html, .xml, vb)"],["Import translation from RPGMakerTrans Patch format","RPGMakerTrans Yama formatından çeviriyi içe aktar"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","RPGMaker Trans' yama dosyalarından çeviriyi içe aktar<br>(.txt)"],["Source :","Kaynak :"],["Select objects to import","İçe aktarılacak nesneleri seç"],["Import mode :","İçe aktarma modu :"],["Import translations","Çevirileri içe aktar"],["Import data object","Veri nesnesini içe aktar"],["Destination :","Hedef :"],["Currently selected : ","Şu anda seçili : "],["Options :","Seçenekler :"],["Import the context translations","Bağlam çevirilerini içe aktar"],["Case insensitive","Büyük/küçük harf duyarsız"],["Overwrite target","Hedefin üzerine yaz"],["Destination column : ","Hedef sütun : "],["Translation mode :","Çeviri modu :"],["Row by row translation","Satır satır çeviri"],["Line by line translation","Satır satır çeviri"],["Select translation by context address","Bağlam adresine göre çeviri seç"],["Just copy translation into the same row (No checking)","Çeviriyi aynı satıra kopyala (Kontrol yok)"],["Merge data","Verileri birleştir"],["Import translation from spreadsheet into project","Çevirileri elektronik tablodan projeye içe aktar"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","Herhangi bir elektronik tablo formatından (xls, xlsx, odx, html, csv, vb.) çeviriyi içe aktar."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>Elektronik tablonun en az 2 sütunu olmalıdır.</b> En önemli sütun, orijinal metinleri içeren ilk sütundur (en soldaki sütun). Sonraki sütunlar çevirileri içerir. Translator++, boş olmayan en sağdaki hücredeki metni kullanacaktır."],["Please click the radio button to select files/folder to import","Lütfen içe aktarılacak dosyaları/klasörü seçmek için radyo düğmesine tıklayın"],["Import file(s)","Dosya(lar)ı içe aktar"],["Import folder","Klasörü içe aktar"],["Import translation from RPG Maker Trans into project","RPG Maker Trans'tan projeye çeviri aktar"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">Proje türünü seç</span>"],["Select project type","Proje türünü seç"],["Spreadsheet","Elektronik tablo"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","Elektronik tablo verilerinden (xls, xlsx, ods, xml, html, sylk, gnumeric, csv) çeviri projesi başlat"],["Blank project","Boş proje"],["Create a new .trans file from scratch.","Sıfırdan yeni bir .trans dosyası oluştur."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Elektronik tablo</span>"],["Fetch type","Alma türü"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","İlk sütunlar çevrilebilir metin, geri kalan sütunlar önceden tanımlanmış çevirilerdir (Orijinal tabloya uyan bir ızgara verisi oluştur)"],["All columns are translatable text","Tüm sütunlar çevrilebilir metin"],["Custom","Özel"],["Custom Options","Özel Seçenekler"],["Which column do you want to fetch?","Hangi sütunu almak istiyorsunuz?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","Lütfen hangi sütunu almak ve hangi sütuna çeviriyi koymak istediğinizi belirtin. <b>Bu, 0 tabanlı indekstir (ilk sütun 0'dır)</b>."],["Column to be translated","Çevrilecek sütun"],["Column to put translation into","Çevirinin konulacağı sütun"],["Action","Eylem"],["Enable Row Header Text Column","Satır Başlığı Metni Sütununu Etkinleştir"],["If enabled, the parser will process the following Row Header Text Column rule","Etkinleştirilirse, ayrıştırıcı aşağıdaki Satır Başlığı Metni Sütunu kuralını işleyecektir"],["Row Header Text Column","Satır Başlığı Metni Sütunu"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","Belirtilirse, bu sütundaki değer satır başlığına uygulanacaktır. Bu, mevcut konuşmacı veya aktörü belirlemek vb. için kullanışlıdır. Sıfır tabanlı bir indekstir."],["Options","Seçenekler"],["Calculate cell value","Hücre değerini hesapla"],["Cell value in the form of formula will be transpiled","Formül şeklindeki hücre değeri derlenecek"],["Get formatted value","Biçimlendirilmiş değeri al"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","Hücre değerlerini biçimlendirmeden sonra işle. (Örneğin, belirli bir yerel ayarda 100000 tam sayısı USD 100,000 olacaktır)"],["Parse CSV in EXCEL format","CSV'yi EXCEL formatında ayrıştır"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","Ayrıştırıcıyı CSV'yi MS EXCEL şeklinde ayrıştırmaya zorla. (sadece CSV dosyaları için)"],["Skip the first <i>n</i> row(s)","İlk <i>n</i> satırı atla"],["Use this option if you want to skip the row header.","Satır başlığını atlamak istiyorsanız bu seçeneği kullanın."],["Select File(s)","Dosya(lar) Seç"],["Select a directory","Bir dizin seç"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Yeni bir Trans dosyası oluştur</span>"],["Create a new Trans file","Yeni bir Trans dosyası oluştur"],["The title of this project","Bu projenin başlığı"],["Engine type","Motor türü"],["Type of the engine","Motorun türü"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Yakın gelecekte harika bir şey için yer tutucu!</span>"],["Placeholder for something great at the near future!","Yakın gelecekte harika bir şey için yer tutucu!"],["This module will be created when the patron count reach 500!","Bu modül, patron sayısı 500'e ulaştığında oluşturulacak!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tAynı başlığa sahip bir proje <br>\"<span class=\"dialogGameTitle\"></span>\"<br> işlenmiş önbellekte zaten mevcut.<br>\n\t\tYükleme süresini önemli ölçüde kısaltmak için bu önbelleği yeniden kullanabilirsiniz.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","Eğer kafanız karışırsa, her zaman güvenle <strong><a href=\"#\">\"Yeni proje oluştur\"</a></strong> düğmesine tıklayabilirsiniz."],["Existed cache","Mevcut önbellek"],["Select Translator","Çevirmen Seç"],["Source column","Kaynak sütun"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","Hangi sütun çevrilecek kaynak metni içeriyor?<br>(varsayılan anahtar sütunu / en soldaki sütun)."],["Target column","Hedef sütun"],["Which column is the translated text put into.<br>(Can not same with source column)","Çevrilen metnin hangi sütuna yerleştirileceği.<br>(Kaynak sütunla aynı olamaz)"],["Translator's Options","Çevirmen Seçenekleri"],["Also try to translate other object","Diğer nesneleri de çevirmeyi dene"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","Bu seçenek işaretlenirse, Translator++ makine çevirisi gerektirmeyen ve seçmediğiniz diğer nesneleri de çevirmeye çalışacaktır. Bu, Translator++ sürüm 2.3.23 veya daha düşüklerinde varsayılan davranıştır."],["Ignore if already translated","Zaten çevrilmişse yoksay"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Bu seçenek işaretlenirse, Translator++ sütununda zaten çevirisi olan herhangi bir satırı yoksayacaktır."],["Overwrite cells","Hücrelerin üzerine yaz"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","Hedef hücrelerin üzerine yaz. İşaretlenmezse, hücreler boş değilse dokunulmaz."],["Save project on each batch.","Her parti için projeyi kaydet."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","Her parti tamamlandığında projenizi kaydedin.<br>Bu seçenek, yerel çevirmen uygulamasından ağır görevler çalıştırıldığında uygulama çökerse veri kaybını önlemek içindir. Bulut tabanlı çevirmen kullanıyorsanız muhtemelen buna ihtiyacınız yoktur."],["Play sound when completed.","Tamamlandığında ses çal."],["Tags","Etiketler"],["Select Context(s)","Bağlam(lar) Seç"],["Manual Query","Manuel Sorgu"],["Match all words","Tüm kelimeleri eşleştir"],["Remove selected","Seçileni kaldır"],["Remove all but selected","Seçilen dışındakileri kaldır"],["Select Context","Bağlam Seç"],["Source Column","Kaynak Sütun"],["Target Column","Hedef Sütun"],["Maximum length","Maksimum uzunluk"],["Export into","Şuraya aktar"],["What to do with tagged rows?","Etiketli satırlarla ne yapılacak?"],["Select Color Tag","Renk Etiketi Seç"],["On the fly word wrap","Anında kelime kaydırma"],["Inject all files (ignoring selection)","Tüm dosyaları enjekte et (seçimi yok sayarak)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","<b>Tümünü Enjekte Et</b> düğmesiyle çeviriyi enjekte etmek üzeresiniz. Bu, sol paneldeki seçili nesnenizden bağımsız olarak çeviriyi enjekte edecektir. Seçili nesneyi enjekte etmek istiyorsanız sol panelin bağlam menüsünü kullanın."],["Select the source material to be translated","Çevrilecek kaynak materyali seçin"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tÇevirmek istediğiniz belirli materyali veya içeriği seçin, örneğin bir dosya, dizin veya diğer ilgili girdiler. Seçilen materyalin erişilebilir ve ilgili ayrıştırıcı için uygun biçimlendirilmiş olduğundan emin olun.<br>\n\t\t\t\tVarsayılan olarak, bazı ayrıştırıcılar hazırlama dizinini kaynak materyal olarak kullanır.\n\t\t\t"],["Path is inaccessible.","Yola erişilemiyor."],["Target Directory","Hedef Dizin"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tÇevrilmiş uygulamanızın bir kopyası bu klasörde oluşturulacaktır.\n\t\t\t"],["Field can not be empty!","Alan boş olamaz!"],["Target to apply translation","Çeviriyi uygulama hedefi"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tLütfen çalıştırılabilir dosyayı seçin.\n\t\t\t"],["Copy materials","Materyalleri kopyala"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","Kaynak Materyalden Hedef Dizine kopyalama seçenekleri. (deneysel, tüm motorlar desteklenmez)"],["Word Wrap by Tags","Etiketlere Göre Kelime Kaydırma"],["Directory name","Dizin adı"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tNesne bu dizin altında gruplandırılacak.<br>\n\t\t\t\tYeni bir <b>referans nesnesi</b> eklemek için yıldız \"<code>*</code>\" girin.\n\t\t\t"],["Invalid directory  name","Geçersiz dizin adı"],["Object name","Nesne adı"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tNesnenin adı.\n\t\t\t"],["Invalid object name","Geçersiz nesne adı"],["New Project","Yeni Proje"],["Save","Kaydet"],["Save as...","Farklı Kaydet..."],["Open...","Aç..."],["Recent","Son"],["None...","Yok..."],["Export Project","Projeyi Dışa Aktar"],["To a folder","Bir klasöre"],["As a zip file","Bir zip dosyası olarak"],["To portable .tpp file","Taşınabilir .tpp dosyasına"],["To RPGMakerTrans file (*.txt)","RPGMakerTrans dosyasına (*.txt)"],["To CSV file","CSV dosyasına"],["To XLSX file","XLSX dosyasına"],["To XLS file","XLS dosyasına"],["To ODS file","ODS dosyasına"],["To HTML file","HTML dosyasına"],["Import","İçe aktar"],["Project from .tpp file","Proje .tpp dosyasından"],["Translation from .trans file","Çeviri .trans dosyasından"],["Translation Spreadsheet","Çeviri Tablosu"],["Translation RPGMKTRANSPATCH Format","Çeviri RPGMKTRANSPATCH Formatı"],["Automation","Otomasyon"],["Batch translation","Toplu çeviri"],["Context tool","Bağlam aracı"],["Batch word wrapping","Toplu satır kaydırma"],["Trim","Kırp"],["Auto padding","Otomatik dolgu"],["Tools","Araçlar"],["Third Party Application Installer","Üçüncü Taraf Uygulama Yükleyicisi"],["Close project","Projeyi Kapat"],["Exit","Çıkış"],["Start here","Buradan Başlayın"],["Start a New Project","Yeni Bir Proje Başlat"],["Continue your work","Çalışmanıza Devam Edin"],["Open Project","Proje Aç"],["Your recent translation","Son Çevirileriniz"],["Tips for you","Sizin İçin İpuçları"],["Next tip! <span class=\"icon-angle-double-right\"></span>","Sonraki ipucu! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","Bir satırdaki en sağdaki hücre öncelik alacaktır."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","Sadece bir trans dosyasıyla projenizi başkalarıyla paylaşamazsınız. Bir TPP dosyası oluşturmanız gerekiyor."],["Always make backups of your trans files.","Trans dosyalarınızın her zaman yedeklerini alın."],["You can rename and reorder the column with the coulumn header's context menu.","Sütun başlığının bağlam menüsüyle sütunu yeniden adlandırabilir ve sıralayabilirsiniz."],["Always backup your game before working with Translator++!","Translator++ ile çalışmadan önce oyununuzun her zaman yedeğini alın!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","Normal çalışmayan bir özellikle karşılaşırsanız, Translator++'ı yeniden başlatmayı deneyin, çoğu durumda sorunu çözecektir."],["Always create a backup of your game before patching with a translation.","Bir çeviriyle yama yapmadan önce oyununuzun her zaman yedeğini oluşturun."],["Thank you for supporting Translator++.","Translator++'ı desteklediğiniz için teşekkür ederiz."],["Please check Translator++'s online documentation at","Lütfen Translator++'ın çevrimiçi belgelerini şu adreste kontrol edin:"],["working","çalışıyor"],["Open","Aç"],["Save file","Dosyayı Kaydet"],["Save As","Farklı Kaydet"],["Import Project","Projeyi İçe Aktar"],["Inject / apply all translation","Tüm çevirileri uygula / ekle"],["Execute Global Level Custom Script","Genel Seviye Özel Betiği Çalıştır"],["Toggle Active Cell Info","Aktif Hücre Bilgisini Aç/Kapat"],["Project Properties","Proje Özellikleri"],["Get Help (F1)","Yardım Al (F1)"],["Batch translation (crl+b)","Toplu çeviri (ctrl+b)"],["File list","Dosya listesi"],["Live Translation Pane","Canlı Çeviri Paneli"],["Toggle selection","Seçimi Aç/Kapat"],["Invert selection","Seçimi Ters Çevir"],["Add A New Object","Yeni Nesne Ekle"],["Connect to auto translator","Otomatik çeviriye bağlan"],["Undock pane","Paneli ayır"],["Collapse / restore left panel","Sol paneli daralt / geri yükle"],["Add new key (alt+n)","Yeni anahtar ekle (alt+n)"],["Import Here","Buraya İçe Aktar"],["Add a note to this file","Bu dosyaya not ekle"],["Open search menu","Arama menüsünü aç"],["Toggle grid information","Izgara bilgisini aç/kapat"],["Object Properties","Nesne Özellikleri"],["Automatically set selected original text to clipboard","Seçili orijinal metni otomatik olarak panoya ayarla"],["Resize Font","Yazı Tipi Boyutunu Değiştir"],["Toggle word wrapping & Explicit white spaces","Kelime kaydırmayı & Açık beyaz boşlukları aç/kapat"],["Use Monospace font","Monospace yazı tipi kullan"],["Remove all translation from this file","Bu dosyadaki tüm çevirileri kaldır"],["Remove this file from project","Bu dosyayı projeden kaldır"],["file path","dosya yolu"],["Quick find","Hızlı bul"],["Active cell's info","Aktif hücre bilgisi"],["View original untranslated text","Orijinal çevrilmemiş metni görüntüle"],["View raw data","Ham veriyi görüntüle"],["View row properties","Satır özelliklerini görüntüle"],["Go to current cell","Geçerli hücreye git"],["Current coordinate","Geçerli koordinat"],["Word wraping (for non Japanese text)","Kelime kaydırma (Japonca olmayan metinler için)"],["Speak original text (alt+,)","Orijinal metni seslendir (alt+,)"],["Copy original text into current cell (ctrl+0)","Orijinal metni mevcut hücreye kopyala (ctrl+0)"],["Default translation for all occurrence","Tüm oluşumlar için varsayılan çeviri"],["Translations by context","Bağlama göre çeviriler"],["This cell has a comment","Bu hücrede bir yorum var"],["This cell has an organic content","Bu hücrede organik içerik var"],["This cell has been visited","Bu hücre ziyaret edildi"],["This is the first time this cell has been visited","Bu hücre ilk kez ziyaret edildi"],["Word wraping","Kelime kaydırma"],["Speak current translation text (alt+.)","Mevcut çeviri metnini seslendir (alt+.)"],["Current Cell Editor options","Mevcut Hücre Düzenleyici seçenekleri"],["Clear context translation for current row","Mevcut satır için bağlam çevirisini temizle"],["Get help about translation by context","Bağlama göre çeviri hakkında yardım al"],["Open menu","Menüyü aç"],["Path not accessible","Yola erişilemiyor"],["The location of the original material. You should not modify anything inside this folder.","Orijinal materyalin konumu. Bu klasör içindeki hiçbir şeyi değiştirmemelisiniz."],["The location of the game that has been translated. The default location of the translation injection.","Çevrilmiş oyunun konumu. Çeviri enjeksiyonunun varsayılan konumu."],["Prefered translator for this project. If not defined, global setting will be used.","Bu proje için tercih edilen çevirmen. Tanımlanmamışsa, genel ayar kullanılacak."],["-use default-","-varsayılanı kullan-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","Hazırlama yolu, çevirileri dışa aktarmak/oluşturmak için gereken bazı dosyaların konumudur. Projeyi oluşturduğunuzda hazırlama dosyaları oluşturulur."],["Number of objects/files available on the left pane","Sol panelde mevcut nesne/dosya sayısı"],["Number of characters in the Original Text column","Orijinal Metin sütunundaki karakter sayısı"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","Boşluk kullanmayan dillerde (örn. Japonca, Çince) yanlış değer gösterebilir."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","Kullanıcılar doğrudan tabloya doldurdu. Bu iyi bir işaret. İnsan çevirisi, düzenlenmiş MTL vb. olabilir."],["Run a javascript function after this project is successfully exported.","Bu proje başarıyla dışa aktarıldıktan sonra bir javascript işlevi çalıştır."],["Import .TRANS into project",".TRANS'ı projeye aktar"],["Import Spreadsheet Options","Elektronik Tablo Seçeneklerini Aktar"],["Import RPGMTransPatch Options","RPGMTransPatch Seçeneklerini Aktar"],["Start a new project","Yeni bir proje başlat"],["Search project type...","Proje türünü ara..."],["Remove row","Satırı kaldır"],["Add row","Satır ekle"],["Project is exist","Proje mevcut