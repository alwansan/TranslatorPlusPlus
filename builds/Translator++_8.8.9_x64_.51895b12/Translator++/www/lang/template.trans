titutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"relPath":"/addons/transLLMBatchApi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":125,"percent":0},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation"],["Target Column"],["The column to put the translation result."],["Import translation from ChatGPT Batch"],["Translation applied to selected rows"],["Invalid format"],["OK"],["Mismatch"],["Failed to load batch list with error: \n"],["Download Error File"],["Batch is not completed yet"],["Are you sure you want to cancel this batch?"],["Cannot cancel completed batch."],["Batch cancelled"],["Failed to cancel batch"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches"],["Apply translation"],["Cancel batch"],["Status"],["Batch ID"],["Input File ID"],["End point"],["Created at"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>"],["Completed at"],["Errors"],["Batch Item Detail of"],["ID"],["Completed on"],["Model"],["Prompt Token"],["Completion Token"],["Total Token"],["Status Code"],["error"],["Conversation"],["Response Validation"],["Raw Payload"],["View raw payload"],["Response Preview"],["Apply translations from selected rows"],["Here you can edit the translation result individually and send it into Translator++"],["Open ChatGPT Settings"],["Help"],["File list"],["Collapse / restore left panel"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":32,"percent":0},"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name"],["Service provider for your Batch API."],["API Key"],["Please enter your API key for the Batch API service."],["Model"],["The pre-trained model"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that."],["Jailbreak Template"],["Template of the Jailbreak message."],["Maximum Tokens"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096)."],["Temperature"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both."],["Nucleus sampling (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both."],["Frequency Penalty"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length."],["Max row per concurrent requests"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts."],["Code Escaping Algorithm"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>."],["Batch API settings"],["General"],["Explore more models"],["Templates"],["Enable Jailbreak"],["Advanced"],["Batch Translation Setting"],["Default"],["JavaScript template cloaking"],["None (no escaping)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"relPath":"/addons/transLLMBatchApi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":39,"percent":0},"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>"],["<li>ENGINE : Engine of the game</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>"],["Sample conversation"],["<h2>Sample dialogue</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>"],["Always separate file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files."],["Add actor name"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation."],["Load Actor Reference as Glossary"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data."],["Actor Reference Translation Column"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation."],["Actor's Information Column"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation."],["Extra Prompt"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message."],["General Settings"],["Always separate file for each batch"],["Append actor name to the translatable text"],["Glossary"],["<h2>Glossary</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>"],["The Column of Actor's Additional Information"],["Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transLLMBatchApi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":30,"percent":0},"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager"],["This feature is only available if you have a project open."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":false,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transLLMBatchApi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>"],["API's base URL"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>."],["API Version"],["Optional. The API version parameter needed for some services."],["API Key"],["Optional. The API key used for authenticating your access to the service."],["Model"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:"],["your deployment name"],["However, some models have unique names that can be directly identified, like:"],["Azure AD Token"],["AWS Access Key ID"],["AWS secret access key"],["Open router site URL"],["Open router APP name"],["Enable Context"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>"],["Context Character Limit"],["Character limit for the context."],["System Message Template"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>"],["<li>LANG_FROM : Source language</li>"],["<li>LANG_TO : Target language</li>"],["<li>SOURCE_TEXT : Source text</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>"],["<li>TITLE : Title of the game</li>"],["<li>ENGINE : Engine of the game</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>"],["Sample conversation"],["User message"],["Assistant's response"],["Body Message Template"],["Template of the body of your message."],["Enable JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that."],["Jailbreak Template"],["Template of the Jailbreak message."],["Maximum Tokens"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096)."],["Temperature"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both."],["Nucleus sampling (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both."],["Frequency Penalty"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>."],["Stop"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line."],["Additional argument variables"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout"],["Timeout for each batch in milisecond"],["Max Request Length"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter."],["Max concurrent requests"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed."],["Max row per concurrent requests"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk."],["Batch delay"],["Delay between batch (in miliseconds)"],["Code Escaping Algorithm"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice."],["Number of retry"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry."],["Retry when the number of translated rows doesn't match original"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload."],["Retry when the number of lines for each translated row doesn't match original"],["If enabled, the engine will retry when any translated row has different number of lines than its original row."],["Prompt: Row count mismatch"],["Prompt used when retrying due to row/element count mismatch."],["Prompt: Line count mismatch"],["Prompt used when retrying due to per-row line count mismatch."],["Prompt: Error / Retry instruction"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry."],["Custom Parameter"],["Key"],["Value"],["Type"],["Type of the value."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value."],["<br />Example: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter."],["You can drop the parameters that are not supported by the model here."],["Manage configuration"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine."],["Text Completion Setting"],["General"],["<h2>Don't waste your money on Reasoning Models</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>"],["Platform specific"],["Azure"],["AWS"],["Open Router"],["Templates"],["Enable context"],["<h2>Sample dialogue</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>"],["Retry prompts"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>"],["<p>Available variables:</p>"],["Enable Jailbreak"],["Advanced"],["Custom Parameters"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>"],["Drop Parameters"],["LiteLLM Proxy Configuration"],["Start LiteLLM server"],["Processing..."],["Server started on port "],["Check LiteLLM Status"],["Change LiteLLM Version"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: "],["Are you sure you want to install LiteLLM version "],["Failed to install LiteLLM. Please check the console for more details."],["LiteLLM has been successfully updated to version "],["Batch Translation Setting"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron."],["Retries and Refinement"],["<h2>Retries and Refinement</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>"],["<h2>Code Escaping Algorithm</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>"],["JavaScript template cloaking"],["None (no escaping)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue."],["Always separate file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files."],["Add actor name"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation."],["Load Actor Reference as Glossary"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data."],["Actor Reference Translation Column"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation."],["Actor's Information Column"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation."],["Extra Prompt"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message."],["General Settings"],["Always separate file for each batch"],["Append actor name to the translatable text"],["Glossary"],["<h2>Glossary</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>"],["The Column of Actor's Additional Information"],["Prompt"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":false,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"relPath":"/addons/transLitellm/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":166,"percent":0},"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API"],["Model"],["The pre-trained model."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column"],["The column of the original texts you want to translate."],["Add actor name"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation."],["Ignore if already translated"],["If this option is checked then Translator++ will ignore any row that already has translations on its column."],["Load Actor Reference as Glossary"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message."],["Actor Reference Translation Column"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation."],["Actor's Information Column"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation."],["System Message Template"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>"],["<li>LANG_FROM : Source language</li>"],["<li>LANG_TO : Target language</li>"],["<li>LANG_FROM_FULL : Full source language name</li>"],["<li>LANG_TO_FULL : Full target language name</li>"],["<li>SOURCE_TEXT : Source text</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>"],["<li>TITLE : Title of the game</li>"],["<li>ENGINE : Engine of the game</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>"],["Body Message Template"],["Template of the body of your chat."],["Sample conversation"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."],["General Settings"],["This form is using your OpenAI Batch API configuration.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>"],["There you can set the API key, model, and other settings.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />"],["<h2>Don't waste your money on Reasoning Models</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>"],["Append actor name to the translatable text"],["Ignore translated rows"],["Glossary"],["<h2>Glossary</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>"],["The Column of Actor's Additional Information"],["Prompt Template"],["<h2>1. System Message</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>"],["<h2>2. Sample dialogue</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>"],["<h2>3. Your actual prompt</h2>"],["<p>This is the actual prompt to the assistant.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request."],["Are you sure you want to reset the form?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation."],["The batch is successfully created. Do you want to open the batch manager?"],["OpenAI Batch API Queue"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"relPath":"/addons/transOpenAIBatch/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":65,"percent":0},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation"],["Target Column"],["The column to put the translation result."],["Import translation from ChatGPT Batch"],["Translation applied to selected rows"],["Invalid format"],["OK"],["Mismatch"],["Failed to load batch list with error: \n"],["Download Error File"],["Batch is not completed yet"],["Are you sure you want to cancel this batch?"],["Cannot cancel completed batch."],["Batch cancelled"],["Failed to cancel batch"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches"],["Apply translation"],["Cancel batch"],["Status"],["Batch ID"],["Input File ID"],["End point"],["Created at"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>"],["Completed at"],["Errors"],["Batch Item Detail of"],["ID"],["Completed on"],["Model"],["Prompt Token"],["Completion Token"],["Total Token"],["Status Code"],["error"],["Conversation"],["Response Validation"],["Raw Payload"],["View raw payload"],["Response Preview"],["Apply translations from selected rows"],["Here you can edit the translation result individually and send it into Translator++"],["Open ChatGPT Settings"],["Help"],["File list"],["Collapse / restore left panel"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":32,"percent":0},"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>"],["<li>ENGINE : Engine of the game</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>"],["Sample conversation"],["<h2>Sample dialogue</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>"],["Always separate file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files."],["Add actor name"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation."],["Load Actor Reference as Glossary"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data."],["Actor Reference Translation Column"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation."],["Actor's Information Column"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation."],["Extra Prompt"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message."],["General Settings"],["Always separate file for each batch"],["Append actor name to the translatable text"],["Glossary"],["<h2>Glossary</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>"],["The Column of Actor's Additional Information"],["Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transOpenAIBatch/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":30,"percent":0},"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager"],["This feature is only available if you have a project open."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":false,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transOpenAIBatch/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server"],["Server started"],["Reinstall server"],["Enter the new version of Translators library you wish to install.\nLatest version is: "],["Are you sure you want to install Translators version "],["Failed to install Translators. Please check the console for more details."],["Translators has been successfully updated to version "],["General Settings"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":false,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"relPath":"/addons/transPyTranslators/pyTranslators.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":8,"percent":0},"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?"],["Process paused!\nPress OK to continue!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":false,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"relPath":"/addons/transRedBatch/transredbatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":false,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"relPath":"/addons/transRikaikun/transRikaikun.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons."],["Please enter the port number:"],["Invalid port : "],["Port must be a numeric."],["Port has successfully changed to: "],["Connection Info"],["Do you want to copy the base URL into the clipboard?"],["Use secure protocol(HTTPS)"],["Port"],["Connection info"],["Help"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":false,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"relPath":"/addons/translationProxy/translationProxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":11,"percent":0},"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese."],["Use legacy parser"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower."],["Select TyranoBuilder packaged game"],["Select the exe file of your packaged game."],["Target folder"],["Select destination folder. The process will replace the existing files."],["Extraction completed"],["Close"],["Next"],["Please select game executable file"],["Back"],["The game is fully loaded, proceed!"],["Extract data"],["Open extracted folder"],["Extract resources"],["Select the game executable"],["Select the game executable or asar file to extract"],["Target directory"],["Select the target directory to store the unpacked files"],["Electron archive file detected. Do you want to extract the asar file instead?"],["Tyranobuilder Game Extractor"],["Before you create a new project, please make sure that :"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++"],["Your game is fully extracted."],["Extract TyranoBuilder package"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding"],["Literal tags are the tags that will be escaped into Translator++ editor."],["<b>ruby l r</b> are mandatory."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags."],["Translator++ can handle standard tags such as character names that start with a sharp (#)."],["However, Translator++ may not be able to handle custom tags created by developers."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project."],["Create Project"],["Play last build"],["Extract TyranoBuilder"],["Create playable package"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":false,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"relPath":"/addons/tyranoTrans/tyranoTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":45,"percent":0},"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General"],["Executable file location"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t"],["Field can not be empty!"],["Service"],["End Point"],["Auto translation service to use."],["Target Language"],["The language to translate into"],["Source Language"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended"],["Files"],["Directory"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}"],["Output File"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}"],["Substitution File"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}"],["Preprocessors File"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}"],["Text Frameworks"],["Enable/Disable auto translation for Unity's text frameworks."],["Behaviour"],["Max Characters Per Translation"],["Max characters per text to translate. Max 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys"],["Whether or not to ignore whitespace, including newlines, in NGUI"],["Minimum Dialogue Chars"],["The length of the text for it to be considered a dialogue"],["Force Split Text After Characters"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)"],["Whether or not to copy hooked texts to clipboard"],["MaxClipboardCopyCharacters"],["Max number of characters to hook to clipboard at a time"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation"],["Indicates whether batching of translations should be enabled for supported endpoints"],["Indicates whether or not to use translations from the included static translation cache"],["Override Font"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI"],["Override Font TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro"],["Resize UI Line Spacing Scale"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated."],["Ignore Text Starting With"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game."],["GameLog Text Paths"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'."],["Romaji Post Processing"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]"],["Translation Post Processing"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile."],["Indicates whether or not whitespace differences should be output to the specified OutputFile."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile."],["Indicates that the plugin should generate translations without variables when using substitutions."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these."],["Indicates the plugin should not print out success messages in relation to translations."],["Blacklisted IMGUI Plugins"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components."],["Max Text Parser Recursion"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent."],["Will enable automated handling of rich text (text with markup)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager)."],["Redirected Resource Detection Strategy"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it."],["Texture"],["Texture Directory"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities."],["Texture Hash Generation Strategy"],["Indicates how the mod identifies pictures through hashes."],["Duplicate Texture Names"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'"],["Indicates if the plugin should detect duplicate texture names."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage."],["Resource Redirector"],["Preferred Storage Path"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked"],["Indicates if translatable resources that are found should be dumped"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files"],["HTTP"],["User Agent"],["Override the user agent used by APIs requiring a user agent"],["Indiciates whether certificate validations for the .NET API should be disabled"],["Translation Aggregator"],["Width"],["The total width of the translation aggregator window"],["Height"],["The width (per translator) of the translation aggregator window."],["Enabled Translators"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'"],["Google"],["ServiceUrl"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC"],["Google Legitimate"],["Google API Key"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured"],["Bing Legitimate"],["OcpApim Subscription Key"],["OPTIONAL, needed if BingTranslateLegitimate is configured"],["Baidu"],["Baidu App Id"],["OPTIONAL, needed if BaiduTranslate is configured"],["BaiduAppSecret"],["Yandex"],["Yandex API Key"],["OPTIONAL, needed if YandexTranslate is configured"],["Watson"],["Url"],["OPTIONAL, needed if WatsonTranslate is configured"],["Key"],["DeepL"],["MinDelay"],["OPTIONAL, used for throttling DeepL"],["MaxDelay"],["DeepL Legitimate"],["OPTIONAL, required if DeepLLegitimate is configured"],["Custom"],["Optional, needed if Custom Translated is configured"],["Lec Power Translator 15"],["InstallationPath"],["Optional, needed if Lec Power Translator 15 is configured"],["Debug"],["Enables the console. Do not enable if other plugins (managers) handles this"],["Enables extra logging for debugging purposes"],["ezTrans"],["Installation Path of ezTrans."],["Migrations"],["Used to enable automatic migrations of this configuration file"],["Tag"],["Tag representing the last version this plugin was executed under. Do not edit"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":false,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":23,"Max Characters Per Translation":24,"Max characters per text to translate. Max 2500.":25,"Whether or not to ignore whitespace, including newlines, in dialogue keys":26,"Whether or not to ignore whitespace, including newlines, in NGUI":27,"Minimum Dialogue Chars":28,"The length of the text for it to be considered a dialogue":29,"Force Split Text After Characters":30,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":31,"Whether or not to copy hooked texts to clipboard":32,"MaxClipboardCopyCharacters":33,"Max number of characters to hook to clipboard at a time":34,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":35,"Indicates whether batching of translations should be enabled for supported endpoints":36,"Indicates whether or not to use translations from the included static translation cache":37,"Override Font":38,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":39,"Override Font TextMeshPro":40,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":41,"Resize UI Line Spacing Scale":42,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":43,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":44,"Ignore Text Starting With":45,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":46,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":47,"GameLog Text Paths":48,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":49,"Romaji Post Processing":50,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":51,"Translation Post Processing":52,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":53,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":54,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":55,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":56,"Indicates that the plugin should generate translations without variables when using substitutions.":57,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":58,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":59,"Indicates the plugin should not print out success messages in relation to translations.":60,"Blacklisted IMGUI Plugins":61,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":62,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":63,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":64,"Max Text Parser Recursion":65,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":66,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":67,"Will enable automated handling of rich text (text with markup).":68,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":69,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":70,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":71,"Redirected Resource Detection Strategy":72,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":73,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":74,"Texture":75,"Texture Directory":76,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":77,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":78,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":79,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":80,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":81,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":82,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":83,"Texture Hash Generation Strategy":84,"Indicates how the mod identifies pictures through hashes.":85,"Duplicate Texture Names":86,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":87,"Indicates if the plugin should detect duplicate texture names.":88,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":89,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":90,"Resource Redirector":91,"Preferred Storage Path":92,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":93,"Indicates if TextAssets should be redirected":94,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":95,"Indicates if translatable resources that are found should be dumped":96,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":97,"HTTP":98,"User Agent":99,"Override the user agent used by APIs requiring a user agent":100,"Indiciates whether certificate validations for the .NET API should be disabled":101,"Translation Aggregator":102,"Width":103,"The total width of the translation aggregator window":104,"Height":105,"The width (per translator) of the translation aggregator window.":106,"Enabled Translators":107,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":108,"Google":109,"ServiceUrl":110,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":111,"Google Legitimate":112,"Google API Key":113,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":114,"Bing Legitimate":115,"OcpApim Subscription Key":116,"OPTIONAL, needed if BingTranslateLegitimate is configured":117,"Baidu":118,"Baidu App Id":119,"OPTIONAL, needed if BaiduTranslate is configured":120,"BaiduAppSecret":121,"Yandex":122,"Yandex API Key":123,"OPTIONAL, needed if YandexTranslate is configured":124,"Watson":125,"Url":126,"OPTIONAL, needed if WatsonTranslate is configured":127,"Key":128,"DeepL":129,"MinDelay":130,"OPTIONAL, used for throttling DeepL":131,"MaxDelay":132,"DeepL Legitimate":133,"OPTIONAL, required if DeepLLegitimate is configured":134,"Custom":135,"Optional, needed if Custom Translated is configured":136,"Lec Power Translator 15":137,"InstallationPath":138,"Optional, needed if Lec Power Translator 15 is configured":139,"Debug":140,"Enables the console. Do not enable if other plugins (managers) handles this":141,"Enables extra logging for debugging purposes":142,"ezTrans":143,"Installation Path of ezTrans.":144,"Migrations":145,"Used to enable automatic migrations of this configuration file":146,"Tag":147,"Tag representing the last version this plugin was executed under. Do not edit":148},"tags":[],"relPath":"/addons/unityTrans/configEdit.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":148,"percent":0},"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!"],["XUnity.AutoTranslator is found!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project."],["XUnity.AutoTranslator is not found!"],["The wizard will guide you to install XUnity.AutoTranslator into the game."],["Next"],["Given path: "],["\nis not an Unity game. Do you still want to proceed?"],["Patch successfully installed!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n"],["Open the game now?"],["Finish"],["Update current project?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":false,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"relPath":"/addons/unityTrans/unityTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":13,"percent":0},"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes."],["Use shell copy if possible"],["Use shell copy instead of native NodeJS copy handler."],["Use shell copy"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?"],["Unable to determina WRPGE path."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?"],["Dev path is not defined.\nYou should inject your game once to generate dev path."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++."],["Wolf RPG Editor games"],["Parsing Wolf RPG Game with"],["Wolf RPG Editor game"],["Select the game's executable file"],["Engine version"],["Detected WolfRPG Engine version of the selected game"],["Heads up!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?"],["Create a new project"],["Please specify a game to be processed!"],["Set dev path. Path to the directory of the translated game."],["Play last build"],["Open editor"],["Open Wolf RPG Editor online manual"],["Open Wolf RPG Editor english manual"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":false,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"relPath":"/addons/wolfJs/wolfJs.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":26,"percent":0},"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format."],["Create project"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":false,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"relPath":"/addons/xmlTrans/xml.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator"],["Checking up requirements..."],["Create a new translation project from YU-RIS visual novel engine"],["Next"],["Select YU-RIS game"],["Select the game's executable file"],["Engine version"],["Detected YU-RIS version of the selected game"],["Create a new project"],["Invalid target game :"],["Source material do not match the current translation project!"],["Select the repack method."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":false,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"relPath":"/addons/yurisParser/YurisParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/automationEditor.html":{"data":[["Form Builder"],["Run"],["New Project (ctrl+n)"],["Open (ctrl+o)"],["Save file (ctrl+s)"],["Save As (ctrl+shift+s)"],["Open debugger (F12)"],["Help"],["Select file in the current workspace"],["file path"],["Create shortcut of the current script"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":false,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"relPath":"/automationEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":11,"percent":0},"parameters":[]},"/find.html":{"data":[["Find"],[