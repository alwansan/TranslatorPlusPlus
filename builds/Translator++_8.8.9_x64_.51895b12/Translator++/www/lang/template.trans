tid/25418/type/StringLiteral"],["tid/25562/type/StringLiteral","tid/26056/type/StringLiteral","tid/34634/type/StringLiteral","tid/37385/type/StringLiteral","tid/47792/type/StringLiteral"],["tid/25801/type/StringLiteral"],["tid/26110/type/StringLiteral"],["tid/30681/type/StringLiteral"],["tid/31037/type/StringLiteral"],["tid/31174/type/StringLiteral"],["tid/31408/type/StringLiteral"],["tid/31574/type/StringLiteral"],["tid/31713/type/StringLiteral"],["tid/33496/type/StringLiteral"],["tid/34508/type/StringLiteral"],["tid/35458/type/StringLiteral"],["tid/35888/type/StringLiteral"],["tid/36469/type/NoSubstitutionTemplate"],["tid/36474/type/NoSubstitutionTemplate"],["tid/36545/type/StringLiteral"],["tid/36731/type/StringLiteral"],["tid/37259/type/StringLiteral"],["tid/37471/type/StringLiteral"],["tid/37870/type/StringLiteral","tid/38404/type/StringLiteral"],["tid/37914/type/StringLiteral"],["tid/38151/type/StringLiteral","tid/38682/type/StringLiteral","tid/44037/type/StringLiteral"],["tid/38169/type/StringLiteral"],["tid/38700/type/StringLiteral","tid/44055/type/StringLiteral"],["tid/39212/type/StringLiteral"],["tid/39226/type/StringLiteral"],["tid/39233/type/StringLiteral"],["tid/39240/type/StringLiteral"],["tid/39247/type/StringLiteral"],["tid/39254/type/StringLiteral"],["tid/39261/type/StringLiteral"],["tid/39268/type/StringLiteral"],["tid/39275/type/StringLiteral"],["tid/39282/type/StringLiteral"],["tid/39560/type/StringLiteral"],["tid/39567/type/StringLiteral"],["tid/39574/type/StringLiteral"],["tid/39581/type/StringLiteral"],["tid/39588/type/StringLiteral"],["tid/39595/type/StringLiteral"],["tid/40027/type/StringLiteral"],["tid/43804/type/StringLiteral"],["tid/44686/type/StringLiteral"],["tid/46202/type/StringLiteral","tid/46240/type/StringLiteral"],["tid/46480/type/StringLiteral"],["tid/46557/type/StringLiteral"],["tid/48659/type/StringLiteral","tid/50075/type/StringLiteral"],["tid/60027/type/StringLiteral"],["tid/66504/type/StringLiteral"],["tid/66576/type/StringLiteral"],["tid/66620/type/StringLiteral"],["tid/66686/type/StringLiteral"],["tid/66746/type/StringLiteral"],["tid/66772/type/StringLiteral"],["tid/68035/type/StringLiteral"],["tid/68084/type/StringLiteral"],["tid/69208/type/StringLiteral"],["tid/69382/type/TemplateHead","tid/70089/type/TemplateHead"],["tid/69384/type/TemplateTail","tid/70091/type/TemplateTail"],["tid/69811/type/StringLiteral"],["tid/70151/type/StringLiteral"],["tid/74815/type/StringLiteral"],["tid/74898/type/StringLiteral"],["tid/75985/type/StringLiteral"],["tid/77908/type/StringLiteral"]],"basename":"ui.js","dirname":"/js","extension":".js","filename":"ui.js","path":"/js/ui.js","indexIsBuilt":false,"indexIds":{"`You cannot close the application at this moment, reason: \\n${":0,"}`":1,"Do you really want to exit Translator++?\nAll unsaved changes will be discarded!":2,"Trans file":3,"Translator++ Project Package (TPP) file":4,"Select all":5,"Select none":6,"Invert":7,"Match destination selection":8,"use mouse drag to do bulk selection":9,"Invalid trans data":10,"Inject / Apply translation":11,"Inject / Apply translation to all":12,"Cancel":13,"Apply Translation":14,"Target path cannot be a parent or child of the source material's path.\nPlease select another path.":15,"Help":16,"Import":17,"Revert to origin data":18,"Select target directory.":19,"The existing files will be overwritten!":20,"Process":21,"Path to the directory can not be empty!":22,"Invalid directory:":23,"Rebuild translation table from this cache":24,"Create new project":25,"-nothing-":26,"Ok":27,"No action selected, are you sure?":28,"No context's keyword specified!":29,"Remove context containing keyword :\n":30,"\nfrom selected files?":31,"Remove every rows except rows that has a context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"relPath":"/js/ui.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":148,"percent":0},"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)"],["Close"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)"],["Close"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/js/ui.parts.js":{"data":[["Form"],["Cancel"],["Ok"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":3,"percent":0},"parameters":[]},"/jsoneditor.html":{"data":[["Remove note"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/login.html":{"data":[["working"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/note.html":{"data":[["Remove note"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/options.html":{"data":[["Click to login"],["Translator &amp; Language"],["Proofreader"],["Assistant"],["General"],["Preferences"],["Add-ons"],["About"],["User Information"],["Login to your Patreon account to get access to the latest features and updates."],["<i class=\"icon-login\"></i> Login"],["<i class=\"icon-login\"></i> Login with browser"],["Welcome,"],["Name"],["Email"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>."],["<i class=\"icon-logout\"></i> Logout"],["Primary Translator"],["Default Translator Engine"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t"],["Default Language"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t"],["Default Source Language"],["Default Target Language"],["Custom escape"],["Patterns"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t"],["AI Assistant"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration"],["Model Endpoint"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions"],["API Key"],["Your API key for authenticating with the AI service. This will be stored securely."],["Model Name"],["Select or enter the AI model to use. Models with tool support are recommended for best results."],["File Association"],["Extension"],["Associate"],["Set All"],["Unset All"],["Apply"],["Update"],["Auto update"],["Automatically update Translator++ if possible."],["Allow reinstall the same version"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program."],["Use default browser to login"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used."],["Multi threading"],["Number of thread"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t"],["Backup"],["Enable backup"],["Automatically create backup every time you save your project."],["Backup level history"],["How many history of backup do you want to keep?"],["Log &amp; Debugging"],["Log to file"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder."],["Truncate log file each session"],["When checked your log file will be truncated each time you re open the application."],["Application Settings"],["Enable remote debugging"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes."],["Disable GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes."],["Dangerous Area"],["Interface Language"],["UI Language"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder."],["Spell checker Language"],["Set the default spell checker language."],["Environment Variables"],["Staging Directory"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts."],["Project creation"],["Auto Load Common Reference"],["Auto load common reference from .trans file."],["Project settings"],["Progress Column Indices"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable"],["<i class=\"icon-download-cloud-1\"></i>Install"],["Install from a package"],["Visit our website &amp; documentation : "],["Fork Translator++ at : "],["Support Translator++ at : "],["Join our discord channel at : "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!"],["Version Info"],["Last checked at : "],["Check now!"],["You have a pending update"],["Update now"],["Your Translator++ is up to date 😃."],["Architecture"],["License"],["Click here to read the license."],["Credits"],["Localization"],["About Third Party Software"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t"],["Special Thanks"],["Want to explicitly support Translator++ by putting your name on this section?"],["Click here to learn more about how to do that!"],["Changelog"],["Feeds"],["Click connect button, to connect translator with Translator++ table"],["working"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)"],["Filter..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":124,"percent":0},"parameters":[]},"/scriptEditor.html":{"data":[["Run"],["New Project (ctrl+n)"],["Open (ctrl+o)"],["Save file (ctrl+s)"],["Save As (ctrl+shift+s)"],["Open debugger (F12)"],["Help"],["Select file in the current workspace"],["file path"],["Create shortcut of the current script"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":10,"percent":0},"parameters":[]},"/tableEditor.html":{"data":[["Reset"],["Clear"],["Search"],["Help"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":4,"percent":0},"parameters":[]},"/trans.html":{"data":[["Start"],["Home"],["Translator"],["Objects"],["Live translation"],["Original"],["Raw"],["Row Properties"],["Default translation"],["Context translation"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>"],["File :"],["Row ID :"],["<i class=\"icon-th-2\"></i><span>Context</span>"],["<i class=\"icon-users\"></i><span>Actors</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>"],["File ID"],["Path"],["Original Format"],["Data Length"],["Translated"],["General"],["Language"],["Staging"],["Stats"],["Advanced"],["Info"],["Title"],["File Location"],["Project ID"],["Built on"],["Editor Name"],["Editor Version"],["Engine"],["Parser"],["Parser version"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>"],["Translate From"],["Translate Into"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>"],["Folders"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>"],["Total Rows"],["Translated row"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>"],["&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>"],["Display this information when the project is opened."],["Select Export Mode"],["Export to a folder"],["Export pre-compiled game data to a folder<br>Folder structures are retained"],["Export as a Zip file"],["Export pre-compiled game data to a single zipped archive"],["RPGMakerTrans Patch Files"],["Export to RPGMakerTrans formatted *.txt files in a folder"],["Comma Separated Values"],["Export to Comma Separated Values (csv) files in a folder"],["Office Open XML (.xlsx) Excel 2007 and above"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder"],["BIFF 8 (.xls) Excel 97 and above"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder"],["HTML Spreadsheet"],["Export to HTML files in a folder"],["Open Document Format/OASIS (.ods)"],["Export to ODS files in a folder"],["Select Import Mode"],["Import translation from another .trans file"],["Open another Translator++ file<br>Apply translation into current project."],["Import translation from spreadsheets"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)"],["Import translation from RPGMakerTrans Patch format"],["Import translation from RPGMaker Trans' patch files<br>(.txt)"],["Source :"],["Select objects to import"],["Import mode :"],["Import translations"],["Import data object"],["Destination :"],["Currently selected : "],["Options :"],["Import the context translations"],["Case insensitive"],["Overwrite target"],["Destination column : "],["Translation mode :"],["Row by row translation"],["Line by line translation"],["Select translation by context address"],["Just copy translation into the same row (No checking)"],["Merge data"],["Import translation from spreadsheet into project"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty."],["Please click the radio button to select files/folder to import"],["Import file(s)"],["Import folder"],["Import translation from RPG Maker Trans into project"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>"],["Select project type"],["Spreadsheet"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project"],["Create a new .trans file from scratch."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>"],["Fetch type"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)"],["All columns are translatable text"],["Custom"],["Custom Options"],["Which column do you want to fetch?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>."],["Column to be translated"],["Column to put translation into"],["Action"],["Enable Row Header Text Column"],["If enabled, the parser will process the following Row Header Text Column rule"],["Row Header Text Column"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index."],["Options"],["Calculate cell value"],["Cell value in the form of formula will be transpiled"],["Get formatted value"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)"],["Parse CSV in EXCEL format"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)"],["Skip the first <i>n</i> row(s)"],["Use this option if you want to skip the row header."],["Select File(s)"],["Select a directory"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>"],["Create a new Trans file"],["The title of this project"],["Engine type"],["Type of the engine"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>"],["Placeholder for something great at the near future!"],["This module will be created when the patron count reach 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. "],["Existed cache"],["Select Translator"],["Source column"],["Which column is the source text to translate for?<br>(default is key column / leftmost column)."],["Target column"],["Which column is the translated text put into.<br>(Can not same with source column)"],["Translator's Options"],["Also try to translate other object"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower."],["Ignore if already translated"],["If this option is checked then Translator++ will ignore any row that already has translations on its column."],["Overwrite cells"],["Overwrite target cells. If not checked, the cells will not be touched when not empty."],["Save project on each batch."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator."],["Play sound when completed."],["Tags"],["Select Context(s)"],["Manual Query"],["Match all words"],["Remove selected"],["Remove all but selected"],["Select Context"],["Source Column"],["Target Column"],["Maximum length"],["Export into"],["What to do with tagged rows?"],["Select Color Tag"],["On the fly word wrap"],["Inject all files (ignoring selection)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object."],["Select the source material to be translated"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t"],["Path is inaccessible."],["Target Directory"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t"],["Field can not be empty!"],["Target to apply translation"],["\n\t\t\t\tPlease select executable file.\n\t\t\t"],["Copy materials"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)"],["Word Wrap by Tags"],["Directory name"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t"],["Invalid directory  name"],["Object name"],["\n\t\t\t\tThe name of the object.\n\t\t\t"],["Invalid object name"],["New Project"],["Save"],["Save as..."],["Open..."],["Recent"],["None..."],["Export Project"],["To a folder"],["As a zip file"],["To portable .tpp file"],["To RPGMakerTrans file (*.txt)"],["To CSV file"],["To XLSX file"],["To XLS file"],["To ODS file"],["To HTML file"],["Import"],["Project from .tpp file"],["Translation from .trans file"],["Translation Spreadsheet"],["Translation RPGMKTRANSPATCH Format"],["Automation"],["Batch translation"],["Context tool"],["Batch word wrapping"],["Trim"],["Auto padding"],["Tools"],["Third Party Application Installer"],["Close project"],["Exit"],["Start here"],["Start a New Project"],["Continue your work"],["Open Project"],["Your recent translation"],["Tips for you"],["Next tip! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority."],["You can't share your project with others with just a trans file. You need to generate a TPP file."],["Always make backups of your trans files."],["You can rename and reorder the column with the coulumn header's context menu."],["Always backup your game before working with Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases."],["Always create a backup of your game before patching with a translation."],["Thank you for supporting Translator++."],["Please check Translator++'s online documentation at"],["working"],["Open"],["Save file"],["Save As"],["Import Project"],["Inject / apply all translation"],["Execute Global Level Custom Script"],["Toggle Active Cell Info"],["Project Properties"],["Get Help (F1)"],["Batch translation (crl+b)"],["File list"],["Live Translation Pane"],["Toggle selection"],["Invert selection"],["Add A New Object"],["Connect to auto translator"],["Undock pane"],["Collapse / restore left panel"],["Add new key (alt+n)"],["Import Here"],["Add a note to this file"],["Open search menu"],["Toggle grid information"],["Object Properties"],["Automatically set selected original text to clipboard"],["Resize Font"],["Toggle word wrapping & Explicit white spaces"],["Use Monospace font"],["Remove all translation from this file"],["Remove this file from project"],["file path"],["Quick find"],["Active cell's info"],["View original untranslated text"],["View raw data"],["View row properties"],["Go to current cell"],["Current coordinate"],["Word wraping (for non Japanese text)"],["Speak original text (alt+,)"],["Copy original text into current cell (ctrl+0)"],["Default translation for all occurrence"],["Translations by context"],["This cell has a comment"],["This cell has an organic content"],["This cell has been visited"],["This is the first time this cell has been visited"],["Word wraping"],["Speak current translation text (alt+.)"],["Current Cell Editor options"],["Clear context translation for current row"],["Get help about translation by context"],["Open menu"],["Path not accessible"],["The location of the original material. You should not modify anything inside this folder."],["The location of the game that has been translated. The default location of the translation injection."],["Prefered translator for this project. If not defined, global setting will be used."],["-use default-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project."],["Number of objects/files available on the left pane"],["Number of characters in the Original Text column"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese)."],["Users filled directly into the grid. Which is a good sign. Can be hu