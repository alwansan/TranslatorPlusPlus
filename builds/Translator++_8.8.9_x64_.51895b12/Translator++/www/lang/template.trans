:"/addons/basicUtils/utils/HTMLPacker.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":33,"percent":0},"parameters":[]},"/addons/basicUtils/utils/Updater.js":{"data":[["An update is being installed. Please do not close the application until the installation is completed."],["Package Path"],["Select the package file."],["Package Key"],["If you have the key, please enter it here. If not, leave it empty."],["Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>."],["Update from package"],["Update"],["Update Translator++"]],"context":[["tid/4918/type/StringLiteral"],["tid/6562/type/StringLiteral"],["tid/6572/type/StringLiteral"],["tid/6612/type/StringLiteral"],["tid/6622/type/StringLiteral"],["tid/6661/type/NoSubstitutionTemplate"],["tid/6753/type/StringLiteral","tid/7195/type/StringLiteral"],["tid/6770/type/StringLiteral","tid/7091/type/StringLiteral"],["tid/7120/type/StringLiteral"]],"basename":"Updater.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"Updater.js","path":"/addons/basicUtils/utils/Updater.js","indexIsBuilt":false,"indexIds":{"An update is being installed. Please do not close the application until the installation is completed.":0,"Package Path":1,"Select the package file.":2,"Package Key":3,"If you have the key, please enter it here. If not, leave it empty.":4,"Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.":5,"Update from package":6,"Update":7,"Update Translator++":8},"tags":[],"relPath":"/addons/basicUtils/utils/Updater.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":9,"percent":0},"parameters":[]},"/addons/basicUtils/utils/info.js":{"data":[["You have "],[" missed update(s)!"],["Translator++ will update itself if auto-update is enabled."],["You can download the latest core version of Translator++ at"],["This update is available for all patrons."],["This update is available for tier $"],[" patrons or greater."],["You're up-to-date!"],["Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!"],["Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details."],["When the same version is available"],["Allow Translator++ to reinstall the same version of Translator++."],["Allow reinstall the same version"],["Update Settings"],["Update Now"],["Updater is not available, please update Translator++ manually."],["Updating Translator++"],["Please don't close Translator++ until the update process is finished."],["Can not update, reason :\n"],["You may need to reconnect Translator++ with your Patreon account (logout and login again)."],["Also, it has been reported that some countries such as mainland China are blocking dropbox repository."],["If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:"],["After that, please use the \"Update from package\" feature to update your Translator++."],["If you still have problems, please contact us at our Discord server : "],["Restart"],["Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first."],["Check for Update"],["Close"]],"context":[["tid/649/type/StringLiteral"],["tid/660/type/StringLiteral"],["tid/665/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/1033/type/StringLiteral"],["tid/1077/type/StringLiteral"],["tid/1088/type/StringLiteral"],["tid/1665/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1675/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1765/type/StringLiteral"],["tid/1811/type/StringLiteral"],["tid/1873/type/StringLiteral"],["tid/2021/type/StringLiteral"],["tid/2066/type/StringLiteral"],["tid/2116/type/StringLiteral"],["tid/2130/type/StringLiteral"],["tid/2176/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2220/type/StringLiteral"],["tid/2245/type/NoSubstitutionTemplate"],["tid/2259/type/StringLiteral"],["tid/2357/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2449/type/StringLiteral"],["tid/2512/type/StringLiteral"]],"basename":"info.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"info.js","path":"/addons/basicUtils/utils/info.js","indexIsBuilt":false,"indexIds":{"You have ":0," missed update(s)!":1,"Translator++ will update itself if auto-update is enabled.":2,"You can download the latest core version of Translator++ at":3,"This update is available for all patrons.":4,"This update is available for tier $":5," patrons or greater.":6,"You're up-to-date!":7,"Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!":8,"Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.":9,"When the same version is available":10,"Allow Translator++ to reinstall the same version of Translator++.":11,"Allow reinstall the same version":12,"Update Settings":13,"Update Now":14,"Updater is not available, please update Translator++ manually.":15,"Updating Translator++":16,"Please don't close Translator++ until the update process is finished.":17,"Can not update, reason :\n":18,"You may need to reconnect Translator++ with your Patreon account (logout and login again).":19,"Also, it has been reported that some countries such as mainland China are blocking dropbox repository.":20,"If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:":21,"After that, please use the \"Update from package\" feature to update your Translator++.":22,"If you still have problems, please contact us at our Discord server : ":23,"Restart":24,"Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.":25,"Check for Update":26,"Close":27},"tags":[],"relPath":"/addons/basicUtils/utils/info.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":28,"percent":0},"parameters":[]},"/addons/basicUtils/utils/uiTags.js":{"data":[["Do not process row with selected tag (blacklist)"],["Only process row with selected tag (whitelist)"],["Ignore tag"],["Load last selection"],["Reset"],["Cancel"],["Confirm"]],"context":[["tid/55/type/StringLiteral"],["tid/60/type/StringLiteral"],["tid/65/type/StringLiteral"],["tid/410/type/StringLiteral"],["tid/415/type/StringLiteral"],["tid/2085/type/StringLiteral"],["tid/2137/type/StringLiteral"]],"basename":"uiTags.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"uiTags.js","path":"/addons/basicUtils/utils/uiTags.js","indexIsBuilt":false,"indexIds":{"Do not process row with selected tag (blacklist)":0,"Only process row with selected tag (whitelist)":1,"Ignore tag":2,"Load last selection":3,"Reset":4,"Cancel":5,"Confirm":6},"tags":[],"relPath":"/addons/basicUtils/utils/uiTags.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":7,"percent":0},"parameters":[]},"/addons/customParser/CustomParserLoader.js":{"data":[["List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created."],["For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>"],["Example: utf8,utf8 bom,utf16le,ascii"],["Select the target character encoding."]],"context":[["tid/3375/type/NoSubstitutionTemplate"],["tid/3383/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/4740/type/StringLiteral"]],"basename":"CustomParserLoader.js","dirname":"/addons/customParser","extension":".js","filename":"CustomParserLoader.js","path":"/addons/customParser/CustomParserLoader.js","indexIsBuilt":false,"indexIds":{"List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.":0,"For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>":1,"Example: utf8,utf8 bom,utf16le,ascii":2,"Select the target character encoding.":3},"tags":[],"relPath":"/addons/customParser/CustomParserLoader.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":4,"percent":0},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.html":{"data":[["<i class=\"icon-edit\"></i>"],["<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>"],["Add a new file group"],["<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>"],["Remove current file group"],["Rules"],["Hooks"],["Options"],["Testing"],["Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>"],["Example"],["For example, the text obtained from the parser is as follows:"],["In this grid it will look like this:"],["That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n"],["With the hook above the text in the grid will be :"],["Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>."],["\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n"],["\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n"],["...will be converted into desired format: "],["Edit the translated text just before writing it into a file."],["Parameters"],["\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            "],["text"],["The text that is about to be written into a file."],["Return value"],["\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            "],["The text that will be written into a file."],["General"],["Read character encoding"],["Force parser to use the following character encoding when reading the file(s)."],["Write character encoding"],["Force parser to use the following character encoding when writing the file(s)."],["You are editing:"],["Please select the mode of your pattern"],["Regular expression Pattern"],["A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern."],["Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. "],["<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist."],["Translatable Capture groups"],["Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma."],["Row Info Capture group"],["\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          "],["Context template"],["\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          "],["Action"],["Capture value"],["Capture then mask value"],["Mask value"],["Send to inner rule"],["Edit inner rule <i class=\"icon-angle-double-right\"></i>"],["What action the pattern is going to do."],["Javascript function"],["Guide"],["\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        "],["Arguments"],["The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:"],["A string of the entire content of the file."],["The rule object that is currently used by the file."],["<i>this</i> Keyword"],["<b>this</b> will reffer to the instance of CustomParser class."],["\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        "],["Expected Return Value"],["Your code must <b>return</b> one of the following value:"],["Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            "],["Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            "],["\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        "],["The following code is an example to parse srt subtitle."],["Welcome to the Custom Parser Model Creator"],["Please start by creating a new File Group."],["Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    "],["Press F1 to open the help dialog."],["New File"],["Open file"],["Save file"],["Save As"],["Open debugger (F12)"],["Help"],["Edit current file pattern"],["Add a new file pattern"],["Remove current file pattern"],["Rule's order does matter, especially when you use masking! Drag to reorder."]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText","idx/29/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/28/innerText","idx/69/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"],["idx/9/attr/title"]],"basename":"modelEditor.html","dirname":"/addons/customParser/modelEditor","extension":".html","filename":"modelEditor.html","path":"/addons/customParser/modelEditor/modelEditor.html","indexIsBuilt":false,"indexIds":{"<i class=\"icon-edit\"></i>":0,"<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>":1,"Add a new file group":2,"<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>":3,"Remove current file group":4,"Rules":5,"Hooks":6,"Options":7,"Testing":8,"Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>":9,"Example":10,"For example, the text obtained from the parser is as follows:":11,"In this grid it will look like this:":12,"That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n":13,"With the hook above the text in the grid will be :":14,"Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.":15,"\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n":16,"\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n":17,"...will be converted into desired format: ":18,"Edit the translated text just before writing it into a file.":19,"Parameters":20,"\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ":21,"text":22,"The text that is about to be written into a file.":23,"Return value":24,"\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ":25,"The text that will be written into a file.":26,"General":27,"Read character encoding":28,"Force parser to use the following character encoding when reading the file(s).":29,"Write character encoding":30,"Force parser to use the following character encoding when writing the file(s).":31,"You are editing:":32,"Please select the mode of your pattern":33,"Regular expression Pattern":34,"A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.":35,"Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ":36,"<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.":37,"Translatable Capture groups":38,"Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.":39,"Row Info Capture group":40,"\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ":41,"Context template":42,"\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ":43,"Action":44,"Capture value":45,"Capture then mask value":46,"Mask value":47,"Send to inner rule":48,"Edit inner rule <i class=\"icon-angle-double-right\"></i>":49,"What action the pattern is going to do.":50,"Javascript function":51,"Guide":52,"\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ":53,"Arguments":54,"The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:":55,"A string of the entire content of the file.":56,"The rule object that is currently used by the file.":57,"<i>this</i> Keyword":58,"<b>this</b> will reffer to the instance of CustomParser class.":59,"\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ":60,"Expected Return Value":61,"Your code must <b>return</b> one of the following value:":62,"Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ":63,"Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ":64,"\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ":65,"The following code is an example to parse srt subtitle.":66,"Welcome to the Custom Parser Model Creator":67,"Please start by creating a new File Group.":68,"Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ":69,"Press F1 to open the help dialog.":70,"New File":71,"Open file":72,"Save file":73,"Save As":74,"Open debugger (F12)":75,"Help":76,"Edit current file pattern":77,"Add a new file pattern":78,"Remove current file pattern":79,"Rule's order does matter, especially when you use masking! Drag to reorder.":80},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":81,"percent":0},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.js":{"data":[["Do you want to close Model editor?\rAll unsaved changes will be discarded."],["Translate here using "],["Do you want to discard your changes and open\n"],["Error when trying to open file :"],["Parser Model Creator"],["Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json"],["Failed to create new file group. Please check your pattern!"],["Do you wish to remove current file group?\nYou can not undo this action!"],["Do you want to discard your changes and create a new blank model?"],["Do you want to discard your changes and open a file?"],["Clear history"],["Open latest file"],["Open from history"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS."]],"context":[["tid/156/type/StringLiteral"],["tid/5647/type/StringLiteral"],["tid/9760/type/StringLiteral"],["tid/10037/type/StringLiteral"],["tid/10099/type/StringLiteral"],["tid/10622/type/StringLiteral","tid/10941/type/StringLiteral"],["tid/10665/type/StringLiteral","tid/10987/type/StringLiteral"],["tid/11026/type/StringLiteral"],["tid/11104/type/StringLiteral"],["tid/11174/type/StringLiteral","tid/12080/type/StringLiteral"],["tid/11459/type/StringLiteral"],["tid/11525/type/StringLiteral"],["tid/11607/type/StringLiteral"],["tid/11750/type/StringLiteral"]],"basename":"modelEditor.js","dirname":"/addons/customParser/modelEditor","extension":".js","filename":"modelEditor.js","path":"/addons/customParser/modelEditor/modelEditor.js","indexIsBuilt":false,"indexIds":{"Do you want to close Model editor?\rAll unsaved changes will be discarded.":0,"Translate here using ":1,"Do you want to discard your changes and open\n":2,"Error when trying to open file :":3,"Parser Model Creator":4,"Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json":5,"Failed to create new file group. Please check your pattern!":6,"Do you wish to remove current file group?\nYou can not undo this action!":7,"Do you want to discard your changes and create a new blank model?":8,"Do you want to discard your changes and open a file?":9,"Clear history":10,"Open latest file":11,"Open from history":12,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":13},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":14,"percent":0},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string"],["Required field Project ID is blank!"],["Required field Service Account Key is blank!"],["Required field Server Location is blank!"],["Required field Location of the glossary file is blank!"],["Required field Glossary Languages is blank!"],["Invalid glossary language value"],["Currently active glossary on this project: "],["Error when retreiving glossary info: "],["Error when removing glossary : "],["Glossary removed successfully."],["Error when creating glossary : "],["Glossary created successfully."],["Configuration error:\r\n"],["No error found!"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js"]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":16,"percent":0},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?"],["JCap agent started successfully. Press "],["jcapKey"],["Please set the JCap executable path in the addon settings."],["JCap executable already exists at the specified location."],["JCap executable downloaded successfully."],["Failed to download JCap package. Please check the console for details."],["JCap executable unpacked successfully."],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent."],["Start JCap OCR Agent"],["Failed to unpack JCap package. Please check the console for details."],["JCap executable not found at the specified location."],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration."],["JCap uninstalled successfully."],["Failed to uninstall JCap. Please check the console for details."],["Help"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text."]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":17,"percent":0},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data"],["When checked the generated data will be beautified."],["Start a new translation project from any JSON file."],["Translator++ will translate any translatable texts found in the JSON files."],["Read the guide on how to start a new JSON translation project here"],["Translator++ will scan through this folder for any JSON files."],["How do you want to get the data from the JSON object?"],["Parser mode"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>"],["Start project"],["`Invalid destination directory:\\n${"],["}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":17,"percent":0},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label"],["is duplicated in the same scenario file"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":2,"percent":0},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory"],["Select a directory to repack"],["Target xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded."],["Patch to allow folder structure"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found."],["Repack into xp3"],["Close"],["Process"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten."],["Unpack XP3 files"],["Repack a folder to xp3"],["Unpack xp3 file"],["Before you create a new project, please make sure that :"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted."],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data."],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>."],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them."],["This may not work on some projects."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list."],["Literal tags are the tags that will be escaped into Translator++ editor."],["<b>ruby l r</b> are mandatory."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags."],["Translator++ can handle standard tags such as character names that start with a sharp (#)."],["However, Translator++ cannot handle custom tags created by developers."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names."],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project."],["Create Project"],["Pack a folder into xp3"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding."],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference."]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":34,"percent":0},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode"],["Select how do you want to start your project. By selecting files or folders."],["Select Folder"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder."],["Select File"],["Select the files you want to process."],["Filters"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders."],["All .mo files in the selected folder and its subfolders."],["PO Files"],["MO Files"],["You are about to export the translations as MO files.\n"],["- MO files are binary files that cannot be edited manually.\n"],["- Only translated entries are stored in MO files.\n"],["Are you sure you want to proceed?"],["PO / MO Files"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":17,"percent":0},"parameters":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading."],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts"],["Create Project"],["Select mode"],["Select how do you want to start your project. By selecting files or folders."],["Select Folder"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder."],["Select File"],["Select the files you want to process."],["Filters"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders."],["All .mo files in the selected folder and its subfolders."],["ProjectTitle"],["Your project title"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor"],["Half width character patch"],["Patch half-width character"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":3,"percent":0},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings"],["Next"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?"],["Create a new project"],["Invalid destination file:"],[" doesn't seems to be a LiveMaker game."]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":6,"percent":0},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path."],["Decompile all rpyc files"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project."],["Overwrite rpy"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>."],["Exclude command"],["This option will allow us to skip some command for being processed and translated"],["Separate entries with a space"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored"],["Are you sure want to start a project without decompiling the rpyc files?"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?"],["Play last build"],["Open Ren'Py documentation"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu."]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":14,"percent":0},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator"],["Parsing Windows binary file with"],["Sellect supported files"],["Select supported file type to translate."],["Create a new project"],["Please select a supported file to parse"],["Please enter your project title!"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":7,"percent":0},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player"],["Use native RPG Player instead of Easy RPG Player"],["Use native RPG Player"],["Target folder"],["Select destination folder."],["Install Easy RPG Player"],["Close"],["Install"],["Process completed!"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin."],["Play last build"],["Apply translation then play"],["Setup Easy RPG in the current directory"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":13,"percent":0},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine"],["Create project"],["Please select RPG Maker 2000/2003 game!"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":4,"percent":0},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder"],["Select destination folder."],["Install Easy RPG Player"],["Close"],["Install"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!"],["Play last build"],["Apply translation then play"],["Setup Easy RPG in the current directory"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":10,"percent":0},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data"],["When checked the generated data will be beautified."],["Error loading system.json"],["Loading"],["index.html not found in"],["Encrypted game"],["Select the index.html of your encrypted game."],["Target folder"],["Select destination folder. The process will replace the existing files."],["Decrypt Resources"],["Close"],["Process"],["Source path can not empty"],["Destination path can not empty"],["Path is not a file:"],["Invalid directory:"],["Extract enigma"],["Select enigma file."],["Extract Enigma"],["Selected file is not an Enigma Virtual Box package."],["Plugins are already fetched for this project. Want to re-fetch the plugins?"],["Translate Javascript File?"],["Cancel"],["I know the risk, Proceed!"],["Game Executable Path"],["Path to the game executable file (.exe)"],["NWJS Version"],["Change into this NWJS version"],["Use Developer version"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'."],["Use 32-bit version"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude)."],["Some game feature may not work across NWJS version"],["Please be aware that some game feature may not work across NWJS version."],["Change RPG Maker MV / RPG Maker MZ / NWJS version"],["This operation will change the NW.js version into"],["Please close the application first before continuing.\nDo you want to continue?"],["The selected file is not a valid NW.js application."],["Could not find index.html in the game directory."],["Debug menu script not found in addon directory."],["Debug menu script is already installed in index.html."],["Debug options installed successfully!"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n"],["Developer Mode provides additional debugging features:\n"],["• Developer Console (F12)\n"],["• Inspect Element (Right-click)\n"],["• Network Monitor\n"],["• Performance Profiler\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n"],["(Recommended for better debugging experience)"],["The game will be upgraded to NW.js SDK version"],["This may take a few minutes. Please wait..."],["NW.js has been upgraded to Developer Mode successfully!"],["Failed to upgrade to Developer Mode:\n"],["Error installing debug options: "],["Install Debug Options"],["This will install a debug menu into your RPG Maker MV/MZ game."],["Select the game executable file to install debug options."],["Compile HTML to Executable"],["Change Existing NWJS Version"],["Install debug options"],["Find next"],["Open folder"],["Open with external application"],["Raw JSON data. Right click to open menu."],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js."],["Error while installing debug options: "],["Play last build"],["Dev path is not defined.\nYou should inject your game once to generate dev path."],["Open editor"],["Load Plugins Into Project"],["Compile Game"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu."],["Unable to find the file related to the data"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>"],["Maximum dialog line"],["Maximum line in the dialog box. Default is 4."],["Add debug options"],["Add debug options into the game to help testing."],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/type/StringLiteral","tid/21410/type/StringLiteral"],["tid/20865/type/StringLiteral","tid/21461/type/StringLiteral"],["tid/20925/type/StringLiteral"],["tid/20962/type/StringLiteral"],["tid/20992/type/StringLiteral"],["tid/21023/type/StringLiteral"],["tid/21215/type/StringLiteral"],["tid/21220/type/StringLiteral"],["tid/21309/type/StringLiteral"],["tid/21564/type/StringLiteral"],["tid/21678/type/StringLiteral"],["tid/22062/type/StringLiteral"],["tid/22163/type/StringLiteral"],["tid/22214/type/StringLiteral"],["tid/22424/type/StringLiteral","tid/24166/type/StringLiteral"],["tid/22434/type/StringLiteral","tid/24176/type/StringLiteral"],["tid/22468/type/StringLiteral"],["tid/22478/type/StringLiteral"],["tid/22512/type/StringLiteral","tid/22962/type/StringLiteral"],["tid/22522/type/StringLiteral"],["tid/22533/type/StringLiteral"],["tid/22560/type/StringLiteral","tid/22986/type/StringLiteral"],["tid/22570/type/StringLiteral"],["tid/22605/type/NoSubstitutionTemplate"],["tid/22610/type/NoSubstitutionTemplate"],["tid/23014/type/NoSubstitutionTemplate"],["tid/23119/type/NoSubstitutionTemplate"],["tid/23148/type/NoSubstitutionTemplate"],["tid/23298/type/StringLiteral"],["tid/23453/type/StringLiteral"],["tid/23555/type/StringLiteral"],["tid/23696/type/StringLiteral"],["tid/23770/type/StringLiteral"],["tid/23812/type/StringLiteral"],["tid/23820/type/StringLiteral"],["tid/23828/type/StringLiteral"],["tid/23836/type/StringLiteral"],["tid/23844/type/StringLiteral"],["tid/23852/type/StringLiteral"],["tid/23860/type/StringLiteral"],["tid/23868/type/StringLiteral"],["tid/23922/type/NoSubstitutionTemplate"],["tid/23931/type/NoSubstitutionTemplate"],["tid/23972/type/StringLiteral"],["tid/24005/type/StringLiteral"],["tid/24068/type/StringLiteral"],["tid/24217/type/NoSubstitutionTemplate","tid/24282/type/NoSubstitutionTemplate"],["tid/24222/type/NoSubstitutionTemplate"],["tid/24227/type/NoSubstitutionTemplate"],["tid/24482/type/StringLiteral"],["tid/24546/type/StringLiteral"],["tid/24598/type/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":82,"percent":0},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS."]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js."]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features."],["Use old parser"],["Event's thread concurrency"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data."],["The minimum number of command in an event that allowed in thread worker"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands."],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1."],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3"],["Start translation from RPG Maker game using the latest parser."],["Error!\r\nTranslator++ is unable to detect the type of "],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter."],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game."],["Unable to extract the Enigma package!"],["Copy & extract data into "]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?"],["Maximum dialog line"],["Maximum line in the dialog box. Default is 4."]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":4,"percent":0},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine."],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253.."],["Create project"],["Error: customField is not defined. This should not happen!"],["Please select the entry point to translate."],["There are currently two known locations of translatable text within the SRPG Studio game. <br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both."],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format."]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":8,"percent":0},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe."],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version."],["Create Project"],["Source mode"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON."],["Select executable"],["Select the game executable. Translator++ will look for data.dts in the same folder."],["Select archive file"],["Select data.dts directly."],["Select dump folder"],["Select the translation dump folder generated by SRPG_Unpacker.exe."],["Filters"],["Glob pattern used to select JSON files from the dump folder."],["ProjectTitle"],["Your project title"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed."],["Server Type :"],["Installed Model :"],["Install Sugoi Translator"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%"],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                "],["Select the following option to install the suitable patch for your system"],["Your GPU is:"],["Install patch For NVIDIA series 30xx or greater"],["Install patch For NVIDIA series 20xx or lower"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode."],["Starting port number"],["The port numbers will be generated incrementaly starting from the value below"],["Keep console window open"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash."],["Action"],["Set Sugoi Trans config based on this setting"],["Start All Server"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":22,"percent":0},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder"],["Where do you want to install the CT2 Sugoi Translator into?"],["Cancel"],["Install now!"],["Path to the directory can not be empty!"],["Invalid directory:"],["Failed to download file. Repository do not exist. Please see the console log for more information."],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier"],["Install CT2 Sugoi Translator"],["Installation completed\nDo you want to set the Server Manager with this installed server?"],["Sugoi Translator Installed"],["Server started\nPlease wait until the server(s) are ready before you translate things."],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?"],["Do you want to reset the current configuration?"],["Configuration refreshed!"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":16,"percent":0},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line."],["Target URL(s)"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line."],["Max Parallel job"],["Maximum parallel job that run simultaneously."],["Send requests in batch"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option."],["Check First Line in Common Reference"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line."],["Check Last Line in Common Reference"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line."],["Automatic splitting"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size."],["Code Escaping Algorithm"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":16,"percent":0},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message."],["Actor Reference Translation Column"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation."],["Actor's Information Column"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation."],["System Message Template"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>"],["<li>LANG_FROM : Source language</li>"],["<li>LANG_TO : Target language</li>"],["<li>LANG_FROM_FULL : Full source language name</li>"],["<li>LANG_TO_FULL : Full target language name</li>"],["<li>SOURCE_TEXT : Source text</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>"],["<li>TITLE : Title of the game</li>"],["<li>ENGINE : Engine of the game</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>"],["Body Message Template"],["Template of the body of your chat."],["Sample conversation"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."],["Glossary"],["<h2>Glossary</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>"],["The Column of Actor's Additional Information"],["Prompt Template"],["<h2>1. System Message</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>"],["<h2>2. Sample dialogue</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>"],["<h2>3. Your actual prompt</h2>"],["<p>This is the actual prompt to the assistant.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request."]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":40,"percent":0},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":1,"percent":0},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization"],["If checked, all organic translation (manually inputted translation) will be memorized automatically."],["Memorize translation by automation script"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization."],["Remind translation on cell translate"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell."],["Default memorization behavior"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record."],["MySQL host"],["The host name or IP address of your MySQL server"],["MySQL port"],["MySQL Port. Default is 3306."],["MySQL user name"],["Username to access the DB."],["MySQL password"],["Password to access the DB."],["Database Name"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential."],["Database Type"],["Automatically memorize manually inputted translations?"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron."],["Automatically memorize translation made by automation scripts?"],["Remind translations when performing translate selection?"],["Use rememorize in organic translation"],["default"],["Indexed DB (experimental)"],["MySQL"],["Database Setting"],["IndexedDB"],["Generate"],["Escaping algorithm for inline code inside dialogues"],["Test connection"],["Connection success!"],["MySql"],["Connection failed!\nError:"],["Install MySQL Server"],["How to setup MySQL Server"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?"],["Your database structure need to be updated."],["Upgrade database"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?"],["The translation memory database has been upgraded!\nPlease restart Translator++!"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":42,"percent":0},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory"],["Fix the problem!"],["No exact matches found!"],["Original"],["Translation"],["Do you want Translator++ to forget the selected cell(s)?"],["Auto recall"],["Auto memorize organic translation"],["Auto memorize automation"],["Use rememorize in organic translation"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["tid/2391/type/StringLiteral"],["tid/2543/type/StringLiteral"],["tid/2686/type/StringLiteral"],["tid/2838/type/StringLiteral"]],"basename":"tmUI.js","dirname":"/addons/tm","extension":".js","filename":"tmUI.js","path":"/addons/tm/tmUI.js","indexIsBuilt":false,"indexIds":{"Memory":0,"Fix the problem!":1,"No exact matches found!":2,"Original":3,"Translation":4,"Do you want Translator++ to forget the selected cell(s)?":5,"Auto recall":6,"Auto memorize organic translation":7,"Auto memorize automation":8,"Use rememorize in organic translation":9},"tags":[],"relPath":"/addons/tm/tmUI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":10,"percent":0},"parameters":[]},"/addons/tpp-localizationTool/fetchtrans.js":{"data":[["Preparing download file..."],["Translation template downloaded successfully!"],["Building translation data..."],["Processing: "],["Fetching directory content..."],["Parsing: "],["Localization Tools"],["Generate UI Translation Template"],["Update Translation Table"],["This will overwrite www/lang/template.trans and update all localization files listed in www/lang/options.json.\n\nExisting translations will be preserved. New strings from the current source will be added.\n\nContinue?"],["Saving template.trans..."],["Loading language options..."],["Updating: "],["Failed to update: "],["Translation tables updated successfully!"]],"context":[["tid/2001/type/StringLiteral"],["tid/2228/type/StringLiteral"],["tid/2286/type/StringLiteral"],["tid/2439/type/StringLiteral"],["tid/2623/type/StringLiteral"],["tid/2825/type/StringLiteral"],["tid/3098/type/StringLiteral"],["tid/3131/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3244/type/StringLiteral"],["tid/3358/type/StringLiteral"],["tid/3408/type/StringLiteral"],["tid/3657/type/StringLiteral"],["tid/3812/type/StringLiteral"],["tid/3852/type/StringLiteral"]],"basename":"fetchtrans.js","dirname":"/addons/tpp-localizationTool","extension":".js","filename":"fetchtrans.js","path":"/addons/tpp-localizationTool/fetchtrans.js","indexIsBuilt":false,"indexIds":{"Preparing download file...":0,"Translation template downloaded successfully!":1,"Building translation data...":2,"Processing: ":3,"Fetching directory content...":4,"Parsing: ":5,"Localization Tools":6,"Generate UI Translation Template":7,"Update Translation Table":8,"This will overwrite www/lang/template.trans and update all localization files listed in www/lang/options.json.\n\nExisting translations will be preserved. New strings from the current source will be added.\n\nContinue?":9,"Saving template.trans...":10,"Loading language options...":11,"Updating: ":12,"Failed to update: ":13,"Translation tables updated successfully!":14},"tags":[],"relPath":"/addons/tpp-localizationTool/fetchtrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":15,"percent":0},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel"],["model"],["|"],["promptLibrary"],["search"],["downloadChat"],["newChat"],["api"],["customEndpoint"],["apiEndpoint.inputLabel"],["apiKey.inputLabel"],["apiVersion.inputL