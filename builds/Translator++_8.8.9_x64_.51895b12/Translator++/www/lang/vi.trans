e/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":82,"length":82,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS.","Tính năng này chỉ khả dụng nếu bạn đang sử dụng phiên bản Nhà phát triển của NWJS."]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js.","Tính năng này chỉ khả dụng nếu bạn đang sử dụng phiên bản nhà phát triển của NW.js."]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser","Sử dụng trình phân tích cũ"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.","Sử dụng trình phân tích cũ trước (Translator++ phiên bản 3.8.12). Trình phân tích cũ không hỗ trợ một số tính năng mới được thêm vào."],["Use old parser","Sử dụng trình phân tích cũ"],["Event's thread concurrency","Đồng thời luồng sự kiện"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.","<b>Cảnh báo! Tính năng thử nghiệm!</b><br />Tùy chọn này xác định số lượng luồng công nhân tối đa có thể phân tích dữ liệu sự kiện đồng thời trên Bản đồ và Sự kiện Chung. <b>Đặt thành 0 để tắt luồng công nhân</b>. <br />Tùy chọn này có tiềm năng tăng tốc quá trình phân tích trong các trò chơi lớn. Tuy nhiên, cần lưu ý rằng trong các trò chơi nhỏ, bật tùy chọn này thực sự có thể làm chậm quá trình phân tích do chi phí thực thi cao hơn so với thời gian phân tích cho mỗi dữ liệu."],["The minimum number of command in an event that allowed in thread worker","Số lượng lệnh tối thiểu trong một sự kiện được phép trong luồng công nhân"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.","<b>Cảnh báo! Tính năng thử nghiệm!</b><br />Luồng công nhân phát sinh chi phí trong quá trình thực thi, có nghĩa là xử lý các sự kiện trống hoặc sự kiện có số lượng lệnh thấp thực sự có thể cản trở toàn bộ quá trình. Tùy chọn này cho phép bạn chỉ định số lượng lệnh tối thiểu mà một sự kiện phải có để được phân tích trong một luồng công nhân. <br />Cần lưu ý rằng ngay cả sự kiện trống cũng chứa một lệnh, và việc xử lý các sự kiện như vậy trong luồng chính hiệu quả hơn so với trong luồng công nhân. Do đó, khuyến nghị đặt số này thành một giá trị <b>lớn hơn 1</b>.<br />Đặt thành 0 để tắt việc phân chia nhiệm vụ dựa trên lệnh."],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.","Lưu ý rằng một sự kiện trống thực sự chứa một lệnh, và bạn chắc chắn muốn xử lý các sự kiện trống trong luồng chính thay vì luồng công nhân. Bạn nên đặt số này thành một giá trị lớn hơn 1."],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3","Trình phân tích RPG Maker XP, VX, Ace, MV & MZ V.3"],["Start translation from RPG Maker game using the latest parser.","Bắt đầu dịch từ trò chơi RPG Maker bằng trình phân tích mới nhất."],["Error!\r\nTranslator++ is unable to detect the type of ","Lỗi!\r\nTranslator++ không thể phát hiện loại của "],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.","Bạn nên thay đổi đường dẫn!\r\nThư mục Dev không nên nằm trong thư mục trò chơi gốc, vì điều này sẽ gây ra vấn đề nếu bạn tiêm trò chơi sau này."],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","Trò chơi được đóng gói với Enigma.\r\nBạn có muốn giải nén gói này không?\r\nViệc này sẽ mất vài phút, tùy thuộc vào kích thước trò chơi của bạn."],["Unable to extract the Enigma package!","Không thể giải nén gói Enigma!"],["Copy & extract data into ","Sao chép & trích xuất dữ liệu vào "]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?","Cần có RPGMakertrans CLI Gateway để chạy hành động này.\nRPGMakertrans CLI Gateway được cấp phép theo GPL-3 và không thể phân phối cùng chương trình.\nNhưng Translator++ có thể thiết lập nó thay cho bạn.\n\nBạn có muốn Translator++ cài đặt RPGMakertrans CLI Gateway cho bạn không?"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?","Cần cập nhật RPGMakertrans CLI Gateway.\nBạn có muốn Translator++ cập nhật RPGMakertrans CLI Gateway cho bạn không?"],["Maximum dialog line","Dòng hộp thoại tối đa"],["Maximum line in the dialog box. Default is 4.","Số dòng tối đa trong hộp thoại. Mặc định là 4."]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine.","Bắt đầu dự án dịch từ SRPG Studio Engine."],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..","Bộ phân tích có thể xử lý dịch từ <b>data.dts</b> (tệp srpgs); tệp <b>localization.dat</b> và các tệp localization (.json, .txt, .js) được tạo bởi công cụ localization của SRPG Studio giới thiệu từ phiên bản 1.253."],["Create project","Tạo dự án"],["Error: customField is not defined. This should not happen!","Lỗi: customField không được định nghĩa. Điều này không nên xảy ra!"],["Please select the entry point to translate.","Vui lòng chọn điểm nhập để dịch."],["There are currently two known locations of translatable text within the SRPG Studio game. <br />","Hiện có hai vị trí đã biết của văn bản có thể dịch trong trò chơi SRPG Studio. <br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.","Đầu tiên được viết trực tiếp trong tệp .srpgs, và thứ hai là trong tệp localization.dat. Bộ phân tích này hiện có thể xử lý cả hai."],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.","<br />Ngoài ra, bạn cũng có thể dịch các tệp localization được tạo bởi công cụ localization của SRPG Studio. Các tệp này ở định dạng JSON, TXT và JS."]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.","Phân tích kho lưu trữ SRPG Studio và JSON dump dịch được tạo bởi SRPG_Unpacker.exe."],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.","Bắt đầu dịch từ data.dts, project.dat của SRPG Studio hoặc JSON dump dịch.<br />Đây là bộ phân tích mới nhất—nhanh hơn và ổn định hơn đáng kể—sẽ thay thế phiên bản trước."],["Create Project","Tạo Dự án"],["Source mode","Chế độ nguồn"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.","Chọn chế độ EXE để bắt đầu từ tệp thực thi trò chơi, chế độ kho lưu trữ cho data.dts / project.dat, hoặc chế độ dump cho JSON dump dịch."],["Select executable","Chọn tệp thực thi"],["Select the game executable. Translator++ will look for data.dts in the same folder.","Chọn tệp thực thi trò chơi. Translator++ sẽ tìm data.dts trong cùng thư mục."],["Select archive file","Chọn tệp lưu trữ"],["Select data.dts directly.","Chọn trực tiếp data.dts."],["Select dump folder","Chọn thư mục dump"],["Select the translation dump folder generated by SRPG_Unpacker.exe.","Chọn thư mục dump dịch được tạo bởi SRPG_Unpacker.exe."],["Filters","Bộ lọc"],["Glob pattern used to select JSON files from the dump folder.","Mẫu glob dùng để chọn tệp JSON từ thư mục dump."],["ProjectTitle","Tiêu đề dự án"],["Your project title","Tiêu đề dự án của bạn"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>","Vị trí Sugoi translator <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Trỏ đến tệp .bat hoặc .exe trong thư mục gốc của ứng dụng.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Đường dẫn không hợp lệ.<br>Một số tính năng sẽ bị vô hiệu hóa cho đến khi sửa lỗi này."],["Server Type :","Loại máy chủ :"],["Installed Model :","Mô hình đã cài đặt :"],["Install Sugoi Translator","Cài đặt Sugoi Translator"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ","Chưa có Sugoi Translator?\n            Cài đặt máy chủ Sugoi Translator tùy chỉnh &amp; tối ưu hóa ngay bây giờ!\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>","Số lượng máy chủ để khởi động (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Số lượng máy chủ được khởi động đồng thời\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%","Số lượng máy chủ được khởi động đồng thời.<br>Nhiều tiến trình không phải lúc nào cũng có nghĩa là nhanh hơn, hãy lưu ý đến dung lượng RAM &amp; CPU của bạn.<br>Bạn có thể không nhận được lợi ích nếu chỉ chạy một máy chủ mà mức sử dụng CPU đã đạt 100%"],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ","\n                    Sugoi Translator của bạn không hỗ trợ xử lý GPU.<br>\n                    Bạn cần vá máy chủ để hỗ trợ xử lý GPU.<br>\n                    <h3 data-tran=\"\">Chọn tùy chọn sau để cài đặt bản vá phù hợp cho hệ thống của bạn</h3>\n                    <div>\n                        <span data-tran=\"\">GPU của bạn là:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Cài đặt bản vá cho NVIDIA series 30xx trở lên</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Cài đặt bản vá cho NVIDIA series 20xx trở xuống</button>\n    \n                    </div>\n                "],["Select the following option to install the suitable patch for your system","Chọn tùy chọn sau để cài đặt bản vá phù hợp cho hệ thống của bạn"],["Your GPU is:","GPU của bạn là:"],["Install patch For NVIDIA series 30xx or greater","Cài đặt bản vá cho NVIDIA series 30xx trở lên"],["Install patch For NVIDIA series 20xx or lower","Cài đặt bản vá cho dòng NVIDIA series 20xx hoặc thấp hơn"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>","Số lượng máy chủ để khởi động (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Số lượng máy chủ được khởi động đồng thời sử dụng GPU. Máy chủ của bạn phải được vá để kích hoạt xử lý GPU.\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.","Bạn muốn khởi động bao nhiêu máy chủ trên <b>GPU</b> của mình. Có thể chạy đồng thời dịch vụ dựa trên CPU và GPU. Nhưng hãy lưu ý rằng nếu mức sử dụng CPU cao có thể cản trở hiệu suất GPU.<br>Máy chủ của bạn phải được vá để kích hoạt chế độ này."],["Starting port number","Số cổng bắt đầu"],["The port numbers will be generated incrementaly starting from the value below","Các số cổng sẽ được tạo tăng dần bắt đầu từ giá trị dưới đây"],["Keep console window open","Giữ cửa sổ console mở"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.","ngăn cửa sổ console đóng khi máy chủ đóng. Tùy chọn này hữu ích để kiểm tra lỗi gây ra sự cố máy chủ."],["Action","Hành động"],["Set Sugoi Trans config based on this setting","Đặt cấu hình Sugoi Trans dựa trên cài đặt này"],["Start All Server","Khởi động tất cả máy chủ"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":22,"length":22,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder","Chọn thư mục cài đặt"],["Where do you want to install the CT2 Sugoi Translator into?","Bạn muốn cài đặt CT2 Sugoi Translator vào đâu?"],["Cancel","Hủy"],["Install now!","Cài đặt ngay!"],["Path to the directory can not be empty!","Đường dẫn đến thư mục không được để trống!"],["Invalid directory:","Thư mục không hợp lệ:"],["Failed to download file. Repository do not exist. Please see the console log for more information.","Không tải được tệp. Kho lưu trữ không tồn tại. Vui lòng xem nhật ký console để biết thêm thông tin."],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series","Bạn có chắc muốn cập nhật máy chủ của mình?\nTập lệnh cập nhật này sẽ hoạt động cho dòng NVIDIA 3XXX series"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier","Bạn có chắc muốn cập nhật máy chủ của mình?\nTập lệnh cập nhật này sẽ hoạt động cho dòng NVIDIA 2XXX series và trước đó"],["Install CT2 Sugoi Translator","Cài đặt CT2 Sugoi Translator"],["Installation completed\nDo you want to set the Server Manager with this installed server?","Cài đặt hoàn tất\nBạn có muốn thiết lập Trình quản lý Máy chủ với máy chủ đã cài đặt này không?"],["Sugoi Translator Installed","Sugoi Translator Đã Cài Đặt"],["Server started\nPlease wait until the server(s) are ready before you translate things.","Máy chủ đã khởi động\nVui lòng đợi cho đến khi máy chủ sẵn sàng trước khi dịch."],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?","Hành động này sẽ ghi đè giá trị hiện tại của cài đặt Tiện ích Sugoi Trans.\nBạn có chắc chắn không?"],["Do you want to reset the current configuration?","Bạn có muốn đặt lại cấu hình hiện tại không?"],["Configuration refreshed!","Cấu hình đã được làm mới!"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter","Dấu phân cách dòng"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.","Điền vào các ký tự hoặc cụm từ sẽ được thoát khỏi bởi trình dịch (cụm từ gốc và bản dịch sẽ luôn giống nhau). Điều này đảm bảo số dòng của văn bản dịch bằng số dòng của văn bản gốc.\nHiện không có cụm từ/ký tự nào mà Sugoi sẽ thoát với tỷ lệ thành công 100%.\nBạn có thể thử dùng &#x3C;br&#x3E; với tỷ lệ thành công khá tốt.\nĐể trống nếu muốn nối các dòng thành một dòng duy nhất."],["Target URL(s)","URL Mục tiêu"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.","URL mục tiêu của trình dịch. Bạn có thể nhập một hoặc nhiều URL back-end của Sugoi Translator. Translator++ sẽ cân bằng tải yêu cầu qua tất cả các phiên bản dịch vụ. Phân tách mỗi mục bằng dòng mới."],["Max Parallel job","Công việc song song tối đa"],["Maximum parallel job that run simultaneously.","Số công việc song song tối đa chạy đồng thời."],["Send requests in batch","Gửi yêu cầu theo lô"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.","Gửi nhiều văn bản (theo Công việc song song tối đa) trong mảng.\nNhanh hơn và có thể giảm đáng kể chi phí thực thi. Bạn phải chạy máy chủ từ trình quản lý máy chủ để bật tùy chọn này."],["Check First Line in Common Reference","Kiểm tra Dòng Đầu tiên trong Tham chiếu Chung"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.","Không bao gồm dòng đầu tiên trong tải trọng nếu dòng đầu tiên được tìm thấy trong Tham chiếu Chung.\nRất hữu ích nếu tên nhân vật ở dòng đầu tiên."],["Check Last Line in Common Reference","Kiểm tra Dòng Cuối cùng trong Tham chiếu Chung"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.","Không bao gồm dòng cuối cùng trong tải trọng nếu dòng cuối cùng được tìm thấy trong Tham chiếu Chung.\nRất hữu ích nếu tên nhân vật ở dòng cuối cùng."],["Automatic splitting","Tách tự động"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.","Tự động tách bản dịch thành số dòng khớp với bản gốc. Độ dài mỗi dòng sẽ có kích thước tương tự."],["Code Escaping Algorithm","Thuật toán Mã hóa"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)","Thuật toán mã hóa cho mã nội tuyến bên trong hội thoại (chưa được triển khai, vui lòng chờ các bản cập nhật trong tương lai)"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary","Tải Tham chiếu Nhân vật làm Từ điển"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu nhân vật làm từ điển. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu nhân vật là tên của nhân vật trong hội thoại. Nó sẽ được tải như một từ điển cho người dịch. Điều này sẽ làm tăng chi phí dịch thuật."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm từ điển cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu nhân vật trong tin nhắn nhắc."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Nhân vật"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch của tên nhân vật. Cột này sẽ được sử dụng làm bản dịch của tham chiếu nhân vật. Điều này sẽ cải thiện tính nhất quán trong việc dịch tên nhân vật trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông tin Nhân vật"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung về nhân vật. Bạn có thể đặt thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện việc dịch đại từ trong cuộc trò chuyện."],["System Message Template","Mẫu Tin nhắn Hệ thống"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Tin nhắn hệ thống là phần đầu của tin nhắn sẽ cho biết vai trò của trợ lý chatGPT của bạn. Tin nhắn này sẽ được gửi như tin nhắn đầu tiên của mỗi lô bạn gửi đến chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Bạn có thể bao gồm các biến sau với kiểu Template Literal của JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Các biến:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Ngôn ngữ nguồn</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Ngôn ngữ đích</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tên đầy đủ của ngôn ngữ nguồn</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tên đầy đủ của ngôn ngữ đích</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Văn bản nguồn</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Tin nhắn được định nghĩa trước của thuật toán mã hóa.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Chuỗi đại diện cho dòng mới (Thay thế dòng).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Số lượng tin nhắn trong lô.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Thêm thông tin của các nhân vật.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu Chung]</code></li>"],["Body Message Template","Mẫu Tin Nhắn Thân"],["Template of the body of your chat.","Mẫu cho phần thân của cuộc trò chuyện của bạn."],["Sample conversation","Cuộc hội thoại mẫu"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API ChatGPT Batch cho phép bạn dịch dự án của mình không đồng bộ với chi phí thấp hơn 50%, nghĩa là bạn sẽ nhận được kết quả dịch <b style=\"color:red\">trong vòng 24 giờ</b> với <b style=\"color:red\">một nửa chi phí thông thường</b>. Điều này đặc biệt hữu ích cho các dự án lớn không yêu cầu kết quả dịch ngay lập tức."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Đọc thêm về API ChatGPT Batch: https://platform.openai.com/docs/guides/batch ."],["Glossary","Bảng Thuật Ngữ"],["<h2>Glossary</h2>","<h2>Bảng Thuật Ngữ</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>","<p>Bạn có thể sử dụng hoặc không sử dụng bảng thuật ngữ. Bảng thuật ngữ sẽ được tải cho mỗi mục lô để cải thiện chất lượng dịch.</p>"],["The Column of Actor's Additional Information","Cột Thông Tin Bổ Sung của Nhân Vật"],["Prompt Template","Mẫu Lời Nhắc"],["<h2>1. System Message</h2>","<h2>1. Tin Nhắn Hệ Thống</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Tại đây, bạn có thể giải thích cho trợ lý về vai trò của họ.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Hội thoại mẫu</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Cuộc hội thoại mẫu hiện có. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Lời nhắc thực tế của bạn</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Đây là lời nhắc thực tế gửi đến trợ lý.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Chi phí chung</h3>\n                        Chi phí chung là chi phí của tin nhắn nhắc mà bạn gửi đến trợ lý mà không có văn bản dịch thực tế. Chi phí được tính dựa trên số lượng token trong tin nhắn nhắc. Càng nhiều token, chi phí càng cao.<br>\n                        <b>Chi phí chung hiện tại:</b> <span class=\"overheadCost\">0</span> token / yêu cầu."]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":40,"length":40,"percent":100},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?","Máy chủ TinyRPA chưa được cài đặt. Bạn có muốn cài đặt ngay bây giờ không?"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization","Ghi nhớ bản dịch hữu cơ tự động"],["If checked, all organic translation (manually inputted translation) will be memorized automatically.","Nếu được chọn, tất cả bản dịch hữu cơ (bản dịch được nhập thủ công) sẽ được ghi nhớ tự động."],["Memorize translation by automation script","Ghi nhớ bản dịch bằng kịch bản tự động"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.","Nếu được chọn, Translator++ sẽ ghi nhớ bản dịch được tạo từ kịch bản tự động. \nTất cả thay đổi qua 'this.cells' sẽ được ghi nhớ. Nhưng có thể chúng tôi sửa đổi nội dung của lưới trực tiếp bằng API trans, những thay đổi đó sẽ không kích hoạt việc ghi nhớ tự động."],["Remind translation on cell translate","Nhắc bản dịch khi dịch ô"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.","Nếu được chọn, Translator++ sẽ tải bản dịch từ bộ nhớ dịch trước khi thực hiện dịch tự động trên ô được chọn."],["Default memorization behavior","Hành vi ghi nhớ mặc định"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.","Ghi đè bản ghi trước đó khi thực hiện dịch hữu cơ. Nếu không chọn, TM sẽ không ghi nhớ bản dịch mới cho bản ghi hiện có."],["MySQL host","Máy chủ MySQL"],["The host name or IP address of your MySQL server","Tên máy chủ hoặc địa chỉ IP của máy chủ MySQL của bạn"],["MySQL port","Cổng MySQL"],["MySQL Port. Default is 3306.","Cổng MySQL. Mặc định là 3306."],["MySQL user name","Tên người dùng MySQL"],["Username to access the DB.","Tên người dùng để truy cập cơ sở dữ liệu."],["MySQL password","Mật khẩu MySQL"],["Password to access the DB.","Mật khẩu để truy cập cơ sở dữ liệu."],["Database Name","Tên Cơ sở dữ liệu"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.","Tên cơ sở dữ liệu. Translator++ sẽ cố gắng tạo cơ sở dữ liệu nếu chưa tồn tại. Nhưng thành công phụ thuộc vào quyền hạn của thông tin đăng nhập được cung cấp."],["Database Type","Loại cơ sở dữ liệu"],["Automatically memorize manually inputted translations?","Tự động ghi nhớ các bản dịch được nhập thủ công?"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Xin lỗi, tiện ích này chỉ khả dụng cho những người bảo trợ đang hoạt động.\nBạn có thể mở khóa tính năng này bằng cách trở thành người bảo trợ $1."],["Automatically memorize translation made by automation scripts?","Tự động ghi nhớ bản dịch được tạo bởi các tập lệnh tự động?"],["Remind translations when performing translate selection?","Nhắc nhở bản dịch khi thực hiện dịch lựa chọn?"],["Use rememorize in organic translation","Sử dụng ghi nhớ lại trong dịch thuật hữu cơ"],["default","mặc định"],["Indexed DB (experimental)","Indexed DB (thử nghiệm)"],["MySQL","MySQL"],["Database Setting","Cài đặt cơ sở dữ liệu"],["IndexedDB","IndexedDB"],["Generate","Tạo"],["Escaping algorithm for inline code inside dialogues","Thuật toán thoát cho mã nội tuyến bên trong hội thoại"],["Test connection","Kiểm tra kết nối"],["Connection success!","Kết nối thành công!"],["MySql","MySql"],["Connection failed!\nError:","Kết nối thất bại!\nLỗi:"],["Install MySQL Server","Cài đặt MySQL Server"],["How to setup MySQL Server","Cách thiết lập MySQL Server"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?","Phát hiện nhiều bản dịch cho một câu khóa.\nChỉ bản dịch tìm thấy cuối cùng sẽ được ghi nhớ bởi Bộ nhớ Dịch.\nBạn có muốn tiếp tục?"],["Your database structure need to be updated.","Cấu trúc cơ sở dữ liệu của bạn cần được cập nhật."],["Upgrade database","Nâng cấp cơ sở dữ liệu"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?","Hành động này sẽ nâng cấp cơ sở dữ liệu của bạn.\nBạn có muốn nâng cấp cơ sở dữ liệu bộ nhớ dịch?"],["The translation memory database has been upgraded!\nPlease restart Translator++!","Cơ sở dữ liệu bộ nhớ dịch đã được nâng cấp!\nVui lòng khởi động lại Translator++!"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":42,"length":42,"percent":100},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory","Bộ nhớ"],["Fix the problem!","Sửa lỗi!"],["No exact matches found!","Không tìm thấy kết quả khớp chính xác!"],["Original","Nguyên bản"],["Translation","Bản dịch"],["Do you want Translator++ to forget the selected cell(s)?","Bạn có muốn Translator++ quên các ô đã chọn?"],["Auto recall","Tự động gợi nhớ"],["Auto memorize organic translation","Tự động ghi nhớ bản dịch hữu cơ"],["Auto memorize automation","Tự động ghi nhớ tự động hóa"],["Use rememorize in organic translation","Sử dụng ghi nhớ lại trong bản dịch hữu cơ"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["