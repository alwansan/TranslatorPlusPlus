ed TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","loại addonObj không hợp lệ"],["invalid type addonObj.addons","loại addonObj.addons không hợp lệ"],["You are not eligible to get this addon","Bạn không đủ điều kiện để nhận tiện ích này"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":false,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"relPath":"/js/addon.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Bạn nên lưu dự án hiện tại trước khi tạo lối tắt đến Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Tính năng này chỉ khả dụng nếu bạn đang sử dụng phiên bản Nhà phát triển của Translator++. Bạn có thể chuyển sang phiên bản Nhà phát triển bằng cách sử dụng Tiện ích cơ bản -> Thay đổi Core NWJS."]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/automationEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/find.js":{"data":[["Action","Hành động"],["Append tags","Thêm thẻ"],["Remove tags","Xóa thẻ"],["Set tags","Đặt thẻ"],["Do nothing","Không làm gì"],["Close","Đóng"],["Proceed","Tiến hành"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","Từ khóa quá ngắn!\nBạn đang cố tìm kiếm tất cả các hàng? Hãy thử dùng dấu sao '*' làm từ khóa."],["Found nothing!<br />Don't forget to set the Target search field.","Không tìm thấy gì!<br />Đừng quên đặt trường tìm kiếm Mục tiêu."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","Không tìm thấy gì để thay thế!<br />Chức năng thay thế không thay thế bất cứ thứ gì trên cột khóa."],["Replace '","Thay thế '"],["' with '","' bằng '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'?\r\nChúng tôi vẫn chưa tạo chức năng hoàn tác cho việc này!\nBạn có chắc muốn tiếp tục?"],["click to go","nhấn để đi"],["This will replace any translation found in target colum,\nAre you sure?","Điều này sẽ thay thế bất kỳ bản dịch nào tìm thấy trong cột mục tiêu,\nBạn có chắc không?"],["Keyword too short!","Từ khóa quá ngắn!"],["Not found!","Không tìm thấy!"],["Are you sure want to execute the following script?","Bạn có chắc muốn thực thi tập lệnh sau không?"],["For ","Cho "],[" selected item(s)?"," mục đã chọn?"],[" Select all"," Chọn tất cả"],[" Invert selection"," Đảo ngược lựa chọn"],[" Clear selection"," Xóa lựa chọn"],[" Set Red tag"," Đặt thẻ Đỏ"],[" Set Yellow tag"," Đặt thẻ Vàng"],[" Set Green tag"," Đặt thẻ Xanh lá"],[" Set Blue tag"," Đặt thẻ Xanh dương"],[" Set Gold tag"," Đặt thẻ Vàng kim"],[" More tags..."," Thêm thẻ..."],[" Clear tags"," Xóa thẻ"],[" Create Automation"," Tạo Tự động hóa"],[" Run Automation"," Chạy Tự động hóa"],[" Clear Automation"," Xóa Tự động hóa"],["Are you sure want to clear all quick launch scripts?","Bạn có chắc muốn xóa tất cả tập lệnh khởi chạy nhanh?"],[" Clear translation"," Xóa bản dịch"],["Do you want to clear translations of the selected items?","Bạn có muốn xóa bản dịch của các mục đã chọn?"],[" Delete rows"," Xóa hàng"],["Do you want to remove selected rows?\nYou can not undo this action!","Bạn có muốn xóa các hàng đã chọn?\nHành động này không thể hoàn tác!"],[" With selection ..."," Với lựa chọn ..."],["Always on top","Luôn ở trên cùng"],["Default","Mặc định"],["Blur opacity","Độ mờ làm mờ"],["Type regex with the modifier","Nhập biểu thức chính quy với bộ sửa đổi"],["Use $n to replace a group. e.g. $1","Sử dụng $n để thay thế một nhóm. Ví dụ: $1"],["Find","Tìm"],["Replace","Thay thế"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":false,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"relPath":"/js/find.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":46,"percent":100},"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","Ẩn mật khẩu"],["Show password","Hiện mật khẩu"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":false,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"relPath":"/js/jsonform.ext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","Một số cấu hình yêu cầu bạn khởi động lại ứng dụng để có hiệu lực.\nVui lòng lưu công việc của bạn và khởi động lại Translator++."],["Pleae select the name for your configuration.","Vui lòng chọn tên cho cấu hình của bạn."],["Translator Engine configuration","Cấu hình công cụ dịch"],["Translator engine version.","Phiên bản công cụ dịch."],["By.","Bởi."],["No option for this engine","Không có tùy chọn cho công cụ này"],["License","Giấy phép"],["Can not disable this addon","Không thể tắt tiện ích bổ sung này"],["Requirements","Yêu cầu"],["What is this?","Đây là gì?"],["Uninstall","Gỡ cài đặt"],["Update","Cập nhật"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","Tiện ích bổ sung đã được cài đặt thành công.\r\nTranslator++ có thể cần được khởi động lại để một số tiện ích bổ sung có hiệu lực."],["WARNING!\n","CẢNH BÁO!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","Tiện ích bổ sung này đã được đánh dấu là \"thay đổi trình phân tích\". Dự án cũ của bạn liên quan đến tiện ích bổ sung này có thể không hoạt động như mong đợi. Nên sao lưu dự án của bạn trước khi cài đặt tiện ích bổ sung này.\nBạn có thể nhập bản dịch hiện có vào dự án mới được tạo.\n\nBạn có muốn cài đặt "],["Do you want to install ","Bạn có muốn cài đặt "],["Add-on","Tiện ích bổ sung"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","đã được cài đặt thành công.\r\nTranslator++ có thể cần khởi động lại để một số tiện ích có hiệu lực."],["Add-on version.","Phiên bản tiện ích bổ sung."],["No option for this add-on","Không có tùy chọn cho tiện ích bổ sung này"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++ sẽ ghi vào registry của Windows.\r\nBạn có chắc chắn?"],["Error parsing patterns:","Lỗi phân tích mẫu:"],["Do you really want to clear the custom escaper?","Bạn thực sự muốn xóa trình thoát tùy chỉnh?"],["Do you really want to reset the custom escaper?","Bạn thực sự muốn đặt lại trình thoát tùy chỉnh?"],["You are currently on the latest version.\nDo you still want to update?","Bạn đang ở phiên bản mới nhất.\nBạn vẫn muốn cập nhật?"],["This option will open your default browser to login.\nDo you want to continue?","Tùy chọn này sẽ mở trình duyệt mặc định để đăng nhập.\nBạn có muốn tiếp tục?"],["Login with Browser","Đăng nhập bằng trình duyệt"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","Trình duyệt của bạn đã được mở đến <b>dreamsavior.net/gettoken/</b>.<br>Đăng nhập sẽ hoàn tất tự động khi bạn đăng nhập.<br><br>Nếu đăng nhập tự động không hoạt động, hãy sao chép mã token từ trang đó và dán vào bên dưới:"],["There is no default translator selected.\nChange the default translator to Google!","Không có trình dịch mặc định được chọn.\nThay đổi trình dịch mặc định thành Google!"],["Change Stagging Path to :","Thay đổi đường dẫn Stagging thành:"],["Move the content of current Stagging Path into the new one?","Di chuyển nội dung của đường dẫn Stagging hiện tại vào đường dẫn mới?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","Tiện ích bổ sung đã được cài đặt.\nTranslator++ cần khởi động lại để có hiệu lực."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","Bạn thực sự muốn xóa tất cả cài đặt và đặt lại Translator++ về mặc định?\nLưu ý rằng hành động này không thể hoàn tác.\nVui lòng sao lưu dự án của bạn trước khi tiếp tục."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","Translator++ có thể không hoạt động bình thường nếu bạn không sửa lỗi.\nBạn có muốn đóng cửa sổ tùy chọn?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":false,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"relPath":"/js/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Bạn nên lưu dự án hiện tại trước khi tạo lối tắt đến Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Tính năng này chỉ khả dụng nếu bạn đang sử dụng phiên bản Developer của Translator++. Bạn có thể chuyển sang phiên bản Developer bằng cách sử dụng Basic Utilities -> Change Core NWJS."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/scriptEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>Không thể chạy PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ cần PHP CLI để thực hiện một số thủ tục bắt buộc.<br />\n\t\t\t\tLỗi này thường xảy ra vì máy tính của bạn <b>chưa cài đặt <a href=\"http://dreamsavior.net/download/#TPPSysreq\">phiên bản Microsoft Visual C++ redistributable chính xác</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Vui lòng cài đặt <a href=\"http://dreamsavior.net/download/#TPPSysreq\">runtime cần thiết</a>.</li>\n\t\t\t\t\t\t<li>Và vui lòng di chuyển thư mục cài đặt Translator++ sang thư mục khác nếu bạn đã cài đặt tất cả runtime nhưng vẫn gặp lỗi này.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tVui lòng kiểm tra <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>tài liệu</a> để biết thêm thông tin về triệu chứng này."],["Initialization Error!","Lỗi Khởi tạo!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":false,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"relPath":"/js/sys.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/trans.js":{"data":[["Original Text","Văn bản Gốc"],["Initial","Ban đầu"],["Machine translation","Dịch máy"],["Better translation","Dịch tốt hơn"],["Best translation","Dịch tốt nhất"],["Loading","Đang tải"],["Error!","Lỗi!"],["Error processing init file : ","Lỗi xử lý tệp khởi tạo : "],["Error! File list not found in init file at : ","Lỗi! Danh sách tệp không tìm thấy trong tệp khởi tạo tại : "],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","Điều này có nghĩa là trò chơi của bạn chưa được phân tích thành công. Vui lòng truy cập https://dreamsavior.net/?p=1311 để tìm giải pháp khả thi cho vấn đề này."],["Done!","Hoàn tất!"],["All done!","Tất cả đã xong!"],["Error opening file : ","Lỗi mở tệp : "],["error opening file (open): ","lỗi mở tệp (open): "],["Project properties - Staging path error!","Thuộc tính Dự án - Lỗi đường dẫn Staging!"],["Project properties","Thuộc tính Dự án"],["untitled project","dự án không tên"],["create file list","tạo danh sách tệp"],["Finished","Hoàn tất"],[