"tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":3,"promptLibrary":4,"search":5,"downloadChat":6,"newChat":7,"api":8,"customEndpoint":9,"apiEndpoint.inputLabel":10,"apiKey.inputLabel":11,"apiVersion.inputLabel":12,"apiVersion.description":13,"securityMessage":14,"apiEndpoint.description":15,"apiEndpoint.warn":16,"partialImportMessages":17,"import":18,"name":19,"prompt":20,"clearPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Dịch bằng ChatGPT Batch API"],["Model","Mô hình"],["The pre-trained model.","Mô hình đã được huấn luyện trước."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Có vẻ như OpenAI Batch API sử dụng quy ước đặt tên mô hình hơi khác so với API thông thường. Các mô hình được sử dụng trong Batch API có tiền tố “-batch”. Ví dụ, nếu bạn sử dụng <code>gpt-4.1-mini</code>, mô hình sẽ tự động trở thành <code>gpt-4.1-mini-batch</code>.<br />\nTuy nhiên, tại thời điểm tiện ích này được tạo, các mô hình batch không được liệt kê trong giới hạn sử dụng mô hình của OpenAI, điều này khiến người dùng không thể sử dụng Batch API nếu họ đã đặt bộ lọc Sử dụng Mô hình thành “Cho phép” (danh sách trắng).<br />\nĐây có thể là lỗi trong giao diện OpenAI và có thể được sửa trong tương lai.<br />\nVì vậy, hãy đảm bảo đặt giới hạn sử dụng trong OpenAI ở chế độ “Chặn” (danh sách đen) để sử dụng Batch API.<br />\nNhấn vào đây để thay đổi giới hạn sử dụng mô hình: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Cột Nguồn"],["The column of the original texts you want to translate.","Cột của văn bản gốc mà bạn muốn dịch."],["Add actor name","Thêm tên nhân vật"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên nhân vật từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ xóa tên nhân vật khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Ignore if already translated","Bỏ qua nếu đã dịch"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Nếu tùy chọn này được chọn, Translator++ sẽ bỏ qua bất kỳ hàng nào đã có bản dịch trong cột của nó."],["Load Actor Reference as Glossary","Tải Tham chiếu Nhân vật làm Bảng Thuật ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu nhân vật làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu nhân vật là tên của nhân vật trong hội thoại. Nó sẽ được tải làm bảng thuật ngữ cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm bảng thuật ngữ cho mỗi mục batch. Sử dụng lệnh mẫu để tải tham chiếu nhân vật trong tin nhắn gợi ý."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Nhân vật"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột của bản dịch tên nhân vật. Cột này sẽ được sử dụng làm bản dịch của tham chiếu nhân vật. Điều này sẽ cải thiện tính nhất quán trong dịch tên nhân vật trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông Tin Diễn Viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung về diễn viên. Bạn có thể thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện việc dịch đại từ trong cuộc trò chuyện."],["System Message Template","Mẫu Tin Nhắn Hệ Thống"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Tin nhắn hệ thống là tiêu đề của tin nhắn sẽ cho biết vai trò của trợ lý chatGPT của bạn. Tin nhắn này sẽ được gửi như tin nhắn đầu tiên trong mỗi lô bạn gửi đến chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Bạn có thể bao gồm các biến sau với kiểu Template Literal của JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Biến:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Ngôn ngữ nguồn</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Ngôn ngữ đích</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tên đầy đủ của ngôn ngữ nguồn</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tên đầy đủ của ngôn ngữ đích</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Văn bản nguồn</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Tin nhắn được định nghĩa trước của thuật toán thoát.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Chuỗi đại diện cho dòng mới (Thay thế dòng).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Số lượng tin nhắn trong lô.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Thêm thông tin của các diễn viên.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham Chiếu Chung]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bao gồm một số dòng trước đó làm ngữ cảnh</li>"],["Body Message Template","Mẫu Tin Nhắn Nội Dung"],["Template of the body of your chat.","Mẫu nội dung chính của cuộc trò chuyện của bạn."],["Sample conversation","Mẫu hội thoại"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch của ChatGPT cho phép bạn dịch dự án của mình một cách không đồng bộ với chi phí thấp hơn 50%, nghĩa là bạn sẽ nhận được kết quả dịch <b style=\"color:red\">trong vòng 24 giờ</b> với <b style=\"color:red\">một nửa chi phí thông thường</b>. Điều này đặc biệt hữu ích cho các dự án lớn không yêu cầu kết quả dịch ngay lập tức."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Đọc thêm về API Batch của ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Cài đặt chung"],["This form is using your existing ChatGPT configuration.<br>","Biểu mẫu này đang sử dụng cấu hình ChatGPT hiện có của bạn.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Bạn có thể thay đổi cấu hình bằng cách vào cài đặt ChatGPT Translator trong cửa sổ tùy chọn.<br>"],["There you can set the API key, model, and other settings.<br />","Ở đó, bạn có thể đặt khóa API, mô hình và các cài đặt khác.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Mở cài đặt ChatGPT\" />"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Ignore translated rows","Bỏ qua các hàng đã dịch"],["Glossary","Bảng thuật ngữ"],["<h2>Glossary</h2>","<h2>Bảng thuật ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng bản dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông tin Bổ sung của Diễn viên"],["Prompt Template","Mẫu Lời nhắc"],["<h2>1. System Message</h2>","<h2>1. Tin nhắn Hệ thống</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Tại đây, bạn có thể giải thích cho trợ lý về vai trò của họ.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Mẫu hội thoại</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mẫu hội thoại hiện có. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Lời nhắc thực tế của bạn</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Đây là lời nhắc thực tế gửi đến trợ lý.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Chi phí cố định</h3>\n                        Chi phí cố định là chi phí của tin nhắn lời nhắc mà bạn gửi đến trợ lý mà không bao gồm văn bản dịch thực tế. Chi phí được tính dựa trên số lượng token trong tin nhắn lời nhắc. Càng nhiều token, chi phí sẽ càng cao.<br>\n                        <b>Chi phí cố định hiện tại:</b> <span class=\"overheadCost\">0</span> token / yêu cầu."],["Are you sure you want to reset the form?","Bạn có chắc chắn muốn đặt lại biểu mẫu không?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Bạn có chắc chắn muốn xử lý hàng loạt không?\nChi phí sẽ phát sinh cho thao tác này."],["The batch is successfully created. Do you want to open the batch manager?","Hàng loạt đã được tạo thành công. Bạn có muốn mở trình quản lý hàng loạt không?"],["OpenAI Batch API Queue","Hàng đợi API Hàng loạt OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transGeminiAi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Công cụ của trò chơi</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu Chung]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transGeminiAi/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Vui lòng chọn các hàng để áp dụng bản dịch"],["Target Column","Cột Đích"],["The column to put the translation result.","Cột để đặt kết quả dịch."],["Import translation from ChatGPT Batch","Nhập bản dịch từ Lô ChatGPT"],["Translation applied to selected rows","Áp dụng bản dịch cho các hàng đã chọn"],["Invalid format","Định dạng không hợp lệ"],["OK","OK"],["Mismatch","Không khớp"],["Failed to load batch list with error: \n","Không thể tải danh sách lô với lỗi: \n"],["Download Error File","Tải xuống Tệp Lỗi"],["Batch is not completed yet","Lô chưa hoàn thành"],["Are you sure you want to cancel this batch?","Bạn có chắc muốn hủy lô này không?"],["Cannot cancel completed batch.","Không thể hủy lô đã hoàn thành."],["Batch cancelled","Lô đã bị hủy"],["Failed to cancel batch","Không thể hủy lô"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","Các lô"],["Apply translation","Áp dụng bản dịch"],["Cancel batch","Hủy lô"],["Status","Trạng thái"],["Batch ID","ID Lô"],["Input File ID","ID Tệp Đầu vào"],["End point","Điểm cuối"],["Created at","Được tạo lúc"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Hết hạn lúc <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Các lô không hoàn thành đúng thời hạn cuối cùng sẽ chuyển sang trạng thái hết hạn; các yêu cầu chưa hoàn thành trong lô đó sẽ bị hủy, và bất kỳ phản hồi nào cho các yêu cầu đã hoàn thành sẽ được cung cấp qua tệp đầu ra của lô. Bạn sẽ bị tính phí cho các token tiêu thụ từ bất kỳ yêu cầu đã hoàn thành nào.\"></i>"],["Completed at","Hoàn thành lúc"],["Errors","Lỗi"],["Batch Item Detail of","Chi tiết Mục Hàng loạt của"],["ID","ID"],["Completed on","Hoàn thành vào"],["Model","Mô hình"],["Prompt Token","Token Đầu vào"],["Completion Token","Token Hoàn thành"],["Total Token","Tổng Token"],["Status Code","Mã Trạng thái"],["error","lỗi"],["Conversation","Cuộc trò chuyện"],["Response Validation","Xác thực Phản hồi"],["Raw Payload","Dữ liệu Thô"],["View raw payload","Xem dữ liệu thô"],["Response Preview","Xem trước Phản hồi"],["Apply translations from selected rows","Áp dụng bản dịch từ các hàng đã chọn"],["Here you can edit the translation result individually and send it into Translator++","Ở đây bạn có thể chỉnh sửa kết quả dịch từng cái một và gửi vào Translator++"],["Open ChatGPT Settings","Mở Cài đặt ChatGPT"],["Help","Trợ giúp"],["File list","Danh sách tệp"],["Collapse / restore left panel","Thu gọn / khôi phục bảng trái"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Các lô không hoàn thành đúng thời hạn cuối cùng sẽ chuyển sang trạng thái hết hạn; các yêu cầu chưa hoàn thành trong lô đó bị hủy, và mọi phản hồi cho các yêu cầu đã hoàn thành được cung cấp qua tệp đầu ra của lô. Bạn sẽ bị tính phí cho token tiêu thụ từ bất kỳ yêu cầu đã hoàn thành nào."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Công cụ của trò chơi</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Bảng thuật ngữ thông tin diễn viên. (Chỉ khi tùy chọn thông tin diễn viên được bật trong chế độ hàng loạt)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu Chung]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Ngữ cảnh của bản dịch trước đó (nếu ngữ cảnh được bật)</li>"],["Sample conversation","Cuộc trò chuyện mẫu"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Đừng lãng phí tiền vào Mô hình Lý luận</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Các nghiên cứu khác nhau đã chứng minh rằng mô hình lý luận kém xa so với mô hình thông thường trong việc thực hiện các tác vụ viết sáng tạo và dịch thuật.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Bạn không thu được gì ngoài chi phí đắt hơn và thời gian phản hồi chậm hơn khi sử dụng mô hình lý luận.</p>"],["<h2>Sample dialogue</h2>","<h2>Đối thoại mẫu</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mẫu hội thoại hiện có. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["Always separate file","Luôn tách tệp"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Luôn tách tệp cho mỗi lô. Điều này có thể giữ cho ngữ cảnh của từng tệp không bị trộn lẫn với các tệp khác."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên diễn viên từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ loại bỏ tên diễn viên khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Load Actor Reference as Glossary","Tải Tham chiếu Diễn viên làm Từ điển"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu diễn viên làm từ điển. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu diễn viên là tên của diễn viên trong hội thoại. Điều này sẽ được tải như một từ điển cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm từ điển cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu diễn viên trong thông báo nhắc."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Nếu bạn bật tùy chọn này, bạn cũng cần bao gồm biến <code>ACTOR_INFO</code> trong mẫu nhắc để đặt dữ liệu thông tin nhân vật."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Diễn viên"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch của tên diễn viên. Cột này sẽ được sử dụng làm bản dịch của tham chiếu diễn viên. Điều này sẽ cải thiện tính nhất quán của bản dịch tên diễn viên trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông tin Diễn viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung của diễn viên. Bạn có thể đặt thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện bản dịch của đại từ trong cuộc trò chuyện."],["Extra Prompt","Nhắc bổ sung"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Nhắc bổ sung sẽ được thêm vào thông báo nhắc. Điều này sẽ được thêm sau thông báo hệ thống và trước thông báo nhắc thực tế."],["General Settings","Cài đặt chung"],["Always separate file for each batch","Luôn tách tệp cho mỗi lô"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Glossary","Từ điển"],["<h2>Glossary</h2>","<h2>Từ điển</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm một bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi nhóm mục để cải thiện chất lượng bản dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông Tin Bổ Sung của Diễn Viên"],["Prompt","Lời nhắc"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"relPath":"/addons/transGeminiAi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>G</u>ửi"],["Toggle word wrap","Bật/tắt xuống dòng"],["Open debugger (F12)","Mở trình gỡ lỗi (F12)"],["Help","Trợ giúp"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Tính năng này chỉ khả dụng nếu bạn đang sử dụng phiên bản Nhà phát triển của Translator++. Bạn có thể chuyển sang phiên bản Nhà phát triển bằng cách sử dụng Tiện ích Cơ bản -> Thay đổi Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Bảng thuật ngữ thông tin diễn viên. (Chỉ khi tùy chọn thông tin diễn viên được bật trong chế độ hàng loạt)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham Chiếu Chung]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Ngữ cảnh của bản dịch trước đó (nếu ngữ cảnh được bật)</li>"],["Sample conversation","Mẫu hội thoại"],["<h2>Sample dialogue</h2>","<h2>Mẫu đối thoại</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mẫu hội thoại hiện có. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["Always separate file","Luôn tách riêng tệp"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Luôn tách riêng tệp cho mỗi nhóm. Điều này có thể giữ cho ngữ cảnh của mỗi tệp không bị lẫn lộn với các tệp khác."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên diễn viên từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi đối thoại và đại từ. Translator++ sau đó sẽ xóa tên diễn viên khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Load Actor Reference as Glossary","Tải Tham Chiếu Diễn Viên làm Bảng Thuật Ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu diễn viên làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu diễn viên là tên của diễn viên trong đối thoại. Nó sẽ được tải như một bảng thuật ngữ cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm bảng thuật ngữ cho mỗi mục nhóm. Sử dụng lệnh mẫu để tải tham chiếu diễn viên trong thông báo lời nhắc."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Nếu bạn bật tùy chọn này, bạn cũng cần bao gồm biến <code>ACTOR_INFO</code> trong mẫu lời nhắc để đặt dữ liệu thông tin nhân vật."],["Actor Reference Translation Column","Cột Dịch Tham Chiếu Diễn Viên"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch tên diễn viên. Cột này sẽ được dùng làm bản dịch cho tham chiếu diễn viên, giúp cải thiện tính nhất quán trong việc dịch tên diễn viên trong cuộc hội thoại."],["Actor's Information Column","Cột Thông Tin Diễn Viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung về diễn viên. Bạn có thể thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện việc dịch đại từ trong cuộc hội thoại."],["Extra Prompt","Lời Nhắc Bổ Sung"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Lời nhắc bổ sung sẽ được thêm vào tin nhắc lời nhắc. Nó sẽ được thêm sau tin nhắc hệ thống và trước tin nhắc lời nhắc thực tế."],["General Settings","Cài Đặt Chung"],["Always separate file for each batch","Luôn tách file cho mỗi lô"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Glossary","Bảng Thuật Ngữ"],["<h2>Glossary</h2>","<h2>Bảng Thuật Ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng bản dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông Tin Bổ Sung của Diễn Viên"],["Prompt","Lời Nhắc"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transGeminiAi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","Trò Chuyện với ChatGPT API"],["Batch Manager","Trình Quản Lý Lô"],["This feature is only available if you have a project open.","Tính năng này chỉ khả dụng nếu bạn đã mở một dự án."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transGeminiAi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","Hành động này sẽ mở một cửa sổ trình duyệt. Hãy đảm bảo trình duyệt mặc định của bạn được đặt là Chrome. Bạn có muốn tiếp tục không?"],["Gemini Nano server is already running. Do you want to restart it?","Máy chủ Gemini Nano đang chạy. Bạn có muốn khởi động lại nó không?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","Hành động này sẽ mở một cửa sổ trình duyệt. Hãy đảm bảo trình duyệt mặc định của bạn được đặt là Chrome. Và Máy chủ Gemini Nano đã khởi động. Bạn có muốn tiếp tục không?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":false,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"relPath":"/addons/transGeminiNano/geminiNanoUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Bảng thuật ngữ thông tin diễn viên. (Chỉ nếu tùy chọn thông tin diễn viên được bật trong chế độ lô)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ: <code>REFERENCE[Tham chiếu Chung]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Ngữ cảnh của bản dịch trước (nếu ngữ cảnh được bật)</li>"],["Always separate file","Luôn tách tệp"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Luôn tách tệp cho mỗi lô. Điều này có thể giữ cho ngữ cảnh của mỗi tệp không bị nhiễm với các tệp khác."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên diễn viên từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ xóa tên diễn viên khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Load Actor Reference as Glossary","Tải Tham chiếu Diễn viên làm Thuật ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu diễn viên làm thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu diễn viên là tên của diễn viên trong đoạn hội thoại. Nó sẽ được tải làm thuật ngữ cho người dịch. Điều này sẽ tăng chi phí dịch thuật."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm thuật ngữ cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu diễn viên trong tin nhắn gợi ý."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Nếu bạn bật tùy chọn này, bạn cũng cần bao gồm biến <code>ACTOR_INFO</code> trong mẫu gợi ý để đặt dữ liệu thông tin nhân vật."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Diễn viên"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch tên diễn viên. Cột này sẽ được sử dụng làm bản dịch cho tham chiếu diễn viên. Điều này sẽ cải thiện tính nhất quán trong việc dịch tên diễn viên trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông tin Diễn viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung về diễn viên. Bạn có thể thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện việc dịch đại từ trong cuộc trò chuyện."],["General Settings","Cài đặt Chung"],["Always separate file for each batch","Luôn tách tệp riêng cho mỗi lô"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Glossary","Thuật ngữ"],["<h2>Glossary</h2>","<h2>Thuật ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm thuật ngữ vào gợi ý. Thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng dịch thuật. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to gợi ý của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông tin Bổ sung của Diễn viên"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"relPath":"/addons/transKoboldAI/Llama3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":24,"length":24,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","Tên Dịch vụ"],["Service provider for your Batch API.","Nhà cung cấp dịch vụ cho Batch API của bạn."],["Your API Key","Khóa API của Bạn"],["Please enter your API key for the Batch API service.","Vui lòng nhập khóa API của bạn cho dịch vụ Batch API."],["Model","Mô hình"],["The model for your translation.","Mô hình cho bản dịch của bạn."],["Source Column","Cột Nguồn"],["The column of the original texts you want to translate.","Cột chứa văn bản gốc mà bạn muốn dịch."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên diễn viên từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ loại bỏ tên diễn viên khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Ignore if already translated","Bỏ qua nếu đã dịch"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Nếu tùy chọn này được chọn, Translator++ sẽ bỏ qua bất kỳ hàng nào đã có bản dịch trong cột của nó."],["Filter Tag","Thẻ Lọc"],["If set, only rows with this tag will be translated.","Nếu được đặt, chỉ các hàng có thẻ này mới được dịch."],["Load Actor Reference as Glossary","Tải Tham chiếu Diễn viên làm Bảng Thuật ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu diễn viên làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu diễn viên là tên của diễn viên trong hội thoại. Nó sẽ được tải như một bảng thuật ngữ cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm bảng thuật ngữ cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu diễn viên trong thông báo nhắc."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Diễn viên"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch của tên diễn viên. Cột này sẽ được sử dụng làm bản dịch của tham chiếu diễn viên. Điều này sẽ cải thiện tính nhất quán trong việc dịch tên diễn viên trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông tin Diễn viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung về diễn viên. Bạn có thể đặt thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện việc dịch đại từ trong cuộc trò chuyện."],["Enable Context","Bật Ngữ cảnh"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Bật ngữ cảnh cho bản dịch. Tài liệu đã dịch trước đó phía trên lô hiện tại sẽ được bao gồm như một ngữ cảnh. <b>Bạn cũng cần bao gồm rõ ràng NGỮ CẢNH vào mẫu</b>"],["Context Character Limit","Giới hạn Ký tự Ngữ cảnh"],["Character limit for the context.","Giới hạn ký tự cho ngữ cảnh."],["System Message Template","Mẫu Tin nhắn Hệ thống"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Tin nhắn hệ thống là tiêu đề của tin nhắn sẽ cho biết vai trò của trợ lý chatGPT của bạn. Tin nhắn này sẽ được gửi như tin nhắn đầu tiên trong mỗi lô bạn gửi đến chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Bạn có thể bao gồm các biến sau với phong cách Template Literal của JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Biến:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Ngôn ngữ nguồn</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Ngôn ngữ đích</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tên đầy đủ của ngôn ngữ nguồn</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tên đầy đủ của ngôn ngữ đích</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Văn bản nguồn</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Tin nhắn được định nghĩa trước của thuật toán thoát.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Chuỗi đại diện cho dòng mới (Thay thế dòng).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Số lượng tin nhắn trong lô.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Thêm thông tin của các diễn viên.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu Chung]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bao gồm một số dòng trước đó như ngữ cảnh</li>"],["Body Message Template","Mẫu Tin nhắn Thân"],["Template of the body of your chat.","Mẫu của phần thân cuộc trò chuyện của bạn."],["Sample conversation","Mẫu hội thoại"],["User message","Tin nhắn người dùng"],["Assistant's response","Phản hồi của trợ lý"],["Enable JailBreak","Bật JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Bật Jailbreak cho bản dịch. Điều này sẽ làm cho bản dịch chính xác hơn và ít thiên vị hơn. Một số mô hình có thể muốn liên hệ sự kiện hư cấu với sự kiện thực tế, do đó chúng sẽ cố gắng thay đổi bản dịch để phù hợp với câu chuyện riêng của chúng. Tùy chọn này sẽ ngăn chặn điều đó."],["Jailbreak Template","Mẫu Jailbreak"],["Template of the Jailbreak message.","Mẫu của tin nhắn Jailbreak."],["Maximum Tokens","Số Token Tối Đa"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Số lượng token tối đa để tạo ra trong phần hoàn thành.<br>Số token của lời nhắc của bạn cộng với max_tokens không được vượt quá độ dài ngữ cảnh của mô hình. Hầu hết các mô hình có độ dài ngữ cảnh là 2048 token (ngoại trừ các mô hình mới nhất, hỗ trợ 4096)."],["Temperature","Nhiệt độ"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Nhiệt độ lấy mẫu sử dụng, từ 0 đến 2. Giá trị cao hơn như 0.8 sẽ làm cho đầu ra ngẫu nhiên hơn, trong khi giá trị thấp hơn như 0.2 sẽ làm cho nó tập trung và xác định hơn. <br>OpenAI thường khuyến nghị thay đổi cái này hoặc top_p nhưng không phải cả hai."],["Nucleus sampling (top_p)","Lấy mẫu hạt nhân (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Một phương pháp thay thế cho lấy mẫu với nhiệt độ, gọi là lấy mẫu hạt nhân, nơi mô hình xem xét kết quả của các token với khối lượng xác suất top_p. Vì vậy 0.1 có nghĩa là chỉ các token chiếm 10% khối lượng xác suất hàng đầu được xem xét. <br>OpenAI thường khuyến nghị thay đổi cái này hoặc nhiệt độ nhưng không phải cả hai."],["Frequency Penalty","Hình phạt Tần suất"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Số từ -2.0 đến 2.0. Giá trị dương phạt các token mới dựa trên tần suất hiện có của chúng trong văn bản cho đến nay, giảm khả năng mô hình lặp lại cùng một dòng nguyên văn. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Hình phạt Hiện diện"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Số từ -2.0 đến 2.0. Giá trị dương phạt các token mới dựa trên việc chúng có xuất hiện trong văn bản cho đến nay hay không, tăng khả năng mô hình nói về các chủ đề mới. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","Tham số Tùy chỉnh"],["Key","Khóa"],["Value","Giá trị"],["Type","Loại"],["Type of the value.","Loại giá trị."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Đối với loại <b>javascript</b>, giá trị sẽ được đánh giá như mã JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Phạm vi của mã javascript là <code>window</code>. Vì vậy bạn có thể truy cập hầu hết mọi giá trị."],["Example: <code>trans.project.title</code>","Ví dụ: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Bỏ các tham số sẽ không được gửi đến API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI liên tục thay đổi, một số mô hình mới có thể không hỗ trợ các tham số cũ và sẽ trả về lỗi HTTP cho tham số yêu cầu không được nhận dạng."],["You can drop the parameters that are not supported by the model here.","Bạn có thể bỏ các tham số không được mô hình hỗ trợ ở đây."],["Batch API settings","Cài đặt API Batch"],["General","Chung"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch của OpenAI cho phép bạn dịch dự án của mình không đồng bộ với chi phí thấp hơn 50%, nghĩa là bạn sẽ nhận được kết quả dịch <b style=\"color:red\">trong vòng 24 giờ</b> với <b style=\"color:blue\">một nửa chi phí thông thường</b>. Điều này đặc biệt hữu ích cho các dự án lớn không yêu cầu kết quả dịch ngay lập tức."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Đọc thêm về API Batch <a href=\"https://platform.openai.com/docs/guides/batch\" external>tại đây</a>.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />Dịch vụ được hỗ trợ: <b>OpenAI</b> và <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>Các cấu hình khác được tìm thấy trong Cài đặt Tiện ích</h2>"],["Open Add-on Settings","Mở Cài đặt Tiện ích"],["Import Configuration from OpenAI Setting","Nhập Cấu hình từ Cài đặt OpenAI"],["General Settings","Cài đặt Chung"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Đừng lãng phí tiền vào Mô hình Lý luận</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Các nghiên cứu khác nhau đã chứng minh rằng mô hình lý luận kém xa so với các mô hình thông thường trong việc thực hiện các tác vụ viết sáng tạo và dịch thuật.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Bạn không nhận được gì ngoài chi phí đắt hơn và thời gian phản hồi chậm hơn khi sử dụng mô hình lý luận.</p>"],["<h2>If you're using OpenAI</h2>","<h2>Nếu bạn đang sử dụng OpenAI</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","OpenAI Batch API sử dụng một quy ước đặt tên mô hình hơi khác so với API tiêu chuẩn. Các mô hình trong Chế độ Batch bao gồm hậu tố -batch. Ví dụ, nếu bạn chỉ định <code>gpt-4.1-mini</code>, nó sẽ tự động được hiểu là <code>gpt-4.1-mini-batch</code>.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","Tuy nhiên, tại thời điểm tiện ích này được phát triển, các mô hình batch chưa được liệt kê dưới giới hạn sử dụng mô hình của OpenAI. Điều này có nghĩa là người dùng đã đặt bộ lọc Sử dụng Mô hình thành \"Cho phép\" (danh sách trắng) sẽ không thể truy cập Batch API.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","Nhấp <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>vào đây</a> để thay đổi giới hạn sử dụng mô hình."],["Explore more models","Khám phá thêm các mô hình"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Ignore translated rows","Bỏ qua các hàng đã dịch"],["Templates","Mẫu"],["<h2>1. System Message</h2>","<h2>1. Thông báo Hệ thống</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Tại đây, bạn có thể giải thích cho trợ lý về vai trò của họ.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Đối thoại mẫu</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Đối thoại mẫu hiện có. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Lời nhắc thực tế của bạn</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Đây là lời nhắc thực tế gửi đến trợ lý.</p>"],["Enable Jailbreak","Bẻ khóa"],["Glossary","Bảng thuật ngữ"],["<h2>Glossary</h2>","<h2>Bảng thuật ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng bản dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông tin Bổ sung của Diễn viên"],["Enable context","Bật ngữ cảnh"],["Advanced","Nâng cao"],["Custom Parameters","Tham số Tùy chỉnh"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Bạn có thể thêm tham số tùy chỉnh vào phần thân yêu cầu API Chat của OpenAI. Điều này hữu ích nếu bạn muốn thêm các tham số bổ sung không có sẵn trong biểu mẫu."],["<h2>Warning</h2>","<h2>Cảnh báo</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Thiết lập tham số tùy chỉnh không chính xác có thể khiến yêu cầu API thất bại. Hãy chắc chắn bạn biết mình đang làm gì trước khi thêm tham số tùy chỉnh. Một số dịch vụ như OpenAI rất nghiêm ngặt về các tham số bạn gửi, và chúng sẽ trả về lỗi HTTP cho tham số yêu cầu không được nhận dạng.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Nếu cùng một khóa được sử dụng nhiều lần, chỉ giá trị cuối cùng sẽ được dùng.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Nếu sử dụng cùng một khóa trong cấu hình hiện có, thì tham số cấu hình hiện tại sẽ bị ghi đè bởi tham số tùy chỉnh.</li>"],["String","Chuỗi"],["Number","Số"],["Boolean","Boolean"],["JavaScript","JavaScript"],["Drop Parameters","Bỏ Tham số"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Chi phí phụ trội</h3>\n                        Chi phí phụ trội là chi phí của tin nhắn nhắc mà bạn gửi đến trợ lý mà không có văn bản dịch thực tế. Chi phí được tính dựa trên số lượng token trong tin nhắn nhắc. Càng nhiều token bạn có, chi phí sẽ càng cao.<br>\n                        <b>Chi phí phụ trội ước tính:</b> <span class=\"overheadCost\">0</span> token / yêu cầu."],["Are you sure you want to reset the form?","Bạn có chắc muốn đặt lại biểu mẫu không?"],["Translate with Batch API","Dịch với API Hàng loạt"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Bạn có chắc muốn xử lý hàng loạt không?\nChi phí sẽ phát sinh cho thao tác này."],["The batch is successfully created. Do you want to open the batch manager?","Hàng loạt đã được tạo thành công. Bạn có muốn mở trình quản lý hàng loạt không?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","Bạn có chắc muốn nhập cấu hình từ cài đặt OpenAI? Điều này sẽ ghi đè cấu hình hiện tại."],["chatGPT engine is not found","Không tìm thấy engine chatGPT"],["Configuration imported successfully.","Nhập cấu hình thành công."],["Batch API Queue","Hàng đợi API Hàng loạt"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"relPath":"/addons/transLLMBatchApi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":125,"length":125,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Vui lòng chọn các hàng để áp dụng bản dịch"],["Target Column","Cột Mục tiêu"],["The column to put the translation result.","Cột để đặt kết quả dịch."],["Import translation from ChatGPT Batch","Nhập bản dịch từ Lô ChatGPT"],["Translation applied to selected rows","Bản dịch đã áp dụng cho các hàng đã chọn"],["Invalid format","Định dạng không hợp lệ"],["OK","OK"],["Mismatch","Không khớp"],["Failed to load batch list with error: \n","Không thể tải danh sách lô với lỗi: \n"],["Download Error File","Tải xuống tệp lỗi"],["Batch is not completed yet","Lô chưa hoàn thành"],["Are you sure you want to cancel this batch?","Bạn có chắc muốn hủy lô này không?"],["Cannot cancel completed batch.","Không thể hủy lô đã hoàn thành."],["Batch cancelled","Lô đã hủy"],["Failed to cancel batch","Không thể hủy lô"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","Các lô"],["Apply translation","Áp dụng bản dịch"],["Cancel batch","Hủy lô"],["Status","Trạng thái"],["Batch ID","ID Lô"],["Input File ID","ID Tệp Đầu vào"],["End point","Điểm cuối"],["Created at","Tạo lúc"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Hết hạn lúc <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Các lô không hoàn thành đúng thời gian cuối cùng sẽ chuyển sang trạng thái hết hạn; các yêu cầu chưa hoàn thành trong lô đó bị hủy, và mọi phản hồi cho các yêu cầu đã hoàn thành được cung cấp qua tệp đầu ra của lô. Bạn sẽ bị tính phí cho token tiêu thụ từ bất kỳ yêu cầu đã hoàn thành nào.\"></i>"],["Completed at","Hoàn thành lúc"],["Errors","Lỗi"],["Batch Item Detail of","Chi tiết Mục Lô của"],["ID","ID"],["Completed on","Hoàn thành vào"],["Model","Mô hình"],["Prompt Token","Token Nhắc nhở"],["Completion Token","Token Hoàn thành"],["Total Token","Tổng Token"],["Status Code","Mã Trạng thái"],["error","lỗi"],["Conversation","Cuộc hội thoại"],["Response Validation","Xác thực Phản hồi"],["Raw Payload","Tải trọng Thô"],["View raw payload","Xem tải trọng thô"],["Response Preview","Xem trước Phản hồi"],["Apply translations from selected rows","Áp dụng bản dịch từ các hàng đã chọn"],["Here you can edit the translation result individually and send it into Translator++","Ở đây bạn có thể chỉnh sửa kết quả dịch riêng lẻ và gửi nó vào Translator++"],["Open ChatGPT Settings","Mở Cài đặt ChatGPT"],["Help","Trợ giúp"],["File list","Danh sách Tệp"],["Collapse / restore left panel","Thu gọn / Khôi phục bảng trái"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Các lô không hoàn thành đúng thời gian cuối cùng sẽ chuyển sang trạng thái hết hạn; các yêu cầu chưa hoàn thành trong lô đó bị hủy, và bất kỳ phản hồi nào cho các yêu cầu đã hoàn thành sẽ được cung cấp qua tệp đầu ra của lô. Bạn sẽ bị tính phí cho các token tiêu thụ từ bất kỳ yêu cầu đã hoàn thành nào."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","Tên Dịch vụ"],["Service provider for your Batch API.","Nhà cung cấp dịch vụ cho Batch API của bạn."],["API Key","Khóa API"],["Please enter your API key for the Batch API service.","Vui lòng nhập khóa API cho dịch vụ Batch API."],["Model","Mô hình"],["The pre-trained model","Mô hình được huấn luyện trước"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","Trong ChatGPT, bạn có thể cần đặt mô hình được phép sử dụng (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","Bật JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Bật Jailbreak cho bản dịch. Điều này sẽ làm cho bản dịch chính xác hơn và ít thiên vị hơn. Một số mô hình có thể muốn liên kết sự kiện hư cấu với sự kiện thực tế, do đó chúng sẽ cố gắng thay đổi bản dịch để phù hợp với câu chuyện riêng của chúng. Tùy chọn này sẽ ngăn chặn điều đó."],["Jailbreak Template","Mẫu Jailbreak"],["Template of the Jailbreak message.","Mẫu của tin nhắn Jailbreak."],["Maximum Tokens","Số Token Tối đa"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Số lượng token tối đa để tạo trong phần hoàn thành.<br>Tổng số token của lời nhắc của bạn cộng với max_tokens không thể vượt quá độ dài ngữ cảnh của mô hình. Hầu hết các mô hình có độ dài ngữ cảnh là 2048 token (ngoại trừ các mô hình mới nhất, hỗ trợ 4096)."],["Temperature","Nhiệt độ"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Nhiệt độ lấy mẫu nào để sử dụng, từ 0 đến 2. Giá trị cao hơn như 0.8 sẽ làm cho đầu ra ngẫu nhiên hơn, trong khi giá trị thấp hơn như 0.2 sẽ làm cho nó tập trung và xác định hơn. <br>OpenAI thường khuyên nên thay đổi tham số này hoặc top_p nhưng không phải cả hai."],["Nucleus sampling (top_p)","Lấy mẫu hạt nhân (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Một phương pháp thay thế cho lấy mẫu với nhiệt độ, gọi là lấy mẫu hạt nhân, trong đó mô hình xem xét kết quả của các token với khối lượng xác suất top_p. Vì vậy, 0.1 có nghĩa là chỉ các token chiếm 10% xác suất hàng đầu được xem xét. <br>OpenAI thường khuyên nên thay đổi tham số này hoặc nhiệt độ nhưng không phải cả hai."],["Frequency Penalty","Hình phạt Tần suất"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Số từ -2.0 đến 2.0. Giá trị dương phạt các token mới dựa trên tần suất hiện có của chúng trong văn bản cho đến nay, giảm khả năng mô hình lặp lại cùng một dòng nguyên văn. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Hình phạt Hiện diện"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Số từ -2.0 đến 2.0. Giá trị dương phạt các token mới dựa trên việc chúng xuất hiện trong văn bản hiện tại, tăng khả năng mô hình nói về chủ đề mới. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","Số Ký tự Tối đa Mỗi Lô"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Giới hạn ký tự tối đa cho mỗi lô dịch.\nTùy chọn này chỉ đếm độ dài ký tự của văn bản gốc, không tính độ dài ký tự của tin nhắn nhắc."],["Max row per concurrent requests","Số Dòng Tối đa Mỗi Yêu cầu Đồng thời"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Số dòng được phép cho mỗi yêu cầu đồng thời. Đặt thành <b>0</b> để tắt tính năng này.<br />Nếu tùy chọn này bị tắt, thì dù bạn đặt <b>Số yêu cầu đồng thời tối đa</b> bao nhiêu, Translator++ cũng sẽ xử lý yêu cầu như một khối duy nhất.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Bạn đặt càng nhiều dòng, bạn càng nhận được nhiều bản dịch trong một lô. Do đó giảm chi phí phụ trội và tăng khả năng AI trả về kết quả lỗi.<br />Số càng thấp, khả năng dịch bị lỗi càng ít nhưng sẽ tốn thêm chi phí cho các nhắc nhở phụ trội."],["Code Escaping Algorithm","Thuật toán Mã Hóa Mã"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Thuật toán mã hóa cho mã nội tuyến bên trong hội thoại. Bạn có thể cần thay đổi <b>Mẫu Tin nhắn Hệ thống</b> và <b>Mẫu Tin nhắn Thân</b> theo thuật toán mã hóa bạn chọn.<br />Khi chọn <b>JSONCloaking</b>, tham số response_format: { type: 'json_object' } sẽ được gửi tự động đến ChatGPT. <b>JSONCloaking</b> rất chính xác, nhưng không hoạt động với tất cả mô hình, hãy thử <b>gpt-3.5-turbo-1106</b>."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>API Lô</b> cho phép bạn gửi nhiều yêu cầu cùng lúc, được xử lý không đồng bộ trong nền. Bạn sẽ không nhận kết quả ngay lập tức, nhưng quá trình <b>sẽ hoàn thành trong vòng 24 giờ</b>—và thường nhanh hơn nhiều. Phương pháp này <b>chỉ tốn một nửa chi phí so với cách tiếp cận tiêu chuẩn</b>."],["Batch API settings","Cài đặt API Lô"],["General","Chung"],["Explore more models","Khám phá thêm mô hình"],["Templates","Mẫu"],["Enable Jailbreak","Bật Jailbreak"],["Advanced","Nâng cao"],["Batch Translation Setting","Cài đặt Dịch Lô"],["Default","Mặc định"],["JavaScript template cloaking","Mẫu che giấu JavaScript"],["None (no escaping)","Không (không mã hóa)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"relPath":"/addons/transLLMBatchApi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":39,"length":39,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÊN : Tên của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Bảng thuật ngữ thông tin diễn viên. (Chỉ nếu tùy chọn thông tin diễn viên được bật trong chế độ hàng loạt)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu Chung]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Ngữ cảnh của bản dịch trước đó (nếu ngữ cảnh được bật)</li>"],["Sample conversation","Cuộc hội thoại mẫu"],["<h2>Sample dialogue</h2>","<h2>Đoạn hội thoại mẫu</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Đoạn hội thoại hiện có mẫu. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc hội thoại.</p>"],["Always separate file","Luôn tách file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Luôn tách file cho mỗi lô. Điều này có thể giữ ngữ cảnh của mỗi file không bị nhiễu bởi các file khác."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên diễn viên từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi đoạn hội thoại và đại từ. Translator++ sau đó sẽ loại bỏ tên diễn viên khỏi kết quả dịch. Điều này rõ ràng sẽ tăng chi phí dịch."],["Load Actor Reference as Glossary","Tải Tham chiếu Diễn viên làm Bảng thuật ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu diễn viên làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc hội thoại. Tham chiếu diễn viên là tên của diễn viên trong đoạn hội thoại. Điều này sẽ được tải như một bảng thuật ngữ cho người dịch. Điều này sẽ tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc hội thoại sẽ được tải làm bảng thuật ngữ cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu diễn viên trong tin nhắn nhắc."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Nếu bạn bật tùy chọn này, bạn cũng cần bao gồm biến <code>ACTOR_INFO</code> trong mẫu nhắc để đặt dữ liệu thông tin nhân vật."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Diễn viên"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột của bản dịch tên diễn viên. Cột này sẽ được sử dụng làm bản dịch của tham chiếu diễn viên. Điều này sẽ cải thiện tính nhất quán của bản dịch tên diễn viên trong cuộc hội thoại."],["Actor's Information Column","Cột Thông tin Diễn viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung của diễn viên. Bạn có thể đặt thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện bản dịch của đại từ trong cuộc hội thoại."],["Extra Prompt","Nhắc bổ sung"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Lời nhắc bổ sung sẽ được thêm vào thông điệp lời nhắc. Điều này sẽ được thêm sau thông điệp hệ thống và trước thông điệp lời nhắc thực tế."],["General Settings","Cài đặt chung"],["Always separate file for each batch","Luôn tách tệp cho mỗi lô"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Glossary","Bảng thuật ngữ"],["<h2>Glossary</h2>","<h2>Bảng thuật ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng bản dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông tin Bổ sung của Diễn viên"],["Prompt","Lời nhắc"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transLLMBatchApi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","Mở Trình quản lý Lô"],["This feature is only available if you have a project open.","Tính năng này chỉ khả dụng nếu bạn đã mở một dự án."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":false,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transLLMBatchApi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","URL proxy của LiteLLM. Địa chỉ URL của proxy LiteLLM của bạn. Mặc định là: <code>http://localhost:8890/chat/completions</code>"],["API's base URL","URL Cơ sở của API"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","URL cơ sở của dịch vụ bạn đã chọn. Chỉ điền trường này nếu bạn đang sử dụng URL điểm cuối tùy chỉnh. LiteLLM sẽ tự động phát hiện URL cơ sở dựa trên mô hình đã cho.<br />Cách LiteLLM thêm đường dẫn vào URL phụ thuộc vào dịch vụ. Ví dụ, đối với các điểm cuối tương thích OpenAI, LiteLLM sẽ nối thêm <code>/chat/completions</code> vào URL đã cho. Vì vậy, nếu điểm cuối của bạn là <code>https://api.fast-tunnel.one/v1/chat/completions</code>, hãy điền trường này với <code>https://api.fast-tunnel.one/v1</code>."],["API Version","Phiên bản API"],["Optional. The API version parameter needed for some services.","Tùy chọn. Tham số phiên bản API cần thiết cho một số dịch vụ."],["API Key","Khóa API"],["Optional. The API key used for authenticating your access to the service.","Tùy chọn. Khóa API được sử dụng để xác thực quyền truy cập của bạn vào dịch vụ."],["Model","Mô hình"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","Huấn luyện trước mô hình bạn chọn. Sử dụng định dạng tiện lợi mô hình LiteLLM để chỉ định mô hình ưa thích của bạn. Định dạng là {tên dịch vụ}/{mô hình}. Ví dụ:"],["your deployment name","tên triển khai của bạn"],["However, some models have unique names that can be directly identified, like:","Tuy nhiên, một số mô hình có tên duy nhất có thể được xác định trực tiếp, như:"],["Azure AD Token","Token Azure AD"],["AWS Access Key ID","ID Khóa Truy cập AWS"],["AWS secret access key","Khóa truy cập bí mật AWS"],["Open router site URL","URL trang web Open router"],["Open router APP name","Tên ứng dụng Open router"],["Enable Context","Bật Ngữ cảnh"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Bật ngữ cảnh cho bản dịch. Tài liệu đã dịch trước đó phía trên lô hiện tại sẽ được bao gồm như một ngữ cảnh. <b>Bạn cũng cần bao gồm rõ ràng NGỮ CẢNH vào mẫu</b>"],["Context Character Limit","Giới hạn Ký tự Ngữ cảnh"],["Character limit for the context.","Giới hạn ký tự cho ngữ cảnh."],["System Message Template","Mẫu Tin nhắn Hệ thống"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Tin nhắn hệ thống là tiêu đề của tin nhắn sẽ cho biết vai trò của trợ lý chatGPT của bạn. Tin nhắn này sẽ được gửi như tin nhắn đầu tiên của mỗi lô bạn gửi đến chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Bạn có thể bao gồm các biến sau với phong cách Template Literal của JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Biến số:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Ngôn ngữ nguồn</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Ngôn ngữ đích</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Văn bản nguồn</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Thông báo định sẵn của thuật toán thoát.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Chuỗi đại diện cho dòng mới (Thay thế dòng).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Số lượng tin nhắn trong lô.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Từ điển thông tin diễn viên. (Chỉ khi tùy chọn thông tin diễn viên được bật trong chế độ lô)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu chung]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Ngữ cảnh của bản dịch trước đó (nếu ngữ cảnh được bật)</li>"],["Sample conversation","Mẫu hội thoại"],["User message","Tin nhắn người dùng"],["Assistant's response","Phản hồi của trợ lý"],["Body Message Template","Mẫu Thông điệp Nội dung"],["Template of the body of your message.","Mẫu của nội dung thông điệp của bạn."],["Enable JailBreak","Bật JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Bật Jailbreak cho bản dịch. Điều này sẽ làm cho bản dịch chính xác hơn và ít thiên vị hơn. Một số mô hình có thể muốn liên kết sự kiện hư cấu với sự kiện thực tế, do đó chúng sẽ cố gắng thay đổi bản dịch để phù hợp với câu chuyện riêng của chúng. Tùy chọn này sẽ ngăn chặn điều đó."],["Jailbreak Template","Mẫu Jailbreak"],["Template of the Jailbreak message.","Mẫu của tin nhắn Jailbreak."],["Maximum Tokens","Số Token Tối Đa"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","Số lượng token tối đa để tạo trong phần hoàn thành.<br>Số token của lời nhắc cộng với max_tokens không được vượt quá độ dài ngữ cảnh của mô hình. Hầu hết các mô hình có độ dài ngữ cảnh là 2048 token (ngoại trừ các mô hình mới nhất, hỗ trợ 4096)."],["Temperature","Nhiệt Độ"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Nhiệt độ lấy mẫu sử dụng, từ 0 đến 2. Giá trị cao hơn như 0.8 sẽ làm đầu ra ngẫu nhiên hơn, trong khi giá trị thấp hơn như 0.2 sẽ làm nó tập trung và xác định hơn. <br>OpenAI thường khuyên thay đổi thông số này hoặc top_p nhưng không phải cả hai."],["Nucleus sampling (top_p)","Lấy mẫu hạt nhân (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Một phương án thay thế cho lấy mẫu với nhiệt độ, gọi là lấy mẫu hạt nhân, nơi mô hình xem xét kết quả của các token với khối lượng xác suất top_p. Vì vậy 0.1 có nghĩa là chỉ các token chiếm 10% xác suất hàng đầu được xem xét. <br>OpenAI thường khuyên thay đổi thông số này hoặc nhiệt độ nhưng không phải cả hai."],["Frequency Penalty","Hình Phạt Tần Suất"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Số từ -2.0 đến 2.0. Giá trị dương phạt các token mới dựa trên tần suất hiện có của chúng trong văn bản cho đến nay, giảm khả năng mô hình lặp lại cùng một dòng nguyên văn. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Hình Phạt Hiện Diện"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Số từ -2.0 đến 2.0. Giá trị dương phạt các token mới dựa trên việc chúng có xuất hiện trong văn bản cho đến nay hay không, tăng khả năng mô hình nói về các chủ đề mới. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Sử Dụng Lược Đồ JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Sử dụng <code>json_schema</code> cho trường <code>response_format.type</code> thay vì <code>json_object</code> cũ. <code>json_schema</code> được yêu cầu bởi một số mô hình mới nhất và một số máy chủ như <b>LM Studio</b>, nhưng một số mô hình cũ vẫn sử dụng <code>json_object</code>."],["Stop","Dừng"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","Nhập từ khóa nơi API sẽ dừng tạo thêm token. Phân tách mỗi mục bằng dòng mới."],["Additional argument variables","Biến đối số bổ sung"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","Các biến đối số bổ sung sẽ được thêm vào khi khởi động máy chủ.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","Thời Gian Chờ Lô"],["Timeout for each batch in milisecond","Thời gian chờ cho mỗi lô tính bằng mili giây."],["Max Request Length","Độ dài tối đa yêu cầu"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","Độ dài ký tự tối đa cho mỗi lô dịch.\nMỗi dịch giả có thông số kỹ thuật khác nhau.\nTôi khuyên nên ít hơn 2000 cho dịch giả giao diện WEB sử dụng tham số GET."],["Max concurrent requests","Yêu cầu đồng thời tối đa"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","Số lượng yêu cầu đồng thời được phép kết nối cùng lúc. Đặt thành <b>0</b> để tắt tính năng này.<br />Kết hợp tùy chọn này với <b>Số dòng tối đa mỗi yêu cầu đồng thời</b> để tăng tốc độ dịch."],["Max row per concurrent requests","Số dòng tối đa mỗi yêu cầu đồng thời"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","Số dòng được phép cho mỗi yêu cầu đồng thời. Đặt thành <b>0</b> để tắt tính năng này.<br />Nếu tùy chọn này bị tắt thì dù bạn đặt bao nhiêu <b>Yêu cầu đồng thời tối đa</b>, Translator++ sẽ xử lý yêu cầu như một khối duy nhất."],["Batch delay","Độ trễ lô"],["Delay between batch (in miliseconds)","Độ trễ giữa các lô (tính bằng mili giây)"],["Code Escaping Algorithm","Thuật toán thoát mã"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","Thuật toán thoát cho mã nội tuyến bên trong hội thoại. Bạn có thể cần thay đổi <b>Mẫu tin nhắn hệ thống</b> và <b>Mẫu tin nhắn nội dung</b> theo thuật toán thoát bạn chọn."],["Number of retry","Số lần thử lại"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Số lần động cơ nên thử lại khi xác thực đầu ra dịch thất bại. Nếu để trống (rỗng), thì không thử lại."],["Retry when the number of translated rows doesn't match original","Thử lại khi số dòng dịch không khớp với bản gốc"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Nếu bật, động cơ sẽ thử lại khi mô hình trả về số dòng dịch khác so với tải trọng gốc."],["Retry when the number of lines for each translated row doesn't match original","Thử lại khi số dòng cho mỗi dòng dịch không khớp với bản gốc"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Nếu bật, động cơ sẽ thử lại khi bất kỳ dòng dịch nào có số dòng khác với dòng gốc của nó."],["Prompt: Row count mismatch","Lời nhắc: Số dòng không khớp"],["Prompt used when retrying due to row/element count mismatch.","Lời nhắc được sử dụng khi thử lại do số dòng/phần tử không khớp."],["Prompt: Line count mismatch","Lời nhắc: Số dòng không khớp"],["Prompt used when retrying due to per-row line count mismatch.","Lời nhắc được sử dụng khi thử lại do số dòng mỗi dòng không khớp."],["Prompt: Error / Retry instruction","Lời nhắc: Lỗi / Hướng dẫn thử lại"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","Lời nhắc được thêm sau lời nhắc không khớp để hướng dẫn mô hình thử lại."],["Custom Parameter","Tham số Tùy chỉnh"],["Key","Khóa"],["Value","Giá trị"],["Type","Loại"],["Type of the value.","Loại của giá trị."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Đối với loại <b>javascript</b>, giá trị sẽ được đánh giá như mã JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","Phạm vi của mã javascript là <code>window</code>. Vì vậy bạn có thể truy cập hầu hết mọi giá trị."],["<br />Example: <code>trans.project.title</code>","<br />Ví dụ: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Bỏ các tham số sẽ không được gửi đến API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","API OpenAI liên tục thay đổi, một số mô hình mới có thể không hỗ trợ các tham số cũ và sẽ trả về lỗi HTTP cho tham số yêu cầu không được nhận dạng."],["You can drop the parameters that are not supported by the model here.","Bạn có thể bỏ các tham số không được mô hình hỗ trợ ở đây."],["Manage configuration","Quản lý cấu hình"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","Một số tính năng của công cụ này yêu cầu tiện ích ChatGPT được cài đặt. Vui lòng đảm bảo bạn đã cài đặt tiện ích ChatGPT trước khi sử dụng công cụ này."],["Text Completion Setting","Cài đặt Hoàn thành Văn bản"],["General","Chung"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Đừng lãng phí tiền vào Mô hình Lý luận</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Các nghiên cứu khác nhau đã chứng minh rằng mô hình lý luận kém hơn nhiều so với mô hình thông thường trong việc thực hiện các tác vụ viết sáng tạo và dịch thuật.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Bạn không nhận được gì ngoài chi phí đắt hơn và thời gian phản hồi chậm hơn khi sử dụng mô hình lý luận.</p>"],["Platform specific","Cụ thể nền tảng"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","Mẫu"],["Enable context","Bật ngữ cảnh"],["<h2>Sample dialogue</h2>","<h2>Mẫu hội thoại</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mẫu hội thoại hiện có. Bạn có thể viết một mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["Retry prompts","Nhắc lại lời nhắc"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Những lời nhắc này được thêm vào như các tin nhắn <b>người dùng</b> bổ sung trong quá trình thử lại, ngay sau đầu ra mô hình trước đó.</p>"],["<p>Available variables:</p>","<p>Các biến có sẵn:</p>"],["Enable Jailbreak","Bật Jailbreak"],["Advanced","Nâng cao"],["Custom Parameters","Tham số Tùy chỉnh"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Bạn có thể thêm tham số tùy chỉnh vào phần thân yêu cầu API Chat của OpenAI. Điều này hữu ích nếu bạn muốn thêm các tham số bổ sung không có sẵn trong biểu mẫu."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>Cảnh báo</h2><ul><li>Thiết lập tham số tùy chỉnh không chính xác có thể khiến yêu cầu API thất bại. Hãy chắc chắn bạn biết mình đang làm gì trước khi thêm tham số tùy chỉnh. Một số dịch vụ như OpenAI rất nghiêm ngặt về các tham số bạn gửi, và họ sẽ trả về lỗi HTTP cho tham số yêu cầu không được công nhận.</li><li>Nếu cùng một khóa được sử dụng nhiều lần, chỉ giá trị cuối cùng sẽ được dùng.</li><li>Nếu cùng một khóa trong cấu hình hiện có được sử dụng, thì tham số cấu hình hiện có sẽ bị ghi đè bởi tham số tùy chỉnh.</li></ul>"],["Drop Parameters","Bỏ Tham số"],["LiteLLM Proxy Configuration","Cấu hình Proxy LiteLLM"],["Start LiteLLM server","Khởi động máy chủ LiteLLM"],["Processing...","Đang xử lý..."],["Server started on port ","Máy chủ đã khởi động trên cổng "],["Check LiteLLM Status","Kiểm tra Trạng thái LiteLLM"],["Change LiteLLM Version","Thay đổi Phiên bản LiteLLM"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","Nhập phiên bản mới của LiteLLM bạn muốn cài đặt.\nPhiên bản hoạt động đã biết: 1.38.0, 1.49.4 \nPhiên bản đề xuất là: "],["Are you sure you want to install LiteLLM version ","Bạn có chắc chắn muốn cài đặt phiên bản LiteLLM "],["Failed to install LiteLLM. Please check the console for more details.","Không thể cài đặt LiteLLM. Vui lòng kiểm tra bảng điều khiển để biết thêm chi tiết."],["LiteLLM has been successfully updated to version ","LiteLLM đã được cập nhật thành công lên phiên bản "],["Batch Translation Setting","Cài đặt Dịch Hàng loạt"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Xin lỗi, tiện ích này chỉ khả dụng cho các nhà tài trợ đang hoạt động.\nBạn có thể mở khóa tính năng này bằng cách trở thành nhà tài trợ $1."],["Retries and Refinement","Thử lại và Tinh chỉnh"],["<h2>Retries and Refinement</h2>","<h2>Thử lại và Tinh chỉnh</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Khi đầu ra dịch không vượt qua kiểm tra, Translator++ có thể yêu cầu mô hình thử lại bản dịch. Bạn có thể đặt số lần mô hình nên thử lại và cũng đặt điều kiện cho việc thử lại.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Đặt số lần thử lại hợp lý với điều kiện thử lại phù hợp có thể cải thiện đáng kể chất lượng dịch trong khi vẫn kiểm soát được chi phí và thời gian.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Mỗi lần thử lại tốn thêm thời gian và tiền bạc</b>. Nếu quá trình dịch hàng loạt của bạn thường xuyên phải thử lại, bạn có thể muốn điều chỉnh lời nhắc để làm cho hướng dẫn rõ ràng hơn cho mô hình.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Sử dụng công cụ nhà phát triển hoặc Quản lý Hàng loạt để gỡ lỗi quá trình dịch hàng loạt của bạn.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Thuật toán Mã hóa Mã</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>Mã hóa mã là một kỹ thuật để ngăn MTL thay đổi các đoạn mã bên trong hội thoại. Điều này hữu ích khi hội thoại của bạn chứa các đoạn mã như thẻ HTML, thẻ XML, đối tượng JSON hoặc mẫu JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Chọn thuật toán mã hóa phù hợp với các đoạn mã bên trong hội thoại của bạn. Bạn có thể cần điều chỉnh mẫu <b>thông điệp hệ thống</b>, <b>Lời nhắc Mẫu</b> và <b>thông điệp nội dung</b> tương ứng.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Nhấp <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>vào đây</a> để đọc thêm về thuật toán mã hóa mã và cách sử dụng chúng hiệu quả.</p>"],["JavaScript template cloaking","Mã hóa mẫu JavaScript"],["None (no escaping)","Không (không thoát)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Bạn có muốn tải mẫu hội thoại mẫu cho thuật toán thoát đã chọn không? Điều này sẽ ghi đè hội thoại mẫu hiện có của bạn."],["Always separate file","Luôn tách file"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Luôn tách file cho mỗi lô. Điều này có thể giữ ngữ cảnh của mỗi file không bị lẫn lộn với các file khác."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên diễn viên từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ loại bỏ tên diễn viên khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Load Actor Reference as Glossary","Tải Tham chiếu Diễn viên làm Bảng Thuật ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu diễn viên làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu diễn viên là tên của diễn viên trong hội thoại. Điều này sẽ được tải như một bảng thuật ngữ cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm bảng thuật ngữ cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu diễn viên trong thông báo nhắc."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Nếu bạn bật tùy chọn này, bạn cũng cần bao gồm biến <code>ACTOR_INFO</code> trong mẫu nhắc để đặt dữ liệu thông tin nhân vật."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Diễn viên"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột của bản dịch tên diễn viên. Cột này sẽ được sử dụng làm bản dịch của tham chiếu diễn viên. Điều này sẽ cải thiện tính nhất quán của bản dịch tên diễn viên trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông tin Diễn viên"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung của diễn viên. Bạn có thể đặt thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện bản dịch của đại từ trong cuộc trò chuyện."],["Extra Prompt","Nhắc Thêm"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Nhắc thêm sẽ được thêm vào thông báo nhắc. Điều này sẽ được thêm sau thông báo hệ thống và trước thông báo nhắc thực tế."],["General Settings","Cài đặt Chung"],["Always separate file for each batch","Luôn tách file cho mỗi lô"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Glossary","Bảng Thuật ngữ"],["<h2>Glossary</h2>","<h2>Bảng Thuật Ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi nhóm mục để cải thiện chất lượng bản dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông Tin Bổ Sung của Nhân Vật"],["Prompt","Lời Nhắc"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":false,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"relPath":"/addons/transLitellm/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":166,"length":166,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","Dịch với OpenAI Batch API"],["Model","Mô Hình"],["The pre-trained model.","Mô hình đã được huấn luyện trước."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Có vẻ như OpenAI Batch API sử dụng quy ước đặt tên mô hình hơi khác so với API thông thường. Các mô hình được sử dụng trong Batch API có tiền tố “-batch”. Ví dụ, nếu bạn dùng <code>gpt-4.1-mini</code>, mô hình sẽ tự động trở thành <code>gpt-4.1-mini-batch</code>.<br />\nTuy nhiên, tại thời điểm tiện ích này được tạo, các mô hình batch không được liệt kê trong giới hạn sử dụng mô hình của OpenAI, điều này khiến người dùng không thể sử dụng Batch API nếu họ đã đặt bộ lọc Sử Dụng Mô Hình thành “Cho phép” (danh sách trắng).<br />\nĐây có thể là lỗi trong giao diện OpenAI và có thể được sửa trong tương lai.<br />\nVì vậy, hãy đảm bảo đặt giới hạn sử dụng trong OpenAI thành chế độ “Chặn” (danh sách đen) để sử dụng Batch API.<br />\nNhấp vào đây để thay đổi giới hạn sử dụng mô hình: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Cột Nguồn"],["The column of the original texts you want to translate.","Cột chứa văn bản gốc mà bạn muốn dịch."],["Add actor name","Thêm tên nhân vật"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên nhân vật từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ loại bỏ tên nhân vật khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Ignore if already translated","Bỏ qua nếu đã dịch"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Nếu tùy chọn này được chọn, Translator++ sẽ bỏ qua bất kỳ hàng nào đã có bản dịch trong cột của nó."],["Load Actor Reference as Glossary","Tải Tham Chiếu Nhân Vật làm Bảng Thuật Ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu nhân vật làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu nhân vật là tên của nhân vật trong hội thoại. Nó sẽ được tải như một bảng thuật ngữ cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm bảng thuật ngữ cho mỗi mục nhóm. Sử dụng lệnh mẫu để tải tham chiếu nhân vật trong tin nhắn lời nhắc."],["Actor Reference Translation Column","Cột Dịch Tham Chiếu Nhân Vật"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch của tên nhân vật. Cột này sẽ được sử dụng làm bản dịch của tham chiếu nhân vật. Điều này sẽ cải thiện tính nhất quán của bản dịch tên nhân vật trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông Tin của Nhân Vật"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung của nhân vật. Bạn có thể thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện việc dịch đại từ trong cuộc hội thoại."],["System Message Template","Mẫu Tin nhắn Hệ thống"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","Tin nhắn hệ thống là phần đầu của tin nhắn sẽ cho biết vai trò của trợ lý chatGPT của bạn. Tin nhắn này sẽ được gửi như là tin nhắn đầu tiên của mỗi lô bạn gửi đến chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Bạn có thể bao gồm các biến sau với phong cách Template Literal của JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","Biến số:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Ngôn ngữ nguồn</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Ngôn ngữ đích</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Tên đầy đủ của ngôn ngữ nguồn</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Tên đầy đủ của ngôn ngữ đích</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Văn bản nguồn</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Tin nhắn được định nghĩa trước của thuật toán thoát.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : Chuỗi đại diện cho dòng mới (Thay thế dòng).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Số lượng tin nhắn trong lô.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Thêm thông tin của các nhân vật.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine của trò chơi</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>REFERENCE[Tham chiếu Chung]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Bao gồm một số dòng trước đó làm ngữ cảnh</li>"],["Body Message Template","Mẫu Tin nhắn Nội dung"],["Template of the body of your chat.","Mẫu của phần nội dung trong cuộc trò chuyện của bạn."],["Sample conversation","Mẫu hội thoại"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","API Batch của OpenAI cho phép bạn dịch dự án của mình không đồng bộ với chi phí thấp hơn 50%, nghĩa là bạn sẽ nhận được kết quả dịch <b style=\"color:red\">trong vòng 24 giờ</b> với <b style=\"color:blue\">một nửa chi phí thông thường</b>. Điều này đặc biệt hữu ích cho các dự án lớn không yêu cầu kết quả dịch ngay lập tức."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />Đọc thêm về API Batch của OpenAI <a href=\"https://platform.openai.com/docs/guides/batch\" external>tại đây</a>."],["General Settings","Cài đặt chung"],["This form is using your OpenAI Batch API configuration.<br>","Biểu mẫu này đang sử dụng cấu hình API Batch OpenAI của bạn.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","Bạn có thể thay đổi cấu hình bằng cách vào cài đặt của tiện ích <b>API Batch OpenAI</b> trong cửa sổ tùy chọn.<br>"],["There you can set the API key, model, and other settings.<br />","Ở đó, bạn có thể đặt khóa API, mô hình và các cài đặt khác.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Mở cài đặt ChatGPT\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Đừng lãng phí tiền vào các Mô hình Suy luận</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Các nghiên cứu khác nhau đã chứng minh rằng các mô hình suy luận kém hơn nhiều so với các mô hình thông thường trong việc thực hiện các tác vụ viết sáng tạo và dịch thuật.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Bạn không nhận được gì ngoài chi phí đắt hơn và thời gian phản hồi chậm hơn khi sử dụng các mô hình suy luận.</p>"],["Append actor name to the translatable text","Thêm tên diễn viên vào văn bản có thể dịch"],["Ignore translated rows","Bỏ qua các hàng đã dịch"],["Glossary","Bảng thuật ngữ"],["<h2>Glossary</h2>","<h2>Bảng thuật ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm một bảng thuật ngữ vào lời nhắc. Bảng thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phình to lời nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông tin Bổ sung của Diễn viên"],["Prompt Template","Mẫu Lời nhắc"],["<h2>1. System Message</h2>","<h2>1. Tin nhắn Hệ thống</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Ở đây, bạn có thể giải thích cho trợ lý về vai trò của họ.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Mẫu hội thoại</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mẫu hội thoại hiện có. Bạn có thể viết mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Lời nhắc thực tế của bạn</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Đây là lời nhắc thực tế gửi đến trợ lý.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Chi phí cố định</h3>\n                        Chi phí cố định là chi phí của tin nhắn lời nhắc mà bạn gửi đến trợ lý mà không bao gồm văn bản dịch thực tế. Chi phí được tính dựa trên số lượng token trong tin nhắn lời nhắc. Càng nhiều token, chi phí sẽ càng cao.<br>\n                        <b>Chi phí cố định ước tính:</b> <span class=\"overheadCost\">0</span> token / yêu cầu."],["Are you sure you want to reset the form?","Bạn có chắc chắn muốn đặt lại biểu mẫu không?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Bạn có chắc chắn muốn xử lý hàng loạt không?\nChi phí sẽ phát sinh cho thao tác này."],["The batch is successfully created. Do you want to open the batch manager?","Hàng loạt đã được tạo thành công. Bạn có muốn mở trình quản lý hàng loạt không?"],["OpenAI Batch API Queue","Hàng đợi API Hàng loạt OpenAI"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"relPath":"/addons/transOpenAIBatch/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":65,"length":65,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Vui lòng chọn các hàng để áp dụng bản dịch"],["Target Column","Cột Mục tiêu"],["The column to put the translation result.","Cột để đặt kết quả dịch."],["Import translation from ChatGPT Batch","Nhập bản dịch từ ChatGPT Batch"],["Translation applied to selected rows","Bản dịch đã áp dụng cho các hàng đã chọn"],["Invalid format","Định dạng không hợp lệ"],["OK","OK"],["Mismatch","Không khớp"],["Failed to load batch list with error: \n","Không thể tải danh sách batch với lỗi: \n"],["Download Error File","Tải xuống Tệp Lỗi"],["Batch is not completed yet","Batch chưa hoàn thành"],["Are you sure you want to cancel this batch?","Bạn có chắc muốn hủy batch này không?"],["Cannot cancel completed batch.","Không thể hủy batch đã hoàn thành."],["Batch cancelled","Batch đã hủy"],["Failed to cancel batch","Không thể hủy batch"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","Các Batch"],["Apply translation","Áp dụng bản dịch"],["Cancel batch","Hủy batch"],["Status","Trạng thái"],["Batch ID","ID Lô"],["Input File ID","ID Tệp Đầu vào"],["End point","Điểm cuối"],["Created at","Được tạo lúc"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Hết hạn lúc <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Các lô không hoàn thành đúng thời hạn cuối cùng sẽ chuyển sang trạng thái hết hạn; các yêu cầu chưa hoàn thành trong lô đó bị hủy, và mọi phản hồi cho các yêu cầu đã hoàn thành được cung cấp qua tệp đầu ra của lô. Bạn sẽ bị tính phí cho token tiêu thụ từ bất kỳ yêu cầu đã hoàn thành nào.\"></i>"],["Completed at","Hoàn thành lúc"],["Errors","Lỗi"],["Batch Item Detail of","Chi tiết Mục Lô của"],["ID","ID"],["Completed on","Hoàn thành vào"],["Model","Mô hình"],["Prompt Token","Token Đầu vào"],["Completion Token","Token Hoàn thành"],["Total Token","Tổng Token"],["Status Code","Mã Trạng thái"],["error","lỗi"],["Conversation","Cuộc trò chuyện"],["Response Validation","Xác thực Phản hồi"],["Raw Payload","Dữ liệu Thô"],["View raw payload","Xem dữ liệu thô"],["Response Preview","Xem trước phản hồi"],["Apply translations from selected rows","Áp dụng bản dịch từ các hàng đã chọn"],["Here you can edit the translation result individually and send it into Translator++","Ở đây bạn có thể chỉnh sửa kết quả dịch từng cái và gửi vào Translator++"],["Open ChatGPT Settings","Mở cài đặt ChatGPT"],["Help","Trợ giúp"],["File list","Danh sách tệp"],["Collapse / restore left panel","Thu gọn / khôi phục bảng trái"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Các lô không hoàn thành đúng hạn cuối cùng sẽ chuyển sang trạng thái hết hạn; các yêu cầu chưa hoàn thành trong lô đó bị hủy, và bất kỳ phản hồi nào cho các yêu cầu đã hoàn thành sẽ được cung cấp qua tệp đầu ra của lô. Bạn sẽ bị tính phí cho các token tiêu thụ từ bất kỳ yêu cầu đã hoàn thành nào."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÊN : Tiêu đề của trò chơi</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Công cụ của trò chơi</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>THÔNG TIN DIỄN VIÊN : Bảng thuật ngữ thông tin diễn viên. (Chỉ khi tùy chọn thông tin diễn viên được bật trong chế độ hàng loạt)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>THAM CHIẾU[tên đối tượng] : Tạo tham chiếu từ đối tượng Translator++. <br />Ví dụ : <code>THAM CHIẾU[Tham chiếu chung]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>NGỮ CẢNH : Ngữ cảnh của bản dịch trước đó (nếu ngữ cảnh được bật)</li>"],["Sample conversation","Cuộc trò chuyện mẫu"],["<h2>Sample dialogue</h2>","<h2>Mẫu hội thoại</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Mẫu hội thoại hiện có. Bạn có thể viết mẫu phản hồi tốt hoặc xấu để giúp người dịch hiểu mục tiêu và ngữ cảnh của cuộc trò chuyện.</p>"],["Always separate file","Luôn tách tệp"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Luôn tách tệp cho mỗi hàng loạt. Điều này có thể giữ cho ngữ cảnh của mỗi tệp không bị lẫn với các tệp khác."],["Add actor name","Thêm tên diễn viên"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Thêm tên nhân vật từ thông tin hàng vào văn bản có thể dịch. Điều này sẽ giúp người dịch theo dõi hội thoại và đại từ. Translator++ sau đó sẽ loại bỏ tên nhân vật khỏi kết quả dịch. Điều này rõ ràng sẽ làm tăng chi phí dịch."],["Load Actor Reference as Glossary","Tải Tham chiếu Nhân vật làm Bảng thuật ngữ"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Nếu được chọn, Translator++ sẽ tải tham chiếu nhân vật làm bảng thuật ngữ. Điều này sẽ giúp người dịch hiểu ngữ cảnh của cuộc trò chuyện. Tham chiếu nhân vật là tên của nhân vật trong hội thoại. Nó sẽ được tải như một bảng thuật ngữ cho người dịch. Điều này sẽ làm tăng chi phí dịch."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Chỉ các nhân vật tồn tại trong cuộc trò chuyện sẽ được tải làm bảng thuật ngữ cho mỗi mục lô. Sử dụng lệnh mẫu để tải tham chiếu nhân vật trong thông điệp nhắc."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Nếu bạn bật tùy chọn này, bạn cũng cần bao gồm biến <code>ACTOR_INFO</code> trong mẫu nhắc để đặt dữ liệu thông tin nhân vật."],["Actor Reference Translation Column","Cột Dịch Tham chiếu Nhân vật"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","Cột chứa bản dịch của tên nhân vật. Cột này sẽ được sử dụng làm bản dịch của tham chiếu nhân vật. Điều này sẽ cải thiện tính nhất quán của bản dịch tên nhân vật trong cuộc trò chuyện."],["Actor's Information Column","Cột Thông tin Nhân vật"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","Cột chứa thông tin bổ sung của nhân vật. Bạn có thể đặt thêm thông tin như giới tính, tuổi, v.v. Điều này sẽ cải thiện bản dịch của đại từ trong cuộc trò chuyện."],["Extra Prompt","Nhắc Bổ sung"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Nhắc bổ sung sẽ được thêm vào thông điệp nhắc. Nó sẽ được thêm sau thông điệp hệ thống và trước thông điệp nhắc thực tế."],["General Settings","Cài đặt Chung"],["Always separate file for each batch","Luôn tách tệp cho mỗi lô"],["Append actor name to the translatable text","Thêm tên nhân vật vào văn bản có thể dịch"],["Glossary","Bảng thuật ngữ"],["<h2>Glossary</h2>","<h2>Bảng thuật ngữ</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Tính năng này sẽ giúp bạn tự động thêm bảng thuật ngữ vào nhắc. Bảng thuật ngữ sẽ được tải cho mỗi lô mục để cải thiện chất lượng dịch. Tính năng sẽ cố gắng chỉ tải các thuật ngữ liên quan để tránh làm phồng nhắc của bạn.</p>"],["The Column of Actor's Additional Information","Cột Thông tin Bổ sung của Nhân vật"],["Prompt","Nhắc"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transOpenAIBatch/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","Trình quản lý Lô"],["This feature is only available if you have a project open.","Tính năng này chỉ khả dụng nếu bạn đã mở một dự án."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":false,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transOpenAIBatch/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","Khởi động máy chủ"],["Server started","Máy chủ đã khởi động"],["Reinstall server","Cài đặt lại máy chủ"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","Nhập phiên bản mới của thư viện Translators bạn muốn cài đặt.\nPhiên bản mới nhất là: "],["Are you sure you want to install Translators version ","Bạn có chắc chắn muốn cài đặt phiên bản Translators "],["Failed to install Translators. Please check the console for more details.","Không thể cài đặt Translators. Vui lòng kiểm tra bảng điều khiển để biết thêm chi tiết."],["Translators has been successfully updated to version ","Translators đã được cập nhật thành công lên phiên bản "],["General Settings","Cài đặt chung"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":false,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"relPath":"/addons/transPyTranslators/pyTranslators.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","Bạn có chắc chắn muốn hủy bỏ?"],["Process paused!\nPress OK to continue!","Quá trình tạm dừng!\nNhấn OK để tiếp tục!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":false,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"relPath":"/addons/transRedBatch/transredbatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","Không bao giờ dỡ từ điển khỏi RAM"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":false,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"relPath":"/addons/transRikaikun/transRikaikun.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","Không thể khởi động Translation Proxy!\nTranslation Proxy hiện chỉ khả dụng cho các nhà tài trợ từ $3 trở lên."],["Please enter the port number:","Vui lòng nhập số cổng:"],["Invalid port : ","Cổng không hợp lệ: "],["Port must be a numeric.","Cổng phải là số."],["Port has successfully changed to: ","Cổng đã được thay đổi thành công thành: "],["Connection Info","Thông tin Kết nối"],["Do you want to copy the base URL into the clipboard?","Bạn có muốn sao chép URL cơ sở vào clipboard không?"],["Use secure protocol(HTTPS)","Sử dụng giao thức bảo mật (HTTPS)"],["Port","Cổng"],["Connection info","Thông tin kết nối"],["Help","Trợ giúp"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":false,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"relPath":"/addons/translationProxy/translationProxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","Sẽ ép buộc mã hóa văn bản thành mã hóa được chọn khi viết kịch bản. (trống = tự động)<br />. Bạn có thể sử dụng trường này để chuyển đổi kịch bản thành <b>UTF-16</b> để trò chơi có thể chơi được mà không cần thay đổi ngôn ngữ hệ thống sang tiếng Nhật."],["Use legacy parser","Sử dụng trình phân tích cũ"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","Sử dụng trình phân tích cũ thay vì trình phân tích mới.<br />Trình phân tích cũ nhanh hơn, nhưng không đáng tin cậy trên một số trò chơi.<br />Trình phân tích mới đáng tin cậy hơn, nhưng chậm hơn."],["Select TyranoBuilder packaged game","Chọn trò chơi đóng gói TyranoBuilder"],["Select the exe file of your packaged game.","Chọn tệp exe của trò chơi đóng gói của bạn."],["Target folder","Thư mục đích"],["Select destination folder. The process will replace the existing files.","Chọn thư mục đích. Quá trình sẽ thay thế các tệp hiện có."],["Extraction completed","Trích xuất hoàn tất"],["Close","Đóng"],["Next","Tiếp theo"],["Please select game executable file","Vui lòng chọn tệp thực thi trò chơi"],["Back","Quay lại"],["The game is fully loaded, proceed!","Trò chơi đã tải đầy đủ, tiến hành!"],["Extract data","Trích xuất dữ liệu"],["Open extracted folder","Mở thư mục đã trích xuất"],["Extract resources","Trích xuất tài nguyên"],["Select the game executable","Chọn tệp thực thi trò chơi"],["Select the game executable or asar file to extract","Chọn tệp thực thi trò chơi hoặc tệp asar để trích xuất"],["Target directory","Thư mục đích"],["Select the target directory to store the unpacked files","Chọn thư mục đích để lưu các tệp đã giải nén"],["Electron archive file detected. Do you want to extract the asar file instead?","Phát hiện tệp lưu trữ Electron. Bạn có muốn trích xuất tệp asar thay thế không?"],["Tyranobuilder Game Extractor","Trình trích xuất trò chơi Tyranobuilder"],["Before you create a new project, please make sure that :","Trước khi tạo dự án mới, vui lòng đảm bảo rằng:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","Tiện ích bổ sung <b>Kirikiri Adventure Game parser</b> đã được cài đặt trong Translator++ của bạn"],["Your game is fully extracted.","Trò chơi của bạn đã được trích xuất đầy đủ."],["Extract TyranoBuilder package","Trích xuất gói TyranoBuilder"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Tất cả các tệp .ks & .tjs đều ở dạng văn bản thuần (không biên dịch, không xáo trộn và không mã hóa)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Một số hành động sẽ sửa đổi trò chơi của bạn. <b>Vì vậy hãy đảm bảo tạo bản sao lưu cho trò chơi của bạn!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Chọn tệp thực thi trò chơi. Tệp này là tệp trò chơi chính sẽ được sử dụng để trích xuất dữ liệu trò chơi."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","Trong các trò chơi Tyrano, nó thường là tệp <b>index.html</b> hoặc <b>exe</b>."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Danh sách các bảng mã ký tự có thể. <b>Thứ tự rất quan trọng!</b>. Bạn có thể kéo để sắp xếp danh sách."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","Game tạo bằng TyranoBuilder sử dụng bảng mã <b>UTF-8</b>"],["Literal tags are the tags that will be escaped into Translator++ editor.","Thẻ ký tự là các thẻ sẽ được thoát vào trình soạn thảo Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> là bắt buộc."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Các thẻ sẽ được Translator++ chèn thành một dòng mới. Vì vậy, bạn không cần viết <b>[r]</b> một cách rõ ràng."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kịch bản Kirikiri (.ks) có thể tùy chỉnh cao và cho phép nhà phát triển tạo thẻ riêng."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ có thể xử lý các thẻ tiêu chuẩn như tên nhân vật bắt đầu bằng dấu thăng (#)."],["However, Translator++ may not be able to handle custom tags created by developers.","Tuy nhiên, Translator++ có thể không xử lý được các thẻ tùy chỉnh do nhà phát triển tạo."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Do đó, bạn có thể cần xác định các thẻ và thuộc tính cần dịch và những thứ cần đánh dấu là tên diễn viên."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>Vui lòng truy cập <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">tài liệu tham khảo thẻ TyranoBuilder</a> để biết thêm thông tin về các thẻ.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","Bạn có thể cần <input type=\"button\" value=\"trích xuất game của bạn\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> và phân tích kịch bản <b>ks</b> bên trong trước khi bắt đầu dự án."],["Create Project","Tạo Dự án"],["Play last build","Chơi bản dựng cuối"],["Extract TyranoBuilder","Trích xuất TyranoBuilder"],["Create playable package","Tạo gói có thể chơi"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":false,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"relPath":"/addons/tyranoTrans/tyranoTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":45,"length":45,"percent":100},"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","Chung"],["Executable file location","Vị trí tệp thực thi"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tĐường dẫn đến tệp thực thi của ứng dụng.\n\t\t\t"],["Field can not be empty!","Trường không thể để trống!"],["Service","Dịch vụ"],["End Point","Điểm Kết Nối"],["Auto translation service to use.","Dịch vụ dịch tự động để sử dụng."],["Target Language","Ngôn Ngữ Đích"],["The language to translate into","Ngôn ngữ để dịch sang."],["Source Language","Ngôn Ngữ Nguồn"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","Ngôn ngữ gốc của trò chơi. \"tự động\" cũng được hỗ trợ cho một số điểm kết nối, nhưng thường không được khuyến nghị."],["Files","Tệp"],["Directory","Thư Mục"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Thư mục để tìm tệp bản dịch đã lưu. Có thể sử dụng chỗ dành sẵn: {GameExeName}, {Lang}"],["Output File","Tệp Đầu Ra"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","Tệp để chèn bản dịch đã tạo vào. Có thể sử dụng chỗ dành sẵn: {GameExeName}, {Lang}"],["Substitution File","Tệp Thay Thế"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","Tệp chứa thay thế được áp dụng trước khi dịch. Có thể sử dụng chỗ dành sẵn: {GameExeName}, {Lang}"],["Preprocessors File","Tệp Tiền Xử Lý"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","Tệp chứa tiền xử lý để áp dụng trước khi gửi văn bản đến dịch vụ dịch. Có thể sử dụng chỗ dành sẵn: {GameExeName}, {Lang}"],["Text Frameworks","Khung Văn Bản"],["Enable/Disable auto translation for Unity's text frameworks.","Bật/Tắt dịch tự động cho khung văn bản của Unity."],["Behaviour","Hành Vi"],["Max Characters Per Translation","Số Ký Tự Tối Đa Mỗi Bản Dịch"],["Max characters per text to translate. Max 2500.","Số ký tự tối đa cho mỗi văn bản để dịch. Tối đa 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Có bỏ qua khoảng trắng, bao gồm dòng mới, trong khóa hội thoại hay không"],["Whether or not to ignore whitespace, including newlines, in NGUI","Có bỏ qua khoảng trắng, bao gồm dòng mới, trong NGUI hay không"],["Minimum Dialogue Chars","Số ký tự tối thiểu cho hội thoại"],["The length of the text for it to be considered a dialogue","Độ dài văn bản để được coi là một hội thoại"],["Force Split Text After Characters","Buộc tách văn bản sau số ký tự"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Tách văn bản thành nhiều dòng khi bản dịch vượt quá số ký tự này. (0 là không tách)"],["Whether or not to copy hooked texts to clipboard","Có sao chép văn bản đã hook vào clipboard hay không"],["MaxClipboardCopyCharacters","Số ký tự tối đa sao chép vào clipboard"],["Max number of characters to hook to clipboard at a time","Số ký tự tối đa để hook vào clipboard cùng lúc"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Plugin có nên cung cấp \"nỗ lực tốt nhất\" để thay đổi kích thước thành phần UI khi dịch hay không"],["Indicates whether batching of translations should be enabled for supported endpoints","Cho biết có nên bật batch dịch cho các endpoint được hỗ trợ hay không"],["Indicates whether or not to use translations from the included static translation cache","Cho biết có sử dụng bản dịch từ bộ nhớ cache tĩnh đi kèm hay không"],["Override Font","Ghi đè phông chữ"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Ghi đè phông chữ được sử dụng cho văn bản khi cập nhật thành phần văn bản. LƯU Ý: Chỉ hoạt động cho UGUI"],["Override Font TextMeshPro","Ghi đè phông chữ TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Ghi đè phông chữ được sử dụng cho văn bản khi cập nhật thành phần văn bản. LƯU Ý: Chỉ hoạt động cho TextMeshPro"],["Resize UI Line Spacing Scale","Tỷ lệ khoảng cách dòng khi thay đổi kích thước UI"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","Một giá trị thập phân mà khoảng cách dòng mặc định nên được nhân lên khi thay đổi kích thước UI, ví dụ: 0.80. LƯU Ý: Chỉ hoạt động cho UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","Cho biết hành vi thay đổi kích thước UI có nên áp dụng cho tất cả thành phần UI bất kể chúng có được dịch hay không."],["Ignore Text Starting With","Bỏ qua văn bản bắt đầu bằng"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Chỉ định rằng plugin nên bỏ qua bất kỳ chuỗi nào bắt đầu bằng các ký tự nhất định. Đây là một danh sách phân tách bằng ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","Chỉ định có bật \"Chế độ tương thích Trình lấy văn bản\" hay không. Chỉ nên bật nếu trò chơi yêu cầu."],["GameLog Text Paths","Đường dẫn Văn bản Nhật ký Trò chơi"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Chỉ định các đường dẫn cụ thể cho đối tượng trò chơi mà trò chơi sử dụng làm \"thành phần nhật ký\", nơi nó liên tục thêm hoặc chèn văn bản vào. Yêu cầu kiến thức chuyên môn để thiết lập. Đây là một danh sách phân tách bằng ';'."],["Romaji Post Processing","Xử lý sau Romaji"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","Chỉ định loại xử lý sau nào để thực hiện trên văn bản romaji 'đã dịch'. Điều này có thể quan trọng trong một số trò chơi vì phông chữ được sử dụng không hỗ trợ đúng cách các dấu phụ khác nhau. Đây là một danh sách phân tách bằng ';'. Các giá trị có thể: [\"Xóa tất cả dấu phụ\", \"Thay thế dấu gạch ngang bằng dấu mũ\", \"Xóa dấu nháy đơn\"]"],["Translation Post Processing","Xử lý sau Dịch thuật"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Chỉ định loại xử lý sau nào để thực hiện trên văn bản đã dịch (không phải romaji). Các giá trị có thể: [\"Xóa tất cả dấu phụ\", \"Thay thế dấu gạch ngang bằng dấu mũ\", \"Xóa dấu nháy đơn\", \"Thay thế ký tự rộng\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Chỉ định liệu kết quả của tra cứu regex có nên được xuất ra Tệp xuất được chỉ định hay không."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Chỉ định liệu sự khác biệt về khoảng trắng có nên được xuất ra Tệp xuất được chỉ định hay không."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Chỉ định liệu kết quả đầy đủ của bản dịch được tách bằng regex có nên được xuất ra Tệp xuất được chỉ định hay không."],["Indicates that the plugin should generate translations without variables when using substitutions.","Chỉ định rằng plugin nên tạo bản dịch không có biến khi sử dụng thay thế."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Chỉ định rằng plugin nên tạo bản dịch một phần để hỗ trợ dịch văn bản khi nó \"cuộn vào\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Chỉ định plugin nên phân tích chỉ thị 'TARC' và phạm vi dịch thuật dựa trên chúng."],["Indicates the plugin should not print out success messages in relation to translations.","Chỉ định plugin không nên in ra thông báo thành công liên quan đến bản dịch."],["Blacklisted IMGUI Plugins","Plugin IMGUI bị chặn"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","Nếu tên assembly/lớp/phương thức cửa sổ IMGUI chứa bất kỳ chuỗi nào trong danh sách này (không phân biệt chữ hoa chữ thường), giao diện người dùng đó sẽ không được dịch. Yêu cầu hook MonoMod. Đây là một danh sách phân tách bằng ';'"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Chỉ định nếu các văn bản được plugin coi là không thể dịch nên được xuất ra Tệp xuất được chỉ định."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Chỉ định rằng các quy tắc cho lệnh gọi phương thức ảo nên được bỏ qua khi cố gắng đặt văn bản của một thành phần văn bản. Trong một số trường hợp có thể giúp đặt văn bản của các thành phần cứng đầu."],["Max Text Parser Recursion","Đệ quy Phân tích Văn bản Tối đa"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Chỉ định số cấp độ đệ quy được phép khi phân tích văn bản để có thể dịch ở các phần khác nhau. Có thể sử dụng với biểu thức tách trong các kịch bản nâng cao. Giá trị mặc định là một về cơ bản có nghĩa là đệ quy bị vô hiệu hóa."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Sẽ xử lý trước và giải mã các thực thể HTML trước khi chúng được gửi đi dịch. Một số dịch giả sẽ thất bại khi gửi thực thể HTML."],["Will enable automated handling of rich text (text with markup).","Sẽ kích hoạt xử lý tự động văn bản phong phú (văn bản có đánh dấu)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Chỉ định xem các thông báo nhật ký hữu ích liên quan đến dịch giả có nên được kích hoạt không. Có thể hữu ích khi dịch dựa trên tài nguyên chuyển hướng."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Chỉ định rằng plugin phải sử dụng móc MonoMod thay vì móc harmony."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Chỉ định plugin nên khởi tạo cầu nối chuyển hướng harmony cho phép móc harmony hoạt động trong môi trường không có System.Reflection.Emit (thường các cài đặt như vậy được xử lý bởi trình quản lý plugin, vì vậy không sử dụng khi dùng trình quản lý plugin)."],["Redirected Resource Detection Strategy","Chiến lược Phát hiện Tài nguyên Chuyển hướng"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Chỉ định nếu và cách plugin nên cố gắng nhận diện tài nguyên chuyển hướng để ngăn dịch trùng lặp."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Chỉ định xem plugin có nên xuất văn bản vượt quá <b>'Số Ký tự Tối đa Mỗi Bản dịch'</b> mà không dịch nó không."],["Texture","Kết cấu"],["Texture Directory","Thư mục Kết cấu"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Thư mục để đổ kết cấu vào và gốc của các thư mục để tải hình ảnh từ đó. Có thể sử dụng trình giữ chỗ: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Chỉ định xem plugin có cố gắng thay thế hình ảnh trong trò chơi bằng những hình từ Thư mục Kết cấu không."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Chỉ định xem plugin có đổ kết cấu mà nó có khả năng thay thế vào Thư mục Kết cấu không. Có tác động đáng kể đến hiệu suất."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","Chỉ định xem việc bật/tắt bản dịch bằng phím tắt ALT+T có ảnh hưởng đến kết cấu không. Không đảm bảo hoạt động cho mọi kết cấu. Có tác động đáng kể đến hiệu suất."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Chỉ định xem plugin có nên quét kết cấu khi tải cảnh không. Điều này cho phép plugin tìm và (có thể) thay thế nhiều kết cấu hơn."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Chỉ định xem plugin có nên cố gắng móc SpriteRenderer không. Đây là một tùy chọn riêng biệt vì SpriteRenderer không thể thực sự được móc đúng cách và giải pháp thay thế đã triển khai có thể có tác động lý thuyết đến hiệu suất trong một số tình huống."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Chỉ định xem kết cấu chưa chỉnh sửa có nên được tải không. Các chỉnh sửa được xác định dựa trên mã băm trong tên tệp. Chỉ bật điều này cho mục đích gỡ lỗi vì nó có thể gây ra sự kỳ lạ."],["Texture Hash Generation Strategy","Chiến lược Tạo Mã băm Kết cấu"],["Indicates how the mod identifies pictures through hashes.","Chỉ định cách mod xác định hình ảnh thông qua mã băm."],["Duplicate Texture Names","Tên Kết Cấu Trùng Lặp"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Chỉ ra các tên kết cấu cụ thể bị trùng lặp trong trò chơi. Danh sách được phân cách bằng ';'"],["Indicates if the plugin should detect duplicate texture names.","Chỉ ra liệu plugin có nên phát hiện tên kết cấu trùng lặp hay không."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Chỉ ra plugin nên sử dụng một chiến lược khác để tải hình ảnh, có thể liên quan nếu động cơ trò chơi cũ."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Chỉ ra rằng tất cả kết cấu được tải nên được giữ trong bộ nhớ để hiệu suất tối ưu. Tắt để giảm mức sử dụng bộ nhớ."],["Resource Redirector","Trình Chuyển Hướng Tài Nguyên"],["Preferred Storage Path","Đường Dẫn Lưu Trữ Ưu Tiên"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Chỉ ra nơi lưu trữ ưu tiên cho tài nguyên được chuyển hướng liên quan đến Auto Translator. Có thể sử dụng placeholder: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","Chỉ ra liệu TextAssets có nên được chuyển hướng hay không"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Chỉ ra liệu plugin có nên ghi log vào console tất cả tài nguyên được tải không. Hữu ích để xác định những gì có thể được móc nối"],["Indicates if translatable resources that are found should be dumped","Chỉ ra liệu tài nguyên có thể dịch được tìm thấy có nên được đổ ra không"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","Khi các tệp nằm trong tệp ZIP trong PreferredStoragePath, các tệp này được lập chỉ mục trong bộ nhớ để tránh thực hiện kiểm tra tệp IO khi tải chúng. Bật tùy chọn này sẽ làm tương tự cho các tệp vật lý"],["HTTP","HTTP"],["User Agent","Tác Nhân Người Dùng"],["Override the user agent used by APIs requiring a user agent","Ghi đè tác nhân người dùng được sử dụng bởi các API yêu cầu một tác nhân người dùng"],["Indiciates whether certificate validations for the .NET API should be disabled","Chỉ ra liệu việc xác thực chứng chỉ cho API .NET có nên bị vô hiệu hóa không"],["Translation Aggregator","Trình Tổng Hợp Dịch Thuật"],["Width","Chiều Rộng"],["The total width of the translation aggregator window","Tổng chiều rộng của cửa sổ trình tổng hợp dịch thuật"],["Height","Chiều Cao"],["The width (per translator) of the translation aggregator window.","Chiều rộng (mỗi trình dịch) của cửa sổ tổng hợp dịch thuật."],["Enabled Translators","Trình dịch đã bật"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","ID của các điểm cuối dịch thuật đã được bật trong cửa sổ tổng hợp dịch thuật. Danh sách được phân tách bằng ';'"],["Google","Google"],["ServiceUrl","URL Dịch vụ"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","TÙY CHỌN, có thể được sử dụng để chuyển hướng yêu cầu API Google đến một URL khác. Có thể dùng để vượt GFWoC"],["Google Legitimate","Google Chính thức"],["Google API Key","Khóa API Google"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","TÙY CHỌN, cần thiết nếu GoogleTranslateLegitimate được cấu hình"],["Bing Legitimate","Bing Chính thức"],["OcpApim Subscription Key","Khóa đăng ký OcpApim"],["OPTIONAL, needed if BingTranslateLegitimate is configured","TÙY CHỌN, cần thiết nếu BingTranslateLegitimate được cấu hình"],["Baidu","Baidu"],["Baidu App Id","ID Ứng dụng Baidu"],["OPTIONAL, needed if BaiduTranslate is configured","TÙY CHỌN, cần thiết nếu BaiduTranslate được cấu hình"],["BaiduAppSecret","Bí mật Ứng dụng Baidu"],["Yandex","Yandex"],["Yandex API Key","Khóa API Yandex"],["OPTIONAL, needed if YandexTranslate is configured","TÙY CHỌN, cần thiết nếu YandexTranslate được cấu hình"],["Watson","Watson"],["Url","URL"],["OPTIONAL, needed if WatsonTranslate is configured","TÙY CHỌN, cần thiết nếu WatsonTranslate được cấu hình"],["Key","Khóa"],["DeepL","DeepL"],["MinDelay","Độ trễ tối thiểu"],["OPTIONAL, used for throttling DeepL","TÙY CHỌN, dùng để điều tiết DeepL"],["MaxDelay","Độ trễ tối đa"],["DeepL Legitimate","DeepL Hợp pháp"],["OPTIONAL, required if DeepLLegitimate is configured","TÙY CHỌN, cần thiết nếu DeepLLegitimate được cấu hình"],["Custom","Tùy chỉnh"],["Optional, needed if Custom Translated is configured","Tùy chọn, cần thiết nếu Dịch Tùy chỉnh được cấu hình"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","Đường dẫn cài đặt"],["Optional, needed if Lec Power Translator 15 is configured","Tùy chọn, cần thiết nếu Lec Power Translator 15 được cấu hình"],["Debug","Gỡ lỗi"],["Enables the console. Do not enable if other plugins (managers) handles this","Bật bảng điều khiển. Không bật nếu các plugin (trình quản lý) khác xử lý điều này"],["Enables extra logging for debugging purposes","Bật ghi nhật ký bổ sung cho mục đích gỡ lỗi"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","Đường dẫn cài đặt của ezTrans."],["Migrations","Di chuyển"],["Used to enable automatic migrations of this configuration file","Dùng để kích hoạt di chuyển tự động của tập tin cấu hình này"],["Tag","Thẻ"],["Tag representing the last version this plugin was executed under. Do not edit","Thẻ đại diện cho phiên bản cuối cùng mà plugin này đã chạy. Không chỉnh sửa"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":false,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":23,"Max Characters Per Translation":24,"Max characters per text to translate. Max 2500.":25,"Whether or not to ignore whitespace, including newlines, in dialogue keys":26,"Whether or not to ignore whitespace, including newlines, in NGUI":27,"Minimum Dialogue Chars":28,"The length of the text for it to be considered a dialogue":29,"Force Split Text After Characters":30,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":31,"Whether or not to copy hooked texts to clipboard":32,"MaxClipboardCopyCharacters":33,"Max number of characters to hook to clipboard at a time":34,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":35,"Indicates whether batching of translations should be enabled for supported endpoints":36,"Indicates whether or not to use translations from the included static translation cache":37,"Override Font":38,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":39,"Override Font TextMeshPro":40,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":41,"Resize UI Line Spacing Scale":42,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":43,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":44,"Ignore Text Starting With":45,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":46,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":47,"GameLog Text Paths":48,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":49,"Romaji Post Processing":50,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":51,"Translation Post Processing":52,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":53,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":54,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":55,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":56,"Indicates that the plugin should generate translations without variables when using substitutions.":57,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":58,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":59,"Indicates the plugin should not print out success messages in relation to translations.":60,"Blacklisted IMGUI Plugins":61,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":62,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":63,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":64,"Max Text Parser Recursion":65,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":66,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":67,"Will enable automated handling of rich text (text with markup).":68,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":69,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":70,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":71,"Redirected Resource Detection Strategy":72,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":73,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":74,"Texture":75,"Texture Directory":76,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":77,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":78,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":79,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":80,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":81,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":82,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":83,"Texture Hash Generation Strategy":84,"Indicates how the mod identifies pictures through hashes.":85,"Duplicate Texture Names":86,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":87,"Indicates if the plugin should detect duplicate texture names.":88,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":89,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":90,"Resource Redirector":91,"Preferred Storage Path":92,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":93,"Indicates if TextAssets should be redirected":94,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":95,"Indicates if translatable resources that are found should be dumped":96,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":97,"HTTP":98,"User Agent":99,"Override the user agent used by APIs requiring a user agent":100,"Indiciates whether certificate validations for the .NET API should be disabled":101,"Translation Aggregator":102,"Width":103,"The total width of the translation aggregator window":104,"Height":105,"The width (per translator) of the translation aggregator window.":106,"Enabled Translators":107,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":108,"Google":109,"ServiceUrl":110,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":111,"Google Legitimate":112,"Google API Key":113,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":114,"Bing Legitimate":115,"OcpApim Subscription Key":116,"OPTIONAL, needed if BingTranslateLegitimate is configured":117,"Baidu":118,"Baidu App Id":119,"OPTIONAL, needed if BaiduTranslate is configured":120,"BaiduAppSecret":121,"Yandex":122,"Yandex API Key":123,"OPTIONAL, needed if YandexTranslate is configured":124,"Watson":125,"Url":126,"OPTIONAL, needed if WatsonTranslate is configured":127,"Key":128,"DeepL":129,"MinDelay":130,"OPTIONAL, used for throttling DeepL":131,"MaxDelay":132,"DeepL Legitimate":133,"OPTIONAL, required if DeepLLegitimate is configured":134,"Custom":135,"Optional, needed if Custom Translated is configured":136,"Lec Power Translator 15":137,"InstallationPath":138,"Optional, needed if Lec Power Translator 15 is configured":139,"Debug":140,"Enables the console. Do not enable if other plugins (managers) handles this":141,"Enables extra logging for debugging purposes":142,"ezTrans":143,"Installation Path of ezTrans.":144,"Migrations":145,"Used to enable automatic migrations of this configuration file":146,"Tag":147,"Tag representing the last version this plugin was executed under. Do not edit":148},"tags":[],"relPath":"/addons/unityTrans/configEdit.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","Cần XUnity Translator để thực hiện hành động này\nVui lòng cài đặt nó qua Trình cài đặt Ứng dụng Bên thứ ba!"],["XUnity.AutoTranslator is found!","Đã tìm thấy XUnity.AutoTranslator!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++ phát hiện XUnity.AutoTranslator đã được cài đặt. Translator++ sẽ sử dụng dữ liệu dịch hiện có để bắt đầu một dự án dịch mới."],["XUnity.AutoTranslator is not found!","Không tìm thấy XUnity.AutoTranslator!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","Trình hướng dẫn sẽ chỉ dẫn bạn cài đặt XUnity.AutoTranslator vào trò chơi."],["Next","Tiếp theo"],["Given path: ","Đường dẫn đã cho: "],["\nis not an Unity game. Do you still want to proceed?","\nkhông phải là một trò chơi Unity. Bạn vẫn muốn tiếp tục?"],["Patch successfully installed!\r\n","Đã cài đặt bản vá thành công!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","Cấu hình sẽ được tạo khi bạn chơi trò chơi lần đầu tiên.\r\n"],["Open the game now?","Mở trò chơi ngay bây giờ?"],["Finish","Hoàn tất"],["Update current project?","Cập nhật dự án hiện tại?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":false,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"relPath":"/addons/unityTrans/unityTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","Số dòng tối đa trong hộp thông báo."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","Giá trị mặc định là 4. Nhập 0 để tắt tính năng này. Nếu số dòng trong hộp thông báo lớn hơn số này, Translator++ sẽ tạo một hộp thông báo mới để ngăn văn bản tràn ra ngoài hộp."],["Use shell copy if possible","Sử dụng sao chép shell nếu có thể"],["Use shell copy instead of native NodeJS copy handler.","Sử dụng sao chép shell thay vì trình xử lý sao chép NodeJS gốc."],["Use shell copy","Sử dụng sao chép shell"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","Trình chỉnh sửa WRPGE chưa được cài đặt\r\nVui lòng cài đặt từ menu T++ > Trình cài đặt ứng dụng bên thứ ba\r\n\r\nMở trình cài đặt ứng dụng bên thứ ba ngay bây giờ?"],["Unable to determina WRPGE path.","Không thể xác định đường dẫn WRPGE."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++ sắp cài đặt trình chỉnh sửa WRPGE trong thư mục đích.\r\nTiếp tục?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Đường dẫn phát triển chưa được xác định.\nBạn nên tiêm trò chơi một lần để tạo đường dẫn phát triển."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","Dịch trò chơi Wolf RPG lên đến phiên bản 3.330 với thư viện WolfJs. Bộ phân tích Wolf RPG mặc định cho Translator++."],["Wolf RPG Editor games","Trò chơi Wolf RPG Editor"],["Parsing Wolf RPG Game with","Đang phân tích trò chơi Wolf RPG với"],["Wolf RPG Editor game","Trò chơi Wolf RPG Editor"],["Select the game's executable file","Chọn tệp thực thi của trò chơi"],["Engine version","Phiên bản động cơ"],["Detected WolfRPG Engine version of the selected game","Đã phát hiện phiên bản WolfRPG Engine của trò chơi được chọn"],["Heads up!\r\n","Chú ý!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nkhông có vẻ là tệp thực thi Wolf RPG!\r\nBạn có chắc muốn bắt đầu dự án Wolf RPG từ điểm nhập này?"],["Create a new project","Tạo một dự án mới"],["Please specify a game to be processed!","Vui lòng chỉ định một trò chơi để xử lý!"],["Set dev path. Path to the directory of the translated game.","Đặt đường dẫn phát triển. Đường dẫn đến thư mục của trò chơi đã dịch."],["Play last build","Chơi bản dựng cuối cùng"],["Open editor","Mở trình chỉnh sửa"],["Open Wolf RPG Editor online manual","Mở hướng dẫn trực tuyến Wolf RPG Editor"],["Open Wolf RPG Editor english manual","Mở sách hướng dẫn tiếng Anh của Wolf RPG Editor"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","Không thể tìm thấy tệp sách hướng dẫn.\nVui lòng cài đặt Wolf RPG Editor thông qua trình cài đặt ứng dụng bên thứ ba."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":false,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"relPath":"/addons/wolfJs/wolfJs.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","Bắt đầu dịch từ tài liệu dạng XML. Hỗ trợ cả định dạng XML và HTML."],["Create project","Tạo dự án"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":false,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"relPath":"/addons/xmlTrans/xml.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","Công cụ dịch động cơ YU-RIS"],["Checking up requirements...","Đang kiểm tra yêu cầu..."],["Create a new translation project from YU-RIS visual novel engine","Tạo một dự án dịch mới từ động cơ visual novel YU-RIS"],["Next","Tiếp theo"],["Select YU-RIS game","Chọn trò chơi YU-RIS"],["Select the game's executable file","Chọn tệp thực thi của trò chơi"],["Engine version","Phiên bản động cơ"],["Detected YU-RIS version of the selected game","Đã phát hiện phiên bản YU-RIS của trò chơi đã chọn"],["Create a new project","Tạo một dự án mới"],["Invalid target game :","Trò chơi mục tiêu không hợp lệ:"],["Source material do not match the current translation project!","Tài liệu nguồn không khớp với dự án dịch hiện tại!"],["Select the repack method.","Chọn phương pháp đóng gói lại."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>Đóng gói lại vào tệp YPF gốc</b><br />Sẽ đóng gói lại bản dịch vào bản gốc. Có thể mất nhiều thời gian hơn để trích xuất bản gốc, vá nó với bản dịch và đóng gói lại.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>Đóng gói lại dưới dạng tệp vá YPF</b><br>Sẽ đóng gói lại bản dịch thành một tệp vá riêng biệt (ví dụ: update9.ypf). Bằng cách này, có thể dịch trò chơi mà không cần sửa đổi các tệp ypf gốc. Kết hợp điều này với tùy chọn <b>Không sao chép tài liệu, chỉ tiêm bản dịch</b> trong Sao chép tài liệu để quá trình vá nhanh hơn.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","Phiên bản đóng gói lại mục tiêu phải khớp với phiên bản trò chơi của bạn. Nhập phiên bản chính và phụ cách nhau bằng dấu chấm. Ví dụ: <b>0.466</b>. Mặc định, Translator++ sẽ phát hiện phiên bản động cơ khi bạn tạo dự án."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":false,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"relPath":"/addons/yurisParser/YurisParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","Trình tạo biểu mẫu"],["Run","Chạy"],["New Project (ctrl+n)","Dự án mới (ctrl+n)"],["Open (ctrl+o)","Mở (ctrl+o)"],["Save file (ctrl+s)","Lưu tệp (ctrl+s)"],["Save As (ctrl+shift+s)","Lưu thành (ctrl+shift+s)"],["Open debugger (F12)","Mở công cụ gỡ lỗi (F12)"],["Help","Trợ giúp"],["Select file in the current workspace","Chọn tệp trong không gian làm việc hiện tại"],["file path","đường dẫn tệp"],["Create shortcut of the current script","Tạo lối tắt cho tập lệnh hiện tại"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx