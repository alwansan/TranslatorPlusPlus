{"data":[[null]],"columns":[{"readOnly":false,"wordWrap":true,"width":200},{"readOnly":false,"wordWrap":true,"width":50},{"readOnly":false,"wordWrap":true,"width":134},{"readOnly":false,"wordWrap":true,"width":120},{"readOnly":false,"wordWrap":true,"width":109}],"colHeaders":["Original Text","Initial","Machine translation","Better translation","Best translation"],"project":{"indexOriginal":0,"gameEngine":"APPUI","files":{"/addons/VNTextPatch/vntextpatch.js":{"data":[["I have extracted the game data","Tôi đã trích xuất dữ liệu trò chơi"],["Load game's data folder","Tải thư mục dữ liệu trò chơi"],["Select the game's data folder","Chọn thư mục dữ liệu trò chơi"],["Engine Info","Thông tin Công cụ"],["Currently detected engine","Công cụ hiện đang được phát hiện"],["Manually Specify Format","Chỉ định Định dạng Thủ công"],["Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.","Chỉ định định dạng trò chơi thủ công.<br />VNTranslationTools sẽ tự động phát hiện định dạng dựa trên phần mở rộng tệp. Tuy nhiên, nếu bạn gặp phần mở rộng tệp mơ hồ, vui lòng cung cấp định dạng rõ ràng."],["Interface","Giao diện"],["VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.","VNTextPatch có thể phân tích trò chơi thành hai định dạng: JSON hoặc bảng tính XLSX. Vui lòng chọn giao diện bạn muốn sử dụng."],["Warning: There is a row limit if you're choosing XLSX spreadsheet.","Cảnh báo: Có giới hạn hàng nếu bạn chọn bảng tính XLSX."],["Create a new project","Tạo một dự án mới"],["Invalid destination directory:","Thư mục đích không hợp lệ:"],["Close","Đóng"],[null,null,null,null,null]],"context":[["tid/8164/type/StringLiteral"],["tid/8228/type/StringLiteral"],["tid/8233/type/StringLiteral"],["tid/8246/type/StringLiteral"],["tid/8251/type/StringLiteral"],["tid/8256/type/StringLiteral"],["tid/8261/type/StringLiteral"],["tid/8266/type/StringLiteral"],["tid/8271/type/StringLiteral"],["tid/8276/type/StringLiteral"],["tid/8455/type/StringLiteral"],["tid/8516/type/NoSubstitutionTemplate"],["tid/11110/type/StringLiteral"]],"basename":"vntextpatch.js","dirname":"/addons/VNTextPatch","extension":".js","filename":"vntextpatch.js","path":"/addons/VNTextPatch/vntextpatch.js","indexIsBuilt":true,"indexIds":{"I have extracted the game data":0,"Load game's data folder":1,"Select the game's data folder":2,"Engine Info":3,"Currently detected engine":4,"Manually Specify Format":5,"Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.":6,"Interface":7,"VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.":8,"Warning: There is a row limit if you're choosing XLSX spreadsheet.":9,"Create a new project":10,"Invalid destination directory:":11,"Close":12},"tags":[],"relPath":"/addons/VNTextPatch/vntextpatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[],"lastSelectedCell":[0,0]},"/addons/actionEditorParser/ae4parser.js":{"data":[["Start translation from Action Editor 4 Game","Bắt đầu dịch từ Action Editor 4 Game"],["Create Project","Tạo Dự án"]],"context":[["tid/920/type/StringLiteral"],["tid/997/type/StringLiteral"]],"basename":"ae4parser.js","dirname":"/addons/actionEditorParser","extension":".js","filename":"ae4parser.js","path":"/addons/actionEditorParser/ae4parser.js","indexIsBuilt":false,"indexIds":{"Start translation from Action Editor 4 Game":0,"Create Project":1},"tags":[],"relPath":"/addons/actionEditorParser/ae4parser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/adminTools/!post.html":{"data":[["Actions","Hành động"],["Build for 32bit system","Xây dựng cho hệ thống 32bit"],["Build for non developer build too","Xây dựng cho cả bản không phải nhà phát triển"],["Custom Version","Phiên bản Tùy chỉnh"],["Custom version (leave blank to autogenerate version)","Phiên bản tùy chỉnh (để trống để tự động tạo phiên bản)"],["Generate minor versioning?","Tạo phiên bản phụ?"],["Save patch to","Lưu bản vá vào"],["Destination folder of generated patch","Thư mục đích của bản vá được tạo"],["Overider template","Mẫu ghi đè"],["Release template","Mẫu phát hành"],["Select file to be available live and excluded from the package","Chọn tệp để có sẵn trực tiếp và loại trừ khỏi gói"],["The file will be excluded from package, but available online","Tệp sẽ bị loại trừ khỏi gói, nhưng có sẵn trực tuyến"],["Make the process does not require user input","Làm cho quá trình không yêu cầu đầu vào từ người dùng"],["Patch Type","Loại Bản Vá"],["The file will be excluded from package, but available online. Select the file you want to substitute.","Tệp sẽ bị loại trừ khỏi gói, nhưng có sẵn trực tuyến. Chọn tệp bạn muốn thay thế."],["Substitute trans.js with a fake one.","Thay thế trans.js bằng một tệp giả."],["Select Patch File","Chọn Tệp Bản Vá"],["Select the generated patch file (*.tpch).","Chọn tệp bản vá đã tạo (*.tpch)."],["Patches Links","Liên Kết Bản Vá"],["Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.","Tự động cập nhật sẽ tải xuống từ các liên kết này. <b>Phải là liên kết tải xuống trực tiếp!</b> Phân tách mỗi liên kết tải xuống bằng dòng mới."],["Download Links","Liên Kết Tải Xuống"],["Downloadable package for manual download. Separate each download link with newline.","Gói có thể tải xuống để tải thủ công. Phân tách mỗi liên kết tải xuống bằng dòng mới."],["Release Category","Danh Mục Phát Hành"],["Category of the release.","Danh mục của bản phát hành."],["Upload log along with this submission.","Tải lên nhật ký cùng với bản gửi này."],["Remove the same version found on database.","Xóa phiên bản giống nhau tìm thấy trong cơ sở dữ liệu."],["Whether this release is enabled or not.","Liệu bản phát hành này có được kích hoạt hay không."],["Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.","Liệu bản phát hành này có bị ẩn hay không. Nếu một bản phát hành bị ẩn, chỉ Quản trị viên và thành viên có khả năng <code>view_hidden_releases</code> (Nhà phát triển) mới có thể cài đặt bản phát hành thông qua trình cài đặt gói."],["Release Name","Tên Bản Phát Hành"],["Release Number","Số Bản Phát Hành"],["Release Date","Ngày Phát Hành"],["Release Key","Khóa Bản Phát Hành"],["Release Type","Loại Bản Phát Hành"],["CRC","CRC"],["Required Version","Phiên Bản Yêu Cầu"],["Minimum Version","Phiên Bản Tối Thiểu"],["Release Note","Ghi Chú Phát Hành"],["Release Info","Thông Tin Phát Hành"],["On Before Install","Trước Khi Cài Đặt"],["On After Install","Sau Khi Cài Đặt"],["Extra parameters","Tham Số Bổ Sung"],["Remote file","Tập Tin Từ Xa"],["List of remote file, separate by new line","Danh sách tập tin từ xa, phân cách bằng dòng mới"],["Patron Level","Cấp Độ Hội Viên"],["Post title","Tiêu Đề Bài Viết"],["Release post","Bài đăng phát hành"],["Excerpt of the post","Trích dẫn bài đăng"]],"context":[["idx/0/innerText","idx/14/innerText","idx/29/innerText","idx/79/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/16/innerText"],["idx/5/innerText","idx/17/innerText"],["idx/6/innerText","idx/18/innerText"],["idx/7/innerText","idx/19/innerText"],["idx/8/innerText","idx/20/innerText"],["idx/9/innerText","idx/21/innerText"],["idx/10/innerText","idx/22/innerText"],["idx/11/innerText","idx/25/innerText"],["idx/12/innerText"],["idx/13/innerText","idx/28/innerText"],["idx/23/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/45/innerText"],["idx/47/innerText"],["idx/49/innerText"],["idx/51/innerText"],["idx/53/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/59/innerText"],["idx/61/innerText"],["idx/63/innerText"],["idx/65/innerText"],["idx/67/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/73/innerText"],["idx/75/innerText"],["idx/77/innerText"]],"basename":"!post.html","dirname":"/addons/adminTools","extension":".html","filename":"!post.html","path":"/addons/adminTools/!post.html","indexIsBuilt":false,"indexIds":{"Actions":0,"":1,"Build for 32bit system":2,"Build for non developer build too":3,"Custom Version":4,"Custom version (leave blank to autogenerate version)":5,"Generate minor versioning?":6,"Save patch to":7,"Destination folder of generated patch":8,"Overider template":9,"Release template":10,"Select file to be available live and excluded from the package":11,"The file will be excluded from package, but available online":12,"Make the process does not require user input":13,"Patch Type":14,"The file will be excluded from package, but available online. Select the file you want to substitute.":15,"Substitute trans.js with a fake one.":16,"Select Patch File":17,"Select the generated patch file (*.tpch).":18,"Patches Links":19,"Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.":20,"Download Links":21,"Downloadable package for manual download. Separate each download link with newline.":22,"Release Category":23,"Category of the release.":24,"Upload log along with this submission.":25,"Remove the same version found on database.":26,"Whether this release is enabled or not.":27,"Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.":28,"Release Name":29,"Release Number":30,"Release Date":31,"Release Key":32,"Release Type":33,"CRC":34,"Required Version":35,"Minimum Version":36,"Release Note":37,"Release Info":38,"On Before Install":39,"On After Install":40,"Extra parameters":41,"Remote file":42,"List of remote file, separate by new line":43,"Patron Level":44,"Post title":45,"Release post":46,"Excerpt of the post":47},"tags":[],"relPath":"/addons/adminTools/!post.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":47,"length":47,"percent":100},"parameters":[]},"/addons/adminTools/!postPackage.html":{"data":[["Select package json file","Chọn tệp json gói"],["Select the generated patch file","Chọn tệp vá đã tạo"],["Or Select Destination File","Hoặc Chọn Tệp Đích"],["Or Download location","Hoặc Vị trí Tải xuống"],["Icon","Biểu tượng"],["Author","Tác giả"],["Name","Tên"],["name of the package.","tên của gói."],["Title","Tiêu đề"],["Title of the package.","Tiêu đề của gói."],["Version","Phiên bản"],["Version of the package.","Phiên bản của gói."],["Description","Mô tả"],["Description of the package.","Mô tả của gói."],["Whether this release is active or not.","Liệu bản phát hành này có đang hoạt động hay không."],["Whether this release is hidden or not.","Liệu bản phát hành này có bị ẩn hay không."],["Patron Level","Cấp độ Patron"],["Current month's pledge in $","Cam kết tháng hiện tại bằng $"],["Patron Points","Điểm Hội Viên"],["100pts = 1$","100 điểm = 1$"],["Purchase type","Loại mua hàng"],["Type of the purchase.","Loại của giao dịch mua."],["On Before Install","Trước Khi Cài Đặt"],["Javascript code to be run before install","Mã Javascript sẽ được chạy trước khi cài đặt"],["On After Install","Sau Khi Cài Đặt"],["Javascript code to be run after install","Mã Javascript sẽ được chạy sau khi cài đặt"],["Manifest","Bản Kê Khai"],["Manifest data","Dữ liệu bản kê khai"],["Minimum version","Phiên bản tối thiểu"],["Minimum version of Translator++ to be able to insatall this addon.","Phiên bản tối thiểu của Translator++ để có thể cài đặt tiện ích này."],["Release Date","Ngày Phát Hành"],["Is parser changed?","Trình phân tích có thay đổi?"],["Mark as parser change. Would warn the user to backup their project before updating to this addon.","Đánh dấu là thay đổi trình phân tích. Sẽ cảnh báo người dùng sao lưu dự án của họ trước khi cập nhật tiện ích này."],["Remove the same version found on database.","Xóa phiên bản giống nhau tìm thấy trong cơ sở dữ liệu."],["Excluded files","Tệp bị loại trừ"],["Files listed here will be excluded from the distribution packages","Các tệp được liệt kê ở đây sẽ bị loại trừ khỏi gói phân phối"],["Script URL","URL Script"],["Script of the URL.","Script của URL."],["Upload script","Tải lên kịch bản"],["This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t","Kịch bản này sẽ được tải lên máy chủ và xử lý với mẫu kịch bản [php]Scripts.\n\t\t\t\t\tĐể sử dụng tính năng này:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Tạo một trang wordpress với mẫu <b>[php]Scripts template</b>.<br>Bạn cũng có thể đặt yêu cầu patreon để xem bài viết.</li>\n\t\t\t\t\t\t<li>Thêm URL của trang vào tệp package.json với tham số <b>l</b> GET trỏ đến tệp cục bộ.<br>\n\t\t\t\t\t\tVí dụ: <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t"],["Actions","Hành động"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/3/innerText"],["idx/2/innerText"],["idx/4/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/47/innerText"]],"basename":"!postPackage.html","dirname":"/addons/adminTools","extension":".html","filename":"!postPackage.html","path":"/addons/adminTools/!postPackage.html","indexIsBuilt":false,"indexIds":{"Select package json file":0,"Select the generated patch file":1,"Or Select Destination File":2,"Or Download location":3,"":4,"Icon":5,"Author":6,"Name":7,"name of the package.":8,"Title":9,"Title of the package.":10,"Version":11,"Version of the package.":12,"Description":13,"Description of the package.":14,"Whether this release is active or not.":15,"Whether this release is hidden or not.":16,"Patron Level":17,"Current month's pledge in $":18,"Patron Points":19,"100pts = 1$":20,"Purchase type":21,"Type of the purchase.":22,"On Before Install":23,"Javascript code to be run before install":24,"On After Install":25,"Javascript code to be run after install":26,"Manifest":27,"Manifest data":28,"Minimum version":29,"Minimum version of Translator++ to be able to insatall this addon.":30,"Release Date":31,"Is parser changed?":32,"Mark as parser change. Would warn the user to backup their project before updating to this addon.":33,"Remove the same version found on database.":34,"Excluded files":35,"Files listed here will be excluded from the distribution packages":36,"Script URL":37,"Script of the URL.":38,"Upload script":39,"This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t":40,"Actions":41},"tags":[],"relPath":"/addons/adminTools/!postPackage.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":41,"length":41,"percent":100},"parameters":[]},"/addons/adminTools/adminTools.js":{"data":[["Close","Đóng"]],"context":[["tid/588/type/StringLiteral"]],"basename":"adminTools.js","dirname":"/addons/adminTools","extension":".js","filename":"adminTools.js","path":"/addons/adminTools/adminTools.js","indexIsBuilt":false,"indexIds":{"Close":0},"tags":[],"relPath":"/addons/adminTools/adminTools.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/aec/aec.js":{"data":[["Universal Archive Unpacker","Trình giải nén lưu trữ phổ quát"]],"context":[["tid/1001/type/StringLiteral","tid/1239/type/StringLiteral"]],"basename":"aec.js","dirname":"/addons/aec","extension":".js","filename":"aec.js","path":"/addons/aec/aec.js","indexIsBuilt":false,"indexIds":{"Universal Archive Unpacker":0},"tags":[],"relPath":"/addons/aec/aec.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/bakinParser/bakin-proxy.js":{"data":[["Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.","Trích xuất từ điển trò chơi Bakin từ data.rbpack, dịch dic.txt và tự động vá trình phát."],["Create project","Tạo dự án"],["Error: customField is not defined. This should not happen!","Lỗi: customField không được định nghĩa. Điều này không nên xảy ra!"],["Please select the Bakin game executable.","Vui lòng chọn tệp thực thi trò chơi Bakin."],["<h2>Proxy workflow</h2>","<h2>Quy trình proxy</h2>"],["Translator++ unpacks data.rbpack into a temporary folder.","Translator++ giải nén data.rbpack vào một thư mục tạm thời."],["Split Dictionary uses dump-split and creates one .txt file per source area by default.","Tách Từ điển sử dụng dump-split và tạo một tệp .txt cho mỗi vùng nguồn theo mặc định."],["Merge Dictionary uses a single dic.txt.","Gộp Từ điển sử dụng một dic.txt duy nhất."],["Injection merges split dictionaries back into data/dic.txt and patches the player executable.","Tiêm hợp nhất các từ điển đã tách trở lại data/dic.txt và vá tệp thực thi trình phát."],["Split Dictionary (default)","Tách Từ điển (mặc định)"],["Merge Dictionary","Gộp Từ điển"]],"context":[["tid/2860/type/StringLiteral"],["tid/2929/type/StringLiteral"],["tid/2966/type/StringLiteral"],["tid/3002/type/StringLiteral"],["tid/3253/type/NoSubstitutionTemplate"],["tid/3266/type/StringLiteral"],["tid/3277/type/StringLiteral"],["tid/3288/type/StringLiteral"],["tid/3299/type/StringLiteral"],["tid/3383/type/StringLiteral"],["tid/3393/type/StringLiteral"]],"basename":"bakin-proxy.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-proxy.js","path":"/addons/bakinParser/bakin-proxy.js","indexIsBuilt":false,"indexIds":{"Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the Bakin game executable.":3,"<h2>Proxy workflow</h2>":4,"Translator++ unpacks data.rbpack into a temporary folder.":5,"Split Dictionary uses dump-split and creates one .txt file per source area by default.":6,"Merge Dictionary uses a single dic.txt.":7,"Injection merges split dictionaries back into data/dic.txt and patches the player executable.":8,"Split Dictionary (default)":9,"Merge Dictionary":10},"tags":[],"relPath":"/addons/bakinParser/bakin-proxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/bakinParser/bakin-xlsx.js":{"data":[["Start a translation project from RPG Developer Bakin localization sheet (xlsx).","Bắt đầu một dự án dịch từ bảng địa phương hóa RPG Developer Bakin (xlsx)."],["Create project","Tạo dự án"],["Error: customField is not defined. This should not happen!","Lỗi: customField không được định nghĩa. Điều này không nên xảy ra!"],["Please select the entry point to translate.","Vui lòng chọn điểm vào để dịch."],["<h2>RPG Developer Bakin editor is required</h2>","<h2>Trình chỉnh sửa RPG Developer Bakin là bắt buộc</h2>"],["RPG Developer Bakin editor is required to start the translation project.","Trình chỉnh sửa RPG Developer Bakin là bắt buộc để bắt đầu dự án dịch."],["<h2>Before you start</h2>","<h2>Trước khi bạn bắt đầu</h2>"],["<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.","<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Giải nén trò chơi của bạn</a> thành dự án RPG Developer Bakin có thể chỉnh sửa."],["Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.","Xuất các chuỗi bản địa hóa bằng cách sử dụng ứng dụng RPG Developer Bakin vào một tệp xlsx. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">Xem hướng dẫn ở đây về cách dịch trò chơi Bakin</a>."]],"context":[["tid/614/type/StringLiteral"],["tid/683/type/StringLiteral"],["tid/720/type/StringLiteral"],["tid/756/type/StringLiteral"],["tid/1034/type/NoSubstitutionTemplate"],["tid/1041/type/NoSubstitutionTemplate"],["tid/1064/type/NoSubstitutionTemplate"],["tid/1077/type/NoSubstitutionTemplate"],["tid/1088/type/NoSubstitutionTemplate"]],"basename":"bakin-xlsx.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-xlsx.js","path":"/addons/bakinParser/bakin-xlsx.js","indexIsBuilt":false,"indexIds":{"Start a translation project from RPG Developer Bakin localization sheet (xlsx).":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the entry point to translate.":3,"<h2>RPG Developer Bakin editor is required</h2>":4,"RPG Developer Bakin editor is required to start the translation project.":5,"<h2>Before you start</h2>":6,"<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.":7,"Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.":8},"tags":[],"relPath":"/addons/bakinParser/bakin-xlsx.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/basicUtils.js":{"data":[["NWJS Version","Phiên bản NWJS"],["Change into this NWJS version","Chuyển sang phiên bản NWJS này"],["Use Developer version","Sử dụng phiên bản Nhà phát triển"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","Sử dụng phiên bản NWJS Nhà phát triển. Phiên bản Nhà phát triển có các công cụ dành cho nhà phát triển sẵn có. Phù hợp cho việc gỡ lỗi và phát triển."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Trong phiên bản Nhà phát triển, bạn có thể sử dụng <b>Bảng điều khiển Nhà phát triển</b>. Bảng điều khiển Nhà phát triển có thể được truy cập bằng cách nhấn F12 hoặc nhấp chuột phải vào ứng dụng và chọn 'Kiểm tra'."],["Use 32-bit version","Sử dụng phiên bản 32-bit"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","Sử dụng phiên bản 32-bit của NWJS. Phiên bản 32-bit hữu ích cho khả năng tương thích với các hệ thống cũ. Khuyến nghị bỏ chọn tùy chọn này nếu có thể (chỉ cần nâng cấp máy của bạn, anh bạn)."],["Some Translator++ feature may not work across NWJS version","Một số tính năng của Translator++ có thể không hoạt động trên các phiên bản NWJS"],["Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.","Xin lưu ý rằng một số tính năng của Translator++ có thể không hoạt động trên các phiên bản NWJS. Hãy đảm bảo kiểm tra dự án của bạn sau khi thay đổi phiên bản NWJS."],["You're currently running on NWJS ver.","Bạn đang chạy trên phiên bản NWJS"],["Change Translator++ Core NWJS version","Thay đổi phiên bản NWJS lõi của Translator++"],["You're already using the selected NWJS version.","Bạn đã sử dụng phiên bản NWJS đã chọn."],["This operation will close Translator++ and change the current NW.js version into","Thao tác này sẽ đóng Translator++ và thay đổi phiên bản NW.js hiện tại thành"],["If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?","Nếu bạn có bất kỳ thay đổi chưa lưu nào, vui lòng chọn 'Hủy' và lưu dự án của bạn trước.\nBạn có muốn tiếp tục không?"]],"context":[["tid/1342/type/StringLiteral"],["tid/1352/type/StringLiteral"],["tid/1428/type/StringLiteral","tid/1617/type/StringLiteral"],["tid/1438/type/StringLiteral"],["tid/1449/type/StringLiteral"],["tid/1482/type/StringLiteral","tid/1641/type/StringLiteral"],["tid/1492/type/StringLiteral"],["tid/1532/type/NoSubstitutionTemplate"],["tid/1537/type/NoSubstitutionTemplate"],["tid/1542/type/StringLiteral"],["tid/1669/type/NoSubstitutionTemplate"],["tid/1745/type/NoSubstitutionTemplate"],["tid/1769/type/NoSubstitutionTemplate"],["tid/1782/type/NoSubstitutionTemplate"]],"basename":"basicUtils.js","dirname":"/addons/basicUtils","extension":".js","filename":"basicUtils.js","path":"/addons/basicUtils/basicUtils.js","indexIsBuilt":false,"indexIds":{"NWJS Version":0,"Change into this NWJS version":1,"Use Developer version":2,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":3,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":4,"Use 32-bit version":5,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":6,"Some Translator++ feature may not work across NWJS version":7,"Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.":8,"You're currently running on NWJS ver.":9,"Change Translator++ Core NWJS version":10,"You're already using the selected NWJS version.":11,"This operation will close Translator++ and change the current NW.js version into":12,"If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?":13},"tags":[],"relPath":"/addons/basicUtils/basicUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/basicUtils/mainMenu.js":{"data":[["Change Language","Thay đổi Ngôn ngữ"],["No MTL available for this language pair","Không có MTL khả dụng cho cặp ngôn ngữ này"],["Change default MTL for this project","Thay đổi MTL mặc định cho dự án này"],["???","???"],["Search in a folder","Tìm kiếm trong một thư mục"],["Search in Staging Files","Tìm kiếm trong Tệp Staging"],["Search in Original Files","Tìm kiếm trong Tệp Gốc"],["No original files path is set for this project.","Không có đường dẫn tệp gốc nào được đặt cho dự án này."],["Search in Translated Files","Tìm kiếm trong Tệp Đã Dịch"],["No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.","Không có đường dẫn tệp đã dịch nào được đặt cho dự án này.\nBạn cần tiêm bản dịch của mình một lần để đặt đường dẫn tệp đã dịch."],["Chat with AI Assistant","Trò chuyện với Trợ lý AI"],["AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.","Trợ lý AI không khả dụng vì các tính năng mới chưa được tải.\nVui lòng cài đặt lại hoặc cập nhật lại Translator++."]],"context":[["tid/442/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/974/type/StringLiteral"],["tid/1182/type/StringLiteral"],["tid/1339/type/StringLiteral"],["tid/1404/type/StringLiteral"],["tid/1501/type/StringLiteral"],["tid/1539/type/StringLiteral"],["tid/1624/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1777/type/StringLiteral"],["tid/1812/type/StringLiteral"]],"basename":"mainMenu.js","dirname":"/addons/basicUtils","extension":".js","filename":"mainMenu.js","path":"/addons/basicUtils/mainMenu.js","indexIsBuilt":false,"indexIds":{"Change Language":0,"No MTL available for this language pair":1,"Change default MTL for this project":2,"???":3,"Search in a folder":4,"Search in Staging Files":5,"Search in Original Files":6,"No original files path is set for this project.":7,"Search in Translated Files":8,"No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.":9,"Chat with AI Assistant":10,"AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.":11},"tags":[],"relPath":"/addons/basicUtils/mainMenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":12,"length":12,"percent":100},"parameters":[]},"/addons/basicUtils/utils/HTMLPacker.js":{"data":[["Path is not a file:","Đường dẫn không phải là tệp:"],["Icon path is not a file:","Đường dẫn biểu tượng không phải là tệp:"],["Path is not an exe file:","Đường dẫn không phải là tệp exe:"],["Icon path is not an ico file:","Đường dẫn biểu tượng không phải là tệp ico:"],["Html entry point","Điểm nhập Html"],["Select the html entry point file (usually index.html)","Chọn tệp điểm nhập html (thường là index.html)"],["Destination folder","Thư mục đích"],["Select destination folder. The process will replace the existing files.","Chọn thư mục đích. Quá trình sẽ thay thế các tệp hiện có."],["NWJS version","Phiên bản NWJS"],["Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.","Tùy chọn. Chọn phiên bản NWJS và kiến trúc.<br />Phiên bản mới nhất không phải lúc nào cũng tốt hơn, chỉ cần dùng cái phù hợp với bạn."],["Application ID","ID ứng dụng"],["Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.","Đặt ID ứng dụng cho trò chơi. ID phải viết thường và chỉ được chứa chữ cái, số và dấu gạch dưới."],["Application description","Mô tả ứng dụng"],["Set the application description for the game.","Đặt mô tả ứng dụng cho trò chơi."],["Window title","Tiêu đề cửa sổ"],["Set the default window title for the game.<br />This value may be overridden by the game engine.","Đặt tiêu đề cửa sổ mặc định cho trò chơi.<br />Giá trị này có thể bị ghi đè bởi engine trò chơi."],["Window width","Chiều rộng cửa sổ"],["Set the default window width for the game.","Đặt chiều rộng cửa sổ mặc định cho trò chơi."],["Window height","Chiều cao cửa sổ"],["Set the default window height for the game.","Đặt chiều cao cửa sổ mặc định cho trò chơi."],["Full screen","Toàn màn hình"],["Set the game to start in full screen mode.","Đặt trò chơi khởi động ở chế độ toàn màn hình."],["Resizable","Có thể thay đổi kích thước"],["Set the game window to be resizable.","Đặt cửa sổ trò chơi có thể thay đổi kích thước."],["Game icon","Biểu tượng trò chơi"],["Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.","Chọn tệp biểu tượng cho tệp thực thi trò chơi. Tệp biểu tượng phải ở định dạng .ico. Biểu tượng sẽ được nhúng vào tệp thực thi trò chơi."],["Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.","Thông qua biểu mẫu này, bạn có thể tạo một gói trò chơi có thể chơi được. <br />Quá trình sẽ thay thế các tệp hiện có trong thư mục đích."],["Start the application in full screen mode","Khởi động ứng dụng ở chế độ toàn màn hình"],["Allow the application to be resizable","Cho phép ứng dụng có thể thay đổi kích thước"],["HTML Compiler","Trình Biên Dịch HTML"],["Compile","Biên Dịch"],["Source path can not empty","Đường dẫn nguồn không được để trống"],["Destination path can not empty","Đường dẫn đích không được để trống"]],"context":[["tid/86/type/StringLiteral","tid/4136/type/StringLiteral"],["tid/116/type/StringLiteral"],["tid/151/type/StringLiteral"],["tid/186/type/StringLiteral"],["tid/2424/type/StringLiteral"],["tid/2434/type/StringLiteral"],["tid/2474/type/StringLiteral"],["tid/2484/type/StringLiteral"],["tid/2524/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2587/type/StringLiteral"],["tid/2597/type/StringLiteral"],["tid/2631/type/StringLiteral","tid/3795/type/StringLiteral"],["tid/2641/type/StringLiteral","tid/3805/type/StringLiteral"],["tid/2675/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2722/type/StringLiteral"],["tid/2732/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2810/type/StringLiteral"],["tid/2820/type/StringLiteral"],["tid/2854/type/StringLiteral"],["tid/2864/type/StringLiteral"],["tid/2899/type/StringLiteral"],["tid/2909/type/StringLiteral"],["tid/2950/type/NoSubstitutionTemplate"],["tid/3900/type/StringLiteral"],["tid/3924/type/StringLiteral"],["tid/4020/type/StringLiteral"],["tid/4037/type/StringLiteral"],["tid/4083/type/StringLiteral"],["tid/4104/type/StringLiteral"]],"basename":"HTMLPacker.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"HTMLPacker.js","path":"/addons/basicUtils/utils/HTMLPacker.js","indexIsBuilt":false,"indexIds":{"Path is not a file:":0,"Icon path is not a file:":1,"Path is not an exe file:":2,"Icon path is not an ico file:":3,"Html entry point":4,"Select the html entry point file (usually index.html)":5,"Destination folder":6,"Select destination folder. The process will replace the existing files.":7,"NWJS version":8,"Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.":9,"Application ID":10,"Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.":11,"Application description":12,"Set the application description for the game.":13,"Window title":14,"Set the default window title for the game.<br />This value may be overridden by the game engine.":15,"Window width":16,"Set the default window width for the game.":17,"Window height":18,"Set the default window height for the game.":19,"Full screen":20,"Set the game to start in full screen mode.":21,"Resizable":22,"Set the game window to be resizable.":23,"Game icon":24,"Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.":25,"Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.":26,"Start the application in full screen mode":27,"Allow the application to be resizable":28,"HTML Compiler":29,"Compile":30,"Source path can not empty":31,"Destination path can not empty":32},"tags":[],"relPath":"/addons/basicUtils/utils/HTMLPacker.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/basicUtils/utils/Updater.js":{"data":[["An update is being installed. Please do not close the application until the installation is completed.","Đang cài đặt bản cập nhật. Vui lòng không đóng ứng dụng cho đến khi cài đặt hoàn tất."],["Package Path","Đường Dẫn Gói"],["Select the package file.","Chọn tệp gói."],["Package Key","Khóa Gói"],["If you have the key, please enter it here. If not, leave it empty.","Nếu bạn có khóa, hãy nhập vào đây. Nếu không, hãy để trống."],["Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.","Thông qua biểu mẫu này, bạn có thể cập nhật Translator++ bằng tệp gói cập nhật. Bạn có thể tải gói cập nhật <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>tại đây</a>."],["Update from package","Cập nhật từ gói"],["Update","Cập nhật"],["Update Translator++","Cập nhật Translator++"]],"context":[["tid/4918/type/StringLiteral"],["tid/6562/type/StringLiteral"],["tid/6572/type/StringLiteral"],["tid/6612/type/StringLiteral"],["tid/6622/type/StringLiteral"],["tid/6661/type/NoSubstitutionTemplate"],["tid/6753/type/StringLiteral","tid/7195/type/StringLiteral"],["tid/6770/type/StringLiteral","tid/7091/type/StringLiteral"],["tid/7120/type/StringLiteral"]],"basename":"Updater.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"Updater.js","path":"/addons/basicUtils/utils/Updater.js","indexIsBuilt":false,"indexIds":{"An update is being installed. Please do not close the application until the installation is completed.":0,"Package Path":1,"Select the package file.":2,"Package Key":3,"If you have the key, please enter it here. If not, leave it empty.":4,"Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.":5,"Update from package":6,"Update":7,"Update Translator++":8},"tags":[],"relPath":"/addons/basicUtils/utils/Updater.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/utils/info.js":{"data":[["You have ","Bạn có "],[" missed update(s)!"," bản cập nhật đã bỏ lỡ!"],["Translator++ will update itself if auto-update is enabled.","Translator++ sẽ tự cập nhật nếu tính năng tự động cập nhật được bật."],["You can download the latest core version of Translator++ at","Bạn có thể tải phiên bản lõi mới nhất của Translator++ tại"],["This update is available for all patrons.","Bản cập nhật này có sẵn cho tất cả nhà tài trợ."],["This update is available for tier $","Bản cập nhật này có sẵn cho nhà tài trợ cấp $"],[" patrons or greater."," trở lên."],["You're up-to-date!","Bạn đã cập nhật!"],["Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!","Cảm ơn bạn đã luôn cập nhật với Translator++! Bạn đang ở phiên bản mới nhất, và chúng tôi trân trọng sự hỗ trợ của bạn. Hãy tận hưởng việc dịch thuật!"],["Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.","Một số thông tin cập nhật có thể được hiển thị từ bộ nhớ cache. Bạn có thể nhấp vào <b>'Kiểm tra cập nhật'</b> để tải chi tiết phiên bản mới nhất."],["When the same version is available","Khi có cùng phiên bản"],["Allow Translator++ to reinstall the same version of Translator++.","Cho phép Translator++ cài đặt lại cùng phiên bản của Translator++."],["Allow reinstall the same version","Cho phép cài đặt lại cùng phiên bản"],["Update Settings","Cài đặt Cập nhật"],["Update Now","Cập nhật Ngay"],["Updater is not available, please update Translator++ manually.","Trình cập nhật không khả dụng, vui lòng cập nhật Translator++ thủ công."],["Updating Translator++","Đang cập nhật Translator++"],["Please don't close Translator++ until the update process is finished.","Vui lòng không đóng Translator++ cho đến khi quá trình cập nhật hoàn tất."],["Can not update, reason :\n","Không thể cập nhật, lý do :\n"],["You may need to reconnect Translator++ with your Patreon account (logout and login again).","Bạn có thể cần kết nối lại Translator++ với tài khoản Patreon của mình (đăng xuất và đăng nhập lại)."],["Also, it has been reported that some countries such as mainland China are blocking dropbox repository.","Ngoài ra, đã có báo cáo rằng một số quốc gia như Trung Quốc đại lục đang chặn kho lưu trữ dropbox."],["If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:","Nếu vì lý do nào đó bạn không thể truy cập kho lưu trữ của chúng tôi, vui lòng tải xuống gói cập nhật (tệp tpch) thủ công bằng proxy hoặc VPN tại đây:"],["After that, please use the \"Update from package\" feature to update your Translator++.","Sau đó, vui lòng sử dụng tính năng \"Cập nhật từ gói\" để cập nhật Translator++ của bạn."],["If you still have problems, please contact us at our Discord server : ","Nếu bạn vẫn gặp vấn đề, vui lòng liên hệ với chúng tôi tại máy chủ Discord của chúng tôi : "],["Restart","Khởi động lại"],["Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.","Bạn có muốn khởi động lại Translator++ ngay bây giờ?\nNếu bạn có công việc chưa lưu, hãy hủy hộp thoại này và lưu công việc của bạn trước."],["Check for Update","Kiểm tra Cập nhật"],["Close","Đóng"]],"context":[["tid/649/type/StringLiteral"],["tid/660/type/StringLiteral"],["tid/665/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/1033/type/StringLiteral"],["tid/1077/type/StringLiteral"],["tid/1088/type/StringLiteral"],["tid/1665/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1675/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1765/type/StringLiteral"],["tid/1811/type/StringLiteral"],["tid/1873/type/StringLiteral"],["tid/2021/type/StringLiteral"],["tid/2066/type/StringLiteral"],["tid/2116/type/StringLiteral"],["tid/2130/type/StringLiteral"],["tid/2176/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2220/type/StringLiteral"],["tid/2245/type/NoSubstitutionTemplate"],["tid/2259/type/StringLiteral"],["tid/2357/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2449/type/StringLiteral"],["tid/2512/type/StringLiteral"]],"basename":"info.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"info.js","path":"/addons/basicUtils/utils/info.js","indexIsBuilt":false,"indexIds":{"You have ":0," missed update(s)!":1,"Translator++ will update itself if auto-update is enabled.":2,"You can download the latest core version of Translator++ at":3,"This update is available for all patrons.":4,"This update is available for tier $":5," patrons or greater.":6,"You're up-to-date!":7,"Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!":8,"Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.":9,"When the same version is available":10,"Allow Translator++ to reinstall the same version of Translator++.":11,"Allow reinstall the same version":12,"Update Settings":13,"Update Now":14,"Updater is not available, please update Translator++ manually.":15,"Updating Translator++":16,"Please don't close Translator++ until the update process is finished.":17,"Can not update, reason :\n":18,"You may need to reconnect Translator++ with your Patreon account (logout and login again).":19,"Also, it has been reported that some countries such as mainland China are blocking dropbox repository.":20,"If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:":21,"After that, please use the \"Update from package\" feature to update your Translator++.":22,"If you still have problems, please contact us at our Discord server : ":23,"Restart":24,"Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.":25,"Check for Update":26,"Close":27},"tags":[],"relPath":"/addons/basicUtils/utils/info.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":28,"length":28,"percent":100},"parameters":[]},"/addons/basicUtils/utils/uiTags.js":{"data":[["Do not process row with selected tag (blacklist)","Không xử lý hàng có thẻ đã chọn (danh sách đen)"],["Only process row with selected tag (whitelist)","Chỉ xử lý hàng có thẻ đã chọn (danh sách trắng)"],["Ignore tag","Bỏ qua thẻ"],["Load last selection","Tải lựa chọn cuối cùng"],["Reset","Đặt lại"],["Cancel","Hủy"],["Confirm","Xác nhận"]],"context":[["tid/55/type/StringLiteral"],["tid/60/type/StringLiteral"],["tid/65/type/StringLiteral"],["tid/410/type/StringLiteral"],["tid/415/type/StringLiteral"],["tid/2085/type/StringLiteral"],["tid/2137/type/StringLiteral"]],"basename":"uiTags.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"uiTags.js","path":"/addons/basicUtils/utils/uiTags.js","indexIsBuilt":false,"indexIds":{"Do not process row with selected tag (blacklist)":0,"Only process row with selected tag (whitelist)":1,"Ignore tag":2,"Load last selection":3,"Reset":4,"Cancel":5,"Confirm":6},"tags":[],"relPath":"/addons/basicUtils/utils/uiTags.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/customParser/CustomParserLoader.js":{"data":[["List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.","Danh sách các mã hóa ký tự có thể. <b>Thứ tự có quan trọng!</b>. Phân tách mỗi giá trị bằng dấu phẩy.<br />Translator++ sẽ đọc tệp gốc với các mã hóa sau, vá các tệp và ghi với tùy chọn <b>Mã hóa ký tự ghi</b>. Để trống để sử dụng mã hóa ký tự gốc khi dự án được tạo."],["For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>","Để hỗ trợ BOM, thêm một khoảng trắng sau mã hóa. Ví dụ: <code>utf8 bom</code>"],["Example: utf8,utf8 bom,utf16le,ascii","Ví dụ: utf8,utf8 bom,utf16le,ascii"],["Select the target character encoding.","Chọn mã hóa ký tự mục tiêu."]],"context":[["tid/3375/type/NoSubstitutionTemplate"],["tid/3383/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/4740/type/StringLiteral"]],"basename":"CustomParserLoader.js","dirname":"/addons/customParser","extension":".js","filename":"CustomParserLoader.js","path":"/addons/customParser/CustomParserLoader.js","indexIsBuilt":false,"indexIds":{"List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.":0,"For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>":1,"Example: utf8,utf8 bom,utf16le,ascii":2,"Select the target character encoding.":3},"tags":[],"relPath":"/addons/customParser/CustomParserLoader.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.html":{"data":[["<i class=\"icon-edit\"></i>","<i class=\"icon-edit\"></i>"],["<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>","<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Thêm một nhóm tệp mới</label>"],["Add a new file group","Thêm một nhóm tệp mới"],["<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>","<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Xóa nhóm tệp hiện tại</label>"],["Remove current file group","Xóa nhóm tệp hiện tại"],["Rules","Quy tắc"],["Hooks","Móc"],["Options","Tùy chọn"],["Testing","Kiểm tra"],["Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>","Nội suy chuỗi trước khi hiển thị trên ô. <b>To Grid</b> là đối lập của <b>From Grid</b>"],["Example","Ví dụ"],["For example, the text obtained from the parser is as follows:","Ví dụ, văn bản thu được từ trình phân tích như sau:"],["In this grid it will look like this:","Trong lưới này, nó sẽ trông như thế này:"],["That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n","Đó không phải là văn bản dễ làm việc nhất.<br>\n  Chúng ta có thể sửa điều đó bằng cách khai báo <span class=\"inlineCode\">To Grid hooks</span> như sau:\n"],["With the hook above the text in the grid will be :","Với hook trên, văn bản trong lưới sẽ là:"],["Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.","Nội suy chuỗi từ các ô vào kết quả dịch. <b>From Grid</b> là đối lập của <b>To Grid</b>."],["\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n","\n  Ví dụ, chuỗi dịch mong đợi nên ở định dạng JSON.<br>\n  Nhưng viết bản dịch ở định dạng JSON không thực sự dễ dàng nhất. <br>\n  Vì vậy, thay vì yêu cầu người dịch dịch ở định dạng JSON, chúng ta có thể chỉ yêu cầu họ gõ bình thường, và thêm một <span class=\"inlineCode\">From Grid hook</span> như sau:\n"],["\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n","\n  Với <span class=\"inlineCode\">From Grid hook</span> ở trên, bản dịch sau ...\n"],["...will be converted into desired format: ","...sẽ được chuyển đổi thành định dạng mong muốn: "],["Edit the translated text just before writing it into a file.","Chỉnh sửa văn bản đã dịch ngay trước khi ghi vào tệp."],["Parameters","Tham số"],["\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ","\n              <h3 data-tran=\"\">văn bản</h3>\n              <p data-tran=\"\">Văn bản sắp được ghi vào tệp.</p>\n            "],["text","văn bản"],["The text that is about to be written into a file.","Văn bản sắp được ghi vào tệp."],["Return value","Giá trị trả về"],["\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ","\n              <h3><i>Chuỗi</i></h3>\n              <p data-tran=\"\">Văn bản sẽ được ghi vào tệp.</p>\n            "],["The text that will be written into a file.","Văn bản sẽ được ghi vào tệp."],["General","Tổng quan"],["Read character encoding","Đọc mã hóa ký tự"],["Force parser to use the following character encoding when reading the file(s).","Buộc trình phân tích sử dụng mã hóa ký tự sau khi đọc tệp."],["Write character encoding","Ghi mã hóa ký tự"],["Force parser to use the following character encoding when writing the file(s).","Buộc trình phân tích sử dụng mã hóa ký tự sau khi ghi tệp."],["You are editing:","Bạn đang chỉnh sửa:"],["Please select the mode of your pattern","Vui lòng chọn chế độ mẫu của bạn"],["Regular expression Pattern","Mẫu biểu thức chính quy"],["A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.","Một biểu thức chính quy ECMA Script hợp lệ cùng với bổ ngữ.<br>Bạn có thể sử dụng <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> để tạo và kiểm tra mẫu của bạn."],["Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ","Chú ý đến việc sử dụng ký tự xuống dòng (\\r) trong văn bản cần dịch. regex101.com sẽ loại bỏ các ký tự xuống dòng nên mẫu của bạn có thể có hiệu ứng khác với những gì bạn thấy trên regex101."],["<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.","<strong>Về lượng tử bắt một chuỗi có độ dài bằng không.</strong><br>\n            Chuỗi <i>rỗng</i> sẽ gây ra vấn đề cho trình phân tích. Do đó, thay vì sử dụng lượng tử <strong>*</strong> cũng sẽ bắt <i>chuỗi rỗng</i>, rất khuyến nghị sử dụng lượng tử <strong>+</strong> chỉ bắt chuỗi nếu tồn tại."],["Translatable Capture groups","Nhóm bắt có thể dịch"],["Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.","Chỉ số của nhóm biểu thức chính quy (Số nguyên) cho văn bản có thể dịch. Có thể nhiều hơn một. Phân cách bằng dấu phẩy."],["Row Info Capture group","Nhóm bắt thông tin hàng"],["\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ","\n            Chỉ số của nhóm biểu thức chính quy (Số nguyên) cho thông tin hàng (ví dụ: tên nhân vật). <b>Chỉ một nhóm</b> được phép.<br>\n            Giá trị của Thông tin hàng có thể được chuyển sang các quy tắc con và sẽ bị ghi đè bởi giá trị Thông tin hàng của quy tắc con nếu tồn tại.\n          "],["Context template","Mẫu ngữ cảnh"],["\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ","\n            Ngữ cảnh là định danh duy nhất cho văn bản có thể dịch.<br>\n            Bạn có thể sử dụng ký tự mẫu Javascript để thêm thông tin vào ngữ cảnh.<br>\n            <b>Biến có sẵn:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Nhóm bắt.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - ID của quy tắc.</li> -->\n            </ul>\n            <br>\n            <b>Ví dụ:</b>\n            <pre>item/${GROUP[2]}</pre>\n          "],["Action","Hành động"],["Capture value","Bắt giá trị"],["Capture then mask value","Bắt rồi che giá trị"],["Mask value","Che giá trị"],["Send to inner rule","Gửi đến quy tắc nội bộ"],["Edit inner rule <i class=\"icon-angle-double-right\"></i>","Chỉnh sửa quy tắc nội bộ <i class=\"icon-angle-double-right\"></i>"],["What action the pattern is going to do.","Hành động mà mẫu sẽ thực hiện."],["Javascript function","Hàm Javascript"],["Guide","Hướng dẫn"],["\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ","\n          <h2 data-tran=\"\">Đối số</h2>\n          <p data-tran=\"\">Mã bạn viết sẽ nằm trong một hàm với 2 đối số có thể truy cập ở bất kỳ đâu trong mã của bạn:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>Chuỗi</b></p>\n              <p data-tran=\"\">Một chuỗi chứa toàn bộ nội dung của tệp.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Đối tượng</b></p>\n              <p data-tran=\"\">Đối tượng quy tắc hiện đang được sử dụng bởi tệp.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\">Từ khóa <i>this</i></h2>\n          <p data-tran=\"\"><b>this</b> sẽ tham chiếu đến thể hiện của lớp CustomParser.</p>\n\n        "],["Arguments","Đối số"],["The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:","Mã bạn viết sẽ nằm trong một hàm với 2 đối số có thể truy cập ở bất kỳ đâu trong mã của bạn:"],["A string of the entire content of the file.","Một chuỗi chứa toàn bộ nội dung của tệp."],["The rule object that is currently used by the file.","Đối tượng quy tắc hiện đang được sử dụng bởi tệp."],["<i>this</i> Keyword","Từ khóa <i>this</i>"],["<b>this</b> will reffer to the instance of CustomParser class.","<b>this</b> sẽ tham chiếu đến thể hiện của lớp CustomParser."],["\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ","\n          <h2 data-tran=\"\">Giá trị trả về mong đợi</h2>\n          <p data-tran=\"\">Mã của bạn phải <b>trả về</b> một trong các giá trị sau:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Độ lệch của văn bản đã chụp, ví dụ:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Tên nhân vật\", // Tên nhân vật. tùy chọn\n    context: [\"một số\", \"ngữ cảnh\", \"ở đây\"] // Ngữ cảnh. tùy chọn\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Mảng độ lệch của văn bản đã chụp, ví dụ:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Tên nhân vật\", context: [\"một số\", \"ngữ cảnh\", \"ở đây\"]},\n    {start:12, end:30, rowInfoText:\"Nhân vật khác\", context: [\"ngữ cảnh\", \"khác\"]},\n    {start:4581, end:4593, rowInfoText:\"Nhân vật thứ ba\", context: [\"ngữ cảnh\", \"thứ ba\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        "],["Expected Return Value","Giá trị trả về mong đợi"],["Your code must <b>return</b> one of the following value:","Mã của bạn phải <b>trả về</b> một trong các giá trị sau:"],["Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ","Độ lệch của văn bản đã chụp, ví dụ:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Tên nhân vật\", // Tên nhân vật. tùy chọn\n    context: [\"một số\", \"ngữ cảnh\", \"ở đây\"] // Ngữ cảnh. tùy chọn\n  }\n</pre>\n            "],["Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ","Mảng độ lệch của văn bản đã chụp, ví dụ:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Tên nhân vật\", context: [\"một số\", \"ngữ cảnh\", \"ở đây\"]},\n    {start:12, end:30, rowInfoText:\"Nhân vật khác\", context: [\"ngữ cảnh\", \"khác\"]},\n    {start:4581, end:4593, rowInfoText:\"Nhân vật thứ ba\", context: [\"ngữ cảnh\", \"thứ ba\"]}\n  ]\n</pre>              \n            "],["\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ","\n          <h2 data-tran=\"\">Ví dụ</h2>\n          <p data-tran=\"\">Mã sau đây là một ví dụ để phân tích phụ đề srt.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ đang sử dụng regexp-match-indices\n  do đó tất cả phương thức RegExp.exec() sẽ trả về độ lệch nhóm của chúng\n  đọc thêm về Chỉ số Biểu thức Chính quy tại đây: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        "],["The following code is an example to parse srt subtitle.","Mã sau đây là một ví dụ để phân tích phụ đề srt."],["Welcome to the Custom Parser Model Creator","Chào mừng đến với Trình tạo Mô hình Phân tích Tùy chỉnh"],["Please start by creating a new File Group.","Vui lòng bắt đầu bằng cách tạo một Nhóm Tệp mới."],["Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ","Vui lòng xác định loại tệp bạn muốn phân tích bằng cách nhấp vào\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Thêm một nhóm tệp mới</button> nút.\n    "],["Press F1 to open the help dialog.","Nhấn F1 để mở hộp thoại trợ giúp."],["New File","Tệp Mới"],["Open file","Mở tệp"],["Save file","Lưu tệp"],["Save As","Lưu Dưới Dạng"],["Open debugger (F12)","Mở trình gỡ lỗi (F12)"],["Help","Trợ giúp"],["Edit current file pattern","Chỉnh sửa mẫu tệp hiện tại"],["Add a new file pattern","Thêm một mẫu tệp mới"],["Remove current file pattern","Xóa mẫu tệp hiện tại"],["Rule's order does matter, especially when you use masking! Drag to reorder.","Thứ tự của quy tắc rất quan trọng, đặc biệt khi bạn sử dụng mặt nạ! Kéo để sắp xếp lại."]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText","idx/29/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/28/innerText","idx/69/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"],["idx/9/attr/title"]],"basename":"modelEditor.html","dirname":"/addons/customParser/modelEditor","extension":".html","filename":"modelEditor.html","path":"/addons/customParser/modelEditor/modelEditor.html","indexIsBuilt":false,"indexIds":{"<i class=\"icon-edit\"></i>":0,"<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>":1,"Add a new file group":2,"<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>":3,"Remove current file group":4,"Rules":5,"Hooks":6,"Options":7,"Testing":8,"Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>":9,"Example":10,"For example, the text obtained from the parser is as follows:":11,"In this grid it will look like this:":12,"That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n":13,"With the hook above the text in the grid will be :":14,"Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.":15,"\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n":16,"\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n":17,"...will be converted into desired format: ":18,"Edit the translated text just before writing it into a file.":19,"Parameters":20,"\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ":21,"text":22,"The text that is about to be written into a file.":23,"Return value":24,"\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ":25,"The text that will be written into a file.":26,"General":27,"Read character encoding":28,"Force parser to use the following character encoding when reading the file(s).":29,"Write character encoding":30,"Force parser to use the following character encoding when writing the file(s).":31,"You are editing:":32,"Please select the mode of your pattern":33,"Regular expression Pattern":34,"A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.":35,"Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ":36,"<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.":37,"Translatable Capture groups":38,"Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.":39,"Row Info Capture group":40,"\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ":41,"Context template":42,"\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ":43,"Action":44,"Capture value":45,"Capture then mask value":46,"Mask value":47,"Send to inner rule":48,"Edit inner rule <i class=\"icon-angle-double-right\"></i>":49,"What action the pattern is going to do.":50,"Javascript function":51,"Guide":52,"\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ":53,"Arguments":54,"The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:":55,"A string of the entire content of the file.":56,"The rule object that is currently used by the file.":57,"<i>this</i> Keyword":58,"<b>this</b> will reffer to the instance of CustomParser class.":59,"\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ":60,"Expected Return Value":61,"Your code must <b>return</b> one of the following value:":62,"Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ":63,"Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ":64,"\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ":65,"The following code is an example to parse srt subtitle.":66,"Welcome to the Custom Parser Model Creator":67,"Please start by creating a new File Group.":68,"Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ":69,"Press F1 to open the help dialog.":70,"New File":71,"Open file":72,"Save file":73,"Save As":74,"Open debugger (F12)":75,"Help":76,"Edit current file pattern":77,"Add a new file pattern":78,"Remove current file pattern":79,"Rule's order does matter, especially when you use masking! Drag to reorder.":80},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":81,"length":81,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.js":{"data":[["Do you want to close Model editor?\rAll unsaved changes will be discarded.","Bạn có muốn đóng Trình chỉnh sửa Mô hình không?\rMọi thay đổi chưa lưu sẽ bị hủy."],["Translate here using ","Dịch ở đây bằng "],["Do you want to discard your changes and open\n","Bạn có muốn hủy thay đổi và mở\n"],["Error when trying to open file :","Lỗi khi cố gắng mở tệp:"],["Parser Model Creator","Trình Tạo Mô hình Phân tích"],["Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json","Vui lòng chỉ định loại tệp bạn muốn phân tích.\nBạn có thể sử dụng các mẫu glob phân cách bằng dấu chấm phẩy. Ví dụ: *.txt;*.js;*.json"],["Failed to create new file group. Please check your pattern!","Không thể tạo nhóm tệp mới. Vui lòng kiểm tra mẫu của bạn!"],["Do you wish to remove current file group?\nYou can not undo this action!","Bạn có muốn xóa nhóm tệp hiện tại không?\nHành động này không thể hoàn tác!"],["Do you want to discard your changes and create a new blank model?","Bạn có muốn hủy các thay đổi và tạo một mô hình trống mới không?"],["Do you want to discard your changes and open a file?","Bạn có muốn hủy các thay đổi và mở một tệp không?"],["Clear history","Xóa lịch sử"],["Open latest file","Mở tệp mới nhất"],["Open from history","Mở từ lịch sử"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Tính năng này chỉ khả dụng nếu bạn đang sử dụng phiên bản Nhà phát triển của Translator++. Bạn có thể chuyển sang phiên bản Nhà phát triển bằng cách sử dụng Tiện ích Cơ bản -> Thay đổi Core NWJS."]],"context":[["tid/156/type/StringLiteral"],["tid/5647/type/StringLiteral"],["tid/9760/type/StringLiteral"],["tid/10037/type/StringLiteral"],["tid/10099/type/StringLiteral"],["tid/10622/type/StringLiteral","tid/10941/type/StringLiteral"],["tid/10665/type/StringLiteral","tid/10987/type/StringLiteral"],["tid/11026/type/StringLiteral"],["tid/11104/type/StringLiteral"],["tid/11174/type/StringLiteral","tid/12080/type/StringLiteral"],["tid/11459/type/StringLiteral"],["tid/11525/type/StringLiteral"],["tid/11607/type/StringLiteral"],["tid/11750/type/StringLiteral"]],"basename":"modelEditor.js","dirname":"/addons/customParser/modelEditor","extension":".js","filename":"modelEditor.js","path":"/addons/customParser/modelEditor/modelEditor.js","indexIsBuilt":false,"indexIds":{"Do you want to close Model editor?\rAll unsaved changes will be discarded.":0,"Translate here using ":1,"Do you want to discard your changes and open\n":2,"Error when trying to open file :":3,"Parser Model Creator":4,"Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json":5,"Failed to create new file group. Please check your pattern!":6,"Do you wish to remove current file group?\nYou can not undo this action!":7,"Do you want to discard your changes and create a new blank model?":8,"Do you want to discard your changes and open a file?":9,"Clear history":10,"Open latest file":11,"Open from history":12,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":13},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string","Chuỗi ngôn ngữ không hợp lệ"],["Required field Project ID is blank!","Trường bắt buộc ID Dự án đang trống!"],["Required field Service Account Key is blank!","Trường bắt buộc Khóa Tài khoản Dịch vụ đang trống!"],["Required field Server Location is blank!","Trường bắt buộc Vị trí Máy chủ đang trống!"],["Required field Location of the glossary file is blank!","Trường bắt buộc Vị trí của tệp bảng thuật ngữ đang trống!"],["Required field Glossary Languages is blank!","Trường bắt buộc Ngôn ngữ Bảng thuật ngữ đang trống!"],["Invalid glossary language value","Giá trị ngôn ngữ bảng thuật ngữ không hợp lệ"],["Currently active glossary on this project: ","Bảng thuật ngữ hiện đang hoạt động trên dự án này: "],["Error when retreiving glossary info: ","Lỗi khi truy xuất thông tin bảng thuật ngữ: "],["Error when removing glossary : ","Lỗi khi xóa bảng thuật ngữ: "],["Glossary removed successfully.","Bảng thuật ngữ đã được xóa thành công."],["Error when creating glossary : ","Lỗi khi tạo bảng thuật ngữ: "],["Glossary created successfully.","Bảng thuật ngữ đã được tạo thành công."],["Configuration error:\r\n","Lỗi cấu hình:\r\n"],["No error found!","Không tìm thấy lỗi!"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js","Node JS là bắt buộc để sử dụng Google Cloud Translate Advanced. Vui lòng tải và cài đặt từ https://node.js"]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?","Không tìm thấy tệp thực thi JCap tại vị trí đã chỉ định. Bạn có muốn cài đặt JCap không?"],["JCap agent started successfully. Press ","Tác nhân JCap đã khởi động thành công. Nhấn "],["jcapKey","jcapKey"],["Please set the JCap executable path in the addon settings.","Vui lòng đặt đường dẫn tệp thực thi JCap trong cài đặt tiện ích."],["JCap executable already exists at the specified location.","Tệp thực thi JCap đã tồn tại tại vị trí đã chỉ định."],["JCap executable downloaded successfully.","Tệp thực thi JCap đã được tải xuống thành công."],["Failed to download JCap package. Please check the console for details.","Không thể tải xuống gói JCap. Vui lòng kiểm tra bảng điều khiển để biết chi tiết."],["JCap executable unpacked successfully.","Tệp thực thi JCap đã được giải nén thành công."],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.","Bây giờ bạn có thể khởi động tác nhân JCap từ Menu Chính - Công cụ - Công cụ OCR JCap - Khởi động Tác nhân JCap."],["Start JCap OCR Agent","Khởi động Tác nhân OCR JCap"],["Failed to unpack JCap package. Please check the console for details.","Không thể giải nén gói JCap. Vui lòng kiểm tra bảng điều khiển để biết chi tiết."],["JCap executable not found at the specified location.","Không tìm thấy tệp thực thi JCap tại vị trí đã chỉ định."],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.","Bạn có chắc chắn muốn gỡ cài đặt JCap không? Hành động này sẽ xóa tệp thực thi JCap và cấu hình của nó."],["JCap uninstalled successfully.","JCap đã được gỡ cài đặt thành công."],["Failed to uninstall JCap. Please check the console for details.","Không thể gỡ cài đặt JCap. Vui lòng kiểm tra bảng điều khiển để biết chi tiết."],["Help","Trợ giúp"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.","JCap OCR là một công cụ OCR cho phép bạn chụp văn bản từ màn hình và dịch nó bằng JCap. Để sử dụng, hãy khởi động JCap bằng cách nhấp vào nút OCR trên menu chính.\nSau đó nhấn phím đã cấu hình (mặc định: F9) để chụp văn bản."]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data","Làm đẹp dữ liệu JSON"],["When checked the generated data will be beautified.","Khi được chọn, dữ liệu tạo ra sẽ được làm đẹp."],["Start a new translation project from any JSON file.","Bắt đầu một dự án dịch mới từ bất kỳ tệp JSON nào."],["Translator++ will translate any translatable texts found in the JSON files.","Translator++ sẽ dịch mọi văn bản có thể dịch được tìm thấy trong các tệp JSON."],["Read the guide on how to start a new JSON translation project here","Đọc hướng dẫn về cách bắt đầu một dự án dịch JSON mới tại đây"],["Translator++ will scan through this folder for any JSON files.","Translator++ sẽ quét qua thư mục này để tìm bất kỳ tệp JSON nào."],["How do you want to get the data from the JSON object?","Bạn muốn lấy dữ liệu từ đối tượng JSON như thế nào?"],["Parser mode","Chế độ phân tích"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>","<h2>Chế độ Đơn giản</h2><p>Trong chế độ đơn giản, bạn có thể dịch tất cả các giá trị chuỗi một cách đệ quy bên trong đối tượng JSON.<br />Trong chế độ đơn giản, văn bản gốc luôn là giá trị.</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>","<h2>Chế độ Nâng cao</h2><p>Trong chế độ nâng cao, bạn có thể truy vấn JSON và xử lý bảng dịch kiểu cặp khóa-giá trị, trong đó văn bản gốc là khóa.</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>","<h2>Thông tin</h2><p>Bạn có thể sử dụng trường truy vấn sau để chọn một phần cụ thể của đối tượng JSON. Kết quả của truy vấn phải là một đối tượng hoặc một mảng văn bản.</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>","<h3>Đối với đối tượng</h3><p><b>Khóa sẽ được sử dụng làm văn bản gốc</b> và <b>giá trị làm bản dịch mặc định</b>.</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />","Trình phân tích sẽ tự động đăng ký nếu giá trị là chuỗi, null hoặc undefined.<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>","<h3>Đối với mảng</h3><p>Trình phân tích sẽ đăng ký tất cả các giá trị chuỗi trong mảng làm văn bản có thể dịch.</p>"],["Start project","Bắt đầu dự án"],["`Invalid destination directory:\\n${","`Thư mục đích không hợp lệ:\\n${"],["}`","}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label","nhãn"],["is duplicated in the same scenario file","bị trùng lặp trong cùng một tệp kịch bản"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory","Chọn thư mục"],["Select a directory to repack","Chọn một thư mục để đóng gói lại"],["Target xp3","Mục tiêu xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.","Chọn tên tệp. Tên tệp đặc biệt như <b>patch.xp3</b>, <b>patch2.xp3</b>...v.v. được ưu tiên hơn data.xp3 khi tải."],["Patch to allow folder structure","Bản vá để cho phép cấu trúc thư mục"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.","Mặc định, động cơ KAG không đọc các tệp bên trong một thư mục trong các tệp xp3. Tùy chọn này sẽ tự động thêm định nghĩa cấu trúc thư mục vào Config.tjs. Không có hiệu lực nếu không tìm thấy tệp Config.tjs."],["Repack into xp3","Đóng gói lại thành xp3"],["Close","Đóng"],["Process","Xử lý"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.","<b>Thứ tự có quan trọng</b> nếu bạn giải nén nhiều tệp cùng lúc! Các tệp sẽ được giải nén theo thứ tự. Nếu tệp đã tồn tại, nó sẽ bị ghi đè."],["Unpack XP3 files","Giải nén các tệp XP3"],["Repack a folder to xp3","Đóng gói lại một thư mục thành xp3"],["Unpack xp3 file","Giải nén tệp xp3"],["Before you create a new project, please make sure that :","Trước khi tạo một dự án mới, hãy đảm bảo rằng:"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Tất cả tệp .ks & .tjs đều ở dạng văn bản thuần (chưa biên dịch, chưa xáo trộn và chưa mã hóa)"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.","Trò chơi KAG nên có thể chơi được ngay cả khi không được đóng gói lại. Vì vậy, bạn nên kiểm tra xem trò chơi của mình có thể chơi được hay không sau khi được trích xuất."],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Một số hành động sẽ sửa đổi trò chơi của bạn. <b>Vì vậy hãy đảm bảo tạo bản sao lưu cho trò chơi của bạn!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Chọn tệp thực thi trò chơi. Tệp này là tệp trò chơi chính sẽ được sử dụng để trích xuất dữ liệu trò chơi."],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.","Translator++ có thể trích xuất các tệp XP3 với tiện ích bổ sung AEC. <b>Nhưng công cụ trích xuất không phải là giải pháp chắc chắn cho mọi loại XP3</b>."],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.","Một số tệp kịch bản được mã hóa. Chọn tùy chọn này nếu bạn muốn Translator++ thử giải mã chúng."],["This may not work on some projects.","Điều này có thể không hoạt động trên một số dự án."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Danh sách các bảng mã ký tự có thể. <b>Thứ tự quan trọng!</b>. Bạn có thể kéo để sắp xếp danh sách."],["Literal tags are the tags that will be escaped into Translator++ editor.","Thẻ nguyên văn là các thẻ sẽ được thoát trong trình soạn thảo Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> là bắt buộc."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Các thẻ sẽ được Translator++ chèn vào một dòng mới. Vì vậy bạn không cần viết <b>[r]</b> một cách rõ ràng."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kịch bản Kirikiri (.ks) có thể tùy chỉnh cao và cho phép nhà phát triển tạo thẻ riêng."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++ có thể xử lý các thẻ tiêu chuẩn như tên nhân vật bắt đầu bằng dấu thăng (#)."],["However, Translator++ cannot handle custom tags created by developers.","Tuy nhiên, Translator++ không thể xử lý các thẻ tùy chỉnh do nhà phát triển tạo."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Do đó, bạn có thể cần xác định các thẻ và thuộc tính cần dịch và những thứ cần đánh dấu là tên diễn viên."],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.","Bạn có thể cần <input type=\"button\" value=\"giải nén trò chơi xp3 của bạn\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> và phân tích kịch bản ks bên trong trước khi bắt đầu dự án."],["Create Project","Tạo Dự án"],["Pack a folder into xp3","Đóng gói một thư mục thành xp3"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.","Chọn bảng mã ký tự mục tiêu.<br />Hầu hết trò chơi KAG tiếng Nhật được viết bằng SHIFT-JIS, nhưng KAG thực sự hỗ trợ unicode UTF16LE. Nhiều dịch giả đặt bảng mã thành UTF16LE để trò chơi có thể chơi được trên Windows không phải tiếng Nhật mà không cần trình giả lập ngôn ngữ. Và quan trọng nhất, có thể hiển thị các ký tự ngoài SHIFT-JIS như \"café\".<br />Mặc định Translator++ sẽ ghi theo bảng mã gốc của nó."],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference.","Có nhiều cách để tạo trò chơi KAG đã bản địa hóa có thể chơi được. Vui lòng chọn một cách phù hợp với sở thích của bạn."]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode","Chọn chế độ"],["Select how do you want to start your project. By selecting files or folders.","Chọn cách bạn muốn bắt đầu dự án. Bằng cách chọn tệp hoặc thư mục."],["Select Folder","Chọn Thư mục"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","Chọn thư mục để xử lý. Translator++ sẽ truy xuất đệ quy các tệp PO từ thư mục được chỉ định."],["Select File","Chọn Tệp"],["Select the files you want to process.","Chọn các tệp bạn muốn xử lý."],["Filters","Bộ lọc"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Lọc tên tệp với mẫu glob. Mặc định là <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Tất cả tệp .po trong thư mục đã chọn và các thư mục con của nó."],["All .mo files in the selected folder and its subfolders.","Tất cả tệp .mo trong thư mục đã chọn và các thư mục con của nó."],["PO Files","Tệp PO"],["MO Files","Tệp MO"],["You are about to export the translations as MO files.\n","Bạn sắp xuất bản dịch dưới dạng tệp MO.\n"],["- MO files are binary files that cannot be edited manually.\n","- Tệp MO là tệp nhị phân không thể chỉnh sửa thủ công.\n"],["- Only translated entries are stored in MO files.\n","- Chỉ các mục đã dịch được lưu trong tệp MO.\n"],["Are you sure you want to proceed?","Bạn có chắc chắn muốn tiếp tục?"],["PO / MO Files","Tệp PO / MO"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.","Tệp .po và .mo là định dạng tệp văn bản và nhị phân tiêu chuẩn được sử dụng cùng nhau để bản địa hóa phần mềm, đặc biệt trong WordPress, để dịch chủ đề và plugin. Tệp PO (Đối tượng di động) là văn bản có thể đọc được chứa bản dịch, trong khi tệp MO (Đối tượng máy) là tệp nhị phân đã biên dịch, có thể đọc được bằng máy, được phần mềm sử dụng để tải nhanh hơn."],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts","Bắt đầu dịch từ kịch bản dịch PO (Đối tượng di động) và MO (Đối tượng máy)"],["Create Project","Tạo Dự án"],["Select mode","Chọn chế độ"],["Select how do you want to start your project. By selecting files or folders.","Chọn cách bạn muốn bắt đầu dự án của mình. Bằng cách chọn tệp hoặc thư mục."],["Select Folder","Chọn Thư mục"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","Chọn thư mục để xử lý. Translator++ sẽ đệ quy lấy các tệp PO từ thư mục đã chỉ định."],["Select File","Chọn Tệp"],["Select the files you want to process.","Chọn các tệp bạn muốn xử lý."],["Filters","Bộ lọc"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Lọc tên tệp với mẫu glob. Mặc định là <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Tất cả tệp .po trong thư mục đã chọn và các thư mục con của nó."],["All .mo files in the selected folder and its subfolders.","Tất cả tệp .mo trong thư mục đã chọn và các thư mục con của nó."],["ProjectTitle","Tiêu đề dự án"],["Your project title","Tiêu đề dự án của bạn"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor","Trích xuất trò chơi Livemaker"],["Half width character patch","Bản vá ký tự nửa chiều rộng"],["Patch half-width character","Vá ký tự nửa chiều rộng"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings","Động cơ Livemaker có hạn chế về hỗ trợ ngôn ngữ. Nó yêu cầu đặt vùng hệ thống không phải unicode của Windows sang tiếng Nhật để chạy các ứng dụng LiveMaker và LiveNovel. Ngoài ra, động cơ được mã hóa cứng chỉ sử dụng các phông chữ hệ thống Windows đã cài đặt hỗ trợ Windows Shift-JIS (MS CP932), có nghĩa là nó có thể không hỗ trợ các vùng hoặc mã hóa khác"],["Next","Tiếp theo"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?","Không thể phát hiện loại RPG Maker!\nBạn có chắc trò chơi là RPG Maker XP, VX hoặc VX Ace không?"],["Create a new project","Tạo một dự án mới"],["Invalid destination file:","Tệp đích không hợp lệ:"],[" doesn't seems to be a LiveMaker game."," dường như không phải là trò chơi LiveMaker."]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path.","Đường dẫn dev chưa được xác định.\nBạn nên tiêm trò chơi một lần để tạo đường dẫn dev."],["Decompile all rpyc files","Giải biên dịch tất cả tệp rpyc"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.","Thử giải biên dịch tất cả tệp rpyc thành .rpy.<br />Translator++ có trình giải biên dịch riêng. Nhưng có báo cáo rằng đôi khi nó không thể giải biên dịch một số trò chơi được tạo với Renpy 7. Bạn có thể để trường này không chọn và tự giải biên dịch trò chơi bằng công cụ của mình trước khi bắt đầu dự án."],["Overwrite rpy","Ghi đè rpy"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.","Nếu được chọn thì trình giải biên dịch <b>sẽ ghi đè các tệp rpy chưa biên dịch hiện có</b>."],["Exclude command","Loại trừ lệnh"],["This option will allow us to skip some command for being processed and translated","Tùy chọn này sẽ cho phép chúng ta bỏ qua một số lệnh để xử lý và dịch"],["Separate entries with a space","Phân tách các mục bằng dấu cách"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored","Ví dụ, nếu bạn đặt <b>old</b> thì tất cả dòng trong rpy bắt đầu bằng <b>old</b> sẽ bị bỏ qua"],["Are you sure want to start a project without decompiling the rpyc files?","Bạn có chắc muốn bắt đầu dự án mà không giải nén các tệp rpyc?"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?","Tệp bạn đã chọn không phải là tệp thực thi trò chơi Ren'Py.\nBạn có muốn tiếp tục không?"],["Play last build","Chơi bản dựng cuối cùng"],["Open Ren'Py documentation","Mở tài liệu Ren'Py"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","Tùy chọn đã được đặt để sử dụng trình phân tích cũ.\nBạn có thể chuyển lại sang trình phân tích mới bất cứ lúc nào qua menu tùy chọn."]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator","Trình dịch tệp nhị phân Windows"],["Parsing Windows binary file with","Đang phân tích tệp nhị phân Windows với"],["Sellect supported files","Chọn tệp được hỗ trợ"],["Select supported file type to translate.","Chọn loại tệp được hỗ trợ để dịch."],["Create a new project","Tạo một dự án mới"],["Please select a supported file to parse","Vui lòng chọn một tệp được hỗ trợ để phân tích"],["Please enter your project title!","Vui lòng nhập tiêu đề dự án của bạn!"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player","Sử dụng Trình chơi RPG gốc"],["Use native RPG Player instead of Easy RPG Player","Sử dụng Trình chơi RPG gốc thay vì Trình chơi RPG Dễ dàng"],["Use native RPG Player","Sử dụng Trình chơi RPG gốc"],["Target folder","Thư mục đích"],["Select destination folder.","Chọn thư mục đích."],["Install Easy RPG Player","Cài đặt Trình chơi Easy RPG"],["Close","Đóng"],["Install","Cài đặt"],["Process completed!","Quá trình hoàn tất!"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin.","Trình phân tích RPG Maker 2000 & 2003 với plugin xmlTrans."],["Play last build","Chơi bản dựng cuối cùng"],["Apply translation then play","Áp dụng bản dịch rồi chơi"],["Setup Easy RPG in the current directory","Thiết lập Easy RPG trong thư mục hiện tại"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine","Bắt đầu dịch từ engine RM2k / RM2k3"],["Create project","Tạo dự án"],["Please select RPG Maker 2000/2003 game!","Vui lòng chọn game RPG Maker 2000/2003!"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?","Không thể phát hiện loại RPG Maker!\nBạn có chắc game này là RPG Maker 2000 / 2003 không?"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder","Thư mục đích"],["Select destination folder.","Chọn thư mục đích."],["Install Easy RPG Player","Cài đặt Trình chơi Easy RPG"],["Close","Đóng"],["Install","Cài đặt"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/","Cách thêm font tùy chỉnh.\n\nFont phải được đặt trong thư mục Font của thư mục game và phải được đặt tên là Font.ttf hoặc Font2.ttf. File font nào được sử dụng phụ thuộc vào cài đặt font đồ họa hệ thống. Ngoài ttf, fon và nhiều font khác được hỗ trợ (bất cứ thứ gì được FreeType hỗ trợ, thư viện mã nguồn mở tốt nhất có sẵn để hiển thị font).\n\nNguồn: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!","Quá trình hoàn tất!"],["Play last build","Chơi bản dựng cuối cùng"],["Apply translation then play","Áp dụng bản dịch rồi chơi"],["Setup Easy RPG in the current directory","Thiết lập Easy RPG trong thư mục hiện tại"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data","Làm đẹp dữ liệu JSON"],["When checked the generated data will be beautified.","Khi được chọn, dữ liệu tạo ra sẽ được làm đẹp."],["Error loading system.json","Lỗi tải system.json"],["Loading","Đang tải"],["index.html not found in","Không tìm thấy index.html trong"],["Encrypted game","Trò chơi được mã hóa"],["Select the index.html of your encrypted game.","Chọn index.html của trò chơi được mã hóa của bạn."],["Target folder","Thư mục đích"],["Select destination folder. The process will replace the existing files.","Chọn thư mục đích. Quá trình sẽ thay thế các tệp hiện có."],["Decrypt Resources","Giải mã Tài nguyên"],["Close","Đóng"],["Process","Xử lý"],["Source path can not empty","Đường dẫn nguồn không được để trống"],["Destination path can not empty","Đường dẫn đích không được để trống"],["Path is not a file:","Đường dẫn không phải là tệp:"],["Invalid directory:","Thư mục không hợp lệ:"],["Extract enigma","Trích xuất enigma"],["Select enigma file.","Chọn tệp enigma."],["Extract Enigma","Trích xuất Enigma"],["Selected file is not an Enigma Virtual Box package.","Tệp đã chọn không phải là gói Enigma Virtual Box."],["Plugins are already fetched for this project. Want to re-fetch the plugins?","Các plugin đã được lấy cho dự án này. Bạn có muốn lấy lại các plugin không?"],["Translate Javascript File?","Dịch Tệp Javascript?"],["Cancel","Hủy"],["I know the risk, Proceed!","Tôi biết rủi ro, Tiếp tục!"],["Game Executable Path","Đường dẫn Tệp thực thi Game"],["Path to the game executable file (.exe)","Đường dẫn đến tệp thực thi game (.exe)"],["NWJS Version","Phiên bản NWJS"],["Change into this NWJS version","Chuyển sang phiên bản NWJS này"],["Use Developer version","Sử dụng phiên bản Nhà phát triển"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","Sử dụng phiên bản Nhà phát triển của NWJS. Phiên bản Nhà phát triển có sẵn các công cụ dành cho nhà phát triển. Phù hợp cho việc gỡ lỗi và phát triển."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Trong phiên bản Nhà phát triển, bạn có thể sử dụng <b>Bảng điều khiển Nhà phát triển</b>. Bảng điều khiển Nhà phát triển có thể được truy cập bằng cách nhấn F12 hoặc nhấp chuột phải vào ứng dụng và chọn 'Kiểm tra'."],["Use 32-bit version","Sử dụng phiên bản 32-bit"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","Sử dụng phiên bản 32-bit của NWJS. Phiên bản 32-bit hữu ích cho khả năng tương thích với các hệ thống cũ. Khuyến nghị bỏ chọn tùy chọn này nếu có thể (chỉ cần nâng cấp máy của bạn, anh bạn)."],["Some game feature may not work across NWJS version","Một số tính năng game có thể không hoạt động trên các phiên bản NWJS"],["Please be aware that some game feature may not work across NWJS version.","Xin lưu ý rằng một số tính năng game có thể không hoạt động trên các phiên bản NWJS."],["Change RPG Maker MV / RPG Maker MZ / NWJS version","Thay đổi phiên bản RPG Maker MV / RPG Maker MZ / NWJS"],["This operation will change the NW.js version into","Thao tác này sẽ thay đổi phiên bản NW.js thành"],["Please close the application first before continuing.\nDo you want to continue?","Vui lòng đóng ứng dụng trước khi tiếp tục.\nBạn có muốn tiếp tục không?"],["The selected file is not a valid NW.js application.","Tệp đã chọn không phải là ứng dụng NW.js hợp lệ."],["Could not find index.html in the game directory.","Không thể tìm thấy index.html trong thư mục trò chơi."],["Debug menu script not found in addon directory.","Không tìm thấy tập lệnh menu gỡ lỗi trong thư mục addon."],["Debug menu script is already installed in index.html.","Tập lệnh menu gỡ lỗi đã được cài đặt trong index.html."],["Debug options installed successfully!","Tùy chọn gỡ lỗi đã được cài đặt thành công!"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n","Trò chơi đã chọn không chạy ở Chế độ Nhà phát triển NW.js (SDK).\n\n"],["Developer Mode provides additional debugging features:\n","Chế độ Nhà phát triển cung cấp các tính năng gỡ lỗi bổ sung:\n"],["• Developer Console (F12)\n","• Bảng điều khiển Nhà phát triển (F12)\n"],["• Inspect Element (Right-click)\n","• Kiểm tra Phần tử (Nhấp chuột phải)\n"],["• Network Monitor\n","• Trình giám sát Mạng\n"],["• Performance Profiler\n\n","• Trình phân tích Hiệu suất\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n","Bạn có muốn nâng cấp lên Chế độ Nhà phát triển NW.js không?\n"],["(Recommended for better debugging experience)","(Được khuyến nghị để có trải nghiệm gỡ lỗi tốt hơn)"],["The game will be upgraded to NW.js SDK version","Trò chơi sẽ được nâng cấp lên phiên bản NW.js SDK"],["This may take a few minutes. Please wait...","Việc này có thể mất vài phút. Vui lòng chờ..."],["NW.js has been upgraded to Developer Mode successfully!","NW.js đã được nâng cấp lên Chế độ Nhà phát triển thành công!"],["Failed to upgrade to Developer Mode:\n","Không thể nâng cấp lên Chế độ Nhà phát triển:\n"],["Error installing debug options: ","Lỗi khi cài đặt tùy chọn gỡ lỗi: "],["Install Debug Options","Cài đặt Tùy chọn Gỡ lỗi"],["This will install a debug menu into your RPG Maker MV/MZ game.","Thao tác này sẽ cài đặt một menu gỡ lỗi vào trò chơi RPG Maker MV/MZ của bạn."],["Select the game executable file to install debug options.","Chọn tệp thực thi của trò chơi để cài đặt tùy chọn gỡ lỗi."],["Compile HTML to Executable","Biên dịch HTML thành Tệp thực thi"],["Change Existing NWJS Version","Thay đổi Phiên bản NWJS Hiện tại"],["Install debug options","Cài đặt tùy chọn gỡ lỗi"],["Find next","Tìm tiếp theo"],["Open folder","Mở thư mục"],["Open with external application","Mở bằng ứng dụng bên ngoài"],["Raw JSON data. Right click to open menu.","Dữ liệu JSON thô. Nhấp chuột phải để mở menu."],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)","Bản vá có sẵn cho dữ liệu dịch này. Bản vá này sẽ làm cho dữ liệu dịch của bạn tương thích với phiên bản hiện tại của Translator++.\nBạn có muốn vá dữ liệu dịch của mình không?\n(Một số tính năng có thể không hoạt động đúng nếu bạn không vá dữ liệu dịch)"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.","Không thể định vị tệp thực thi để cài đặt tùy chọn gỡ lỗi. Hãy đảm bảo trò chơi của bạn được đóng gói cho Windows với NW.js."],["Error while installing debug options: ","Lỗi khi cài đặt tùy chọn gỡ lỗi: "],["Play last build","Chạy bản dựng cuối cùng"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","Đường dẫn phát triển chưa được xác định.\nBạn nên tiêm trò chơi của mình một lần để tạo đường dẫn phát triển."],["Open editor","Mở trình chỉnh sửa"],["Load Plugins Into Project","Tải Plugin vào Dự án"],["Compile Game","Biên dịch Trò chơi"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","Tùy chọn đã được đặt để sử dụng trình phân tích cũ.\nBạn có thể chuyển lại sang trình phân tích mới bất cứ lúc nào qua menu tùy chọn."],["Unable to find the file related to the data","Không thể tìm thấy tệp liên quan đến dữ liệu"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Để sửa lỗi này, hãy chỉnh sửa trường <b>Vị trí nguyên liệu thô</b> tại <a href=\"#\" class=\"openProjectProperties\">Thuộc tính dự án</a>"],["Maximum dialog line","Dòng hội thoại tối đa"],["Maximum line in the dialog box. Default is 4.","Số dòng tối đa trong hộp thoại. Mặc định là 4."],["Add debug options","Thêm tùy chọn gỡ lỗi"],["Add debug options into the game to help testing.","Thêm tùy chọn gỡ lỗi vào trò chơi để hỗ trợ kiểm thử."],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>","Bật tùy chọn này để thêm công cụ gỡ lỗi vào trò chơi. Các tính năng này có thể giúp bạn kiểm tra bản dịch của mình.<br/><b>⚠️ Lưu ý: Tùy chọn này chỉ khả dụng nếu trò chơi của bạn được đóng gói với NWJS cho Windows.</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/ty