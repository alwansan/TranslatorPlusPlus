xt","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":false,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"relPath":"/find.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":25,"length":25,"percent":100},"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","Không thể tìm thấy tệp liên quan đến dữ liệu"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Để sửa lỗi này, hãy chỉnh sửa trường <b>Vị trí nguyên liệu thô</b> trong <a href=\"#\" class=\"openProjectProperties\">Thuộc tính dự án</a>"],["Copy path to clipboard","Sao chép đường dẫn vào clipboard"],["Path has been copied to clipboard.","Đường dẫn đã được sao chép vào clipboard."],["Open folder","Mở thư mục"],["Open with external application","Mở bằng ứng dụng bên ngoài"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","M