tringLiteral"],["tid/66686/type/StringLiteral"],["tid/66746/type/StringLiteral"],["tid/66772/type/StringLiteral"],["tid/68035/type/StringLiteral"],["tid/68084/type/StringLiteral"],["tid/69208/type/StringLiteral"],["tid/69382/type/TemplateHead","tid/70089/type/TemplateHead"],["tid/69384/type/TemplateTail","tid/70091/type/TemplateTail"],["tid/69811/type/StringLiteral"],["tid/70151/type/StringLiteral"],["tid/74815/type/StringLiteral"],["tid/74898/type/StringLiteral"],["tid/75985/type/StringLiteral"],["tid/77908/type/StringLiteral"]],"basename":"ui.js","dirname":"/js","extension":".js","filename":"ui.js","path":"/js/ui.js","indexIsBuilt":false,"indexIds":{"`You cannot close the application at this moment, reason: \\n${":0,"}`":1,"Do you really want to exit Translator++?\nAll unsaved changes will be discarded!":2,"Trans file":3,"Translator++ Project Package (TPP) file":4,"Select all":5,"Select none":6,"Invert":7,"Match destination selection":8,"use mouse drag to do bulk selection":9,"Invalid trans data":10,"Inject / Apply translation":11,"Inject / Apply translation to all":12,"Cancel":13,"Apply Translation":14,"Target path cannot be a parent or child of the source material's path.\nPlease select another path.":15,"Help":16,"Import":17,"Revert to origin data":18,"Select target directory.":19,"The existing files will be overwritten!":20,"Process":21,"Path to the directory can not be empty!":22,"Invalid directory:":23,"Rebuild translation table from this cache":24,"Create new project":25,"-nothing-":26,"Ok":27,"No action selected, are you sure?":28,"No context's keyword specified!":29,"Remove context containing keyword :\n":30,"\nfrom selected files?":31,"Remove every rows except rows that has a context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"relPath":"/js/ui.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","Bạn có thể xem thông tin chi tiết hơn trong nhật ký bảng điều khiển (F12)"],["Close","Đóng"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","Bạn có thể xem thông tin chi tiết hơn trong nhật ký bảng điều khiển (F12)"],["Close","Đóng"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/ui.parts.js":{"data":[["Form","Biểu mẫu"],["Cancel","Hủy"],["Ok","OK"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","Xóa ghi chú"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/login.html":{"data":[["working","đang làm việc"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/note.html":{"data":[["Remove note","Xóa ghi chú"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/options.html":{"data":[["Click to login","Nhấn để đăng nhập"],["Translator &amp; Language","Trình dịch &amp; Ngôn ngữ"],["Proofreader","Người hiệu đính"],["Assistant","Trợ lý"],["General","Chung"],["Preferences","Tùy chọn"],["Add-ons","Tiện ích bổ sung"],["About","Về"],["User Information","Thông tin người dùng"],["Login to your Patreon account to get access to the latest features and updates.","Đăng nhập vào tài khoản Patreon của bạn để truy cập các tính năng và cập nhật mới nhất."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> Đăng nhập"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> Đăng nhập bằng trình duyệt"],["Welcome,","Chào mừng,"],["Name","Tên"],["Email","Email"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Cấp độ <div class=\"infoHeadNote\">(Đăng ký hiện tại tính bằng xu USD)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Điểm <div class=\"infoHeadNote\">(Tổng đăng ký trọn đời tính bằng xu USD)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","Trạng thái thanh toán <div class=\"infoHeadNote\">(Trạng thái thanh toán hiện tại)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Đừng hoảng sợ!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>Và vui lòng đọc thông tin sau.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Cờ này cho biết Patreon chưa nhận được tiền từ cam kết của bạn. Hệ thống thanh toán gặp trễ là điều bình thường. Tùy theo phương thức thanh toán và quốc gia, trễ có thể lên đến 24 giờ.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Trong thời gian trễ này, bạn có thể thấy ghi nợ từ thẻ tín dụng. Đừng lo—Patreon sẽ thử lại định kỳ để kiểm tra xem họ đã nhận thanh toán chưa. Điều này thường tự giải quyết trong vòng 24 giờ.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Nếu vấn đề kéo dài hơn, vui lòng đăng trong chủ đề <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> trên máy chủ Translator++ trên Discord. Tôi sẽ hỗ trợ bạn nhiều nhất có thể.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Xin hiểu rằng để ngăn gian lận, <b><span class=\"userInfoPoints\">điểm</span> và <span class=\"userInfoLevel\">Cấp độ</span> sẽ không được tính cho đến khi Patreon nhận thanh toán thành công</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">Đừng hoảng sợ!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","Cờ này cho biết Patreon chưa nhận được tiền từ cam kết của bạn. Hệ thống thanh toán gặp trễ là điều bình thường. Tùy theo phương thức thanh toán và quốc gia, trễ có thể lên đến 24 giờ."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","Trong thời gian trễ này, bạn có thể thấy ghi nợ từ thẻ tín dụng. Đừng lo—Patreon sẽ thử lại định kỳ để kiểm tra xem họ đã nhận thanh toán chưa. Điều này thường tự giải quyết trong vòng 24 giờ."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","Nếu vấn đề vẫn tiếp diễn sau khoảng thời gian này, vui lòng đăng trong <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">luồng account-problem</a> trên máy chủ Translator++ trên Discord. Tôi sẽ hỗ trợ bạn nhiều nhất có thể."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","Vui lòng hiểu rằng để ngăn chặn gian lận, <b><span class=\"userInfoPoints\">điểm</span> và <span class=\"userInfoLevel\">Cấp độ</span> sẽ không được tính cho đến khi thanh toán của bạn được Patreon nhận thành công</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> Đăng xuất"],["Primary Translator","Dịch giả Chính"],["Default Translator Engine","Công cụ Dịch Mặc định"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tCông cụ Dịch này sẽ được sử dụng khi bạn nhấn <span class=\"keyboardHint\">Ctrl+g</span> tại ô đã chọn để <strong>g</strong>enerate dịch tại ô đã chọn.\n\t\t\t\t"],["Default Language","Ngôn ngữ Mặc định"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\tCài đặt ngôn ngữ mặc định trên tất cả dự án!<br>\n\t\t\t\tCài đặt trong thuộc tính dự án sẽ ghi đè giá trị này.\n\t\t\t"],["Default Source Language","Ngôn ngữ Nguồn Mặc định"],["Default Target Language","Ngôn ngữ Đích Mặc định"],["Custom escape","Thoát tùy chỉnh"],["Patterns","Mẫu"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tTất cả từ khớp với mẫu dưới đây sẽ không được dịch bởi công cụ dịch máy. \n\t\t\t\t\t\tPhần này phù hợp để ẩn thẻ và tập lệnh khỏi công cụ dịch. <br>\n\t\t\t\t\t\tMỗi mục nhập là một biểu thức chính quy javaScript hợp lệ, hàm, hoặc literal string được phân tách bằng <b>dấu phẩy</b>.<br>\n\t\t\t\t\t\tThoát tùy chỉnh chỉ hoạt động cho <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">thuật toán thoát được hỗ trợ</a>.\n\t\t\t\t\t\t<b>Gợi ý:</b>Bạn cũng có thể yêu cầu ChatGPT tạo biểu thức chính quy cho bạn. <br>\n\t\t\t\t\t\tVui lòng viết mẫu regex cùng với bộ sửa đổi của nó.<br>\n\t\t\t\t\t\tví dụ:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","Trình kiểm tra"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tDán văn bản của bạn vào đây để kiểm tra mẫu.\n\t\t\t\t\t\tTất cả mẫu khớp sẽ được đánh dấu.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>Đang Xây dựng</h2>\n\t\t\t\t<p>Khu vực này sẽ là nơi cấu hình cài đặt và tùy chọn trình kiểm tra tự động.</p>\n\t\t\t"],["AI Assistant","Trợ lý AI"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Xin chào! Tôi là MIRAI, trợ lý AI của bạn cho Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Chỉ cần nhấp vào biểu tượng của tôi <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> trên menu Trang chủ để trò chuyện với tôi. Tôi có thể hỗ trợ bạn với:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Cải thiện và đề xuất dịch thuật</li>\n\t\t\t\t\t\t\t<li>Kiểm tra và đảm bảo chất lượng</li>\n\t\t\t\t\t\t\t<li>Thiết lập quy trình dịch của bạn</li>\n\t\t\t\t\t\t\t<li>Tạo tập lệnh tự động hóa</li>\n\t\t\t\t\t\t\t<li>Và nhiều hơn nữa!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Hãy cùng nhau làm cho công việc dịch thuật của bạn dễ dàng và hiệu quả hơn!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. Tôi vẫn còn mới, vì vậy, hãy kiên nhẫn với tôi.🙇‍♀️ Nhưng tôi đang học và cải thiện mỗi ngày!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","Cấu hình AI"],["Model Endpoint","Điểm cuối Mô hình"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","URL điểm cuối API cho mô hình AI của bạn. Ví dụ: https://api.openai.com/v1/chat/completions"],["API Key","Khóa API"],["Your API key for authenticating with the AI service. This will be stored securely.","Khóa API của bạn để xác thực với dịch vụ AI. Thông tin này sẽ được lưu trữ an toàn."],["Model Name","Tên Mô hình"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","Chọn hoặc nhập mô hình AI để sử dụng. Các mô hình hỗ trợ công cụ được khuyến nghị để đạt kết quả tốt nhất."],["File Association","Liên kết Tệp"],["Extension","Phần mở rộng"],["Associate","Liên kết"],["Set All","Đặt Tất cả"],["Unset All","Bỏ Đặt Tất cả"],["Apply","Áp dụng"],["Update","Cập nhật"],["Auto update","Tự động cập nhật"],["Automatically update Translator++ if possible.","Tự động cập nhật Translator++ nếu có thể."],["Allow reinstall the same version","Cho phép cài đặt lại cùng phiên bản"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Cho phép Translator++ cài đặt lại cùng phiên bản đã được cài đặt. Vui lòng giữ tùy chọn này tắt sau khi bạn đã cài đặt bản cập nhật, đặc biệt khi cài đặt <b>Tự động cập nhật</b> của bạn đang bật. Nếu không, Translator++ sẽ tiếp tục tự cập nhật mỗi khi bạn mở chương trình."],["Use default browser to login","Sử dụng trình duyệt mặc định để đăng nhập"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","Sử dụng trình duyệt mặc định đáng tin cậy của hệ thống để đăng nhập vào tài khoản Patreon của bạn. Trừ khi tùy chọn này được chọn, trình duyệt nhúng của Translator++ sẽ được sử dụng."],["Multi threading","Đa luồng"],["Number of thread","Số luồng"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","Số lượng tiến trình con được mở đồng thời.<br>\n\t\t\t\t\t\t\t0 = tắt đa luồng. Tất cả tiến trình sẽ được thực hiện bởi tiến trình renderer.<br>\n\t\t\t\t\t\t\tSố lượng tối ưu thường là số lõi vật lý của bạn - 1.\n\t\t\t\t\t\t"],["Backup","Sao lưu"],["Enable backup","Bật sao lưu"],["Automatically create backup every time you save your project.","Tự động tạo sao lưu mỗi khi bạn lưu dự án."],["Backup level history","Lịch sử cấp độ sao lưu"],["How many history of backup do you want to keep?","Bạn muốn giữ bao nhiêu lịch sử sao lưu?"],["Log &amp; Debugging","Nhật ký &amp; Gỡ lỗi"],["Log to file","Ghi nhật ký vào tệp"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","Ghi nhật ký vào tệp thay vì cửa sổ console mặc định.<br>Điều này hữu ích nếu bạn muốn gỡ lỗi Translator++ và không có quyền truy cập vào cửa sổ console. Bật tùy chọn này sẽ ảnh hưởng nhẹ đến hiệu suất. Vì vậy, bạn nên tắt tùy chọn này mọi lúc, trừ khi bạn đang gỡ lỗi hoặc báo cáo sự cố.<br>Nhật ký được lưu trong thư mục data/logs/."],["Truncate log file each session","Cắt ngắn tệp nhật ký mỗi phiên"],["When checked your log file will be truncated each time you re open the application.","Khi được chọn, tệp nhật ký của bạn sẽ bị cắt ngắn mỗi khi bạn mở lại ứng dụng."],["Application Settings","Cài đặt ứng dụng"],["Enable remote debugging","Bật gỡ lỗi từ xa"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","Kích hoạt giao thức gỡ lỗi từ xa Chrome DevTools trên cổng 9222. Điều này cho phép bạn kiểm tra và gỡ lỗi Translator++ bằng trình duyệt bên ngoài bằng cách điều hướng đến <code>chrome://inspect</code>. Cờ này thêm <code>--remote-debugging-port=9222</code> vào các đối số khởi động ứng dụng. Cần khởi động lại để áp dụng thay đổi."],["Disable GPU","Tắt GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","Tắt tăng tốc GPU phần cứng. Điều này hữu ích nếu bạn gặp lỗi hình ảnh, sự cố hoặc vấn đề kết xuất trên một số phần cứng hoặc trình điều khiển đồ họa. Cờ này thêm <code>--disable-gpu</code> vào các đối số khởi động ứng dụng. Cần khởi động lại để áp dụng thay đổi."],["Dangerous Area","Khu vực nguy hiểm"],["Interface Language","Ngôn ngữ giao diện"],["UI Language","Ngôn ngữ UI"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","Đặt ngôn ngữ cho giao diện người dùng. Bạn có thể tạo bản địa hóa riêng nếu Translator++ không có sẵn bằng ngôn ngữ của bạn. Dữ liệu ngôn ngữ nằm trong thư mục www/lang."],["Spell checker Language","Ngôn ngữ kiểm tra chính tả"],["Set the default spell checker language.","Thiết lập ngôn ngữ kiểm tra chính tả mặc định."],["Environment Variables","Biến môi trường"],["Staging Directory","Thư mục Staging"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","Thư mục Staging là bộ nhớ cache cứng của các dự án đang được xử lý. Một phần dữ liệu từ nguyên liệu thô được sao chép vào thư mục này để các tập lệnh thông dịch truy cập."],["Project creation","Tạo dự án"],["Auto Load Common Reference","Tự động tải tham chiếu chung"],["Auto load common reference from .trans file.","Tự động tải tham chiếu chung từ tệp .trans."],["Project settings","Cài đặt dự án"],["Progress Column Indices","Chỉ số cột tiến độ"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","Ở đây, bạn có thể chỉ định cột nào sẽ được bao gồm trong tính toán tiến độ của dự án.\n\t\t\t\t\t\t\t<br>Chỉ số cột là số nguyên bắt đầu từ 0, trong đó cột ngoài cùng bên trái là 0.\n\t\t\t\t\t\t\t<br>Sử dụng dấu phẩy để chỉ định nhiều cột. Ví dụ: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Mặc định: Trống</b>. Nếu để trống, Translator++ sẽ tính tiến độ từ tất cả các cột có sẵn.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>Bật/Tắt"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>Cài đặt"],["Install from a package","Cài đặt từ gói"],["Visit our website &amp; documentation : ","Truy cập trang web &amp; tài liệu của chúng tôi : "],["Fork Translator++ at : ","Fork Translator++ tại : "],["Support Translator++ at : ","Hỗ trợ Translator++ tại : "],["Join our discord channel at : ","Tham gia kênh discord của chúng tôi tại : "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) Nếu bạn là patron, bạn nên <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">liên kết tài khoản discord trên hồ sơ Patreon của bạn</a>. Bạn sẽ được mời tự động và có những lợi ích đang chờ bạn!"],["Version Info","Thông tin phiên bản"],["Last checked at : ","Lần kiểm tra cuối lúc : "],["Check now!","Kiểm tra ngay!"],["You have a pending update","Bạn có một bản cập nhật đang chờ"],["Update now","Cập nhật ngay"],["Your Translator++ is up to date 😃.","Translator++ của bạn đã được cập nhật 😃."],["Architecture","Kiến trúc"],["License","Giấy phép"],["Click here to read the license.","Nhấn vào đây để đọc giấy phép."],["Credits","Công lao"],["Localization","Bản địa hóa"],["About Third Party Software","Về Phần Mềm Bên Thứ Ba"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tPhần mềm này sử dụng các phần mềm bên thứ ba nằm tại /3rdParty. Các phần mềm bên thứ ba này có giấy phép riêng và \n\t\t\t\tđược bao gồm chỉ vì sự tiện lợi khi sử dụng và \n\t\t\t\tđược cung cấp “nguyên trạng” mà không có bất kỳ bảo hành nào, dù được nêu rõ hay ngụ ý và phần mềm đó được sử dụng với rủi ro của bạn.\n\t\t\t\t"],["Special Thanks","Lời cảm ơn đặc biệt"],["Want to explicitly support Translator++ by putting your name on this section?","Muốn hỗ trợ rõ ràng Translator++ bằng cách đặt tên của bạn vào phần này?"],["Click here to learn more about how to do that!","Nhấn vào đây để tìm hiểu thêm về cách làm điều đó!"],["Changelog","Nhật ký thay đổi"],["Feeds","Nguồn cấp dữ liệu"],["Click connect button, to connect translator with Translator++ table","Nhấn nút kết nối, để kết nối trình dịch với bảng Translator++"],["working","đang hoạt động"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Cấp độ Patreon/Khoản đóng góp hiện tại của bạn trong tháng này bằng cent (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","Điểm/Đóng góp trọn đời của bạn + tiền thưởng tính bằng cent (1 USD = 100 điểm)"],["Filter...","Lọc..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":124,"length":124,"percent":100},"parameters":[]},"/scriptEditor.html":{"data":[["Run","Chạy"],["New Project (ctrl+n)","Dự án mới (ctrl+n)"],["Open (ctrl+o)","Mở (ctrl+o)"],["Save file (ctrl+s)","Lưu tệp (ctrl+s)"],["Save As (ctrl+shift+s)","Lưu thành (ctrl+shift+s)"],["Open debugger (F12)","Mở trình gỡ lỗi (F12)"],["Help","Trợ giúp"],["Select file in the current workspace","Chọn tệp trong không gian làm việc hiện tại"],["file path","đường dẫn tệp"],["Create shortcut of the current script","Tạo lối tắt cho tập lệnh hiện tại"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/tableEditor.html":{"data":[["Reset","Đặt lại"],["Clear","Xóa"],["Search","Tìm kiếm"],["Help","Trợ giúp"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/trans.html":{"data":[["Start","Bắt đầu"],["Home","Trang chủ"],["Translator","Trình dịch"],["Objects","Đối tượng"],["Live translation","Dịch trực tiếp"],["Original","Nguyên bản"],["Raw","Thô"],["Row Properties","Thuộc tính dòng"],["Default translation","Bản dịch mặc định"],["Context translation","Bản dịch ngữ cảnh"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\tĐường dẫn <a class=\"problemPath\"></a> không thể truy cập bởi trình thông dịch PHP.<br>\n\t\tVui lòng đổi tên đường dẫn và chỉ sử dụng tên chữ và số.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>Vị trí</span>"],["File :","Tệp :"],["Row ID :","ID dòng :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>Ngữ cảnh</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>Nhân vật</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>Văn bản khóa</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>Bản dịch tốt nhất</span>"],["File ID","ID tệp"],["Path","Đường dẫn"],["Original Format","Định dạng gốc"],["Data Length","Độ dài dữ liệu"],["Translated","Đã dịch"],["General","Chung"],["Language","Ngôn ngữ"],["Staging","Sân khấu"],["Stats","Thống kê"],["Advanced","Nâng cao"],["Info","Thông tin"],["Title","Tiêu đề"],["File Location","Vị trí tệp"],["Project ID","ID dự án"],["Built on","Được xây dựng trên"],["Editor Name","Tên trình chỉnh sửa"],["Editor Version","Phiên bản trình chỉnh sửa"],["Engine","Công cụ"],["Parser","Bộ phân tích"],["Parser version","Phiên bản bộ phân tích"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","Vị trí nguyên liệu gốc <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Vị trí của nguyên liệu gốc. Bạn không nên sửa đổi bất cứ thứ gì trong thư mục này.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Đường dẫn không hợp lệ.<br>Một số tính năng sẽ bị vô hiệu hóa cho đến khi sửa lỗi này."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","Vị trí nguyên liệu đã dịch <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Vị trí của trò chơi đã được dịch. Vị trí mặc định để tiêm bản dịch.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","Dịch giả <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Dịch giả ưa thích cho dự án này. Nếu không xác định, sẽ sử dụng cài đặt toàn cục.\"></i>"],["Translate From","Dịch từ"],["Translate Into","Dịch sang"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","Đường dẫn Staging <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Đường dẫn staging là vị trí của một số tệp cần thiết để xuất/xây dựng bản dịch. Các tệp staging được tạo khi bạn tạo dự án.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","Đối tượng <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Số lượng đối tượng/tệp có sẵn ở khung bên trái\"></i>"],["Folders","Thư mục"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","Ký tự <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Số lượng ký tự trong cột Văn bản Gốc\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","Từ <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Có thể hiển thị giá trị sai trong các ngôn ngữ không sử dụng khoảng trắng (ví dụ: tiếng Nhật, tiếng Trung).\"></i>"],["Total Rows","Tổng số hàng"],["Translated row","Hàng đã dịch"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Bản dịch hữu cơ <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Người dùng điền trực tiếp vào lưới. Đây là một dấu hiệu tốt. Có thể là bản dịch của con người, có thể là MTL đã chỉnh sửa, v.v.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","Tiến độ tổng thể <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","Chạy sau khi xuất<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Chạy một hàm javascript sau khi dự án này được xuất thành công.\"></i>"],["Display this information when the project is opened.","Hiển thị thông tin này khi mở dự án."],["Select Export Mode","Chọn Chế độ Xuất"],["Export to a folder","Xuất ra một thư mục"],["Export pre-compiled game data to a folder<br>Folder structures are retained","Xuất dữ liệu trò chơi đã biên dịch trước vào một thư mục<br>Cấu trúc thư mục được giữ nguyên"],["Export as a Zip file","Xuất dưới dạng tệp Zip"],["Export pre-compiled game data to a single zipped archive","Xuất dữ liệu trò chơi đã biên dịch trước vào một kho lưu trữ nén duy nhất"],["RPGMakerTrans Patch Files","Tệp Bản vá RPGMakerTrans"],["Export to RPGMakerTrans formatted *.txt files in a folder","Xuất ra các tệp *.txt định dạng RPGMakerTrans trong một thư mục"],["Comma Separated Values","Giá trị Phân cách bằng Dấu phẩy"],["Export to Comma Separated Values (csv) files in a folder","Xuất ra tệp Giá trị Phân tách bằng Dấu phẩy (csv) trong một thư mục"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 trở lên"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","Xuất ra tệp Bảng tính Microsoft Excel (xlsx) trong một thư mục"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 trở lên"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","Xuất ra tệp Bảng tính Microsoft Excel (xls) trong một thư mục"],["HTML Spreadsheet","Bảng tính HTML"],["Export to HTML files in a folder","Xuất ra tệp HTML trong một thư mục"],["Open Document Format/OASIS (.ods)","Định dạng Tài liệu Mở/OASIS (.ods)"],["Export to ODS files in a folder","Xuất ra tệp ODS trong một thư mục"],["Select Import Mode","Chọn Chế độ Nhập"],["Import translation from another .trans file","Nhập bản dịch từ tệp .trans khác"],["Open another Translator++ file<br>Apply translation into current project.","Mở tệp Translator++ khác<br>Áp dụng bản dịch vào dự án hiện tại."],["Import translation from spreadsheets","Nhập bản dịch từ bảng tính"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","Nhập bản dịch từ các tệp bảng tính đa dạng<br>(.xls, .xlsx, .ods, .html, .xml, v.v.)"],["Import translation from RPGMakerTrans Patch format","Nhập bản dịch từ định dạng Bản vá RPGMakerTrans"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","Nhập bản dịch từ tệp bản vá của RPGMaker Trans<br>(.txt)"],["Source :","Nguồn :"],["Select objects to import","Chọn đối tượng để nhập"],["Import mode :","Chế độ nhập :"],["Import translations","Nhập bản dịch"],["Import data object","Nhập đối tượng dữ liệu"],["Destination :","Đích đến :"],["Currently selected : ","Đang chọn : "],["Options :","Tùy chọn :"],["Import the context translations","Nhập bản dịch theo ngữ cảnh"],["Case insensitive","Không phân biệt chữ hoa chữ thường"],["Overwrite target","Ghi đè mục tiêu"],["Destination column : ","Cột đích : "],["Translation mode :","Chế độ dịch :"],["Row by row translation","Dịch theo từng hàng"],["Line by line translation","Dịch theo từng dòng"],["Select translation by context address","Chọn bản dịch theo địa chỉ ngữ cảnh"],["Just copy translation into the same row (No checking)","Chỉ sao chép bản dịch vào cùng hàng (Không kiểm tra)"],["Merge data","Hợp nhất dữ liệu"],["Import translation from spreadsheet into project","Nhập bản dịch từ bảng tính vào dự án"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","Nhập bản dịch từ bất kỳ định dạng bảng tính nào (xls, xlsx, odx, html, csv, v.v.)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>Bảng tính phải có ít nhất 2 cột.</b> Cột quan trọng nhất là cột đầu tiên (cột ngoài cùng bên trái) chứa văn bản gốc. Các cột tiếp theo chứa bản dịch. Translator++ sẽ sử dụng văn bản trong ô ngoài cùng bên phải không trống."],["Please click the radio button to select files/folder to import","Vui lòng nhấp nút radio để chọn tệp/thư mục để nhập"],["Import file(s)","Nhập tệp"],["Import folder","Nhập thư mục"],["Import translation from RPG Maker Trans into project","Nhập bản dịch từ RPG Maker Trans vào dự án"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">Chọn loại dự án</span>"],["Select project type","Chọn loại dự án"],["Spreadsheet","Bảng tính"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","Bắt đầu một dự án dịch từ dữ liệu bảng tính (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","Dự án trống"],["Create a new .trans file from scratch.","Tạo một tệp .trans mới từ đầu."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Bảng tính</span>"],["Fetch type","Loại lấy dữ liệu"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","Các cột đầu là văn bản có thể dịch, các cột còn lại là bản dịch được định sẵn (Tạo dữ liệu lưới khớp với bảng gốc)"],["All columns are translatable text","Tất cả các cột là văn bản có thể dịch"],["Custom","Tùy chỉnh"],["Custom Options","Tùy chọn tùy chỉnh"],["Which column do you want to fetch?","Bạn muốn lấy cột nào?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","Vui lòng chỉ định cột bạn muốn lấy và cột bạn muốn đặt bản dịch vào. <b>Chỉ số bắt đầu từ 0 (cột đầu tiên là 0)</b>."],["Column to be translated","Cột cần dịch"],["Column to put translation into","Cột để đặt bản dịch vào"],["Action","Hành động"],["Enable Row Header Text Column","Bật cột văn bản tiêu đề hàng"],["If enabled, the parser will process the following Row Header Text Column rule","Nếu được bật, trình phân tích sẽ xử lý quy tắc cột văn bản tiêu đề hàng sau đây"],["Row Header Text Column","Tiêu đề Hàng Cột Văn bản"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","Nếu được chỉ định, giá trị trong cột này sẽ được áp dụng cho tiêu đề hàng. Điều này hữu ích để xác định người nói hoặc diễn viên hiện tại, v.v. Đây là chỉ số bắt đầu từ 0."],["Options","Tùy chọn"],["Calculate cell value","Tính giá trị ô"],["Cell value in the form of formula will be transpiled","Giá trị ô dưới dạng công thức sẽ được biên dịch"],["Get formatted value","Lấy giá trị đã định dạng"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","Xử lý giá trị ô sau khi định dạng. (Ví dụ: số nguyên 100000 trong một ngôn ngữ nhất định sẽ trở thành USD 100,000)"],["Parse CSV in EXCEL format","Phân tích CSV theo định dạng EXCEL"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","Buộc trình phân tích phân tích CSV theo cách của MS EXCEL. (chỉ cho các tệp CSV)"],["Skip the first <i>n</i> row(s)","Bỏ qua <i>n</i> hàng đầu tiên"],["Use this option if you want to skip the row header.","Sử dụng tùy chọn này nếu bạn muốn bỏ qua tiêu đề hàng."],["Select File(s)","Chọn Tệp"],["Select a directory","Chọn một thư mục"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Tạo tệp Trans mới</span>"],["Create a new Trans file","Tạo một tệp Trans mới"],["The title of this project","Tiêu đề của dự án này"],["Engine type","Loại động cơ"],["Type of the engine","Loại của động cơ"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Giữ chỗ cho điều gì đó tuyệt vời trong tương lai gần!</span>"],["Placeholder for something great at the near future!","Giữ chỗ cho điều gì đó tuyệt vời trong tương lai gần!"],["This module will be created when the patron count reach 500!","Mô-đun này sẽ được tạo khi số lượng người ủng hộ đạt 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tMột dự án có cùng tiêu đề <br>\"<span class=\"dialogGameTitle\"></span>\"<br> đã tồn tại trong bộ nhớ cache đã xử lý.<br>\n\t\tBạn có thể tái sử dụng bộ nhớ cache này để giảm đáng kể thời gian tải.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","Nếu bạn bối rối, bạn luôn có thể an toàn nhấp vào nút <strong><a href=\"#\">\"Tạo dự án mới\"</a></strong>."],["Existed cache","Bộ nhớ cache tồn tại"],["Select Translator","Chọn Trình dịch"],["Source column","Cột nguồn"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","Cột nào chứa văn bản nguồn để dịch?<br>(mặc định là cột khóa / cột ngoài cùng bên trái)."],["Target column","Cột đích"],["Which column is the translated text put into.<br>(Can not same with source column)","Cột nào để đặt văn bản đã dịch vào.<br>(Không thể trùng với cột nguồn)"],["Translator's Options","Tùy chọn của Trình dịch"],["Also try to translate other object","Cũng thử dịch các đối tượng khác"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","Nếu tùy chọn này được chọn, Translator++ cũng sẽ thử dịch các đối tượng khác mà bạn không chọn mà không yêu cầu dịch máy. Đây là hành vi mặc định trong Translator++ phiên bản 2.3.23 hoặc thấp hơn."],["Ignore if already translated","Bỏ qua nếu đã dịch"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Nếu tùy chọn này được chọn, Translator++ sẽ bỏ qua bất kỳ hàng nào đã có bản dịch trong cột của nó."],["Overwrite cells","Ghi đè ô"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","Ghi đè các ô đích. Nếu không được chọn, các ô sẽ không bị động chạm khi không trống."],["Save project on each batch.","Lưu dự án sau mỗi lô."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","Lưu dự án của bạn khi mỗi lô hoàn thành.<br>Tùy chọn này để tránh mất dữ liệu khi ứng dụng bị sập do chạy các tác vụ nặng từ ứng dụng trình dịch cục bộ. Bạn có thể không cần điều này nếu đang chạy trình dịch dựa trên đám mây."],["Play sound when completed.","Phát âm thanh khi hoàn thành."],["Tags","Thẻ"],["Select Context(s)","Chọn Ngữ cảnh"],["Manual Query","Truy vấn Thủ công"],["Match all words","Khớp tất cả từ"],["Remove selected","Xóa đã chọn"],["Remove all but selected","Xóa tất cả trừ đã chọn"],["Select Context","Chọn Ngữ cảnh"],["Source Column","Cột Nguồn"],["Target Column","Cột Đích"],["Maximum length","Độ dài tối đa"],["Export into","Xuất vào"],["What to do with tagged rows?","Làm gì với các hàng được gắn thẻ?"],["Select Color Tag","Chọn Thẻ Màu"],["On the fly word wrap","Tự động xuống dòng"],["Inject all files (ignoring selection)","Tiêm tất cả tệp (bỏ qua lựa chọn)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","Bạn sắp tiêm bản dịch qua nút <b>Tiêm tất cả</b>. Điều này sẽ tiêm bản dịch bất kể đối tượng bạn chọn ở khung bên trái. Sử dụng menu ngữ cảnh của khung trái nếu bạn muốn tiêm đối tượng đã chọn."],["Select the source material to be translated","Chọn tài liệu nguồn để dịch"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tChọn tài liệu hoặc nội dung cụ thể bạn muốn dịch, chẳng hạn như tệp, thư mục hoặc đầu vào liên quan khác. Đảm bảo tài liệu đã chọn có thể truy cập và được định dạng phù hợp cho trình phân tích tương ứng.<br>\n\t\t\t\tMặc định, một số trình phân tích sử dụng thư mục staging làm tài liệu nguồn.\n\t\t\t"],["Path is inaccessible.","Đường dẫn không thể truy cập."],["Target Directory","Thư mục Đích"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tMột bản sao của ứng dụng đã dịch của bạn sẽ được tạo trong thư mục này.\n\t\t\t"],["Field can not be empty!","Trường không được để trống!"],["Target to apply translation","Mục tiêu để áp dụng bản dịch"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tVui lòng chọn tệp thực thi.\n\t\t\t"],["Copy materials","Sao chép tài liệu"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","Các tùy chọn sao chép từ Tài liệu Nguồn sang Thư mục Đích. (thử nghiệm, không phải tất cả công cụ đều được hỗ trợ)"],["Word Wrap by Tags","Ngắt dòng bằng Thẻ"],["Directory name","Tên thư mục"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tĐối tượng sẽ được nhóm dưới thư mục này.<br>\n\t\t\t\tNhập dấu sao \"<code>*</code>\" để thêm một <b>đối tượng tham chiếu</b> mới.\n\t\t\t"],["Invalid directory  name","Tên thư mục không hợp lệ"],["Object name","Tên đối tượng"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tTên của đối tượng.\n\t\t\t"],["Invalid object name","Tên đối tượng không hợp lệ"],["New Project","Dự án Mới"],["Save","Lưu"],["Save as...","Lưu thành..."],["Open...","Mở..."],["Recent","Gần đây"],["None...","Không có..."],["Export Project","Xuất Dự án"],["To a folder","Đến một thư mục"],["As a zip file","Dưới dạng tệp zip"],["To portable .tpp file","Thành tệp .tpp di động"],["To RPGMakerTrans file (*.txt)","Thành tệp RPGMakerTrans (*.txt)"],["To CSV file","Thành tệp CSV"],["To XLSX file","Thành tệp XLSX"],["To XLS file","Thành tệp XLS"],["To ODS file","Thành tệp ODS"],["To HTML file","Thành tệp HTML"],["Import","Nhập"],["Project from .tpp file","Dự án từ tệp .tpp"],["Translation from .trans file","Bản dịch từ tệp .trans"],["Translation Spreadsheet","Bảng tính bản dịch"],["Translation RPGMKTRANSPATCH Format","Định dạng bản dịch RPGMKTRANSPATCH"],["Automation","Tự động hóa"],["Batch translation","Dịch hàng loạt"],["Context tool","Công cụ ngữ cảnh"],["Batch word wrapping","Xuống dòng hàng loạt"],["Trim","Cắt bớt"],["Auto padding","Tự động đệm"],["Tools","Công cụ"],["Third Party Application Installer","Trình cài đặt ứng dụng bên thứ ba"],["Close project","Đóng dự án"],["Exit","Thoát"],["Start here","Bắt đầu tại đây"],["Start a New Project","Bắt đầu một dự án mới"],["Continue your work","Tiếp tục công việc của bạn"],["Open Project","Mở dự án"],["Your recent translation","Bản dịch gần đây của bạn"],["Tips for you","Mẹo dành cho bạn"],["Next tip! <span class=\"icon-angle-double-right\"></span>","Mẹo tiếp theo! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","Ô ngoài cùng bên phải trong một hàng sẽ được ưu tiên."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","Bạn không thể chia sẻ dự án của mình với người khác chỉ bằng một tệp trans. Bạn cần tạo một tệp TPP."],["Always make backups of your trans files.","Luôn sao lưu các tệp trans của bạn."],["You can rename and reorder the column with the coulumn header's context menu.","Bạn có thể đổi tên và sắp xếp lại cột bằng menu ngữ cảnh của tiêu đề cột."],["Always backup your game before working with Translator++!","Luôn sao lưu trò chơi của bạn trước khi làm việc với Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","Nếu bạn gặp một tính năng không hoạt động bình thường, hãy thử khởi động lại Translator++, nó sẽ khắc phục vấn đề trong hầu hết các trường hợp."],["Always create a backup of your game before patching with a translation.","Luôn tạo bản sao lưu trò chơi của bạn trước khi vá với bản dịch."],["Thank you for supporting Translator++.","Cảm ơn bạn đã hỗ trợ Translator++."],["Please check Translator++'s online documentation at","Vui lòng kiểm tra tài liệu trực tuyến của Translator++ tại"],["working","đang hoạt động"],["Open","Mở"],["Save file","Lưu tệp"],["Save As","Lưu thành"],["Import Project","Nhập dự án"],["Inject / apply all translation","Tiêm / áp dụng tất cả bản dịch"],["Execute Global Level Custom Script","Thực thi tập lệnh tùy chỉnh cấp toàn cục"],["Toggle Active Cell Info","Bật/Tắt thông tin ô hoạt động"],["Project Properties","Thuộc tính dự án"],["Get Help (F1)","Nhận trợ giúp (F1)"],["Batch translation (crl+b)","Dịch hàng loạt (ctrl+b)"],["File list","Danh sách tệp"],["Live Translation Pane","Ngăn dịch trực tiếp"],["Toggle selection","Bật/Tắt lựa chọn"],["Invert selection","Đảo ngược lựa chọn"],["Add A New Object","Thêm đối tượng mới"],["Connect to auto translator","Kết nối với trình dịch tự động"],["Undock pane","Tách ngăn"],["Collapse / restore left panel","Thu gọn / khôi phục ngăn trái"],["Add new key (alt+n)","Thêm khóa mới (alt+n)"],["Import Here","Nhập tại đây"],["Add a note to this file","Thêm ghi chú vào tệp này"],["Open search menu","Mở menu tìm kiếm"],["Toggle grid information","Bật/tắt thông tin lưới"],["Object Properties","Thuộc tính đối tượng"],["Automatically set selected original text to clipboard","Tự động đặt văn bản gốc đã chọn vào clipboard"],["Resize Font","Thay đổi kích thước phông chữ"],["Toggle word wrapping & Explicit white spaces","Bật/tắt ngắt dòng & Khoảng trắng rõ ràng"],["Use Monospace font","Sử dụng phông chữ đơn cách"],["Remove all translation from this file","Xóa tất cả bản dịch khỏi tệp này"],["Remove this file from project","Xóa tệp này khỏi dự án"],["file path","đường dẫn tệp"],["Quick find","Tìm nhanh"],["Active cell's info","Thông tin ô đang hoạt động"],["View original untranslated text","Xem văn bản gốc chưa dịch"],["View raw data","Xem dữ liệu thô"],["View row properties","Xem thuộc tính hàng"],["Go to current cell","Đi đến ô hiện tại"],["Current coordinate","Tọa độ hiện tại"],["Word wraping (for non Japanese text)","Ngắt dòng (cho văn bản không phải tiếng Nhật)"],["Speak original text (alt+,)","Đọc văn bản gốc (alt+,)"],["Copy original text into current cell (ctrl+0)","Sao chép văn bản gốc vào ô hiện tại (ctrl+0)"],["Default translation for all occurrence","Bản dịch mặc định cho tất cả các lần xuất hiện"],["Translations by context","Bản dịch theo ngữ cảnh"],["This cell has a comment","Ô này có một bình luận"],["This cell has an organic content","Ô này có nội dung hữu cơ"],["This cell has been visited","Ô này đã được truy cập"],["This is the first time this cell has been visited","Đây là lần đầu tiên ô này được truy cập"],["Word wraping","Xuống dòng"],["Speak current translation text (alt+.)","Đọc văn bản dịch hiện tại (alt+.)"],["Current Cell Editor options","Tùy chọn trình chỉnh sửa ô hiện tại"],["Clear context translation for current row","Xóa bản dịch ngữ cảnh cho hàng hiện tại"],["Get help about translation by context","Nhận trợ giúp về dịch theo ngữ cảnh"],["Open menu","Mở menu"],["Path not accessible","Đường dẫn không thể truy cập"],["The location of the original material. You should not modify anything inside this folder.","Vị trí của tài liệu gốc. Bạn không nên sửa đổi bất cứ thứ gì bên trong thư mục này."],["The location of the game that has been translated. The default location of the translation injection.","Vị trí của trò chơi đã được dịch. Vị trí mặc định để tiêm bản dịch."],["Prefered translator for this project. If not defined, global setting will be used.","Trình dịch ưu tiên cho dự án này. Nếu không xác định, sẽ sử dụng cài đặt toàn cục."],["-use default-","-sử dụng mặc định-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","Đường dẫn staging là vị trí của một số tệp cần thiết để xuất/tạo bản dịch. Các tệp staging được tạo khi bạn tạo dự án."],["Number of objects/files available on the left pane","Số lượng đối tượng/tệp có sẵn ở ngăn bên trái"],["Number of characters in the Original Text column","Số ký tự trong cột Văn bản gốc"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","Có thể hiển thị sai giá trị trong các ngôn ngữ không sử dụng khoảng trắng (ví dụ: tiếng Nhật, tiếng Trung)."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","Người dùng đã điền trực tiếp vào lưới. Đó là một dấu hiệu tốt. Có thể là bản dịch của con người, có thể là MTL đã chỉnh sửa, v.v."],["Run a javascript function after this project is successfully exported.","Chạy một hàm javascript sau khi dự án này được xuất thành công."],["Import .TRANS into project","Nhập .TRANS vào dự án"],["Import Spreadsheet Options","Tùy chọn Nhập Bảng tính"],["Import RPGMTransPatch Options","Tùy chọn Nhập RPGMTransPatch"],["Start a new project","Bắt đầu một dự án mới"],["Search project type...","Tìm kiếm loại dự án..."],["Remove row","Xóa hàng"],["Add row","Thêm hàng"],["Project is exist","Dự án đã tồn tại"],["Context Tool","Công cụ Ngữ cảnh"],["Your list of context separated by new line","Danh sách ngữ cảnh của bạn được phân cách bằng dòng mới"],["Wrap text","Gói văn bản"],["Export Options","Tùy chọn Xuất"],["Tagging","Gắn thẻ"],["Apply Translation","Áp dụng Bản dịch"],["Add new Object","Thêm Đối tượng mới"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText","idx/56/innerText"],["idx/29/innerText","idx/152/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText","idx/41/innerText"],["idx/40/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"]