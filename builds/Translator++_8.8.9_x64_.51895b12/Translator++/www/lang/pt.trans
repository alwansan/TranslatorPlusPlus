og.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","Você pode visualizar informações mais detalhadas no log do console (F12)"],["Close","Fechar"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.parts.js":{"data":[["Form","Formulário"],["Cancel","Cancelar"],["Ok","Ok"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/jsoneditor.html":{"data":[["Remove note","Remover nota"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/login.html":{"data":[["working","trabalhando"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/note.html":{"data":[["Remove note","Remover nota"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/options.html":{"data":[["Click to login","Clique para fazer login"],["Translator &amp; Language","Tradutor &amp; Idioma"],["Proofreader","Revisor"],["Assistant","Assistente"],["General","Geral"],["Preferences","Preferências"],["Add-ons","Extensões"],["About","Sobre"],["User Information","Informações do Usuário"],["Login to your Patreon account to get access to the latest features and updates.","Faça login na sua conta do Patreon para acessar os recursos e atualizações mais recentes."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> Login"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> Login com navegador"],["Welcome,","Bem-vindo,"],["Name","Nome"],["Email","Email"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","Nível <div class=\"infoHeadNote\">(Assinatura atual em centavos de USD)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","Pontos <div class=\"infoHeadNote\">(Assinatura total vitalícia em centavos de USD)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","Status do pagamento <div class=\"infoHeadNote\">(Status atual do pagamento)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Não entre em pânico!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>E por favor, leia as seguintes informações.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Esta flag indica que o Patreon ainda não recebeu com sucesso os fundos da sua doação. É normal que o sistema de pagamento tenha atrasos. Dependendo do seu método de pagamento e país de origem, atrasos podem ocorrer por até 24 horas.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Durante este atraso, você pode ver um débito no seu cartão de crédito. Não se preocupe—o Patreon tentará novamente em intervalos regulares para verificar se recebeu seu pagamento. Isso geralmente se resolve em até 24 horas.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Se o problema persistir além desse período, por favor, poste no tópico <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> no servidor do Translator++ no Discord. Eu ajudarei o máximo possível.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Por favor, entenda que para prevenir fraudes, <b><span class=\"userInfoPoints\">pontos</span> e <span class=\"userInfoLevel\">Nível</span> não serão contabilizados até que seu pagamento seja recebido com sucesso pelo Patreon</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">Não entre em pânico!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","Esta flag indica que o Patreon ainda não recebeu com sucesso os fundos da sua doação. É normal que o sistema de pagamento tenha atrasos. Dependendo do seu método de pagamento e país de origem, atrasos podem ocorrer por até 24 horas."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","Durante este atraso, você pode ver um débito no seu cartão de crédito. Não se preocupe—o Patreon tentará novamente em intervalos regulares para verificar se recebeu seu pagamento. Isso geralmente se resolve em até 24 horas."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","Se o problema persistir além desse período, por favor, poste no tópico <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> no servidor do Translator++ no Discord. Eu ajudarei o máximo possível."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","Por favor, entenda que para prevenir fraudes, <b><span class=\"userInfoPoints\">pontos</span> e <span class=\"userInfoLevel\">Nível</span> não serão contabilizados até que seu pagamento seja recebido com sucesso pelo Patreon</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> Sair"],["Primary Translator","Tradutor Principal"],["Default Translator Engine","Motor de Tradução Padrão"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tEste Motor de Tradução será usado quando você pressionar <span class=\"keyboardHint\">Ctrl+g</span> na(s) célula(s) selecionada(s) para <strong>g</strong>erar tradução na célula selecionada.\n\t\t\t\t"],["Default Language","Idioma Padrão"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\tAs configurações de idioma padrão em todos os projetos!<br>\n\t\t\t\tAs configurações nas propriedades do projeto substituirão este valor.\n\t\t\t"],["Default Source Language","Idioma de Origem Padrão"],["Default Target Language","Idioma de Destino Padrão"],["Custom escape","Escape Personalizado"],["Patterns","Padrões"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tTodas as palavras que corresponderem ao padrão abaixo não serão traduzidas por tradutores automáticos. \n\t\t\t\t\t\tEsta seção é adequada para ocultar tags e scripts dos motores de tradução. <br>\n\t\t\t\t\t\tCada entrada é uma expressão regular válida em JavaScript, função ou literal string separada por <b>vírgula</b>.<br>\n\t\t\t\t\t\tO escape personalizado só funciona para <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">algoritmos de escape suportados</a>.\n\t\t\t\t\t\t<b>Dica:</b> Você também pode pedir ao ChatGPT para gerar expressões regulares. <br>\n\t\t\t\t\t\tPor favor, escreva o padrão regex junto com seu modificador.<br>\n\t\t\t\t\t\tpor exemplo:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","Testador"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tCole seu texto aqui para verificar o padrão.\n\t\t\t\t\t\tTodos os padrões correspondentes serão destacados.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>Em Construção</h2>\n\t\t\t\t<p>Esta área será o local onde as configurações e opções do verificador automático serão configuradas.</p>\n\t\t\t"],["AI Assistant","Assistente de IA"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Olá! Eu sou MIRAI, seu assistente de IA para o Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Basta clicar no meu ícone <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> no seu menu Início para conversar comigo. Posso ajudá-lo com:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Melhorias e sugestões de tradução</li>\n\t\t\t\t\t\t\t<li>Revisão e verificação de qualidade</li>\n\t\t\t\t\t\t\t<li>Configuração do seu fluxo de trabalho de tradução</li>\n\t\t\t\t\t\t\t<li>Criação de scripts de automação</li>\n\t\t\t\t\t\t\t<li>E muito mais!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Vamos tornar seu trabalho de tradução mais fácil e eficiente juntos!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. Ainda sou nova, então, por favor, seja paciente comigo.🙇‍♀️ Mas estou aprendendo e melhorando todos os dias!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","Configuração de IA"],["Model Endpoint","Endpoint do Modelo"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","A URL do endpoint da API para seu modelo de IA. Por exemplo: https://api.openai.com/v1/chat/completions"],["API Key","Chave da API"],["Your API key for authenticating with the AI service. This will be stored securely.","Sua chave de API para autenticação com o serviço de IA. Isso será armazenado com segurança."],["Model Name","Nome do Modelo"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","Selecione ou insira o modelo de IA a ser usado. Modelos com suporte a ferramentas são recomendados para melhores resultados."],["File Association","Associação de Arquivo"],["Extension","Extensão"],["Associate","Associar"],["Set All","Definir Todos"],["Unset All","Desfazer Todos"],["Apply","Aplicar"],["Update","Atualizar"],["Auto update","Atualização automática"],["Automatically update Translator++ if possible.","Atualizar automaticamente o Translator++ se possível."],["Allow reinstall the same version","Permitir reinstalar a mesma versão"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","Permitir que o Translator++ reinstale a mesma versão que já está instalada. Mantenha esta opção desativada após instalar a atualização, especialmente quando sua configuração de <b>Atualização automática</b> está ativada. Caso contrário, seu Translator++ continuará se atualizando toda vez que você abrir o programa."],["Use default browser to login","Usar navegador padrão para login"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","Use o navegador padrão confiável do seu sistema para fazer login na sua conta do Patreon. A menos que esta opção seja marcada, o navegador incorporado do Translator++ será usado."],["Multi threading","Multi threading"],["Number of thread","Número de threads"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","O número de processos filhos que são abertos simultaneamente.<br>\n\t\t\t\t\t\t\t0 = desativar multi threading. Todos os processos serão feitos pelo processo de renderização.<br>\n\t\t\t\t\t\t\tA quantidade ideal geralmente é o número de seus núcleos físicos - 1.\n\t\t\t\t\t\t"],["Backup","Backup"],["Enable backup","Ativar backup"],["Automatically create backup every time you save your project.","Criar backup automaticamente sempre que você salvar seu projeto."],["Backup level history","Histórico de níveis de backup"],["How many history of backup do you want to keep?","Quantos históricos de backup você deseja manter?"],["Log &amp; Debugging","Log &amp; Depuração"],["Log to file","Log para arquivo"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","Log para arquivo em vez da janela de console padrão.<br>Isso é útil se você quiser depurar o Translator++ e não tiver acesso à janela de console. Ativar esta opção afetará ligeiramente o desempenho. Portanto, você deve manter esta opção desativada o tempo todo, exceto quando estiver depurando ou relatando problemas.<br>Os logs são salvos na pasta data/logs/."],["Truncate log file each session","Truncar arquivo de log a cada sessão"],["When checked your log file will be truncated each time you re open the application.","Quando marcado, seu arquivo de log será truncado cada vez que você reabrir o aplicativo."],["Application Settings","Configurações do Aplicativo"],["Enable remote debugging","Ativar depuração remota"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","Ativa o protocolo de depuração remota do Chrome DevTools na porta 9222. Isso permite que você inspecione e depure o Translator++ usando um navegador externo navegando para <code>chrome://inspect</code>. Esta flag adiciona <code>--remote-debugging-port=9222</code> aos argumentos de inicialização do aplicativo. É necessário reiniciar para aplicar as alterações."],["Disable GPU","Desativar GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","Desativa a aceleração de GPU por hardware. Isso é útil se você tiver problemas visuais, travamentos ou problemas de renderização em determinados hardwares gráficos ou drivers. Esta flag adiciona <code>--disable-gpu</code> aos argumentos de inicialização do aplicativo. É necessário reiniciar para aplicar as alterações."],["Dangerous Area","Área Perigosa"],["Interface Language","Idioma da Interface"],["UI Language","Idioma da UI"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","Defina o idioma da interface do usuário. Você pode criar sua própria localização se o Translator++ não estiver disponível no seu idioma. Os dados de idioma estão localizados dentro da pasta www/lang."],["Spell checker Language","Idioma do Corretor Ortográfico"],["Set the default spell checker language.","Defina o idioma padrão do corretor ortográfico."],["Environment Variables","Variáveis de Ambiente"],["Staging Directory","Diretório de Preparação"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","O Diretório de Preparação é um cache fixo de projetos em andamento. Uma parte dos dados das matérias-primas é copiada para este diretório para ser acessada pelos scripts do interpretador."],["Project creation","Criação de Projeto"],["Auto Load Common Reference","Carregar Referência Comum Automaticamente"],["Auto load common reference from .trans file.","Carregar automaticamente a referência comum a partir do arquivo .trans."],["Project settings","Configurações do Projeto"],["Progress Column Indices","Índices das Colunas de Progresso"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","Aqui, você pode especificar quais colunas serão incluídas no cálculo do progresso do projeto.\n\t\t\t\t\t\t\t<br>O índice da coluna é um número inteiro baseado em zero, onde a coluna mais à esquerda é 0.\n\t\t\t\t\t\t\t<br>Use vírgulas para especificar múltiplas colunas. Por exemplo: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Padrão: Em branco</b>. Se deixado em branco, o Translator++ calculará o progresso de todas as colunas disponíveis.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>Ativar/Desativar"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>Instalar"],["Install from a package","Instalar a partir de um pacote"],["Visit our website &amp; documentation : ","Visite nosso site e documentação: "],["Fork Translator++ at : ","Fork do Translator++ em: "],["Support Translator++ at : ","Apoie o Translator++ em: "],["Join our discord channel at : ","Junte-se ao nosso canal do Discord em: "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) Se você é um patrono, deve <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">vincular sua conta do Discord no seu perfil do Patreon</a>. Você será convidado automaticamente e há benefícios esperando por você!"],["Version Info","Informações da Versão"],["Last checked at : ","Última verificação em: "],["Check now!","Verificar agora!"],["You have a pending update","Você tem uma atualização pendente"],["Update now","Atualizar agora"],["Your Translator++ is up to date 😃.","Seu Translator++ está atualizado 😃."],["Architecture","Arquitetura"],["License","Licença"],["Click here to read the license.","Clique aqui para ler a licença."],["Credits","Créditos"],["Localization","Localização"],["About Third Party Software","Sobre Software de Terceiros"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tEste software utiliza softwares de terceiros localizados em /3rdParty. Esses softwares de terceiros possuem suas próprias licenças e \n\t\t\t\tsão incluídos apenas por conveniência de uso e \n\t\t\t\tfornecidos “como estão” sem garantia de qualquer tipo, expressa ou implícita, e tais softwares devem ser usados por sua própria conta e risco.\n\t\t\t\t"],["Special Thanks","Agradecimentos Especiais"],["Want to explicitly support Translator++ by putting your name on this section?","Deseja apoiar explicitamente o Translator++ colocando seu nome nesta seção?"],["Click here to learn more about how to do that!","Clique aqui para saber mais sobre como fazer isso!"],["Changelog","Registro de Mudanças"],["Feeds","Feeds"],["Click connect button, to connect translator with Translator++ table","Clique no botão conectar, para conectar o tradutor com a tabela do Translator++"],["working","funcionando"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Nível do Patreon/Sua contribuição atual deste mês em centavos (1 USD = 100 lv)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","Pontos/Sua contribuição vitalícia+bônus em centavos (1 USD = 100 pts)"],["Filter...","Filtrar..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":124,"length":124,"percent":100},"parameters":[]},"/scriptEditor.html":{"data":[["Run","Executar"],["New Project (ctrl+n)","Novo Projeto (ctrl+n)"],["Open (ctrl+o)","Abrir (ctrl+o)"],["Save file (ctrl+s)","Salvar arquivo (ctrl+s)"],["Save As (ctrl+shift+s)","Salvar Como (ctrl+shift+s)"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ajuda"],["Select file in the current workspace","Selecionar arquivo no espaço de trabalho atual"],["file path","caminho do arquivo"],["Create shortcut of the current script","Criar atalho do script atual"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/tableEditor.html":{"data":[["Reset","Redefinir"],["Clear","Limpar"],["Search","Pesquisar"],["Help","Ajuda"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/trans.html":{"data":[["Start","Iniciar"],["Home","Início"],["Translator","Tradutor"],["Objects","Objetos"],["Live translation","Tradução ao vivo"],["Original","Original"],["Raw","Cru"],["Row Properties","Propriedades da Linha"],["Default translation","Tradução Padrão"],["Context translation","Tradução de Contexto"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\tO caminho <a class=\"problemPath\"></a> não é acessível pelo interpretador PHP.<br>\n\t\tPor favor, renomeie o caminho e use apenas nomes alfanuméricos.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>Localização</span>"],["File :","Arquivo :"],["Row ID :","ID da Linha :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>Contexto</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>Atores</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>Texto-Chave</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>Melhor Tradução</span>"],["File ID","ID do Arquivo"],["Path","Caminho"],["Original Format","Formato Original"],["Data Length","Comprimento dos Dados"],["Translated","Traduzido"],["General","Geral"],["Language","Idioma"],["Staging","Estágio"],["Stats","Estatísticas"],["Advanced","Avançado"],["Info","Informação"],["Title","Título"],["File Location","Localização do Arquivo"],["Project ID","ID do Projeto"],["Built on","Construído em"],["Editor Name","Nome do Editor"],["Editor Version","Versão do Editor"],["Engine","Motor"],["Parser","Analisador"],["Parser version","Versão do Analisador"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","Localização do Material Original <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"A localização do material original. Você não deve modificar nada dentro desta pasta.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Caminho inválido.<br>Alguns recursos serão desativados até que isso seja corrigido."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","Localização do Material Traduzido <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"A localização do jogo que foi traduzido. A localização padrão da injeção da tradução.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","Tradutor <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Tradutor preferido para este projeto. Se não definido, a configuração global será usada.\"></i>"],["Translate From","Traduzir De"],["Translate Into","Traduzir Para"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","Caminho de Preparação <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"O caminho de preparação é a localização de alguns arquivos necessários para exportar/construir traduções. Arquivos de preparação gerados quando você criou o projeto.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","Objetos <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Número de objetos/arquivos disponíveis no painel esquerdo\"></i>"],["Folders","Pastas"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","Caracteres <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Número de caracteres na coluna Texto Original\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","Palavras <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Pode exibir valor incorreto em idiomas que não usam espaços (ex.: japonês, chinês).\"></i>"],["Total Rows","Total de Linhas"],["Translated row","Linha traduzida"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","Tradução orgânica <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Preenchido diretamente pelos usuários na grade. O que é um bom sinal. Pode ser tradução humana, MTL editado, etc.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","Progresso geral <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","Executar após exportação<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Executar uma função javascript após este projeto ser exportado com sucesso.\"></i>"],["Display this information when the project is opened.","Exibir esta informação quando o projeto for aberto."],["Select Export Mode","Selecionar Modo de Exportação"],["Export to a folder","Exportar para uma pasta"],["Export pre-compiled game data to a folder<br>Folder structures are retained","Exportar dados de jogo pré-compilados para uma pasta<br>As estruturas de pastas são mantidas"],["Export as a Zip file","Exportar como arquivo Zip"],["Export pre-compiled game data to a single zipped archive","Exportar dados de jogo pré-compilados para um único arquivo compactado"],["RPGMakerTrans Patch Files","Arquivos de Patch RPGMakerTrans"],["Export to RPGMakerTrans formatted *.txt files in a folder","Exportar para arquivos *.txt formatados RPGMakerTrans em uma pasta"],["Comma Separated Values","Valores Separados por Vírgula"],["Export to Comma Separated Values (csv) files in a folder","Exportar para arquivos Valores Separados por Vírgula (csv) em uma pasta"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007 e superior"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","Exportar para arquivos de Planilha do Microsoft Excel (xlsx) em uma pasta"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97 e acima"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","Exportar para arquivos de Planilha do Microsoft Excel (xls) em uma pasta"],["HTML Spreadsheet","Planilha HTML"],["Export to HTML files in a folder","Exportar para arquivos HTML em uma pasta"],["Open Document Format/OASIS (.ods)","Formato de Documento Aberto/OASIS (.ods)"],["Export to ODS files in a folder","Exportar para arquivos ODS em uma pasta"],["Select Import Mode","Selecionar Modo de Importação"],["Import translation from another .trans file","Importar tradução de outro arquivo .trans"],["Open another Translator++ file<br>Apply translation into current project.","Abrir outro arquivo do Translator++<br>Aplicar tradução no projeto atual."],["Import translation from spreadsheets","Importar tradução de planilhas"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","Importar tradução de vários arquivos de planilha<br>(.xls, .xlsx, .ods, .html, .xml, etc)"],["Import translation from RPGMakerTrans Patch format","Importar tradução do formato de Patch RPGMakerTrans"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","Importar tradução dos arquivos de patch do RPGMaker Trans<br>(.txt)"],["Source :","Fonte :"],["Select objects to import","Selecionar objetos para importar"],["Import mode :","Modo de importação :"],["Import translations","Importar traduções"],["Import data object","Importar objeto de dados"],["Destination :","Destino :"],["Currently selected : ","Atualmente selecionado : "],["Options :","Opções :"],["Import the context translations","Importar as traduções de contexto"],["Case insensitive","Sem distinção de maiúsculas/minúsculas"],["Overwrite target","Sobrescrever destino"],["Destination column : ","Coluna de destino : "],["Translation mode :","Modo de tradução :"],["Row by row translation","Tradução linha por linha"],["Line by line translation","Tradução linha a linha"],["Select translation by context address","Selecionar tradução por endereço de contexto"],["Just copy translation into the same row (No checking)","Apenas copiar tradução para a mesma linha (Sem verificação)"],["Merge data","Mesclar dados"],["Import translation from spreadsheet into project","Importar tradução de planilha para o projeto"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","Importar tradução de qualquer formato de planilha (xls, xlsx, odx, html, csv, etc)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>A planilha deve ter pelo menos 2 colunas.</b> A coluna mais importante é a primeira coluna (a mais à esquerda) contendo os textos originais. As colunas seguintes contêm as traduções. O Translator++ usará o texto na célula mais à direita que não estiver vazia."],["Please click the radio button to select files/folder to import","Por favor, clique no botão de rádio para selecionar arquivos/pasta para importar"],["Import file(s)","Importar arquivo(s)"],["Import folder","Importar pasta"],["Import translation from RPG Maker Trans into project","Importar tradução do RPG Maker Trans para o projeto"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">Selecionar tipo de projeto</span>"],["Select project type","Selecionar tipo de projeto"],["Spreadsheet","Planilha"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","Iniciar um projeto de tradução a partir de dados de planilha (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","Projeto em branco"],["Create a new .trans file from scratch.","Criar um novo arquivo .trans do zero."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Planilha</span>"],["Fetch type","Tipo de busca"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","As primeiras colunas são texto traduzível, o restante das colunas são traduções predefinidas (Crie dados de grade que correspondam à tabela original)"],["All columns are translatable text","Todas as colunas são texto traduzível"],["Custom","Personalizado"],["Custom Options","Opções Personalizadas"],["Which column do you want to fetch?","Qual coluna você deseja buscar?"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","Por favor, especifique qual coluna você deseja buscar e em qual coluna deseja colocar a tradução. <b>É um índice baseado em 0 (a primeira coluna é 0)</b>."],["Column to be translated","Coluna a ser traduzida"],["Column to put translation into","Coluna para colocar a tradução"],["Action","Ação"],["Enable Row Header Text Column","Habilitar Coluna de Texto do Cabeçalho da Linha"],["If enabled, the parser will process the following Row Header Text Column rule","Se habilitado, o analisador processará a seguinte regra da Coluna de Texto do Cabeçalho da Linha"],["Row Header Text Column","Coluna de Texto do Cabeçalho da Linha"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","Se especificado, o valor nesta coluna será aplicado ao cabeçalho da linha. Isso é útil para determinar o falante ou ator atual, etc. É um índice baseado em zero."],["Options","Opções"],["Calculate cell value","Calcular valor da célula"],["Cell value in the form of formula will be transpiled","O valor da célula na forma de fórmula será transpilado"],["Get formatted value","Obter valor formatado"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","Processar valores das células após formatação. (Por exemplo, o inteiro 100000 em certas localidades se tornará USD 100.000)"],["Parse CSV in EXCEL format","Analisar CSV no formato EXCEL"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","Forçar o analisador a analisar CSV no modo MS EXCEL. (apenas para arquivos CSV)"],["Skip the first <i>n</i> row(s)","Pular as primeiras <i>n</i> linha(s)"],["Use this option if you want to skip the row header.","Use esta opção se quiser pular o cabeçalho da linha."],["Select File(s)","Selecionar Arquivo(s)"],["Select a directory","Selecionar um diretório"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Criar um novo arquivo Trans</span>"],["Create a new Trans file","Criar um novo arquivo Trans"],["The title of this project","O título deste projeto"],["Engine type","Tipo de motor"],["Type of the engine","Tipo do motor"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Espaço reservado para algo incrível em breve!</span>"],["Placeholder for something great at the near future!","Espaço reservado para algo incrível em breve!"],["This module will be created when the patron count reach 500!","Este módulo será criado quando o número de patrocinadores atingir 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tUm projeto com o mesmo título <br>\"<span class=\"dialogGameTitle\"></span>\"<br> já existe no cache pós-processado.<br>\n\t\tVocê pode reutilizar este cache para reduzir significativamente o tempo de carregamento.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","Se você estiver confuso, pode sempre clicar com segurança no botão <strong><a href=\"#\">\"Criar novo projeto\"</a></strong>."],["Existed cache","Cache existente"],["Select Translator","Selecionar Tradutor"],["Source column","Coluna de origem"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","Qual coluna contém o texto de origem para traduzir?<br>(padrão é a coluna chave / coluna mais à esquerda)."],["Target column","Coluna de destino"],["Which column is the translated text put into.<br>(Can not same with source column)","Em qual coluna o texto traduzido será colocado.<br>(Não pode ser a mesma que a coluna de origem)"],["Translator's Options","Opções do Tradutor"],["Also try to translate other object","Também tentar traduzir outros objetos"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","Se esta opção estiver marcada, o Translator++ também tentará traduzir outros objetos que você não selecionou e que não exigem tradução automática. Este é o comportamento padrão no Translator++ versão 2.3.23 ou inferior."],["Ignore if already translated","Ignorar se já traduzido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Se esta opção estiver marcada, o Translator++ ignorará qualquer linha que já tenha traduções em sua coluna."],["Overwrite cells","Sobrescrever células"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","Sobrescrever células de destino. Se não marcado, as células não serão tocadas quando não estiverem vazias."],["Save project on each batch.","Salvar projeto a cada lote."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","Salve seu projeto a cada conclusão de lote.<br>Esta opção evita a perda de dados quando o aplicativo trava devido à execução de tarefas pesadas do aplicativo tradutor local. Você provavelmente não precisa disso se estiver usando um tradutor baseado em nuvem."],["Play sound when completed.","Reproduzir som quando concluído."],["Tags","Tags"],["Select Context(s)","Selecionar Contexto(s)"],["Manual Query","Consulta Manual"],["Match all words","Corresponder todas as palavras"],["Remove selected","Remover selecionado"],["Remove all but selected","Remover tudo exceto selecionado"],["Select Context","Selecionar Contexto"],["Source Column","Coluna de Origem"],["Target Column","Coluna de Destino"],["Maximum length","Comprimento máximo"],["Export into","Exportar para"],["What to do with tagged rows?","O que fazer com as linhas marcadas?"],["Select Color Tag","Selecionar Etiqueta de Cor"],["On the fly word wrap","Quebra de linha dinâmica"],["Inject all files (ignoring selection)","Injetar todos os arquivos (ignorando seleção)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","Você está prestes a injetar tradução via botão <b>Injetar todos</b>. Isso injetará tradução independentemente do objeto selecionado no painel esquerdo. Use o menu de contexto do painel esquerdo se quiser injetar o objeto selecionado."],["Select the source material to be translated","Selecione o material de origem a ser traduzido"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tSelecione o material ou conteúdo específico que deseja traduzir, como um arquivo, diretório ou outra entrada relevante. Certifique-se de que o material escolhido esteja acessível e formatado adequadamente para o analisador correspondente.<br>\n\t\t\t\tPor padrão, alguns analisadores usam o diretório de preparação como material de origem.\n\t\t\t"],["Path is inaccessible.","Caminho inacessível."],["Target Directory","Diretório de Destino"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tUma cópia do seu aplicativo traduzido será gerada nesta pasta.\n\t\t\t"],["Field can not be empty!","O campo não pode estar vazio!"],["Target to apply translation","Destino para aplicar tradução"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tSelecione o arquivo executável.\n\t\t\t"],["Copy materials","Copiar materiais"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","As opções de cópia do Material de Origem para o Diretório de Destino. (experimental, nem todos os motores são suportados)"],["Word Wrap by Tags","Quebra de Linha por Tags"],["Directory name","Nome do diretório"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tO objeto será agrupado neste diretório.<br>\n\t\t\t\tDigite asterisco \"<code>*</code>\" para adicionar um novo <b>objeto de referência</b>.\n\t\t\t"],["Invalid directory  name","Nome de diretório inválido"],["Object name","Nome do objeto"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tO nome do objeto.\n\t\t\t"],["Invalid object name","Nome de objeto inválido"],["New Project","Novo Projeto"],["Save","Salvar"],["Save as...","Salvar como..."],["Open...","Abrir..."],["Recent","Recentes"],["None...","Nenhum..."],["Export Project","Exportar Projeto"],["To a folder","Para uma pasta"],["As a zip file","Como um arquivo zip"],["To portable .tpp file","Para arquivo .tpp portátil"],["To RPGMakerTrans file (*.txt)","Para arquivo RPGMakerTrans (*.txt)"],["To CSV file","Para arquivo CSV"],["To XLSX file","Para arquivo XLSX"],["To XLS file","Para arquivo XLS"],["To ODS file","Para arquivo ODS"],["To HTML file","Para arquivo HTML"],["Import","Importar"],["Project from .tpp file","Projeto de arquivo .tpp"],["Translation from .trans file","Tradução de arquivo .trans"],["Translation Spreadsheet","Planilha de tradução"],["Translation RPGMKTRANSPATCH Format","Formato RPGMKTRANSPATCH de tradução"],["Automation","Automação"],["Batch translation","Tradução em lote"],["Context tool","Ferramenta de contexto"],["Batch word wrapping","Quebra de linha em lote"],["Trim","Aparar"],["Auto padding","Preenchimento automático"],["Tools","Ferramentas"],["Third Party Application Installer","Instalador de aplicativos de terceiros"],["Close project","Fechar projeto"],["Exit","Sair"],["Start here","Comece aqui"],["Start a New Project","Iniciar um Novo Projeto"],["Continue your work","Continuar seu trabalho"],["Open Project","Abrir Projeto"],["Your recent translation","Sua tradução recente"],["Tips for you","Dicas para você"],["Next tip! <span class=\"icon-angle-double-right\"></span>","Próxima dica! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","A célula mais à direita em uma linha terá prioridade."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","Você não pode compartilhar seu projeto com outros apenas com um arquivo trans. Você precisa gerar um arquivo TPP."],["Always make backups of your trans files.","Sempre faça backups dos seus arquivos trans."],["You can rename and reorder the column with the coulumn header's context menu.","Você pode renomear e reordenar a coluna com o menu de contexto do cabeçalho da coluna."],["Always backup your game before working with Translator++!","Sempre faça backup do seu jogo antes de trabalhar com o Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","Se você encontrou um recurso que não está funcionando normalmente, tente reiniciar o Translator++, isso resolverá o problema na maioria dos casos."],["Always create a backup of your game before patching with a translation.","Sempre crie um backup do seu jogo antes de aplicar uma tradução."],["Thank you for supporting Translator++.","Obrigado por apoiar o Translator++."],["Please check Translator++'s online documentation at","Por favor, verifique a documentação online do Translator++ em"],["working","trabalhando"],["Open","Abrir"],["Save file","Salvar arquivo"],["Save As","Salvar Como"],["Import Project","Importar Projeto"],["Inject / apply all translation","Injetar / aplicar todas as traduções"],["Execute Global Level Custom Script","Executar Script Personalizado de Nível Global"],["Toggle Active Cell Info","Alternar Informações da Célula Ativa"],["Project Properties","Propriedades do Projeto"],["Get Help (F1)","Obter Ajuda (F1)"],["Batch translation (crl+b)","Tradução em Lote (ctrl+b)"],["File list","Lista de Arquivos"],["Live Translation Pane","Painel de Tradução ao Vivo"],["Toggle selection","Alternar seleção"],["Invert selection","Inverter seleção"],["Add A New Object","Adicionar um Novo Objeto"],["Connect to auto translator","Conectar ao tradutor automático"],["Undock pane","Desancorar painel"],["Collapse / restore left panel","Recolher / restaurar painel esquerdo"],["Add new key (alt+n)","Adicionar nova chave (alt+n)"],["Import Here","Importar Aqui"],["Add a note to this file","Adicionar uma nota a este arquivo"],["Open search menu","Abrir menu de busca"],["Toggle grid information","Alternar informações da grade"],["Object Properties","Propriedades do Objeto"],["Automatically set selected original text to clipboard","Definir automaticamente o texto original selecionado para a área de transferência"],["Resize Font","Redimensionar Fonte"],["Toggle word wrapping & Explicit white spaces","Alternar quebra de linha e espaços em branco explícitos"],["Use Monospace font","Usar fonte monoespaçada"],["Remove all translation from this file","Remover todas as traduções deste arquivo"],["Remove this file from project","Remover este arquivo do projeto"],["file path","caminho do arquivo"],["Quick find","Busca rápida"],["Active cell's info","Informações da célula ativa"],["View original untranslated text","Ver texto original não traduzido"],["View raw data","Ver dados brutos"],["View row properties","Ver propriedades da linha"],["Go to current cell","Ir para a célula atual"],["Current coordinate","Coordenada atual"],["Word wraping (for non Japanese text)","Quebra de linha (para texto não japonês)"],["Speak original text (alt+,)","Falar texto original (alt+,)"],["Copy original text into current cell (ctrl+0)","Copiar texto original para a célula atual (ctrl+0)"],["Default translation for all occurrence","Tradução padrão para todas as ocorrências"],["Translations by context","Traduções por contexto"],["This cell has a comment","Esta célula tem um comentário"],["This cell has an organic content","Esta célula tem um conteúdo orgânico"],["This cell has been visited","Esta célula foi visitada"],["This is the first time this cell has been visited","Esta é a primeira vez que esta célula foi visitada"],["Word wraping","Quebra de linha"],["Speak current translation text (alt+.)","Falar texto de tradução atual (alt+.)"],["Current Cell Editor options","Opções do Editor de Célula Atual"],["Clear context translation for current row","Limpar tradução de contexto para a linha atual"],["Get help about translation by context","Obter ajuda sobre tradução por contexto"],["Open menu","Abrir menu"],["Path not accessible","Caminho não acessível"],["The location of the original material. You should not modify anything inside this folder.","A localização do material original. Você não deve modificar nada dentro desta pasta."],["The location of the game that has been translated. The default location of the translation injection.","A localização do jogo que foi traduzido. A localização padrão da injeção da tradução."],["Prefered translator for this project. If not defined, global setting will be used.","Tradutor preferido para este projeto. Se não definido, a configuração global será usada."],["-use default-","-usar padrão-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","O caminho de preparação é a localização de alguns arquivos necessários para exportar/construir traduções. Arquivos de preparação gerados quando você criou o projeto."],["Number of objects/files available on the left pane","Número de objetos/arquivos disponíveis no painel esquerdo"],["Number of characters in the Original Text column","Número de caracteres na coluna Texto Original"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","Pode exibir valor incorreto em idiomas que não usam espaços (ex. Japonês, Chinês)."],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","Usuários preencheram diretamente na grade. O que é um bom sinal. Pode ser tradução humana, MTL editada, etc."],["Run a javascript function after this project is successfully exported.","Executar uma função javascript após este projeto ser exportado com sucesso."],["Import .TRANS into project","Importar .TRANS para o projeto"],["Import Spreadsheet Options","Opções de Importação de Planilha"],["Import RPGMTransPatch Options","Opções de Importação de RPGMTransPatch"],["Start a new project","Iniciar um novo projeto"],["Search project type...","Pesquisar tipo de projeto..."],["Remove row","Remover linha"],["Add row","Adicionar linha"],["Project is exist","Projeto já existe"],["Context Tool","Ferramenta de Contexto"],["Your list of context separated by new line","Sua lista de contexto separada por nova linha"],["Wrap text","Quebrar texto"],["Export Options","Opções de Exportação"],["Tagging","Marcação"],["Apply Translation","Aplicar Tradução"],["Add new Object","Adicionar novo Objeto"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText","idx/56/innerText"],["idx/29/innerText","idx/152/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText","idx/41/innerText"],["idx/40/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/inn