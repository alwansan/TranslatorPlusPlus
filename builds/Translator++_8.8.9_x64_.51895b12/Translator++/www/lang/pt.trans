direct download!</b> Separate each download link with newline.":19,"Download Links":20,"Downloadable package for manual download. Separate each download link with newline.":21,"Release Category":22,"Category of the release.":23,"Upload log along with this submission.":24,"Remove the same version found on database.":25,"Whether this release is enabled or not.":26,"Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.":27,"Release Name":28,"Release Number":29,"Release Date":30,"Release Key":31,"Release Type":32,"CRC":33,"Required Version":34,"Minimum Version":35,"Release Note":36,"Release Info":37,"On Before Install":38,"On After Install":39,"Extra parameters":40,"Remote file":41,"List of remote file, separate by new line":42,"Patron Level":43,"Post title":44,"Release post":45,"Excerpt of the post":46},"tags":[],"relPath":"/addons/adminTools/!post.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":47,"length":47,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/!postPackage.html":{"data":[["Select package json file","Selecionar arquivo json do pacote"],["Select the generated patch file","Selecionar o arquivo de patch gerado"],["Or Select Destination File","Ou Selecionar Arquivo de Destino"],["Or Download location","Ou Local de download"],["Icon","Ícone"],["Author","Autor"],["Name","Nome"],["name of the package.","nome do pacote."],["Title","Título"],["Title of the package.","Título do pacote."],["Version","Versão"],["Version of the package.","Versão do pacote."],["Description","Descrição"],["Description of the package.","Descrição do pacote."],["Whether this release is active or not.","Se esta versão está ativa ou não."],["Whether this release is hidden or not.","Se esta versão está oculta ou não."],["Patron Level","Nível de Patrono"],["Current month's pledge in $","Contribuição do mês atual em $"],["Patron Points","Pontos de Patrono"],["100pts = 1$","100pts = 1$"],["Purchase type","Tipo de compra"],["Type of the purchase.","Tipo da compra."],["On Before Install","Antes da Instalação"],["Javascript code to be run before install","Código Javascript a ser executado antes da instalação"],["On After Install","Após a Instalação"],["Javascript code to be run after install","Código Javascript a ser executado após a instalação"],["Manifest","Manifesto"],["Manifest data","Dados do manifesto"],["Minimum version","Versão mínima"],["Minimum version of Translator++ to be able to insatall this addon.","Versão mínima do Translator++ para poder instalar este addon."],["Release Date","Data de Lançamento"],["Is parser changed?","O parser foi alterado?"],["Mark as parser change. Would warn the user to backup their project before updating to this addon.","Marcar como alteração do parser. Avisaria ao usuário para fazer backup do projeto antes de atualizar para este addon."],["Remove the same version found on database.","Remover a mesma versão encontrada no banco de dados."],["Excluded files","Arquivos excluídos"],["Files listed here will be excluded from the distribution packages","Arquivos listados aqui serão excluídos dos pacotes de distribuição"],["Script URL","URL do script"],["Script of the URL.","Script da URL."],["Upload script","Enviar script"],["This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t","Este script será enviado para o back-end e processado com o [php]Scripts template script.\n\t\t\t\t\tPara usar este recurso:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Crie uma página wordpress com o template <b>[php]Scripts template</b>.<br>Você também pode definir o requisito do patreon para visualizar o post.</li>\n\t\t\t\t\t\t<li>Adicione a URL da página ao arquivo package.json com o parâmetro GET <b>l</b> apontando para o arquivo local.<br>\n\t\t\t\t\t\tPor exemplo: <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t"],["Actions","Ações"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/3/innerText"],["idx/2/innerText"],["idx/4/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/47/innerText"]],"basename":"!postPackage.html","dirname":"/addons/adminTools","extension":".html","filename":"!postPackage.html","path":"/addons/adminTools/!postPackage.html","indexIsBuilt":false,"indexIds":{"Select package json file":0,"Select the generated patch file":1,"Or Select Destination File":2,"Or Download location":3,"Icon":4,"Author":5,"Name":6,"name of the package.":7,"Title":8,"Title of the package.":9,"Version":10,"Version of the package.":11,"Description":12,"Description of the package.":13,"Whether this release is active or not.":14,"Whether this release is hidden or not.":15,"Patron Level":16,"Current month's pledge in $":17,"Patron Points":18,"100pts = 1$":19,"Purchase type":20,"Type of the purchase.":21,"On Before Install":22,"Javascript code to be run before install":23,"On After Install":24,"Javascript code to be run after install":25,"Manifest":26,"Manifest data":27,"Minimum version":28,"Minimum version of Translator++ to be able to insatall this addon.":29,"Release Date":30,"Is parser changed?":31,"Mark as parser change. Would warn the user to backup their project before updating to this addon.":32,"Remove the same version found on database.":33,"Excluded files":34,"Files listed here will be excluded from the distribution packages":35,"Script URL":36,"Script of the URL.":37,"Upload script":38,"This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t":39,"Actions":40},"tags":[],"relPath":"/addons/adminTools/!postPackage.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":41,"length":41,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/adminTools.js":{"data":[["Close","Fechar"]],"context":[["tid/588/type/StringLiteral"]],"basename":"adminTools.js","dirname":"/addons/adminTools","extension":".js","filename":"adminTools.js","path":"/addons/adminTools/adminTools.js","indexIsBuilt":false,"indexIds":{"Close":0},"tags":[],"relPath":"/addons/adminTools/adminTools.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}]],"lastSelectedCell":[0,1]},"/addons/aec/aec.js":{"data":[["Universal Archive Unpacker","Descompactador de Arquivo Universal"]],"context":[["tid/1001/type/StringLiteral","tid/1239/type/StringLiteral"]],"basename":"aec.js","dirname":"/addons/aec","extension":".js","filename":"aec.js","path":"/addons/aec/aec.js","indexIsBuilt":false,"indexIds":{"Universal Archive Unpacker":0},"tags":[],"relPath":"/addons/aec/aec.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/bakinParser/bakin-proxy.js":{"data":[["Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.","Extrai um dicionário do jogo Bakin de data.rbpack, traduz dic.txt e aplica o patch automaticamente no player."],["Create project","Criar projeto"],["Error: customField is not defined. This should not happen!","Erro: customField não está definido. Isso não deveria acontecer!"],["Please select the Bakin game executable.","Por favor, selecione o executável do jogo Bakin."],["<h2>Proxy workflow</h2>","<h2>Fluxo de trabalho do proxy</h2>"],["Translator++ unpacks data.rbpack into a temporary folder.","O Translator++ descompacta data.rbpack em uma pasta temporária."],["Split Dictionary uses dump-split and creates one .txt file per source area by default.","Dividir Dicionário usa dump-split e cria um arquivo .txt por área de origem por padrão."],["Merge Dictionary uses a single dic.txt.","Mesclar Dicionário usa um único dic.txt."],["Injection merges split dictionaries back into data/dic.txt and patches the player executable.","A injeção mescla dicionários divididos de volta em data/dic.txt e corrige o executável do jogador."],["Split Dictionary (default)","Dividir Dicionário (padrão)"],["Merge Dictionary","Mesclar Dicionário"]],"context":[["tid/2860/type/StringLiteral"],["tid/2929/type/StringLiteral"],["tid/2966/type/StringLiteral"],["tid/3002/type/StringLiteral"],["tid/3253/type/NoSubstitutionTemplate"],["tid/3266/type/StringLiteral"],["tid/3277/type/StringLiteral"],["tid/3288/type/StringLiteral"],["tid/3299/type/StringLiteral"],["tid/3383/type/StringLiteral"],["tid/3393/type/StringLiteral"]],"basename":"bakin-proxy.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-proxy.js","path":"/addons/bakinParser/bakin-proxy.js","indexIsBuilt":false,"indexIds":{"Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the Bakin game executable.":3,"<h2>Proxy workflow</h2>":4,"Translator++ unpacks data.rbpack into a temporary folder.":5,"Split Dictionary uses dump-split and creates one .txt file per source area by default.":6,"Merge Dictionary uses a single dic.txt.":7,"Injection merges split dictionaries back into data/dic.txt and patches the player executable.":8,"Split Dictionary (default)":9,"Merge Dictionary":10},"tags":[],"relPath":"/addons/bakinParser/bakin-proxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/bakinParser/bakin-xlsx.js":{"data":[["Start a translation project from RPG Developer Bakin localization sheet (xlsx).","Iniciar um projeto de tradução a partir da planilha de localização do RPG Developer Bakin (xlsx)."],["Create project","Criar projeto"],["Error: customField is not defined. This should not happen!","Erro: customField não está definido. Isso não deveria acontecer!"],["Please select the entry point to translate.","Por favor, selecione o ponto de entrada para traduzir."],["<h2>RPG Developer Bakin editor is required</h2>","<h2>Editor do RPG Developer Bakin é necessário</h2>"],["RPG Developer Bakin editor is required to start the translation project.","O editor do RPG Developer Bakin é necessário para iniciar o projeto de tradução."],["<h2>Before you start</h2>","<h2>Antes de começar</h2>"],["<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.","<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Descompacte seu jogo</a> em um projeto editável do RPG Developer Bakin."],["Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.","Exporte as strings de localização usando o aplicativo RPG Developer Bakin para um arquivo xlsx. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">Veja o guia aqui sobre como traduzir jogos Bakin</a>."]],"context":[["tid/614/type/StringLiteral"],["tid/683/type/StringLiteral"],["tid/720/type/StringLiteral"],["tid/756/type/StringLiteral"],["tid/1034/type/NoSubstitutionTemplate"],["tid/1041/type/NoSubstitutionTemplate"],["tid/1064/type/NoSubstitutionTemplate"],["tid/1077/type/NoSubstitutionTemplate"],["tid/1088/type/NoSubstitutionTemplate"]],"basename":"bakin-xlsx.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-xlsx.js","path":"/addons/bakinParser/bakin-xlsx.js","indexIsBuilt":false,"indexIds":{"Start a translation project from RPG Developer Bakin localization sheet (xlsx).":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the entry point to translate.":3,"<h2>RPG Developer Bakin editor is required</h2>":4,"RPG Developer Bakin editor is required to start the translation project.":5,"<h2>Before you start</h2>":6,"<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.":7,"Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.":8},"tags":[],"relPath":"/addons/bakinParser/bakin-xlsx.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/basicUtils.js":{"data":[["NWJS Version","Versão NWJS"],["Change into this NWJS version","Mudar para esta versão NWJS"],["Use Developer version","Usar versão Desenvolvedor"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","Use a versão Desenvolvedor do NWJS. A versão Desenvolvedor tem ferramentas de desenvolvedor disponíveis. Adequada para depuração e desenvolvimento."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Na versão Desenvolvedor, você pode usar o <b>Console do Desenvolvedor</b>. O Console do Desenvolvedor pode ser acessado pressionando F12 ou clicando com o botão direito no aplicativo e selecionando 'Inspecionar'."],["Use 32-bit version","Usar versão 32-bit"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","Use a versão 32-bit do NWJS. A versão 32-bit é útil para compatibilidade com sistemas antigos. Recomenda-se desmarcar esta opção se possível (apenas atualize sua máquina, cara)."],["Some Translator++ feature may not work across NWJS version","Algumas funcionalidades do Translator++ podem não funcionar entre versões do NWJS"],["Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.","Por favor, esteja ciente de que alguns recursos do Translator++ podem não funcionar entre versões do NWJS. Certifique-se de testar seu projeto após alterar a versão do NWJS."],["You're currently running on NWJS ver.","Você está executando atualmente na versão do NWJS"],["Change Translator++ Core NWJS version","Alterar versão do NWJS do núcleo do Translator++"],["You're already using the selected NWJS version.","Você já está usando a versão do NWJS selecionada."],["This operation will close Translator++ and change the current NW.js version into","Esta operação fechará o Translator++ e alterará a versão atual do NW.js para"],["If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?","Se você tiver alterações não salvas, selecione 'Cancelar' e salve seu projeto primeiro.\nDeseja continuar?"]],"context":[["tid/1342/type/StringLiteral"],["tid/1352/type/StringLiteral"],["tid/1428/type/StringLiteral","tid/1617/type/StringLiteral"],["tid/1438/type/StringLiteral"],["tid/1449/type/StringLiteral"],["tid/1482/type/StringLiteral","tid/1641/type/StringLiteral"],["tid/1492/type/StringLiteral"],["tid/1532/type/NoSubstitutionTemplate"],["tid/1537/type/NoSubstitutionTemplate"],["tid/1542/type/StringLiteral"],["tid/1669/type/NoSubstitutionTemplate"],["tid/1745/type/NoSubstitutionTemplate"],["tid/1769/type/NoSubstitutionTemplate"],["tid/1782/type/NoSubstitutionTemplate"]],"basename":"basicUtils.js","dirname":"/addons/basicUtils","extension":".js","filename":"basicUtils.js","path":"/addons/basicUtils/basicUtils.js","indexIsBuilt":false,"indexIds":{"NWJS Version":0,"Change into this NWJS version":1,"Use Developer version":2,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":3,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":4,"Use 32-bit version":5,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":6,"Some Translator++ feature may not work across NWJS version":7,"Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.":8,"You're currently running on NWJS ver.":9,"Change Translator++ Core NWJS version":10,"You're already using the selected NWJS version.":11,"This operation will close Translator++ and change the current NW.js version into":12,"If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?":13},"tags":[],"relPath":"/addons/basicUtils/basicUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/basicUtils/mainMenu.js":{"data":[["Change Language","Alterar Idioma"],["No MTL available for this language pair","Nenhuma MTL disponível para este par de idiomas"],["Change default MTL for this project","Alterar MTL padrão para este projeto"],["???","???"],["Search in a folder","Pesquisar em uma pasta"],["Search in Staging Files","Pesquisar em Arquivos de Estágio"],["Search in Original Files","Pesquisar em Arquivos Originais"],["No original files path is set for this project.","Nenhum caminho de arquivos originais está definido para este projeto."],["Search in Translated Files","Pesquisar em Arquivos Traduzidos"],["No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.","Nenhum caminho de arquivos traduzidos está definido para este projeto.\nVocê precisa injetar sua tradução uma vez para definir o caminho dos arquivos traduzidos."],["Chat with AI Assistant","Conversar com o Assistente de IA"],["AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.","O Assistente de IA não está disponível, pois os novos recursos não foram carregados.\nPor favor, reinstale ou atualize novamente o Translator++."]],"context":[["tid/442/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/974/type/StringLiteral"],["tid/1182/type/StringLiteral"],["tid/1339/type/StringLiteral"],["tid/1404/type/StringLiteral"],["tid/1501/type/StringLiteral"],["tid/1539/type/StringLiteral"],["tid/1624/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1777/type/StringLiteral"],["tid/1812/type/StringLiteral"]],"basename":"mainMenu.js","dirname":"/addons/basicUtils","extension":".js","filename":"mainMenu.js","path":"/addons/basicUtils/mainMenu.js","indexIsBuilt":false,"indexIds":{"Change Language":0,"No MTL available for this language pair":1,"Change default MTL for this project":2,"???":3,"Search in a folder":4,"Search in Staging Files":5,"Search in Original Files":6,"No original files path is set for this project.":7,"Search in Translated Files":8,"No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.":9,"Chat with AI Assistant":10,"AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.":11},"tags":[],"relPath":"/addons/basicUtils/mainMenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":12,"length":12,"percent":100},"parameters":[]},"/addons/basicUtils/utils/HTMLPacker.js":{"data":[["Path is not a file:","O caminho não é um arquivo:"],["Icon path is not a file:","O caminho do ícone não é um arquivo:"],["Path is not an exe file:","O caminho não é um arquivo exe:"],["Icon path is not an ico file:","O caminho do ícone não é um arquivo ico:"],["Html entry point","Ponto de entrada HTML"],["Select the html entry point file (usually index.html)","Selecione o arquivo de ponto de entrada HTML (geralmente index.html)"],["Destination folder","Pasta de destino"],["Select destination folder. The process will replace the existing files.","Selecione a pasta de destino. O processo substituirá os arquivos existentes."],["NWJS version","Versão do NWJS"],["Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.","Opcional. Selecione a versão e arquitetura do NWJS.<br />A versão mais recente nem sempre é melhor, use o que funciona para você."],["Application ID","ID do aplicativo"],["Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.","Defina o ID do aplicativo para o jogo. O ID deve estar em minúsculas e pode conter apenas letras, números e sublinhados."],["Application description","Descrição do aplicativo"],["Set the application description for the game.","Defina a descrição do aplicativo para o jogo."],["Window title","Título da janela"],["Set the default window title for the game.<br />This value may be overridden by the game engine.","Defina o título padrão da janela para o jogo.<br />Este valor pode ser substituído pelo motor do jogo."],["Window width","Largura da janela"],["Set the default window width for the game.","Defina a largura padrão da janela para o jogo."],["Window height","Altura da janela"],["Set the default window height for the game.","Defina a altura padrão da janela para o jogo."],["Full screen","Tela cheia"],["Set the game to start in full screen mode.","Defina o jogo para iniciar em modo de tela cheia."],["Resizable","Redimensionável"],["Set the game window to be resizable.","Defina a janela do jogo como redimensionável."],["Game icon","Ícone do jogo"],["Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.","Selecione o arquivo de ícone para o executável do jogo. O arquivo de ícone deve estar no formato .ico. O ícone será incorporado no executável do jogo."],["Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.","Através deste formulário, você pode criar um pacote jogável do seu jogo. <br />O processo substituirá os arquivos existentes na pasta de destino."],["Start the application in full screen mode","Iniciar o aplicativo em modo de tela cheia"],["Allow the application to be resizable","Permitir que o aplicativo seja redimensionável"],["HTML Compiler","Compilador HTML"],["Compile","Compilar"],["Source path can not empty","O caminho de origem não pode estar vazio"],["Destination path can not empty","O caminho de destino não pode estar vazio"]],"context":[["tid/86/type/StringLiteral","tid/4136/type/StringLiteral"],["tid/116/type/StringLiteral"],["tid/151/type/StringLiteral"],["tid/186/type/StringLiteral"],["tid/2424/type/StringLiteral"],["tid/2434/type/StringLiteral"],["tid/2474/type/StringLiteral"],["tid/2484/type/StringLiteral"],["tid/2524/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2587/type/StringLiteral"],["tid/2597/type/StringLiteral"],["tid/2631/type/StringLiteral","tid/3795/type/StringLiteral"],["tid/2641/type/StringLiteral","tid/3805/type/StringLiteral"],["tid/2675/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2722/type/StringLiteral"],["tid/2732/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2810/type/StringLiteral"],["tid/2820/type/StringLiteral"],["tid/2854/type/StringLiteral"],["tid/2864/type/StringLiteral"],["tid/2899/type/StringLiteral"],["tid/2909/type/StringLiteral"],["tid/2950/type/NoSubstitutionTemplate"],["tid/3900/type/StringLiteral"],["tid/3924/type/StringLiteral"],["tid/4020/type/StringLiteral"],["tid/4037/type/StringLiteral"],["tid/4083/type/StringLiteral"],["tid/4104/type/StringLiteral"]],"basename":"HTMLPacker.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"HTMLPacker.js","path":"/addons/basicUtils/utils/HTMLPacker.js","indexIsBuilt":false,"indexIds":{"Path is not a file:":0,"Icon path is not a file:":1,"Path is not an exe file:":2,"Icon path is not an ico file:":3,"Html entry point":4,"Select the html entry point file (usually index.html)":5,"Destination folder":6,"Select destination folder. The process will replace the existing files.":7,"NWJS version":8,"Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.":9,"Application ID":10,"Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.":11,"Application description":12,"Set the application description for the game.":13,"Window title":14,"Set the default window title for the game.<br />This value may be overridden by the game engine.":15,"Window width":16,"Set the default window width for the game.":17,"Window height":18,"Set the default window height for the game.":19,"Full screen":20,"Set the game to start in full screen mode.":21,"Resizable":22,"Set the game window to be resizable.":23,"Game icon":24,"Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.":25,"Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.":26,"Start the application in full screen mode":27,"Allow the application to be resizable":28,"HTML Compiler":29,"Compile":30,"Source path can not empty":31,"Destination path can not empty":32},"tags":[],"relPath":"/addons/basicUtils/utils/HTMLPacker.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/basicUtils/utils/Updater.js":{"data":[["An update is being installed. Please do not close the application until the installation is completed.","Uma atualização está sendo instalada. Por favor, não feche o aplicativo até que a instalação seja concluída."],["Package Path","Caminho do Pacote"],["Select the package file.","Selecione o arquivo do pacote."],["Package Key","Chave do Pacote"],["If you have the key, please enter it here. If not, leave it empty.","Se você tiver a chave, insira-a aqui. Caso contrário, deixe em branco."],["Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.","Através deste formulário, você pode atualizar o Translator++ com o arquivo de pacote de atualização. Você pode baixar o pacote de atualização <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>aqui</a>."],["Update from package","Atualizar a partir do pacote"],["Update","Atualizar"],["Update Translator++","Atualizar Translator++"]],"context":[["tid/4918/type/StringLiteral"],["tid/6562/type/StringLiteral"],["tid/6572/type/StringLiteral"],["tid/6612/type/StringLiteral"],["tid/6622/type/StringLiteral"],["tid/6661/type/NoSubstitutionTemplate"],["tid/6753/type/StringLiteral","tid/7195/type/StringLiteral"],["tid/6770/type/StringLiteral","tid/7091/type/StringLiteral"],["tid/7120/type/StringLiteral"]],"basename":"Updater.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"Updater.js","path":"/addons/basicUtils/utils/Updater.js","indexIsBuilt":false,"indexIds":{"An update is being installed. Please do not close the application until the installation is completed.":0,"Package Path":1,"Select the package file.":2,"Package Key":3,"If you have the key, please enter it here. If not, leave it empty.":4,"Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.":5,"Update from package":6,"Update":7,"Update Translator++":8},"tags":[],"relPath":"/addons/basicUtils/utils/Updater.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/utils/info.js":{"data":[["You have ","Você tem "],[" missed update(s)!"," atualização(s) perdida(s)!"],["Translator++ will update itself if auto-update is enabled.","O Translator++ se atualizará automaticamente se a atualização automática estiver habilitada."],["You can download the latest core version of Translator++ at","Você pode baixar a versão mais recente do núcleo do Translator++ em"],["This update is available for all patrons.","Esta atualização está disponível para todos os patrocinadores."],["This update is available for tier $","Esta atualização está disponível para patrocinadores de nível $"],[" patrons or greater."," ou superior."],["You're up-to-date!","Você está atualizado!"],["Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!","Obrigado por se manter atualizado com o Translator++! Você está na versão mais recente e agradecemos seu apoio. Aproveite a tradução!"],["Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.","Algumas informações de atualização podem ser exibidas do cache. Você pode clicar em <b>'Verificar atualizações'</b> para carregar os detalhes da versão mais recente."],["When the same version is available","Quando a mesma versão está disponível"],["Allow Translator++ to reinstall the same version of Translator++.","Permitir que o Translator++ reinstale a mesma versão do Translator++."],["Allow reinstall the same version","Permitir reinstalar a mesma versão"],["Update Settings","Configurações de Atualização"],["Update Now","Atualizar Agora"],["Updater is not available, please update Translator++ manually.","O atualizador não está disponível, por favor atualize o Translator++ manualmente."],["Updating Translator++","Atualizando o Translator++"],["Please don't close Translator++ until the update process is finished.","Por favor, não feche o Translator++ até que o processo de atualização seja concluído."],["Can not update, reason :\n","Não foi possível atualizar, motivo:\n"],["You may need to reconnect Translator++ with your Patreon account (logout and login again).","Você pode precisar reconectar o Translator++ com sua conta do Patreon (faça logout e login novamente)."],["Also, it has been reported that some countries such as mainland China are blocking dropbox repository.","Além disso, foi relatado que alguns países, como a China continental, estão bloqueando o repositório do Dropbox."],["If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:","Se por algum motivo você não conseguir acessar nosso repositório, faça o download manual do pacote de atualização (arquivo tpch) usando um proxy ou VPN aqui:"],["After that, please use the \"Update from package\" feature to update your Translator++.","Depois disso, use o recurso \"Atualizar a partir do pacote\" para atualizar seu Translator++."],["If you still have problems, please contact us at our Discord server : ","Se ainda tiver problemas, entre em contato conosco em nosso servidor do Discord:"],["Restart","Reiniciar"],["Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.","Deseja reiniciar o Translator++ agora?\nSe tiver trabalho não salvo, cancele esta caixa de diálogo e salve seu trabalho primeiro."],["Check for Update","Verificar Atualizações"],["Close","Fechar"]],"context":[["tid/649/type/StringLiteral"],["tid/660/type/StringLiteral"],["tid/665/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/1033/type/StringLiteral"],["tid/1077/type/StringLiteral"],["tid/1088/type/StringLiteral"],["tid/1665/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1675/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1765/type/StringLiteral"],["tid/1811/type/StringLiteral"],["tid/1873/type/StringLiteral"],["tid/2021/type/StringLiteral"],["tid/2066/type/StringLiteral"],["tid/2116/type/StringLiteral"],["tid/2130/type/StringLiteral"],["tid/2176/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2220/type/StringLiteral"],["tid/2245/type/NoSubstitutionTemplate"],["tid/2259/type/StringLiteral"],["tid/2357/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2449/type/StringLiteral"],["tid/2512/type/StringLiteral"]],"basename":"info.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"info.js","path":"/addons/basicUtils/utils/info.js","indexIsBuilt":false,"indexIds":{"You have ":0," missed update(s)!":1,"Translator++ will update itself if auto-update is enabled.":2,"You can download the latest core version of Translator++ at":3,"This update is available for all patrons.":4,"This update is available for tier $":5," patrons or greater.":6,"You're up-to-date!":7,"Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!":8,"Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.":9,"When the same version is available":10,"Allow Translator++ to reinstall the same version of Translator++.":11,"Allow reinstall the same version":12,"Update Settings":13,"Update Now":14,"Updater is not available, please update Translator++ manually.":15,"Updating Translator++":16,"Please don't close Translator++ until the update process is finished.":17,"Can not update, reason :\n":18,"You may need to reconnect Translator++ with your Patreon account (logout and login again).":19,"Also, it has been reported that some countries such as mainland China are blocking dropbox repository.":20,"If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:":21,"After that, please use the \"Update from package\" feature to update your Translator++.":22,"If you still have problems, please contact us at our Discord server : ":23,"Restart":24,"Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.":25,"Check for Update":26,"Close":27},"tags":[],"relPath":"/addons/basicUtils/utils/info.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":28,"length":28,"percent":100},"parameters":[]},"/addons/basicUtils/utils/uiTags.js":{"data":[["Do not process row with selected tag (blacklist)","Não processar linha com a tag selecionada (lista negra)"],["Only process row with selected tag (whitelist)","Processar apenas linha com a tag selecionada (lista branca)"],["Ignore tag","Ignorar tag"],["Load last selection","Carregar última seleção"],["Reset","Redefinir"],["Cancel","Cancelar"],["Confirm","Confirmar"]],"context":[["tid/55/type/StringLiteral"],["tid/60/type/StringLiteral"],["tid/65/type/StringLiteral"],["tid/410/type/StringLiteral"],["tid/415/type/StringLiteral"],["tid/2085/type/StringLiteral"],["tid/2137/type/StringLiteral"]],"basename":"uiTags.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"uiTags.js","path":"/addons/basicUtils/utils/uiTags.js","indexIsBuilt":false,"indexIds":{"Do not process row with selected tag (blacklist)":0,"Only process row with selected tag (whitelist)":1,"Ignore tag":2,"Load last selection":3,"Reset":4,"Cancel":5,"Confirm":6},"tags":[],"relPath":"/addons/basicUtils/utils/uiTags.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/customParser/CustomParserLoader.js":{"data":[["List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.","Lista das possíveis codificações de caracteres. <b>A ordem importa!</b>. Separe cada valor com uma vírgula.<br />O Translator++ lerá o arquivo original com as seguintes codificações, aplicará as correções e escreverá com a opção <b>Codificação de caracteres de escrita</b>. Deixe em branco para usar a codificação de caracteres original quando o projeto for criado."],["For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>","Para suporte a BOM, adicione um espaço após a codificação. Exemplo: <code>utf8 bom</code>"],["Example: utf8,utf8 bom,utf16le,ascii","Exemplo: utf8,utf8 bom,utf16le,ascii"],["Select the target character encoding.","Selecione a codificação de caracteres de destino."]],"context":[["tid/3375/type/NoSubstitutionTemplate"],["tid/3383/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/4740/type/StringLiteral"]],"basename":"CustomParserLoader.js","dirname":"/addons/customParser","extension":".js","filename":"CustomParserLoader.js","path":"/addons/customParser/CustomParserLoader.js","indexIsBuilt":false,"indexIds":{"List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.":0,"For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>":1,"Example: utf8,utf8 bom,utf16le,ascii":2,"Select the target character encoding.":3},"tags":[],"relPath":"/addons/customParser/CustomParserLoader.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.html":{"data":[["<i class=\"icon-edit\"></i>","<i class=\"icon-edit\"></i>"],["<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>","<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Adicionar um novo grupo de arquivos</label>"],["Add a new file group","Adicionar um novo grupo de arquivos"],["<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>","<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remover grupo de arquivos atual</label>"],["Remove current file group","Remover grupo de arquivos atual"],["Rules","Regras"],["Hooks","Ganchos"],["Options","Opções"],["Testing","Teste"],["Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>","Interpolar as strings antes de serem exibidas nas células. <b>Para a Grade</b> é o antítese de <b>Da Grade</b>"],["Example","Exemplo"],["For example, the text obtained from the parser is as follows:","Por exemplo, o texto obtido do analisador é o seguinte:"],["In this grid it will look like this:","Nesta grade, ele ficará assim:"],["That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n","Esse não é o texto mais fácil de trabalhar.<br>\n  Podemos corrigir isso declarando <span class=\"inlineCode\">Ganchos Para a Grade</span> da seguinte forma:\n"],["With the hook above the text in the grid will be :","Com o gancho acima, o texto na grade será:"],["Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.","Interpolar as strings das células no resultado da tradução. <b>Da Grade</b> é o antítese de <b>Para a Grade</b>."],["\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n","\n  Por exemplo, as strings traduzidas esperadas devem estar no formato JSON.<br>\n  Mas escrever a tradução em formato JSON não é realmente a coisa mais fácil de fazer. <br>\n  Então, em vez de pedir ao nosso tradutor para traduzir em formato JSON, podemos apenas pedir que digitem normalmente e adicionar um <span class=\"inlineCode\">Gancho Da Grade</span> da seguinte forma:\n"],["\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n","\n  Com o <span class=\"inlineCode\">Gancho Da Grade</span> acima, a seguinte tradução ...\n"],["...will be converted into desired format: ","...será convertida no formato desejado: "],["Edit the translated text just before writing it into a file.","Editar o texto traduzido logo antes de escrevê-lo em um arquivo."],["Parameters","Parâmetros"],["\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ","\n              <h3 data-tran=\"\">texto</h3>\n              <p data-tran=\"\">O texto que está prestes a ser escrito em um arquivo.</p>\n            "],["text","texto"],["The text that is about to be written into a file.","O texto que está prestes a ser escrito em um arquivo."],["Return value","Valor de retorno"],["\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ","\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">O texto que será escrito em um arquivo.</p>\n            "],["The text that will be written into a file.","O texto que será escrito em um arquivo."],["General","Geral"],["Read character encoding","Codificação de caracteres de leitura"],["Force parser to use the following character encoding when reading the file(s).","Forçar o analisador a usar a seguinte codificação de caracteres ao ler o(s) arquivo(s)."],["Write character encoding","Codificação de caracteres de escrita"],["Force parser to use the following character encoding when writing the file(s).","Forçar o analisador a usar a seguinte codificação de caracteres ao escrever o(s) arquivo(s)."],["You are editing:","Você está editando:"],["Please select the mode of your pattern","Por favor, selecione o modo do seu padrão"],["Regular expression Pattern","Padrão de expressão regular"],["A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.","Uma expressão regular válida do ECMA Script junto com o modificador.<br>Você pode usar <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> para criar e testar seu padrão."],["Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ","Preste atenção ao uso de retorno de carro (\\r) no texto a ser traduzido. regex101.com removerá os retornos de carro, então seu padrão pode ter um efeito diferente do que você vê no regex101."],["<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.","<strong>Sobre quantificador que captura uma string de comprimento zero.</strong><br>\n            <i>Strings</i> nulas causarão problemas para o analisador. Portanto, em vez de usar o quantificador <strong>*</strong> que também captura <i>nulos</i>, é altamente recomendado usar o quantificador <strong>+</strong> que só captura strings se existirem."],["Translatable Capture groups","Grupos de captura traduzíveis"],["Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.","Índice dos grupos da expressão regular (Inteiro) para os textos traduzíveis. Pode ser mais de um. Separe com vírgula."],["Row Info Capture group","Grupo de captura de informações da linha"],["\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ","\n            Índice do grupo da expressão regular (Inteiro) para a informação da linha (ex: nome do personagem). <b>Apenas um grupo</b> é permitido. <br>\n            O valor da informação da linha pode ser transferido para as regras filhas e será sobrescrito pelo valor da informação da linha da regra filha, se existir.\n          "],["Context template","Modelo de contexto"],["\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ","\n            O contexto é um identificador único para textos traduzíveis. <br>\n            Você pode usar literais de modelo do Javascript para adicionar informação ao contexto.<br>\n            <b>Variável disponível:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GRUPO[<i>n</i>]</span> - Captura de grupo.</li>\n              <!-- <li><span class=\"inlineCode\">ID_REGRAS</span> - O ID da regra.</li> -->\n            </ul>\n            <br>\n            <b>Exemplo:</b>\n            <pre>item/${GRUPO[2]}</pre>\n          "],["Action","Ação"],["Capture value","Capturar valor"],["Capture then mask value","Capturar e mascarar valor"],["Mask value","Mascarar valor"],["Send to inner rule","Enviar para regra interna"],["Edit inner rule <i class=\"icon-angle-double-right\"></i>","Editar regra interna <i class=\"icon-angle-double-right\"></i>"],["What action the pattern is going to do.","Qual ação o padrão vai realizar."],["Javascript function","Função Javascript"],["Guide","Guia"],["\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ","\n          <h2 data-tran=\"\">Argumentos</h2>\n          <p data-tran=\"\">O código que você escreve estará dentro de uma função com 2 argumentos que podem ser acessados em qualquer lugar no seu código:</p>\n          <ul>\n            <li>\n              <h3>texto</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">Uma string de todo o conteúdo do arquivo.</p>\n            </li>\n            <li>\n              <h3>esteModelo</h3>\n              <p><b>Objeto</b></p>\n              <p data-tran=\"\">O objeto de regra que está atualmente sendo usado pelo arquivo.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\">Palavra-chave <i>this</i></h2>\n          <p data-tran=\"\"><b>this</b> se referirá à instância da classe CustomParser.</p>\n\n        "],["Arguments","Argumentos"],["The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:","O código que você escreve estará dentro de uma função com 2 argumentos que podem ser acessados em qualquer lugar no seu código:"],["A string of the entire content of the file.","Uma string de todo o conteúdo do arquivo."],["The rule object that is currently used by the file.","O objeto de regra que está atualmente sendo usado pelo arquivo."],["<i>this</i> Keyword","Palavra-chave <i>this</i>"],["<b>this</b> will reffer to the instance of CustomParser class.","<b>this</b> se referirá à instância da classe CustomParser."],["\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ","\n          <h2 data-tran=\"\">Valor de Retorno Esperado</h2>\n          <p data-tran=\"\">Seu código deve <b>retornar</b> um dos seguintes valores:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Deslocamento do texto capturado, por exemplo:\n<pre>  {\n    início:100,\n    fim:120,\n    textoInfoLinha:\"Nome do Personagem\", // Nome do personagem. opcional\n    contexto: [\"algum\", \"contexto\", \"aqui\"] // Contexto. opcional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array do deslocamento do texto capturado, por exemplo:\n<pre>  [\n    {início:0, fim:5, textoInfoLinha:\"Nome do Personagem\", contexto: [\"algum\", \"contexto\", \"aqui\"]},\n    {início:12, fim:30, textoInfoLinha:\"Outro Personagem\", contexto: [\"outro\", \"contexto\"]},\n    {início:4581, fim:4593, textoInfoLinha:\"Terceiro Personagem\", contexto: [\"terceiro\", \"contexto\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        "],["Expected Return Value","Valor de Retorno Esperado"],["Your code must <b>return</b> one of the following value:","Seu código deve <b>retornar</b> um dos seguintes valores:"],["Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ","Deslocamento do texto capturado, por exemplo:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Nome do Personagem\", // Nome do personagem. opcional\n    context: [\"algum\", \"contexto\", \"aqui\"] // Contexto. opcional\n  }\n</pre>\n            "],["Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ","Array do deslocamento do texto capturado, por exemplo:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Nome do Personagem\", context: [\"algum\", \"contexto\", \"aqui\"]},\n    {start:12, end:30, rowInfoText:\"Outro Personagem\", context: [\"outro\", \"contexto\"]},\n    {start:4581, end:4593, rowInfoText:\"Terceiro Personagem\", context: [\"terceiro\", \"contexto\"]}\n  ]\n</pre>              \n            "],["\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ","\n          <h2 data-tran=\"\">Exemplo</h2>\n          <p data-tran=\"\">O código a seguir é um exemplo para analisar legenda srt.</p>\n<pre><code class=\"language-javascript\">\n/*\n  O Translator++ está usando regexp-match-indices\n  por isso todos os métodos RegExp.exec() retornarão o deslocamento de seus grupos\n  leia mais sobre Índices de Expressão Regular aqui: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        "],["The following code is an example to parse srt subtitle.","O código a seguir é um exemplo para analisar legenda srt."],["Welcome to the Custom Parser Model Creator","Bem-vindo ao Criador de Modelo de Parser Personalizado"],["Please start by creating a new File Group.","Por favor, comece criando um novo Grupo de Arquivos."],["Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ","Por favor, defina que tipo de arquivo você deseja analisar clicando no\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Adicionar um novo grupo de arquivos</button> botão.\n    "],["Press F1 to open the help dialog.","Pressione F1 para abrir a caixa de ajuda."],["New File","Novo Arquivo"],["Open file","Abrir arquivo"],["Save file","Salvar arquivo"],["Save As","Salvar Como"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ajuda"],["Edit current file pattern","Editar padrão de arquivo atual"],["Add a new file pattern","Adicionar um novo padrão de arquivo"],["Remove current file pattern","Remover padrão de arquivo atual"],["Rule's order does matter, especially when you use masking! Drag to reorder.","A ordem das regras é importante, especialmente ao usar máscara! Arraste para reordenar."]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText","idx/29/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/28/innerText","idx/69/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"],["idx/9/attr/title"]],"basename":"modelEditor.html","dirname":"/addons/customParser/modelEditor","extension":".html","filename":"modelEditor.html","path":"/addons/customParser/modelEditor/modelEditor.html","indexIsBuilt":false,"indexIds":{"<i class=\"icon-edit\"></i>":0,"<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>":1,"Add a new file group":2,"<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>":3,"Remove current file group":4,"Rules":5,"Hooks":6,"Options":7,"Testing":8,"Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>":9,"Example":10,"For example, the text obtained from the parser is as follows:":11,"In this grid it will look like this:":12,"That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n":13,"With the hook above the text in the grid will be :":14,"Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.":15,"\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n":16,"\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n":17,"...will be converted into desired format: ":18,"Edit the translated text just before writing it into a file.":19,"Parameters":20,"\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ":21,"text":22,"The text that is about to be written into a file.":23,"Return value":24,"\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ":25,"The text that will be written into a file.":26,"General":27,"Read character encoding":28,"Force parser to use the following character encoding when reading the file(s).":29,"Write character encoding":30,"Force parser to use the following character encoding when writing the file(s).":31,"You are editing:":32,"Please select the mode of your pattern":33,"Regular expression Pattern":34,"A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.":35,"Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ":36,"<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.":37,"Translatable Capture groups":38,"Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.":39,"Row Info Capture group":40,"\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ":41,"Context template":42,"\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ":43,"Action":44,"Capture value":45,"Capture then mask value":46,"Mask value":47,"Send to inner rule":48,"Edit inner rule <i class=\"icon-angle-double-right\"></i>":49,"What action the pattern is going to do.":50,"Javascript function":51,"Guide":52,"\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ":53,"Arguments":54,"The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:":55,"A string of the entire content of the file.":56,"The rule object that is currently used by the file.":57,"<i>this</i> Keyword":58,"<b>this</b> will reffer to the instance of CustomParser class.":59,"\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ":60,"Expected Return Value":61,"Your code must <b>return</b> one of the following value:":62,"Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ":63,"Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ":64,"\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ":65,"The following code is an example to parse srt subtitle.":66,"Welcome to the Custom Parser Model Creator":67,"Please start by creating a new File Group.":68,"Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ":69,"Press F1 to open the help dialog.":70,"New File":71,"Open file":72,"Save file":73,"Save As":74,"Open debugger (F12)":75,"Help":76,"Edit current file pattern":77,"Add a new file pattern":78,"Remove current file pattern":79,"Rule's order does matter, especially when you use masking! Drag to reorder.":80},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":81,"length":81,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.js":{"data":[["Do you want to close Model editor?\rAll unsaved changes will be discarded.","Deseja fechar o editor de Modelos?\rTodas as alterações não salvas serão descartadas."],["Translate here using ","Traduza aqui usando "],["Do you want to discard your changes and open\n","Deseja descartar suas alterações e abrir\n"],["Error when trying to open file :","Erro ao tentar abrir o arquivo:"],["Parser Model Creator","Criador de Modelo de Parser"],["Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json","Por favor, especifique que tipo de arquivo você deseja analisar.\nVocê pode usar padrões glob separados por ponto e vírgula. Por exemplo: *.txt;*.js;*.json"],["Failed to create new file group. Please check your pattern!","Falha ao criar novo grupo de arquivos. Verifique seu padrão!"],["Do you wish to remove current file group?\nYou can not undo this action!","Deseja remover o grupo de arquivos atual?\nEsta ação não pode ser desfeita!"],["Do you want to discard your changes and create a new blank model?","Deseja descartar suas alterações e criar um novo modelo em branco?"],["Do you want to discard your changes and open a file?","Deseja descartar suas alterações e abrir um arquivo?"],["Clear history","Limpar histórico"],["Open latest file","Abrir arquivo mais recente"],["Open from history","Abrir do histórico"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Este recurso está disponível apenas se você estiver usando a versão Developer do Translator++. Você pode mudar para a versão Developer usando Utilitários Básicos -> Alterar Core NWJS."]],"context":[["tid/156/type/StringLiteral"],["tid/5647/type/StringLiteral"],["tid/9760/type/StringLiteral"],["tid/10037/type/StringLiteral"],["tid/10099/type/StringLiteral"],["tid/10622/type/StringLiteral","tid/10941/type/StringLiteral"],["tid/10665/type/StringLiteral","tid/10987/type/StringLiteral"],["tid/11026/type/StringLiteral"],["tid/11104/type/StringLiteral"],["tid/11174/type/StringLiteral","tid/12080/type/StringLiteral"],["tid/11459/type/StringLiteral"],["tid/11525/type/StringLiteral"],["tid/11607/type/StringLiteral"],["tid/11750/type/StringLiteral"]],"basename":"modelEditor.js","dirname":"/addons/customParser/modelEditor","extension":".js","filename":"modelEditor.js","path":"/addons/customParser/modelEditor/modelEditor.js","indexIsBuilt":false,"indexIds":{"Do you want to close Model editor?\rAll unsaved changes will be discarded.":0,"Translate here using ":1,"Do you want to discard your changes and open\n":2,"Error when trying to open file :":3,"Parser Model Creator":4,"Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json":5,"Failed to create new file group. Please check your pattern!":6,"Do you wish to remove current file group?\nYou can not undo this action!":7,"Do you want to discard your changes and create a new blank model?":8,"Do you want to discard your changes and open a file?":9,"Clear history":10,"Open latest file":11,"Open from history":12,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":13},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string","String de idioma inválida"],["Required field Project ID is blank!","O campo obrigatório ID do Projeto está em branco!"],["Required field Service Account Key is blank!","O campo obrigatório Chave da Conta de Serviço está em branco!"],["Required field Server Location is blank!","O campo obrigatório Localização do Servidor está em branco!"],["Required field Location of the glossary file is blank!","O campo obrigatório Localização do arquivo do glossário está em branco!"],["Required field Glossary Languages is blank!","O campo obrigatório Idiomas do Glossário está em branco!"],["Invalid glossary language value","Valor de idioma do glossário inválido"],["Currently active glossary on this project: ","Glossário atualmente ativo neste projeto: "],["Error when retreiving glossary info: ","Erro ao recuperar informações do glossário: "],["Error when removing glossary : ","Erro ao remover glossário: "],["Glossary removed successfully.","Glossário removido com sucesso."],["Error when creating glossary : ","Erro ao criar glossário: "],["Glossary created successfully.","Glossário criado com sucesso."],["Configuration error:\r\n","Erro de configuração:\r\n"],["No error found!","Nenhum erro encontrado!"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js","Node JS é necessário para usar o Google Cloud Translate Advanced. Por favor, baixe e instale de https://node.js"]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?","Executável JCap não encontrado no local especificado. Deseja instalar o JCap?"],["JCap agent started successfully. Press ","Agente JCap iniciado com sucesso. Pressione "],["jcapKey","jcapKey"],["Please set the JCap executable path in the addon settings.","Por favor, defina o caminho do executável JCap nas configurações do addon."],["JCap executable already exists at the specified location.","Executável JCap já existe no local especificado."],["JCap executable downloaded successfully.","Executável JCap baixado com sucesso."],["Failed to download JCap package. Please check the console for details.","Falha ao baixar o pacote JCap. Por favor, verifique o console para detalhes."],["JCap executable unpacked successfully.","Executável JCap descompactado com sucesso."],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.","Agora você pode iniciar o agente JCap no Menu Principal - Ferramentas - Ferramentas OCR JCap - Iniciar Agente JCap."],["Start JCap OCR Agent","Iniciar Agente OCR JCap"],["Failed to unpack JCap package. Please check the console for details.","Falha ao descompactar o pacote JCap. Verifique o console para detalhes."],["JCap executable not found at the specified location.","Executável JCap não encontrado no local especificado."],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.","Tem certeza de que deseja desinstalar o JCap? Isso excluirá o executável JCap e sua configuração."],["JCap uninstalled successfully.","JCap desinstalado com sucesso."],["Failed to uninstall JCap. Please check the console for details.","Falha ao desinstalar o JCap. Verifique o console para detalhes."],["Help","Ajuda"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.","JCap OCR é uma ferramenta de OCR que permite capturar texto da tela e traduzi-lo usando JCap. Para usá-lo, inicie o JCap clicando no botão OCR no menu principal.\nEm seguida, pressione a tecla configurada (padrão: F9) para capturar o texto."]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data","Embelezar dados JSON"],["When checked the generated data will be beautified.","Quando marcado, os dados gerados serão embelezados."],["Start a new translation project from any JSON file.","Iniciar um novo projeto de tradução a partir de qualquer arquivo JSON."],["Translator++ will translate any translatable texts found in the JSON files.","O Translator++ traduzirá quaisquer textos traduzíveis encontrados nos arquivos JSON."],["Read the guide on how to start a new JSON translation project here","Leia o guia sobre como iniciar um novo projeto de tradução JSON aqui"],["Translator++ will scan through this folder for any JSON files.","O Translator++ examinará esta pasta em busca de quaisquer arquivos JSON."],["How do you want to get the data from the JSON object?","Como você deseja obter os dados do objeto JSON?"],["Parser mode","Modo de análise"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>","<h2>Modo Simples</h2><p>No modo simples, você pode traduzir todos os valores de string recursivamente dentro do objeto JSON.<br />No modo simples, o texto original é sempre o valor.</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>","<h2>Modo Avançado</h2><p>No modo avançado, você pode consultar o JSON e lidar com tabelas de tradução do tipo chave-valor, onde o texto original é a chave.</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>","<h2>Informação</h2><p>Você pode usar o seguinte campo de consulta para selecionar uma parte específica do objeto JSON. O resultado da consulta deve ser um objeto ou um array de textos.</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>","<h3>Para objetos</h3><p>A <b>chave será usada como o texto original</b> e <b>o valor como a tradução padrão</b>.</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />","O analisador registrará automaticamente se o valor for uma string, null ou undefined.<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>","<h3>Para arrays</h3><p>O analisador registrará todos os valores de string no array como textos traduzíveis.</p>"],["Start project","Iniciar projeto"],["`Invalid destination directory:\\n${","`Diretório de destino inválido:\\n${"],["}`","}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label","rótulo"],["is duplicated in the same scenario file","está duplicado no mesmo arquivo de cenário"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory","Selecionar diretório"],["Select a directory to repack","Selecionar um diretório para reempacotar"],["Target xp3","Alvo xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.","Selecione o nome do arquivo. Nomes especiais como <b>patch.xp3</b>, <b>patch2.xp3</b>... etc têm prioridade sobre data.xp3 ao carregar."],["Patch to allow folder structure","Patch para permitir estrutura de pastas"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.","Por padrão, o motor KAG não lê arquivos dentro de uma pasta dentro de arquivos xp3. Esta opção adicionará automaticamente a definição de estrutura de pastas ao Config.tjs. Não tem efeito se nenhum arquivo Config.tjs for encontrado."],["Repack into xp3","Reempacotar em xp3"],["Close","Fechar"],["Process","Processar"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.","<b>A ordem importa</b> se você descompactar vários arquivos de uma vez! Os arquivos serão descompactados na ordem. Se os arquivos existirem, serão sobrescritos."],["Unpack XP3 files","Descompactar arquivos XP3"],["Repack a folder to xp3","Reempacotar uma pasta para xp3"],["Unpack xp3 file","Descompactar arquivo xp3"],["Before you create a new project, please make sure that :","Antes de criar um novo projeto, certifique-se de que:"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Todos os arquivos .ks e .tjs estão em texto simples (não compilados, não embaralhados e não criptografados)"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.","Jogos KAG devem ser jogáveis mesmo sem serem reempacotados. Portanto, você deve verificar se o seu jogo está jogável ou não após ser extraído."],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Algumas ações modificarão seu jogo. <b>Portanto, certifique-se de criar um backup do seu jogo!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Selecione o arquivo executável do jogo. Este arquivo é o arquivo principal do jogo que será usado para extrair os dados do jogo."],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.","O Translator++ pode extrair arquivos XP3 com o addon AEC. <b>Mas o extrator não é uma solução infalível para todos os tipos de XP3</b>."],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.","Alguns arquivos de cenário estão criptografados. Marque esta opção se desejar que o Translator++ tente descriptografá-los."],["This may not work on some projects.","Isso pode não funcionar em alguns projetos."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Lista das possíveis codificações de caracteres. <b>A ordem importa!</b>. Você pode arrastar para ordenar a lista."],["Literal tags are the tags that will be escaped into Translator++ editor.","Tags literais são as tags que serão escapadas no editor do Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> são obrigatórios."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> Tags serão interpoladas pelo Translator++ em uma nova linha. Portanto, você não precisa escrever <b>[r]</b> explicitamente."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","O script Kirikiri (.ks) é altamente personalizável e permite que os desenvolvedores criem suas próprias tags."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","O Translator++ pode lidar com tags padrão, como nomes de personagens que começam com um sustenido (#)."],["However, Translator++ cannot handle custom tags created by developers.","No entanto, o Translator++ não pode lidar com tags personalizadas criadas por desenvolvedores."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Portanto, você pode precisar definir as tags e atributos que precisam ser traduzidos e aqueles que precisam ser marcados como nomes de atores."],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.","Você pode precisar <input type=\"button\" value=\"extrair seu jogo xp3\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> e analisar o script ks dentro dele antes de iniciar o projeto."],["Create Project","Criar Projeto"],["Pack a folder into xp3","Empacotar uma pasta em xp3"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.","Selecione a codificação de caracteres alvo.<br />A maioria dos jogos KAG japoneses é escrita com SHIFT-JIS, mas o KAG na verdade tem suporte para unicode UTF16LE. Muitos tradutores definem a codificação de caracteres como UTF16LE para que o jogo seja jogável em Windows não-japonês sem emulador de localidade. E, mais importante, pode exibir caracteres fora do SHIFT-JIS, como \"café\".<br />Por padrão, o Translator++ escreverá em sua codificação de caracteres original."],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference.","Existem várias maneiras de produzir um jogo localizado jogável para KAG. Por favor, selecione uma que se adapte à sua preferência."]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode","Selecionar modo"],["Select how do you want to start your project. By selecting files or folders.","Selecione como deseja iniciar seu projeto. Escolhendo arquivos ou pastas."],["Select Folder","Selecionar Pasta"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","Selecione a pasta para processamento. O Translator++ recuperará recursivamente os arquivos PO da pasta especificada."],["Select File","Selecionar Arquivo"],["Select the files you want to process.","Selecione os arquivos que deseja processar."],["Filters","Filtros"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Filtre o nome do arquivo com padrão glob. O padrão é <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Todos os arquivos .po na pasta selecionada e suas subpastas."],["All .mo files in the selected folder and its subfolders.","Todos os arquivos .mo na pasta selecionada e suas subpastas."],["PO Files","Arquivos PO"],["MO Files","Arquivos MO"],["You are about to export the translations as MO files.\n","Você está prestes a exportar as traduções como arquivos MO.\n"],["- MO files are binary files that cannot be edited manually.\n","- Os arquivos MO são arquivos binários que não podem ser editados manualmente.\n"],["- Only translated entries are stored in MO files.\n","- Apenas as entradas traduzidas são armazenadas em arquivos MO.\n"],["Are you sure you want to proceed?","Tem certeza de que deseja prosseguir?"],["PO / MO Files","Arquivos PO / MO"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.","Arquivos .po e .mo são formatos de arquivo baseados em texto e binário, respectivamente, usados juntos para localização de software, especialmente no WordPress, para traduzir temas e plugins. O arquivo PO (Portable Object) é um texto legível por humanos contendo traduções, enquanto o arquivo MO (Machine Object) é um arquivo binário compilado e legível por máquina usado pelo software para carregamento mais rápido."],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts","Iniciar tradução a partir de scripts de tradução PO (Portable Object) e MO (Machine Object)"],["Create Project","Criar Projeto"],["Select mode","Selecionar modo"],["Select how do you want to start your project. By selecting files or folders.","Selecione como deseja iniciar seu projeto. Escolhendo arquivos ou pastas."],["Select Folder","Selecionar Pasta"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","Selecione a pasta para processamento. O Translator++ recuperará recursivamente os arquivos PO da pasta especificada."],["Select File","Selecionar Arquivo"],["Select the files you want to process.","Selecione os arquivos que deseja processar."],["Filters","Filtros"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","Filtre o nome do arquivo com padrão glob. O padrão é <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","Todos os arquivos .po na pasta selecionada e suas subpastas."],["All .mo files in the selected folder and its subfolders.","Todos os arquivos .mo na pasta selecionada e suas subpastas."],["ProjectTitle","Título do Projeto"],["Your project title","Seu título de projeto"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor","Extrator de Jogo Livemaker"],["Half width character patch","Patch de caracteres de meia largura"],["Patch half-width character","Corrigir caracteres de meia largura"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings","O motor Livemaker tem limitações quanto ao suporte a idiomas. Requer configurar a localidade do sistema Windows não-unicode para japonês para executar aplicativos LiveMaker e LiveNovel. Além disso, o motor é codificado para usar apenas fontes do sistema Windows instaladas que suportam Windows Shift-JIS (MS CP932), o que significa que pode não suportar outras localidades ou codificações"],["Next","Próximo"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?","Não foi possível detectar o tipo de RPG Maker!\nTem certeza de que o jogo é RPG Maker XP, VX ou VX Ace?"],["Create a new project","Criar um novo projeto"],["Invalid destination file:","Arquivo de destino inválido:"],[" doesn't seems to be a LiveMaker game."," não parece ser um jogo LiveMaker."]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path.","O caminho de desenvolvimento não está definido.\nVocê deve injetar seu jogo uma vez para gerar o caminho de desenvolvimento."],["Decompile all rpyc files","Descompilar todos os arquivos rpyc"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.","Tentar descompilar todos os arquivos rpyc em .rpy.<br />O Translator++ tem seu próprio descompilador. Mas há relatos de que às vezes ele falha ao descompilar alguns jogos criados com Renpy 7. Você pode deixar este campo desmarcado e descompilar o jogo você mesmo com suas próprias ferramentas antes de iniciar um projeto."],["Overwrite rpy","Sobrescrever rpy"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.","Se marcado, o descompilador <b>sobrescreverá os arquivos rpy descompilados existentes</b>."],["Exclude command","Excluir comando"],["This option will allow us to skip some command for being processed and translated","Esta opção permitirá pular alguns comandos para serem processados e traduzidos"],["Separate entries with a space","Separe as entradas com um espaço"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored","Por exemplo, se você colocar <b>old</b>, todas as linhas em rpy que começarem com <b>old</b> serão ignoradas"],["Are you sure want to start a project without decompiling the rpyc files?","Tem certeza de que deseja iniciar um projeto sem descompilar os arquivos rpyc?"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?","O arquivo selecionado não é um arquivo executável de jogo Ren'Py.\nDeseja continuar mesmo assim?"],["Play last build","Reproduzir a última compilação"],["Open Ren'Py documentation","Abrir documentação do Ren'Py"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","A opção foi definida para usar o analisador legado.\nVocê pode voltar ao novo analisador a qualquer momento através do menu de opções."]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator","Tradutor de arquivos binários do Windows"],["Parsing Windows binary file with","Analisando arquivo binário do Windows com"],["Sellect supported files","Selecionar arquivos suportados"],["Select supported file type to translate.","Selecione o tipo de arquivo suportado para traduzir."],["Create a new project","Criar um novo projeto"],["Please select a supported file to parse","Por favor, selecione um arquivo suportado para análise"],["Please enter your project title!","Por favor, insira o título do seu projeto!"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player","Usar Reprodutor RPG Nativo"],["Use native RPG Player instead of Easy RPG Player","Usar Reprodutor RPG Nativo em vez do Reprodutor RPG Fácil"],["Use native RPG Player","Usar Reprodutor RPG Nativo"],["Target folder","Pasta de destino"],["Select destination folder.","Selecione a pasta de destino."],["Install Easy RPG Player","Instalar Reprodutor RPG Fácil"],["Close","Fechar"],["Install","Instalar"],["Process completed!","Processo concluído!"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin.","Analisador RPG Maker 2000 & 2003 com plugin xmlTrans."],["Play last build","Reproduzir última compilação"],["Apply translation then play","Aplicar tradução e reproduzir"],["Setup Easy RPG in the current directory","Configurar RPG Fácil no diretório atual"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine","Iniciar tradução do motor RM2k / RM2k3"],["Create project","Criar projeto"],["Please select RPG Maker 2000/2003 game!","Por favor, selecione um jogo RPG Maker 2000/2003!"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?","Não foi possível detectar o tipo de RPG Maker!\nTem certeza de que o jogo é RPG Maker 2000 / 2003?"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder","Pasta de destino"],["Select destination folder.","Selecionar pasta de destino."],["Install Easy RPG Player","Instalar Easy RPG Player"],["Close","Fechar"],["Install","Instalar"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/","Como adicionar uma fonte personalizada.\n\nAs fontes devem ser colocadas na pasta Font do diretório do jogo e devem ser nomeadas Font.ttf ou Font2.ttf. Qual arquivo de fonte é usado depende da configuração de fonte gráfica do sistema. Além de ttf, fon e muitas outras fontes são suportadas (qualquer coisa suportada pelo FreeType, a melhor biblioteca de código aberto disponível para renderização de fontes).\n\nFonte: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!","Processo concluído!"],["Play last build","Jogar última compilação"],["Apply translation then play","Aplicar tradução e jogar"],["Setup Easy RPG in the current directory","Configurar Easy RPG no diretório atual"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data","Embelezar dados JSON"],["When checked the generated data will be beautified.","Quando marcado, os dados gerados serão embelezados."],["Error loading system.json","Erro ao carregar system.json"],["Loading","Carregando"],["index.html not found in","index.html não encontrado em"],["Encrypted game","Jogo criptografado"],["Select the index.html of your encrypted game.","Selecionar o index.html do seu jogo criptografado."],["Target folder","Pasta de destino"],["Select destination folder. The process will replace the existing files.","Selecionar pasta de destino. O processo substituirá os arquivos existentes."],["Decrypt Resources","Descriptografar recursos"],["Close","Fechar"],["Process","Processar"],["Source path can not empty","O caminho de origem não pode estar vazio"],["Destination path can not empty","O caminho de destino não pode estar vazio"],["Path is not a file:","O caminho não é um arquivo:"],["Invalid directory:","Diretório inválido:"],["Extract enigma","Extrair enigma"],["Select enigma file.","Selecione o arquivo enigma."],["Extract Enigma","Extrair Enigma"],["Selected file is not an Enigma Virtual Box package.","O arquivo selecionado não é um pacote Enigma Virtual Box."],["Plugins are already fetched for this project. Want to re-fetch the plugins?","Os plugins já foram obtidos para este projeto. Deseja obter os plugins novamente?"],["Translate Javascript File?","Traduzir arquivo Javascript?"],["Cancel","Cancelar"],["I know the risk, Proceed!","Eu sei o risco, Prossiga!"],["Game Executable Path","Caminho do Executável do Jogo"],["Path to the game executable file (.exe)","Caminho para o arquivo executável do jogo (.exe)"],["NWJS Version","Versão NWJS"],["Change into this NWJS version","Mudar para esta versão NWJS"],["Use Developer version","Usar versão de Desenvolvedor"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","Use a versão de Desenvolvedor do NWJS. A versão de Desenvolvedor tem ferramentas de desenvolvedor disponíveis. Adequada para depuração e desenvolvimento."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","Na versão de Desenvolvedor, você pode usar o <b>Console do Desenvolvedor</b>. O Console do Desenvolvedor pode ser acessado pressionando F12 ou clicando com o botão direito no aplicativo e selecionando 'Inspecionar'."],["Use 32-bit version","Usar versão de 32 bits"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","Use a versão de 32 bits do NWJS. A versão de 32 bits é útil para compatibilidade com sistemas mais antigos. É recomendado desmarcar esta opção se possível (apenas atualize sua máquina, cara)."],["Some game feature may not work across NWJS version","Algum recurso do jogo pode não funcionar em versões diferentes do NWJS"],["Please be aware that some game feature may not work across NWJS version.","Por favor, esteja ciente de que alguns recursos do jogo podem não funcionar em versões diferentes do NWJS."],["Change RPG Maker MV / RPG Maker MZ / NWJS version","Alterar versão do RPG Maker MV / RPG Maker MZ / NWJS"],["This operation will change the NW.js version into","Esta operação mudará a versão do NW.js para"],["Please close the application first before continuing.\nDo you want to continue?","Por favor, feche o aplicativo primeiro antes de continuar.\nVocê deseja continuar?"],["The selected file is not a valid NW.js application.","O arquivo selecionado não é um aplicativo NW.js válido."],["Could not find index.html in the game directory.","Não foi possível encontrar index.html no diretório do jogo."],["Debug menu script not found in addon directory.","Script do menu de depuração não encontrado no diretório de addon."],["Debug menu script is already installed in index.html.","O script do menu de depuração já está instalado no index.html."],["Debug options installed successfully!","Opções de depuração instaladas com sucesso!"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n","O jogo selecionado não está sendo executado no Modo Desenvolvedor do NW.js (SDK).\n\n"],["Developer Mode provides additional debugging features:\n","O Modo Desenvolvedor fornece recursos de depuração adicionais:\n"],["• Developer Console (F12)\n","• Console do Desenvolvedor (F12)\n"],["• Inspect Element (Right-click)\n","• Inspecionar Elemento (Clique direito)\n"],["• Network Monitor\n","• Monitor de Rede\n"],["• Performance Profiler\n\n","• Analisador de Desempenho\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n","Você deseja atualizar para o Modo Desenvolvedor do NW.js?\n"],["(Recommended for better debugging experience)","(Recomendado para uma melhor experiência de depuração)"],["The game will be upgraded to NW.js SDK version","O jogo será atualizado para a versão do SDK NW.js"],["This may take a few minutes. Please wait...","Isso pode levar alguns minutos. Por favor, aguarde..."],["NW.js has been upgraded to Developer Mode successfully!","NW.js foi atualizado para o Modo Desenvolvedor com sucesso!"],["Failed to upgrade to Developer Mode:\n","Falha ao atualizar para o Modo Desenvolvedor:\n"],["Error installing debug options: ","Erro ao instalar opções de depuração: "],["Install Debug Options","Instalar Opções de Depuração"],["This will install a debug menu into your RPG Maker MV/MZ game.","Isso instalará um menu de depuração no seu jogo RPG Maker MV/MZ."],["Select the game executable file to install debug options.","Selecione o arquivo executável do jogo para instalar opções de depuração."],["Compile HTML to Executable","Compilar HTML para Executável"],["Change Existing NWJS Version","Alterar Versão NWJS Existente"],["Install debug options","Instalar opções de depuração"],["Find next","Encontrar próximo"],["Open folder","Abrir pasta"],["Open with external application","Abrir com aplicativo externo"],["Raw JSON data. Right click to open menu.","Dados JSON brutos. Clique com o botão direito para abrir o menu."],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)","Um patch está disponível para estes dados de tradução. Este patch tornará seus dados de tradução compatíveis com a versão atual do Translator++.\nDeseja aplicar o patch aos seus dados de tradução?\n(Alguns recursos podem não funcionar corretamente se você não aplicar o patch)"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.","Não foi possível localizar o executável para instalar opções de depuração. Certifique-se de que seu jogo está empacotado para Windows com NW.js."],["Error while installing debug options: ","Erro ao instalar opções de depuração: "],["Play last build","Reproduzir última compilação"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","O caminho de desenvolvimento não está definido.\nVocê deve injetar seu jogo uma vez para gerar o caminho de desenvolvimento."],["Open editor","Abrir editor"],["Load Plugins Into Project","Carregar Plugins no Projeto"],["Compile Game","Compilar Jogo"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","A opção foi definida para usar o analisador legado.\nVocê pode voltar ao novo analisador a qualquer momento através do menu de opções."],["Unable to find the file related to the data","Não foi possível encontrar o arquivo relacionado aos dados"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Para corrigir isso, ajuste o campo <b>Localização da matéria-prima</b> nas <a href=\"#\" class=\"openProjectProperties\">Propriedades do projeto</a>"],["Maximum dialog line","Linha máxima de diálogo"],["Maximum line in the dialog box. Default is 4.","Número máximo de linhas na caixa de diálogo. O padrão é 4."],["Add debug options","Adicionar opções de depuração"],["Add debug options into the game to help testing.","Adicionar opções de depuração no jogo para auxiliar nos testes."],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>","Ative esta opção para adicionar ferramentas de depuração ao jogo. Esses recursos podem ajudá-lo a testar sua tradução.<br/><b>⚠️ Nota: Esta opção só está disponível se seu jogo for empacotado com NWJS para Windows.</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/type/StringLiteral","tid/21410/type/StringLiteral"],["tid/20865/type/StringLiteral","tid/21461/type/StringLiteral"],["tid/20925/type/StringLiteral"],["tid/20962/type/StringLiteral"],["tid/20992/type/StringLiteral"],["tid/21023/type/StringLiteral"],["tid/21215/type/StringLiteral"],["tid/21220/type/StringLiteral"],["tid/21309/type/StringLiteral"],["tid/21564/type/StringLiteral"],["tid/21678/type/StringLiteral"],["tid/22062/type/StringLiteral"],["tid/22163/type/StringLiteral"],["tid/22214/type/StringLiteral"],["tid/22424/type/StringLiteral","tid/24166/type/StringLiteral"],["tid/22434/type/StringLiteral","tid/24176/type/StringLiteral"],["tid/22468/type/StringLiteral"],["tid/22478/type/StringLiteral"],["tid/22512/type/StringLiteral","tid/22962/type/StringLiteral"],["tid/22522/type/StringLiteral"],["tid/22533/type/StringLiteral"],["tid/22560/type/StringLiteral","tid/22986/type/StringLiteral"],["tid/22570/type/StringLiteral"],["tid/22605/type/NoSubstitutionTemplate"],["tid/22610/type/NoSubstitutionTemplate"],["tid/23014/type/NoSubstitutionTemplate"],["tid/23119/type/NoSubstitutionTemplate"],["tid/23148/type/NoSubstitutionTemplate"],["tid/23298/type/StringLiteral"],["tid/23453/type/StringLiteral"],["tid/23555/type/StringLiteral"],["tid/23696/type/StringLiteral"],["tid/23770/type/StringLiteral"],["tid/23812/type/StringLiteral"],["tid/23820/type/StringLiteral"],["tid/23828/type/StringLiteral"],["tid/23836/type/StringLiteral"],["tid/23844/type/StringLiteral"],["tid/23852/type/StringLiteral"],["tid/23860/type/StringLiteral"],["tid/23868/type/StringLiteral"],["tid/23922/type/NoSubstitutionTemplate"],["tid/23931/type/NoSubstitutionTemplate"],["tid/23972/type/StringLiteral"],["tid/24005/type/StringLiteral"],["tid/24068/type/StringLiteral"],["tid/24217/type/NoSubstitutionTemplate","tid/24282/type/NoSubstitutionTemplate"],["tid/24222/type/NoSubstitutionTemplate"],["tid/24227/type/NoSubstitutionTemplate"],["tid/24482/type/StringLiteral"],["tid/24546/type/StringLiteral"],["tid/24598/type/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":82,"length":82,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS.","Este recurso só está disponível se você estiver usando a versão de Desenvolvedor do NWJS."]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js.","Este recurso só está disponível se você estiver usando a versão de desenvolvedor do NW.js."]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser","Usar analisador legado"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.","Use o analisador antigo anterior ao (Translator++ ver. 3.8.12). O analisador antigo não suporta alguns recursos adicionados recentemente."],["Use old parser","Usar analisador antigo"],["Event's thread concurrency","Concorrência de threads de evento"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.","<b>Aviso! Recurso experimental!</b><br />Esta opção determina o número máximo de threads de trabalho que podem analisar dados de evento simultaneamente no Mapa e CommonEvents. <b>Defina como 0 para desativar threads de trabalho</b>. <br />Esta opção tem o potencial de acelerar o processo de análise em jogos maiores. No entanto, é importante notar que em jogos menores, ativar esta opção pode realmente desacelerar o processo de análise devido à maior sobrecarga de execução em comparação com o tempo de análise para cada dado."],["The minimum number of command in an event that allowed in thread worker","O número mínimo de comandos em um evento permitido em thread de trabalho"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.","<b>Aviso! Recurso experimental!</b><br />Threads de trabalho incorrem em sobrecarga durante a execução, o que significa que processar eventos em branco ou eventos com um baixo número de comandos pode realmente prejudicar o processo geral. Esta opção permite que você especifique o número mínimo de comandos que um evento deve ter para ser analisado em uma thread de trabalho. <br />É importante notar que mesmo eventos em branco contêm um comando, e é mais eficiente processar tais eventos na thread principal em vez de em uma thread de trabalho. Portanto, é recomendado definir este número para um valor <b>maior que 1</b>.<br />Defina como 0 para desativar a divisão de tarefas com base em comandos."],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.","Observe que um evento em branco na verdade contém um comando, e você definitivamente deseja processar eventos em branco na thread principal em vez de em uma thread de trabalho. Você deve definir este número para um valor maior que 1."],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3","Analisador RPG Maker XP, VX, Ace, MV & MZ V.3"],["Start translation from RPG Maker game using the latest parser.","Iniciar tradução de um jogo RPG Maker usando o analisador mais recente."],["Error!\r\nTranslator++ is unable to detect the type of ","Erro!\r\nO Translator++ não consegue detectar o tipo de "],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.","Você deve alterar o caminho!\r\nO diretório Dev não deve estar dentro do diretório original do jogo, pois isso causará problemas se você injetar o jogo posteriormente."],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","O jogo está empacotado com Enigma.\r\nDeseja extrair o pacote?\r\nIsso levará minutos, dependendo do tamanho do seu jogo."],["Unable to extract the Enigma package!","Não foi possível extrair o pacote Enigma!"],["Copy & extract data into ","Copiar e extrair dados em "]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?","O Gateway CLI RPGMakertrans é necessário para executar esta ação.\nO Gateway CLI RPGMakertrans está licenciado sob GPL-3 e não pode ser distribuído junto com o programa.\nMas o Translator++ pode configurá-lo em seu nome.\n\nDeseja que o Translator++ instale o Gateway CLI RPGMakertrans para você?"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?","O Gateway CLI RPGMakertrans precisa ser atualizado.\nDeseja que o Translator++ atualize o Gateway CLI RPGMakertrans para você?"],["Maximum dialog line","Linha máxima de diálogo"],["Maximum line in the dialog box. Default is 4.","Número máximo de linhas na caixa de diálogo. O padrão é 4."]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine.","Iniciar um projeto de tradução a partir do motor SRPG Studio."],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..","O analisador pode lidar com traduções de <b>data.dts</b> (arquivo srpgs); o arquivo <b>localization.dat</b> e os arquivos de localização (.json, .txt, .js) gerados pela ferramenta de localização do SRPG Studio introduzida na versão 1.253."],["Create project","Criar projeto"],["Error: customField is not defined. This should not happen!","Erro: customField não está definido. Isso não deveria acontecer!"],["Please select the entry point to translate.","Por favor, selecione o ponto de entrada para traduzir."],["There are currently two known locations of translatable text within the SRPG Studio game. <br />","Atualmente, existem dois locais conhecidos de texto traduzível dentro do jogo SRPG Studio. <br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.","O primeiro está escrito diretamente dentro do arquivo .srpgs, e o segundo está no arquivo localization.dat. Este analisador atualmente pode lidar com ambos."],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.","<br />Além disso, você também pode traduzir os arquivos de localização gerados pela ferramenta de localização do SRPG Studio. Esses arquivos estão nos formatos JSON, TXT e JS."]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.","Analisar arquivos do SRPG Studio e despejo de tradução JSON gerado por SRPG_Unpacker.exe."],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.","Iniciar tradução a partir de data.dts do SRPG Studio, project.dat ou despejo de tradução JSON.<br />Este é o analisador mais recente—significativamente mais rápido e estável—que substituirá a versão anterior."],["Create Project","Criar Projeto"],["Source mode","Modo de origem"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.","Escolha o modo EXE para iniciar a partir do executável do jogo, modo de arquivo para data.dts / project.dat ou modo de despejo para despejo de tradução JSON."],["Select executable","Selecionar executável"],["Select the game executable. Translator++ will look for data.dts in the same folder.","Selecione o executável do jogo. O Translator++ procurará por data.dts na mesma pasta."],["Select archive file","Selecionar arquivo de arquivo"],["Select data.dts directly.","Selecione data.dts diretamente."],["Select dump folder","Selecionar pasta de despejo"],["Select the translation dump folder generated by SRPG_Unpacker.exe.","Selecione a pasta de despejo de tradução gerada por SRPG_Unpacker.exe."],["Filters","Filtros"],["Glob pattern used to select JSON files from the dump folder.","Padrão global usado para selecionar arquivos JSON da pasta de despejo."],["ProjectTitle","Título do Projeto"],["Your project title","Seu título de projeto"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>","Localização do Sugoi translator <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Aponte para o arquivo .bat ou .exe no diretório raiz do aplicativo.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> Caminho inválido.<br>Alguns recursos serão desativados até que isso seja corrigido."],["Server Type :","Tipo de Servidor :"],["Installed Model :","Modelo Instalado :"],["Install Sugoi Translator","Instalar Sugoi Translator"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ","Não tem o Sugoi Translator?\n            Instale o servidor do Sugoi Translator personalizado e otimizado agora!\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>","Número de servidores a iniciar (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Número de servidores iniciados simultaneamente\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%","Número de servidores a serem iniciados simultaneamente.<br>Mais processos nem sempre significam mais velocidade, esteja atento à capacidade da sua RAM e CPU.<br>Você pode não obter benefícios se, ao executar apenas um servidor, o uso da CPU atingir 100%"],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ","\n                    Seu Sugoi Translator não suporta processamento por GPU.<br>\n                    Você precisa aplicar um patch no seu servidor para suportar processamento por GPU.<br>\n                    <h3 data-tran=\"\">Selecione a seguinte opção para instalar o patch adequado para o seu sistema</h3>\n                    <div>\n                        <span data-tran=\"\">Sua GPU é:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Instalar patch para NVIDIA série 30xx ou superior</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Instalar patch para NVIDIA série 20xx ou inferior</button>\n    \n                    </div>\n                "],["Select the following option to install the suitable patch for your system","Selecione a seguinte opção para instalar o patch adequado para o seu sistema"],["Your GPU is:","Sua GPU é:"],["Install patch For NVIDIA series 30xx or greater","Instalar patch para NVIDIA série 30xx ou superior"],["Install patch For NVIDIA series 20xx or lower","Instalar patch para NVIDIA série 20xx ou inferior"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>","Número de servidores a iniciar (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Número de servidores iniciados simultaneamente usando GPU. Seu servidor deve ser patchado para habilitar o processamento por GPU.\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.","Quantos servidores você deseja iniciar na sua <b>GPU</b>. É possível executar serviços baseados em CPU e GPU simultaneamente. Mas lembre-se de que, se o uso da CPU estiver alto, isso pode prejudicar o desempenho da GPU.<br>Seu servidor deve ser patchado para habilitar este modo."],["Starting port number","Número da porta inicial"],["The port numbers will be generated incrementaly starting from the value below","Os números das portas serão gerados incrementalmente a partir do valor abaixo"],["Keep console window open","Manter janela do console aberta"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.","impedir que a janela do console feche quando o servidor fecha. Esta opção é útil para verificar erros que causaram a queda do servidor."],["Action","Ação"],["Set Sugoi Trans config based on this setting","Definir configuração do Sugoi Trans com base nesta configuração"],["Start All Server","Iniciar Todos os Servidores"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":22,"length":22,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder","Selecionar pasta de instalação"],["Where do you want to install the CT2 Sugoi Translator into?","Onde você deseja instalar o CT2 Sugoi Translator?"],["Cancel","Cancelar"],["Install now!","Instalar agora!"],["Path to the directory can not be empty!","O caminho para o diretório não pode estar vazio!"],["Invalid directory:","Diretório inválido:"],["Failed to download file. Repository do not exist. Please see the console log for more information.","Falha ao baixar o arquivo. O repositório não existe. Por favor, veja o log do console para mais informações."],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series","Tem certeza de que deseja atualizar seu servidor?\nEste script de atualização funcionará para a série NVIDIA 3XXX"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier","Tem certeza de que deseja atualizar seu servidor?\nEste script de atualização funcionará para a série NVIDIA 2XXX e anteriores"],["Install CT2 Sugoi Translator","Instalar CT2 Sugoi Translator"],["Installation completed\nDo you want to set the Server Manager with this installed server?","Instalação concluída\nDeseja configurar o Gerenciador de Servidores com este servidor instalado?"],["Sugoi Translator Installed","Sugoi Translator Instalado"],["Server started\nPlease wait until the server(s) are ready before you translate things.","Servidor iniciado\nPor favor, aguarde até que o(s) servidor(es) esteja(m) pronto(s) antes de traduzir coisas."],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?","Esta ação substituirá o valor atual das configurações do Sugoi Trans Addon.\nTem certeza?"],["Do you want to reset the current configuration?","Deseja redefinir a configuração atual?"],["Configuration refreshed!","Configuração atualizada!"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter","Delimitador de linha"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.","Preencha com os caracteres ou frases que serão escapados pelo tradutor (a frase original e a tradução serão sempre as mesmas). Isso garantirá que o número de linhas do texto traduzido seja o mesmo que o número de linhas do texto original. \nAtualmente, não há frases/caracteres que o Sugoi escapará com 100% de taxa de sucesso.\nVocê pode tentar usar &#x3C;br&#x3E; com uma taxa de sucesso decente.\nDeixe em branco se deseja concatenar as linhas em uma única linha."],["Target URL(s)","URL(s) de destino"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.","URL de destino do tradutor. Você pode inserir um ou mais URLs de back-end do Sugoi Translator. O Translator++ distribuirá as solicitações entre todas as instâncias dos serviços. Separe cada entrada com uma nova linha."],["Max Parallel job","Máximo de trabalhos paralelos"],["Maximum parallel job that run simultaneously.","Máximo de trabalhos paralelos executados simultaneamente."],["Send requests in batch","Enviar solicitações em lote"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.","Envie vários textos (por trabalho paralelo máximo) em array.\nMais rápido e pode reduzir significativamente a sobrecarga de execução. Você deve executar o servidor a partir do gerenciador de servidores para habilitar esta opção."],["Check First Line in Common Reference","Verificar Primeira Linha na Referência Comum"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.","Não inclua a primeira linha no payload se a primeira linha for encontrada na Referência Comum.\nIsso é muito útil se o nome do personagem estiver na primeira linha."],["Check Last Line in Common Reference","Verificar Última Linha na Referência Comum"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.","Não inclua a última linha no payload se a última linha for encontrada na Referência Comum.\nIsso é muito útil se o nome do personagem estiver na última linha."],["Automatic splitting","Divisão automática"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.","Divida automaticamente a tradução no número de linhas correspondente ao original. O comprimento de cada linha será de tamanho similar."],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)","Algoritmo de escape para código inline dentro de diálogos (ainda não implementado, por favor aguarde as atualizações futuras)"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que dirá qual é o papel do seu assistente chatGPT. Esta mensagem será enviada como a primeira mensagem de cada lote enviado ao chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis com o estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nome completo do idioma de origem</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nome completo do idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensagens no lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Adicionar informações dos atores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nome do objeto] : Gerar referência a partir do objeto do Translator++. <br />Exemplo: <code>REFERENCE[Referência Comum]</code></li>"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your chat.","Modelo do corpo do seu chat."],["Sample conversation","Conversa de exemplo"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","A API Batch do ChatGPT permite traduzir seu projeto de forma assíncrona com custos 50% menores, o que significa que você receberá os resultados da sua tradução <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:red\">metade do custo normal</b>. Isso é particularmente útil para projetos grandes que não exigem resultados de tradução imediatos."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Leia mais sobre a API Batch do ChatGPT: https://platform.openai.com/docs/guides/batch ."],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>","<p>Você pode ou não usar o glossário. O glossário será carregado para cada item do lote para melhorar a qualidade da tradução.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt Template","Modelo de Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensagem do Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aqui você pode explicar ao assistente qual é o papel dele.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Seu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este é o prompt real para o assistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Custo indireto</h3>\n                        Custo indireto é o custo da mensagem de prompt que você envia ao assistente sem os textos de tradução reais. O custo é calculado com base no número de tokens na mensagem de prompt. Quanto mais tokens você tiver, maior será o custo.<br>\n                        <b>Custo indireto atual:</b> <span class=\"overheadCost\">0</span> tokens / solicitação."]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":40,"length":40,"percent":100},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?","O servidor TinyRPA não está instalado. Você deseja instalá-lo agora?"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization","Memorização automática de tradução orgânica"],["If checked, all organic translation (manually inputted translation) will be memorized automatically.","Se marcado, toda tradução orgânica (tradução inserida manualmente) será memorizada automaticamente."],["Memorize translation by automation script","Memorizar tradução por script de automação"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.","Se marcado, o Translator++ lembrará a tradução criada a partir de scripts de automação. \nTodas as alterações via 'this.cells' serão memorizadas. Mas é possível modificar o conteúdo da grade diretamente usando a API trans, tais alterações não acionarão a memorização automática."],["Remind translation on cell translate","Lembrar tradução ao traduzir célula"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.","Se marcado, o Translator++ carregará a tradução da memória de tradução primeiro antes de realizar a tradução automática na célula selecionada."],["Default memorization behavior","Comportamento padrão de memorização"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.","Substituir registro anterior ao realizar tradução orgânica. Se desmarcado, a MT não memorizará a nova tradução para registros existentes."],["MySQL host","Host MySQL"],["The host name or IP address of your MySQL server","O nome do host ou endereço IP do seu servidor MySQL"],["MySQL port","Porta MySQL"],["MySQL Port. Default is 3306.","Porta MySQL. O padrão é 3306."],["MySQL user name","Nome de usuário MySQL"],["Username to access the DB.","Nome de usuário para acessar o banco de dados."],["MySQL password","Senha MySQL"],["Password to access the DB.","Senha para acessar o banco de dados."],["Database Name","Nome do Banco de Dados"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.","Nome do banco de dados. O Translator++ tentará criar o banco de dados se não existir, mas o sucesso depende dos privilégios das credenciais fornecidas."],["Database Type","Tipo de Banco de Dados"],["Automatically memorize manually inputted translations?","Memorizar automaticamente traduções inseridas manualmente?"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Desculpe, este addon está disponível apenas para patrocinadores ativos.\nVocê pode desbloquear este recurso tornando-se um patrocinador de $1."],["Automatically memorize translation made by automation scripts?","Memorizar automaticamente traduções feitas por scripts de automação?"],["Remind translations when performing translate selection?","Lembrar traduções ao realizar a seleção de tradução?"],["Use rememorize in organic translation","Usar rememorização na tradução orgânica"],["default","padrão"],["Indexed DB (experimental)","Indexed DB (experimental)"],["MySQL","MySQL"],["Database Setting","Configuração do Banco de Dados"],["IndexedDB","IndexedDB"],["Generate","Gerar"],["Escaping algorithm for inline code inside dialogues","Algoritmo de escape para código inline dentro de diálogos"],["Test connection","Testar conexão"],["Connection success!","Conexão bem-sucedida!"],["MySql","MySql"],["Connection failed!\nError:","Conexão falhou!\nErro:"],["Install MySQL Server","Instalar Servidor MySQL"],["How to setup MySQL Server","Como configurar o Servidor MySQL"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?","Múltiplas traduções para uma frase-chave foram detectadas.\nApenas a última tradução encontrada será memorizada pela Memória de Tradução.\nDeseja continuar?"],["Your database structure need to be updated.","A estrutura do seu banco de dados precisa ser atualizada."],["Upgrade database","Atualizar banco de dados"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?","Esta ação atualizará seu banco de dados.\nDeseja atualizar o banco de dados da memória de tradução?"],["The translation memory database has been upgraded!\nPlease restart Translator++!","O banco de dados da memória de tradução foi atualizado!\nPor favor, reinicie o Translator++!"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":42,"length":42,"percent":100},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory","Memória"],["Fix the problem!","Corrigir o problema!"],["No exact matches found!","Nenhuma correspondência exata encontrada!"],["Original","Original"],["Translation","Tradução"],["Do you want Translator++ to forget the selected cell(s)?","Deseja que o Translator++ esqueça a(s) célula(s) selecionada(s)?"],["Auto recall","Recuperação automática"],["Auto memorize organic translation","Memorização automática de tradução orgânica"],["Auto memorize automation","Automatizar memorização automática"],["Use rememorize in organic translation","Usar rememorização em tradução orgânica"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["tid/2391/type/StringLiteral"],["tid/2543/type/StringLiteral"],["tid/2686/type/StringLiteral"],["tid/2838/type/StringLiteral"]],"basename":"tmUI.js","dirname":"/addons/tm","extension":".js","filename":"tmUI.js","path":"/addons/tm/tmUI.js","indexIsBuilt":false,"indexIds":{"Memory":0,"Fix the problem!":1,"No exact matches found!":2,"Original":3,"Translation":4,"Do you want Translator++ to forget the selected cell(s)?":5,"Auto recall":6,"Auto memorize organic translation":7,"Auto memorize automation":8,"Use rememorize in organic translation":9},"tags":[],"relPath":"/addons/tm/tmUI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/tpp-localizationTool/fetchtrans.js":{"data":[["Preparing download file...","Preparando arquivo de download..."],["Translation template downloaded successfully!","Modelo de tradução baixado com sucesso!"],["Building translation data...","Construindo dados de tradução..."],["Processing: ","Processando: "],["Fetching directory content...","Buscando conteúdo do diretório..."],["Parsing: ","Analisando: "]],"context":[["tid/2001/type/StringLiteral"],["tid/2228/type/StringLiteral"],["tid/2286/type/StringLiteral"],["tid/2439/type/StringLiteral"],["tid/2623/type/StringLiteral"],["tid/2825/type/StringLiteral"]],"basename":"fetchtrans.js","dirname":"/addons/tpp-localizationTool","extension":".js","filename":"fetchtrans.js","path":"/addons/tpp-localizationTool/fetchtrans.js","indexIsBuilt":false,"indexIds":{"Preparing download file...":0,"Translation template downloaded successfully!":1,"Building translation data...":2,"Processing: ":3,"Fetching directory content...":4,"Parsing: ":5},"tags":[],"relPath":"/addons/tpp-localizationTool/fetchtrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","modelo"],["|","|"],["promptLibrary","bibliotecaDePrompts"],["search","pesquisar"],["downloadChat","baixarChat"],["newChat","novoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","descrição da apiVersion"],["securityMessage","mensagem de segurança"],["apiEndpoint.description","descrição do apiEndpoint"],["apiEndpoint.warn","aviso do apiEndpoint"],["partialImportMessages","mensagens de importação parcial"],["import","importar"],["name","nome"],["prompt","prompt"],["clearPrompts","limpar prompts"],["morePrompts","mais prompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","botão.sync"],["button.stop","botão.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-05e7d66a.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-05e7d66a.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js":{"data":[["customModels.customLabel","rótulo personalizado de customModels"],["model","modelo"],["|","|"],["promptLibrary","biblioteca de prompts"],["search","pesquisar"],["downloadChat","baixar chat"],["newChat","novoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","importar"],["name","nome"],["prompt","prompt"],["clearPrompts","limparPrompts"],["morePrompts","maisPrompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","button.sync"],["button.stop","button.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-4418d312.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-4418d312.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js":{"data":[["customModels.customLabel","modelosPersonalizados.etiquetaPersonalizada"],["