,"Row properties":155},"tags":[],"relPath":"/js/trans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":156,"length":156,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.js":{"data":[["`You cannot close the application at this moment, reason: \\n${","`Você não pode fechar o aplicativo neste momento, motivo: \\n${"],["}`","}`"],["Do you really want to exit Translator++?\nAll unsaved changes will be discarded!","Você realmente deseja sair do Translator++?\nTodas as alterações não salvas serão descartadas!"],["Trans file","Arquivo de tradução"],["Translator++ Project Package (TPP) file","Arquivo de Pacote de Projeto Translator++ (TPP)"],["Select all","Selecionar tudo"],["Select none","Selecionar nenhum"],["Invert","Inverter"],["Match destination selection","Corresponder à seleção de destino"],["use mouse drag to do bulk selection","use arrastar do mouse para fazer seleção em massa"],["Invalid trans data","Dados de tradução inválidos"],["Inject / Apply translation","Injetar / Aplicar tradução"],["Inject / Apply translation to all","Injetar / Aplicar tradução a todos"],["Cancel","Cancelar"],["Apply Translation","Aplicar Tradução"],["Target path cannot be a parent or child of the source material's path.\nPlease select another path.","O caminho de destino não pode ser pai ou filho do caminho do material de origem.\nPor favor, selecione outro caminho."],["Help","Ajuda"],["Import","Importar"],["Revert to origin data","Reverter para dados originais"],["Select target directory.","Selecionar diretório de destino."],["The existing files will be overwritten!","Os arquivos existentes serão sobrescritos!"],["Process","Processar"],["Path to the directory can not be empty!","O caminho para o diretório não pode estar vazio!"],["Invalid directory:","Diretório inválido:"],["Rebuild translation table from this cache","Reconstruir tabela de tradução a partir deste cache"],["Create new project","Criar novo projeto"],["-nothing-","-nada-"],["Ok","Ok"],["No action selected, are you sure?","Nenhuma ação selecionada, tem certeza?"],["No context's keyword specified!","Nenhuma palavra-chave de contexto especificada!"],["Remove context containing keyword :\n","Remover contexto contendo palavra-chave :\n"],["\nfrom selected files?","\ndos arquivos selecionados?"],["Remove every rows except rows that has a context containing keyword :\n","Remover todas as linhas exceto as que têm um contexto contendo palavra-chave :\n"],["items","itens"],["Select Context","Selecionar Contexto"],["Manual Query","Consulta Manual"],["Tag filter","Filtro de Tag"],["Merging option","Opção de Fusão"],["Source Column","Coluna de Origem"],["Target Column","Coluna de Destino"],["Maximum length","Comprimento máximo"],["Query","Consulta"],["Select how you want to filter the rows to be wrapped based on their context.","Selecione como deseja filtrar as linhas a serem envolvidas com base em seu contexto."],["Your list of context separated by new line","Sua lista de contexto separada por nova linha"],["Optionally filter rows by their color tags.","Opcionalmente, filtre linhas por suas tags de cor."],["Options","Opções"],["No merging","Sem mesclagem"],["Merge lines","Mesclar linhas"],["Merge lines except first line","Mesclar linhas exceto a primeira linha"],["General setup","Configuração geral"],["Wrap text","Quebrar texto"],["Source & target column can not be same!","A coluna de origem e destino não podem ser iguais!"],["No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?","Nenhum arquivo está selecionado no painel de seleção de arquivos.\nO Translator++ assumirá que todos os arquivos serão processados\nTem certeza disso?"],["One or more required options are not set for ","Uma ou mais opções necessárias não estão definidas para "],["One or more settings required by the translator engine are not set. If you continue, the translation process may fail.","Uma ou mais configurações exigidas pelo motor de tradução não estão definidas. Se você continuar, o processo de tradução pode falhar."],["Required options :","Opções necessárias:"],["Open the settings","Abrir as configurações"],["Continue anyway","Continuar mesmo assim"],["Translate Now","Traduzir Agora"],["Please select translator engine","Por favor, selecione o motor de tradução"],["Can not process your request because the source column and target column are same!","Não é possível processar sua solicitação porque a coluna de origem e destino são iguais!"],["Tags","Tags"],["Merge Option","Opção de Mesclagem"],["Add rows","Adicionar linhas"],["None","Nenhum"],["Merge","Mesclar"],["Merge except the first line","Mesclar exceto a primeira linha"],["No export path specified","Nenhum caminho de exportação especificado"],["Export path can not be inside or the same with the project folder.\nYour export path: ","O caminho de exportação não pode estar dentro ou ser o mesmo que a pasta do projeto.\nSeu caminho de exportação: "],["\nYour project path: ","\nSeu caminho do projeto: "],["\n\nPlease choose another folder!","\n\nPor favor, escolha outra pasta!"],["Export Now","Exportar Agora"],["Action","Ação"],["Append tags","Adicionar tags"],["Remove tags","Remover tags"],["Set tags","Definir tags"],["Do nothing","Não fazer nada"],["-unknown title-","-título desconhecido-"],["Can not open file. File not exist.","Não é possível abrir o arquivo. O arquivo não existe."],["Go to online documentation.","Ir para a documentação online."],["No projects yet","Ainda não há projetos"],["Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t","Você é novo no Translator++?<br />\n\t\t\tPor favor, leia nossa documentação online em <b>dreamsavior.net</b>.<br />\n\t\t\tPressione <b>F1</b> para abrir a ajuda online.<br />\n\t\t\tEntre em contato comigo em <b>patreon.com/dreamsavior</b> para perguntas e relatórios de bugs.\n\t\t\t"],["Warning","Aviso"],["Close","Fechar"],["You are about to run a user script!","Você está prestes a executar um script de usuário!"],["Execute the script","Executar o script"],["Bring to main screen","Trazer para a tela principal"],["Show row header info","Mostrar informações do cabeçalho da linha"],["Row header width","Largura do cabeçalho da linha"],["Display marker on organic cells","Exibir marcador em células orgânicas"],["Leave trail on cell visit","Deixar rastro na visita à célula"],["Display trails on visited cells","Exibir rastros em células visitadas"],["Row Properties","Propriedades da Linha"],["Project Properties","Propriedades do Projeto"],["Project Properties : ","Propriedades do Projeto : "],["Stage path do not exist!","O caminho do estágio não existe!"],["Select dev folder","Selecionar pasta de desenvolvimento"],["Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.","Onde está localizado o diretório do jogo traduzido?<br />Esta é a mesma pasta com o diretório de destino ao injetar seu jogo."],["Select folder","Selecionar pasta"],["Submit","Enviar"],["File Properties","Propriedades do Arquivo"],["File Properties : ","Propriedades do Arquivo : "],["Target column","Coluna alvo"],["Trim Whitespaces","Remover Espaços em Branco"],["Please select a column","Por favor, selecione uma coluna"],["Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!","Tem certeza de que deseja remover os espaços em branco na coluna selecionada?\nEsta ação não pode ser desfeita!"],["Are you sure want commit autopadding on selected column?\nThis action can not be undone!","Tem certeza de que deseja aplicar o preenchimento automático na coluna selecionada?\nEsta ação não pode ser desfeita!"],["Markers","Marcadores"],["Markers are visual guidelines for the number of characters in a line.","Marcadores são guias visuais para o número de caracteres em uma linha."],["The marker will only be visible if wordwrap in the text area is disabled.","O marcador só será visível se a quebra de linha na área de texto estiver desativada."],["Add","Adicionar"],["Clear all","Limpar tudo"],["Enable suggestion","Habilitar sugestão"],["Speech Synthesizer","Sintetizador de Voz"],["Reading speed:","Velocidade de leitura:"],["Pitch:","Tom:"],["Volume:","Volume:"],["Mark at","Marcar em"],["Units","Unidades"],["Half width character (ie. Alphabet, etc)","Caractere de meia largura (ex. Alfabeto, etc.)"],["Full width character (ie. Hiragana, Kanji, 漢字, etc)","Caractere de largura total (ex. Hiragana, Kanji, 漢字, etc.)"],["Color","Cor"],["Remove","Remover"],["Current Cell's Editor Options","Opções do Editor da Célula Atual"],["Auto Padding","Preenchimento Automático"],["Create","Criar"],["Unable to open that file!","Não foi possível abrir esse arquivo!"],["Are you sure want to close the project?\nYou will lost any unsaved changes!","Tem certeza de que deseja fechar o projeto?\nVocê perderá quaisquer alterações não salvas!"],["Are you sure want to exit Translator++?\nYou will lost any unsaved changes!","Tem certeza de que deseja sair do Translator++?\nVocê perderá quaisquer alterações não salvas!"],["Do not show this message again!","Não mostrar esta mensagem novamente!"],["Back","Voltar"],["Are you sure want to execute the following script?","Tem certeza de que deseja executar o seguinte script?"],["No script found","Nenhum script encontrado"],["Open Script Editor","Abrir Editor de Scripts"],["How to add Automation here","Como adicionar Automação aqui"],["Clear Quick Launch","Limpar Lançamento Rápido"],["Are you sure want to clear all quick launch scripts?","Tem certeza de que deseja limpar todos os scripts de lançamento rápido?"],["Remove selected objects?","Remover objetos selecionados?"],["Do you wish to remove related staging files too?\nWarning: This is can not be undone!","Deseja remover também os arquivos de preparação relacionados?\nAviso: Isso não pode ser desfeito!"],["Error!\r\nTranslator++ is unable to detect the type of ","Erro!\r\nO Translator++ não consegue detectar o tipo de "],["`Required application to parse ${","`Aplicativo necessário para analisar ${"],["} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`","} não está instalado.\\nPor favor, instale-o através do instalador de aplicativos de terceiros.\\nDeseja abrir a janela do Instalador de Aplicativos de Terceiros?`"],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","O jogo está empacotado com Enigma.\r\nDeseja extrair o pacote?\r\nIsso levará minutos, dependendo do tamanho do seu jogo."],["Copy & extract data into ","Copiar & extrair dados para "],["Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!","Tem certeza absoluta de que deseja excluir todas as traduções na página atual?\nAviso: esta ação é irreversível!"],["Are you realy sure want to delete current file?\nWarning: this is irreversible action!","Tem certeza absoluta de que deseja excluir o arquivo atual?\nAviso: esta ação é irreversível!"],["Please enter the title","Por favor, insira o título"],["Do you want to remove the currently selected row(s)?","Deseja remover a(s) linha(s) atualmente selecionada(s)?"]],"context":[["tid/154/type/TemplateHead"],["tid/158/type/TemplateTail"],["tid/202/type/StringLiteral"],["tid/1201/type/StringLiteral"],["tid/1261/type/StringLiteral"],["tid/4827/type/StringLiteral"],["tid/4834/type/StringLiteral"],["tid/4841/type/StringLiteral"],["tid/4848/type/StringLiteral"],["tid/4855/type/StringLiteral"],["tid/8249/type/StringLiteral"],["tid/8829/type/StringLiteral"],["tid/8861/type/StringLiteral"],[