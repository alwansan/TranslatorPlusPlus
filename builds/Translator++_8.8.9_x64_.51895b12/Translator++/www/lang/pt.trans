292/type/StringLiteral"],["tid/622315/type/StringLiteral"],["tid/629235/type/StringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","modelosPersonalizados.rótuloPersonalizado"],["model","modelo"],["|","|"],["promptLibrary","bibliotecaDePrompts"],["search","pesquisar"],["downloadChat","baixarChat"],["newChat","novoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","apiEndpoint.rótuloEntrada"],["apiKey.inputLabel","apiKey.rótuloEntrada"],["apiVersion.inputLabel","apiVersion.rótuloEntrada"],["apiVersion.description","apiVersion.descrição"],["securityMessage","mensagemDeSegurança"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","importar"],["name","nome"],["prompt","prompt"],["clearPrompts","limparPrompts"],["morePrompts","maisPrompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","botão.sync"],["button.stop","botão.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Traduzir com ChatGPT Batch API"],["Model","Modelo"],["The pre-trained model.","O modelo pré-treinado."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Parece que a API Batch da OpenAI usa uma convenção de nomenclatura de modelos ligeiramente diferente da API geralmente usada. Os modelos usados na API Batch têm um prefixo “-batch”. Por exemplo, se você usar <code>gpt-4.1-mini</code>, o modelo se torna automaticamente <code>gpt-4.1-mini-batch</code>.<br />\nNo entanto, no momento em que este add-on foi criado, os modelos batch não estão listados nos limites de uso de modelos da OpenAI, o que impossibilita que os usuários usem a API Batch se tiverem definido o filtro de uso de modelo para “Permitir” (lista branca).<br />\nIsso provavelmente é um bug na interface da OpenAI que pode ser corrigido no futuro.<br />\nPortanto, certifique-se de definir os limites de uso na OpenAI para o modo “Bloquear” (lista negra) para usar a API Batch.<br />\nClique aqui para alterar os limites de uso do modelo: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Coluna de Origem"],["The column of the original texts you want to translate.","A coluna dos textos originais que você deseja traduzir."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Ignore if already translated","Ignorar se já traduzido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Se esta opção estiver marcada, o Translator++ ignorará qualquer linha que já tenha traduções em sua coluna."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações, como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que dirá qual é o papel do seu assistente chatGPT. Esta mensagem será enviada como a primeira mensagem de cada lote que você enviar ao chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis com o estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nome completo do idioma de origem</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nome completo do idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensagens no lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Adicionar informações dos atores.</li>"],["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência a partir do objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXTO : Incluir algumas linhas anteriores como contexto</li>"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your chat.","Modelo do corpo do seu chat."],["Sample conversation","Conversa de exemplo"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","A API Batch do ChatGPT permite traduzir seu projeto de forma assíncrona com 50% de custo menor, o que significa que você receberá os resultados da sua tradução <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:red\">metade do custo normal</b>. Isso é particularmente útil para projetos grandes que não exigem resultados de tradução imediatos."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Leia mais sobre a API Batch do ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Configurações Gerais"],["This form is using your existing ChatGPT configuration.<br>","Este formulário está usando sua configuração existente do ChatGPT.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Você pode alterar a configuração indo para as configurações do Tradutor ChatGPT na janela de opções.<br>"],["There you can set the API key, model, and other settings.<br />","Lá você pode definir a chave da API, o modelo e outras configurações.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Abrir configurações do ChatGPT\" />"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Ignore translated rows","Ignorar linhas traduzidas"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário ao prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar sobrecarregar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt Template","Modelo de Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensagem do Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aqui você pode explicar ao assistente qual é o papel dele.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Exemplo de diálogo existente. Você pode escrever um exemplo de boas ou más respostas para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Seu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este é o prompt real para o assistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Custo fixo</h3>\n                        Custo fixo é o custo da mensagem de prompt que você envia ao assistente sem os textos de tradução reais. O custo é calculado com base no número de tokens na mensagem de prompt. Quanto mais tokens você tiver, maior será o custo.<br>\n                        <b>Custo fixo atual:</b> <span class=\"overheadCost\">0</span> tokens / solicitação."],["Are you sure you want to reset the form?","Tem certeza de que deseja redefinir o formulário?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Tem certeza de que deseja processar o lote?\nCustos serão incorridos para esta operação."],["The batch is successfully created. Do you want to open the batch manager?","O lote foi criado com sucesso. Você deseja abrir o gerenciador de lotes?"],["OpenAI Batch API Queue","Fila da API de Lotes OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transChatGPT/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência do objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transChatGPT/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor, selecione as linhas para aplicar a tradução"],["Target Column","Coluna de Destino"],["The column to put the translation result.","A coluna para colocar o resultado da tradução."],["Import translation from ChatGPT Batch","Importar tradução do Lote do ChatGPT"],["Translation applied to selected rows","Tradução aplicada às linhas selecionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Incompatibilidade"],["Failed to load batch list with error: \n","Falha ao carregar a lista de lotes com erro: \n"],["Download Error File","Baixar Arquivo de Erro"],["Batch is not completed yet","O lote ainda não foi concluído"],["Are you sure you want to cancel this batch?","Tem certeza de que deseja cancelar este lote?"],["Cannot cancel completed batch.","Não é possível cancelar um lote concluído."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Falha ao cancelar o lote"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar tradução"],["Cancel batch","Cancelar lote"],["Status","Status"],["Batch ID","ID do Lote"],["Input File ID","ID do Arquivo de Entrada"],["End point","Ponto Final"],["Created at","Criado em"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira em <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas a solicitações concluídas ficam disponíveis via arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas.\"></i>"],["Completed at","Concluído em"],["Errors","Erros"],["Batch Item Detail of","Detalhe do Item do Lote de"],["ID","ID"],["Completed on","Concluído em"],["Model","Modelo"],["Prompt Token","Token de Prompt"],["Completion Token","Token de Conclusão"],["Total Token","Token Total"],["Status Code","Código de Status"],["error","erro"],["Conversation","Conversa"],["Response Validation","Validação de Resposta"],["Raw Payload","Carga Bruta"],["View raw payload","Ver carga bruta"],["Response Preview","Prévia da Resposta"],["Apply translations from selected rows","Aplicar traduções das linhas selecionadas"],["Here you can edit the translation result individually and send it into Translator++","Aqui você pode editar o resultado da tradução individualmente e enviá-lo para o Translator++"],["Open ChatGPT Settings","Abrir Configurações do ChatGPT"],["Help","Ajuda"],["File list","Lista de Arquivos"],["Collapse / restore left panel","Recolher / restaurar painel esquerdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas a solicitações concluídas ficam disponíveis através do arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","Chat OpenAI"],["Target URL","URL de Destino"],["Target end point. You can use any service that supports OpenAI API.","Ponto final de destino. Você pode usar qualquer serviço que suporte a API OpenAI."],["Sample endpoints","Pontos de amostra"],["Use this endpoint","Use este ponto"],["Copy to clipboard","Copiar para a área de transferência"],["e.g.","por exemplo"],["API Key","Chave da API"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","Insira sua chave da API aqui.<br>O método para obter a chave da API é diferente para cada serviço.<br>"],["Leave it blank if the service doesn't require API key.","Deixe em branco se o serviço não exigir chave da API."],["Model","Modelo"],["The pre-trained model","O modelo pré-treinado"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","Para OpenAI, você pode precisar configurar o modelo permitido para uso (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","Ativar Contexto"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Ative o contexto para a tradução. O material traduzido anteriormente acima do lote atual será incluído como contexto. <b>Você também precisa incluir explicitamente o CONTEXTO no modelo</b>"],["Context Character Limit","Limite de Caracteres do Contexto"],["Character limit for the context.","Limite de caracteres para o contexto."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que dirá qual é o papel do seu assistente chatGPT. Esta mensagem será enviada como a primeira de cada lote que você enviar ao chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis no estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>TEXTO_ORIGINAL : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ALGORITMO_DE_ESCAPE_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>STRING_DE_NOVA_LINHA : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>CONTAGEM_DE_MENSAGENS : Número de mensagens no lote.</li>"],["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFORMAÇÃO_DE_ATOR : Glossário de informações do ator. (Somente se a opção de informação do ator estiver ativada no modo lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência do objeto Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["User message","Mensagem do usuário"],["Assistant's response","Resposta do assistente"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your chat.","Modelo do corpo do seu chat."],["Enable JailBreak","Ativar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Ativar Jailbreak para a tradução. Isso tornará a tradução mais precisa e menos tendenciosa. Alguns modelos podem querer relacionar eventos fictícios a eventos da vida real, portanto, tentarão alterar a tradução para se adequar à sua própria narrativa. Esta opção impedirá isso."],["Jailbreak Template","Modelo de Jailbreak"],["Template of the Jailbreak message.","Modelo da mensagem de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","O número máximo de tokens a gerar na conclusão.<br>A contagem de tokens do seu prompt mais max_tokens não pode exceder o comprimento de contexto do modelo. A maioria dos modelos tem um comprimento de contexto de 2048 tokens (exceto os modelos mais novos, que suportam 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qual temperatura de amostragem usar, entre 0 e 2. Valores mais altos como 0,8 tornarão a saída mais aleatória, enquanto valores mais baixos como 0,2 a tornarão mais focada e determinística. <br>A OpenAI geralmente recomenda alterar isso ou top_p, mas não ambos."],["Nucleus sampling (top_p)","Amostragem de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Uma alternativa à amostragem com temperatura, chamada amostragem de núcleo, onde o modelo considera os resultados dos tokens com massa de probabilidade top_p. Assim, 0,1 significa que apenas os tokens que compõem os 10% superiores de massa de probabilidade são considerados. <br>A OpenAI geralmente recomenda alterar isso ou a temperatura, mas não ambos."],["Frequency Penalty","Penalidade de Frequência"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua frequência existente no texto até agora, diminuindo a probabilidade do modelo repetir a mesma linha literalmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalidade de Presença"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em se eles aparecem no texto até agora, aumentando a probabilidade do modelo falar sobre novos tópicos. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Usar Esquema JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Use <code>json_schema</code> para o campo <code>response_format.type</code> em vez do antigo <code>json_object</code>. O <code>json_schema</code> é exigido por alguns dos modelos mais recentes e alguns servidores como <b>LM Studio</b>, mas alguns modelos antigos ainda usam <code>json_object</code>."],["Max Characters per Batch","Máximo de Caracteres por Lote"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Limite máximo de caracteres por lote de tradução.\nEsta opção contará apenas o comprimento em caracteres do texto original, e não o comprimento da mensagem do prompt."],["Max concurrent requests","Máximo de solicitações simultâneas"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","Quantas solicitações simultâneas são permitidas para serem conectadas ao mesmo tempo? Cada conexão simultânea adicional multiplicará sua velocidade de tradução, mas também esgotará rapidamente seu limite de tokens definido pelo seu provedor.<br />Defina como <b>0</b> para desativar este recurso.<br />Combine esta opção com <b>Máximo de linhas por solicitação simultânea</b> para aumentar ainda mais a velocidade de tradução.<br />Definir esta opção para mais de 1 afetará o <b>Contexto</b> porque haverá uma solicitação processada antes que a anterior seja concluída. Assim, o contexto será enviado sem o resultado da tradução da solicitação anterior."],["Max row per concurrent requests","Máximo de linhas por solicitações simultâneas"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Quantas linhas são permitidas para cada solicitação simultânea. Defina como <b>0</b> para desativar este recurso.<br />Se esta opção estiver desativada, não importa quantas <b>Máximo de solicitações simultâneas</b> você definir, o Translator++ processará a solicitação como um único bloco.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Quanto mais linhas você definir, mais tradução você pode obter em um único lote. Portanto, reduz o custo de sobrecarga e aumenta a chance de a IA retornar resultados com erro.<br />Quanto menor o número, menos provável que a tradução tenha erro, mas custará extra para prompts de sobrecarga."],["Preserve translations from invalid returned number of rows","Preservar traduções de número inválido de linhas retornadas"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","Preservar traduções de respostas que têm contagens de linhas inválidas.<br />Se marcado, o Translator++ tentará corrigir a contagem de linhas e inserir as traduções na grade.<br />Se desmarcado, as células permanecerão em branco.<br />Recomenda-se deixar esta opção desmarcada para fins de retradução."],["Batch delay","Atraso do Lote"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","Atraso entre lotes (em milissegundos).<br />Use esta configuração para controlar suas solicitações e não exceder o limite de RPM (solicitações por minuto)."],["Batch Timeout","Tempo Limite do Lote"],["Timeout for each batch in milisecond","Tempo limite para cada lote em milissegundos"],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Algoritmo de escape para código embutido dentro de diálogos. Pode ser necessário alterar o <b>Modelo de Mensagem do Sistema</b> e o <b>Modelo de Mensagem do Corpo</b> de acordo com o algoritmo de escape escolhido.<br />Ao escolher <b>JSONCloaking</b> ou <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> será enviado automaticamente (a menos que você habilite <b>Usar Esquema JSON</b>, que enviará um esquema JSON em vez disso). <b>JSONCloaking</b> é muito preciso, mas não funciona com todos os modelos, tente <b>gpt-3.5-turbo-1106</b>."],["Number of retry","Número de tentativas"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Quantas vezes o mecanismo deve tentar novamente quando a validação da saída da tradução falhar. Se nulo (vazio), então sem tentativa."],["Retry when the number of translated rows doesn't match original","Tentar novamente quando o número de linhas traduzidas não corresponder ao original"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Se habilitado, o mecanismo tentará novamente quando o modelo retornar um número diferente de linhas de tradução em comparação com o payload original."],["Retry when the number of lines for each translated row doesn't match original","Tentar novamente quando o número de linhas para cada linha traduzida não corresponder ao original"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Se habilitado, o mecanismo tentará novamente quando qualquer linha traduzida tiver um número diferente de linhas do que sua linha original."],["Prompt: Row count mismatch","Prompt: Incompatibilidade na contagem de linhas"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt usado ao tentar novamente devido a incompatibilidade na contagem de linhas/elementos. Variáveis de modelo disponíveis incluem: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","Prompt: Incompatibilidade na contagem de linhas por linha"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt usado ao tentar novamente devido a incompatibilidade na contagem de linhas por linha. Variáveis de modelo disponíveis incluem: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","Prompt: Erro / Instrução de tentativa"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","Prompt anexado após o(s) prompt(s) de incompatibilidade para instruir o modelo a tentar novamente. Variáveis de modelo disponíveis incluem: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","Parâmetro Personalizado"],["Key","Chave"],["Value","Valor"],["Type","Tipo"],["Type of the value.","Tipo do valor."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Para o tipo <b>javascript</b>, o valor será avaliado como código JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","O escopo do código JavaScript é <code>window</code>. Então você pode praticamente acessar qualquer valor."],["<br />Example: <code>trans.project.title</code>","<br />Exemplo: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Remova parâmetros que não serão enviados à API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","A API da OpenAI está sempre mudando, alguns novos modelos podem não suportar os parâmetros antigos e retornarão erro HTTP para parâmetros de solicitação não reconhecidos."],["You can drop the parameters that are not supported by the model here.","Você pode remover os parâmetros que não são suportados pelo modelo aqui."],["Manage configuration","Gerenciar configuração"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","HTML com Encapsulamento"],["JSONObject Cloaking","Encapsulamento JSONObject"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","Este addon permite a tradução através de qualquer serviço que suporte a API de Chat da OpenAI, como Deepseek, LlamaCPP, Google Gemini, etc, e, claro, OpenAI ChatGPT."],["OpenAI API settings","Configurações da API da OpenAI"],["General","Geral"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Não desperdice seu dinheiro com Modelos de Raciocínio</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Estudos diversos comprovaram que modelos de raciocínio são muito piores do que os modelos normais em tarefas de escrita criativa e tradução.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Você não ganha nada além de custos mais altos e tempos de resposta mais lentos ao usar modelos de raciocínio.</p>"],["Explore more models","Explorar mais modelos"],["Templates","Modelos"],["Enable context","Ativar contexto"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Add Example: Translate Japanese to English","Adicionar Exemplo: Traduzir Japonês para Inglês"],["Retry prompts","Repetir prompts"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Estes prompts são anexados como mensagens extras de <b>usuário</b> durante as repetições, logo após a saída anterior do modelo.</p>"],["<p>Available variables:</p>","<p>Variáveis disponíveis:</p>"],["Enable Jailbreak","Ativar Jailbreak"],["Advanced","Avançado"],["Custom Parameters","Parâmetros Personalizados"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Você pode adicionar parâmetros personalizados ao corpo da requisição da API do Chat OpenAI. Isso é útil se quiser adicionar parâmetros adicionais que não estão disponíveis no formulário."],["<h2>Warning</h2>","<h2>Aviso</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Configurar parâmetros personalizados incorretamente pode fazer com que a requisição da API falhe. Certifique-se de saber o que está fazendo antes de adicionar parâmetros personalizados. Alguns serviços como o OpenAI são rigorosos sobre quais parâmetros você está enviando, e eles retornarão um erro HTTP para parâmetros de requisição não reconhecidos.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Se a mesma chave for usada múltiplas vezes, apenas o último valor será usado.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Se a mesma chave na configuração existente for usada, então o parâmetro de configuração existente será sobrescrito pelo parâmetro personalizado.</li>"],["Drop Parameters","Remover Parâmetros"],["Open chatGPT tester","Abrir testador do chatGPT"],["Batch Translation Setting","Configuração de Tradução em Lote"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Desculpe, este addon está disponível apenas para patronos ativos.\nVocê pode desbloquear este recurso tornando-se um patrono de $1."],["Preserve invalid returned rows","Preservar linhas retornadas inválidas"],["Retries and Refinement","Tentativas e Refinamento"],["<h2>Retries and Refinement</h2>","<h2>Tentativas e Refinamento</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Quando a saída da tradução falha na validação, o Translator++ pode pedir ao modelo para tentar novamente a tradução. Você pode definir quantas vezes o modelo deve tentar e também definir a condição para a tentativa.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Definir um número razoável de tentativas com condições adequadas pode melhorar significativamente a qualidade da tradução, mantendo o custo e o tempo sob controle.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Cada tentativa custa tempo e dinheiro adicionais</b>. Se seu lote acabar tentando com frequência, você pode querer ajustar seu prompt para tornar as instruções mais claras para o modelo.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Use a ferramenta de desenvolvedor ou o Gerenciador de Lotes para depurar sua tradução em lote.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Algoritmo de Escape de Código</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>O escape de código é uma técnica para evitar que o MTL altere os trechos de código dentro dos diálogos. Isso é útil quando seus diálogos contêm trechos de código, como tags HTML, tags XML, objetos JSON ou modelos JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Escolha o algoritmo de escape que corresponde aos trechos de código dentro de seus diálogos. Você pode precisar ajustar os modelos de <b>mensagem do sistema</b>, <b>Prompt de exemplo</b> e <b>mensagem do corpo</b> de acordo.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Clique <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>aqui</a> para ler mais sobre algoritmos de escape de código e como usá-los efetivamente.</p>"],["Default","Padrão"],["JavaScript template cloaking","Ocultação de modelo JavaScript"],["None (no escaping)","Nenhum (sem escape)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Você quer carregar o preset de diálogo de exemplo para o algoritmo de escape selecionado? Isso substituirá seu diálogo de exemplo existente."],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separar o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>ACTOR_INFO</code> no modelo de prompt para posicionar os dados de informação do personagem."],["Actor Reference Translation Column","Coluna de Tradução de Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações, como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["<br />","<br />"],["General Settings","Configurações Gerais"],["Always separate file for each batch","Sempre separar arquivo para cada lote"],["Append actor name to the translatable text","Acrescentar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar sobrecarregar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":false,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"relPath":"/addons/transChatGPT/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":160,"length":160,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>E</u>nviar"],["Toggle word wrap","Alternar quebra de linha"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ajuda"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Este recurso só está disponível se você estiver usando a versão Desenvolvedor do Translator++. Você pode mudar para a versão Desenvolvedor usando Utilitários Básicos -> Alterar Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ATOR : Glossário de informações do ator. (Somente se a opção de informações do ator estiver habilitada no modo de lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência a partir de um objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de boas ou más respostas para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separar o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>INFORMAÇÃO_ATOR</code> no modelo de prompt para colocar os dados de informação do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Arquivo separado sempre para cada lote"],["Append actor name to the translatable text","Acrescentar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário ao prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar sobrecarregar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transChatGPT/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","Conversar com a API do ChatGPT"],["Batch Manager","Gerenciador de Lotes"],["This feature is only available if you have a project open.","Este recurso está disponível apenas se você tiver um projeto aberto."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transChatGPT/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","Você deseja instalar o DazedMTLTool?"],["Ignore if already translated","Ignorar se já traduzido"],["OpenAI Translation with DazedMTL","Tradução OpenAI com DazedMTL"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":false,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"relPath":"/addons/transDazedMTL/transdazedmtl.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","O servidor DeepL não está instalado. Você deseja instalá-lo agora?"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":false,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/transDeepl/DeepLUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","Uso de caracteres:\n"],["Failed to fetch quota: ","Falha ao buscar cota: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":false,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"relPath":"/addons/transDeeplPro/deepl-pro.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>E</u>nviar"],["Toggle word wrap","Alternar quebra de linha"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ajuda"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Este recurso só está disponível se você estiver usando a versão Desenvolvedor do Translator++. Você pode mudar para a versão Desenvolvedor usando Utilitários Básicos -> Alterar Core NWJS."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência a partir de objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>API Nativa Gemini</h2><p>Este motor usa a API nativa do Google Gemini para tradução. <br />Você também pode usar o add-on OpenAI para Google Gemini. Há mais recursos no add-on OpenAI, por isso <b style='color:green;'>recomendo usar o add-on OpenAI em vez disso</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","O Gemini AI requer alguns módulos da biblioteca OpenAI. Certifique-se de que o add-on <b>transChatGPT (ChatGPT para Translator++)</b> está instalado."],["Explore more models","Explorar mais modelos"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"relPath":"/addons/transGemini/gemini.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","modelo"],["|","|"],["promptLibrary","bibliotecaDePrompts"],["search","pesquisar"],["downloadChat","baixarChat"],["newChat","novoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","securityMessage"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","importar"],["name","nome"],["prompt","prompt"],["clearPrompts","limparPrompts"],["morePrompts","maisPrompts"],["toast.sync","toast.sincronizar"],["toast.stop","toast.parar"],["button.sync","botão.sincronizar"],["button.stop","botão.parar"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606