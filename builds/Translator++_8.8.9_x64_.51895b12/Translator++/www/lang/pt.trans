 field.","Nada encontrado!<br />Não se esqueça de definir o campo de pesquisa de destino."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","Nada encontrado para substituir!<br />A função de substituição não substitui nada na coluna de chave."],["Replace '","Substituir '"],["' with '","' por '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'?\r\nAinda não criamos a função de desfazer para isso!\nTem certeza de que deseja prosseguir?"],["click to go","clique para ir"],["This will replace any translation found in target colum,\nAre you sure?","Isso substituirá qualquer tradução encontrada na coluna de destino,\nTem certeza?"],["Keyword too short!","Palavra-chave muito curta!"],["Not found!","Não encontrado!"],["Are you sure want to execute the following script?","Tem certeza de que deseja executar o seguinte script?"],["For ","Para "],[" selected item(s)?"," item(s) selecionado(s)?"],[" Select all"," Selecionar tudo"],[" Invert selection"," Inverter seleção"],[" Clear selection"," Limpar seleção"],[" Set Red tag"," Definir etiqueta vermelha"],[" Set Yellow tag"," Definir etiqueta amarela"],[" Set Green tag","Definir etiqueta verde"],[" Set Blue tag","Definir etiqueta azul"],[" Set Gold tag","Definir etiqueta dourada"],[" More tags...","Mais etiquetas..."],[" Clear tags","Limpar etiquetas"],[" Create Automation","Criar automação"],[" Run Automation","Executar automação"],[" Clear Automation","Limpar automação"],["Are you sure want to clear all quick launch scripts?","Tem certeza de que deseja limpar todos os scripts de lançamento rápido?"],[" Clear translation","Limpar tradução"],["Do you want to clear translations of the selected items?","Deseja limpar as traduções dos itens selecionados?"],[" Delete rows","Excluir linhas"],["Do you want to remove selected rows?\nYou can not undo this action!","Deseja remover as linhas selecionadas?\nEsta ação não pode ser desfeita!"],[" With selection ...","Com seleção..."],["Always on top","Sempre no topo"],["Default","Padrão"],["Blur opacity","Opacidade de desfoque"],["Type regex with the modifier","Digite regex com o modificador"],["Use $n to replace a group. e.g. $1","Use $n para substituir um grupo. ex: $1"],["Find","Encontrar"],["Replace","Substituir"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":false,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"relPath":"/js/find.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":46,"percent":100},"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","Ocultar senha"],["Show password","Mostrar senha"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":false,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"relPath":"/js/jsonform.ext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","Algumas configurações exigem que você reinicie o aplicativo para entrarem em vigor.\nPor favor, salve seu trabalho e reinicie o Translator++."],["Pleae select the name for your configuration.","Por favor, selecione o nome para sua configuração."],["Translator Engine configuration","Configuração do motor de tradução"],["Translator engine version.","Versão do motor de tradução."],["By.","Por."],["No option for this engine","Nenhuma opção para este motor"],["License","Licença"],["Can not disable this addon","Não é possível desativar este addon"],["Requirements","Requisitos"],["What is this?","O que é isso?"],["Uninstall","Desinstalar"],["Update","Atualizar"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","Addon instalado com sucesso.\r\nO Translator++ pode precisar ser reiniciado para que alguns addons entrem em vigor."],["WARNING!\n","AVISO!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","Este add-on foi marcado como \"alteração de parser\". Seus projetos antigos relacionados a este add-on podem não funcionar como esperado. É recomendado fazer backup do seu projeto antes de instalar este add-on.\nVocê pode importar sua tradução existente para o projeto recém-criado.\n\nDeseja instalar "],["Do you want to install ","Deseja instalar "],["Add-on","Add-on"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","foi instalado com sucesso.\r\nO Translator++ pode precisar ser reiniciado para que alguns addons entrem em vigor."],["Add-on version.","Versão do add-on."],["No option for this add-on","Nenhuma opção para este add-on"],["Translator++ will write Window's registry.\r\nAre you sure?","O Translator++ irá escrever no registro do Windows.\r\nTem certeza?"],["Error parsing patterns:","Erro ao analisar padrões:"],["Do you really want to clear the custom escaper?","Você realmente deseja limpar o escaper personalizado?"],["Do you really want to reset the custom escaper?","Você realmente deseja redefinir o escaper personalizado?"],["You are currently on the latest version.\nDo you still want to update?","Você está atualmente na versão mais recente.\nAinda deseja atualizar?"],["This option will open your default browser to login.\nDo you want to continue?","Esta opção abrirá seu navegador padrão para fazer login.\nDeseja continuar?"],["Login with Browser","Login com Navegador"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","Seu navegador foi aberto para <b>dreamsavior.net/gettoken/</b>.<br>O login será concluído automaticamente após você fazer login.<br><br>Se o login automático não funcionar, copie seu token daquela página e cole-o abaixo:"],["There is no default translator selected.\nChange the default translator to Google!","Não há tradutor padrão selecionado.\nAltere o tradutor padrão para o Google!"],["Change Stagging Path to :","Alterar Caminho de Estágio para:"],["Move the content of current Stagging Path into the new one?","Mover o conteúdo do Caminho de Estágio atual para o novo?"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","Addon(s) foi(ram) instalado(s).\nO Translator++ precisa ser reiniciado para entrar em vigor."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","Você realmente deseja limpar todas as configurações e redefinir o Translator++ para o padrão?\nObserve que esta ação é irreversível.\nFaça backup do seu projeto antes de prosseguir."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","O Translator++ pode não funcionar normalmente se você não corrigir o erro.\nDeseja fechar a janela de opções?"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":false,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"relPath":"/js/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Você deve salvar o projeto atual primeiro antes de criar um atalho para o Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Este recurso só está disponível se você estiver usando a versão Developer do Translator++. Você pode mudar para a versão Developer usando Utilitários Básicos -> Alterar Core NWJS."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/scriptEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>Não foi possível executar o Interpretador PHP!</b><br />\n\t\t\t\tO Translator++ precisa do PHP CLI para executar alguns procedimentos obrigatórios.<br />\n\t\t\t\tEste erro geralmente ocorre porque seu computador <b>não está instalado com a <a href=\"http://dreamsavior.net/download/#TPPSysreq\">versão correta do Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Por favor, instale o <a href=\"http://dreamsavior.net/download/#TPPSysreq\">runtime necessário</a>.</li>\n\t\t\t\t\t\t<li>E por favor, mova o diretório de instalação do Translator++ para outra pasta se você já instalou todo o runtime e ainda está com este erro.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPor favor, verifique a <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentação</a> para mais informações sobre este sintoma."],["Initialization Error!","Erro de Inicialização!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":false,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"relPath":"/js/sys.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/trans.js":{"data":[["Original Text","Texto Original"],["Initial","Inicial"],["Machine translation","Tradução automática"],["Better translation","Tradução melhor"],["Best translation","Melhor tradução"],["Loading","Carregando"],["Error!","Erro!"],["Error processing init file : ","Erro ao processar arquivo de inicialização: "],["Error! File list not found in init file at : ","Erro! Lista de arquivos não encontrada no arquivo de inicialização em: "],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","Isso significa que seu jogo não foi analisado com sucesso. Por favor, visite https://dreamsavior.net/?p=1311 para possíveis soluções para este problema."],["Done!","Concluído!"],["All done!","Tudo pronto!"],["Error opening file : ","Erro ao abrir arquivo: "],["error opening file (open): ","erro ao abrir arquivo (abrir): "],["Project properties - Staging path error!","Propriedades do projeto - Erro no caminho de preparação!"],["Project properties","Propriedades do projeto"],["untitled project","projeto sem título"],["create file list","criar lista de arquivos"],["Finished","Finalizado"],["All process finished!","Todos os processos concluídos!"],["Open Explorer","Abrir Explorador"],["Opening file!","Abrindo arquivo!"],["Assigning new staging path : ","Atribuindo novo caminho de preparação: "],["Success!","Sucesso!"],["Failed!","Falhou!"],["Collecting paths","Coletando caminhos"],["Path : '","Caminho: '"],["' doesn't exist","' não existe"],[" file(s) collected!"," arquivo(s) coletado(s)!"],["Start importing data!","Iniciar importação de dados!"],["Importing : ","Importando: "],["All Done!","Tudo pronto!"],[" is not a valid object name"," não é um nome de objeto válido"],[" is not a valid directory name"," não é um nome de diretório válido"],[" is already exist"," já existe"],["Error opening file :","Erro ao abrir arquivo:"],["Error executing :","Erro ao executar:"],["Are you sure want to execute the following script?","Tem certeza de que deseja executar o seguinte script?"],["Clear quick launch","Limpar lançamento rápido"],["Are you sure want to clear quick launch?","Tem certeza de que deseja limpar o lançamento rápido?"],["How to add Automation here","Como adicionar Automação aqui"],["Select all","Selecionar tudo"],["Clear selection","Limpar seleção"],["Select 100%","Selecionar 100%"],["Select <100%","Selecionar <100%"],["Select progress ≥ ...","Selecionar progresso ≥ ..."],["Select completed","Selecionar concluído"],["Invert selection","Inverter seleção"],["Toggle mark as complete","Alternar marcação como concluído"],["With all","Com todos"],["With ","Com "],[" selected"," selecionado"],["Mark as complete","Marcar como concluído"],["Un-mark as complete","Desmarcar como concluído"],["Batch translation","Tradução em lote"],["Send to...","Enviar para..."],["Wrap texts","Envolver textos"],["Trim","Aparar"],["Auto padding","Preenchimento automático"],["Context Tool","Ferramenta de Contexto"],["Create Automation","Criar Automação"],["For each object","Para cada objeto"],["For each row","Para cada linha"],["Run Automation","Executar Automação"],["Import from...","Importar de..."],["Trans File","Arquivo de Trans"],["Spreadsheets","Planilhas"],["RPGMTransPatch Files","Arquivos RPGMTransPatch"],["Export into...","Exportar para..."],["A folder","Uma pasta"],["Zipped Game Patch","Patch de Jogo Compactado"],["Comma Separated Value (csv)","Valor Separado por Vírgula (csv)"],["Excel 2007 Spreadsheets (xlsx)","Planilhas Excel 2007 (xlsx)"],["Excel Spreadsheets (xls)","Planilhas Excel (xls)"],["ODS Spreadsheets","Planilhas ODS"],["Html Spreadsheets","Planilhas Html"],["RMTrans Patch","Patch RMTrans"],["Inject Translation","Injetar Tradução"],["Revert to original","Reverter para original"],["Clear translation","Limpar tradução"],["Delete files","Excluir arquivos"],["Properties","Propriedades"],["Select progress greater than","Selecionar progresso maior que"],["Please input a number","Por favor, insira um número"],["Do you want to clear translation?","Você deseja limpar a tradução?"],["Add comment","Adicionar comentário"],["Remove comment","Remover comentário"],["added to reference table!","adicionado à tabela de referência!"],["Can not modify Column 0","Não é possível modificar a Coluna 0"],["Unable to delete table : ","Não foi possível excluir a tabela: "],["Can not remove key column!","Não é possível remover a coluna-chave!"],["Please open or create a project first","Por favor, abra ou crie um projeto primeiro"],["Column name can not be empty!","O nome da coluna não pode estar vazio!"],["Invalid column index!","Índice de coluna inválido!"],["Please open or create a new project first!","Por favor, abra ou crie um novo projeto primeiro!"],["You should not edit key value","Você não deve editar o valor-chave"],["Ilegal value","Valor ilegal"],["That value already exist!","Esse valor já existe!"],["The maximum number of columns for this project has been reached, so you cannot add any more.","O número máximo de colunas para este projeto foi atingido, então você não pode adicionar mais."],["Are you sure want to abort this process?","Tem certeza de que deseja abortar este processo?"],["Process paused!\nPress OK to continue!","Processo pausado!\nPressione OK para continuar!"],["Unable to process, project not found","Não foi possível processar, projeto não encontrado"],["Unable to process, data not found","Não foi possível processar, dados não encontrados"],["Translation engine not found","Motor de tradução não encontrado"],["Translation engine ","Motor de tradução "],[" is disabled!"," está desativado!"],["Selected files :","Arquivos selecionados :"],["Collecting data from :","Coletando dados de :"],["Translation finished","Tradução concluída"],["applying translation to table!","aplicando tradução à tabela!"],["Error when translating data!","Erro ao traduzir dados!"],["\tHTTP Status : ","\tStatus HTTP : "],["\tError Type : ","\tTipo de Erro : "],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","Você provavelmente foi temporariamente banido pelo seu serviço de tradução!\r\nPor favor, use o serviço de tradução online com moderação\r\nIsso geralmente se resolve sozinho em um ou dois dias.\r\n"],["Running trans.translateAll","Executando trans.translateAll"],["Start collecting data!","Iniciar coleta de dados!"],["Data collection is done!","Coleta de dados concluída!"],["nothing is selected","nada está selecionado"],["no translator loaded","nenhum tradutor carregado"],["unable to load translator window","incapaz de carregar a janela do tradutor"],["Reference path cannot empty!","O caminho de referência não pode estar vazio!"],["Collecting translation refference","Coletando referência de tradução"],["Applying translation!","Aplicando tradução!"],["Importing translation","Importando tradução"],["Parsing data","Analisando dados"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"," não é uma e