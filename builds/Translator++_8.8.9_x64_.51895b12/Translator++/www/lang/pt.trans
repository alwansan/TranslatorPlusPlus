{"data":[[null]],"columns":[{"readOnly":false,"wordWrap":true,"width":200},{"readOnly":false,"wordWrap":true,"width":339},{"readOnly":false,"wordWrap":true,"width":134},{"readOnly":false,"wordWrap":true,"width":120},{"readOnly":false,"wordWrap":true,"width":109}],"colHeaders":["Original Text","Initial","Machine translation","Better translation","Best translation"],"project":{"indexOriginal":0,"gameEngine":"APPUI","files":{"/addons/VNTextPatch/vntextpatch.js":{"data":[["I have extracted the game data","Extraí os dados do jogo"],["Load game's data folder","Carregar pasta de dados do jogo"],["Select the game's data folder","Selecionar a pasta de dados do jogo"],["Engine Info","Informações do Motor"],["Currently detected engine","Motor atualmente detectado"],["Manually Specify Format","Especificar Formato Manualmente"],["Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.","Especifique manualmente o formato do jogo.<br />O VNTranslationTools detectará automaticamente o formato com base na extensão do arquivo. No entanto, se encontrar extensões ambíguas, forneça o formato explicitamente."],["Interface","Interface"],["VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.","O VNTextPatch pode analisar o jogo em dois formatos: JSON ou uma planilha XLSX. Selecione a interface que deseja usar."],["Warning: There is a row limit if you're choosing XLSX spreadsheet.","Aviso: Há um limite de linhas se escolher a planilha XLSX."],["Create a new project","Criar um novo projeto"],["Invalid destination directory:","Diretório de destino inválido:"],["Close","Fechar"],[null,null,null,null,null]],"context":[["tid/8164/type/StringLiteral"],["tid/8228/type/StringLiteral"],["tid/8233/type/StringLiteral"],["tid/8246/type/StringLiteral"],["tid/8251/type/StringLiteral"],["tid/8256/type/StringLiteral"],["tid/8261/type/StringLiteral"],["tid/8266/type/StringLiteral"],["tid/8271/type/StringLiteral"],["tid/8276/type/StringLiteral"],["tid/8455/type/StringLiteral"],["tid/8516/type/NoSubstitutionTemplate"],["tid/11110/type/StringLiteral"]],"basename":"vntextpatch.js","dirname":"/addons/VNTextPatch","extension":".js","filename":"vntextpatch.js","path":"/addons/VNTextPatch/vntextpatch.js","indexIsBuilt":true,"indexIds":{"I have extracted the game data":0,"Load game's data folder":1,"Select the game's data folder":2,"Engine Info":3,"Currently detected engine":4,"Manually Specify Format":5,"Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.":6,"Interface":7,"VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.":8,"Warning: There is a row limit if you're choosing XLSX spreadsheet.":9,"Create a new project":10,"Invalid destination directory:":11,"Close":12},"tags":[],"relPath":"/addons/VNTextPatch/vntextpatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}]],"lastSelectedCell":[0,1]},"/addons/actionEditorParser/ae4parser.js":{"data":[["Start translation from Action Editor 4 Game","Iniciar tradução a partir do Editor de Ação 4 Jogo"],["Create Project","Criar Projeto"]],"context":[["tid/920/type/StringLiteral"],["tid/997/type/StringLiteral"]],"basename":"ae4parser.js","dirname":"/addons/actionEditorParser","extension":".js","filename":"ae4parser.js","path":"/addons/actionEditorParser/ae4parser.js","indexIsBuilt":false,"indexIds":{"Start translation from Action Editor 4 Game":0,"Create Project":1},"tags":[],"relPath":"/addons/actionEditorParser/ae4parser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/!post.html":{"data":[["Actions","Ações"],["Build for 32bit system","Compilar para sistema de 32 bits"],["Build for non developer build too","Compilar também para build não de desenvolvedor"],["Custom Version","Versão Personalizada"],["Custom version (leave blank to autogenerate version)","Versão personalizada (deixe em branco para gerar versão automaticamente)"],["Generate minor versioning?","Gerar versionamento menor?"],["Save patch to","Salvar patch em"],["Destination folder of generated patch","Pasta de destino do patch gerado"],["Overider template","Substituir modelo"],["Release template","Modelo de lançamento"],["Select file to be available live and excluded from the package","Selecionar arquivo para ficar disponível online e excluído do pacote"],["The file will be excluded from package, but available online","O arquivo será excluído do pacote, mas disponível online"],["Make the process does not require user input","Fazer o processo não exigir entrada do usuário"],["Patch Type","Tipo de Patch"],["The file will be excluded from package, but available online. Select the file you want to substitute.","O arquivo será excluído do pacote, mas disponível online. Selecione o arquivo que deseja substituir."],["Substitute trans.js with a fake one.","Substituir trans.js por um falso."],["Select Patch File","Selecionar Arquivo de Patch"],["Select the generated patch file (*.tpch).","Selecione o arquivo de patch gerado (*.tpch)."],["Patches Links","Links de Patches"],["Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.","A atualização automática fará o download a partir destes links. <b>Deve ser download direto!</b> Separe cada link de download com uma nova linha."],["Download Links","Links de Download"],["Downloadable package for manual download. Separate each download link with newline.","Pacote para download manual. Separe cada link de download com uma nova linha."],["Release Category","Categoria de Lançamento"],["Category of the release.","Categoria do lançamento."],["Upload log along with this submission.","Carregar log junto com este envio."],["Remove the same version found on database.","Remover a mesma versão encontrada no banco de dados."],["Whether this release is enabled or not.","Se este lançamento está habilitado ou não."],["Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.","Se este lançamento está oculto ou não. Se um lançamento estiver oculto, apenas Administradores e membros com a capacidade <code>view_hidden_releases</code> (Desenvolvedor) podem instalar o lançamento via instalador de pacotes."],["Release Name","Nome do Lançamento"],["Release Number","Número do Lançamento"],["Release Date","Data do Lançamento"],["Release Key","Chave do Lançamento"],["Release Type","Tipo de Lançamento"],["CRC","CRC"],["Required Version","Versão Necessária"],["Minimum Version","Versão Mínima"],["Release Note","Nota do Lançamento"],["Release Info","Informações do Lançamento"],["On Before Install","Antes da Instalação"],["On After Install","Após a Instalação"],["Extra parameters","Parâmetros extras"],["Remote file","Arquivo remoto"],["List of remote file, separate by new line","Lista de arquivos remotos, separados por nova linha"],["Patron Level","Nível de Patrono"],["Post title","Título da postagem"],["Release post","Postagem de lançamento"],["Excerpt of the post","Resumo da postagem"]],"context":[["idx/0/innerText","idx/14/innerText","idx/29/innerText","idx/79/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/16/innerText"],["