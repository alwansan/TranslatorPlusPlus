Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","model"],["|","|"],["promptLibrary","bibliotecaDePrompts"],["search","pesquisar"],["downloadChat","baixarChat"],["newChat","novoChat"],["api","api"],["customEndpoint","endpointPersonalizado"],["apiEndpoint.inputLabel","apiEndpoint.etiquetaEntrada"],["apiKey.inputLabel","chaveApi.etiquetaEntrada"],["apiVersion.inputLabel","versaoApi.etiquetaEntrada"],["apiVersion.description","versaoApi.descricao"],["securityMessage","mensagemSeguranca"],["apiEndpoint.description","apiEndpoint.descricao"],["apiEndpoint.warn","apiEndpoint.aviso"],["partialImportMessages","mensagensImportacaoParcial"],["import","importar"],["name","nome"],["prompt","prompt"],["clearPrompts","limparPrompts"],["morePrompts","maisPrompts"],["toast.sync","toast.sincronizar"],["toast.stop","toast.stop"],["button.sync","botão.sync"],["button.stop","botão.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","Traduzir com a API Batch do ChatGPT"],["Model","Modelo"],["The pre-trained model.","O modelo pré-treinado."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Parece que a API Batch da OpenAI usa uma convenção de nomenclatura de modelos ligeiramente diferente da API geralmente usada. Os modelos usados na API Batch têm um prefixo “-batch”. Por exemplo, se você usar <code>gpt-4.1-mini</code>, o modelo automaticamente se torna <code>gpt-4.1-mini-batch</code>.<br />\nNo entanto, no momento em que este add-on foi criado, os modelos batch não estão listados nos limites de uso de modelos da OpenAI, o que impossibilita que os usuários usem a API Batch se tiverem definido o filtro de uso de modelos como “Permitir” (lista branca).<br />\nIsso provavelmente é um bug na interface da OpenAI que pode ser corrigido no futuro.<br />\nPortanto, certifique-se de definir os limites de uso na OpenAI para o modo “Bloquear” (lista negra) para usar a API Batch.<br />\nClique aqui para alterar os limites de uso do modelo: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Coluna de Origem"],["The column of the original texts you want to translate.","A coluna dos textos originais que você deseja traduzir."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Ignore if already translated","Ignorar se já traduzido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Se esta opção estiver marcada, o Translator++ ignorará qualquer linha que já tenha traduções em sua coluna."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que informará qual é a função do seu assistente chatGPT. Esta mensagem será enviada como a primeira de cada lote que você enviar ao chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis no estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nome completo do idioma de origem</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nome completo do idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensagens no lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Adiciona informações dos atores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nome do objeto] : Gera referência a partir do objeto do Translator++. <br />Exemplo : <code>REFERENCE[Referência Comum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Inclui algumas linhas anteriores como contexto</li>"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your chat.","Modelo do corpo do seu chat."],["Sample conversation","Exemplo de conversa"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","A API em Lote do ChatGPT permite que você traduza seu projeto de forma assíncrona com custos 50% menores, o que significa que você receberá os resultados da sua tradução <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:red\">metade do custo normal</b>. Isso é particularmente útil para projetos grandes que não exigem resultados de tradução imediatos."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />Leia mais sobre a API em Lote do ChatGPT: https://platform.openai.com/docs/guides/batch ."],["General Settings","Configurações Gerais"],["This form is using your existing ChatGPT configuration.<br>","Este formulário está usando sua configuração existente do ChatGPT.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","Você pode alterar a configuração indo para as configurações do Tradutor ChatGPT na janela de opções.<br>"],["There you can set the API key, model, and other settings.<br />","Lá você pode definir a chave da API, o modelo e outras configurações.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Abrir configurações do ChatGPT\" />"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Ignore translated rows","Ignorar linhas traduzidas"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar sobrecarregar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt Template","Modelo de Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensagem do Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aqui você pode explicar ao assistente qual é o papel dele.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Seu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este é o prompt real para o assistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Custo indireto</h3>\n                        O custo indireto é o custo da mensagem de prompt que você envia ao assistente sem os textos de tradução reais. O custo é calculado com base no número de tokens na mensagem de prompt. Quanto mais tokens você tiver, maior será o custo.<br>\n                        <b>Custo indireto atual:</b> <span class=\"overheadCost\">0</span> tokens / solicitação."],["Are you sure you want to reset the form?","Tem certeza de que deseja redefinir o formulário?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Tem certeza de que deseja processar o lote?\nO custo será incorrido para esta operação."],["The batch is successfully created. Do you want to open the batch manager?","O lote foi criado com sucesso. Deseja abrir o gerenciador de lotes?"],["OpenAI Batch API Queue","Fila da API de Lote OpenAI"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transGeminiAi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência do objeto Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transGeminiAi/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor, selecione as linhas para aplicar a tradução"],["Target Column","Coluna de Destino"],["The column to put the translation result.","A coluna para colocar o resultado da tradução."],["Import translation from ChatGPT Batch","Importar tradução do Lote do ChatGPT"],["Translation applied to selected rows","Tradução aplicada às linhas selecionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Incompatibilidade"],["Failed to load batch list with error: \n","Falha ao carregar a lista de lotes com erro: \n"],["Download Error File","Baixar Arquivo de Erro"],["Batch is not completed yet","O lote ainda não está concluído"],["Are you sure you want to cancel this batch?","Tem certeza de que deseja cancelar este lote?"],["Cannot cancel completed batch.","Não é possível cancelar um lote concluído."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Falha ao cancelar o lote"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar tradução"],["Cancel batch","Cancelar lote"],["Status","Status"],["Batch ID","ID do Lote"],["Input File ID","ID do Arquivo de Entrada"],["End point","Ponto final"],["Created at","Criado em"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira em <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Lotes que não são concluídos a tempo eventualmente mudam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas a solicitações concluídas ficam disponíveis através do arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas.\"></i>"],["Completed at","Concluído em"],["Errors","Erros"],["Batch Item Detail of","Detalhe do Item em Lote de"],["ID","ID"],["Completed on","Concluído em"],["Model","Modelo"],["Prompt Token","Token de Prompt"],["Completion Token","Token de Conclusão"],["Total Token","Token Total"],["Status Code","Código de Status"],["error","erro"],["Conversation","Conversa"],["Response Validation","Validação de Resposta"],["Raw Payload","Carga Bruta"],["View raw payload","Ver carga bruta"],["Response Preview","Prévia da Resposta"],["Apply translations from selected rows","Aplicar traduções das linhas selecionadas"],["Here you can edit the translation result individually and send it into Translator++","Aqui você pode editar o resultado da tradução individualmente e enviá-lo para o Translator++"],["Open ChatGPT Settings","Abrir Configurações do ChatGPT"],["Help","Ajuda"],["File list","Lista de Arquivos"],["Collapse / restore left panel","Recolher / restaurar painel esquerdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; pedidos não finalizados dentro desse lote são cancelados, e quaisquer respostas a pedidos concluídos ficam disponíveis através do arquivo de saída do lote. Você será cobrado pelos tokens consumidos em quaisquer pedidos concluídos."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ATOR : Glossário de informações do ator. (Somente se a opção de informações do ator estiver ativada no modo de lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência do objeto Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Não desperdice seu dinheiro com Modelos de Raciocínio</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Estudos diversos comprovaram que os modelos de raciocínio são muito piores que os modelos normais na execução de tarefas de escrita criativa e tradução.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Você não ganha nada além de custo mais caro e tempos de resposta mais lentos ao usar modelos de raciocínio.</p>"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever uma amostra de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separe o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados por outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>ACTOR_INFO</code> no modelo de prompt para colocar os dados de informações do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Sempre separar arquivo para cada lote"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar inflar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"relPath":"/addons/transGeminiAi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>E</u>nviar"],["Toggle word wrap","Alternar quebra de linha"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ajuda"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","Este recurso só está disponível se você estiver usando a versão Desenvolvedor do Translator++. Você pode mudar para a versão Desenvolvedor usando Utilitários Básicos -> Alterar Core NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGeminiAi/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ATOR : Glossário de informações do ator. (Somente se a opção de informações do ator estiver ativada no modo em lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gera referência a partir do objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separar o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ removerá então o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência do Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem do prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>INFO_ATOR</code> no modelo do prompt para colocar os dados de informações do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Sempre arquivo separado para cada lote"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar inflar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transGeminiAi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","Conversar com a API do ChatGPT"],["Batch Manager","Gerenciador de Lotes"],["This feature is only available if you have a project open.","Este recurso está disponível apenas se você tiver um projeto aberto."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transGeminiAi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","Esta ação abrirá uma janela do navegador. Certifique-se de que seu navegador padrão está configurado como Chrome. Deseja continuar?"],["Gemini Nano server is already running. Do you want to restart it?","O servidor Gemini Nano já está em execução. Deseja reiniciá-lo?"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","Esta ação abrirá uma janela do navegador. Certifique-se de que seu navegador padrão está configurado como Chrome e que o Servidor Gemini Nano está iniciado. Deseja continuar?"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":false,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"relPath":"/addons/transGeminiNano/geminiNanoUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ATOR : Glossário de informações do ator. (Somente se a opção de informações do ator estiver habilitada no modo de lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência do objeto Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver habilitado)</li>"],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separar o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Acrescentar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem do prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>ACTOR_INFO</code> no modelo do prompt para colocar os dados de informação do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informação do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Sempre arquivo separado para cada lote"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar inflar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"relPath":"/addons/transKoboldAI/Llama3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":24,"length":24,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","Nome do Serviço"],["Service provider for your Batch API.","Provedor de serviço para sua API de Lote."],["Your API Key","Sua Chave de API"],["Please enter your API key for the Batch API service.","Por favor, insira sua chave de API para o serviço de API de Lote."],["Model","Modelo"],["The model for your translation.","O modelo para sua tradução."],["Source Column","Coluna de Origem"],["The column of the original texts you want to translate.","A coluna dos textos originais que você deseja traduzir."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Ignore if already translated","Ignorar se já traduzido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Se esta opção estiver marcada, o Translator++ ignorará qualquer linha que já tenha traduções em sua coluna."],["Filter Tag","Filtrar Tag"],["If set, only rows with this tag will be translated.","Se definido, apenas as linhas com esta tag serão traduzidas."],["Load Actor Reference as Glossary","Carregar Referência do Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações, como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Enable Context","Habilitar Contexto"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Habilitar contexto para a tradução. O material traduzido anteriormente acima do lote atual será incluído como contexto. <b>Você também precisa incluir explicitamente o CONTEXTO no modelo</b>"],["Context Character Limit","Limite de Caracteres do Contexto"],["Character limit for the context.","Limite de caracteres para o contexto."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que dirá qual é o papel do seu assistente chatGPT. Esta mensagem será enviada como a primeira mensagem de cada lote que você enviar ao chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis com o estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nome completo do idioma de origem</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nome completo do idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensagens no lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Adicionar informações dos atores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nome do objeto] : Gerar referência do objeto do Translator++. <br />Exemplo : <code>REFERENCE[Referência Comum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Incluir algumas linhas anteriores como contexto</li>"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your chat.","Modelo do corpo do seu chat."],["Sample conversation","Exemplo de conversa"],["User message","Mensagem do usuário"],["Assistant's response","Resposta do assistente"],["Enable JailBreak","Ativar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Ativar Jailbreak para a tradução. Isso tornará a tradução mais precisa e menos tendenciosa. Alguns modelos podem tentar relacionar eventos fictícios a eventos da vida real, alterando a tradução para se adequar à sua própria narrativa. Esta opção impedirá isso."],["Jailbreak Template","Modelo de Jailbreak"],["Template of the Jailbreak message.","Modelo da mensagem de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","O número máximo de tokens a serem gerados na conclusão.<br>A contagem de tokens do seu prompt mais max_tokens não pode exceder o comprimento de contexto do modelo. A maioria dos modelos tem um comprimento de contexto de 2048 tokens (exceto os modelos mais recentes, que suportam 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qual temperatura de amostragem usar, entre 0 e 2. Valores mais altos como 0,8 tornarão a saída mais aleatória, enquanto valores mais baixos como 0,2 a tornarão mais focada e determinística.<br>A OpenAI geralmente recomenda alterar isso ou top_p, mas não ambos."],["Nucleus sampling (top_p)","Amostragem por núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Uma alternativa à amostragem com temperatura, chamada amostragem por núcleo, onde o modelo considera os resultados dos tokens com massa de probabilidade top_p. Assim, 0,1 significa que apenas os tokens que compõem os 10% superiores da massa de probabilidade são considerados.<br>A OpenAI geralmente recomenda alterar isso ou temperatura, mas não ambos."],["Frequency Penalty","Penalidade de Frequência"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua frequência existente no texto até agora, diminuindo a probabilidade do modelo repetir a mesma linha literalmente.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalidade de Presença"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua aparição no texto até agora, aumentando a probabilidade do modelo falar sobre novos tópicos.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","Parâmetro Personalizado"],["Key","Chave"],["Value","Valor"],["Type","Tipo"],["Type of the value.","Tipo do valor."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Para o tipo <b>javascript</b>, o valor será avaliado como código JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","O escopo do código javascript é <code>window</code>. Então você pode praticamente pegar qualquer valor."],["Example: <code>trans.project.title</code>","Exemplo: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Remova parâmetros que não serão enviados para a API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","A API da OpenAI está sempre mudando, alguns novos modelos podem não suportar os parâmetros antigos e retornarão erro HTTP para parâmetros de solicitação não reconhecidos."],["You can drop the parameters that are not supported by the model here.","Você pode remover os parâmetros que não são suportados pelo modelo aqui."],["Batch API settings","Configurações da API em Lote"],["General","Geral"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","A API em Lote da OpenAI permite que você traduza seu projeto de forma assíncrona com custos 50% menores, o que significa que você receberá os resultados da sua tradução <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:blue\">metade do custo normal</b>. Isso é particularmente útil para projetos grandes que não exigem resultados de tradução imediatos."],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />Leia mais sobre a API em Lote <a href=\"https://platform.openai.com/docs/guides/batch\" external>aqui</a>.<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />Serviços suportados: <b>OpenAI</b> e <b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>Mais configurações são encontradas nas Configurações do Add-on</h2>"],["Open Add-on Settings","Abrir Configurações do Add-on"],["Import Configuration from OpenAI Setting","Importar Configuração das Configurações da OpenAI"],["General Settings","Configurações Gerais"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Não desperdice seu dinheiro com Modelos de Raciocínio</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Foi comprovado por vários estudos que os modelos de raciocínio são muito piores do que os modelos normais na execução de tarefas de escrita criativa e tradução.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Você não ganha nada além de custos mais caros e tempos de resposta mais lentos ao usar modelos de raciocínio.</p>"],["<h2>If you're using OpenAI</h2>","<h2>Se você está usando a OpenAI</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","A API em Lote da OpenAI usa uma convenção de nomenclatura de modelos ligeiramente diferente em comparação com a API padrão. Os modelos no Modo em Lote incluem um sufixo -batch. Por exemplo, se você especificar <code>gpt-4.1-mini</code>, ele será automaticamente interpretado como <code>gpt-4.1-mini-batch</code>.<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","No entanto, no momento em que este add-on foi desenvolvido, os modelos em lote não estavam listados sob os limites de uso de modelo da OpenAI. Isso significa que usuários que configuraram seu filtro de Uso de Modelo para \"Permitir\" (lista branca) não poderão acessar a API em Lote.<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","Clique <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>aqui</a> para alterar os limites de uso do modelo."],["Explore more models","Explorar mais modelos"],["Append actor name to the translatable text","Adicionar nome do ator ao texto traduzível"],["Ignore translated rows","Ignorar linhas traduzidas"],["Templates","Modelos"],["<h2>1. System Message</h2>","<h2>1. Mensagem do Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aqui você pode explicar ao assistente qual é o papel dele.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Seu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este é o prompt real para o assistente.</p>"],["Enable Jailbreak","Habilitar Jailbreak"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário ao prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar inflar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Enable context","Habilitar contexto"],["Advanced","Avançado"],["Custom Parameters","Parâmetros Personalizados"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Você pode adicionar parâmetros personalizados ao corpo da solicitação da API de Chat da OpenAI. Isso é útil se você quiser adicionar parâmetros adicionais que não estão disponíveis no formulário."],["<h2>Warning</h2>","<h2>Aviso</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>Definir parâmetros personalizados incorretamente pode fazer com que a solicitação da API falhe. Certifique-se de saber o que está fazendo antes de adicionar parâmetros personalizados. Alguns serviços, como o OpenAI, são rigorosos sobre quais parâmetros você está enviando e retornarão erro HTTP para parâmetros de solicitação não reconhecidos.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>Se a mesma chave for usada várias vezes, apenas o último valor será utilizado.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>Se a mesma chave na configuração existente for usada, o parâmetro de configuração existente será substituído pelo parâmetro personalizado.</li>"],["String","String"],["Number","Número"],["Boolean","Booleano"],["JavaScript","JavaScript"],["Drop Parameters","Remover Parâmetros"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Custo de sobrecarga</h3>\n                        O custo de sobrecarga é o custo da mensagem de prompt que você envia ao assistente sem os textos de tradução reais. O custo é calculado com base no número de tokens na mensagem de prompt. Quanto mais tokens você tiver, maior será o custo.<br>\n                        <b>Custo estimado de sobrecarga:</b> <span class=\"overheadCost\">0</span> tokens / solicitação."],["Are you sure you want to reset the form?","Tem certeza de que deseja redefinir o formulário?"],["Translate with Batch API","Traduzir com API em Lote"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Tem certeza de que deseja processar o lote?\nCustos serão incorridos para esta operação."],["The batch is successfully created. Do you want to open the batch manager?","O lote foi criado com sucesso. Deseja abrir o gerenciador de lotes?"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","Tem certeza de que deseja importar a configuração das configurações do OpenAI? Isso substituirá a configuração atual."],["chatGPT engine is not found","Mecanismo chatGPT não encontrado"],["Configuration imported successfully.","Configuração importada com sucesso."],["Batch API Queue","Fila da API em Lote"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"relPath":"/addons/transLLMBatchApi/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":125,"length":125,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor, selecione as linhas para aplicar a tradução"],["Target Column","Coluna de Destino"],["The column to put the translation result.","A coluna para colocar o resultado da tradução."],["Import translation from ChatGPT Batch","Importar tradução do Lote do ChatGPT"],["Translation applied to selected rows","Tradução aplicada às linhas selecionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Incompatibilidade"],["Failed to load batch list with error: \n","Falha ao carregar a lista de lotes com erro: \n"],["Download Error File","Baixar Arquivo de Erro"],["Batch is not completed yet","Lote ainda não está concluído"],["Are you sure you want to cancel this batch?","Tem certeza de que deseja cancelar este lote?"],["Cannot cancel completed batch.","Não é possível cancelar um lote concluído."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Falha ao cancelar o lote"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar tradução"],["Cancel batch","Cancelar lote"],["Status","Status"],["Batch ID","ID do Lote"],["Input File ID","ID do Arquivo de Entrada"],["End point","Ponto Final"],["Created at","Criado em"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira em <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas a solicitações concluídas ficam disponíveis via arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas.\"></i>"],["Completed at","Concluído em"],["Errors","Erros"],["Batch Item Detail of","Detalhe do Item do Lote de"],["ID","ID"],["Completed on","Concluído em"],["Model","Modelo"],["Prompt Token","Token de Prompt"],["Completion Token","Token de Conclusão"],["Total Token","Token Total"],["Status Code","Código de Status"],["error","erro"],["Conversation","Conversa"],["Response Validation","Validação de Resposta"],["Raw Payload","Carga Bruta"],["View raw payload","Ver carga bruta"],["Response Preview","Prévia da Resposta"],["Apply translations from selected rows","Aplicar traduções das linhas selecionadas"],["Here you can edit the translation result individually and send it into Translator++","Aqui você pode editar o resultado da tradução individualmente e enviá-lo para o Translator++"],["Open ChatGPT Settings","Abrir Configurações do ChatGPT"],["Help","Ajuda"],["File list","Lista de Arquivos"],["Collapse / restore left panel","Recolher / restaurar painel esquerdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas a solicitações concluídas ficam disponíveis através do arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","Nome do Serviço"],["Service provider for your Batch API.","Provedor de serviço para sua API em Lote."],["API Key","Chave da API"],["Please enter your API key for the Batch API service.","Por favor, insira sua chave da API para o serviço Batch API."],["Model","Modelo"],["The pre-trained model","O modelo pré-treinado"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","No ChatGPT, você pode precisar definir o modelo permitido a ser usado (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable JailBreak","Ativar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Ativar Jailbreak para a tradução. Isso tornará a tradução mais precisa e menos tendenciosa. Alguns modelos podem tentar relacionar eventos fictícios a eventos da vida real, alterando a tradução para se adequar à sua própria narrativa. Esta opção impedirá isso."],["Jailbreak Template","Modelo de Jailbreak"],["Template of the Jailbreak message.","Modelo da mensagem de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","O número máximo de tokens a serem gerados na conclusão.<br>A contagem de tokens do seu prompt mais max_tokens não pode exceder o comprimento de contexto do modelo. A maioria dos modelos tem um comprimento de contexto de 2048 tokens (exceto os modelos mais recentes, que suportam 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qual temperatura de amostragem usar, entre 0 e 2. Valores mais altos, como 0.8, tornarão a saída mais aleatória, enquanto valores mais baixos, como 0.2, a tornarão mais focada e determinística. <br>A OpenAI geralmente recomenda alterar isso ou top_p, mas não ambos."],["Nucleus sampling (top_p)","Amostragem de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Uma alternativa à amostragem com temperatura, chamada amostragem de núcleo, onde o modelo considera os resultados dos tokens com a massa de probabilidade top_p. Assim, 0.1 significa que apenas os tokens que compõem os 10% superiores da massa de probabilidade são considerados. <br>A OpenAI geralmente recomenda alterar isso ou a temperatura, mas não ambos."],["Frequency Penalty","Penalidade de Frequência"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua frequência existente no texto até agora, diminuindo a probabilidade do modelo repetir a mesma linha literalmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalidade de Presença"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua aparição no texto até agora, aumentando a probabilidade do modelo falar sobre novos tópicos. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","Máximo de Caracteres por Lote"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","Limite máximo de caracteres por lote de tradução.\nEsta opção contará apenas o comprimento em caracteres do texto original, e não o comprimento da mensagem do prompt."],["Max row per concurrent requests","Máximo de linhas por solicitações concorrentes"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","Quantas linhas são permitidas para cada solicitação concorrente. Defina como <b>0</b> para desativar este recurso.<br />Se esta opção estiver desativada, não importa quantas <b>Solicitações concorrentes máximas</b> você definir, o Translator++ processará a solicitação como um único bloco.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","Quanto mais linhas você definir, mais tradução você pode obter em um único lote. Portanto, reduz o custo de sobrecarga e aumenta a chance de o IA retornar resultados com erro.<br />Quanto menor o número, menos provável que a tradução tenha erro, mas custará extra para prompts de sobrecarga."],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","Algoritmo de escape para código inline dentro de diálogos. Você pode precisar alterar o <b>Modelo de Mensagem do Sistema</b> e o <b>Modelo de Mensagem do Corpo</b> de acordo com o algoritmo de escape de sua escolha.<br />Quando você escolhe <b>JSONCloaking</b>, o parâmetro response_format: { type: 'json_object' } será enviado automaticamente ao ChatGPT. <b>JSONCloaking</b> é muito preciso, mas não funciona com todos os modelos, tente <b>gpt-3.5-turbo-1106</b>."],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","A <b>API em Lote</b> permite que você envie muitas solicitações de uma vez, que são processadas de forma assíncrona em segundo plano. Você não receberá resultados imediatamente, mas o processo <b>será concluído em até 24 horas</b>—e muitas vezes muito mais rápido. Este método <b>custa apenas metade do preço da abordagem padrão</b>."],["Batch API settings","Configurações da API em Lote"],["General","Geral"],["Explore more models","Explorar mais modelos"],["Templates","Modelos"],["Enable Jailbreak","Ativar Jailbreak"],["Advanced","Avançado"],["Batch Translation Setting","Configuração de Tradução em Lote"],["Default","Padrão"],["JavaScript template cloaking","Cloaking de modelo JavaScript"],["None (no escaping)","Nenhum (sem escape)"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":false,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"relPath":"/addons/transLLMBatchApi/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":39,"length":39,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ATOR : Glossário de informações do ator. (Somente se a opção de informações do ator estiver ativada no modo lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gere referência a partir do objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separe o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não poluídos com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Acrescente o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>INFORMAÇÃO_ATOR</code> no modelo de prompt para colocar os dados de informação do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Arquivo separado sempre para cada lote"],["Append actor name to the translatable text","Acrescentar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar sobrecarregar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transLLMBatchApi/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","Abrir Gerenciador de Lotes"],["This feature is only available if you have a project open.","Este recurso está disponível apenas se você tiver um projeto aberto."]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":false,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transLLMBatchApi/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","URL do proxy LiteLLM. O endereço URL do seu proxy LiteLLM. O padrão é: <code>http://localhost:8890/chat/completions</code>"],["API's base URL","URL base da API"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","A URL base do seu serviço selecionado. Preencha este campo apenas se estiver usando uma URL de endpoint personalizada. O LiteLLM detectará automaticamente a URL base com base no modelo fornecido.<br />A forma como o LiteLLM adiciona o caminho à URL depende do serviço. Por exemplo, para endpoints compatíveis com OpenAI, o LiteLLM anexará <code>/chat/completions</code> à URL fornecida. Portanto, se seu endpoint for <code>https://api.fast-tunnel.one/v1/chat/completions</code>, preencha o campo com <code>https://api.fast-tunnel.one/v1</code>."],["API Version","Versão da API"],["Optional. The API version parameter needed for some services.","Opcional. O parâmetro de versão da API necessário para alguns serviços."],["API Key","Chave da API"],["Optional. The API key used for authenticating your access to the service.","Opcional. A chave da API usada para autenticar seu acesso ao serviço."],["Model","Modelo"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","Pré-treine o modelo de sua escolha. Utilize o formato de conveniência de modelo LiteLLM para especificar seu modelo preferido. O formato é {nome do serviço}/{modelo}. Por exemplo:"],["your deployment name","seu nome de implantação"],["However, some models have unique names that can be directly identified, like:","No entanto, alguns modelos têm nomes únicos que podem ser identificados diretamente, como:"],["Azure AD Token","Token do Azure AD"],["AWS Access Key ID","ID da Chave de Acesso da AWS"],["AWS secret access key","Chave de acesso secreta da AWS"],["Open router site URL","URL do site do Open Router"],["Open router APP name","Nome do APP do Open Router"],["Enable Context","Habilitar Contexto"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","Habilite o contexto para a tradução. O material previamente traduzido acima do lote atual será incluído como contexto. <b>Você também precisa incluir explicitamente o CONTEXTO no modelo</b>"],["Context Character Limit","Limite de Caracteres do Contexto"],["Character limit for the context.","Limite de caracteres para o contexto."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que dirá qual é o papel do seu assistente chatGPT. Esta mensagem será enviada como a primeira mensagem de cada lote que você enviar ao chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis com o estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensagens no lote.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : Glossário de informações de atores. (Somente se a opção de informações de atores estiver ativada no modo de lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nome do objeto] : Gerar referência do objeto do Translator++. <br />Exemplo : <code>REFERENCE[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["User message","Mensagem do usuário"],["Assistant's response","Resposta do assistente"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your message.","Modelo do corpo da sua mensagem."],["Enable JailBreak","Ativar JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","Ativar Jailbreak para a tradução. Isso tornará a tradução mais precisa e menos tendenciosa. Alguns modelos podem querer relacionar eventos fictícios a eventos da vida real, tentando alterar a tradução para se adequar à sua própria narrativa. Esta opção impedirá isso."],["Jailbreak Template","Modelo de Jailbreak"],["Template of the Jailbreak message.","Modelo da mensagem de Jailbreak."],["Maximum Tokens","Tokens Máximos"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","O número máximo de tokens a serem gerados na conclusão.<br>A contagem de tokens do seu prompt mais max_tokens não pode exceder o comprimento de contexto do modelo. A maioria dos modelos tem um comprimento de contexto de 2048 tokens (exceto os modelos mais novos, que suportam 4096)."],["Temperature","Temperatura"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","Qual temperatura de amostragem usar, entre 0 e 2. Valores mais altos como 0,8 tornarão a saída mais aleatória, enquanto valores mais baixos como 0,2 a tornarão mais focada e determinística. <br>A OpenAI geralmente recomenda alterar isso ou top_p, mas não ambos."],["Nucleus sampling (top_p)","Amostragem de núcleo (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","Uma alternativa à amostragem com temperatura, chamada amostragem de núcleo, onde o modelo considera os resultados dos tokens com massa de probabilidade top_p. Assim, 0,1 significa que apenas os tokens que compõem os 10% superiores de massa de probabilidade são considerados. <br>A OpenAI geralmente recomenda alterar isso ou a temperatura, mas não ambos."],["Frequency Penalty","Penalidade de Frequência"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em sua frequência existente no texto até agora, diminuindo a probabilidade do modelo repetir a mesma linha literalmente. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","Penalidade de Presença"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","Número entre -2,0 e 2,0. Valores positivos penalizam novos tokens com base em se eles aparecem no texto até agora, aumentando a probabilidade do modelo falar sobre novos tópicos. <br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","Usar Esquema JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","Use <code>json_schema</code> para o campo <code>response_format.type</code> em vez do antigo <code>json_object</code>. O <code>json_schema</code> é exigido por alguns dos modelos mais recentes e alguns servidores como <b>LM Studio</b>, mas alguns modelos antigos ainda usam <code>json_object</code>."],["Stop","Parar"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","Insira uma palavra-chave onde a API parará de gerar mais tokens. Separe cada entrada com uma nova linha."],["Additional argument variables","Variáveis de argumentos adicionais"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","Variáveis de argumentos adicionais que seriam anexadas ao iniciar o servidor.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","Tempo Limite do Lote"],["Timeout for each batch in milisecond","Tempo limite para cada lote em milissegundos"],["Max Request Length","Comprimento Máximo da Solicitação"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","O comprimento máximo de caracteres para cada lote de tradução.\nCada tradutor tem especificações diferentes.\nRecomendo menos de 2000 para tradutores de front-end WEB que usam parâmetro GET."],["Max concurrent requests","Máximo de solicitações simultâneas"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","Quantas solicitações simultâneas são permitidas para serem conectadas ao mesmo tempo. Defina como <b>0</b> para desativar este recurso.<br />Combine esta opção com <b>Máximo de linhas por solicitação simultânea</b> para aumentar a velocidade da tradução."],["Max row per concurrent requests","Máximo de linhas por solicitações simultâneas"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","Quantas linhas são permitidas para cada solicitação simultânea. Defina como <b>0</b> para desativar este recurso.<br />Se esta opção estiver desativada, não importa quantos <b>Máximo de solicitações simultâneas</b> você definir, o Translator++ processará a solicitação como um único bloco."],["Batch delay","Atraso do lote"],["Delay between batch (in miliseconds)","Atraso entre lotes (em milissegundos)"],["Code Escaping Algorithm","Algoritmo de Escape de Código"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","Algoritmo de escape para código inline dentro dos diálogos. Você pode precisar alterar o <b>Modelo de Mensagem do Sistema</b> e <b>Modelo de Mensagem do Corpo</b> de acordo com o algoritmo de escape escolhido."],["Number of retry","Número de tentativas"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","Quantas vezes o mecanismo deve tentar novamente quando a validação da saída da tradução falhar. Se nulo (vazio), então sem tentativas."],["Retry when the number of translated rows doesn't match original","Tentar novamente quando o número de linhas traduzidas não corresponder ao original"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","Se habilitado, o mecanismo tentará novamente quando o modelo retornar um número diferente de linhas de tradução em comparação com o payload original."],["Retry when the number of lines for each translated row doesn't match original","Tentar novamente quando o número de linhas para cada linha traduzida não corresponder ao original"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","Se habilitado, o mecanismo tentará novamente quando qualquer linha traduzida tiver um número diferente de linhas do que sua linha original."],["Prompt: Row count mismatch","Prompt: Incompatibilidade de contagem de linhas"],["Prompt used when retrying due to row/element count mismatch.","Prompt usado ao tentar novamente devido a incompatibilidade na contagem de linhas/elementos."],["Prompt: Line count mismatch","Prompt: Incompatibilidade de contagem de linhas por linha"],["Prompt used when retrying due to per-row line count mismatch.","Prompt usado ao tentar novamente devido a incompatibilidade na contagem de linhas por linha."],["Prompt: Error / Retry instruction","Prompt: Erro / Instrução de tentativa"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","Prompt anexado após o(s) prompt(s) de incompatibilidade para instruir o modelo a tentar novamente."],["Custom Parameter","Parâmetro Personalizado"],["Key","Chave"],["Value","Valor"],["Type","Tipo"],["Type of the value.","Tipo do valor."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","Para o tipo <b>javascript</b>, o valor será avaliado como código JavaScript."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","O escopo do código JavaScript é <code>window</code>. Portanto, você pode acessar praticamente qualquer valor."],["<br />Example: <code>trans.project.title</code>","<br />Exemplo: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","Remova parâmetros que não serão enviados à API.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","A API da OpenAI está em constante mudança; alguns novos modelos podem não suportar os parâmetros antigos e retornarão erro HTTP para parâmetros de solicitação não reconhecidos."],["You can drop the parameters that are not supported by the model here.","Você pode remover os parâmetros não suportados pelo modelo aqui."],["Manage configuration","Gerenciar configuração"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","Algumas funcionalidades deste mecanismo exigem que o complemento ChatGPT esteja instalado. Certifique-se de ter instalado o complemento ChatGPT antes de usar este mecanismo."],["Text Completion Setting","Configuração de Conclusão de Texto"],["General","Geral"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Não desperdice seu dinheiro em Modelos de Raciocínio</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Estudos diversos comprovaram que os modelos de raciocínio são muito piores do que os modelos normais em tarefas de escrita criativa e tradução.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Você não ganha nada além de custos mais caros e tempos de resposta mais lentos ao usar modelos de raciocínio.</p>"],["Platform specific","Específico da plataforma"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","Modelos"],["Enable context","Ativar contexto"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever uma amostra de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Retry prompts","Repetir prompts"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>Esses prompts são anexados como mensagens extras do <b>usuário</b> durante as repetições, logo após a saída anterior do modelo.</p>"],["<p>Available variables:</p>","<p>Variáveis disponíveis:</p>"],["Enable Jailbreak","Ativar Jailbreak"],["Advanced","Avançado"],["Custom Parameters","Parâmetros Personalizados"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","Você pode adicionar parâmetros personalizados ao corpo da solicitação da API OpenAI Chat. Isso é útil se você quiser adicionar parâmetros adicionais que não estão disponíveis no formulário."],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>Aviso</h2><ul><li>Definir parâmetros personalizados incorretamente pode fazer com que a solicitação da API falhe. Certifique-se de saber o que está fazendo antes de adicionar parâmetros personalizados. Alguns serviços, como o OpenAI, são rigorosos sobre quais parâmetros você está enviando e retornarão erro HTTP para parâmetros de solicitação não reconhecidos.</li><li>Se a mesma chave for usada várias vezes, apenas o último valor será usado.</li><li>Se a mesma chave na configuração existente for usada, então o parâmetro de configuração existente será substituído pelo parâmetro personalizado.</li></ul>"],["Drop Parameters","Remover Parâmetros"],["LiteLLM Proxy Configuration","Configuração do Proxy LiteLLM"],["Start LiteLLM server","Iniciar servidor LiteLLM"],["Processing...","Processando..."],["Server started on port ","Servidor iniciado na porta "],["Check LiteLLM Status","Verificar Status do LiteLLM"],["Change LiteLLM Version","Alterar Versão do LiteLLM"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","Digite a nova versão do LiteLLM que deseja instalar.\nVersões conhecidas funcionais: 1.38.0, 1.49.4 \nA versão sugerida é: "],["Are you sure you want to install LiteLLM version ","Tem certeza de que deseja instalar a versão "],["Failed to install LiteLLM. Please check the console for more details.","Falha ao instalar o LiteLLM. Verifique o console para mais detalhes."],["LiteLLM has been successfully updated to version ","LiteLLM foi atualizado com sucesso para a versão "],["Batch Translation Setting","Configuração de Tradução em Lote"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","Desculpe, este addon está disponível apenas para patronos ativos.\nVocê pode desbloquear este recurso tornando-se um patrono de $1."],["Retries and Refinement","Tentativas e Refinamento"],["<h2>Retries and Refinement</h2>","<h2>Tentativas e Refinamento</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>Quando a saída da tradução falha na validação, o Translator++ pode pedir ao modelo para tentar novamente a tradução. Você pode definir quantas vezes o modelo deve tentar e também definir a condição para a nova tentativa.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>Definir um número razoável de tentativas com condições adequadas pode melhorar significativamente a qualidade da tradução, mantendo o custo e o tempo sob controle.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>Cada tentativa custa tempo e dinheiro adicionais</b>. Se seu lote acabar tentando frequentemente, você pode querer ajustar seu prompt para tornar as instruções mais claras para o modelo.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>Use a ferramenta de desenvolvedor ou o Gerenciador de Lotes para depurar sua tradução em lote.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>Algoritmo de Escape de Código</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>O escape de código é uma técnica para evitar que o MTL altere os trechos de código dentro dos diálogos. Isso é útil quando seus diálogos contêm trechos de código, como tags HTML, tags XML, objetos JSON ou modelos JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>Escolha o algoritmo de escape que corresponde aos trechos de código dentro de seus diálogos. Você pode precisar ajustar os modelos de <b>mensagem do sistema</b>, <b>Prompt de amostra</b> e <b>mensagem do corpo</b> de acordo.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>Clique <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>aqui</a> para ler mais sobre algoritmos de escape de código e como usá-los efetivamente.</p>"],["JavaScript template cloaking","Ocultação de modelo JavaScript"],["None (no escaping)","Nenhum (sem escape)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","Deseja carregar a predefinição de diálogo de amostra para o algoritmo de escape selecionado? Isso substituirá sua amostra de diálogo existente."],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separe o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Anexe o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ removerá então o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>ACTOR_INFO</code> no modelo de prompt para colocar os dados de informação do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informação do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Sempre separar arquivo para cada lote"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar inflar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":false,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"relPath":"/addons/transLitellm/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":166,"length":166,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","Traduzir com OpenAI Batch API"],["Model","Modelo"],["The pre-trained model.","O modelo pré-treinado."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","Parece que a OpenAI Batch API usa uma convenção de nomenclatura de modelos ligeiramente diferente da API geralmente usada. Os modelos usados na Batch API têm um prefixo \"-batch\". Por exemplo, se você usar <code>gpt-4.1-mini</code>, o modelo automaticamente se torna <code>gpt-4.1-mini-batch</code>.<br />\nNo entanto, no momento em que este add-on foi criado, os modelos de lote não estão listados nos limites de uso de modelos da OpenAI, o que impossibilita os usuários de usar a Batch API se eles configuraram o filtro de uso de modelo como \"Permitir\" (lista branca).<br />\nIsso provavelmente é um bug na interface da OpenAI que pode ser corrigido no futuro.<br />\nPortanto, certifique-se de definir os limites de uso na OpenAI para o modo \"Bloquear\" (lista negra) para usar a Batch API.<br />\nClique aqui para alterar os limites de uso do modelo: https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","Coluna de Origem"],["The column of the original texts you want to translate.","A coluna dos textos originais que você deseja traduzir."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Acrescentar o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ então removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Ignore if already translated","Ignorar se já traduzido"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","Se esta opção estiver marcada, o Translator++ ignorará qualquer linha que já tenha traduções em sua coluna."],["Load Actor Reference as Glossary","Carregar Referência do Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém as informações adicionais do ator. Você pode colocar mais informações, como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["System Message Template","Modelo de Mensagem do Sistema"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","A mensagem do sistema é o cabeçalho da mensagem que informará qual é a função do seu assistente ChatGPT. Esta mensagem será enviada como a primeira de cada lote que você enviar ao ChatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","Você pode incluir as seguintes variáveis no estilo de Template Literal do JavaScript <span class='inlineCode'><b>${</b>VARIÁVEL<b>}</b></span><br>"],["Variables:<br>","Variáveis:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : Idioma de origem</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : Idioma de destino</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : Nome completo do idioma de origem</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : Nome completo do idioma de destino</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : Texto de origem</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : Mensagem predefinida do algoritmo de escape.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : String que representa nova linha (substituto de linha).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : Número de mensagens no lote.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : Adiciona informações dos atores.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : Engine do jogo</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[nome do objeto] : Gera referência a partir de um objeto do Translator++. <br />Exemplo : <code>REFERENCE[Referência Comum]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : Inclui algumas linhas anteriores como contexto</li>"],["Body Message Template","Modelo de Mensagem do Corpo"],["Template of the body of your chat.","Modelo do corpo do seu chat."],["Sample conversation","Exemplo de conversa"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","A API Batch da OpenAI permite traduzir seu projeto de forma assíncrona com custos 50% mais baixos, o que significa que você receberá os resultados da sua tradução <b style=\"color:red\">dentro de 24 horas</b> a <b style=\"color:blue\">metade do custo normal</b>. Isso é particularmente útil para projetos grandes que não exigem resultados de tradução imediatos."],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>."," <br />Leia mais sobre a API de Lote da OpenAI <a href=\"https://platform.openai.com/docs/guides/batch\" external>aqui</a>."],["General Settings","Configurações Gerais"],["This form is using your OpenAI Batch API configuration.<br>","Este formulário está usando sua configuração da API de Lote da OpenAI.<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","Você pode alterar a configuração indo para as configurações do add-on <b>API de Lote da OpenAI</b> na janela de opções.<br>"],["There you can set the API key, model, and other settings.<br />","Lá você pode definir a chave da API, o modelo e outras configurações.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Sua Chave da API OpenAI\"}});' value=\"Abrir configurações do ChatGPT\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>Não desperdice seu dinheiro com Modelos de Raciocínio</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>Foi comprovado por vários estudos que os modelos de raciocínio são muito piores do que os modelos normais na execução de tarefas de escrita criativa e tradução.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>Você não ganha nada além de custo mais caro e tempos de resposta mais lentos ao usar modelos de raciocínio.</p>"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Ignore translated rows","Ignorar linhas traduzidas"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar sobrecarregar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt Template","Modelo de Prompt"],["<h2>1. System Message</h2>","<h2>1. Mensagem do Sistema</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>Aqui você pode explicar ao assistente qual é o papel dele.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de respostas boas ou ruins para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. Seu prompt real</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>Este é o prompt real para o assistente.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>Custo indireto</h3>\n                        O custo indireto é o custo da mensagem de prompt que você envia ao assistente sem os textos de tradução reais. O custo é calculado com base no número de tokens na mensagem de prompt. Quanto mais tokens você tiver, maior será o custo.<br>\n                        <b>Custo indireto estimado:</b> <span class=\"overheadCost\">0</span> tokens / solicitação."],["Are you sure you want to reset the form?","Tem certeza de que deseja redefinir o formulário?"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","Tem certeza de que deseja processar o lote?\nO custo será incorrido para esta operação."],["The batch is successfully created. Do you want to open the batch manager?","O lote foi criado com sucesso. Deseja abrir o gerenciador de lotes?"],["OpenAI Batch API Queue","Fila da API de Lote OpenAI"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"relPath":"/addons/transOpenAIBatch/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":65,"length":65,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","Por favor, selecione as linhas para aplicar a tradução"],["Target Column","Coluna de Destino"],["The column to put the translation result.","A coluna para colocar o resultado da tradução."],["Import translation from ChatGPT Batch","Importar tradução do ChatGPT em Lote"],["Translation applied to selected rows","Tradução aplicada às linhas selecionadas"],["Invalid format","Formato inválido"],["OK","OK"],["Mismatch","Incompatibilidade"],["Failed to load batch list with error: \n","Falha ao carregar a lista de lotes com erro: \n"],["Download Error File","Baixar Arquivo de Erro"],["Batch is not completed yet","O lote ainda não foi concluído"],["Are you sure you want to cancel this batch?","Tem certeza de que deseja cancelar este lote?"],["Cannot cancel completed batch.","Não é possível cancelar um lote concluído."],["Batch cancelled","Lote cancelado"],["Failed to cancel batch","Falha ao cancelar o lote"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","Lotes"],["Apply translation","Aplicar tradução"],["Cancel batch","Cancelar lote"],["Status","Status"],["Batch ID","ID do Lote"],["Input File ID","ID do Arquivo de Entrada"],["End point","Ponto final"],["Created at","Criado em"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","Expira em <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas a solicitações concluídas ficam disponíveis através do arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas.\"></i>"],["Completed at","Concluído em"],["Errors","Erros"],["Batch Item Detail of","Detalhe do Item do Lote de"],["ID","ID"],["Completed on","Concluído em"],["Model","Modelo"],["Prompt Token","Token de Prompt"],["Completion Token","Token de Conclusão"],["Total Token","Token Total"],["Status Code","Código de Status"],["error","erro"],["Conversation","Conversação"],["Response Validation","Validação de Resposta"],["Raw Payload","Carga Bruta"],["View raw payload","Ver carga bruta"],["Response Preview","Prévia da Resposta"],["Apply translations from selected rows","Aplicar traduções das linhas selecionadas"],["Here you can edit the translation result individually and send it into Translator++","Aqui você pode editar o resultado da tradução individualmente e enviá-lo para o Translator++"],["Open ChatGPT Settings","Abrir Configurações do ChatGPT"],["Help","Ajuda"],["File list","Lista de arquivos"],["Collapse / restore left panel","Recolher / restaurar painel esquerdo"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","Lotes que não são concluídos a tempo eventualmente passam para um estado expirado; solicitações não finalizadas dentro desse lote são canceladas, e quaisquer respostas para solicitações concluídas ficam disponíveis através do arquivo de saída do lote. Você será cobrado pelos tokens consumidos de quaisquer solicitações concluídas."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TÍTULO : Título do jogo</li>"],["<li>ENGINE : Engine of the game</li>","<li>MOTOR : Motor do jogo</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>INFO_ATOR : Glossário de informações do ator. (Somente se a opção de informações do ator estiver ativada no modo de lote)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERÊNCIA[nome do objeto] : Gerar referência do objeto do Translator++. <br />Exemplo : <code>REFERÊNCIA[Referência Comum]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXTO : Contexto da tradução anterior (se o contexto estiver ativado)</li>"],["Sample conversation","Conversa de exemplo"],["<h2>Sample dialogue</h2>","<h2>Diálogo de exemplo</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>Diálogo existente de exemplo. Você pode escrever um exemplo de boas ou más respostas para ajudar o tradutor a entender seu objetivo e o contexto da conversa.</p>"],["Always separate file","Sempre separar arquivo"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","Sempre separe o arquivo para cada lote. Isso pode manter os contextos de cada arquivo não contaminados com outros arquivos."],["Add actor name","Adicionar nome do ator"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","Acrescente o nome do ator das informações da linha ao texto traduzível. Isso ajudará os tradutores a acompanhar o diálogo e os pronomes. O Translator++ removerá o nome do ator do resultado da tradução. Isso obviamente aumentará o custo da tradução."],["Load Actor Reference as Glossary","Carregar Referência de Ator como Glossário"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","Se marcado, o Translator++ carregará a referência do ator como glossário. Isso ajudará o tradutor a entender o contexto da conversa. A referência do ator é o nome do ator no diálogo. Isso será carregado como um glossário para o tradutor. Isso aumentará o custo da tradução."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","Apenas os personagens que existem na conversa serão carregados como glossário para cada item do lote. Use o comando de modelo para carregar a referência do ator na mensagem de prompt."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️Se você habilitar esta opção, também precisa incluir a variável <code>ACTOR_INFO</code> no modelo de prompt para colocar os dados de informação do personagem."],["Actor Reference Translation Column","Coluna de Tradução da Referência do Ator"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","A coluna da tradução do nome do ator. Esta coluna será usada como a tradução da referência do ator. Isso melhorará a consistência da tradução do nome do ator na conversa."],["Actor's Information Column","Coluna de Informações do Ator"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","A coluna que contém informações adicionais do ator. Você pode colocar mais informações como gênero, idade, etc. Isso melhorará a tradução dos pronomes na conversa."],["Extra Prompt","Prompt Extra"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","Prompt extra que será adicionado à mensagem de prompt. Isso será adicionado após a mensagem do sistema e antes da mensagem de prompt real."],["General Settings","Configurações Gerais"],["Always separate file for each batch","Sempre separar arquivo para cada lote"],["Append actor name to the translatable text","Anexar nome do ator ao texto traduzível"],["Glossary","Glossário"],["<h2>Glossary</h2>","<h2>Glossário</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>Este recurso ajudará você a adicionar automaticamente um glossário no prompt. O glossário será carregado para cada lote de itens para melhorar a qualidade da tradução. O recurso tentará carregar apenas os termos relevantes para evitar inflar seu prompt.</p>"],["The Column of Actor's Additional Information","A Coluna de Informações Adicionais do Ator"],["Prompt","Prompt"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transOpenAIBatch/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","Gerenciador de Lotes"],["This feature is only available if you have a project open.","Este recurso está disponível apenas se você tiver um projeto aberto."]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":false,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"relPath":"/addons/transOpenAIBatch/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","Iniciar servidor"],["Server started","Servidor iniciado"],["Reinstall server","Reinstalar servidor"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","Insira a nova versão da biblioteca de Tradutores que deseja instalar.\nA versão mais recente é: "],["Are you sure you want to install Translators version ","Tem certeza de que deseja instalar a versão "],["Failed to install Translators. Please check the console for more details.","Falha ao instalar Tradutores. Por favor, verifique o console para mais detalhes."],["Translators has been successfully updated to version ","Tradutores foi atualizado com sucesso para a versão "],["General Settings","Configurações Gerais"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":false,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"relPath":"/addons/transPyTranslators/pyTranslators.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","Tem certeza de que deseja abortar?"],["Process paused!\nPress OK to continue!","Processo pausado!\nPressione OK para continuar!"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":false,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"relPath":"/addons/transRedBatch/transredbatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","Nunca descarregar dicionários da RAM"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":false,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"relPath":"/addons/transRikaikun/transRikaikun.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","Não é possível iniciar o Proxy de Tradução!\nO Proxy de Tradução está atualmente disponível apenas para patronos de $3 ou mais."],["Please enter the port number:","Por favor, insira o número da porta:"],["Invalid port : ","Porta inválida: "],["Port must be a numeric.","A porta deve ser numérica."],["Port has successfully changed to: ","A porta foi alterada com sucesso para: "],["Connection Info","Informações de Conexão"],["Do you want to copy the base URL into the clipboard?","Deseja copiar a URL base para a área de transferência?"],["Use secure protocol(HTTPS)","Usar protocolo seguro (HTTPS)"],["Port","Porta"],["Connection info","Informações de conexão"],["Help","Ajuda"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":false,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"relPath":"/addons/translationProxy/translationProxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","Forçará a codificação de texto para a selecionada ao escrever os scripts. (em branco = automático)<br />. Você pode usar este campo para converter o script em <b>UTF-16</b> para que o jogo seja jogável sem alterar seu local para japonês."],["Use legacy parser","Usar analisador legado"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","Usar analisador legado (antigo) em vez do novo.<br />O analisador legado é mais rápido, mas não confiável em alguns jogos.<br />O novo analisador é mais confiável, mas mais lento."],["Select TyranoBuilder packaged game","Selecionar jogo empacotado TyranoBuilder"],["Select the exe file of your packaged game.","Selecione o arquivo exe do seu jogo empacotado."],["Target folder","Pasta de destino"],["Select destination folder. The process will replace the existing files.","Selecione a pasta de destino. O processo substituirá os arquivos existentes."],["Extraction completed","Extração concluída"],["Close","Fechar"],["Next","Próximo"],["Please select game executable file","Por favor, selecione o arquivo executável do jogo"],["Back","Voltar"],["The game is fully loaded, proceed!","O jogo está totalmente carregado, prossiga!"],["Extract data","Extrair dados"],["Open extracted folder","Abrir pasta extraída"],["Extract resources","Extrair recursos"],["Select the game executable","Selecione o executável do jogo"],["Select the game executable or asar file to extract","Selecione o executável do jogo ou arquivo asar para extrair"],["Target directory","Diretório de destino"],["Select the target directory to store the unpacked files","Selecione o diretório de destino para armazenar os arquivos descompactados"],["Electron archive file detected. Do you want to extract the asar file instead?","Arquivo de arquivo Electron detectado. Deseja extrair o arquivo asar em vez disso?"],["Tyranobuilder Game Extractor","Extrator de Jogo Tyranobuilder"],["Before you create a new project, please make sure that :","Antes de criar um novo projeto, certifique-se de que:"],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","O add-on <b>Kirikiri Adventure Game parser</b> está instalado no seu Translator++"],["Your game is fully extracted.","Seu jogo está totalmente extraído."],["Extract TyranoBuilder package","Extrair pacote TyranoBuilder"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","Todos os arquivos .ks e .tjs estão em texto simples (não compilados, não embaralhados e não criptografados)"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","Algumas ações modificarão seu jogo. <b>Portanto, certifique-se de criar um backup do seu jogo!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","Selecione o arquivo executável do jogo. Este é o arquivo principal do jogo que será usado para extrair os dados do jogo."],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","Em jogos Tyrano, geralmente é o arquivo <b>index.html</b> ou <b>exe</b>."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","Lista das possíveis codificações de caracteres. <b>A ordem importa!</b>. Você pode arrastar para ordenar a lista."],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","Jogo criado com TyranoBuilder está na codificação <b>UTF-8</b>"],["Literal tags are the tags that will be escaped into Translator++ editor.","As tags literais são as tags que serão escapadas no editor do Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> são obrigatórios."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> As tags serão interpoladas pelo Translator++ em uma nova linha. Portanto, você não precisa escrever <b>[r]</b> explicitamente."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","O script Kirikiri (.ks) é altamente personalizável e permite que os desenvolvedores criem suas próprias tags."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","O Translator++ pode lidar com tags padrão, como nomes de personagens que começam com um sustenido (#)."],["However, Translator++ may not be able to handle custom tags created by developers.","No entanto, o Translator++ pode não ser capaz de lidar com tags personalizadas criadas por desenvolvedores."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","Portanto, você pode precisar definir as tags e atributos que precisam ser traduzidos e aqueles que precisam ser marcados como nomes de atores."],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>Por favor, visite a <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">referência de tags do TyranoBuilder</a> para mais informações sobre as tags.</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","Você pode precisar <input type=\"button\" value=\"extrair seu jogo\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> e analisar o script <b>ks</b> dentro dele antes de iniciar o projeto."],["Create Project","Criar Projeto"],["Play last build","Reproduzir última compilação"],["Extract TyranoBuilder","Extrair TyranoBuilder"],["Create playable package","Criar pacote jogável"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":false,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"relPath":"/addons/tyranoTrans/tyranoTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":45,"length":45,"percent":100},"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","Geral"],["Executable file location","Localização do arquivo executável"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tCaminho para o arquivo executável do aplicativo.\n\t\t\t"],["Field can not be empty!","O campo não pode estar vazio!"],["Service","Serviço"],["End Point","Ponto Final"],["Auto translation service to use.","Serviço de tradução automática a ser usado."],["Target Language","Idioma de Destino"],["The language to translate into","O idioma para o qual traduzir"],["Source Language","Idioma de Origem"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","O idioma original do jogo. \"auto\" também é suportado para alguns endpoints, mas geralmente não é recomendado"],["Files","Arquivos"],["Directory","Diretório"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","Diretório para procurar arquivos de tradução em cache. Pode usar placeholders: {GameExeName}, {Lang}"],["Output File","Arquivo de Saída"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","Arquivo para inserir traduções geradas. Pode usar placeholders: {GameExeName}, {Lang}"],["Substitution File","Arquivo de Substituição"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","Arquivo que contém substituições aplicadas antes das traduções. Pode usar placeholders: {GameExeName}, {Lang}"],["Preprocessors File","Arquivo de Pré-processadores"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","Arquivo que contém pré-processadores a serem aplicados antes de enviar um texto para um tradutor. Pode usar placeholders: {GameExeName}, {Lang}"],["Text Frameworks","Estruturas de Texto"],["Enable/Disable auto translation for Unity's text frameworks.","Ativar/Desativar tradução automática para as estruturas de texto do Unity."],["Behaviour","Comportamento"],["Max Characters Per Translation","Máximo de Caracteres por Tradução"],["Max characters per text to translate. Max 2500.","Máximo de caracteres por texto a traduzir. Máximo 2500."],["Whether or not to ignore whitespace, including newlines, in dialogue keys","Se deve ignorar espaços em branco, incluindo novas linhas, nas chaves de diálogo"],["Whether or not to ignore whitespace, including newlines, in NGUI","Se deve ignorar espaços em branco, incluindo novas linhas, no NGUI"],["Minimum Dialogue Chars","Caracteres Mínimos de Diálogo"],["The length of the text for it to be considered a dialogue","O comprimento do texto para que seja considerado um diálogo"],["Force Split Text After Characters","Forçar Divisão de Texto Após Caracteres"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","Dividir texto em múltiplas linhas uma vez que o texto traduzido exceda este número de caracteres. (0 significa sem divisão)"],["Whether or not to copy hooked texts to clipboard","Se deve ou não copiar textos capturados para a área de transferência"],["MaxClipboardCopyCharacters","Máximo de Caracteres para Copiar na Área de Transferência"],["Max number of characters to hook to clipboard at a time","Número máximo de caracteres para capturar na área de transferência de uma vez"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","Se o plugin deve ou não fornecer uma \"melhor tentativa\" de redimensionar componentes de UI após a tradução"],["Indicates whether batching of translations should be enabled for supported endpoints","Indica se o agrupamento de traduções deve ser ativado para endpoints suportados"],["Indicates whether or not to use translations from the included static translation cache","Indica se deve ou não usar traduções do cache de tradução estática incluído"],["Override Font","Substituir Fonte"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","Substitui as fontes usadas para textos ao atualizar componentes de texto. NOTA: Funciona apenas para UGUI"],["Override Font TextMeshPro","Substituir Fonte TextMeshPro"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","Substitui as fontes usadas para textos ao atualizar componentes de texto. NOTA: Funciona apenas para TextMeshPro"],["Resize UI Line Spacing Scale","Redimensionar Escala de Espaçamento de Linha da UI"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","Um valor decimal pelo qual o espaçamento de linha padrão deve ser escalado durante o redimensionamento da UI, por exemplo: 0.80. NOTA: Funciona apenas para UGUI"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","Indica se o comportamento de redimensionamento da UI deve ser aplicado a todos os componentes de UI, independentemente de serem traduzidos."],["Ignore Text Starting With","Ignorar Texto Que Começa Com"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","Indica que o plugin deve ignorar quaisquer strings que comecem com certos caracteres. Esta é uma lista separada por ';'."],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","Indica se deve ou não ativar o \"Modo de Compatibilidade do Obtentor de Texto\". Deve ser ativado apenas se necessário para o jogo."],["GameLog Text Paths","Caminhos de Texto do GameLog"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","Indica caminhos específicos para objetos do jogo que o jogo usa como \"componentes de log\", onde ele adiciona ou insere texto continuamente. Requer conhecimento especializado para configurar. Esta é uma lista separada por ';'."],["Romaji Post Processing","Pós-processamento de Romaji"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","Indica que tipo de pós-processamento fazer em textos 'traduzidos' de romaji. Isso pode ser importante em certos jogos porque a fonte usada não suporta adequadamente vários diacríticos. Esta é uma lista separada por ';'. Valores possíveis: [\"RemoverTodosDiacríticos\", \"SubstituirMacronPorCircunflexo\", \"RemoverApostrofos\"]"],["Translation Post Processing","Pós-processamento de Tradução"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","Indica que tipo de pós-processamento fazer em textos traduzidos (não romaji). Valores possíveis: [\"RemoverTodosDiacríticos\", \"SubstituirMacronPorCircunflexo\", \"RemoverApostrofos\", \"SubstituirCaracteresLargos\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","Indica se os resultados de pesquisas regex devem ser enviados para o OutputFile especificado."],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","Indica se diferenças de espaços em branco devem ser enviadas para o OutputFile especificado."],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","Indica se o resultado completo de traduções divididas por regex deve ser enviado para o OutputFile especificado."],["Indicates that the plugin should generate translations without variables when using substitutions.","Indica que o plugin deve gerar traduções sem variáveis ao usar substituições."],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","Indica que o plugin deve gerar traduções parciais para suportar traduções de texto conforme ele \"rola para dentro\"."],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","Indica que o plugin deve analisar diretivas 'TARC' e escopear traduções com base nelas."],["Indicates the plugin should not print out success messages in relation to translations.","Indica que o plugin não deve imprimir mensagens de sucesso relacionadas a traduções."],["Blacklisted IMGUI Plugins","Plugins IMGUI na Lista Negra"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","Se uma janela IMGUI assembly/classe/método contiver qualquer uma das strings nesta lista (sem distinção entre maiúsculas e minúsculas), essa UI não será traduzida. Requer ganchos MonoMod. Esta é uma lista separada por ';'."],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","Indica se textos considerados pelo plugin como intraduzíveis devem ser enviados para o OutputFile especificado."],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","Indica que as regras para chamadas de método virtual devem ser ignoradas ao tentar definir o texto de um componente de texto. Pode em alguns casos ajudar a definir o texto de componentes teimosos."],["Max Text Parser Recursion","Recursão Máxima do Analisador de Texto"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","Indica quantos níveis de recursão são permitidos quando o texto é analisado para que possa ser traduzido em partes diferentes. Isso pode ser usado com regexes divisores em cenários avançados. O valor padrão de um essencialmente significa que a recursão está desativada."],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","Pré-processará e decodificará entidades HTML antes de serem enviadas para tradução. Alguns tradutores falham quando entidades HTML são enviadas."],["Will enable automated handling of rich text (text with markup).","Permitirá o tratamento automatizado de texto rico (texto com marcação)."],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","Indica se mensagens de log úteis relacionadas ao tradutor devem ser ativadas. Pode ser útil ao traduzir com base em recursos redirecionados."],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","Indica que o plugin deve usar ganchos MonoMod em vez de ganchos Harmony."],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","Indica que o plugin deve inicializar a ponte de desvio Harmony, que permite que ganchos Harmony funcionem em um ambiente onde System.Reflection.Emit não existe (geralmente essas configurações são tratadas por gerenciadores de plugin, então não use ao usar um gerenciador de plugin)."],["Redirected Resource Detection Strategy","Estratégia de Detecção de Recursos Redirecionados"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","Indica se e como o plugin deve tentar reconhecer recursos redirecionados para evitar traduções duplicadas."],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","Indica se o plugin deve exibir texto que excede <b>'Máximo de Caracteres por Tradução'</b> sem traduzi-lo."],["Texture","Textura"],["Texture Directory","Diretório de Texturas"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","Diretório para despejar texturas e raiz dos diretórios para carregar imagens. Pode usar marcador: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","Indica se o plugin tentará substituir imagens do jogo por aquelas do diretório TextureDirectory."],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","Indica se o plugin despejará texturas que é capaz de substituir no TextureDirectory. Tem impacto significativo no desempenho."],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","Indica se alternar a tradução com o atalho ALT+T também afetará texturas. Não é garantido funcionar para todas as texturas. Tem impacto significativo no desempenho."],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","Indica se o plugin deve escanear texturas ao carregar a cena. Isso permite que o plugin encontre e (possivelmente) substitua mais texturas."],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","Indica se o plugin deve tentar conectar SpriteRenderer. Esta é uma opção separada porque SpriteRenderer não pode ser conectado adequadamente e a solução implementada pode ter um impacto teórico no desempenho em certas situações."],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","Indica se texturas não modificadas devem ser carregadas. Modificações são determinadas com base no hash no nome do arquivo. Ative apenas para fins de depuração, pois pode causar anomalias."],["Texture Hash Generation Strategy","Estratégia de Geração de Hash de Textura"],["Indicates how the mod identifies pictures through hashes.","Indica como o mod identifica imagens por meio de hashes."],["Duplicate Texture Names","Nomes de Textura Duplicados"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","Indica nomes específicos de textura que estão duplicados no jogo. A lista é separada por ';'"],["Indicates if the plugin should detect duplicate texture names.","Indica se o plugin deve detectar nomes de texturas duplicados."],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","Indica que o plugin deve usar uma estratégia diferente para carregar imagens, o que pode ser relevante se o motor do jogo for antigo."],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","Indica que todas as texturas carregadas devem ser mantidas na memória para desempenho ideal. Desative para reduzir o uso de memória."],["Resource Redirector","Redirecionador de Recursos"],["Preferred Storage Path","Caminho de Armazenamento Preferido"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Indica o armazenamento preferido para recursos redirecionados em relação ao Auto Translator. Pode usar marcador: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","Indica se TextAssets devem ser redirecionados"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","Indica se o plugin deve registrar no console todos os recursos carregados. Útil para determinar o que pode ser conectado"],["Indicates if translatable resources that are found should be dumped","Indica se recursos traduzíveis encontrados devem ser despejados"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","Quando arquivos estão em arquivos ZIP no Caminho de Armazenamento Preferido, esses arquivos são indexados na memória para evitar verificação de IO ao carregá-los. Habilitar esta opção fará o mesmo para arquivos físicos"],["HTTP","HTTP"],["User Agent","Agente de Usuário"],["Override the user agent used by APIs requiring a user agent","Substitui o agente de usuário usado por APIs que exigem um agente de usuário"],["Indiciates whether certificate validations for the .NET API should be disabled","Indica se as validações de certificado para a API .NET devem ser desativadas"],["Translation Aggregator","Agregador de Tradução"],["Width","Largura"],["The total width of the translation aggregator window","A largura total da janela do agregador de tradução"],["Height","Altura"],["The width (per translator) of the translation aggregator window.","A largura (por tradutor) da janela do agregador de tradução."],["Enabled Translators","Tradutores Habilitados"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","Os IDs dos endpoints de tradução que foram habilitados na janela do agregador de tradução. A lista é separada por ';'"],["Google","Google"],["ServiceUrl","URL do Serviço"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","OPCIONAL, pode ser usado para direcionar a solicitação da API do Google para uma URL diferente. Pode ser usado para contornar o GFWoC"],["Google Legitimate","Google Legítimo"],["Google API Key","Chave da API do Google"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","OPCIONAL, necessária se o GoogleTranslateLegitimate estiver configurado"],["Bing Legitimate","Bing Legítimo"],["OcpApim Subscription Key","Chave de Assinatura OcpApim"],["OPTIONAL, needed if BingTranslateLegitimate is configured","OPCIONAL, necessária se o BingTranslateLegitimate estiver configurado"],["Baidu","Baidu"],["Baidu App Id","ID do Aplicativo Baidu"],["OPTIONAL, needed if BaiduTranslate is configured","OPCIONAL, necessária se o BaiduTranslate estiver configurado"],["BaiduAppSecret","Segredo do Aplicativo Baidu"],["Yandex","Yandex"],["Yandex API Key","Chave da API do Yandex"],["OPTIONAL, needed if YandexTranslate is configured","OPCIONAL, necessária se o YandexTranslate estiver configurado"],["Watson","Watson"],["Url","URL"],["OPTIONAL, needed if WatsonTranslate is configured","OPCIONAL, necessária se o WatsonTranslate estiver configurado"],["Key","Chave"],["DeepL","DeepL"],["MinDelay","AtrasoMínimo"],["OPTIONAL, used for throttling DeepL","OPCIONAL, usado para limitar o DeepL"],["MaxDelay","AtrasoMáximo"],["DeepL Legitimate","DeepL Legítimo"],["OPTIONAL, required if DeepLLegitimate is configured","OPCIONAL, necessário se DeepLLegítimo estiver configurado"],["Custom","Personalizado"],["Optional, needed if Custom Translated is configured","Opcional, necessário se Tradutor Personalizado estiver configurado"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","Caminho de Instalação"],["Optional, needed if Lec Power Translator 15 is configured","Opcional, necessário se Lec Power Translator 15 estiver configurado"],["Debug","Depuração"],["Enables the console. Do not enable if other plugins (managers) handles this","Ativa o console. Não ative se outros plugins (gerenciadores) lidarem com isso"],["Enables extra logging for debugging purposes","Ativa registro extra para fins de depuração"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","Caminho de Instalação do ezTrans."],["Migrations","Migrações"],["Used to enable automatic migrations of this configuration file","Usado para habilitar migrações automáticas deste arquivo de configuração"],["Tag","Tag"],["Tag representing the last version this plugin was executed under. Do not edit","Tag que representa a última versão em que este plugin foi executado. Não edite"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":false,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"relPath":"/addons/unityTrans/configEdit.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","XUnity Translator é necessário para realizar esta ação\nPor favor, instale-o através do Instalador de Aplicativos de Terceiros!"],["XUnity.AutoTranslator is found!","XUnity.AutoTranslator foi encontrado!"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++ detecta que XUnity.AutoTranslator já está instalado. Translator++ usará os dados de tradução existentes para iniciar um novo projeto de tradução."],["XUnity.AutoTranslator is not found!","XUnity.AutoTranslator não foi encontrado!"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","O assistente irá guiá-lo para instalar o XUnity.AutoTranslator no jogo."],["Next","Próximo"],["Given path: ","Caminho fornecido: "],["\nis not an Unity game. Do you still want to proceed?","\nnão é um jogo Unity. Você ainda deseja prosseguir?"],["Patch successfully installed!\r\n","Patch instalado com sucesso!\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","A configuração será gerada quando você jogar o jogo pela primeira vez.\r\n"],["Open the game now?","Abrir o jogo agora?"],["Finish","Concluir"],["Update current project?","Atualizar projeto atual?"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":false,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"relPath":"/addons/unityTrans/unityTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","Número máximo de linhas na caixa de mensagem."],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","O valor padrão é 4. Digite 0 para desativar este recurso. Se o número de linhas na caixa de mensagem for maior que este número, o Translator++ gerará uma nova caixa de mensagem para evitar que os textos transbordem das caixas."],["Use shell copy if possible","Usar cópia shell se possível"],["Use shell copy instead of native NodeJS copy handler.","Usar cópia shell em vez do manipulador de cópia nativo do NodeJS."],["Use shell copy","Usar cópia shell"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","Editor WRPGE não está instalado\r\nPor favor, instale-o no menu T++ > Instalador de aplicativos de terceiros\r\n\r\nAbrir o Instalador de aplicativos de terceiros agora?"],["Unable to determina WRPGE path.","Não foi possível determinar o caminho do WRPGE."],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","O Translator++ está prestes a instalar o editor WRPGE na pasta de destino.\r\nContinuar?"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","O caminho de desenvolvimento não está definido.\nVocê deve injetar seu jogo uma vez para gerar o caminho de desenvolvimento."],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","Traduza um jogo Wolf RPG até a versão 3.330 com a biblioteca WolfJs. O analisador padrão de Wolf RPG para o Translator++."],["Wolf RPG Editor games","Jogos do Wolf RPG Editor"],["Parsing Wolf RPG Game with","Analisando jogo Wolf RPG com"],["Wolf RPG Editor game","Jogo do Wolf RPG Editor"],["Select the game's executable file","Selecione o arquivo executável do jogo"],["Engine version","Versão do motor"],["Detected WolfRPG Engine version of the selected game","Versão do WolfRPG Engine detectada para o jogo selecionado"],["Heads up!\r\n","Atenção!\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nnão parece ser um arquivo executável do Wolf RPG!\r\nTem certeza de que deseja iniciar o projeto Wolf RPG a partir deste ponto de entrada?"],["Create a new project","Criar um novo projeto"],["Please specify a game to be processed!","Por favor, especifique um jogo para ser processado!"],["Set dev path. Path to the directory of the translated game.","Definir caminho de desenvolvimento. Caminho para o diretório do jogo traduzido."],["Play last build","Jogar última compilação"],["Open editor","Abrir editor"],["Open Wolf RPG Editor online manual","Abrir manual online do Wolf RPG Editor"],["Open Wolf RPG Editor english manual","Abrir manual em inglês do Wolf RPG Editor"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","Não foi possível encontrar o arquivo do manual.\nPor favor, instale o Wolf RPG Editor através do instalador de aplicativos de terceiros."]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":false,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"relPath":"/addons/wolfJs/wolfJs.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","Iniciar tradução de documentos semelhantes a XML. Suporta formatos XML e HTML."],["Create project","Criar projeto"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":false,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"relPath":"/addons/xmlTrans/xml.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","Tradutor do motor YU-RIS"],["Checking up requirements...","Verificando requisitos..."],["Create a new translation project from YU-RIS visual novel engine","Criar um novo projeto de tradução do motor de visual novel YU-RIS"],["Next","Próximo"],["Select YU-RIS game","Selecionar jogo YU-RIS"],["Select the game's executable file","Selecionar o arquivo executável do jogo"],["Engine version","Versão do motor"],["Detected YU-RIS version of the selected game","Versão YU-RIS detectada do jogo selecionado"],["Create a new project","Criar um novo projeto"],["Invalid target game :","Jogo alvo inválido:"],["Source material do not match the current translation project!","O material de origem não corresponde ao projeto de tradução atual!"],["Select the repack method.","Selecione o método de reempacotamento."],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>Reempacotar nos arquivos YPF originais</b><br />Reempacotará a tradução no pacote original. Pode levar mais tempo para extrair o pacote original, aplicar a tradução e reempacotá-lo novamente.</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>Reempacotar como um arquivo de patch YPF</b><br>Reempacotará a tradução como um arquivo de patch separado (ex: update9.ypf). Dessa forma, é possível traduzir o jogo sem modificar os arquivos ypf originais. Combine isso com a opção <b>Não copiar material, apenas injetar tradução</b> do Copiar material para um processo de aplicação mais rápido.</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","A versão de reempacotamento alvo deve corresponder à versão do seu jogo. Insira a versão principal e secundária separadas por um ponto. Por exemplo: <b>0.466</b>. Por padrão, o Translator++ detectará a versão do motor ao criar o projeto."]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":false,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"relPath":"/addons/yurisParser/YurisParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","Construtor de Formulários"],["Run","Executar"],["New Project (ctrl+n)","Novo Projeto (ctrl+n)"],["Open (ctrl+o)","Abrir (ctrl+o)"],["Save file (ctrl+s)","Salvar arquivo (ctrl+s)"],["Save As (ctrl+shift+s)","Salvar como (ctrl+shift+s)"],["Open debugger (F12)","Abrir depurador (F12)"],["Help","Ajuda"],["Select file in the current workspace","Selecionar arquivo no espaço de trabalho atual"],["file path","caminho do arquivo"],["Create shortcut of the current script","Criar atalho do script atual"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"automationEditor.html","dirname":"/","extension":".html","filename":"automationEditor.html","path":"/automationEditor.html","indexIsBuilt":false,"indexIds":{"Form Builder":0,"Run":1,"New Project (ctrl+n)":2,"Open (ctrl+o)":3,"Save file (ctrl+s)":4,"Save As (ctrl+shift+s)":5,"Open debugger (F12)":6,"Help":7,"Select file in the current workspace":8,"file path":9,"Create shortcut of the current script":10},"tags":[],"relPath":"/automationEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/find.html":{"data":[["Find","Localizar"],["Replace","Substituir"],["Put","Inserir"],["Target","Alvo"],["Grid","Grade"],["Context","Contexto"],["Tag","Tag"],["Comment","Comentário"],["Untranslated rows","Linhas não traduzidas"],["Refine","Refinar"],["Case sensitive","Diferenciar maiúsculas/minúsculas"],["Transpile \\r\\n\\t","Transpilar \\r\\n\\t"],["RegExp","Expressão Regular"],["All files","Todos os arquivos"],["Select All Columns","Selecionar Todas as Colunas"],["Find all string above and replace with :","Encontrar todas as strings acima e substituir por:"],["Original text:","Texto original:"],["Text to put :","Texto a inserir:"],["into: ","em:"],["Search all files","Pesquisar todos os arquivos"],["Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)","Digite a palavra-chave e pressione enter. Você pode usar padrão glob (ex.: *.png)"],["Drag to select, Shift+Drag to unselect","Arraste para selecionar, Shift+Arraste para desselecionar"],["Select target column","Selecionar coluna alvo"],["A line in the original text to find. Press alt+enter to add a new line.","Uma linha no texto original para encontrar. Pressione alt+enter para adicionar uma nova linha."],["Translation","Tradução"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":false,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"relPath":"/find.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":25,"length":25,"percent":100},"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","Não foi possível encontrar o arquivo relacionado aos dados"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","Para corrigir isso, ajuste o campo <b>Localização da matéria-prima</b> nas <a href=\"#\" class=\"openProjectProperties\">Propriedades do projeto</a>"],["Copy path to clipboard","Copiar caminho para a área de transferência"],["Path has been copied to clipboard.","O caminho foi copiado para a área de transferência."],["Open folder","Abrir pasta"],["Open with external application","Abrir com aplicativo externo"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","Abrir com..."],[null,null,null,null,null]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"relPath":"/js/RawViewer.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~usar tradução padrão~"],["Column","Coluna"],["Do you want to delete all context translation on the currently selected row?","Você deseja excluir todas as traduções de contexto na linha atualmente selecionada?"],["Do you want to delete all translation on the currently active row?","Você deseja excluir todas as traduções na linha atualmente ativa?"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":false,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"relPath":"/js/TranslationByContext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","tipo inválido addonObj"],["invalid type addonObj.addons","tipo inválido addonObj.addons"],["You are not eligible to get this addon","Você não está elegível para obter este addon"],[null,null,null,null,null]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":true,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You a