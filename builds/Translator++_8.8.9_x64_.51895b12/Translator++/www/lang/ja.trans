782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-05e7d66a.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-05e7d66a.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","model"],["|","|"],["promptLibrary","promptLibrary"],["search","search"],["downloadChat","downloadChat"],["newChat","新規チャット"],["api","API"],["customEndpoint","カスタムエンドポイント"],["apiEndpoint.inputLabel","APIエンドポイント入力ラベル"],["apiKey.inputLabel","APIキー入力ラベル"],["apiVersion.inputLabel","APIバージョン入力ラベル"],["apiVersion.description","APIバージョン説明"],["securityMessage","セキュリティメッセージ"],["apiEndpoint.description","APIエンドポイント説明"],["apiEndpoint.warn","APIエンドポイント警告"],["partialImportMessages","部分インポートメッセージ"],["import","インポート"],["name","名前"],["prompt","プロンプト"],["clearPrompts","プロンプトクリア"],["morePrompts","その他のプロンプト"],["toast.sync","トースト同期"],["toast.stop","トースト停止"],["button.sync","ボタン同期"],["button.stop","ボタン停止"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-4418d312.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-4418d312.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js":{"data":[["customModels.customLabel","カスタムモデル.カスタムラベル"],["model","モデル"],["|","|"],["promptLibrary","プロンプトライブラリ"],["search","検索"],["downloadChat","チャットをダウンロード"],["newChat","新しいチャット"],["api","API"],["customEndpoint","カスタムエンドポイント"],["apiEndpoint.inputLabel","APIエンドポイント.入力ラベル"],["apiKey.inputLabel","APIキー.入力ラベル"],["apiVersion.inputLabel","APIバージョン.入力ラベル"],["apiVersion.description","APIバージョン.説明"],["securityMessage","セキュリティメッセージ"],["apiEndpoint.description","APIエンドポイント.説明"],["apiEndpoint.warn","APIエンドポイント.警告"],["partialImportMessages","部分インポートメッセージ"],["import","インポート"],["name","名前"],["prompt","プロンプト"],["clearPrompts","プロンプトをクリア"],["morePrompts","さらにプロンプト"],["toast.sync","トースト.同期"],["toast.stop","トースト.停止"],["button.sync","ボタン.同期"],["button.stop","ボタン.停止"]],"context":[["tid/100616/type/StringLiteral"],["tid/100621/type/StringLiteral"],["tid/461589/type/StringLiteral"],["tid/553065/type/StringLiteral","tid/621844/type/StringLiteral"],["tid/553097/type/StringLiteral"],["tid/557240/type/StringLiteral","tid/557260/type/StringLiteral","tid/557282/type/StringLiteral"],["tid/560133/type/StringLiteral","tid/560171/type/StringLiteral","tid/560214/type/StringLiteral"],["tid/606093/type/StringLiteral","tid/606166/type/StringLiteral","tid/606207/type/StringLiteral","tid/606305/type/StringLiteral","tid/606384/type/StringLiteral","tid/606410/type/StringLiteral","tid/606531/type/StringLiteral","tid/606553/type/StringLiteral","tid/606575/type/StringLiteral"],["tid/606161/type/StringLiteral"],["tid/606202/type/StringLiteral"],["tid/606300/type/StringLiteral"],["tid/606379/type/StringLiteral"],["tid/606405/type/StringLiteral"],["tid/606526/type/StringLiteral"],["tid/606548/type/StringLiteral"],["tid/606570/type/StringLiteral"],["tid/608417/type/StringLiteral"],["tid/608422/type/StringLiteral"],["tid/621955/type/StringLiteral","tid/629854/type/StringLiteral"],["tid/621975/type/StringLiteral"],["tid/622292/type/StringLiteral"],["tid/622315/type/StringLiteral"],["tid/629235/type/StringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","カスタムモデル.カスタムラベル"],["model","モデル"],["|","|"],["promptLibrary","プロンプトライブラリ"],["search","検索"],["downloadChat","チャットをダウンロード"],["newChat","新しいチャット"],["api","API"],["customEndpoint","カスタムエンドポイント"],["apiEndpoint.inputLabel","APIエンドポイント.入力ラベル"],["apiKey.inputLabel","APIキー.入力ラベル"],["apiVersion.inputLabel","APIバージョン.入力ラベル"],["apiVersion.description","APIバージョン.説明"],["securityMessage","セキュリティメッセージ"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages","partialImportMessages"],["import","import"],["name","name"],["prompt","prompt"],["clearPrompts","clearPrompts"],["morePrompts","morePrompts"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","button.sync"],["button.stop","button.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ChatGPTバッチAPIで翻訳"],["Model","モデル"],["The pre-trained model.","事前学習済みモデル。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAIバッチAPIは、一般的に使用されるAPIとは少し異なるモデル命名規則を使用しているようです。バッチAPIで使用されるモデルには「-batch」という接頭辞が付きます。例えば、<code>gpt-4.1-mini</code>を使用すると、モデルは自動的に<code>gpt-4.1-mini-batch</code>になります。<br />\nただし、このアドオンが作成された時点では、バッチモデルはOpenAIのモデル使用制限にリストされておらず、ユーザーがモデル使用フィルターを「許可」（ホワイトリスト）に設定している場合、バッチAPIを使用できません。<br />\nこれはOpenAI UIのバグである可能性があり、将来的に修正されるかもしれません。<br />\nしたがって、バッチAPIを使用するには、OpenAIで使用制限を「ブロック」（ブラックリスト）モードに設定してください。<br />\nモデルの使用制限を変更するにはここをクリック：https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","ソース列"],["The column of the original texts you want to translate.","翻訳したい元のテキストの列。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が対話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Ignore if already translated","既に翻訳済みの場合は無視"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","このオプションをチェックすると、Translator++は既に翻訳が列にある行を無視します。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話の文脈を理解するのに役立ちます。アクター参照は対話中のアクター名です。これは翻訳者用の用語集として読み込まれ、翻訳コストが増加します。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチアイテムの用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むには、テンプレートコマンドを使用します。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話中のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの詳細情報を記入でき、会話中の代名詞の翻訳を改善します。"],["System Message Template","システムメッセージテンプレート"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","システムメッセージは、ChatGPTアシスタントの役割を伝えるメッセージのヘッダーです。このメッセージは、ChatGPTに送信するすべてのバッチの最初のメッセージとして送信されます。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScriptのテンプレートリテラルスタイルで以下の変数を含めることができます <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","変数:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : ソース言語</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : ターゲット言語</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : ソース言語の正式名</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : ターゲット言語の正式名</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : ソーステキスト</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : エスケープアルゴリズムの事前定義メッセージ。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 改行を表す文字列（行置換）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : バッチ内のメッセージ数。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : アクターの情報を追加します。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++のオブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 前の数行をコンテキストとして含めます</li>"],["Body Message Template","本文メッセージテンプレート"],["Template of the body of your chat.","チャットの本文のテンプレート。"],["Sample conversation","サンプル会話"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT Batch APIを使用すると、プロジェクトを非同期に翻訳でき、コストが50%削減されます。つまり、翻訳結果を<b style=\"color:red\">24時間以内</b>に<b style=\"color:red\">通常の半額</b>で受け取れます。これは、即時の翻訳結果を必要としない大規模プロジェクトに特に役立ちます。"],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />ChatGPT Batch APIの詳細: https://platform.openai.com/docs/guides/batch 。"],["General Settings","一般設定"],["This form is using your existing ChatGPT configuration.<br>","このフォームは既存のChatGPT設定を使用しています。<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","設定を変更するには、オプションウィンドウのChatGPT翻訳者設定に移動してください。<br>"],["There you can set the API key, model, and other settings.<br />","そこでAPIキー、モデル、その他の設定を設定できます。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT設定を開く\" />"],["Append actor name to the translatable text","翻訳可能なテキストにアクター名を追加"],["Ignore translated rows","翻訳済みの行を無視"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は翻訳の品質を向上させるために、各バッチのアイテムごとに読み込まれます。この機能は、プロンプトを肥大化させないように、関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","アクターの追加情報の列"],["Prompt Template","プロンプトテンプレート"],["<h2>1. System Message</h2>","<h2>1. システムメッセージ</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>ここでは、アシスタントにその役割を説明できます。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答の例を書くことで、翻訳者が目的と会話の文脈を理解するのに役立ちます。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 実際のプロンプト</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>これはアシスタントへの実際のプロンプトです。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>オーバーヘッドコスト</h3>\n                        オーバーヘッドコストは、実際の翻訳テキストなしでアシスタントに送信するプロンプトメッセージのコストです。コストはプロンプトメッセージのトークン数に基づいて計算されます。トークンが多いほど、コストは高くなります。<br>\n                        <b>現在のオーバーヘッドコスト:</b> <span class=\"overheadCost\">0</span> トークン / リクエスト。"],["Are you sure you want to reset the form?","フォームをリセットしてもよろしいですか？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","バッチを処理してもよろしいですか？\nこの操作にはコストが発生します。"],["The batch is successfully created. Do you want to open the batch manager?","バッチは正常に作成されました。バッチマネージャーを開きますか？"],["OpenAI Batch API Queue","OpenAIバッチAPIキュー"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","翻訳を適用する行を選択してください"],["Target Column","ターゲット列"],["The column to put the translation result.","翻訳結果を配置する列。"],["Import translation from ChatGPT Batch","ChatGPT バッチから翻訳をインポート"],["Translation applied to selected rows","選択した行に翻訳が適用されました"],["Invalid format","無効な形式"],["OK","OK"],["Mismatch","不一致"],["Failed to load batch list with error: \n","バッチリストの読み込みに失敗しました。エラー: \n"],["Download Error File","エラーファイルをダウンロード"],["Batch is not completed yet","バッチはまだ完了していません"],["Are you sure you want to cancel this batch?","このバッチをキャンセルしてもよろしいですか？"],["Cannot cancel completed batch.","完了したバッチはキャンセルできません。"],["Batch cancelled","バッチがキャンセルされました"],["Failed to cancel batch","バッチのキャンセルに失敗しました"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","バッチ"],["Apply translation","翻訳を適用"],["Cancel batch","バッチをキャンセル"],["Status","ステータス"],["Batch ID","バッチID"],["Input File ID","入力ファイルID"],["End point","エンドポイント"],["Created at","作成日時"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","有効期限 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了のリクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストで消費されたトークンに対して課金されます。\"></i>"],["Completed at","完了日時"],["Errors","エラー"],["Batch Item Detail of","のバッチアイテム詳細"],["ID","ID"],["Completed on","完了日"],["Model","モデル"],["Prompt Token","プロンプトトークン"],["Completion Token","完了トークン"],["Total Token","合計トークン"],["Status Code","ステータスコード"],["error","エラー"],["Conversation","会話"],["Response Validation","応答検証"],["Raw Payload","生ペイロード"],["View raw payload","生ペイロードを表示"],["Response Preview","応答プレビュー"],["Apply translations from selected rows","選択した行から翻訳を適用"],["Here you can edit the translation result individually and send it into Translator++","ここでは翻訳結果を個別に編集し、Translator++に送信できます"],["Open ChatGPT Settings","ChatGPT設定を開く"],["Help","ヘルプ"],["File list","ファイルリスト"],["Collapse / restore left panel","左パネルを折りたたむ/復元"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了のリクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストで消費されたトークンに対して課金されます。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","OpenAIチャット"],["Target URL","ターゲットURL"],["Target end point. You can use any service that supports OpenAI API.","ターゲットエンドポイント。OpenAI APIをサポートする任意のサービスを使用できます。"],["Sample endpoints","サンプルエンドポイント"],["Use this endpoint","このエンドポイントを使用"],["Copy to clipboard","クリップボードにコピー"],["e.g.","例："],["API Key","APIキー"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","ここにAPIキーを入力してください。<br>APIキーの取得方法はサービスごとに異なります。<br>"],["Leave it blank if the service doesn't require API key.","APIキーが不要なサービスでは空欄のままにしてください。"],["Model","モデル"],["The pre-trained model","事前学習済みモデル"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","OpenAIの場合、使用可能なモデルを設定する必要があるかもしれません（https://platform.openai.com/settings/proj_xxx/limits）。"],["Enable Context","コンテキストを有効化"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","翻訳のコンテキストを有効化します。現在のバッチの上にある以前に翻訳された内容がコンテキストとして含まれます。<b>また、テンプレートに明示的にCONTEXTを含める必要があります</b>"],["Context Character Limit","コンテキスト文字数制限"],["Character limit for the context.","コンテキストの文字数制限。"],["System Message Template","システムメッセージテンプレート"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","システムメッセージは、chatGPTアシスタントの役割を伝えるメッセージのヘッダーです。このメッセージは、chatGPTに送信するすべてのバッチの最初のメッセージとして送信されます。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScriptのテンプレートリテラルスタイルで以下の変数を含めることができます <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","変数：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : ソース言語</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : ターゲット言語</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : ソーステキスト</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : エスケープアルゴリズムの事前定義メッセージ。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 改行を表す文字列（行の代替）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : バッチ内のメッセージ数。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : アクター情報の用語集。（バッチモードでアクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++オブジェクトから参照を生成。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["User message","ユーザーメッセージ"],["Assistant's response","アシスタントの応答"],["Body Message Template","本文メッセージテンプレート"],["Template of the body of your chat.","チャット本文のテンプレート。"],["Enable JailBreak","ジェイルブレイクを有効化"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","翻訳のジェイルブレイクを有効化します。これにより、翻訳がより正確で偏りが少なくなります。一部のモデルは架空の出来事を現実の出来事に関連付けようとするため、独自の物語に合わせて翻訳を変更しようとします。このオプションはそれを防ぎます。"],["Jailbreak Template","ジェイルブレイクテンプレート"],["Template of the Jailbreak message.","ジェイルブレイクメッセージのテンプレート。"],["Maximum Tokens","最大トークン数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","生成するトークンの最大数。<br>プロンプトのトークン数とmax_tokensの合計は、モデルのコンテキスト長を超えることはできません。ほとんどのモデルは2048トークンのコンテキスト長を持っています（最新モデルを除き、4096をサポート）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用するサンプリング温度を0から2の間で指定します。0.8のような高い値は出力をよりランダムにし、0.2のような低い値はより焦点を絞り、確定的にします。<br>OpenAIは一般的に、これを変更するかtop_pを変更することを推奨していますが、両方ではなくどちらか一方です。"],["Nucleus sampling (top_p)","核サンプリング（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度によるサンプリングの代替として、核サンプリングと呼ばれる方法があり、モデルはtop_p確率質量を持つトークンの結果を考慮します。したがって、0.1は上位10%の確率質量を構成するトークンのみが考慮されることを意味します。<br>OpenAIは一般的に、これを変更するか温度を変更することを推奨していますが、両方ではなくどちらか一方です。"],["Frequency Penalty","頻度ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内での既存の頻度に基づいて新しいトークンにペナルティを課し、モデルが同じ行を逐語的に繰り返す可能性を減らします。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内に既に出現しているかどうかに基づいて新しいトークンにペナルティを課し、モデルが新しいトピックについて話す可能性を高めます。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","JSONスキーマを使用"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","古い<code>json_object</code>の代わりに<code>response_format.type</code>フィールドに<code>json_schema</code>を使用します。<code>json_schema</code>は一部の最新モデルや<b>LM Studio</b>などのサーバーで必要ですが、一部の古いモデルはまだ<code>json_object</code>を使用しています。"],["Max Characters per Batch","バッチあたりの最大文字数"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","翻訳バッチあたりの最大文字制限。\nこのオプションは、プロンプトメッセージの文字長ではなく、元のテキストの文字長のみをカウントします。"],["Max concurrent requests","最大同時リクエスト数"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","同時に接続できる同時リクエストの数はいくつですか？追加の同時接続ごとに翻訳速度が倍増しますが、プロバイダーが設定したトークン制限もすぐに使い果たします。<br />この機能を無効にするには<b>0</b>に設定します。<br />このオプションを<b>同時リクエストあたりの最大行数</b>と組み合わせて、翻訳速度をさらに向上させます。<br />このオプションを1より大きく設定すると、前のリクエストが終了する前にリクエストが処理されるため、<b>コンテキスト</b>に影響します。したがって、コンテキストは前のリクエストの翻訳結果なしで送信されます。"],["Max row per concurrent requests","同時リクエストあたりの最大行数"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","各同時リクエストで許可される行数。この機能を無効にするには<b>0</b>に設定します。<br />このオプションが無効になっている場合、<b>最大同時リクエスト数</b>をいくつ設定しても、Translator++はリクエストを単一のチャンクとして処理します。<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","設定する行数が多いほど、単一のバッチでより多くの翻訳を取得できます。したがって、オーバーヘッドコストが削減され、AIがエラー結果を返す可能性が高まります。<br />数値が低いほど、翻訳がエラーになる可能性は低くなりますが、オーバーヘッドプロンプトの追加コストがかかります。"],["Preserve translations from invalid returned number of rows","無効な返された行数からの翻訳を保持"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","無効な行数を持つ応答からの翻訳を保持します。<br />チェックすると、Translator++は行数を修正し、翻訳をグリッドに挿入しようとします。<br />チェックしないと、セルは空白のままになります。<br />再翻訳の目的には、このオプションをチェックしないことをお勧めします。"],["Batch delay","バッチ遅延"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","バッチ間の遅延（ミリ秒単位）。<br />この設定を使用してリクエストを制御し、RPM（1分あたりのリクエスト数）制限に達しないようにします。"],["Batch Timeout","バッチタイムアウト"],["Timeout for each batch in milisecond","各バッチのタイムアウト（ミリ秒単位）"],["Code Escaping Algorithm","コードエスケープアルゴリズム"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","ダイアログ内のインラインコード用のエスケープアルゴリズム。選択したエスケープアルゴリズムに応じて、<b>システムメッセージテンプレート</b>と<b>本文メッセージテンプレート</b>を変更する必要がある場合があります。<br /><b>JSONCloaking</b>または<b>JSONObjectCloaking</b>を選択すると、<code>response_format: { type: 'json_object' }</code>が自動的に送信されます（<b>JSONスキーマを使用</b>を有効にした場合を除き、その場合はJSONスキーマが送信されます）。<b>JSONCloaking</b>は非常に正確ですが、すべてのモデルで動作するわけではありません。<b>gpt-3.5-turbo-1106</b>をお試しください。"],["Number of retry","リトライ回数"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","翻訳出力の検証が失敗した場合に、エンジンがリトライする回数。nullish（空）の場合はリトライしません。"],["Retry when the number of translated rows doesn't match original","翻訳行数が元の行数と一致しない場合にリトライ"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","有効にすると、モデルが返す翻訳行数が元のペイロードと異なる場合にエンジンがリトライします。"],["Retry when the number of lines for each translated row doesn't match original","各翻訳行の行数が元の行数と一致しない場合にリトライ"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","有効にすると、翻訳行のいずれかが元の行と異なる行数を持つ場合にエンジンがリトライします。"],["Prompt: Row count mismatch","プロンプト: 行数不一致"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","行数/要素数不一致によるリトライ時に使用するプロンプト。利用可能なテンプレート変数: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}。"],["Prompt: Line count mismatch","プロンプト: 行数不一致（各行）"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","各行の行数不一致によるリトライ時に使用するプロンプト。利用可能なテンプレート変数: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}。"],["Prompt: Error / Retry instruction","プロンプト: エラー / リトライ指示"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","不一致プロンプトの後に追加され、モデルにリトライを指示するプロンプト。利用可能なテンプレート変数: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}。"],["Custom Parameter","カスタムパラメータ"],["Key","キー"],["Value","値"],["Type","タイプ"],["Type of the value.","値のタイプ。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b>タイプの場合、値はJavaScriptコードとして評価されます。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScriptコードのスコープは<code>window</code>です。したがって、ほぼすべての値を取得できます。"],["<br />Example: <code>trans.project.title</code>","<br />例：<code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","APIに送信されないパラメータを削除します。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI APIは常に変化しており、新しいモデルは古いパラメータをサポートせず、認識されないリクエストパラメータに対してHTTPエラーを返す場合があります。"],["You can drop the parameters that are not supported by the model here.","ここでモデルがサポートしていないパラメータを削除できます。"],["Manage configuration","設定を管理"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","HTMLクローキングラップ"],["JSONObject Cloaking","JSONObjectクローキング"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","このアドオンは、Deepseek、LlamaCPP、Google Geminiなど、OpenAI Chat APIをサポートするあらゆるサービスを通じて翻訳を可能にし、もちろんOpenAI ChatGPTも含みます。"],["OpenAI API settings","OpenAI API設定"],["General","一般"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>推論モデルにお金を無駄にしないでください</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>さまざまな研究により、推論モデルは創造的な文章作成や翻訳タスクにおいて通常のモデルよりもはるかに劣ることが証明されています。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>推論モデルを使用すると、より高価なコストと遅い応答時間以外に何も得られません。</p>"],["Explore more models","さらに多くのモデルを探索"],["Templates","テンプレート"],["Enable context","コンテキストを有効化"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存のサンプル対話。良い応答や悪い応答の例を記述して、翻訳者が会話の目的と文脈を理解するのを助けることができます。</p>"],["Add Example: Translate Japanese to English","例を追加：日本語から英語への翻訳"],["Retry prompts","プロンプトを再試行"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>これらのプロンプトは、前のモデル出力の直後に追加の<b>ユーザー</b>メッセージとして再試行時に追加されます。</p>"],["<p>Available variables:</p>","<p>利用可能な変数：</p>"],["Enable Jailbreak","ジェイルブレイクを有効化"],["Advanced","詳細設定"],["Custom Parameters","カスタムパラメータ"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat APIリクエストボディにカスタムパラメータを追加できます。フォームで利用できない追加パラメータを追加したい場合に便利です。"],["<h2>Warning</h2>","<h2>警告</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>カスタムパラメータを誤って設定すると、APIリクエストが失敗する可能性があります。カスタムパラメータを追加する前に、何をしているか理解していることを確認してください。OpenAIなどの一部のサービスは送信するパラメータに厳格で、認識されないリクエストパラメータに対してHTTPエラーを返します。</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>同じキーが複数回使用された場合、最後の値のみが使用されます。</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>既存の設定で同じキーが使用されている場合、既存の設定パラメータはカスタムパラメータで上書きされます。</li>"],["Drop Parameters","パラメータを削除"],["Open chatGPT tester","chatGPTテスターを開く"],["Batch Translation Setting","バッチ翻訳設定"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","申し訳ありませんが、このアドオンはアクティブなパトロンのみ利用可能です。\n$1のパトロンになることでこの機能をアンロックできます。"],["Preserve invalid returned rows","無効な返却行を保持"],["Retries and Refinement","再試行と改善"],["<h2>Retries and Refinement</h2>","<h2>再試行と改善</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>翻訳出力が検証に失敗した場合、Translator++はモデルに翻訳の再試行を要求できます。モデルが何回再試行すべきか、また再試行の条件を設定できます。</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>適切な再試行条件と合理的な再試行回数を設定することで、コストと時間を抑えつつ、翻訳品質を大幅に向上させることができます。</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>各再試行は追加の時間と費用がかかります</b>。バッチが頻繁に再試行する場合、モデルへの指示を明確にするためにプロンプトを調整することをお勧めします。</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>開発者ツールまたはバッチマネージャーを使用して、バッチ翻訳をデバッグしてください。</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>コードエスケープアルゴリズム</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>コードエスケープは、MTLがダイアログ内のコードスニペットを変更するのを防ぐ技術です。ダイアログにHTMLタグ、XMLタグ、JSONオブジェクト、JavaScriptテンプレートなどのコードスニペットが含まれている場合に便利です。</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>ダイアログ内のコードスニペットに一致するエスケープアルゴリズムを選択してください。<b>システムメッセージ</b>、<b>サンプルプロンプト</b>、<b>本文メッセージ</b>のテンプレートを適宜調整する必要があるかもしれません。</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>コードエスケープアルゴリズムとその効果的な使用方法について詳しくは、<a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>こちら</a>をクリックしてください。</p>"],["Default","デフォルト"],["JavaScript template cloaking","JavaScriptテンプレート隠蔽"],["None (no escaping)","なし（エスケープなし）"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","選択したエスケープアルゴリズムのサンプルダイアログプリセットを読み込みますか？これにより既存のサンプルダイアログが上書きされます。"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチで常にファイルを分離します。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれる可能性があります。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者がダイアログと代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込み"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解しやすくなります。アクター参照はダイアログ内のアクターの名前です。これは翻訳者への用語集として読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチ項目の用語集として読み込まれます。プロンプトメッセージでキャラクター参照を読み込むには、テンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合、プロンプトテンプレートに<code>ACTOR_INFO</code>変数を含めて、キャラクター情報データを配置する必要もあります。"],["Actor Reference Translation Column","キャラクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","キャラクター名の翻訳の列です。この列はキャラクター参照の翻訳として使用され、会話内でのキャラクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","キャラクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","キャラクターの追加情報を含む列です。性別、年齢などの詳細情報を入れることができ、会話内の代名詞の翻訳を改善します。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプトです。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["<br />","<br />"],["General Settings","一般設定"],["Always separate file for each batch","常に各バッチごとに別ファイル"],["Append actor name to the translatable text","翻訳可能なテキストにキャラクター名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチの項目ごとに読み込まれ、翻訳の品質を向上させます。この機能は、プロンプトの肥大化を避けるために関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","キャラクター追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":true,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>送</u>信"],["Toggle word wrap","ワードラップを切り替え"],["Open debugger (F12)","デバッガーを開く (F12)"],["Help","ヘルプ"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","この機能はTranslator++の開発者バージョンを使用している場合のみ利用可能です。開発者バージョンに切り替えるには、基本ユーティリティ -> コアNWJSの変更を使用してください。"]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : キャラクター情報の用語集（バッチモードでキャラクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答の例を書いて、翻訳者が目的と会話のコンテキストを理解するのに役立てることができます。</p>"],["Always separate file","常にファイルを分ける"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチごとに常にファイルを分けてください。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれます。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が対話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳のコストを増加させます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解するのに役立ちます。アクター参照は対話内のアクターの名前です。これは用語集として翻訳者に読み込まれます。これにより、翻訳のコストが増加します。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチ項目の用語集として読み込まれます。プロンプトメッセージでアクター参照を配置するには、テンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合、プロンプトテンプレートに<code>ACTOR_INFO</code>変数を含めて、キャラクター情報データを配置する必要もあります。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用されます。これにより、会話内でのアクター名の翻訳の一貫性が向上します。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの詳細情報を入れることができます。これにより、会話内での代名詞の翻訳が向上します。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプト。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["General Settings","一般設定"],["Always separate file for each batch","バッチごとに常に別ファイル"],["Append actor name to the translatable text","翻訳可能なテキストに役者名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチの項目に対して読み込まれ、翻訳の品質を向上させます。プロンプトの肥大化を避けるため、関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","役者の追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","ChatGPT API とチャット"],["Batch Manager","バッチマネージャー"],["This feature is only available if you have a project open.","この機能はプロジェクトを開いている場合のみ利用可能です。"]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","DazedMTLToolをインストールしますか？"],["Ignore if already translated","すでに翻訳済みの場合は無視"],["OpenAI Translation with DazedMTL","DazedMTLを使用したOpenAI翻訳"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":true,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","DeepLサーバーがインストールされていません。今すぐインストールしますか？"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":true,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","文字使用量：\n"],["Failed to fetch quota: ","クォータの取得に失敗しました："]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":true,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>送信</u>"],["Toggle word wrap","ワードラップの切り替え"],["Open debugger (F12)","デバッガーを開く（F12）"],["Help","ヘルプ"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","この機能はTranslator++の開発者バージョンを使用している場合のみ利用可能です。開発者バージョンに切り替えるには、基本ユーティリティ -> コアNWJSの変更を使用してください。"]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例：<code>REFERENCE[共通参照]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>ネイティブGemini API</h2><p>このエンジンは翻訳にGoogle GeminiネイティブAPIを使用します。<br />Google Gemini用のOpenAIアドオンも使用できます。OpenAIアドオンにはより多くの機能があるため、<b style='color:green;'>代わりにOpenAIアドオンの使用をお勧めします</b>。</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AIにはOpenAIライブラリの一部モジュールが必要です。<b>transChatGPT（Translator++用ChatGPT）</b>アドオンがインストールされていることを確認してください。"],["Explore more models","さらにモデルを探索"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","モデル"],["|","|"],["promptLibrary","プロンプトライブラリ"],["search","検索"],["downloadChat","チャットをダウンロード"],["newChat","新しいチャット"],["api",