/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transGeminiAi/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":true,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"parameters":[]},"/addons/transGeminiAi/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ChatGPTバッチAPIで翻訳"],["Model","モデル"],["The pre-trained model.","事前学習済みモデル。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAIバッチAPIは、一般的に使用されるAPIとは少し異なるモデルの命名規則を使用しているようです。バッチAPIで使用されるモデルには「-batch」という接頭辞が付きます。例えば、<code>gpt-4.1-mini</code>を使用すると、モデルは自動的に<code>gpt-4.1-mini-batch</code>になります。<br />\nただし、このアドオンが作成された時点では、バッチモデルはOpenAIのモデル使用制限にリストされていないため、ユーザーがモデル使用フィルターを「許可」（ホワイトリスト）に設定している場合、バッチAPIを使用できません。<br />\nこれはおそらくOpenAI UIのバグであり、将来的に修正される可能性があります。<br />\nしたがって、バッチAPIを使用するには、OpenAIの使用制限を「ブロック」（ブラックリスト）モードに設定してください。<br />\nモデルの使用制限を変更するにはここをクリック：https://platform.openai.com/settings/proj_xxx/limits\n"],["Source Column","ソース列"],["The column of the original texts you want to translate.","翻訳したい元のテキストの列。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が会話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Ignore if already translated","既に翻訳済みの場合は無視"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","このオプションがチェックされている場合、Translator++はその列に既に翻訳がある行を無視します。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話の文脈を理解しやすくなります。アクター参照は会話内のアクターの名前です。これは翻訳者への用語集として読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチアイテムの用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むには、テンプレートコマンドを使用してください。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話内のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの詳細情報を入力できます。これにより、会話内の代名詞の翻訳が改善されます。"],["System Message Template","システムメッセージテンプレート"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","システムメッセージは、チャットGPTアシスタントの役割を伝えるメッセージのヘッダーです。このメッセージは、チャットGPTに送信するすべてのバッチの最初のメッセージとして送信されます。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScriptのテンプレートリテラルスタイルで以下の変数を含めることができます <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","変数:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : ソース言語</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : ターゲット言語</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完全なソース言語名</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完全なターゲット言語名</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : ソーステキスト</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : エスケープアルゴリズムの事前定義メッセージ。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 改行を表す文字列（行の代替）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : バッチ内のメッセージ数。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : アクターの情報を追加します。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 前の数行をコンテキストとして含めます</li>"],["Body Message Template","本文メッセージテンプレート"],["Template of the body of your chat.","チャットの本文のテンプレート。"],["Sample conversation","サンプル会話"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPTバッチAPIを使用すると、プロジェクトを非同期で翻訳でき、コストを50%削減できます。つまり、翻訳結果を<b style=\"color:red\">24時間以内</b>に<b style=\"color:red\">通常の半額</b>で受け取れます。これは、即時の翻訳結果を必要としない大規模プロジェクトに特に役立ちます。"],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .","<br />ChatGPTバッチAPIの詳細はこちら: https://platform.openai.com/docs/guides/batch 。"],["General Settings","一般設定"],["This form is using your existing ChatGPT configuration.<br>","このフォームは既存のChatGPT設定を使用しています。<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","設定は、オプションウィンドウのChatGPT翻訳設定で変更できます。<br>"],["There you can set the API key, model, and other settings.<br />","そこでAPIキー、モデル、その他の設定を設定できます。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT設定を開く\" />"],["Append actor name to the translatable text","翻訳可能なテキストに役者名を追加"],["Ignore translated rows","翻訳済み行を無視"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能はプロンプトに用語集を自動的に追加し、翻訳品質を向上させます。用語集は各バッチの項目ごとに読み込まれ、プロンプトの肥大化を避けるために関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","役者の追加情報の列"],["Prompt Template","プロンプトテンプレート"],["<h2>1. System Message</h2>","<h2>1. システムメッセージ</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>ここでアシスタントに役割を説明できます。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良いまたは悪い応答の例を記述して、翻訳者が目的と会話の文脈を理解するのを助けます。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 実際のプロンプト</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>これはアシスタントへの実際のプロンプトです。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>オーバーヘッドコスト</h3>\n                        オーバーヘッドコストは、実際の翻訳テキストなしでアシスタントに送信するプロンプトメッセージのコストです。コストはプロンプトメッセージのトークン数に基づいて計算されます。トークンが多いほどコストは高くなります。<br>\n                        <b>現在のオーバーヘッドコスト:</b> <span class=\"overheadCost\">0</span> トークン / リクエスト。"],["Are you sure you want to reset the form?","フォームをリセットしてもよろしいですか？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","バッチ処理を実行してもよろしいですか？\nこの操作にはコストが発生します。"],["The batch is successfully created. Do you want to open the batch manager?","バッチが正常に作成されました。バッチマネージャーを開きますか？"],["OpenAI Batch API Queue","OpenAI バッチ API キュー"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"batchAPI.js","path":"/addons/transGeminiAi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++ オブジェクトから参照を生成します。<br />例: <code>REFERENCE[共通参照]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transGeminiAi/chatGPT-legacy.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","翻訳を適用する行を選択してください"],["Target Column","ターゲット列"],["The column to put the translation result.","翻訳結果を配置する列です。"],["Import translation from ChatGPT Batch","ChatGPTバッチから翻訳をインポート"],["Translation applied to selected rows","選択した行に翻訳が適用されました"],["Invalid format","無効な形式"],["OK","OK"],["Mismatch","不一致"],["Failed to load batch list with error: \n","バッチリストの読み込みに失敗しました。エラー：\n"],["Download Error File","エラーファイルをダウンロード"],["Batch is not completed yet","バッチはまだ完了していません"],["Are you sure you want to cancel this batch?","このバッチをキャンセルしてもよろしいですか？"],["Cannot cancel completed batch.","完了したバッチはキャンセルできません。"],["Batch cancelled","バッチがキャンセルされました"],["Failed to cancel batch","バッチのキャンセルに失敗しました"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transGeminiAi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transGeminiAi/chatgpt-batch-manager/index.html":{"data":[["Batches","バッチ"],["Apply translation","翻訳を適用"],["Cancel batch","バッチをキャンセル"],["Status","ステータス"],["Batch ID","バッチID"],["Input File ID","入力ファイルID"],["End point","エンドポイント"],["Created at","作成日時"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","有効期限 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了のリクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストから消費されたトークンに対して課金されます。\"></i>"],["Completed at","完了日時"],["Errors","エラー"],["Batch Item Detail of","バッチアイテム詳細"],["ID","ID"],["Completed on","完了日時"],["Model","モデル"],["Prompt Token","プロンプトトークン"],["Completion Token","完了トークン"],["Total Token","合計トークン"],["Status Code","ステータスコード"],["error","エラー"],["Conversation","会話"],["Response Validation","レスポンス検証"],["Raw Payload","生ペイロード"],["View raw payload","生ペイロードを表示"],["Response Preview","レスポンスプレビュー"],["Apply translations from selected rows","選択した行から翻訳を適用"],["Here you can edit the translation result individually and send it into Translator++","ここでは翻訳結果を個別に編集し、Translator++に送信できます"],["Open ChatGPT Settings","ChatGPT設定を開く"],["Help","ヘルプ"],["File list","ファイルリスト"],["Collapse / restore left panel","左パネルを折りたたむ/復元"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了リクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストから消費されたトークンに対して課金されます。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transGeminiAi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transGeminiAi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transGeminiAi/options.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : アクター情報の用語集（バッチモードでアクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++ オブジェクトから参照を生成します。<br />例: <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>推論モデルにお金を無駄にしないでください</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>様々な研究により、推論モデルは創造的な文章作成や翻訳タスクにおいて通常のモデルよりもはるかに劣ることが証明されています。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>推論モデルを使用すると、より高価なコストと遅い応答時間が得られるだけで、何も得られません。</p>"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答のサンプルを書くことで、翻訳者があなたの目的や会話のコンテキストを理解するのに役立ちます。</p>"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチごとにファイルを分けてください。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれます。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が対話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解しやすくなります。アクター参照は対話中のアクター名です。これは用語集として翻訳者に読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチアイテムの用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むには、テンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合、プロンプトテンプレートに<code>ACTOR_INFO</code>変数を含めて、キャラクター情報データを配置する必要があります。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話中のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの情報を入れることができ、会話中の代名詞の翻訳を向上させます。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプト。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["General Settings","一般設定"],["Always separate file for each batch","各バッチごとにファイルを分ける"],["Append actor name to the translatable text","翻訳可能なテキストにアクター名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチのアイテムごとに読み込まれ、翻訳の品質を向上させます。この機能は、プロンプトが膨らむのを避けるため、関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","アクターの追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/727/type/StringLiteral","tid/5390/type/StringLiteral"],["tid/735/type/StringLiteral","tid/5398/type/StringLiteral"],["tid/743/type/StringLiteral","tid/5406/type/StringLiteral"],["tid/751/type/StringLiteral","tid/5414/type/StringLiteral"],["tid/759/type/StringLiteral","tid/5422/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/2367/type/NoSubstitutionTemplate"],["tid/2375/type/NoSubstitutionTemplate"],["tid/2383/type/NoSubstitutionTemplate"],["tid/2907/type/StringLiteral"],["tid/2914/type/StringLiteral"],["tid/5098/type/StringLiteral"],["tid/5108/type/StringLiteral"],["tid/5142/type/StringLiteral"],["tid/5152/type/StringLiteral"],["tid/5189/type/StringLiteral","tid/5599/type/StringLiteral"],["tid/5199/type/StringLiteral"],["tid/5206/type/StringLiteral"],["tid/5213/type/StringLiteral"],["tid/5247/type/StringLiteral","tid/5630/type/StringLiteral"],["tid/5257/type/StringLiteral"],["tid/5284/type/StringLiteral"],["tid/5294/type/StringLiteral"],["tid/5324/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5461/type/StringLiteral"],["tid/5487/type/StringLiteral"],["tid/5511/type/StringLiteral"],["tid/5543/type/StringLiteral"],["tid/5569/type/StringLiteral"],["tid/5576/type/StringLiteral"],["tid/5661/type/StringLiteral"],["tid/5692/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"options.js","path":"/addons/transGeminiAi/options.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Don't waste your money on Reasoning Models</h2>":6,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":7,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":8,"<h2>Sample dialogue</h2>":9,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":10,"Always separate file":11,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":12,"Add actor name":13,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":14,"Load Actor Reference as Glossary":15,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":16,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":17,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":18,"Actor Reference Translation Column":19,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":20,"Actor's Information Column":21,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":22,"Extra Prompt":23,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":24,"General Settings":25,"Always separate file for each batch":26,"Append actor name to the translatable text":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":30,"The Column of Actor's Additional Information":31,"Prompt":32},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>送信</u>"],["Toggle word wrap","ワードラップの切り替え"],["Open debugger (F12)","デバッガーを開く（F12）"],["Help","ヘルプ"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGeminiAi/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGeminiAi/tester/chatGPTtester.html","indexIsBuilt":true,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"parameters":[]},"/addons/transGeminiAi/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","この機能は、Translator++の開発者バージョンを使用している場合のみ利用可能です。基本ユーティリティ -> コアNWJSの変更を使用して開発者バージョンに切り替えることができます。"]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGeminiAi/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGeminiAi/tester/chatGPTtester.js","indexIsBuilt":true,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"parameters":[]},"/addons/transGeminiAi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : キャラクター情報の用語集（バッチモードでキャラクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前回の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答の例を書いて、翻訳者が目的や会話のコンテキストを理解できるようにします。</p>"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチごとにファイルを常に分離します。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれます。"],["Add actor name","キャラクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からキャラクター名を翻訳可能なテキストに追加します。これにより、翻訳者が対話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からキャラクター名を削除します。これにより、翻訳コストが明らかに増加します。"],["Load Actor Reference as Glossary","キャラクター参照を用語集として読み込み"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はキャラクター参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解しやすくなります。キャラクター参照は対話内のキャラクター名です。これは用語集として翻訳者に読み込まれ、翻訳コストが増加します。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが各バッチ項目の用語集として読み込まれます。プロンプトメッセージでキャラクター参照を読み込むには、テンプレートコマンドを使用します。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合、プロンプトテンプレートに<code>ACTOR_INFO</code>変数を含めて、キャラクター情報データを配置する必要があります。"],["Actor Reference Translation Column","キャラクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","キャラクター名の翻訳の列。この列はキャラクター参照の翻訳として使用され、会話内でのキャラクター名の翻訳の一貫性が向上します。"],["Actor's Information Column","キャラクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列です。性別、年齢などの情報を追加できます。これにより、会話内の代名詞の翻訳が改善されます。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプトです。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["General Settings","一般設定"],["Always separate file for each batch","常にバッチごとに別ファイル"],["Append actor name to the translatable text","翻訳可能なテキストにアクター名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチのアイテムごとに読み込まれ、翻訳の品質を向上させます。プロンプトの肥大化を避けるため、関連する用語のみを読み込むように試みます。</p>"],["The Column of Actor's Additional Information","アクターの追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transGeminiAi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transGeminiAi/utility.js":{"data":[["Chat with ChatGPT API","ChatGPT APIとのチャット"],["Batch Manager","バッチマネージャー"],["This feature is only available if you have a project open.","この機能はプロジェクトを開いている場合のみ利用可能です。"]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transGeminiAi","extension":".js","filename":"utility.js","path":"/addons/transGeminiAi/utility.js","indexIsBuilt":true,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"parameters":[]},"/addons/transGeminiNano/geminiNanoUtils.js":{"data":[["This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?","この操作によりブラウザウィンドウが起動します。デフォルトブラウザがChromeブラウザに設定されていることを確認してください。続行しますか？"],["Gemini Nano server is already running. Do you want to restart it?","Gemini Nanoサーバーは既に実行中です。再起動しますか？"],["This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?","この操作によりブラウザウィンドウが起動します。デフォルトブラウザがChromeブラウザに設定されていること、およびGemini Nanoサーバーが起動していることを確認してください。続行しますか？"]],"context":[["tid/1312/type/NoSubstitutionTemplate"],["tid/1352/type/NoSubstitutionTemplate"],["tid/1525/type/NoSubstitutionTemplate"]],"basename":"geminiNanoUtils.js","dirname":"/addons/transGeminiNano","extension":".js","filename":"geminiNanoUtils.js","path":"/addons/transGeminiNano/geminiNanoUtils.js","indexIsBuilt":true,"indexIds":{"This action will launch a browser window. Make sure your default browser is set to Chrome browser. Do you want to continue?":0,"Gemini Nano server is already running. Do you want to restart it?":1,"This action will launch a browser window. Make sure your default browser is set to Chrome browser. And Gemini Nano Server is starte. Do you want to continue?":2},"tags":[],"parameters":[]},"/addons/transKoboldAI/Llama3.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : アクター情報の用語集。（バッチモードでアクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチごとに常にファイルを分離します。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれる可能性があります。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","翻訳可能なテキストに行情報からアクター名を追加します。これにより、翻訳者が会話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解しやすくなります。アクター参照は対話中のアクターの名前です。これは翻訳者への用語集として読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話内に存在するキャラクターのみが各バッチ項目の用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むにはテンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合は、キャラクター情報データを配置するためにプロンプトテンプレートに<code>ACTOR_INFO</code>変数を含める必要もあります。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話内でのアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの詳細情報を入力でき、会話内の代名詞の翻訳を改善します。"],["General Settings","一般設定"],["Always separate file for each batch","常にバッチごとに別ファイル"],["Append actor name to the translatable text","翻訳可能なテキストにアクター名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。翻訳の品質を向上させるため、各バッチ項目に対して用語集が読み込まれます。プロンプトの肥大化を避けるため、関連する用語のみを読み込むよう試みます。</p>"],["The Column of Actor's Additional Information","アクター追加情報の列"]],"context":[["tid/820/type/StringLiteral"],["tid/828/type/StringLiteral"],["tid/836/type/StringLiteral"],["tid/844/type/StringLiteral"],["tid/852/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3356/type/StringLiteral"],["tid/3390/type/StringLiteral"],["tid/3400/type/StringLiteral"],["tid/3437/type/StringLiteral","tid/3715/type/StringLiteral"],["tid/3447/type/StringLiteral"],["tid/3454/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3495/type/StringLiteral","tid/3746/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3532/type/StringLiteral"],["tid/3542/type/StringLiteral"],["tid/3577/type/StringLiteral"],["tid/3603/type/StringLiteral"],["tid/3627/type/StringLiteral"],["tid/3659/type/StringLiteral"],["tid/3685/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3777/type/StringLiteral"]],"basename":"Llama3.js","dirname":"/addons/transKoboldAI","extension":".js","filename":"Llama3.js","path":"/addons/transKoboldAI/Llama3.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Always separate file":5,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":6,"Add actor name":7,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":8,"Load Actor Reference as Glossary":9,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":10,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":11,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"General Settings":17,"Always separate file for each batch":18,"Append actor name to the translatable text":19,"Glossary":20,"<h2>Glossary</h2>":21,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":22,"The Column of Actor's Additional Information":23},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/batchAPI.js":{"data":[["Service Name","サービス名"],["Service provider for your Batch API.","バッチAPIのサービスプロバイダー。"],["Your API Key","APIキー"],["Please enter your API key for the Batch API service.","バッチAPIサービスのAPIキーを入力してください。"],["Model","モデル"],["The model for your translation.","翻訳用のモデル。"],["Source Column","ソース列"],["The column of the original texts you want to translate.","翻訳したい元テキストの列。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより翻訳者が台詞や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Ignore if already translated","既に翻訳済みの場合は無視"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","このオプションがチェックされている場合、Translator++は既に翻訳が存在する列の行を無視します。"],["Filter Tag","フィルタータグ"],["If set, only rows with this tag will be translated.","設定すると、このタグを持つ行のみが翻訳されます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより翻訳者が会話の文脈を理解しやすくなります。アクター参照は台詞中のアクター名です。これは用語集として翻訳者に読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが各バッチアイテムの用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むにはテンプレートコマンドを使用してください。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話中のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの情報を追加でき、会話中の代名詞の翻訳を向上させます。"],["Enable Context","コンテキストを有効化"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","翻訳のためのコンテキストを有効化します。現在のバッチより前の翻訳済みの内容がコンテキストとして含まれます。<b>テンプレートに明示的にCONTEXTを含める必要もあります</b>"],["Context Character Limit","コンテキスト文字数制限"],["Character limit for the context.","コンテキストの文字数制限。"],["System Message Template","システムメッセージテンプレート"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","システムメッセージは、chatGPTアシスタントの役割を伝えるメッセージのヘッダーです。このメッセージは、chatGPTに送信するすべてのバッチの最初のメッセージとして送信されます。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScriptのテンプレートリテラルスタイル <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>で以下の変数を含めることができます。"],["Variables:<br>","変数:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : ソース言語</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : ターゲット言語</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : ソース言語の完全な名前</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : ターゲット言語の完全な名前</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : ソーステキスト</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : エスケープアルゴリズムの事前定義メッセージ。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 改行を表す文字列（行の代替）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : バッチ内のメッセージ数。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : アクターの情報を追加します。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 前の数行をコンテキストとして含めます</li>"],["Body Message Template","本文メッセージテンプレート"],["Template of the body of your chat.","チャットの本文のテンプレート。"],["Sample conversation","サンプル会話"],["User message","ユーザーメッセージ"],["Assistant's response","アシスタントの応答"],["Enable JailBreak","ジェイルブレイクを有効にする"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","翻訳のためのジェイルブレイクを有効にします。これにより、翻訳がより正確で偏りが少なくなります。一部のモデルは架空の出来事を現実の出来事に関連付けようとするため、独自の物語に合わせて翻訳を変更しようとすることがあります。このオプションはそれを防ぎます。"],["Jailbreak Template","ジェイルブレイクテンプレート"],["Template of the Jailbreak message.","ジェイルブレイクメッセージのテンプレート。"],["Maximum Tokens","最大トークン数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","生成するトークンの最大数。<br>プロンプトのトークン数と最大トークン数の合計は、モデルのコンテキスト長を超えることはできません。ほとんどのモデルは2048トークンのコンテキスト長を持っています（最新のモデルを除き、4096をサポートします）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用するサンプリング温度を0から2の間で指定します。0.8のような高い値は出力をよりランダムにし、0.2のような低い値はより焦点を絞り、決定論的にします。<br>OpenAIは通常、これを変更するかtop_pを変更することを推奨しますが、両方を変更することは推奨しません。"],["Nucleus sampling (top_p)","核サンプリング（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度サンプリングに代わる核サンプリングで、モデルはtop_p確率質量を持つトークンの結果を考慮します。したがって、0.1は上位10%の確率質量を構成するトークンのみが考慮されることを意味します。<br>OpenAIは通常、これを変更するか温度を変更することを推奨しますが、両方を変更することは推奨しません。"],["Frequency Penalty","頻度ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内での既存の頻度に基づいて新しいトークンにペナルティを課し、モデルが同じ行を逐語的に繰り返す可能性を減らします。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内に既に出現しているかどうかに基づいて新しいトークンにペナルティを課し、モデルが新しいトピックについて話す可能性を高めます。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Custom Parameter","カスタムパラメータ"],["Key","キー"],["Value","値"],["Type","タイプ"],["Type of the value.","値のタイプ。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b>タイプの場合、値はJavaScriptコードとして評価されます。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScriptコードのスコープは<code>window</code>です。したがって、ほぼすべての値を取得できます。"],["Example: <code>trans.project.title</code>","例: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","APIに送信されないパラメータを削除します。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI APIは常に変化しており、新しいモデルは古いパラメータをサポートせず、認識されないリクエストパラメータに対してHTTPエラーを返す場合があります。"],["You can drop the parameters that are not supported by the model here.","モデルでサポートされていないパラメータはここで削除できます。"],["Batch API settings","バッチAPI設定"],["General","一般"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAIバッチAPIを使用すると、プロジェクトを非同期で翻訳でき、コストが50%削減されます。つまり、翻訳結果を<b style=\"color:red\">24時間以内</b>に<b style=\"color:blue\">通常の半額</b>で受け取れます。これは、即時の翻訳結果を必要としない大規模プロジェクトに特に有用です。"],[" <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />"," <br />バッチAPIについて詳しくは<a href=\"https://platform.openai.com/docs/guides/batch\" external>こちら</a>をご覧ください。<br />"],[" <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>"," <br />サポートされているサービス: <b>OpenAI</b>と<b>Gemini</b>"],["<h2>More configurations are found in Addon Settings</h2>","<h2>その他の設定はアドオン設定にあります</h2>"],["Open Add-on Settings","アドオン設定を開く"],["Import Configuration from OpenAI Setting","OpenAI設定から構成をインポート"],["General Settings","一般設定"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>推論モデルにお金を無駄にしないでください</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>様々な研究により、推論モデルは創造的な文章作成や翻訳タスクにおいて通常のモデルよりもはるかに劣ることが証明されています。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>推論モデルを使用すると、より高価なコストと遅い応答時間以外に何も得られません。</p>"],["<h2>If you're using OpenAI</h2>","<h2>OpenAIを使用している場合</h2>"],["OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />","OpenAIバッチAPIは、標準APIとは少し異なるモデル命名規則を使用します。バッチモードのモデルには-batchサフィックスが含まれます。例えば、<code>gpt-4.1-mini</code>を指定すると、自動的に<code>gpt-4.1-mini-batch</code>と解釈されます。<br />"],["However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />","ただし、このアドオンが開発された時点では、バッチモデルはOpenAIのモデル使用制限のリストに含まれていませんでした。これは、モデル使用フィルターを「許可」（ホワイトリスト）に設定したユーザーがバッチAPIにアクセスできないことを意味します。<br />"],["Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.","モデルの使用制限を変更するには<a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>こちら</a>をクリックしてください。"],["Explore more models","他のモデルを探す"],["Append actor name to the translatable text","翻訳可能なテキストに役者名を追加"],["Ignore translated rows","翻訳済み行を無視"],["Templates","テンプレート"],["<h2>1. System Message</h2>","<h2>1. システムメッセージ</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>ここで、アシスタントにその役割を説明できます。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良いまたは悪い応答のサンプルを書いて、翻訳者が目的と会話の文脈を理解するのに役立てられます。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 実際のプロンプト</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>これはアシスタントへの実際のプロンプトです。</p>"],["Enable Jailbreak","ジェイルブレイクを有効化"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は翻訳の品質を向上させるために各アイテムのバッチごとに読み込まれます。この機能はプロンプトを膨らませないように、関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","役者の追加情報の列"],["Enable context","コンテキストを有効化"],["Advanced","詳細設定"],["Custom Parameters","カスタムパラメータ"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat APIリクエストボディにカスタムパラメータを追加できます。これは、フォームで利用できない追加パラメータを追加したい場合に便利です。"],["<h2>Warning</h2>","<h2>警告</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>カスタムパラメータを誤って設定すると、APIリクエストが失敗する可能性があります。カスタムパラメータを追加する前に、自分が何をしているのか確認してください。OpenAIなどの一部のサービスは送信するパラメータに厳格で、認識されないリクエストパラメータに対してHTTPエラーを返します。</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>同じキーが複数回使用された場合、最後の値のみが使用されます。</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>既存の設定で同じキーが使用されている場合、既存の設定パラメータはカスタムパラメータによって上書きされます。</li>"],["String","文字列"],["Number","数値"],["Boolean","ブール値"],["JavaScript","JavaScript"],["Drop Parameters","パラメータを削除"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>オーバーヘッドコスト</h3>\n                        オーバーヘッドコストは、実際の翻訳テキストなしでアシスタントに送信するプロンプトメッセージのコストです。コストはプロンプトメッセージ内のトークン数に基づいて計算されます。トークン数が多いほど、コストは高くなります。<br>\n                        <b>推定オーバーヘッドコスト:</b> <span class=\"overheadCost\">0</span> トークン / リクエスト。"],["Are you sure you want to reset the form?","フォームをリセットしてもよろしいですか？"],["Translate with Batch API","バッチAPIで翻訳"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","バッチを処理してもよろしいですか？\nこの操作にはコストが発生します。"],["The batch is successfully created. Do you want to open the batch manager?","バッチが正常に作成されました。バッチマネージャーを開きますか？"],["Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.","OpenAI設定から設定をインポートしてもよろしいですか？これにより現在の設定が上書きされます。"],["chatGPT engine is not found","chatGPTエンジンが見つかりません"],["Configuration imported successfully.","設定が正常にインポートされました。"],["Batch API Queue","バッチAPIキュー"]],"context":[["tid/414/type/StringLiteral"],["tid/424/type/NoSubstitutionTemplate"],["tid/483/type/StringLiteral"],["tid/493/type/StringLiteral"],["tid/531/type/StringLiteral"],["tid/541/type/NoSubstitutionTemplate"],["tid/580/type/StringLiteral"],["tid/590/type/StringLiteral"],["tid/629/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/689/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/739/type/StringLiteral"],["tid/782/type/StringLiteral","tid/3377/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/799/type/StringLiteral"],["tid/838/type/StringLiteral","tid/3408/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/887/type/StringLiteral"],["tid/897/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/946/type/StringLiteral"],["tid/985/type/StringLiteral"],["tid/995/type/StringLiteral"],["tid/1040/type/StringLiteral"],["tid/1050/type/StringLiteral"],["tid/1058/type/StringLiteral"],["tid/1066/type/StringLiteral"],["tid/1079/type/StringLiteral"],["tid/1087/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1111/type/StringLiteral"],["tid/1119/type/StringLiteral"],["tid/1127/type/StringLiteral"],["tid/1135/type/StringLiteral"],["tid/1143/type/StringLiteral"],["tid/1151/type/StringLiteral"],["tid/1159/type/StringLiteral"],["tid/1167/type/StringLiteral"],["tid/1175/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1237/type/StringLiteral"],["tid/1296/type/StringLiteral"],["tid/1325/type/StringLiteral"],["tid/1351/type/StringLiteral"],["tid/1395/type/StringLiteral"],["tid/1405/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1454/type/StringLiteral"],["tid/1494/type/StringLiteral"],["tid/1504/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1573/type/StringLiteral"],["tid/1632/type/StringLiteral"],["tid/1642/type/StringLiteral"],["tid/1701/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1771/type/StringLiteral"],["tid/1781/type/StringLiteral"],["tid/1857/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1913/type/StringLiteral"],["tid/1940/type/StringLiteral"],["tid/1968/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/1991/type/StringLiteral"],["tid/2030/type/StringLiteral"],["tid/2037/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2086/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2161/type/NoSubstitutionTemplate"],["tid/2173/type/NoSubstitutionTemplate"],["tid/2181/type/NoSubstitutionTemplate"],["tid/2205/type/NoSubstitutionTemplate"],["tid/2227/type/StringLiteral"],["tid/2239/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2341/type/NoSubstitutionTemplate"],["tid/2349/type/NoSubstitutionTemplate"],["tid/2357/type/NoSubstitutionTemplate"],["tid/2380/type/StringLiteral"],["tid/2387/type/NoSubstitutionTemplate"],["tid/2391/type/NoSubstitutionTemplate"],["tid/2395/type/NoSubstitutionTemplate"],["tid/2569/type/StringLiteral"],["tid/2769/type/StringLiteral"],["tid/2793/type/StringLiteral"],["tid/2848/type/StringLiteral"],["tid/2881/type/StringLiteral"],["tid/2888/type/StringLiteral"],["tid/2933/type/StringLiteral"],["tid/2940/type/StringLiteral"],["tid/3153/type/StringLiteral"],["tid/3160/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3314/type/StringLiteral"],["tid/3347/type/StringLiteral"],["tid/3354/type/StringLiteral"],["tid/3439/type/StringLiteral"],["tid/3463/type/StringLiteral"],["tid/3502/type/StringLiteral"],["tid/3774/type/StringLiteral"],["tid/3807/type/StringLiteral"],["tid/3830/type/StringLiteral"],["tid/3841/type/StringLiteral"],["tid/3848/type/StringLiteral"],["tid/3855/type/StringLiteral"],["tid/3965/type/StringLiteral"],["tid/3975/type/StringLiteral"],["tid/3985/type/StringLiteral"],["tid/3995/type/StringLiteral"],["tid/4051/type/StringLiteral"],["tid/4185/type/NoSubstitutionTemplate"],["tid/4435/type/StringLiteral"],["tid/4581/type/StringLiteral"],["tid/8938/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9838/type/StringLiteral"],["tid/9883/type/StringLiteral"],["tid/10067/type/StringLiteral","tid/10130/type/StringLiteral"],["tid/10328/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"batchAPI.js","path":"/addons/transLLMBatchApi/batchAPI.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"Your API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The model for your translation.":5,"Source Column":6,"The column of the original texts you want to translate.":7,"Add actor name":8,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":9,"Ignore if already translated":10,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":11,"Filter Tag":12,"If set, only rows with this tag will be translated.":13,"Load Actor Reference as Glossary":14,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":15,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":16,"Actor Reference Translation Column":17,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":18,"Actor's Information Column":19,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":20,"Enable Context":21,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":22,"Context Character Limit":23,"Character limit for the context.":24,"System Message Template":25,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":26,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":27,"Variables:<br>":28,"<li>LANG_FROM : Source language</li>":29,"<li>LANG_TO : Target language</li>":30,"<li>LANG_FROM_FULL : Full source language name</li>":31,"<li>LANG_TO_FULL : Full target language name</li>":32,"<li>SOURCE_TEXT : Source text</li>":33,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":34,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":35,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":36,"<li>ACTOR_INFO : Add information of the actors.</li>":37,"<li>TITLE : Title of the game</li>":38,"<li>ENGINE : Engine of the game</li>":39,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":40,"<li>CONTEXT : Include some previous lines as a context</li>":41,"Body Message Template":42,"Template of the body of your chat.":43,"Sample conversation":44,"User message":45,"Assistant's response":46,"Enable JailBreak":47,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":48,"Jailbreak Template":49,"Template of the Jailbreak message.":50,"Maximum Tokens":51,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":52,"Temperature":53,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":54,"Nucleus sampling (top_p)":55,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":56,"Frequency Penalty":57,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":58,"Presence Penalty":59,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":60,"Custom Parameter":61,"Key":62,"Value":63,"Type":64,"Type of the value.":65,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":66,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":67,"Example: <code>trans.project.title</code>":68,"Drop parameters that will not be sent to the API.<br />":69,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":70,"You can drop the parameters that are not supported by the model here.":71,"Batch API settings":72,"General":73,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":74," <br />Read more about the Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.<br />":75," <br />Supported services: <b>OpenAI</b> and <b>Gemini</b>":76,"<h2>More configurations are found in Addon Settings</h2>":77,"Open Add-on Settings":78,"Import Configuration from OpenAI Setting":79,"General Settings":80,"<h2>Don't waste your money on Reasoning Models</h2>":81,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":82,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":83,"<h2>If you're using OpenAI</h2>":84,"OpenAI Batch API uses a slightly different model naming convention compared to the standard API. Models in Batch Mode include a -batch suffix. For instance, if you specify <code>gpt-4.1-mini</code>, it will automatically be interpreted as <code>gpt-4.1-mini-batch</code>.<br />":85,"However, at the time this add-on was developed, batch models were not listed under OpenAI’s model usage limits. This means users who have set their Model Usage filter to “Allow” (whitelist) won't be able to access the Batch API.<br />":86,"Click <a href=\"https://platform.openai.com/settings/proj_xxx/limits\" external>here</a> to change the model's usage limits.":87,"Explore more models":88,"Append actor name to the translatable text":89,"Ignore translated rows":90,"Templates":91,"<h2>1. System Message</h2>":92,"<p>Here you can explain to the assistant, what is their role.</p>":93,"<h2>2. Sample dialogue</h2>":94,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":95,"<h2>3. Your actual prompt</h2>":96,"<p>This is the actual prompt to the assistant.</p>":97,"Enable Jailbreak":98,"Glossary":99,"<h2>Glossary</h2>":100,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":101,"The Column of Actor's Additional Information":102,"Enable context":103,"Advanced":104,"Custom Parameters":105,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":106,"<h2>Warning</h2>":107,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":108,"<li>If the same key is used multiple times, only the last value will be used.</li>":109,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":110,"String":111,"Number":112,"Boolean":113,"JavaScript":114,"Drop Parameters":115,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":116,"Are you sure you want to reset the form?":117,"Translate with Batch API":118,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":119,"The batch is successfully created. Do you want to open the batch manager?":120,"Are you sure you want to import configuration from OpenAI settings? This will overwrite the current configuration.":121,"chatGPT engine is not found":122,"Configuration imported successfully.":123,"Batch API Queue":124},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","翻訳を適用する行を選択してください"],["Target Column","ターゲット列"],["The column to put the translation result.","翻訳結果を配置する列。"],["Import translation from ChatGPT Batch","ChatGPTバッチから翻訳をインポート"],["Translation applied to selected rows","選択した行に翻訳を適用しました"],["Invalid format","無効な形式"],["OK","OK"],["Mismatch","不一致"],["Failed to load batch list with error: \n","エラーでバッチリストの読み込みに失敗しました：\n"],["Download Error File","エラーファイルをダウンロード"],["Batch is not completed yet","バッチはまだ完了していません"],["Are you sure you want to cancel this batch?","このバッチをキャンセルしてもよろしいですか？"],["Cannot cancel completed batch.","完了したバッチはキャンセルできません。"],["Batch cancelled","バッチがキャンセルされました"],["Failed to cancel batch","バッチのキャンセルに失敗しました"]],"context":[["tid/3027/type/StringLiteral"],["tid/3072/type/StringLiteral","tid/12550/type/StringLiteral"],["tid/3082/type/StringLiteral","tid/12560/type/StringLiteral"],["tid/3156/type/StringLiteral","tid/12634/type/StringLiteral"],["tid/3496/type/StringLiteral"],["tid/3926/type/StringLiteral"],["tid/3958/type/StringLiteral","tid/4037/type/StringLiteral"],["tid/4005/type/StringLiteral"],["tid/7881/type/StringLiteral","tid/8155/type/StringLiteral"],["tid/10164/type/StringLiteral"],["tid/12498/type/StringLiteral"],["tid/14441/type/StringLiteral"],["tid/14519/type/StringLiteral"],["tid/14577/type/StringLiteral"],["tid/14594/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html":{"data":[["Batches","バッチ"],["Apply translation","翻訳を適用"],["Cancel batch","バッチをキャンセル"],["Status","ステータス"],["Batch ID","バッチID"],["Input File ID","入力ファイルID"],["End point","エンドポイント"],["Created at","作成日時"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","有効期限 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了リクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストで消費されたトークンに対して課金されます。\"></i>"],["Completed at","完了日時"],["Errors","エラー"],["Batch Item Detail of","のバッチアイテム詳細"],["ID","ID"],["Completed on","完了日"],["Model","モデル"],["Prompt Token","プロンプトトークン"],["Completion Token","完了トークン"],["Total Token","合計トークン"],["Status Code","ステータスコード"],["error","エラー"],["Conversation","会話"],["Response Validation","応答検証"],["Raw Payload","生ペイロード"],["View raw payload","生ペイロードを表示"],["Response Preview","応答プレビュー"],["Apply translations from selected rows","選択した行から翻訳を適用"],["Here you can edit the translation result individually and send it into Translator++","ここでは翻訳結果を個別に編集し、Translator++に送信できます"],["Open ChatGPT Settings","ChatGPT設定を開く"],["Help","ヘルプ"],["File list","ファイルリスト"],["Collapse / restore left panel","左パネルを折りたたむ/復元"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了リクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストで消費されたトークンに対して課金されます。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transLLMBatchApi/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transLLMBatchApi/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/options.js":{"data":[["Service Name","サービス名"],["Service provider for your Batch API.","バッチAPIのサービスプロバイダーです。"],["API Key","APIキー"],["Please enter your API key for the Batch API service.","Batch APIサービスのAPIキーを入力してください。"],["Model","モデル"],["The pre-trained model","事前学習済みモデル"],["In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","ChatGPTでは、使用可能なモデルを設定する必要がある場合があります（https://platform.openai.com/settings/proj_xxx/limits）。"],["Enable JailBreak","ジェイルブレイクを有効化"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","翻訳のジェイルブレイクを有効化します。これにより、翻訳がより正確で偏りが少なくなります。一部のモデルは架空の出来事を現実の出来事に関連付けようとするため、独自の物語に合わせて翻訳を変更しようとすることがあります。このオプションはそれを防ぎます。"],["Jailbreak Template","ジェイルブレイクテンプレート"],["Template of the Jailbreak message.","ジェイルブレイクメッセージのテンプレート。"],["Maximum Tokens","最大トークン数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","生成するトークンの最大数。<br>プロンプトのトークン数とmax_tokensの合計は、モデルのコンテキスト長を超えることはできません。ほとんどのモデルは2048トークンのコンテキスト長を持っています（最新のモデルを除き、4096をサポート）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用するサンプリング温度、0から2の間。0.8のような高い値は出力をよりランダムにし、0.2のような低い値はより集中して確定的にします。<br>OpenAIは通常、これまたはtop_pのいずれかを変更することを推奨していますが、両方は推奨しません。"],["Nucleus sampling (top_p)","核サンプリング（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度サンプリングの代替として、核サンプリングと呼ばれる方法で、モデルはtop_p確率質量を持つトークンの結果を考慮します。つまり、0.1は上位10%の確率質量を構成するトークンのみが考慮されることを意味します。<br>OpenAIは通常、これまたは温度のいずれかを変更することを推奨していますが、両方は推奨しません。"],["Frequency Penalty","頻度ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内での既存の頻度に基づいて新しいトークンにペナルティを課し、モデルが同じ行を逐語的に繰り返す可能性を減らします。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内に既に出現しているかどうかに基づいて新しいトークンにペナルティを課し、モデルが新しいトピックについて話す可能性を高めます。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Max Characters per Batch","バッチあたりの最大文字数"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","翻訳バッチごとの最大文字数制限。\nこのオプションは、プロンプトメッセージの文字数ではなく、元のテキストの文字数のみをカウントします。"],["Max row per concurrent requests","同時リクエストあたりの最大行数"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","各同時リクエストで許可される行数。<b>0</b>に設定するとこの機能を無効にします。<br />このオプションが無効の場合、<b>最大同時リクエスト数</b>をいくら設定しても、Translator++はリクエストを単一のチャンクとして処理します。<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","設定する行数が多いほど、単一バッチで取得できる翻訳が増え、オーバーヘッドコストが削減されますが、AIがエラー結果を返す可能性も高まります。<br />数値が低いほど、翻訳エラーの可能性は低くなりますが、オーバーヘッドプロンプトの追加コストが発生します。"],["Code Escaping Algorithm","コードエスケープアルゴリズム"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","対話内のインラインコード用のエスケープアルゴリズム。選択したエスケープアルゴリズムに応じて、<b>システムメッセージテンプレート</b>と<b>本文メッセージテンプレート</b>を変更する必要がある場合があります。<br /><b>JSONCloaking</b>を選択すると、response_format: { type: 'json_object' }パラメータがChatGPTに自動的に送信されます。<b>JSONCloaking</b>は非常に正確ですが、すべてのモデルで動作するわけではありません。<b>gpt-3.5-turbo-1106</b>をお試しください。"],["The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.","<b>バッチAPI</b>を使用すると、一度に多くのリクエストを送信でき、それらはバックグラウンドで非同期に処理されます。結果はすぐには受け取れませんが、プロセスは<b>24時間以内に完了します</b>—多くの場合、もっと早く終わります。この方法は<b>標準的なアプローチの半分のコストしかかかりません</b>。"],["Batch API settings","バッチAPI設定"],["General","一般"],["Explore more models","その他のモデルを探索"],["Templates","テンプレート"],["Enable Jailbreak","ジェイルブレイクを有効化"],["Advanced","詳細設定"],["Batch Translation Setting","バッチ翻訳設定"],["Default","デフォルト"],["JavaScript template cloaking","JavaScriptテンプレートクローキング"],["None (no escaping)","なし（エスケープなし）"]],"context":[["tid/413/type/StringLiteral"],["tid/423/type/NoSubstitutionTemplate"],["tid/479/type/StringLiteral"],["tid/489/type/StringLiteral"],["tid/529/type/StringLiteral"],["tid/539/type/StringLiteral"],["tid/546/type/NoSubstitutionTemplate"],["tid/625/type/StringLiteral"],["tid/635/type/StringLiteral"],["tid/669/type/StringLiteral"],["tid/679/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/726/type/StringLiteral"],["tid/782/type/StringLiteral"],["tid/792/type/StringLiteral"],["tid/848/type/StringLiteral"],["tid/858/type/StringLiteral"],["tid/914/type/StringLiteral"],["tid/924/type/StringLiteral"],["tid/981/type/StringLiteral"],["tid/991/type/StringLiteral"],["tid/1054/type/StringLiteral"],["tid/1064/type/StringLiteral"],["tid/1122/type/StringLiteral"],["tid/1132/type/StringLiteral"],["tid/1139/type/StringLiteral"],["tid/1217/type/StringLiteral"],["tid/1227/type/StringLiteral"],["tid/1382/type/StringLiteral"],["tid/1406/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1896/type/StringLiteral"],["tid/2069/type/StringLiteral"],["tid/2578/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2786/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"options.js","path":"/addons/transLLMBatchApi/options.js","indexIsBuilt":true,"indexIds":{"Service Name":0,"Service provider for your Batch API.":1,"API Key":2,"Please enter your API key for the Batch API service.":3,"Model":4,"The pre-trained model":5,"In ChatGPT, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":6,"Enable JailBreak":7,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":8,"Jailbreak Template":9,"Template of the Jailbreak message.":10,"Maximum Tokens":11,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":12,"Temperature":13,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":14,"Nucleus sampling (top_p)":15,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":16,"Frequency Penalty":17,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":18,"Presence Penalty":19,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":20,"Max Characters per Batch":21,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":22,"Max row per concurrent requests":23,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":24,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":25,"Code Escaping Algorithm":26,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b>, response_format: { type: 'json_object' } parameter will be sent to ChatGPT automatically. <b>JSONCLoaking</b> is very acurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":27,"The <b>Batch API</b> allows you to submit many requests at once, which are processed asynchronously in the background. You won’t receive results immediately, but the process <b>will be completed within 24 hours</b>—and often much faster. This method <b>costs only half as much as the standard approach</b>.":28,"Batch API settings":29,"General":30,"Explore more models":31,"Templates":32,"Enable Jailbreak":33,"Advanced":34,"Batch Translation Setting":35,"Default":36,"JavaScript template cloaking":37,"None (no escaping)":38},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : アクター情報の用語集。（バッチモードでアクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答の例を書くことで、翻訳者が目的や会話のコンテキストを理解するのに役立ちます。</p>"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチごとにファイルを常に分離します。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれます。"],["Add actor name","役者名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報から役者名を翻訳可能なテキストに追加します。これにより、翻訳者が対話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果から役者名を削除します。これは明らかに翻訳コストを増加させます。"],["Load Actor Reference as Glossary","役者参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++は役者参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解するのに役立ちます。役者参照は対話中の役者の名前です。これは用語集として翻訳者に読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチ項目の用語集として読み込まれます。プロンプトメッセージで役者参照を読み込むには、テンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合は、プロンプトテンプレートに<code>ACTOR_INFO</code>変数を含めて、キャラクター情報データを配置する必要もあります。"],["Actor Reference Translation Column","役者参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","役者名の翻訳の列。この列は役者参照の翻訳として使用され、会話中の役者名の翻訳の一貫性を向上させます。"],["Actor's Information Column","役者の情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","役者の追加情報を含む列。性別、年齢などの詳細情報を入れることができ、会話中の代名詞の翻訳を向上させます。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプト。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["General Settings","一般設定"],["Always separate file for each batch","バッチごとに常に別ファイル"],["Append actor name to the translatable text","翻訳可能なテキストに役者名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチの項目ごとに読み込まれ、翻訳の品質を向上させます。プロンプトの肥大化を避けるため、関連する用語のみを読み込むように試みます。</p>"],["The Column of Actor's Additional Information","役者の追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transLLMBatchApi/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transLLMBatchApi/utility.js":{"data":[["Open Batch Manager","バッチマネージャーを開く"],["This feature is only available if you have a project open.","この機能はプロジェクトを開いている場合のみ利用可能です。"]],"context":[["tid/117/type/StringLiteral"],["tid/156/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transLLMBatchApi","extension":".js","filename":"utility.js","path":"/addons/transLLMBatchApi/utility.js","indexIsBuilt":true,"indexIds":{"Open Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transLitellm/options.js":{"data":[["LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>","LiteLLMのプロキシURL。あなたのLiteLLMプロキシのURLアドレス。デフォルトは：<code>http://localhost:8890/chat/completions</code>"],["API's base URL","APIのベースURL"],["The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.","選択したサービスのベースURL。カスタムエンドポイントURLを使用する場合のみこのフィールドを入力してください。LiteLLMは指定されたモデルに基づいてベースURLを自動検出します。<br />LiteLLMがURLにパスを追加する方法はサービスによって異なります。例えば、OpenAI互換エンドポイントの場合、LiteLLMは指定されたURLに<code>/chat/completions</code>を追加します。したがって、エンドポイントが<code>https://api.fast-tunnel.one/v1/chat/completions</code>の場合は、フィールドに<code>https://api.fast-tunnel.one/v1</code>を入力してください。"],["API Version","APIバージョン"],["Optional. The API version parameter needed for some services.","オプション。一部のサービスで必要なAPIバージョンパラメータ。"],["API Key","APIキー"],["Optional. The API key used for authenticating your access to the service.","オプション。サービスへのアクセス認証に使用するAPIキー。"],["Model","モデル"],["Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:","選択したモデルを事前学習します。LiteLLMモデルの便利な形式を使用して、希望するモデルを指定します。形式は{サービス名}/{モデル}です。例："],["your deployment name","デプロイメント名"],["However, some models have unique names that can be directly identified, like:","ただし、一部のモデルは直接識別できる固有の名前を持っています。例："],["Azure AD Token","Azure ADトークン"],["AWS Access Key ID","AWSアクセスキーID"],["AWS secret access key","AWSシークレットアクセスキー"],["Open router site URL","Open routerサイトURL"],["Open router APP name","Open routerアプリ名"],["Enable Context","コンテキストを有効にする"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","翻訳のコンテキストを有効にします。現在のバッチより上の以前に翻訳された内容がコンテキストとして含まれます。<b>テンプレートにCONTEXTを明示的に含める必要もあります</b>"],["Context Character Limit","コンテキスト文字数制限"],["Character limit for the context.","コンテキストの文字数制限。"],["System Message Template","システムメッセージテンプレート"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","システムメッセージは、chatGPTアシスタントの役割を伝えるメッセージのヘッダーです。このメッセージは、chatGPTに送信するすべてのバッチの最初のメッセージとして送信されます。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScriptのテンプレートリテラルスタイル<span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>で次の変数を含めることができます。"],["Variables:<br>","変数：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : ソース言語</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : ターゲット言語</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : ソーステキスト</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : エスケープアルゴリズムの事前定義メッセージ。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 改行を表す文字列（行の代替）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : バッチ内のメッセージ数。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : アクター情報の用語集。（バッチモードでアクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : Translator++オブジェクトから参照を生成。<br />例：<code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["User message","ユーザーメッセージ"],["Assistant's response","アシスタントの応答"],["Body Message Template","本文メッセージテンプレート"],["Template of the body of your message.","メッセージ本文のテンプレート。"],["Enable JailBreak","JailBreakを有効化"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","翻訳のJailbreakを有効化します。これにより、翻訳がより正確で偏りが少なくなります。一部のモデルは架空の出来事を現実の出来事に関連付けようとし、独自の物語に合わせて翻訳を変更しようとする可能性があります。このオプションはそれを防ぎます。"],["Jailbreak Template","Jailbreakテンプレート"],["Template of the Jailbreak message.","Jailbreakメッセージのテンプレート。"],["Maximum Tokens","最大トークン数"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","生成する完了トークンの最大数。<br>プロンプトのトークン数と最大トークン数の合計は、モデルのコンテキスト長を超えることはできません。ほとんどのモデルは2048トークンのコンテキスト長を持っています（最新モデルを除き、4096をサポート）。"],["Temperature","温度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用するサンプリング温度、0から2の間。0.8のような高い値は出力をよりランダムにし、0.2のような低い値はより焦点が絞られ決定論的になります。<br>OpenAIは通常、これを変更するかtop_pを変更することを推奨しますが、両方ではありません。"],["Nucleus sampling (top_p)","核サンプリング（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","温度サンプリングの代替として、核サンプリングと呼ばれるもので、モデルはtop_p確率質量を持つトークンの結果を考慮します。したがって0.1は、上位10%の確率質量を構成するトークンのみが考慮されることを意味します。<br>OpenAIは通常、これを変更するか温度を変更することを推奨しますが、両方ではありません。"],["Frequency Penalty","頻度ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内での既存の頻度に基づいて新しいトークンをペナルティし、モデルが同じ行を逐語的に繰り返す可能性を減らします。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在ペナルティ"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","-2.0から2.0の間の数値。正の値は、テキスト内に既に出現しているかどうかに基づいて新しいトークンをペナルティし、モデルが新しいトピックについて話す可能性を増加させます。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","JSONスキーマを使用"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","古い<code>json_object</code>の代わりに<code>response_format.type</code>フィールドに<code>json_schema</code>を使用します。<code>json_schema</code>は、最新モデルの一部や<b>LM Studio</b>のような一部のサーバーで必要ですが、古いモデルの一部はまだ<code>json_object</code>を使用しています。"],["Stop","停止"],["Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.","APIがそれ以上のトークンを生成を停止するキーワードを入力します。各エントリは改行で区切ります。"],["Additional argument variables","追加の引数変数"],["Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params","サーバー起動時に追加される追加の引数変数。<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params"],["Batch Timeout","バッチタイムアウト"],["Timeout for each batch in milisecond","各バッチのタイムアウト（ミリ秒）"],["Max Request Length","最大リクエスト長"],["The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.","各翻訳バッチの最大文字長。\n各翻訳者は異なる仕様を持っています。\nGETパラメータを使用するWEBフロントエンド翻訳者には2000未満を推奨します。"],["Max concurrent requests","最大同時リクエスト数"],["How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.","同時に接続を許可するリクエストの数。<b>0</b>に設定するとこの機能を無効にします。<br />このオプションを<b>最大行数/同時リクエスト</b>と組み合わせて翻訳速度を向上させます。"],["Max row per concurrent requests","最大行数/同時リクエスト"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.","各同時リクエストで許可される行数。<b>0</b>に設定するとこの機能を無効にします。<br />このオプションが無効の場合、<b>最大同時リクエスト数</b>をいくら設定しても、Translator++はリクエストを単一のチャンクとして処理します。"],["Batch delay","バッチ遅延"],["Delay between batch (in miliseconds)","バッチ間の遅延（ミリ秒）"],["Code Escaping Algorithm","コードエスケープアルゴリズム"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.","ダイアログ内のインラインコードのエスケープアルゴリズム。選択したエスケープアルゴリズムに応じて<b>システムメッセージテンプレート</b>と<b>本文メッセージテンプレート</b>を変更する必要がある場合があります。"],["Number of retry","リトライ回数"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","翻訳出力の検証が失敗した場合にエンジンがリトライする回数。nullish（空）の場合、リトライしません。"],["Retry when the number of translated rows doesn't match original","翻訳行数が元の行数と一致しない場合にリトライ"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","有効にすると、モデルが返す翻訳行数が元のペイロードと異なる場合にエンジンがリトライします。"],["Retry when the number of lines for each translated row doesn't match original","各翻訳行の行数が元の行数と一致しない場合にリトライ"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","有効にすると、翻訳行のいずれかの行数が元の行と異なる場合にエンジンがリトライします。"],["Prompt: Row count mismatch","プロンプト：行数不一致"],["Prompt used when retrying due to row/element count mismatch.","行数/要素数不一致によるリトライ時に使用するプロンプト。"],["Prompt: Line count mismatch","プロンプト：行数不一致（各行）"],["Prompt used when retrying due to per-row line count mismatch.","各行の行数不一致によるリトライ時に使用するプロンプト。"],["Prompt: Error / Retry instruction","プロンプト：エラー/リトライ指示"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry.","不一致プロンプトの後に追加され、モデルにリトライを指示するプロンプト。"],["Custom Parameter","カスタムパラメータ"],["Key","キー"],["Value","値"],["Type","タイプ"],["Type of the value.","値のタイプ。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","<b>javascript</b>タイプの場合、値はJavaScriptコードとして評価されます。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScriptコードのスコープは<code>window</code>です。したがって、ほぼ任意の値を取得できます。"],["<br />Example: <code>trans.project.title</code>","<br />例: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","APIに送信されないパラメータを削除します。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI APIは常に変化しており、新しいモデルは古いパラメータをサポートしない場合があり、認識されないリクエストパラメータに対してHTTPエラーを返すことがあります。"],["You can drop the parameters that are not supported by the model here.","ここでモデルがサポートしていないパラメータを削除できます。"],["Manage configuration","設定の管理"],["Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.","このエンジンの一部の機能にはChatGPTアドオンのインストールが必要です。このエンジンを使用する前に、ChatGPTアドオンがインストールされていることを確認してください。"],["Text Completion Setting","テキスト補完設定"],["General","一般"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>推論モデルにお金を無駄にしないでください</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>様々な研究により、推論モデルは創造的な執筆や翻訳タスクにおいて通常のモデルよりもはるかに劣ることが証明されています。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>推論モデルを使用すると、より高価なコストと遅い応答時間以外に何も得られません。</p>"],["Platform specific","プラットフォーム固有"],["Azure","Azure"],["AWS","AWS"],["Open Router","Open Router"],["Templates","テンプレート"],["Enable context","コンテキストを有効化"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話サンプル。良いまたは悪い応答のサンプルを記述して、翻訳者が目的と会話の文脈を理解するのを助けることができます。</p>"],["Retry prompts","リトライプロンプト"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>これらのプロンプトは、前回のモデル出力の直後に、追加の<b>ユーザー</b>メッセージとしてリトライ時に追加されます。</p>"],["<p>Available variables:</p>","<p>利用可能な変数:</p>"],["Enable Jailbreak","ジェイルブレイクを有効化"],["Advanced","詳細設定"],["Custom Parameters","カスタムパラメータ"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","OpenAI Chat API リクエストボディにカスタムパラメータを追加できます。フォームで利用できない追加パラメータを追加したい場合に便利です。"],["<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>","<h2>警告</h2><ul><li>カスタムパラメータを誤って設定すると、APIリクエストが失敗する可能性があります。カスタムパラメータを追加する前に、何をしているか理解していることを確認してください。OpenAIなどの一部のサービスは送信するパラメータに厳格で、認識されないリクエストパラメータに対してHTTPエラーを返します。</li><li>同じキーが複数回使用された場合、最後の値のみが使用されます。</li><li>既存の設定で同じキーが使用されている場合、既存の設定パラメータはカスタムパラメータによって上書きされます。</li></ul>"],["Drop Parameters","パラメータを削除"],["LiteLLM Proxy Configuration","LiteLLM プロキシ設定"],["Start LiteLLM server","LiteLLM サーバーを起動"],["Processing...","処理中..."],["Server started on port ","サーバーがポート "],["Check LiteLLM Status","LiteLLM ステータスを確認"],["Change LiteLLM Version","LiteLLMバージョンの変更"],["Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ","インストールするLiteLLMの新しいバージョンを入力してください。\n動作確認済みのバージョン: 1.38.0, 1.49.4 \n推奨バージョンは: "],["Are you sure you want to install LiteLLM version ","LiteLLMバージョン "],["Failed to install LiteLLM. Please check the console for more details.","をインストールしてもよろしいですか？"],["LiteLLM has been successfully updated to version ","LiteLLMのインストールに失敗しました。詳細はコンソールを確認してください。"],["Batch Translation Setting","LiteLLMはバージョン "],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","に正常に更新されました。"],["Retries and Refinement","バッチ翻訳設定"],["<h2>Retries and Refinement</h2>","申し訳ありませんが、このアドオンはアクティブなパトロンのみ利用可能です。\n$1のパトロンになることでこの機能をアンロックできます。"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","リトライと改善"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<h2>リトライと改善</h2>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p>翻訳出力が検証に失敗した場合、Translator++はモデルに翻訳をリトライさせることができます。モデルが何回リトライするか、またリトライの条件を設定できます。</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>適切なリトライ条件と適切な回数を設定することで、コストと時間を抑えつつ、翻訳品質を大幅に向上させることができます。</p>"],["<h2>Code Escaping Algorithm</h2>","<p><b>各リトライは追加の時間と費用がかかります</b>。バッチが頻繁にリトライする場合は、モデルへの指示をより明確にするためにプロンプトを調整することをお勧めします。</p>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>開発者ツールまたはバッチマネージャーを使用してバッチ翻訳をデバッグしてください。</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<h2>コードエスケープアルゴリズム</h2>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>コードエスケープは、対話内のコードスニペットがMTLによって変更されるのを防ぐ技術です。これは、対話にHTMLタグ、XMLタグ、JSONオブジェクト、JavaScriptテンプレートなどのコードスニペットが含まれている場合に便利です。</p>"],["JavaScript template cloaking","<p>対話内のコードスニペットに一致するエスケープアルゴリズムを選択してください。<b>システムメッセージ</b>、<b>サンプルプロンプト</b>、<b>本文メッセージ</b>テンプレートを適宜調整する必要があるかもしれません。</p>"],["None (no escaping)","<p>コードエスケープアルゴリズムとその効果的な使用方法について詳しくは<a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>こちら</a>をクリックしてください。</p>"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","JavaScriptテンプレートの隠蔽"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","常に各バッチごとにファイルを分離します。これにより、各ファイルのコンテキストが他のファイルで汚染されないように保つことができます。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が対話と代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話のコンテキストを理解しやすくなります。アクター参照は対話中のアクターの名前です。これは用語集として翻訳者に読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチ項目の用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むには、テンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合、<code>ACTOR_INFO</code>変数をプロンプトテンプレートに含めて、キャラクター情報データを配置する必要もあります。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話中のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの詳細情報を入れることができ、会話中の代名詞の翻訳を向上させます。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプト。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["General Settings","一般設定"],["Always separate file for each batch","各バッチで常にファイルを分離"],["Append actor name to the translatable text","翻訳可能なテキストにアクター名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチの項目に対して読み込まれ、翻訳の品質を向上させます。この機能は、プロンプトを膨らませないように、関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","アクターの追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/576/type/StringLiteral"],["tid/618/type/StringLiteral"],["tid/628/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/680/type/StringLiteral"],["tid/722/type/StringLiteral"],["tid/732/type/StringLiteral"],["tid/768/type/StringLiteral"],["tid/782/type/NoSubstitutionTemplate"],["tid/790/type/StringLiteral"],["tid/798/type/NoSubstitutionTemplate"],["tid/880/type/StringLiteral"],["tid/923/type/StringLiteral"],["tid/966/type/StringLiteral"],["tid/1009/type/StringLiteral"],["tid/1052/type/StringLiteral","tid/1062/type/StringLiteral"],["tid/1103/type/StringLiteral"],["tid/1113/type/StringLiteral"],["tid/1146/type/StringLiteral"],["tid/1156/type/StringLiteral"],["tid/1190/type/StringLiteral"],["tid/1200/type/StringLiteral"],["tid/1208/type/StringLiteral"],["tid/1216/type/StringLiteral"],["tid/1229/type/StringLiteral","tid/1492/type/StringLiteral"],["tid/1237/type/StringLiteral","tid/1500/type/StringLiteral"],["tid/1245/type/StringLiteral","tid/1508/type/StringLiteral"],["tid/1253/type/StringLiteral","tid/1516/type/StringLiteral"],["tid/1261/type/StringLiteral","tid/1524/type/StringLiteral"],["tid/1269/type/StringLiteral"],["tid/1277/type/StringLiteral","tid/8920/type/StringLiteral"],["tid/1285/type/StringLiteral","tid/8928/type/StringLiteral"],["tid/1293/type/StringLiteral","tid/8936/type/StringLiteral"],["tid/1301/type/StringLiteral","tid/8944/type/StringLiteral"],["tid/1309/type/StringLiteral","tid/8952/type/StringLiteral"],["tid/1378/type/StringLiteral"],["tid/1407/type/StringLiteral"],["tid/1433/type/StringLiteral"],["tid/1469/type/StringLiteral"],["tid/1479/type/StringLiteral"],["tid/1571/type/StringLiteral"],["tid/1581/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1625/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1672/type/StringLiteral"],["tid/1728/type/StringLiteral"],["tid/1738/type/StringLiteral"],["tid/1794/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1870/type/StringLiteral"],["tid/1927/type/StringLiteral"],["tid/1937/type/StringLiteral"],["tid/1994/type/StringLiteral","tid/5919/type/StringLiteral"],["tid/2004/type/StringLiteral"],["tid/2044/type/StringLiteral"],["tid/2054/type/StringLiteral"],["tid/2091/type/StringLiteral"],["tid/2101/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2148/type/StringLiteral"],["tid/2181/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2247/type/StringLiteral"],["tid/2257/type/StringLiteral"],["tid/2315/type/StringLiteral"],["tid/2325/type/StringLiteral"],["tid/2383/type/StringLiteral"],["tid/2393/type/StringLiteral"],["tid/2433/type/StringLiteral"],["tid/2443/type/StringLiteral"],["tid/2524/type/StringLiteral","tid/7772/type/StringLiteral"],["tid/2534/type/StringLiteral","tid/7782/type/StringLiteral"],["tid/2583/type/StringLiteral","tid/7947/type/StringLiteral"],["tid/2593/type/StringLiteral","tid/7957/type/StringLiteral"],["tid/2635/type/StringLiteral","tid/8028/type/StringLiteral"],["tid/2645/type/StringLiteral","tid/8038/type/StringLiteral"],["tid/2687/type/StringLiteral"],["tid/2697/type/StringLiteral"],["tid/2739/type/StringLiteral"],["tid/2749/type/StringLiteral"],["tid/2791/type/StringLiteral"],["tid/2801/type/StringLiteral"],["tid/2861/type/StringLiteral"],["tid/2890/type/StringLiteral"],["tid/2917/type/StringLiteral"],["tid/2944/type/StringLiteral"],["tid/2972/type/StringLiteral"],["tid/2979/type/StringLiteral"],["tid/2986/type/StringLiteral"],["tid/2993/type/StringLiteral"],["tid/3032/type/StringLiteral"],["tid/3039/type/StringLiteral"],["tid/3046/type/StringLiteral"],["tid/3093/type/StringLiteral"],["tid/3332/type/NoSubstitutionTemplate"],["tid/3355/type/StringLiteral"],["tid/3401/type/StringLiteral"],["tid/3780/type/NoSubstitutionTemplate"],["tid/3788/type/NoSubstitutionTemplate"],["tid/3796/type/NoSubstitutionTemplate"],["tid/3886/type/StringLiteral"],["tid/3919/type/StringLiteral"],["tid/4013/type/StringLiteral"],["tid/4164/type/StringLiteral"],["tid/4316/type/StringLiteral"],["tid/4349/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4590/type/StringLiteral"],["tid/4898/type/StringLiteral"],["tid/4924/type/StringLiteral"],["tid/4931/type/StringLiteral"],["tid/5296/type/StringLiteral"],["tid/5469/type/StringLiteral"],["tid/5990/type/StringLiteral"],["tid/6023/type/StringLiteral"],["tid/6046/type/StringLiteral"],["tid/6292/type/StringLiteral"],["tid/6465/type/StringLiteral"],["tid/6573/type/StringLiteral"],["tid/6669/type/StringLiteral","tid/6858/type/StringLiteral","tid/7000/type/StringLiteral"],["tid/6710/type/StringLiteral"],["tid/6762/type/StringLiteral"],["tid/6921/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7131/type/StringLiteral"],["tid/7207/type/StringLiteral"],["tid/7226/type/StringLiteral"],["tid/7281/type/StringLiteral"],["tid/7402/type/StringLiteral"],["tid/7694/type/StringLiteral"],["tid/7720/type/StringLiteral"],["tid/7727/type/StringLiteral"],["tid/7734/type/StringLiteral"],["tid/7741/type/StringLiteral"],["tid/7748/type/StringLiteral"],["tid/8117/type/StringLiteral"],["tid/8124/type/StringLiteral"],["tid/8131/type/StringLiteral"],["tid/8138/type/StringLiteral"],["tid/8168/type/StringLiteral"],["tid/8178/type/StringLiteral"],["tid/8425/type/StringLiteral"],["tid/8628/type/StringLiteral"],["tid/8638/type/StringLiteral"],["tid/8672/type/StringLiteral"],["tid/8682/type/StringLiteral"],["tid/8719/type/StringLiteral","tid/9129/type/StringLiteral"],["tid/8729/type/StringLiteral"],["tid/8736/type/StringLiteral"],["tid/8743/type/StringLiteral"],["tid/8777/type/StringLiteral","tid/9160/type/StringLiteral"],["tid/8787/type/StringLiteral"],["tid/8814/type/StringLiteral"],["tid/8824/type/StringLiteral"],["tid/8854/type/StringLiteral"],["tid/8864/type/StringLiteral"],["tid/8991/type/StringLiteral"],["tid/9017/type/StringLiteral"],["tid/9041/type/StringLiteral"],["tid/9073/type/StringLiteral"],["tid/9099/type/StringLiteral"],["tid/9106/type/StringLiteral"],["tid/9191/type/StringLiteral"],["tid/9222/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transLitellm","extension":".js","filename":"options.js","path":"/addons/transLitellm/options.js","indexIsBuilt":true,"indexIds":{"LiteLLM's proxy url. The url address of your LiteLLM proxy. The default is : <code>http://localhost:8890/chat/completions</code>":0,"API's base URL":1,"The base URL of your selected service. Only fill this field if you're using a custom endpoint URL. LiteLLM will automatically detect the base URL based on the given model.<br />The way LiteLLM adds the path to the URL depends on the service. For example, for OpenAI-compatible endpoints, LiteLLM will append <code>/chat/completions</code> to the given URL. So, if your endpoint is <code>https://api.fast-tunnel.one/v1/chat/completions</code>, fill the field with <code>https://api.fast-tunnel.one/v1</code>.":2,"API Version":3,"Optional. The API version parameter needed for some services.":4,"API Key":5,"Optional. The API key used for authenticating your access to the service.":6,"Model":7,"Pre-train the model of your choice. Utilize the LiteLLM model convenience format to specify your preferred model. The format is {service name}/{model}. For example:":8,"your deployment name":9,"However, some models have unique names that can be directly identified, like:":10,"Azure AD Token":11,"AWS Access Key ID":12,"AWS secret access key":13,"Open router site URL":14,"Open router APP name":15,"Enable Context":16,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":17,"Context Character Limit":18,"Character limit for the context.":19,"System Message Template":20,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":21,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":22,"Variables:<br>":23,"<li>LANG_FROM : Source language</li>":24,"<li>LANG_TO : Target language</li>":25,"<li>SOURCE_TEXT : Source text</li>":26,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":27,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":28,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":32,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":33,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":34,"Sample conversation":35,"User message":36,"Assistant's response":37,"Body Message Template":38,"Template of the body of your message.":39,"Enable JailBreak":40,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":41,"Jailbreak Template":42,"Template of the Jailbreak message.":43,"Maximum Tokens":44,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":45,"Temperature":46,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":47,"Nucleus sampling (top_p)":48,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":49,"Frequency Penalty":50,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":51,"Presence Penalty":52,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":53,"Use JSON Schema":54,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":55,"Stop":56,"Enter a keyword where the API will stop generating further tokens. Separate each entry with a new line.":57,"Additional argument variables":58,"Additional argument variables that would be appended when starting the server.<br />https://docs.litellm.ai/docs/proxy/cli#--drop_params":59,"Batch Timeout":60,"Timeout for each batch in milisecond":61,"Max Request Length":62,"The maximum length of characters for each translation batch.\nEach translator has a different specs.\nI recommend less than 2000 for WEB front-end translator that uses GET parameter.":63,"Max concurrent requests":64,"How many concurrent requests are allowed to be connected simultaneously. Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed.":65,"Max row per concurrent requests":66,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.":67,"Batch delay":68,"Delay between batch (in miliseconds)":69,"Code Escaping Algorithm":70,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.":71,"Number of retry":72,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":73,"Retry when the number of translated rows doesn't match original":74,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":75,"Retry when the number of lines for each translated row doesn't match original":76,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":77,"Prompt: Row count mismatch":78,"Prompt used when retrying due to row/element count mismatch.":79,"Prompt: Line count mismatch":80,"Prompt used when retrying due to per-row line count mismatch.":81,"Prompt: Error / Retry instruction":82,"Prompt appended after the mismatch prompt(s) to instruct the model to retry.":83,"Custom Parameter":84,"Key":85,"Value":86,"Type":87,"Type of the value.":88,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":89,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":90,"<br />Example: <code>trans.project.title</code>":91,"Drop parameters that will not be sent to the API.<br />":92,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":93,"You can drop the parameters that are not supported by the model here.":94,"Manage configuration":95,"Some of the feature of this engine requires ChatGPT add-on to be installed. Please make sure you have installed ChatGPT add-on before using this engine.":96,"Text Completion Setting":97,"General":98,"<h2>Don't waste your money on Reasoning Models</h2>":99,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":100,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":101,"Platform specific":102,"Azure":103,"AWS":104,"Open Router":105,"Templates":106,"Enable context":107,"<h2>Sample dialogue</h2>":108,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":109,"Retry prompts":110,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":111,"<p>Available variables:</p>":112,"Enable Jailbreak":113,"Advanced":114,"Custom Parameters":115,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":116,"<h2>Warning</h2><ul><li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li><li>If the same key is used multiple times, only the last value will be used.</li><li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li></ul>":117,"Drop Parameters":118,"LiteLLM Proxy Configuration":119,"Start LiteLLM server":120,"Processing...":121,"Server started on port ":122,"Check LiteLLM Status":123,"Change LiteLLM Version":124,"Enter the new version of LiteLLM you wish to install.\nKnown working version: 1.38.0, 1.49.4 \nThe suggested version is: ":125,"Are you sure you want to install LiteLLM version ":126,"Failed to install LiteLLM. Please check the console for more details.":127,"LiteLLM has been successfully updated to version ":128,"Batch Translation Setting":129,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":130,"Retries and Refinement":131,"<h2>Retries and Refinement</h2>":132,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":133,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":134,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":135,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":136,"<h2>Code Escaping Algorithm</h2>":137,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":138,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":139,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":140,"JavaScript template cloaking":141,"None (no escaping)":142,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":143,"Always separate file":144,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":145,"Add actor name":146,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":147,"Load Actor Reference as Glossary":148,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":149,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":150,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":151,"Actor Reference Translation Column":152,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":153,"Actor's Information Column":154,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":155,"Extra Prompt":156,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":157,"General Settings":158,"Always separate file for each batch":159,"Append actor name to the translatable text":160,"Glossary":161,"<h2>Glossary</h2>":162,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":163,"The Column of Actor's Additional Information":164,"Prompt":165},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/batchAPI.js":{"data":[["Translate with OpenAI Batch API","OpenAI Batch APIで翻訳"],["Model","モデル"],["The pre-trained model.","事前学習済みモデル。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI Batch APIは、一般的に使用されるAPIとは少し異なるモデル命名規則を使用しているようです。Batch APIで使用されるモデルには「-batch」という接頭辞が付きます。例えば、<code>gpt-4.1-mini</code>を使用すると、モデルは自動的に<code>gpt-4.1-mini-batch</code>になります。<br />\nただし、このアドオンが作成された時点では、バッチモデルはOpenAIのモデル使用制限にリストされていないため、ユーザーがモデル使用フィルターを「許可」（ホワイトリスト）に設定している場合、Batch APIを使用できません。<br />\nこれはOpenAI UIのバグである可能性が高く、将来的に修正されるかもしれません。<br />\nしたがって、Batch APIを使用するには、OpenAIで使用制限を「ブロック」（ブラックリスト）モードに設定してください。<br />\nモデルの使用制限を変更するにはここをクリック：https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","ソース列"],["The column of the original texts you want to translate.","翻訳したい元のテキストの列。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が会話や代名詞を追跡しやすくなります。Translator++はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Ignore if already translated","既に翻訳済みの場合は無視"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","このオプションがチェックされている場合、Translator++は既に翻訳が存在する行を無視します。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者が会話の文脈を理解しやすくなります。アクター参照は会話中のアクターの名前です。これは用語集として翻訳者に読み込まれ、翻訳コストを増加させます。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが各バッチアイテムの用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むにはテンプレートコマンドを使用してください。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列。この列はアクター参照の翻訳として使用され、会話中のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクターの情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列。性別、年齢などの情報を追加でき、会話中の代名詞の翻訳を向上させます。"],["System Message Template","システムメッセージテンプレート"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","システムメッセージは、チャットGPTアシスタントの役割を伝えるメッセージのヘッダーです。このメッセージは、チャットGPTに送信するすべてのバッチの最初のメッセージとして送信されます。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","JavaScriptのテンプレートリテラルスタイル<span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>で以下の変数を含めることができます。"],["Variables:<br>","変数:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : ソース言語</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : ターゲット言語</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : ソース言語の完全な名前</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : ターゲット言語の完全な名前</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : ソーステキスト</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : エスケープアルゴリズムの事前定義メッセージ。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 改行を表す文字列（行の代替）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : バッチ内のメッセージ数。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : アクターの情報を追加。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++オブジェクトから参照を生成。<br />例: <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 前の数行をコンテキストとして含める</li>"],["Body Message Template","本文メッセージテンプレート"],["Template of the body of your chat.","チャットの本文のテンプレート。"],["Sample conversation","サンプル会話"],["The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","OpenAIバッチAPIを使用すると、プロジェクトを非同期で50%低コストで翻訳でき、翻訳結果を<b style=\"color:red\">24時間以内</b>に<b style=\"color:blue\">通常の半額</b>で受け取ることができます。これは、即時の翻訳結果を必要としない大規模プロジェクトに特に有用です。"],[" <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.","<br />OpenAI Batch APIの詳細については<a href=\"https://platform.openai.com/docs/guides/batch\" external>こちら</a>をお読みください。"],["General Settings","一般設定"],["This form is using your OpenAI Batch API configuration.<br>","このフォームはあなたのOpenAI Batch API設定を使用しています。<br>"],["You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>","設定は、オプションウィンドウの<b>OpenAI Batch API</b>アドオンの設定から変更できます。<br>"],["There you can set the API key, model, and other settings.<br />","そこでAPIキー、モデル、その他の設定を設定できます。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"ChatGPT設定を開く\" />"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>推論モデルにお金を無駄にしないで</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>様々な研究により、推論モデルは創造的な文章作成や翻訳タスクにおいて通常のモデルよりもはるかに劣ることが証明されています。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>推論モデルを使用しても、より高額なコストと遅い応答時間が増えるだけで、何も得られません。</p>"],["Append actor name to the translatable text","翻訳可能なテキストに役者名を追加"],["Ignore translated rows","翻訳済み行を無視"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチのアイテムごとに読み込まれ、翻訳の品質を向上させます。この機能は、プロンプトを膨らませないように関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","役者の追加情報の列"],["Prompt Template","プロンプトテンプレート"],["<h2>1. System Message</h2>","<h2>1. システムメッセージ</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>ここで、アシスタントにその役割を説明できます。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答のサンプルを書いて、翻訳者があなたの目的と会話の文脈を理解するのを助けることができます。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 実際のプロンプト</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>これはアシスタントへの実際のプロンプトです。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>オーバーヘッドコスト</h3>\n                        オーバーヘッドコストは、実際の翻訳テキストなしでアシスタントに送信するプロンプトメッセージのコストです。コストはプロンプトメッセージ内のトークン数に基づいて計算されます。トークンが多いほど、コストは高くなります。<br>\n                        <b>推定オーバーヘッドコスト:</b> <span class=\"overheadCost\">0</span> トークン / リクエスト。"],["Are you sure you want to reset the form?","フォームをリセットしてもよろしいですか？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","バッチを処理してもよろしいですか？\nこの操作にはコストがかかります。"],["The batch is successfully created. Do you want to open the batch manager?","バッチが正常に作成されました。バッチマネージャーを開きますか？"],["OpenAI Batch API Queue","OpenAI バッチ API キュー"]],"context":[["tid/319/type/StringLiteral"],["tid/418/type/StringLiteral"],["tid/428/type/NoSubstitutionTemplate"],["tid/437/type/NoSubstitutionTemplate"],["tid/474/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/521/type/StringLiteral"],["tid/556/type/StringLiteral"],["tid/566/type/StringLiteral"],["tid/629/type/StringLiteral","tid/1634/type/StringLiteral"],["tid/639/type/StringLiteral"],["tid/646/type/StringLiteral"],["tid/680/type/StringLiteral","tid/1665/type/StringLiteral"],["tid/690/type/StringLiteral"],["tid/717/type/StringLiteral"],["tid/727/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/843/type/StringLiteral"],["tid/851/type/StringLiteral"],["tid/859/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/880/type/StringLiteral"],["tid/888/type/StringLiteral"],["tid/896/type/StringLiteral"],["tid/904/type/StringLiteral"],["tid/912/type/StringLiteral"],["tid/920/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/936/type/StringLiteral"],["tid/944/type/StringLiteral"],["tid/952/type/StringLiteral"],["tid/960/type/StringLiteral"],["tid/968/type/StringLiteral"],["tid/1007/type/StringLiteral"],["tid/1017/type/StringLiteral"],["tid/1063/type/StringLiteral"],["tid/1158/type/NoSubstitutionTemplate"],["tid/1170/type/NoSubstitutionTemplate"],["tid/1194/type/StringLiteral"],["tid/1220/type/NoSubstitutionTemplate"],["tid/1228/type/NoSubstitutionTemplate"],["tid/1235/type/NoSubstitutionTemplate"],["tid/1242/type/NoSubstitutionTemplate"],["tid/1287/type/NoSubstitutionTemplate"],["tid/1295/type/NoSubstitutionTemplate"],["tid/1303/type/NoSubstitutionTemplate"],["tid/1502/type/StringLiteral"],["tid/1526/type/StringLiteral"],["tid/1578/type/StringLiteral"],["tid/1604/type/StringLiteral"],["tid/1611/type/StringLiteral"],["tid/1696/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1790/type/StringLiteral"],["tid/1797/type/StringLiteral"],["tid/1842/type/StringLiteral"],["tid/1849/type/StringLiteral"],["tid/1975/type/StringLiteral"],["tid/1982/type/StringLiteral"],["tid/2036/type/NoSubstitutionTemplate"],["tid/2253/type/StringLiteral"],["tid/6512/type/StringLiteral"],["tid/6990/type/StringLiteral"],["tid/7239/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"batchAPI.js","path":"/addons/transOpenAIBatch/batchAPI.js","indexIsBuilt":true,"indexIds":{"Translate with OpenAI Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The OpenAI Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:blue\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the OpenAI Batch API <a href=\"https://platform.openai.com/docs/guides/batch\" external>here</a>.":38,"General Settings":39,"This form is using your OpenAI Batch API configuration.<br>":40,"You can change the configuration by going to the <b>OpenAI Batch API</b> add-on's settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"transOpenAIBatch\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"<h2>Don't waste your money on Reasoning Models</h2>":44,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":45,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":46,"Append actor name to the translatable text":47,"Ignore translated rows":48,"Glossary":49,"<h2>Glossary</h2>":50,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":51,"The Column of Actor's Additional Information":52,"Prompt Template":53,"<h2>1. System Message</h2>":54,"<p>Here you can explain to the assistant, what is their role.</p>":55,"<h2>2. Sample dialogue</h2>":56,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":57,"<h2>3. Your actual prompt</h2>":58,"<p>This is the actual prompt to the assistant.</p>":59,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Estimated overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":60,"Are you sure you want to reset the form?":61,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":62,"The batch is successfully created. Do you want to open the batch manager?":63,"OpenAI Batch API Queue":64},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","翻訳を適用する行を選択してください"],["Target Column","ターゲット列"],["The column to put the translation result.","翻訳結果を配置する列。"],["Import translation from ChatGPT Batch","ChatGPTバッチから翻訳をインポート"],["Translation applied to selected rows","選択行に適用された翻訳"],["Invalid format","無効な形式"],["OK","OK"],["Mismatch","不一致"],["Failed to load batch list with error: \n","エラーでバッチリストの読み込みに失敗しました: \n"],["Download Error File","エラーファイルをダウンロード"],["Batch is not completed yet","バッチはまだ完了していません"],["Are you sure you want to cancel this batch?","このバッチをキャンセルしてもよろしいですか？"],["Cannot cancel completed batch.","完了したバッチはキャンセルできません。"],["Batch cancelled","バッチがキャンセルされました"],["Failed to cancel batch","バッチのキャンセルに失敗しました"]],"context":[["tid/1733/type/StringLiteral"],["tid/1778/type/StringLiteral","tid/11153/type/StringLiteral"],["tid/1788/type/StringLiteral","tid/11163/type/StringLiteral"],["tid/1862/type/StringLiteral","tid/11237/type/StringLiteral"],["tid/2202/type/StringLiteral"],["tid/2632/type/StringLiteral"],["tid/2664/type/StringLiteral","tid/2743/type/StringLiteral"],["tid/2711/type/StringLiteral"],["tid/6535/type/StringLiteral","tid/6796/type/StringLiteral"],["tid/8758/type/StringLiteral"],["tid/11101/type/StringLiteral"],["tid/12975/type/StringLiteral"],["tid/13053/type/StringLiteral"],["tid/13111/type/StringLiteral"],["tid/13128/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":true,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html":{"data":[["Batches","バッチ"],["Apply translation","翻訳を適用"],["Cancel batch","バッチをキャンセル"],["Status","ステータス"],["Batch ID","バッチID"],["Input File ID","入力ファイルID"],["End point","エンドポイント"],["Created at","作成日時"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","有効期限 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了リクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストで消費されたトークンに対して課金されます。\"></i>"],["Completed at","完了日時"],["Errors","エラー"],["Batch Item Detail of","バッチアイテム詳細"],["ID","ID"],["Completed on","完了日"],["Model","モデル"],["Prompt Token","プロンプトトークン"],["Completion Token","完了トークン"],["Total Token","合計トークン"],["Status Code","ステータスコード"],["error","エラー"],["Conversation","会話"],["Response Validation","応答検証"],["Raw Payload","生ペイロード"],["View raw payload","生ペイロードを表示"],["Response Preview","応答プレビュー"],["Apply translations from selected rows","選択した行から翻訳を適用"],["Here you can edit the translation result individually and send it into Translator++","ここでは翻訳結果を個別に編集し、Translator++に送信できます"],["Open ChatGPT Settings","ChatGPT設定を開く"],["Help","ヘルプ"],["File list","ファイルリスト"],["Collapse / restore left panel","左パネルを折りたたむ/復元する"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","時間内に完了しないバッチは最終的に期限切れ状態に移行します。そのバッチ内の未完了のリクエストはキャンセルされ、完了したリクエストへの応答はバッチの出力ファイルを通じて利用可能になります。完了したリクエストで消費されたトークンに対して課金されます。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transOpenAIBatch/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transOpenAIBatch/chatgpt-batch-manager/index.html","indexIsBuilt":true,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : ゲームのタイトル</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : ゲームのエンジン</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : アクター情報の用語集。（バッチモードでアクター情報オプションが有効な場合のみ）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[オブジェクト名] : Translator++ オブジェクトから参照を生成します。<br />例 : <code>REFERENCE[共通参照]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 前の翻訳のコンテキスト（コンテキストが有効な場合）</li>"],["Sample conversation","サンプル会話"],["<h2>Sample dialogue</h2>","<h2>サンプル対話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>既存の対話のサンプル。良い応答や悪い応答の例を書くことで、翻訳者が目的と会話のコンテキストを理解するのに役立ちます。</p>"],["Always separate file","常にファイルを分離"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","各バッチのファイルを常に分離します。これにより、各ファイルのコンテキストが他のファイルと混ざらずに保たれます。"],["Add actor name","アクター名を追加"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","行情報からアクター名を翻訳可能なテキストに追加します。これにより、翻訳者が対話や代名詞を追跡しやすくなります。Translator++ はその後、翻訳結果からアクター名を削除します。これは明らかに翻訳コストを増加させます。"],["Load Actor Reference as Glossary","アクター参照を用語集として読み込む"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","チェックすると、Translator++はアクター参照を用語集として読み込みます。これにより、翻訳者は会話の文脈を理解しやすくなります。アクター参照は対話中のアクター名です。これは翻訳者用の用語集として読み込まれます。これにより翻訳コストが増加します。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","会話に存在するキャラクターのみが、各バッチ項目の用語集として読み込まれます。プロンプトメッセージでアクター参照を読み込むには、テンプレートコマンドを使用してください。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️このオプションを有効にする場合、キャラクター情報データを配置するために、プロンプトテンプレートに<code>ACTOR_INFO</code>変数を含める必要もあります。"],["Actor Reference Translation Column","アクター参照翻訳列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","アクター名の翻訳の列です。この列はアクター参照の翻訳として使用され、会話中のアクター名の翻訳の一貫性を向上させます。"],["Actor's Information Column","アクター情報列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","アクターの追加情報を含む列です。性別、年齢などの詳細情報を入力できます。これにより、会話中の代名詞の翻訳が改善されます。"],["Extra Prompt","追加プロンプト"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","プロンプトメッセージに追加される追加プロンプトです。これはシステムメッセージの後、実際のプロンプトメッセージの前に追加されます。"],["General Settings","一般設定"],["Always separate file for each batch","常に各バッチごとにファイルを分離"],["Append actor name to the translatable text","翻訳可能なテキストにアクター名を追加"],["Glossary","用語集"],["<h2>Glossary</h2>","<h2>用語集</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>この機能は、プロンプトに用語集を自動的に追加するのに役立ちます。用語集は各バッチ項目ごとに読み込まれ、翻訳の品質を向上させます。この機能は、プロンプトの肥大化を避けるために関連する用語のみを読み込もうとします。</p>"],["The Column of Actor's Additional Information","アクター追加情報の列"],["Prompt","プロンプト"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transOpenAIBatch/transOpenAIAssistant.js","indexIsBuilt":true,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"parameters":[]},"/addons/transOpenAIBatch/utility.js":{"data":[["Batch Manager","バッチマネージャー"],["This feature is only available if you have a project open.","この機能はプロジェクトが開いている場合のみ利用可能です。"]],"context":[["tid/78/type/StringLiteral"],["tid/114/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transOpenAIBatch","extension":".js","filename":"utility.js","path":"/addons/transOpenAIBatch/utility.js","indexIsBuilt":true,"indexIds":{"Batch Manager":0,"This feature is only available if you have a project open.":1},"tags":[],"parameters":[]},"/addons/transPyTranslators/pyTranslators.js":{"data":[["Start server","サーバーを開始"],["Server started","サーバーが開始されました"],["Reinstall server","サーバーを再インストール"],["Enter the new version of Translators library you wish to install.\nLatest version is: ","インストールしたいTranslatorsライブラリの新しいバージョンを入力してください。\n最新バージョンは: "],["Are you sure you want to install Translators version ","Translatorsバージョン "],["Failed to install Translators. Please check the console for more details.","Translatorsのインストールに失敗しました。詳細はコンソールを確認してください。"],["Translators has been successfully updated to version ","Translatorsがバージョン "],["General Settings","一般設定"]],"context":[["tid/2096/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2241/type/StringLiteral"],["tid/2442/type/StringLiteral"],["tid/2480/type/StringLiteral"],["tid/2555/type/StringLiteral"],["tid/2574/type/StringLiteral"],["tid/3019/type/StringLiteral"]],"basename":"pyTranslators.js","dirname":"/addons/transPyTranslators","extension":".js","filename":"pyTranslators.js","path":"/addons/transPyTranslators/pyTranslators.js","indexIsBuilt":true,"indexIds":{"Start server":0,"Server started":1,"Reinstall server":2,"Enter the new version of Translators library you wish to install.\nLatest version is: ":3,"Are you sure you want to install Translators version ":4,"Failed to install Translators. Please check the console for more details.":5,"Translators has been successfully updated to version ":6,"General Settings":7},"tags":[],"parameters":[]},"/addons/transRedBatch/transredbatch.js":{"data":[["Are you sure you want to abort?","本当に中止しますか？"],["Process paused!\nPress OK to continue!","処理が一時停止しました！\n続行するにはOKを押してください！"]],"context":[["tid/2002/type/StringLiteral"],["tid/2070/type/StringLiteral"]],"basename":"transredbatch.js","dirname":"/addons/transRedBatch","extension":".js","filename":"transredbatch.js","path":"/addons/transRedBatch/transredbatch.js","indexIsBuilt":true,"indexIds":{"Are you sure you want to abort?":0,"Process paused!\nPress OK to continue!":1},"tags":[],"parameters":[]},"/addons/transRikaikun/transRikaikun.js":{"data":[["Never unload dictionaries from RAM","辞書をRAMからアンロードしない"]],"context":[["tid/890/type/StringLiteral"]],"basename":"transRikaikun.js","dirname":"/addons/transRikaikun","extension":".js","filename":"transRikaikun.js","path":"/addons/transRikaikun/transRikaikun.js","indexIsBuilt":true,"indexIds":{"Never unload dictionaries from RAM":0},"tags":[],"parameters":[]},"/addons/translationProxy/translationProxy.js":{"data":[["Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.","Translation Proxyを開始できません！\nTranslation Proxyは現在、$3以上のパトロンのみ利用可能です。"],["Please enter the port number:","ポート番号を入力してください:"],["Invalid port : ","無効なポート: "],["Port must be a numeric.","ポートは数値でなければなりません。"],["Port has successfully changed to: ","ポートが正常に変更されました: "],["Connection Info","接続情報"],["Do you want to copy the base URL into the clipboard?","ベースURLをクリップボードにコピーしますか？"],["Use secure protocol(HTTPS)","セキュアプロトコル(HTTPS)を使用"],["Port","ポート"],["Connection info","接続情報"],["Help","ヘルプ"]],"context":[["tid/3919/type/StringLiteral"],["tid/4030/type/StringLiteral"],["tid/4063/type/StringLiteral"],["tid/4072/type/StringLiteral"],["tid/4104/type/StringLiteral"],["tid/4236/type/StringLiteral"],["tid/4252/type/StringLiteral"],["tid/4490/type/StringLiteral"],["tid/4575/type/StringLiteral"],["tid/4627/type/StringLiteral"],["tid/4664/type/StringLiteral"]],"basename":"translationProxy.js","dirname":"/addons/translationProxy","extension":".js","filename":"translationProxy.js","path":"/addons/translationProxy/translationProxy.js","indexIsBuilt":true,"indexIds":{"Cannot start Translation Proxy!\nTranslation Proxy is currently only available for $3 or more patrons.":0,"Please enter the port number:":1,"Invalid port : ":2,"Port must be a numeric.":3,"Port has successfully changed to: ":4,"Connection Info":5,"Do you want to copy the base URL into the clipboard?":6,"Use secure protocol(HTTPS)":7,"Port":8,"Connection info":9,"Help":10},"tags":[],"parameters":[]},"/addons/tyranoTrans/tyranoTrans.js":{"data":[["Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.","スクリプト書き込み時に選択したテキストエンコーディングに強制します。（空白 = 自動）<br />このフィールドを使用してスクリプトを<b>UTF-16</b>に変換し、ロケールを日本語に変更せずにゲームをプレイ可能にできます。"],["Use legacy parser","レガシーパーサーを使用"],["Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.","新しいパーサーの代わりにレガシー（旧パーサー）を使用します。<br />レガシーパーサーは高速ですが、一部のゲームでは信頼性が低いです。<br />新しいパーサーはより信頼性が高いですが、低速です。"],["Select TyranoBuilder packaged game","TyranoBuilderパッケージゲームを選択"],["Select the exe file of your packaged game.","パッケージゲームのexeファイルを選択してください。"],["Target folder","ターゲットフォルダ"],["Select destination folder. The process will replace the existing files.","宛先フォルダを選択してください。処理により既存のファイルが置き換えられます。"],["Extraction completed","抽出完了"],["Close","閉じる"],["Next","次へ"],["Please select game executable file","ゲーム実行ファイルを選択してください"],["Back","戻る"],["The game is fully loaded, proceed!","ゲームが完全に読み込まれました。進めてください！"],["Extract data","データを抽出"],["Open extracted folder","抽出されたフォルダを開く"],["Extract resources","リソースを抽出"],["Select the game executable","ゲーム実行ファイルを選択"],["Select the game executable or asar file to extract","抽出するゲーム実行ファイルまたはasarファイルを選択"],["Target directory","ターゲットディレクトリ"],["Select the target directory to store the unpacked files","解凍されたファイルを保存するターゲットディレクトリを選択"],["Electron archive file detected. Do you want to extract the asar file instead?","Electronアーカイブファイルを検出しました。代わりにasarファイルを抽出しますか？"],["Tyranobuilder Game Extractor","Tyranobuilderゲーム抽出ツール"],["Before you create a new project, please make sure that :","新しいプロジェクトを作成する前に、以下を確認してください："],["<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++","<b>Kirikiriアドベンチャーゲームパーサー</b>アドオンがTranslator++にインストールされていること"],["Your game is fully extracted.","ゲームが完全に抽出されました。"],["Extract TyranoBuilder package","TyranoBuilderパッケージを抽出"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","すべての.ksおよび.tjsファイルはプレーンテキストです（コンパイルされず、スクランブルされず、暗号化されていません）"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","一部の操作はゲームを変更します。<b>必ずゲームのバックアップを作成してください！</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","ゲーム実行ファイルを選択してください。このファイルはゲームデータを抽出するために使用されるメインのゲームファイルです。"],["In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.","Tyranoゲームでは通常<b>index.html</b>または<b>exe</b>ファイルです。"],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","可能な文字エンコーディングのリスト。<b>順序は重要です！</b>。ドラッグしてリストを並べ替えることができます。"],["Game created with TyranoBuilder is in <b>UTF-8</b> encoding","TyranoBuilderで作成されたゲームは<b>UTF-8</b>エンコーディングです"],["Literal tags are the tags that will be escaped into Translator++ editor.","リテラルタグは、Translator++エディタ内でエスケープされるタグです。"],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b>は必須です。"],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b>タグはTranslator++によって改行に補間されます。そのため、<b>[r]</b>を明示的に書く必要はありません。"],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kirikiriスクリプト（.ks）は高度にカスタマイズ可能で、開発者が独自のタグを作成できます。"],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++は、シャープ（#）で始まるキャラクター名などの標準タグを処理できます。"],["However, Translator++ may not be able to handle custom tags created by developers.","ただし、Translator++は開発者が作成したカスタムタグを処理できない場合があります。"],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","そのため、翻訳が必要なタグと属性、およびアクター名としてマークする必要があるものを定義する必要があるかもしれません。"],["<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>","<p>タグに関する詳細情報は、<a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilderタグリファレンス</a>をご覧ください。</p>"],["You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.","プロジェクトを開始する前に、<input type=\"button\" value=\"ゲームを抽出\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" />して、その中の<b>ks</b>スクリプトを分析する必要があるかもしれません。"],["Create Project","プロジェクトを作成"],["Play last build","最後のビルドを再生"],["Extract TyranoBuilder","TyranoBuilderを抽出"],["Create playable package","再生可能なパッケージを作成"]],"context":[["tid/74/type/StringLiteral"],["tid/249/type/StringLiteral","tid/259/type/StringLiteral"],["tid/269/type/StringLiteral"],["tid/4537/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4739/type/StringLiteral"],["tid/4744/type/StringLiteral"],["tid/4877/type/StringLiteral"],["tid/4970/type/StringLiteral","tid/5392/type/StringLiteral"],["tid/5021/type/StringLiteral"],["tid/5053/type/NoSubstitutionTemplate"],["tid/5103/type/StringLiteral","tid/5199/type/StringLiteral"],["tid/5146/type/StringLiteral"],["tid/5242/type/StringLiteral"],["tid/5334/type/StringLiteral"],["tid/5476/type/StringLiteral"],["tid/5750/type/StringLiteral"],["tid/5760/type/StringLiteral"],["tid/5793/type/StringLiteral"],["tid/5803/type/StringLiteral"],["tid/5992/type/StringLiteral"],["tid/6081/type/StringLiteral"],["tid/9405/type/StringLiteral"],["tid/9410/type/StringLiteral"],["tid/9415/type/StringLiteral"],["tid/9420/type/StringLiteral"],["tid/9425/type/StringLiteral"],["tid/9430/type/StringLiteral"],["tid/9636/type/StringLiteral"],["tid/9645/type/StringLiteral"],["tid/9685/type/StringLiteral"],["tid/9694/type/StringLiteral"],["tid/9738/type/StringLiteral"],["tid/9747/type/StringLiteral"],["tid/9756/type/StringLiteral"],["tid/10111/type/StringLiteral"],["tid/10118/type/StringLiteral"],["tid/10125/type/StringLiteral"],["tid/10132/type/StringLiteral"],["tid/10139/type/NoSubstitutionTemplate"],["tid/10146/type/StringLiteral"],["tid/10449/type/StringLiteral"],["tid/12059/type/StringLiteral"],["tid/12121/type/StringLiteral"],["tid/12176/type/StringLiteral"]],"basename":"tyranoTrans.js","dirname":"/addons/tyranoTrans","extension":".js","filename":"tyranoTrans.js","path":"/addons/tyranoTrans/tyranoTrans.js","indexIsBuilt":true,"indexIds":{"Will force the text encoding into the one selected when writing the scripts. (blank = auto)<br />. You can use this field to convert the script into <b>UTF-16</b> so that the game will playable without changing your locale into Japanese.":0,"Use legacy parser":1,"Use legacy (old parser) instead of the new parser.<br />Legacy parser is faster, but unreliable on some game.<br />New parser is more reliable, but slower.":2,"Select TyranoBuilder packaged game":3,"Select the exe file of your packaged game.":4,"Target folder":5,"Select destination folder. The process will replace the existing files.":6,"Extraction completed":7,"Close":8,"Next":9,"Please select game executable file":10,"Back":11,"The game is fully loaded, proceed!":12,"Extract data":13,"Open extracted folder":14,"Extract resources":15,"Select the game executable":16,"Select the game executable or asar file to extract":17,"Target directory":18,"Select the target directory to store the unpacked files":19,"Electron archive file detected. Do you want to extract the asar file instead?":20,"Tyranobuilder Game Extractor":21,"Before you create a new project, please make sure that :":22,"<b>Kirikiri Adventure Game parser</b> add-on is installed in your Translator++":23,"Your game is fully extracted.":24,"Extract TyranoBuilder package":25,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":26,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":27,"Select the game executable file. This file is the main game file that will be used to extract the game data.":28,"In Tyrano games it is usually <b>index.html</b> or <b>exe</b> file.":29,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":30,"Game created with TyranoBuilder is in <b>UTF-8</b> encoding":31,"Literal tags are the tags that will be escaped into Translator++ editor.":32,"<b>ruby l r</b> are mandatory.":33,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":34,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":35,"Translator++ can handle standard tags such as character names that start with a sharp (#).":36,"However, Translator++ may not be able to handle custom tags created by developers.":37,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":38,"<p>Please visit the <a href=\"https://tyranobuilder.com/tag/\" external target=\"_blank\">TyranoBuilder tag reference</a> for more information about the tags.</p>":39,"You might need to <input type=\"button\" value=\"extract your game\" onclick=\"addonLoader.addons.tyranoTrans.TyranoUtil.showExtractDialog()\" /> and analyze the <b>ks</b> script inside it before starting the project.":40,"Create Project":41,"Play last build":42,"Extract TyranoBuilder":43,"Create playable package":44},"tags":[],"parameters":[]},"/addons/unityTrans/configEdit.html":{"data":[["General","一般"],["Executable file location","実行ファイルの場所"],["\n\t\t\t\tPath to the application's executable file.\n\t\t\t","\n\t\t\t\tアプリケーションの実行ファイルへのパス。\n\t\t\t"],["Field can not be empty!","フィールドは空にできません！"],["Service","サービス"],["End Point","エンドポイント"],["Auto translation service to use.","使用する自動翻訳サービス。"],["Target Language","ターゲット言語"],["The language to translate into","翻訳先の言語"],["Source Language","ソース言語"],["The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended","ゲームの元の言語。「auto」も一部のエンドポイントでサポートされていますが、一般的には推奨されません"],["Files","ファイル"],["Directory","ディレクトリ"],["Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}","キャッシュされた翻訳ファイルを検索するディレクトリ。プレースホルダーを使用可能: {GameExeName}, {Lang}"],["Output File","出力ファイル"],["File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}","生成された翻訳を挿入するファイル。プレースホルダーを使用可能: {GameExeName}, {Lang}"],["Substitution File","置換ファイル"],["File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}","翻訳前に適用される置換を含むファイル。プレースホルダーを使用可能: {GameExeName}, {Lang}"],["Preprocessors File","プリプロセッサファイル"],["File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}","テキストを翻訳者に送信する前に適用されるプリプロセッサを含むファイル。プレースホルダーを使用可能: {GameExeName}, {Lang}"],["Text Frameworks","テキストフレームワーク"],["Enable/Disable auto translation for Unity's text frameworks.","Unityのテキストフレームワークの自動翻訳を有効/無効にします。"],["Behaviour","動作"],["Max Characters Per Translation","翻訳ごとの最大文字数"],["Max characters per text to translate. Max 2500.","翻訳するテキストごとの最大文字数。最大2500。"],["Whether or not to ignore whitespace, including newlines, in dialogue keys","ダイアログキー内の空白（改行を含む）を無視するかどうか"],["Whether or not to ignore whitespace, including newlines, in NGUI","NGUI内の空白（改行を含む）を無視するかどうか"],["Minimum Dialogue Chars","最小ダイアログ文字数"],["The length of the text for it to be considered a dialogue","ダイアログとみなされるテキストの長さ"],["Force Split Text After Characters","文字数後に強制分割"],["Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)","翻訳テキストがこの文字数を超えた場合、複数行に分割します。（0は分割なし）"],["Whether or not to copy hooked texts to clipboard","フックしたテキストをクリップボードにコピーするかどうか"],["MaxClipboardCopyCharacters","最大クリップボードコピー文字数"],["Max number of characters to hook to clipboard at a time","一度にクリップボードにフックする最大文字数"],["Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation","翻訳時にUIコンポーネントのリサイズを「最善の試み」で提供するかどうか"],["Indicates whether batching of translations should be enabled for supported endpoints","サポートされているエンドポイントで翻訳のバッチ処理を有効にするかどうかを示します"],["Indicates whether or not to use translations from the included static translation cache","含まれる静的翻訳キャッシュから翻訳を使用するかどうかを示します"],["Override Font","フォントの上書き"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI","テキストコンポーネントを更新する際に使用するフォントを上書きします。注：UGUIでのみ動作します"],["Override Font TextMeshPro","フォントの上書き（TextMeshPro）"],["Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro","テキストコンポーネントを更新する際に使用するフォントを上書きします。注：TextMeshProでのみ動作します"],["Resize UI Line Spacing Scale","UI行間隔スケールのリサイズ"],["A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI","UIリサイズ中にデフォルトの行間隔をスケールする小数値、例：0.80。注：UGUIでのみ動作します"],["Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.","翻訳されているかどうかに関わらず、すべてのUIコンポーネントにUIリサイズ動作を適用するかどうかを示します"],["Ignore Text Starting With","特定の文字で始まるテキストを無視"],["Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.","プラグインが特定の文字で始まる文字列を無視することを示します。これは「;」で区切られたリストです"],["Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.","「テキストゲッター互換モード」を有効にするかどうかを示します。ゲームで必要な場合のみ有効にしてください"],["GameLog Text Paths","ゲームログテキストパス"],["Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.","ゲームが「ログコンポーネント」として使用するゲームオブジェクトの特定のパスを示し、そこにテキストを継続的に追加または先頭に挿入します。設定には専門知識が必要です。これは「;」で区切られたリストです。"],["Romaji Post Processing","ローマ字後処理"],["Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]","「翻訳された」ローマ字テキストに対して行う後処理のタイプを示します。これは、使用されるフォントがさまざまな発音記号を適切にサポートしていない場合、特定のゲームで重要になることがあります。これは「;」で区切られたリストです。可能な値: [\"すべての発音記号を削除\", \"マクロンをサーカムフレックスに置換\", \"アポストロフィを削除\"]"],["Translation Post Processing","翻訳後処理"],["Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]","翻訳されたテキスト（ローマ字以外）に対して行う後処理のタイプを示します。可能な値: [\"すべての発音記号を削除\", \"マクロンをサーカムフレックスに置換\", \"アポストロフィを削除\", \"全角文字を置換\"]"],["Indicates whether or not results of regex lookups should be output to the specified OutputFile.","正規表現ルックアップの結果を指定された出力ファイルに出力するかどうかを示します。"],["Indicates whether or not whitespace differences should be output to the specified OutputFile.","空白の違いを指定された出力ファイルに出力するかどうかを示します。"],["Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.","正規表現で分割された翻訳の完全な結果を指定された出力ファイルに出力するかどうかを示します。"],["Indicates that the plugin should generate translations without variables when using substitutions.","置換を使用する際に、変数なしで翻訳を生成することを示します。"],["Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".","テキストが「スクロールイン」する際に、テキスト翻訳をサポートするために部分翻訳を生成することを示します。"],["Indicates the plugin should parse 'TARC' directives and scope translations based on these.","プラグインが「TARC」ディレクティブを解析し、これらに基づいて翻訳をスコープすることを示します。"],["Indicates the plugin should not print out success messages in relation to translations.","プラグインが翻訳に関連する成功メッセージを出力しないことを示します。"],["Blacklisted IMGUI Plugins","ブラックリスト化されたIMGUIプラグイン"],["If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'","IMGUIウィンドウのアセンブリ/クラス/メソッド名に、このリスト内の文字列（大文字小文字を区別しない）が含まれている場合、そのUIは翻訳されません。MonoModフックが必要です。これは「;」で区切られたリストです。"],["Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.","プラグインが翻訳不可能と見なすテキストを指定された出力ファイルに出力するかどうかを示します。"],["Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.","テキストコンポーネントのテキストを設定しようとする際に、仮想メソッド呼び出しのルールを無視することを示します。場合によっては、頑固なコンポーネントのテキスト設定に役立つことがあります。"],["Max Text Parser Recursion","最大テキストパーサー再帰"],["Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.","テキストが解析され、異なる部分で翻訳できるようにする際に許可される再帰のレベル数を示します。これは、高度なシナリオでスプリッター正規表現と共に使用できます。デフォルト値の1は、基本的に再帰が無効であることを意味します。"],["Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.","翻訳に送信される前にHTMLエンティティを前処理およびデコードします。HTMLエンティティが送信されると、一部の翻訳者は失敗します。"],["Will enable automated handling of rich text (text with markup).","リッチテキスト（マークアップ付きテキスト）の自動処理を有効にします。"],["Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.","翻訳に関連する有用なログメッセージを有効にするかどうかを示します。リダイレクトされたリソースに基づいて翻訳する際に役立つ場合があります。"],["Indicates that the plugin must use MonoMod hooks instead of harmony hooks.","プラグインがHarmonyフックの代わりにMonoModフックを使用する必要があることを示します。"],["Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).","プラグインがHarmonyフックを動作させるためのHarmonyデトアブリッジを初期化する必要があることを示します（通常はプラグインマネージャーが処理するため、プラグインマネージャー使用時は使用しないでください）。"],["Redirected Resource Detection Strategy","リダイレクトされたリソース検出戦略"],["Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.","プラグインが二重翻訳を防ぐためにリダイレクトされたリソースを認識しようとするかどうか、およびその方法を示します。"],["Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.","プラグインが<b>'翻訳ごとの最大文字数'</b>を超えるテキストを翻訳せずに出力するかどうかを示します。"],["Texture","テクスチャ"],["Texture Directory","テクスチャディレクトリ"],["Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}","テクスチャをダンプし、画像を読み込むディレクトリのルート。プレースホルダー使用可能: {GameExeName}, {Lang}"],["Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.","プラグインがゲーム内の画像をTextureDirectoryディレクトリの画像で置き換えようとするかどうかを示します。"],["Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.","プラグインが置き換え可能なテクスチャをTextureDirectoryにダンプするかどうかを示します。パフォーマンスに大きな影響があります。"],["Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.","ALT+Tホットキーで翻訳を切り替える際にテクスチャも影響を受けるかどうかを示します。すべてのテクスチャで動作する保証はありません。パフォーマンスに大きな影響があります。"],["Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.","プラグインがシーン読み込み時にテクスチャをスキャンするかどうかを示します。これにより、プラグインがより多くのテクスチャを見つけて（可能であれば）置き換えることができます。"],["Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.","プラグインがSpriteRendererをフックしようとするかどうかを示します。これは別のオプションです。なぜなら、SpriteRendererは実際には適切にフックできず、実装された回避策は特定の状況で理論的にパフォーマンスに影響を与える可能性があるためです。"],["Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.","変更されていないテクスチャを読み込むかどうかを示します。変更はファイル名のハッシュに基づいて判断されます。デバッグ目的でのみ有効にしてください。奇妙な動作を引き起こす可能性があります。"],["Texture Hash Generation Strategy","テクスチャハッシュ生成戦略"],["Indicates how the mod identifies pictures through hashes.","モッドがハッシュを通じて画像を識別する方法を示します。"],["Duplicate Texture Names","重複するテクスチャ名"],["Indicates specific texture names that are duplicated in the game. List is separated by ';'","ゲーム内で重複している特定のテクスチャ名を示します。リストは「;」で区切られています。"],["Indicates if the plugin should detect duplicate texture names.","プラグインが重複するテクスチャ名を検出するかどうかを示します。"],["Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.","プラグインが異なる戦略で画像を読み込むべきであることを示します。ゲームエンジンが古い場合に関連する可能性があります。"],["Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.","すべての読み込まれたテクスチャをメモリに保持して最適なパフォーマンスを実現することを示します。メモリ使用量を減らすには無効にしてください。"],["Resource Redirector","リソースリダイレクター"],["Preferred Storage Path","優先ストレージパス"],["Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}","Auto Translatorに関連してリダイレクトされたリソースの優先ストレージを示します。プレースホルダーを使用できます: {GameExeName}, {Lang}"],["Indicates if TextAssets should be redirected","TextAssetsをリダイレクトするかどうかを示します"],["Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked","プラグインがコンソールに読み込まれたすべてのアセットをログ記録するかどうかを示します。フック可能なものを特定するのに役立ちます"],["Indicates if translatable resources that are found should be dumped","見つかった翻訳可能なリソースをダンプするかどうかを示します"],["When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files","PreferredStoragePath内のZIPファイルにファイルがある場合、これらのファイルはメモリにインデックス化され、読み込み時のファイルチェックIOを回避します。このオプションを有効にすると、物理ファイルに対しても同じことを行います"],["HTTP","HTTP"],["User Agent","ユーザーエージェント"],["Override the user agent used by APIs requiring a user agent","ユーザーエージェントを必要とするAPIで使用されるユーザーエージェントを上書きします"],["Indiciates whether certificate validations for the .NET API should be disabled",".NET APIの証明書検証を無効にするかどうかを示します"],["Translation Aggregator","翻訳アグリゲーター"],["Width","幅"],["The total width of the translation aggregator window","翻訳アグリゲーターウィンドウの総幅"],["Height","高さ"],["The width (per translator) of the translation aggregator window.","翻訳アグリゲーターウィンドウの（翻訳者ごとの）幅"],["Enabled Translators","有効な翻訳者"],["The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'","翻訳アグリゲーターウィンドウで有効になっている翻訳エンドポイントのID。リストは「;」で区切られています。"],["Google","Google"],["ServiceUrl","サービスURL"],["OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC","オプション、Google APIリクエストを別のURLにリダイレクトするために使用できます。GFWoCを回避するために使用可能です。"],["Google Legitimate","Google Legitimate"],["Google API Key","Google APIキー"],["OPTIONAL, needed if GoogleTranslateLegitimate is configured","オプション、GoogleTranslateLegitimateが設定されている場合に必要です。"],["Bing Legitimate","Bing Legitimate"],["OcpApim Subscription Key","OcpApimサブスクリプションキー"],["OPTIONAL, needed if BingTranslateLegitimate is configured","オプション、BingTranslateLegitimateが設定されている場合に必要です。"],["Baidu","Baidu"],["Baidu App Id","Baidu App ID"],["OPTIONAL, needed if BaiduTranslate is configured","オプション、BaiduTranslateが設定されている場合に必要です。"],["BaiduAppSecret","BaiduAppSecret"],["Yandex","Yandex"],["Yandex API Key","Yandex APIキー"],["OPTIONAL, needed if YandexTranslate is configured","オプション、YandexTranslateが設定されている場合に必要です。"],["Watson","Watson"],["Url","URL"],["OPTIONAL, needed if WatsonTranslate is configured","オプション、WatsonTranslateが設定されている場合に必要です。"],["Key","キー"],["DeepL","DeepL"],["MinDelay","最小遅延"],["OPTIONAL, used for throttling DeepL","オプション、DeepLのスロットリングに使用"],["MaxDelay","最大遅延"],["DeepL Legitimate","DeepL 正当"],["OPTIONAL, required if DeepLLegitimate is configured","オプション、DeepLLegitimateが設定されている場合に必要"],["Custom","カスタム"],["Optional, needed if Custom Translated is configured","オプション、カスタム翻訳が設定されている場合に必要"],["Lec Power Translator 15","Lec Power Translator 15"],["InstallationPath","インストールパス"],["Optional, needed if Lec Power Translator 15 is configured","オプション、Lec Power Translator 15が設定されている場合に必要"],["Debug","デバッグ"],["Enables the console. Do not enable if other plugins (managers) handles this","コンソールを有効化。他のプラグイン（マネージャー）がこれを処理する場合は有効にしないでください"],["Enables extra logging for debugging purposes","デバッグ目的の追加ログを有効化"],["ezTrans","ezTrans"],["Installation Path of ezTrans.","ezTransのインストールパス"],["Migrations","マイグレーション"],["Used to enable automatic migrations of this configuration file","この設定ファイルの自動マイグレーションを有効にするために使用"],["Tag","タグ"],["Tag representing the last version this plugin was executed under. Do not edit","このプラグインが最後に実行されたバージョンを表すタグ。編集しないでください"]],"context":[["idx/0/innerText","idx/7/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/82/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/125/innerText"],["idx/126/innerText"],["idx/127/innerText"],["idx/128/innerText","idx/130/innerText"],["idx/129/innerText"],["idx/131/innerText"],["idx/132/innerText"],["idx/133/innerText"],["idx/134/innerText"],["idx/135/innerText","idx/149/innerText"],["idx/136/innerText","idx/138/innerText"],["idx/137/innerText"],["idx/139/innerText"],["idx/140/innerText","idx/145/innerText"],["idx/141/innerText","idx/143/innerText"],["idx/142/innerText"],["idx/144/innerText"],["idx/146/innerText","idx/147/innerText"],["idx/148/innerText"],["idx/150/innerText"],["idx/151/innerText"],["idx/152/innerText","idx/158/innerText"],["idx/153/innerText"],["idx/154/innerText"],["idx/155/innerText"],["idx/156/innerText"],["idx/157/innerText"],["idx/159/innerText"],["idx/160/innerText"],["idx/161/innerText"],["idx/162/innerText"],["idx/163/innerText"]],"basename":"configEdit.html","dirname":"/addons/unityTrans","extension":".html","filename":"configEdit.html","path":"/addons/unityTrans/configEdit.html","indexIsBuilt":true,"indexIds":{"General":0,"Executable file location":1,"\n\t\t\t\tPath to the application's executable file.\n\t\t\t":2,"Field can not be empty!":3,"Service":4,"End Point":5,"Auto translation service to use.":6,"Target Language":7,"The language to translate into":8,"Source Language":9,"The original language of the game. \"auto\" is also supported for some endpoints, but it is generally not recommended":10,"Files":11,"Directory":12,"Directory to search for cached translation files. Can use placeholder: {GameExeName}, {Lang}":13,"Output File":14,"File to insert generated translations into. Can use placeholders: {GameExeName}, {Lang}":15,"Substitution File":16,"File that contains substitution applied before translations. Can use placeholders: {GameExeName}, {Lang}":17,"Preprocessors File":18,"File that contains preprocessors to be applied before sending a text to a translator. Can use placeholders: {GameExeName}, {Lang}":19,"Text Frameworks":20,"Enable/Disable auto translation for Unity's text frameworks.":21,"":22,"Behaviour":22,"Max Characters Per Translation":23,"Max characters per text to translate. Max 2500.":24,"Whether or not to ignore whitespace, including newlines, in dialogue keys":25,"Whether or not to ignore whitespace, including newlines, in NGUI":26,"Minimum Dialogue Chars":27,"The length of the text for it to be considered a dialogue":28,"Force Split Text After Characters":29,"Split text into multiple lines once the translated text exceeds this number of characters. (0 is no split)":30,"Whether or not to copy hooked texts to clipboard":31,"MaxClipboardCopyCharacters":32,"Max number of characters to hook to clipboard at a time":33,"Whether or not the plugin should provide a \"best attempt\" at resizing UI components upon translation":34,"Indicates whether batching of translations should be enabled for supported endpoints":35,"Indicates whether or not to use translations from the included static translation cache":36,"Override Font":37,"Overrides the fonts used for texts when updating text components. NOTE: Only works for UGUI":38,"Override Font TextMeshPro":39,"Overrides the fonts used for texts when updating text components. NOTE: Only works for TextMeshPro":40,"Resize UI Line Spacing Scale":41,"A decimal value that the default line spacing should be scaled by during UI resizing, for example: 0.80. NOTE: Only works for UGUI":42,"Indicates whether the UI resize behavior should be applied to all UI components regardless of them being translated.":43,"Ignore Text Starting With":44,"Indicates that the plugin should ignore any strings starting with certain characters. This is a list seperated by ';'.":45,"Indicates whether or not to enable \"Text Getter Compatibility Mode\". Should only be enabled if required by the game.":46,"GameLog Text Paths":47,"Indicates specific paths for game objects that the game uses as \"log components\", where it continuously appends or prepends text to. Requires expert knowledge to setup. This is a list seperated by ';'.":48,"Romaji Post Processing":49,"Indicates what type of post processing to do on 'translated' romaji texts. This can be important in certain games because the font used does not support various diacritics properly. This is a list seperated by ';'. Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\"]":50,"Translation Post Processing":51,"Indicates what type of post processing to do on translated texts (not romaji). Possible values: [\"RemoveAllDiacritics\", \"ReplaceMacronWithCircumflex\", \"RemoveApostrophes\", \"ReplaceWideCharacters\"]":52,"Indicates whether or not results of regex lookups should be output to the specified OutputFile.":53,"Indicates whether or not whitespace differences should be output to the specified OutputFile.":54,"Indicates whether or not the complete result of regex-splitted translations should be output to the specified OutputFile.":55,"Indicates that the plugin should generate translations without variables when using substitutions.":56,"Indicates that the plugin should generate partial translations to support text translations as it is \"scrolling in\".":57,"Indicates the plugin should parse 'TARC' directives and scope translations based on these.":58,"Indicates the plugin should not print out success messages in relation to translations.":59,"Blacklisted IMGUI Plugins":60,"If an IMGUI window assembly/class/method name contains any of the strings in this list (case insensitive) that UI will not be translated. Requires MonoMod hooks. This is a list seperated by ';'":61,"Indicates if texts that are considered by the plugin to be untranslatable should be output to the specified OutputFile.":62,"Indicates that rules for virtual method calls should be ignored when trying to set the text of a text component. May in some cases help setting the text of stubborn components.":63,"Max Text Parser Recursion":64,"Indicates how many levels of recursion are allowed when text is parsed so it can be translated in different parts. This can be used with splitter-regexes in advanced scenarios. The default value of one essentially means that recursion is disabled.":65,"Will preprocess and decode html entities before they are send for translation. Some translators will fail when html entities are sent.":66,"Will enable automated handling of rich text (text with markup).":67,"Indicates if translator-related helpful log messages should be enabled. May be useful when tranlating based on redirected resources.":68,"Indicates that the plugin must use MonoMod hooks instead of harmony hooks.":69,"Indicates the plugin should initial harmony detour bridge which allows harmony hooks to work in an environment where System.Reflection.Emit does not exist (usually such settings are handled by plugin managers, so don't use when using a plugin manager).":70,"Redirected Resource Detection Strategy":71,"Indicates if and how the plugin should attempt to recognize redirected resources in order to prevent double translations.":72,"Indicates if the plugin should output text that exceeds <b>'Max Characters Per Translation'</b> without translating it.":73,"Texture":74,"Texture Directory":75,"Directory to dump textures to, and root of directories to load images from. Can use placeholder: {GameExeName}, {Lang}":76,"Indicates whether the plugin will attempt to replace in-game images with those from the TextureDirectory directory.":77,"Indicates whether the plugin will dump texture it is capable of replacing to the TextureDirectory. Has significant performance impact.":78,"Indicates whether or not toggling the translation with the ALT+T hotkey will also affect textures. Not guaranteed to work for all textures. Has significant performance impact.":79,"Indicates whether or not the plugin should scan for textures on scene load. This enables the plugin to find and (possibly) replace more texture.":80,"Indicates whether or not the plugin should attempt to hook SpriteRenderer. This is a seperate option because SpriteRenderer can't actually be hooked properly and the implemented workaround could have a theoretical impact on performance in certain situations.":81,"Indicates whether or not unmodified textures should be loaded. Modifications are determined based on the hash in the file name. Only enable this for debugging purposes as it is likely to cause oddities.":82,"Texture Hash Generation Strategy":83,"Indicates how the mod identifies pictures through hashes.":84,"Duplicate Texture Names":85,"Indicates specific texture names that are duplicated in the game. List is separated by ';'":86,"Indicates if the plugin should detect duplicate texture names.":87,"Indicates the plugin should use a different strategy to load images, that may be relevant if the game engine is old.":88,"Indicates that all textures loaded should be kept in memory for optimal performance. Disable to decrease memory usage.":89,"Resource Redirector":90,"Preferred Storage Path":91,"Indicates the preferred storage for redirected resources in relation to the Auto Translator. Can use placeholder: {GameExeName}, {Lang}":92,"Indicates if TextAssets should be redirected":93,"Indicates if the plugin should log to the console all loaded assets. Useful to determine what can be hooked":94,"Indicates if translatable resources that are found should be dumped":95,"When files are in ZIP files in the PreferredStoragePath, these files are indexed in memory to avoid performing file check IO when loading them. Enabling this option will do the same for physical files":96,"HTTP":97,"User Agent":98,"Override the user agent used by APIs requiring a user agent":99,"Indiciates whether certificate validations for the .NET API should be disabled":100,"Translation Aggregator":101,"Width":102,"The total width of the translation aggregator window":103,"Height":104,"The width (per translator) of the translation aggregator window.":105,"Enabled Translators":106,"The id's of the translation endpoints that has been enabled in the translation aggregator window. List is separated by ';'":107,"Google":108,"ServiceUrl":109,"OPTIONAL, can be used to direct google API request to a different URL. Can be used to circumvent GFWoC":110,"Google Legitimate":111,"Google API Key":112,"OPTIONAL, needed if GoogleTranslateLegitimate is configured":113,"Bing Legitimate":114,"OcpApim Subscription Key":115,"OPTIONAL, needed if BingTranslateLegitimate is configured":116,"Baidu":117,"Baidu App Id":118,"OPTIONAL, needed if BaiduTranslate is configured":119,"BaiduAppSecret":120,"Yandex":121,"Yandex API Key":122,"OPTIONAL, needed if YandexTranslate is configured":123,"Watson":124,"Url":125,"OPTIONAL, needed if WatsonTranslate is configured":126,"Key":127,"DeepL":128,"MinDelay":129,"OPTIONAL, used for throttling DeepL":130,"MaxDelay":131,"DeepL Legitimate":132,"OPTIONAL, required if DeepLLegitimate is configured":133,"Custom":134,"Optional, needed if Custom Translated is configured":135,"Lec Power Translator 15":136,"InstallationPath":137,"Optional, needed if Lec Power Translator 15 is configured":138,"Debug":139,"Enables the console. Do not enable if other plugins (managers) handles this":140,"Enables extra logging for debugging purposes":141,"ezTrans":142,"Installation Path of ezTrans.":143,"Migrations":144,"Used to enable automatic migrations of this configuration file":145,"Tag":146,"Tag representing the last version this plugin was executed under. Do not edit":147},"tags":[],"parameters":[]},"/addons/unityTrans/unityTrans.js":{"data":[["XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!","この操作を実行するにはXUnity Translatorが必要です\nサードパーティアプリケーションインストーラーからインストールしてください！"],["XUnity.AutoTranslator is found!","XUnity.AutoTranslatorが見つかりました！"],["Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.","Translator++はXUnity.AutoTranslatorが既にインストールされていることを検出しました。Translator++は既存の翻訳データを使用して新しい翻訳プロジェクトを開始します。"],["XUnity.AutoTranslator is not found!","XUnity.AutoTranslatorが見つかりません！"],["The wizard will guide you to install XUnity.AutoTranslator into the game.","ウィザードがゲームにXUnity.AutoTranslatorをインストールする手順を案内します。"],["Next","次へ"],["Given path: ","指定されたパス："],["\nis not an Unity game. Do you still want to proceed?","\nはUnityゲームではありません。それでも続行しますか？"],["Patch successfully installed!\r\n","パッチが正常にインストールされました！\r\n"],["The configuration will be generated when you play the game for the first time.\r\n","設定はゲームを初めてプレイする際に生成されます。\r\n"],["Open the game now?","今すぐゲームを開きますか？"],["Finish","完了"],["Update current project?","現在のプロジェクトを更新しますか？"]],"context":[["tid/432/type/StringLiteral"],["tid/7208/type/StringLiteral"],["tid/7224/type/StringLiteral"],["tid/7270/type/StringLiteral"],["tid/7287/type/StringLiteral"],["tid/7352/type/StringLiteral","tid/7929/type/StringLiteral"],["tid/7437/type/StringLiteral"],["tid/7441/type/StringLiteral"],["tid/7606/type/StringLiteral"],["tid/7613/type/StringLiteral"],["tid/7620/type/StringLiteral"],["tid/7730/type/StringLiteral"],["tid/8938/type/StringLiteral"]],"basename":"unityTrans.js","dirname":"/addons/unityTrans","extension":".js","filename":"unityTrans.js","path":"/addons/unityTrans/unityTrans.js","indexIsBuilt":true,"indexIds":{"XUnity Translator is needed to perform this action\nPlease install it through Third Party Application Installer!":0,"XUnity.AutoTranslator is found!":1,"Translator++ detects that XUnity.AutoTranslator is already installed. Translator++ will use existing translation data to start a new translation project.":2,"XUnity.AutoTranslator is not found!":3,"The wizard will guide you to install XUnity.AutoTranslator into the game.":4,"Next":5,"Given path: ":6,"\nis not an Unity game. Do you still want to proceed?":7,"Patch successfully installed!\r\n":8,"The configuration will be generated when you play the game for the first time.\r\n":9,"Open the game now?":10,"Finish":11,"Update current project?":12},"tags":[],"parameters":[]},"/addons/wolfJs/wolfJs.js":{"data":[["Maximum number of line in message box.","メッセージボックスの最大行数。"],["Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.","デフォルト値は4です。0を入力するとこの機能を無効にします。メッセージボックスの行数がこの数を超える場合、Translator++はテキストがボックスからはみ出るのを防ぐために新しいメッセージボックスを生成します。"],["Use shell copy if possible","可能であればシェルコピーを使用"],["Use shell copy instead of native NodeJS copy handler.","ネイティブのNodeJSコピーハンドラーの代わりにシェルコピーを使用します。"],["Use shell copy","シェルコピーを使用"],["WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?","WRPGE Editorがインストールされていません\r\nT++メニュー > サードパーティアプリケーションインストーラーからインストールしてください\r\n\r\n今すぐサードパーティアプリケーションインストーラーを開きますか？"],["Unable to determina WRPGE path.","WRPGEのパスを特定できません。"],["Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?","Translator++は指定フォルダにWRPGEエディターをインストールしようとしています。\r\n続行しますか？"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","開発パスが定義されていません。\n開発パスを生成するには、ゲームを一度注入してください。"],["Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.","WolfJsライブラリを使用して、バージョン3.330までのWolf RPGゲームを翻訳します。Translator++のデフォルトWolf RPGパーサーです。"],["Wolf RPG Editor games","Wolf RPGエディターゲーム"],["Parsing Wolf RPG Game with","Wolf RPGゲームを解析中："],["Wolf RPG Editor game","Wolf RPGエディターゲーム"],["Select the game's executable file","ゲームの実行ファイルを選択してください"],["Engine version","エンジンバージョン"],["Detected WolfRPG Engine version of the selected game","選択したゲームのWolfRPGエンジンバージョンを検出しました"],["Heads up!\r\n","ご注意ください！\r\n"],["\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?","\r\nWolf RPG実行ファイルではないようです！\r\nこのエントリーポイントからWolf RPGプロジェクトを開始してもよろしいですか？"],["Create a new project","新規プロジェクトを作成"],["Please specify a game to be processed!","処理するゲームを指定してください！"],["Set dev path. Path to the directory of the translated game.","開発パスを設定します。翻訳済みゲームのディレクトリへのパスです。"],["Play last build","最後のビルドを再生"],["Open editor","エディターを開く"],["Open Wolf RPG Editor online manual","Wolf RPGエディターオンラインマニュアルを開く"],["Open Wolf RPG Editor english manual","Wolf RPGエディター英語マニュアルを開く"],["Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.","マニュアルファイルが見つかりません。\nサードパーティアプリインストーラーを通じてWolf RPGエディターをインストールしてください。"]],"context":[["tid/99/type/StringLiteral","tid/12843/type/StringLiteral"],["tid/109/type/StringLiteral","tid/12853/type/StringLiteral"],["tid/486/type/StringLiteral"],["tid/496/type/StringLiteral"],["tid/513/type/StringLiteral"],["tid/7571/type/StringLiteral"],["tid/7624/type/StringLiteral"],["tid/7670/type/StringLiteral"],["tid/7851/type/StringLiteral","tid/12443/type/StringLiteral","tid/12542/type/StringLiteral"],["tid/10368/type/StringLiteral"],["tid/10411/type/StringLiteral"],["tid/10416/type/StringLiteral"],["tid/10429/type/StringLiteral"],["tid/10434/type/StringLiteral"],["tid/10447/type/StringLiteral"],["tid/10452/type/StringLiteral"],["tid/10752/type/StringLiteral"],["tid/10759/type/StringLiteral"],["tid/11124/type/StringLiteral"],["tid/11221/type/StringLiteral"],["tid/12334/type/StringLiteral"],["tid/12394/type/StringLiteral"],["tid/12493/type/StringLiteral"],["tid/12592/type/StringLiteral"],["tid/12650/type/StringLiteral"],["tid/12697/type/StringLiteral"]],"basename":"wolfJs.js","dirname":"/addons/wolfJs","extension":".js","filename":"wolfJs.js","path":"/addons/wolfJs/wolfJs.js","indexIsBuilt":true,"indexIds":{"Maximum number of line in message box.":0,"Default value is 4. Type 0 to disable this feature. If the number of line in message box is greater than this number, Translator++ will generates a new message box to prevents the texts overflowing the boxes.":1,"Use shell copy if possible":2,"Use shell copy instead of native NodeJS copy handler.":3,"Use shell copy":4,"WRPGE Editor is not installed\r\nPlease install it from T++ menu > Third party application installer\r\n\r\nOpen Third Party application installer now?":5,"Unable to determina WRPGE path.":6,"Translator++ is about to install WRPGE editor in the destination folder.\r\nContinue?":7,"Dev path is not defined.\nYou should inject your game once to generate dev path.":8,"Translate a Wolf RPG game up to ver. 3.330 with WolfJs library. The default Wolf RPG parser for Translator++.":9,"Wolf RPG Editor games":10,"Parsing Wolf RPG Game with":11,"Wolf RPG Editor game":12,"Select the game's executable file":13,"Engine version":14,"Detected WolfRPG Engine version of the selected game":15,"Heads up!\r\n":16,"\r\ndoesn't seem to be a Wolf RPG executable file!\r\nAre you sure want to start Wolf RPG Project from this entry point?":17,"Create a new project":18,"Please specify a game to be processed!":19,"Set dev path. Path to the directory of the translated game.":20,"Play last build":21,"Open editor":22,"Open Wolf RPG Editor online manual":23,"Open Wolf RPG Editor english manual":24,"Can not find the manual file.\nPlease install Wolf RPG Editor through 3rd Party app installer.":25},"tags":[],"parameters":[]},"/addons/xmlTrans/xml.js":{"data":[["Start translation from XML-like documents. Supports both XML and HTML format.","XML形式のドキュメントから翻訳を開始します。XMLとHTML形式の両方をサポートします。"],["Create project","プロジェクトを作成"]],"context":[["tid/795/type/StringLiteral"],["tid/864/type/StringLiteral"]],"basename":"xml.js","dirname":"/addons/xmlTrans","extension":".js","filename":"xml.js","path":"/addons/xmlTrans/xml.js","indexIsBuilt":true,"indexIds":{"Start translation from XML-like documents. Supports both XML and HTML format.":0,"Create project":1},"tags":[],"parameters":[]},"/addons/yurisParser/YurisParser.js":{"data":[["YU-RIS engine translator","YU-RISエンジン翻訳者"],["Checking up requirements...","要件を確認中..."],["Create a new translation project from YU-RIS visual novel engine","YU-RISビジュアルノベルエンジンから新しい翻訳プロジェクトを作成"],["Next","次へ"],["Select YU-RIS game","YU-RISゲームを選択"],["Select the game's executable file","ゲームの実行ファイルを選択"],["Engine version","エンジンバージョン"],["Detected YU-RIS version of the selected game","選択したゲームのYU-RISバージョンを検出"],["Create a new project","新しいプロジェクトを作成"],["Invalid target game :","無効なターゲットゲーム："],["Source material do not match the current translation project!","ソース素材が現在の翻訳プロジェクトと一致しません！"],["Select the repack method.","再パック方法を選択してください。"],["<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>","<ul><li><b>元のYPFファイルに再パック</b><br />翻訳を元のパックに再パックします。元のパックを抽出し、翻訳でパッチを適用して再度パックするため、時間がかかる場合があります。</li>"],["<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>","<li><b>YPFパッチファイルとして再パック</b><br>翻訳を別のパッチファイル（例：update9.ypf）として再パックします。これにより、元のypfファイルを変更せずにゲームを翻訳できます。より高速なパッチングプロセスのために、素材のコピーの<b>素材をコピーせず、翻訳のみを注入</b>オプションと組み合わせてください。</li></ul>"],["The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.","ターゲット再パックバージョンはゲームバージョンと一致する必要があります。メジャーとマイナーバージョンをドットで区切って入力してください。例：<b>0.466</b>。デフォルトでは、Translator++はプロジェクト作成時にエンジンバージョンを検出します。"]],"context":[["tid/4757/type/StringLiteral","tid/4811/type/StringLiteral"],["tid/4770/type/StringLiteral"],["tid/4816/type/StringLiteral"],["tid/4995/type/StringLiteral"],["tid/5081/type/StringLiteral"],["tid/5086/type/StringLiteral"],["tid/5099/type/StringLiteral"],["tid/5104/type/StringLiteral"],["tid/5440/type/StringLiteral"],["tid/5501/type/NoSubstitutionTemplate"],["tid/6038/type/StringLiteral"],["tid/6550/type/StringLiteral"],["tid/6557/type/NoSubstitutionTemplate"],["tid/6561/type/NoSubstitutionTemplate"],["tid/6613/type/StringLiteral"]],"basename":"YurisParser.js","dirname":"/addons/yurisParser","extension":".js","filename":"YurisParser.js","path":"/addons/yurisParser/YurisParser.js","indexIsBuilt":true,"indexIds":{"YU-RIS engine translator":0,"Checking up requirements...":1,"Create a new translation project from YU-RIS visual novel engine":2,"Next":3,"Select YU-RIS game":4,"Select the game's executable file":5,"Engine version":6,"Detected YU-RIS version of the selected game":7,"Create a new project":8,"Invalid target game :":9,"Source material do not match the current translation project!":10,"Select the repack method.":11,"<ul><li><b>Repack into original YPF file(s)</b><br />Will repack the translation to the original pack. May take longer time to extract the original pack, patch it with translation and repack it again.</li>":12,"<li><b>Repack as a YPF patch file</b><br>Will repack the translation as a separate patch file (e.g. update9.ypf). This way, it is possible to translate the game even without modifying the original ypf files. Combine this with Copy material's <b>Do not copy material, inject translation only</b> option for the faster patching process.</li></ul>":13,"The target repack version must match your game version. Enter the major and minor version separated by a dot. For example: <b>0.466</b>. By default, Translator++ will detect the engine version when you create the project.":14},"tags":[],"parameters":[]},"/automationEditor.html":{"data":[["Form Builder","フォームビルダー"],["Run","実行"],["New Project (ctrl+n)","新規プロジェクト (ctrl+n)"],["Open (ctrl+o)","開く (ctrl+o)"],["Save file (ctrl+s)","ファイル保存 (ctrl+s)"],["Save As (ctrl+shift+s)","名前を付けて保存 (ctrl+shift+s)"],["Open debugger (F12)","デバッガーを開く (F12)"],["Help","ヘルプ"],["Select file in the current workspace","現在のワークスペースでファイルを選択"],["file path","ファイルパス"],["Create shortcut of the current script","現在のスクリプトのショートカットを作成"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]]