x/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":true,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","データに関連するファイルが見つかりません"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","これを修正するには、<a href=\"#\" class=\"openProjectProperties\">プロジェクトプロパティ</a>の<b>素材の場所</b>フィールドを修正してください"],["Copy path to clipboard","パスをクリップボードにコピー"],["Path has been copied to clipboard.","パスがクリップボードにコピーされました。"],["Open folder","フォルダを開く"],["Open with external application","外部アプリケーションで開く"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","開く..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~デフォルト翻訳を使用~"],["Column","列"],["Do you want to delete all context translation on the currently selected row?","現在選択されている行のすべてのコンテキスト翻訳を削除しますか？"],["Do you want to delete all translation on the currently active row?","現在アクティブな行のすべての翻訳を削除しますか？"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":true,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"parameters":[]},"/js/addon.js":{"data":[["invalid type addonObj","無効なタイプ addonObj"],["invalid type addonObj.addons","無効なタイプ addonObj.addons"],["You are not eligible to get this addon","このアドオンを取得する資格がありません"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":true,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"parameters":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Translator++へのショートカットを作成する前に、現在のプロジェクトを保存してください。"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","この機能は、Translator++の開発者バージョンを使用している場合のみ利用可能です。基本ユーティリティ -> コアNWJSを変更 を使用して開発者バージョンに切り替えることができます。"]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/find.js":{"data":[["Action","アクション"],["Append tags","タグを追加"],["Remove tags","タグを削除"],["Set tags","タグを設定"],["Do nothing","何もしない"],["Close","閉じる"],["Proceed","続行"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","キーワードが短すぎます！\nすべての行を検索しようとしていますか？アスタリスク '*' をキーワードとして使用してみてください。"],["Found nothing!<br />Don't forget to set the Target search field.","何も見つかりませんでした！<br />検索対象フィールドを設定することを忘れないでください。"],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","置換するものが見つかりませんでした！<br />置換機能はキー列の何も置換しません。"],["Replace '","「"],["' with '","」を「"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","」に置換しますか？\r\nこの機能の元に戻す機能はまだ作成していません！\n本当に続行しますか？"],["click to go","クリックして移動"],["This will replace any translation found in target colum,\nAre you sure?","これはターゲット列で見つかった翻訳をすべて置換します、\n本当に実行しますか？"],["Keyword too short!","キーワードが短すぎます！"],["Not found!","見つかりませんでした！"],["Are you sure want to execute the following script?","次のスクリプトを実行してもよろしいですか？"],["For ","選択された"],[" selected item(s)?","件に対して？"],[" Select all","すべて選択"],[" Invert selection","選択を反転"],[" Clear selection","選択をクリア"],[" Set Red tag","赤タグを設定"],[" Set Yellow tag","黄タグを設定"],[" Set Green tag","緑タグを設定"],[" Set Blue tag","青タグを設定"],[" Set Gold tag","金タグを設定"],[" More tags...","その他のタグ..."],[" Clear tags","タグをクリア"],[" Create Automation","自動化を作成"],[" Run Automation","自動化を実行"],[" Clear Automation","自動化をクリア"],["Are you sure want to clear all quick launch scripts?","すべてのクイック起動スクリプトをクリアしてもよろしいですか？"],[" Clear translation","翻訳をクリア"],["Do you want to clear translations of the selected items?","選択した項目の翻訳をクリアしますか？"],[" Delete rows","行を削除"],["Do you want to remove selected rows?\nYou can not undo this action!","選択した行を削除しますか？\nこの操作は元に戻せません！"],[" With selection ...","選択中..."],["Always on top","常に最前面"],["Default","デフォルト"],["Blur opacity","ぼかしの不透明度"],["Type regex with the modifier","修飾子付きの正規表現を入力"],["Use $n to replace a group. e.g. $1","グループを置換するには $n を使用。例: $1"],["Find","検索"],["Replace","置換"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":true,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","パスワードを隠す"],["Show password","パスワードを表示"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":true,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","一部の設定は、アプリケーションを再起動しないと有効になりません。\n作業を保存し、Translator++を再起動してください。"],["Pleae select the name for your configuration.","設定の名前を選択してください。"],["Translator Engine configuration","翻訳エンジン設定"],["Translator engine version.","翻訳エンジンのバージョン。"],["By.","作成者："],["No option for this engine","このエンジンにはオプションがありません"],["License","ライセンス"],["Can not disable this addon","このアドオンを無効にできません"],["Requirements","必要条件"],["What is this?","これは何ですか？"],["Uninstall","アンインストール"],["Update","更新"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","アドオンが正常にインストールされました。\r\n一部のアドオンが有効になるには、Translator++を再起動する必要がある場合があります。"],["WARNING!\n","警告！\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","このアドオンは「パーサー変更」としてマークされています。このアドオンに関連する古いプロジェクトは、期待通りに動作しなくなる可能性があります。このアドオンをインストールする前に、プロジェクトをバックアップすることをお勧めします。\n既存の翻訳を新しく作成したプロジェクトにインポートできます。\n\nインストールしますか？"],["Do you want to install ","インストールしますか？"],["Add-on","アドオン"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","正常にインストールされました。\r\n一部のアドオンが有効になるには、Translator++の再起動が必要な場合があります。"],["Add-on version.","アドオンのバージョン。"],["No option for this add-on","このアドオンにはオプションがありません"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++はWindowsのレジストリに書き込みます。\r\nよろしいですか？"],["Error parsing patterns:","パターンの解析エラー："],["Do you really want to clear the custom escaper?","カスタムエスケープを本当にクリアしますか？"],["Do you really want to reset the custom escaper?","カスタムエスケープを本当にリセットしますか？"],["You are currently on the latest version.\nDo you still want to update?","現在最新バージョンです。\nそれでも更新しますか？"],["This option will open your default browser to login.\nDo you want to continue?","このオプションは、ログインするためにデフォルトブラウザを開きます。\n続行しますか？"],["Login with Browser","ブラウザでログイン"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","ブラウザが<b>dreamsavior.net/gettoken/</b>に開かれました。<br>ログインすると自動的に完了します。<br><br>自動ログインが機能しない場合は、そのページからトークンをコピーして以下に貼り付けてください："],["There is no default translator selected.\nChange the default translator to Google!","デフォルトの翻訳者が選択されていません。\nデフォルトの翻訳者をGoogleに変更します！"],["Change Stagging Path to :","ステージングパスを変更先："],["Move the content of current Stagging Path into the new one?","現在のステージングパスの内容を新しいパスに移動しますか？"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","アドオンがインストールされました。\n有効にするにはTranslator++の再起動が必要です。"],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","すべての設定をクリアしてTranslator++をデフォルトにリセットしますか？\nこの操作は元に戻せませんのでご注意ください。\n続行前にプロジェクトをバックアップしてください。"],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","エラーを修正しないとTranslator++が正常に動作しない可能性があります。\nオプションウィンドウを閉じますか？"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":true,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","Translator++へのショートカットを作成する前に、現在のプロジェクトを保存してください"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","この機能は、Translator++の開発者バージョンを使用している場合のみ利用可能です。基本ユーティリティ -> コアNWJSの変更から開発者バージョンに切り替えることができます。"]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":true,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>PHPインタープリターを実行できません！</b><br />\n\t\t\t\tTranslator++は一部の必須手順を実行するためにPHP CLIが必要です。<br />\n\t\t\t\tこのエラーは通常、コンピューターに<b><a href=\"http://dreamsavior.net/download/#TPPSysreq\">正しいバージョンのMicrosoft Visual C++再頒布可能パッケージ</a>がインストールされていない</b>ために発生します。\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li><a href=\"http://dreamsavior.net/download/#TPPSysreq\">必要なランタイム</a>をインストールしてください。</li>\n\t\t\t\t\t\t<li>すべてのランタイムをインストールしてもこのエラーが発生する場合は、Translator++のインストールディレクトリを他のフォルダに移動してください。</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tこの症状の詳細については、<a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>ドキュメント</a>をご確認ください。"],["Initialization Error!","初期化エラー！"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":true,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"parameters":[]},"/js/trans.js":{"data":[["Original Text","原文"],["Initial","初期"],["Machine translation","機械翻訳"],["Better translation","より良い翻訳"],["Best translation","最良の翻訳"],["Loading","読み込み中"],["Error!","エラー！"],["Error processing init file : ","初期化ファイルの処理エラー："],["Error! File list not found in init file at : ","エラー！初期化ファイルでファイルリストが見つかりません："],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","これは、ゲームが正常に解析されなかったことを意味します。この問題の解決策については、https://dreamsavior.net/?p=1311 をご覧ください。"],["Done!","完了！"],["All done!","すべて完了！"],["Error opening file : ","ファイルを開くエラー："],["error opening file (open): ","ファイルを開くエラー（開く）："],["Project properties - Staging path error!","プロジェクトプロパティ - ステージングパスエラー！"],["Project properties","プロジェクトプロパティ"],["untitled project","無題プロジェクト"],["create file list","ファイルリストを作成"],["Finished","完了"],["All process finished!","すべての処理が完了しました！"],["Open Explorer","エクスプローラーを開く"],["Opening file!","ファイルを開いています！"],["Assigning new staging path : ","新しいステージングパスを割り当て中："],["Success!","成功！"],["Failed!","失敗！"],["Collecting paths","パスを収集中"],["Path : '","パス：'"],["' doesn't exist","' は存在しません"],[" file(s) collected!"," ファイルを収集しました！"],["Start importing data!","データのインポートを開始！"],["Importing : ","インポート中："],["All Done!","すべて完了！"],[" is not a valid object name"," は有効なオブジェクト名ではありません"],[" is not a valid directory name"," は有効なディレクトリ名ではありません"],[" is already exist"," はすでに存在します"],["Error opening file :","ファイルを開くエラー："],["Error executing :","実行エラー："],["Are you sure want to execute the following script?","以下のスクリプトを実行してもよろしいですか？"],["Clear quick launch","クイック起動をクリア"],["Are you sure want to clear quick launch?","クイック起動をクリアしてもよろしいですか？"],["How to add Automation here","ここに自動化を追加する方法"],["Select all","すべて選択"],["Clear selection","選択をクリア"],["Select 100%","100%を選択"],["Select <100%","<100%を選択"],["Select progress ≥ ...","進捗 ≥ ...を選択"],["Select completed","完了を選択"],["Invert selection","選択を反転"],["Toggle mark as complete","完了としてマークを切り替え"],["With all","すべてと"],["With ","と"],[" selected"," 選択済み"],["Mark as complete","完了としてマーク"],["Un-mark as complete","完了としてマーク解除"],["Batch translation","一括翻訳"],["Send to...","送信先..."],["Wrap texts","テキストを折り返す"],["Trim","トリム"],["Auto padding","自動パディング"],["Context Tool","コンテキストツール"],["Create Automation","自動化を作成"],["For each object","各オブジェクトについて"],["For each row","各行について"],["Run Automation","自動化を実行"],["Import from...","インポート元..."],["Trans File","翻訳ファイル"],["Spreadsheets","スプレッドシート"],["RPGMTransPatch Files","RPGMTransPatchファイル"],["Export into...","エクスポート先..."],["A folder","フォルダ"],["Zipped Game Patch","圧縮ゲームパッチ"],["Comma Separated Value (csv)","カンマ区切り値 (csv)"],["Excel 2007 Spreadsheets (xlsx)","Excel 2007スプレッドシート (xlsx)"],["Excel Spreadsheets (xls)","Excelスプレッドシート (xls)"],["ODS Spreadsheets","ODSスプレッドシート"],["Html Spreadsheets","HTMLスプレッドシート"],["RMTrans Patch","RMTransパッチ"],["Inject Translation","翻訳を挿入"],["Revert to original","元に戻す"],["Clear translation","翻訳をクリア"],["Delete files","ファイルを削除"],["Properties","プロパティ"],["Select progress greater than","進捗が以上の場合を選択"],["Please input a number","数字を入力してください"],["Do you want to clear translation?","翻訳をクリアしますか？"],["Add comment","コメントを追加"],["Remove comment","コメントを削除"],["added to reference table!","参照テーブルに追加されました！"],["Can not modify Column 0","列0は変更できません"],["Unable to delete table : ","テーブルを削除できません："],["Can not remove key column!","キー列は削除できません！"],["Please open or create a project first","まずプロジェクトを開くか作成してください"],["Column name can not be empty!","列名は空にできません！"],["Invalid column index!","無効な列インデックスです！"],["Please open or create a new project first!","まず新しいプロジェクトを開くか作成してください！"],["You should not edit key value","キー値は編集しないでください"],["Ilegal value","不正な値"],["That value already exist!","その値は既に存在します！"],["The maximum number of columns for this project has been reached, so you cannot add any more.","このプロジェクトの最大列数に達したため、これ以上追加できません。"],["Are you sure want to abort this process?","この処理を中止してもよろしいですか？"],["Process paused!\nPress OK to continue!","処理が一時停止しました！\n続行するにはOKを押してください！"],["Unable to process, project not found","処理できません、プロジェクトが見つかりません"],["Unable to process, data not found","処理できません、データが見つかりません"],["Translation engine not found","翻訳エンジンが見つかりません"],["Translation engine ","翻訳エンジン"],[" is disabled!","は無効です！"],["Selected files :","選択されたファイル："],["Collecting data from :","データ収集中："],["Translation finished","翻訳完了"],["applying translation to table!","テーブルに翻訳を適用中！"],["Error when translating data!","データ翻訳中にエラーが発生しました！"],["\tHTTP Status : ","\tHTTPステータス："],["\tError Type : ","\tエラータイプ："],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","翻訳サービスから一時的に利用制限されている可能性があります！\r\nオンライン翻訳サービスは適度にご利用ください\r\n通常、1〜2日以内に自動的に解除されます。\r\n"],["Running trans.translateAll","trans.translateAllを実行中"],["Start collecting data!","データ収集を開始！"],["Data collection is done!","データ収集完了！"],["nothing is selected","何も選択されていません"],["no translator loaded","翻訳機が読み込まれていません"],["unable to load translator window","翻訳ウィンドウを読み込めません"],["Reference path cannot empty!","参照パスは空にできません！"],["Collecting translation refference","翻訳参照を収集中"],["Applying translation!","翻訳を適用中！"],["Importing translation","翻訳をインポート中"],["Parsing data","データを解析中"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions","は有効なJavaScriptの正規表現ではありません！\r\nJavaScriptの正規表現について詳しくは：\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"],["Keyword too short!","キーワードが短すぎます！"],["Delete comment","コメントを削除"],["Translate here","ここで翻訳"],["Translate here using ","ここで翻訳（"],["Translate using...","翻訳方法..."],["Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?","選択したセルの翻訳で、このプロジェクト内の同じテキストをすべて翻訳しますか？"],[" cell(s) has been written!","セルが書き込まれました！"],["Column width","列幅"],["Width must greater than 0","幅は0より大きくなければなりません"],["Insert column right","右に列を挿入"],["Duplicate column","列を複製"],["Remove this column","この列を削除"],["Remove selected column?\nThis can not be undone!","選択した列を削除しますか？\nこの操作は元に戻せません！"],["Rename this column","この列の名前を変更"],["Please enter new name","新しい名前を入力してください"],["Tags","タグ"],["Red","赤"],["Yellow","黄"],["Green","緑"],["Blue","青"],["Gold","金"],["More tags...","その他のタグ..."],["Clear tags","タグをクリア"],["Delete Row","行を削除"],["Do you want to remove the currently selected row(s)?","現在選択されている行を削除しますか？"],["Clear Context Translation","コンテキスト翻訳をクリア"],["Clear Automation","自動化をクリア"],["Are you sure want to clear all quick launch scripts?","すべてのクイック起動スクリプトをクリアしてもよろしいですか？"],["Append rows to reference","参照に行を追加"],["Row properties","行のプロパティ"]],"context":[["tid/2227/type/StringLiteral","tid/2619/type/StringLiteral"],["tid/2233/type/StringLiteral","tid/2625/type/StringLiteral"],["tid/2239/type/StringLiteral","tid/2631/type/StringLiteral"],["tid/2245/type/StringLiteral","tid/2637/type/StringLiteral"],["tid/2251/type/StringLiteral","tid/2643/type/StringLiteral"],["tid/4770/type/Str