100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-05e7d66a.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-05e7d66a.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js":{"data":[["customModels.customLabel","自訂模型.自訂標籤"],["model","模型"],["|","|"],["promptLibrary","提示庫"],["search","搜尋"],["downloadChat","下載聊天"],["newChat","新聊天"],["api","API"],["customEndpoint","自訂端點"],["apiEndpoint.inputLabel","API端點.輸入標籤"],["apiKey.inputLabel","API金鑰.輸入標籤"],["apiVersion.inputLabel","API版本.輸入標籤"],["apiVersion.description","API版本.描述"],["securityMessage","安全訊息"],["apiEndpoint.description","API端點描述"],["apiEndpoint.warn","API端點警告"],["partialImportMessages","部分匯入訊息"],["import","匯入"],["name","名稱"],["prompt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","同步通知"],["toast.stop","停止通知"],["button.sync","同步按鈕"],["button.stop","停止按鈕"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/