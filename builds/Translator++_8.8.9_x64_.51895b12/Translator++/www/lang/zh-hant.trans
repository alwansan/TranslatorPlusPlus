ed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"relPath":"/js/ui.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","您可以在控制台日誌（F12）中查看更詳細的資訊"],["Close","關閉"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","您可以在控制台日誌（F12）中查看更詳細的資訊"],["Close","關閉"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/ui.parts.js":{"data":[["Form","表單"],["Cancel","取消"],["Ok","確定"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/jsoneditor.html":{"data":[["Remove note","移除註記"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/login.html":{"data":[["working","工作中"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/note.html":{"data":[["Remove note","移除註記"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/options.html":{"data":[["Click to login","點擊登入"],["Translator &amp; Language","翻譯器與語言"],["Proofreader","校對員"],["Assistant","助手"],["General","一般"],["Preferences","偏好設定"],["Add-ons","附加元件"],["About","關於"],["User Information","使用者資訊"],["Login to your Patreon account to get access to the latest features and updates.","登入您的Patreon帳戶以獲取最新功能和更新。"],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> 登入"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> 使用瀏覽器登入"],["Welcome,","歡迎，"],["Name","名稱"],["Email","電子郵件"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","等級 <div class=\"infoHeadNote\">（當前訂閱金額，以美分計）</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","點數 <div class=\"infoHeadNote\">（終身訂閱總金額，以美分計）</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","付款狀態 <div class=\"infoHeadNote\">（當前付款狀態）</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">別慌張！</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>請閱讀以下資訊。</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">此標誌表示 Patreon 尚未成功收到您的贊助款項。付款系統延遲是正常現象。根據您的付款方式和國家，延遲可能長達 24 小時。</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">在此延遲期間，您可能會看到信用卡被扣款。別擔心——Patreon 會定期重試檢查是否已收到您的付款。這通常在 24 小時內自行解決。</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">如果問題持續超過此期間，請在 Discord 上的 Translator++ 伺服器的 <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> 討論串中發文。我將盡力協助您。</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">請理解，為防止詐騙，<b><span class=\"userInfoPoints\">點數</span> 和 <span class=\"userInfoLevel\">等級</span> 將不會計入，直到 Patreon 成功收到您的付款為止</b>。</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">別慌張！</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","此標誌表示 Patreon 尚未成功收到您的贊助款項。付款系統延遲是正常現象。根據您的付款方式和國家，延遲可能長達 24 小時。"],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","在此延遲期間，您可能會看到信用卡被扣款。別擔心——Patreon 會定期重試檢查是否已收到您的付款。這通常在 24 小時內自行解決。"],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","如果問題持續超過此期間，請在 Discord 上的 Translator++ 伺服器的 <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> 討論串中發文。我將盡力協助您。"],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","請理解，為防止詐騙，<b><span class=\"userInfoPoints\">點數</span> 和 <span class=\"userInfoLevel\">等級</span> 將不會計入，直到 Patreon 成功收到您的付款為止</b>。"],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> 登出"],["Primary Translator","主要翻譯器"],["Default Translator Engine","預設翻譯引擎"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\t當您在選取的儲存格上按 <span class=\"keyboardHint\">Ctrl+g</span> 以<strong>生</strong>成翻譯時，將使用此翻譯引擎。\n\t\t\t\t"],["Default Language","預設語言"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\t跨專案的預設語言設定！<br>\n\t\t\t\t專案屬性中的設定將覆蓋此值。\n\t\t\t"],["Default Source Language","預設來源語言"],["Default Target Language","預設目標語言"],["Custom escape","自訂跳脫"],["Patterns","模式"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\t所有符合以下模式的詞語將不會由機器翻譯器翻譯。\n\t\t\t\t\t\t此部分適合用於隱藏標籤和腳本，使其不被翻譯引擎處理。<br>\n\t\t\t\t\t\t每個條目可以是有效的JavaScript正則表達式、函數或literal string，以<b>逗號</b>分隔。<br>\n\t\t\t\t\t\t自訂跳脫僅適用於支援的<a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">跳脫演算法</a>。\n\t\t\t\t\t\t<b>提示：</b>您也可以請ChatGPT為您生成正則表達式。<br>\n\t\t\t\t\t\t請寫下正則表達式模式及其修飾符。<br>\n\t\t\t\t\t\t例如：\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","測試器"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\t在此處貼上您的文字以檢查模式。\n\t\t\t\t\t\t所有匹配的模式將被高亮顯示。\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>施工中</h2>\n\t\t\t\t<p>此區域將用於配置自動校對器的設定和選項。</p>\n\t\t\t"],["AI Assistant","AI助手"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>嗨！我是MIRAI，您的Translator++ AI助手。👋</strong></p>\n\t\t\t\t\t\t<p>只需點擊主選單上的我的圖標<button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button>即可與我聊天。我可以協助您：</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>翻譯改進與建議</li>\n\t\t\t\t\t\t\t<li>校對與品質檢查</li>\n\t\t\t\t\t\t\t<li>設定您的翻譯工作流程</li>\n\t\t\t\t\t\t\t<li>創建自動化腳本</li>\n\t\t\t\t\t\t\t<li>以及更多！</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>讓我們一起讓您的翻譯工作更輕鬆、更有效率！</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>附註：我還是新手，所以請對我耐心一點。🙇‍♀️但我每天都在學習和進步！😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","AI配置"],["Model Endpoint","模型端點"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","您的AI模型的API端點URL。例如：https://api.openai.com/v1/chat/completions"],["API Key","API金鑰"],["Your API key for authenticating with the AI service. This will be stored securely.","用於驗證AI服務的API金鑰。此金鑰將安全儲存。"],["Model Name","模型名稱"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","選擇或輸入要使用的AI模型。建議使用支援工具功能的模型以獲得最佳效果。"],["File Association","檔案關聯"],["Extension","副檔名"],["Associate","關聯"],["Set All","設定全部"],["Unset All","全部取消設定"],["Apply","套用"],["Update","更新"],["Auto update","自動更新"],["Automatically update Translator++ if possible.","如果可能，自動更新 Translator++。"],["Allow reinstall the same version","允許重新安裝相同版本"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","允許 Translator++ 重新安裝已安裝的相同版本。請在安裝更新後保持此選項禁用，特別是當您的<b>自動更新</b>設定開啟時。否則，每次開啟程式時，您的 Translator++ 將持續自我更新。"],["Use default browser to login","使用預設瀏覽器登入"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","使用您信任的系統預設瀏覽器登入您的 Patreon 帳戶。除非勾選此選項，否則將使用 Translator++ 的內嵌瀏覽器。"],["Multi threading","多執行緒"],["Number of thread","執行緒數量"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","同時開啟的子進程數量。<br>\n\t\t\t\t\t\t\t0 = 禁用多執行緒。所有進程將由渲染器進程處理。<br>\n\t\t\t\t\t\t\t最佳數量通常是您的實體核心數 - 1。\n\t\t\t\t\t\t"],["Backup","備份"],["Enable backup","啟用備份"],["Automatically create backup every time you save your project.","每次儲存專案時自動建立備份。"],["Backup level history","備份歷史層級"],["How many history of backup do you want to keep?","您希望保留多少備份歷史？"],["Log &amp; Debugging","日誌與除錯"],["Log to file","記錄到檔案"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","將日誌記錄到檔案而非預設的控制台視窗。<br>如果您想除錯 Translator++ 且無法存取控制台視窗，這很有用。啟用此選項會輕微影響效能。因此，除非您正在除錯或報告問題，否則應始終保持此選項關閉。<br>日誌儲存在 data/logs/ 資料夾中。"],["Truncate log file each session","每次會話截斷日誌文件"],["When checked your log file will be truncated each time you re open the application.","勾選後，每次重新開啟應用程式時，您的日誌文件將被截斷。"],["Application Settings","應用程式設定"],["Enable remote debugging","啟用遠端除錯"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","在端口 9222 上啟用 Chrome DevTools 遠端除錯協議。這允許您通過導航到 <code>chrome://inspect</code> 使用外部瀏覽器檢查和除錯 Translator++。此標誌將 <code>--remote-debugging-port=9222</code> 添加到應用程式啟動參數中。需要重新啟動以應用更改。"],["Disable GPU","禁用 GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","禁用硬體 GPU 加速。如果您在某些圖形硬體或驅動程式上遇到視覺故障、崩潰或渲染問題，這很有用。此標誌將 <code>--disable-gpu</code> 添加到應用程式啟動參數中。需要重新啟動以應用更改。"],["Dangerous Area","危險區域"],["Interface Language","介面語言"],["UI Language","UI 語言"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","設定使用者介面的語言。如果 Translator++ 沒有您語言的本地化版本，您可以創建自己的本地化。語言數據位於 www/lang 資料夾內。"],["Spell checker Language","拼寫檢查器語言"],["Set the default spell checker language.","設定預設的拼寫檢查器語言。"],["Environment Variables","環境變數"],["Staging Directory","暫存目錄"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","暫存目錄是正在處理的專案的硬快取。從原始材料中複製一部分數據到此目錄，以供解釋器腳本訪問。"],["Project creation","專案創建"],["Auto Load Common Reference","自動載入通用參考"],["Auto load common reference from .trans file.","從 .trans 文件自動載入通用參考。"],["Project settings","專案設定"],["Progress Column Indices","進度欄索引"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","在此，您可以指定哪些欄位將納入專案進度計算中。\n\t\t\t\t\t\t\t<br>欄位索引是從零開始的整數，最左側的欄位為0。\n\t\t\t\t\t\t\t<br>使用逗號分隔指定多個欄位。例如：<code>2,3,4</code>。\n\t\t\t\t\t\t\t<br><b>預設：空白</b>。若留空，Translator++ 將從所有可用欄位計算進度。\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>啟用/停用"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>安裝"],["Install from a package","從套件安裝"],["Visit our website &amp; documentation : ","訪問我們的網站與文檔："],["Fork Translator++ at : ","在以下位置分叉 Translator++："],["Support Translator++ at : ","在以下位置支持 Translator++："],["Join our discord channel at : ","加入我們的 Discord 頻道："],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) 如果您是贊助者，應<a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">在您的 Patreon 個人資料中連結 Discord 帳戶</a>。您將自動收到邀請，並有福利等著您！"],["Version Info","版本資訊"],["Last checked at : ","最後檢查於："],["Check now!","立即檢查！"],["You have a pending update","您有待處理的更新"],["Update now","立即更新"],["Your Translator++ is up to date 😃.","您的 Translator++ 已是最新版本 😃。"],["Architecture","架構"],["License","授權"],["Click here to read the license.","點擊此處閱讀授權條款。"],["Credits","致謝"],["Localization","本地化"],["About Third Party Software","關於第三方軟體"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\t本軟體使用了位於 /3rdParty 的第三方軟體。這些第三方軟體擁有各自的許可證，\n\t\t\t\t僅為使用便利而包含，並以「現狀」提供，不提供任何明示或暗示的擔保，\n\t\t\t\t使用此類軟體需自行承擔風險。\n\t\t\t\t"],["Special Thanks","特別感謝"],["Want to explicitly support Translator++ by putting your name on this section?","想透過在此部分列出您的名字來明確支持 Translator++ 嗎？"],["Click here to learn more about how to do that!","點擊這裡了解更多如何操作！"],["Changelog","更新日誌"],["Feeds","動態"],["Click connect button, to connect translator with Translator++ table","點擊連接按鈕，將翻譯器與 Translator++ 表格連接"],["working","工作中"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","Patreon 等級/您本月當前的贊助金額（以分計，1 美元 = 100 分）"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","點數/您終身贊助金額+獎勵（以分計，1 美元 = 100 點）"],["Filter...","篩選..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":124,"length":124,"percent":100},"parameters":[]},"/scriptEditor.html":{"data":[["Run","執行"],["New Project (ctrl+n)","新專案 (ctrl+n)"],["Open (ctrl+o)","開啟 (ctrl+o)"],["Save file (ctrl+s)","儲存檔案 (ctrl+s)"],["Save As (ctrl+shift+s)","另存新檔 (ctrl+shift+s)"],["Open debugger (F12)","開啟偵錯工具 (F12)"],["Help","說明"],["Select file in the current workspace","在當前工作區中選擇檔案"],["file path","檔案路徑"],["Create shortcut of the current script","創建當前腳本的捷徑"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/tableEditor.html":{"data":[["Reset","重置"],["Clear","清除"],["Search","搜尋"],["Help","幫助"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/trans.html":{"data":[["Start","開始"],["Home","首頁"],["Translator","翻譯器"],["Objects","物件"],["Live translation","即時翻譯"],["Original","原始"],["Raw","原始碼"],["Row Properties","行屬性"],["Default translation","預設翻譯"],["Context translation","上下文翻譯"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\t路徑 <a class=\"problemPath\"></a> 無法被 PHP 解釋器存取。<br>\n\t\t請重新命名路徑，僅使用字母數字命名。\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>位置</span>"],["File :","檔案："],["Row ID :","行ID :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>上下文</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>角色</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>關鍵文本</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>最佳翻譯</span>"],["File ID","檔案ID"],["Path","路徑"],["Original Format","原始格式"],["Data Length","資料長度"],["Translated","已翻譯"],["General","一般"],["Language","語言"],["Staging","暫存"],["Stats","統計"],["Advanced","進階"],["Info","資訊"],["Title","標題"],["File Location","檔案位置"],["Project ID","專案ID"],["Built on","建於"],["Editor Name","編輯器名稱"],["Editor Version","編輯器版本"],["Engine","引擎"],["Parser","解析器"],["Parser version","解析器版本"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","原始素材位置 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"原始素材的位置。您不應修改此資料夾內的任何內容。\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> 路徑無效。<br>在修復之前，某些功能將被禁用。"],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","翻譯素材位置 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"已翻譯遊戲的位置。翻譯注入的預設位置。\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","翻譯器 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"此專案的首選翻譯器。如果未定義，將使用全域設定。\"></i>"],["Translate From","翻譯自"],["Translate Into","翻譯為"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","暫存路徑 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"暫存路徑是匯出/建構翻譯所需的一些檔案位置。暫存檔案在您創建專案時生成。\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","物件 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"左側窗格中可用的物件/檔案數量\"></i>"],["Folders","資料夾"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","字元 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"原始文字列中的字元數量\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","單詞 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"在不使用空格的語言（如日語、中文）中可能顯示錯誤值。\"></i>"],["Total Rows","總行數"],["Translated row","已翻譯行"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","有機翻譯 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"用戶直接在網格中填寫的翻譯。這是一個好跡象。可能是人工翻譯，也可能是編輯過的機器翻譯等。\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","整體進度 <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","匯出後執行<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"在此專案成功匯出後執行一個javascript函數。\"></i>"],["Display this information when the project is opened.","當專案開啟時顯示此資訊。"],["Select Export Mode","選擇匯出模式"],["Export to a folder","匯出至資料夾"],["Export pre-compiled game data to a folder<br>Folder structures are retained","匯出預編譯的遊戲資料至資料夾<br>資料夾結構保留"],["Export as a Zip file","匯出為Zip檔案"],["Export pre-compiled game data to a single zipped archive","匯出預編譯的遊戲資料至單個壓縮存檔"],["RPGMakerTrans Patch Files","RPGMakerTrans補丁檔案"],["Export to RPGMakerTrans formatted *.txt files in a folder","匯出為RPGMakerTrans格式的*.txt檔案至資料夾"],["Comma Separated Values","逗號分隔值"],["Export to Comma Separated Values (csv) files in a folder","匯出為逗號分隔值（csv）檔案至資料夾"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) Excel 2007及以上版本"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","匯出為Microsoft Excel試算表（xlsx）檔案至資料夾"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) Excel 97及以上版本"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","匯出為Microsoft Excel試算表（xls）檔案至資料夾"],["HTML Spreadsheet","HTML試算表"],["Export to HTML files in a folder","匯出為HTML檔案至資料夾"],["Open Document Format/OASIS (.ods)","開放文件格式/OASIS (.ods)"],["Export to ODS files in a folder","匯出為ODS檔案至資料夾"],["Select Import Mode","選擇匯入模式"],["Import translation from another .trans file","從另一個 .trans 檔案匯入翻譯"],["Open another Translator++ file<br>Apply translation into current project.","開啟另一個 Translator++ 檔案<br>將翻譯套用至當前專案。"],["Import translation from spreadsheets","從試算表匯入翻譯"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","從各種試算表檔案匯入翻譯<br>(.xls, .xlsx, .ods, .html, .xml 等)"],["Import translation from RPGMakerTrans Patch format","從 RPGMakerTrans 修補格式匯入翻譯"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","從 RPGMaker Trans 的修補檔案匯入翻譯<br>(.txt)"],["Source :","來源："],["Select objects to import","選擇要匯入的物件"],["Import mode :","匯入模式："],["Import translations","匯入翻譯"],["Import data object","匯入資料物件"],["Destination :","目的地："],["Currently selected : ","當前選擇："],["Options :","選項："],["Import the context translations","匯入上下文翻譯"],["Case insensitive","不區分大小寫"],["Overwrite target","覆寫目標"],["Destination column : ","目的地欄位："],["Translation mode :","翻譯模式："],["Row by row translation","逐行翻譯"],["Line by line translation","逐句翻譯"],["Select translation by context address","根據上下文地址選擇翻譯"],["Just copy translation into the same row (No checking)","僅將翻譯複製到同一行（不檢查）"],["Merge data","合併數據"],["Import translation from spreadsheet into project","從電子表格導入翻譯到專案"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","從任何電子表格格式（xls、xlsx、odx、html、csv等）導入翻譯。"],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>電子表格必須至少有2列。</b>最重要的列是第一列（最左列），包含原始文本。後續列包含翻譯。Translator++將使用最右側非空單元格中的文本。"],["Please click the radio button to select files/folder to import","請點選單選按鈕以選擇要導入的文件/資料夾"],["Import file(s)","導入文件"],["Import folder","導入資料夾"],["Import translation from RPG Maker Trans into project","從RPG Maker Trans導入翻譯到專案"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">選擇專案類型</span>"],["Select project type","選擇專案類型"],["Spreadsheet","電子表格"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","從電子表格數據（xls、xlsx、ods、xml、html、sylk、gnumeric、csv）開始翻譯專案"],["Blank project","空白專案"],["Create a new .trans file from scratch.","從頭創建一個新的.trans文件。"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">電子表格</span>"],["Fetch type","獲取類型"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","前幾列是可翻譯的文字，其餘列是預定義的翻譯（創建與原始表格匹配的網格數據）"],["All columns are translatable text","所有列都是可翻譯的文字"],["Custom","自訂"],["Custom Options","自訂選項"],["Which column do you want to fetch?","您想擷取哪一列？"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","請指定您想擷取的列以及要放入翻譯的列。<b>這是基於零的索引（第一列是0）</b>。"],["Column to be translated","要翻譯的列"],["Column to put translation into","放入翻譯的列"],["Action","操作"],["Enable Row Header Text Column","啟用行標題文字列"],["If enabled, the parser will process the following Row Header Text Column rule","如果啟用，解析器將處理以下行標題文字列規則"],["Row Header Text Column","行標題文字列"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","如果指定，此列中的值將應用於行標題。這對於確定當前發言者或演員等很有用。它是基於零的索引。"],["Options","選項"],["Calculate cell value","計算儲存格值"],["Cell value in the form of formula will be transpiled","公式形式的儲存格值將被轉譯"],["Get formatted value","取得格式化值"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","在格式化後處理儲存格值。（例如，在某些地區設定中，整數100000會變成USD 100,000）"],["Parse CSV in EXCEL format","以EXCEL格式解析CSV"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","強制解析器以MS EXCEL方式解析CSV。（僅適用於CSV檔案）"],["Skip the first <i>n</i> row(s)","跳過前 <i>n</i> 行"],["Use this option if you want to skip the row header.","如果您想跳過行標題，請使用此選項。"],["Select File(s)","選擇檔案"],["Select a directory","選擇目錄"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">建立新的翻譯檔案</span>"],["Create a new Trans file","建立新的翻譯檔案"],["The title of this project","此專案的標題"],["Engine type","引擎類型"],["Type of the engine","引擎的類型"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">預留位置，即將推出精彩內容！</span>"],["Placeholder for something great at the near future!","預留位置，即將推出精彩內容！"],["This module will be created when the patron count reach 500!","當贊助者數量達到 500 時，將創建此模組！"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\t已存在相同標題的專案 <br>\"<span class=\"dialogGameTitle\"></span>\"<br> 於後處理快取中。<br>\n\t\t您可以重新使用此快取以顯著縮短載入時間。\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","如果您感到困惑，可以隨時安全地點擊 <strong><a href=\"#\">「建立新專案」</a></strong> 按鈕。"],["Existed cache","現有快取"],["Select Translator","選擇翻譯器"],["Source column","來源欄"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","哪一欄是要翻譯的來源文本？<br>（預設為鍵欄 / 最左欄）。"],["Target column","目標欄"],["Which column is the translated text put into.<br>(Can not same with source column)","翻譯文本將放入哪一欄。<br>（不能與來源欄相同）"],["Translator's Options","翻譯器選項"],["Also try to translate other object","同時嘗試翻譯其他物件"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","如果勾選此選項，Translator++ 將同時嘗試翻譯您未選擇且不需要機器翻譯的其他物件。這是 Translator++ 版本 2.3.23 或更低的預設行為。"],["Ignore if already translated","若已翻譯則忽略"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果勾選此選項，Translator++ 將忽略任何在其欄位中已有翻譯的行。"],["Overwrite cells","覆寫儲存格"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","覆寫目標儲存格。如果未勾選，當儲存格非空時將不會被觸動。"],["Save project on each batch.","每批次儲存專案"],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","在每批次完成時儲存您的專案。<br>此選項是為了避免應用程式因執行本地翻譯應用程式的繁重任務而崩潰時導致數據丟失。如果您使用的是基於雲端的翻譯器，可能不需要此選項。"],["Play sound when completed.","完成時播放音效"],["Tags","標籤"],["Select Context(s)","選擇上下文"],["Manual Query","手動查詢"],["Match all words","匹配所有詞語"],["Remove selected","移除選中的"],["Remove all but selected","移除除選中外的所有"],["Select Context","選擇上下文"],["Source Column","來源欄位"],["Target Column","目標欄位"],["Maximum length","最大長度"],["Export into","匯出至"],["What to do with tagged rows?","如何處理標記的行？"],["Select Color Tag","選擇顏色標籤"],["On the fly word wrap","即時自動換行"],["Inject all files (ignoring selection)","注入所有檔案（忽略選擇）"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","您即將透過<b>注入所有</b>按鈕注入翻譯。這將注入翻譯，無論您在左側面板選擇了哪個物件。如果您想注入選定的物件，請使用左側面板的上下文選單。"],["Select the source material to be translated","選擇要翻譯的原始素材"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\t選擇您希望翻譯的特定素材或內容，例如檔案、目錄或其他相關輸入。確保所選素材可存取且格式適合對應的解析器。<br>\n\t\t\t\t預設情況下，某些解析器使用暫存目錄作為原始素材。\n\t\t\t"],["Path is inaccessible.","路徑無法存取。"],["Target Directory","目標目錄"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\t您的翻譯應用程式副本將在此資料夾中生成。\n\t\t\t"],["Field can not be empty!","欄位不能為空！"],["Target to apply translation","應用翻譯的目標"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\t請選擇可執行檔案。\n\t\t\t"],["Copy materials","複製素材"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","從原始素材到目標目錄的複製選項。（實驗性，並非所有引擎都支援）"],["Word Wrap by Tags","按標籤自動換行"],["Directory name","目錄名稱"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\t物件將在此目錄下分組。<br>\n\t\t\t\t輸入星號 \"<code>*</code>\" 以新增<b>參考物件</b>。\n\t\t\t"],["Invalid directory  name","無效的目錄名稱"],["Object name","物件名稱"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\t物件的名稱。\n\t\t\t"],["Invalid object name","無效的物件名稱"],["New Project","新專案"],["Save","儲存"],["Save as...","另存為..."],["Open...","開啟..."],["Recent","最近"],["None...","無..."],["Export Project","匯出專案"],["To a folder","至資料夾"],["As a zip file","作為 zip 檔案"],["To portable .tpp file","至可攜式 .tpp 檔案"],["To RPGMakerTrans file (*.txt)","至 RPGMakerTrans 檔案 (*.txt)"],["To CSV file","至 CSV 檔案"],["To XLSX file","至 XLSX 檔案"],["To XLS file","至 XLS 檔案"],["To ODS file","至 ODS 檔案"],["To HTML file","至 HTML 檔案"],["Import","匯入"],["Project from .tpp file","從 .tpp 檔案開啟專案"],["Translation from .trans file","從 .trans 檔案匯入翻譯"],["Translation Spreadsheet","翻譯試算表"],["Translation RPGMKTRANSPATCH Format","翻譯 RPGMKTRANSPATCH 格式"],["Automation","自動化"],["Batch translation","批次翻譯"],["Context tool","上下文工具"],["Batch word wrapping","批次換行"],["Trim","修剪"],["Auto padding","自動填充"],["Tools","工具"],["Third Party Application Installer","第三方應用程式安裝器"],["Close project","關閉專案"],["Exit","退出"],["Start here","從這裡開始"],["Start a New Project","開始新專案"],["Continue your work","繼續您的工作"],["Open Project","開啟專案"],["Your recent translation","您最近的翻譯"],["Tips for you","給您的提示"],["Next tip! <span class=\"icon-angle-double-right\"></span>","下一個提示！<span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","行中最右側的儲存格將獲得優先權。"],["You can't share your project with others with just a trans file. You need to generate a TPP file.","您不能僅憑翻譯檔案與他人分享專案。您需要生成一個TPP檔案。"],["Always make backups of your trans files.","請務必備份您的翻譯檔案。"],["You can rename and reorder the column with the coulumn header's context menu.","您可以透過列標題的上下文選單重新命名和重新排序列。"],["Always backup your game before working with Translator++!","在使用Translator++之前，請務必備份您的遊戲！"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","如果您遇到功能運行不正常的情況，請嘗試重新啟動Translator++，這在大多數情況下能解決問題。"],["Always create a backup of your game before patching with a translation.","在套用翻譯前，請務必創建遊戲的備份。"],["Thank you for supporting Translator++.","感謝您支持Translator++。"],["Please check Translator++'s online documentation at","請查看Translator++的在線文檔於"],["working","工作中"],["Open","開啟"],["Save file","儲存檔案"],["Save As","另存新檔"],["Import Project","匯入專案"],["Inject / apply all translation","注入/套用所有翻譯"],["Execute Global Level Custom Script","執行全域層級自訂腳本"],["Toggle Active Cell Info","切換活動儲存格資訊"],["Project Properties","專案屬性"],["Get Help (F1)","取得幫助（F1）"],["Batch translation (crl+b)","批次翻譯 (Ctrl+B)"],["File list","檔案清單"],["Live Translation Pane","即時翻譯面板"],["Toggle selection","切換選擇"],["Invert selection","反轉選擇"],["Add A New Object","新增物件"],["Connect to auto translator","連接到自動翻譯器"],["Undock pane","取消面板停靠"],["Collapse / restore left panel","摺疊/還原左側面板"],["Add new key (alt+n)","新增鍵 (Alt+N)"],["Import Here","在此匯入"],["Add a note to this file","為此檔案新增註解"],["Open search menu","開啟搜尋選單"],["Toggle grid information","切換網格資訊"],["Object Properties","物件屬性"],["Automatically set selected original text to clipboard","自動將選取的原始文字設定到剪貼簿"],["Resize Font","調整字型大小"],["Toggle word wrapping & Explicit white spaces","切換文字換行與顯示空白字元"],["Use Monospace font","使用等寬字型"],["Remove all translation from this file","從此檔案移除所有翻譯"],["Remove this file from project","從專案中移除此檔案"],["file path","檔案路徑"],["Quick find","快速查找"],["Active cell's info","活動儲存格的資訊"],["View original untranslated text","查看原始未翻譯文字"],["View raw data","查看原始資料"],["View row properties","查看列屬性"],["Go to current cell","前往目前儲存格"],["Current coordinate","目前座標"],["Word wraping (for non Japanese text)","文字換行（適用於非日文文字）"],["Speak original text (alt+,)","朗讀原始文字（Alt+,）"],["Copy original text into current cell (ctrl+0)","複製原始文字到目前儲存格（Ctrl+0）"],["Default translation for all occurrence","所有出現的預設翻譯"],["Translations by context","依上下文翻譯"],["This cell has a comment","此儲存格有註解"],["This cell has an organic content","此儲存格有有機內容"],["This cell has been visited","此儲存格已被訪問"],["This is the first time this cell has been visited","這是此儲存格首次被訪問"],["Word wraping","文字換行"],["Speak current translation text (alt+.)","朗讀目前翻譯文字（Alt+.）"],["Current Cell Editor options","當前儲存格編輯器選項"],["Clear context translation for current row","清除當前行的上下文翻譯"],["Get help about translation by context","獲取關於上下文翻譯的幫助"],["Open menu","開啟選單"],["Path not accessible","路徑無法存取"],["The location of the original material. You should not modify anything inside this folder.","原始素材的位置。您不應修改此資料夾內的任何內容。"],["The location of the game that has been translated. The default location of the translation injection.","已翻譯遊戲的位置。翻譯注入的預設位置。"],["Prefered translator for this project. If not defined, global setting will be used.","此專案的首選翻譯器。如果未定義，將使用全域設定。"],["-use default-","-使用預設-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","暫存路徑是匯出/建構翻譯所需某些檔案的位置。暫存檔案在您建立專案時生成。"],["Number of objects/files available on the left pane","左側窗格中可用的物件/檔案數量"],["Number of characters in the Original Text column","原始文字欄中的字元數"],["May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).","在不使用空格（例如日文、中文）的語言中可能顯示錯誤值。"],["Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.","使用者直接填入網格中。這是一個好跡象。可能是人工翻譯、編輯過的機器翻譯等。"],["Run a javascript function after this project is successfully exported.","在此專案成功匯出後執行一個 JavaScript 函數。"],["Import .TRANS into project","將 .TRANS 匯入專案"],["Import Spreadsheet Options","匯入試算表選項"],["Import RPGMTransPatch Options","匯入 RPGMTransPatch 選項"],["Start a new project","開始新專案"],["Search project type...","搜尋專案類型..."],["Remove row","移除行"],["Add row","新增行"],["Project is exist","專案已存在"],["Context Tool","上下文工具"],["Your list of context separated by new line","您的上下文列表，以換行分隔"],["Wrap text","換行文字"],["Export Options","匯出選項"],["Tagging","標記"],["Apply Translation","套用翻譯"],["Add new Object","新增物件"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText","idx/56/innerText"],["idx/29/innerText","idx/152/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText","idx/41/innerText"],["idx/40/innerText"],["idx/42/innerText"],["idx/43/innerText"]