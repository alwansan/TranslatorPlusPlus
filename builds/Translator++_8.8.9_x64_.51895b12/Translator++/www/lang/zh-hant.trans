mpt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","同步通知"],["toast.stop","停止通知"],["button.sync","同步按鈕"],["button.stop","停止按鈕"]],"context":[["tid/100616/type/StringLiteral"],["tid/100621/type/StringLiteral"],["tid/461589/type/StringLiteral"],["tid/553065/type/StringLiteral","tid/621844/type/StringLiteral"],["tid/553097/type/StringLiteral"],["tid/557240/type/StringLiteral","tid/557260/type/StringLiteral","tid/557282/type/StringLiteral"],["tid/560133/type/StringLiteral","tid/560171/type/StringLiteral","tid/560214/type/StringLiteral"],["tid/606093/type/StringLiteral","tid/606166/type/StringLiteral","tid/606207/type/StringLiteral","tid/606305/type/StringLiteral","tid/606384/type/StringLiteral","tid/606410/type/StringLiteral","tid/606531/type/StringLiteral","tid/606553/type/StringLiteral","tid/606575/type/StringLiteral"],["tid/606161/type/StringLiteral"],["tid/606202/type/StringLiteral"],["tid/606300/type/StringLiteral"],["tid/606379/type/StringLiteral"],["tid/606405/type/StringLiteral"],["tid/606526/type/StringLiteral"],["tid/606548/type/StringLiteral"],["tid/606570/type/StringLiteral"],["tid/608417/type/StringLiteral"],["tid/608422/type/StringLiteral"],["tid/621955/type/StringLiteral","tid/629854/type/StringLiteral"],["tid/621975/type/StringLiteral"],["tid/622292/type/StringLiteral"],["tid/622315/type/StringLiteral"],["tid/629235/type/StringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","自定義模型標籤"],["model","模型"],["|","|"],["promptLibrary","提示庫"],["search","搜尋"],["downloadChat","下載聊天"],["newChat","新聊天"],["api","API"],["customEndpoint","自定義端點"],["apiEndpoint.inputLabel","API端點輸入標籤"],["apiKey.inputLabel","API金鑰輸入標籤"],["apiVersion.inputLabel","API版本輸入標籤"],["apiVersion.description","API版本描述"],["securityMessage","安全訊息"],["apiEndpoint.description","API端點描述"],["apiEndpoint.warn","API端點警告"],["partialImportMessages","部分導入訊息"],["import","導入"],["name","名稱"],["prompt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","toast.sync"],["toast.stop","toast.stop"],["button.sync","button.sync"],["button.stop","button.stop"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"|":2,"promptLibrary":3,"search":4,"downloadChat":5,"newChat":6,"api":7,"customEndpoint":8,"apiEndpoint.inputLabel":9,"apiKey.inputLabel":10,"apiVersion.inputLabel":11,"apiVersion.description":12,"securityMessage":13,"apiEndpoint.description":14,"apiEndpoint.warn":15,"partialImportMessages":16,"import":17,"name":18,"prompt":19,"clearPrompts":20,"morePrompts":21,"toast.sync":22,"toast.stop":23,"button.sync":24,"button.stop":25},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","使用 ChatGPT 批次 API 翻譯"],["Model","模型"],["The pre-trained model.","預訓練模型。"],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","OpenAI 批次 API 似乎使用與一般 API 略有不同的模型命名約定。批次 API 中使用的模型帶有「-batch」前綴。例如，如果您使用 <code>gpt-4.1-mini</code>，模型會自動變為 <code>gpt-4.1-mini-batch</code>。<br />\n然而，截至本插件創建時，批次模型未列在 OpenAI 的模型使用限制中，這使得用戶如果將模型使用過濾器設為「允許」（白名單），則無法使用批次 API。<br />\n這可能是 OpenAI UI 中的一個錯誤，未來可能會修復。<br />\n因此，請確保將 OpenAI 中的使用限制設為「阻止」（黑名單）模式，以便使用批次 API。<br />\n點擊此處更改模型的使用限制：https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","來源欄位"],["The column of the original texts you want to translate.","您要翻譯的原始文本所在欄位。"],["Add actor name","添加角色名稱"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","將行資訊中的角色名稱附加到可翻譯文本中。這將幫助譯者追蹤對話和人稱代詞。Translator++ 隨後會從翻譯結果中移除角色名稱。這顯然會增加翻譯成本。"],["Ignore if already translated","若已翻譯則忽略"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","如果勾選此選項，則 Translator++ 將忽略任何已在該欄位有翻譯的行。"],["Load Actor Reference as Glossary","載入角色參考作為詞彙表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾選，Translator++ 將載入角色參考作為詞彙表。這將幫助譯者理解對話的上下文。角色參考是對話中角色的名稱。這將作為詞彙表載入到翻譯器中。這會增加翻譯成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有對話中存在的角色才會作為每個批次項目的詞彙表載入。使用模板命令在提示訊息中載入角色參考。"],["Actor Reference Translation Column","角色參考翻譯欄位"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名稱翻譯的欄位。此欄位將用作角色參考的翻譯。這將提高對話中角色名稱翻譯的一致性。"],["Actor's Information Column","演員資訊欄"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含演員額外資訊的欄位。您可以添加更多資訊，如性別、年齡等。這將改善對話中代詞的翻譯。"],["System Message Template","系統訊息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系統訊息是訊息的標頭，用於告知您的ChatGPT助手的角色。此訊息將作為您發送給ChatGPT的每批訊息中的第一條訊息。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用JavaScript模板字面量風格包含以下變數 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","變數：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 來源語言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目標語言</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完整來源語言名稱</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完整目標語言名稱</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 來源文字</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 預定義的逃逸演算法訊息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 表示換行的字串（行替代）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的訊息數量。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : 添加演員的資訊。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 遊戲標題</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 遊戲引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : 從Translator++物件生成參考。<br />範例：<code>REFERENCE[Common Reference]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : 包含一些前幾行作為上下文</li>"],["Body Message Template","主體訊息模板"],["Template of the body of your chat.","聊天內容的範本。"],["Sample conversation","範例對話"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT 批次 API 讓您能以 50% 更低的成本非同步翻譯您的專案，這意味著您將在 <b style=\"color:red\">24 小時內</b>收到翻譯結果，且成本僅為 <b style=\"color:red\">正常價格的一半</b>。這對於不需要立即翻譯結果的大型專案特別有用。"],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .","<br />了解更多關於 ChatGPT 批次 API：https://platform.openai.com/docs/guides/batch 。"],["General Settings","一般設定"],["This form is using your existing ChatGPT configuration.<br>","此表單使用您現有的 ChatGPT 配置。<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","您可以前往選項視窗中的 ChatGPT 翻譯器設定來變更配置。<br>"],["There you can set the API key, model, and other settings.<br />","在那裡，您可以設定 API 金鑰、模型和其他設定。<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"開啟 ChatGPT 設定\" />"],["Append actor name to the translatable text","將角色名稱附加到可翻譯文字"],["Ignore translated rows","忽略已翻譯的行"],["Glossary","詞彙表"],["<h2>Glossary</h2>","<h2>詞彙表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能將幫助您自動將詞彙表加入提示中。詞彙表會為每批項目載入，以提升翻譯品質。功能會嘗試僅載入相關術語，以避免提示過於臃腫。</p>"],["The Column of Actor's Additional Information","角色附加資訊的欄位"],["Prompt Template","提示範本"],["<h2>1. System Message</h2>","<h2>1. 系統訊息</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>在這裡，您可以向助理解釋他們的角色。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 範例對話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>現有對話的範例。您可以撰寫良好或不良回應的範例，以幫助翻譯者理解您的目標和對話的上下文。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 您的實際提示</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>這是發送給助手的實際提示。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>間接成本</h3>\n                        間接成本是指您發送給助手的提示訊息中，不包含實際翻譯文本的成本。成本是根據提示訊息中的令牌數量計算的。令牌越多，成本越高。<br>\n                        <b>當前間接成本：</b> <span class=\"overheadCost\">0</span> 令牌 / 請求。"],["Are you sure you want to reset the form?","您確定要重置表單嗎？"],["Are you sure you want to process the batch?\nCost will be incurred for this operation.","您確定要處理批次嗎？\n此操作將產生成本。"],["The batch is successfully created. Do you want to open the batch manager?","批次已成功創建。您要開啟批次管理器嗎？"],["OpenAI Batch API Queue","OpenAI 批次 API 隊列"]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transChatGPT/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":62,"length":62,"percent":100},"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>","<li>標題 : 遊戲的標題</li>"],["<li>ENGINE : Engine of the game</li>","<li>引擎 : 遊戲的引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>參考[物件名稱] : 從 Translator++ 物件生成參考。<br />範例：<code>參考[通用參考]</code></li>"]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transChatGPT/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","請選擇要套用翻譯的行"],["Target Column","目標欄位"],["The column to put the translation result.","放置翻譯結果的欄位。"],["Import translation from ChatGPT Batch","從ChatGPT批次匯入翻譯"],["Translation applied to selected rows","翻譯已套用至選定的行"],["Invalid format","格式無效"],["OK","確定"],["Mismatch","不匹配"],["Failed to load batch list with error: \n","載入批次清單失敗，錯誤：\n"],["Download Error File","下載錯誤檔案"],["Batch is not completed yet","批次尚未完成"],["Are you sure you want to cancel this batch?","您確定要取消此批次嗎？"],["Cannot cancel completed batch.","無法取消已完成的批次。"],["Batch cancelled","批次已取消"],["Failed to cancel batch","取消批次失敗"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","批次"],["Apply translation","套用翻譯"],["Cancel batch","取消批次"],["Status","狀態"],["Batch ID","批次 ID"],["Input File ID","輸入檔案 ID"],["End point","端點"],["Created at","建立於"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","到期於 <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"未及時完成的批次最終會進入到期狀態；該批次中未完成的請求將被取消，而對已完成請求的回應可透過批次的輸出檔案取得。您將被收取已完成請求所消耗的代幣費用。\"></i>"],["Completed at","完成於"],["Errors","錯誤"],["Batch Item Detail of","批次項目詳情"],["ID","ID"],["Completed on","完成於"],["Model","模型"],["Prompt Token","提示代幣"],["Completion Token","完成代幣"],["Total Token","總代幣"],["Status Code","狀態碼"],["error","錯誤"],["Conversation","對話"],["Response Validation","回應驗證"],["Raw Payload","原始資料"],["View raw payload","檢視原始資料"],["Response Preview","回應預覽"],["Apply translations from selected rows","套用選取列的翻譯"],["Here you can edit the translation result individually and send it into Translator++","在此您可以個別編輯翻譯結果並將其發送至 Translator++"],["Open ChatGPT Settings","開啟 ChatGPT 設定"],["Help","說明"],["File list","檔案清單"],["Collapse / restore left panel","摺疊/還原左側面板"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","未及時完成的批次最終會進入過期狀態；該批次中未完成的請求將被取消，而對已完成請求的回應則可透過該批次的輸出檔案取得。您將被收取已完成請求所消耗的令牌費用。"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat","OpenAI 聊天"],["Target URL","目標 URL"],["Target end point. You can use any service that supports OpenAI API.","目標端點。您可以使用任何支援 OpenAI API 的服務。"],["Sample endpoints","範例端點"],["Use this endpoint","使用此端點"],["Copy to clipboard","複製到剪貼簿"],["e.g.","例如"],["API Key","API 金鑰"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","在此輸入您的 API 金鑰。<br>獲取 API 金鑰的方法因服務而異。<br>"],["Leave it blank if the service doesn't require API key.","如果服務不需要 API 金鑰，請留空。"],["Model","模型"],["The pre-trained model","預訓練模型"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","對於OpenAI，您可能需要設定允許使用的模型（https://platform.openai.com/settings/proj_xxx/limits）。"],["Enable Context","啟用上下文"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","啟用翻譯的上下文。當前批次上方的先前翻譯材料將作為上下文包含。<b>您還需要明確將CONTEXT包含在模板中</b>"],["Context Character Limit","上下文字元限制"],["Character limit for the context.","上下文的字元限制。"],["System Message Template","系統訊息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系統訊息是訊息的標頭，將告知您的chatGPT助理的角色。此訊息將作為您發送給chatGPT的每個批次的第一條訊息發送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用JavaScript模板文字風格包含以下變數 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","變數：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 來源語言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目標語言</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 來源文本</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 預定義的轉義算法訊息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 代表換行的字串（行替代）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : 批次中的訊息數量。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : 遊戲標題</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 遊戲引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色資訊詞彙表。（僅在批次模式中啟用角色資訊選項時）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[物件名稱]：從Translator++物件生成參考。<br />範例：<code>REFERENCE[通用參考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT：先前翻譯的上下文（若啟用上下文）</li>"],["Sample conversation","樣本對話"],["User message","使用者訊息"],["Assistant's response","助理的回應"],["Body Message Template","主體訊息模板"],["Template of the body of your chat.","您聊天主體的模板。"],["Enable JailBreak","啟用越獄"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","為翻譯啟用越獄。這將使翻譯更準確且較少偏見。某些模型可能希望將虛構事件與現實生活事件聯繫起來，因此它們會嘗試改變翻譯以符合其自身敘述。此選項將防止這種情況。"],["Jailbreak Template","越獄模板"],["Template of the Jailbreak message.","越獄訊息的模板。"],["Maximum Tokens","最大令牌數"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","完成中生成的最大令牌數。<br>您的提示令牌數加上max_tokens不能超過模型的上下文長度。大多數模型的上下文長度為2048個令牌（除了最新模型支援4096）。"],["Temperature","溫度"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","使用的採樣溫度，介於0到2之間。較高的值如0.8將使輸出更隨機，而較低的值如0.2將使其更專注和確定性。<br>OpenAI通常建議調整此值或top_p，但不要同時調整兩者。"],["Nucleus sampling (top_p)","核心採樣（top_p）"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","溫度採樣的替代方案，稱為核心採樣，模型考慮具有top_p概率質量的令牌結果。因此0.1表示僅考慮構成前10%概率質量的令牌。<br>OpenAI通常建議調整此值或溫度，但不要同時調整兩者。"],["Frequency Penalty","頻率懲罰"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","介於-2.0和2.0之間的數字。正值根據令牌在文本中現有的頻率懲罰新令牌，減少模型重複相同字句的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","存在懲罰"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","介於 -2.0 和 2.0 之間的數值。正值會根據新詞彙是否已在文本中出現來懲罰它們，增加模型談論新主題的可能性。<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","使用 JSON 架構"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","使用 <code>json_schema</code> 代替舊的 <code>json_object</code> 作為 <code>response_format.type</code> 欄位。一些最新模型和伺服器（如 <b>LM Studio</b>）需要 <code>json_schema</code>，但一些舊模型仍在使用 <code>json_object</code>。"],["Max Characters per Batch","每批次最大字元數"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","每批次翻譯的最大字元限制。\n此選項僅計算原始文本的字元長度，不包括提示訊息的長度。"],["Max concurrent requests","最大並行請求數"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","允許同時連接多少個並行請求？每個額外的並行連接會倍增翻譯速度，但也會快速消耗供應商設定的令牌限制。<br />設為 <b>0</b> 以禁用此功能。<br />結合此選項與 <b>每並行請求最大行數</b> 可進一步提升翻譯速度。<br />將此選項設為大於 1 會影響 <b>上下文</b>，因為前一個請求完成前會有新請求處理，導致上下文發送時不包含先前請求的翻譯結果。"],["Max row per concurrent requests","每並行請求最大行數"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","每個並行請求允許的行數。設為 <b>0</b> 以禁用此功能。<br />如果禁用此選項，則無論 <b>最大並行請求數</b> 設為多少，Translator++ 都會將請求作為單一區塊處理。<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","設定的行數越多，單一批次可獲得的翻譯越多，從而減少額外成本，但增加 AI 返回錯誤結果的機率。<br />數字越低，翻譯出錯的可能性越小，但會因額外提示而增加成本。"],["Preserve translations from invalid returned number of rows","保留無效返回行數的翻譯"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","保留行數無效的回應中的翻譯。<br />如果勾選，Translator++ 會嘗試修正行數並將翻譯插入網格中。<br />如果未勾選，儲存格將保持空白。<br />建議為重譯目的保持此選項未勾選。"],["Batch delay","批次延遲"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","批次之間的延遲（以毫秒為單位）。<br />使用此設定控制請求，以避免達到 RPM（每分鐘請求數）限制。"],["Batch Timeout","批次超時"],["Timeout for each batch in milisecond","每個批次的超時時間（以毫秒為單位）"],["Code Escaping Algorithm","程式碼轉義演算法"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","對話中內嵌程式碼的轉義演算法。您可能需要根據選擇的轉義演算法調整 <b>系統訊息模板</b> 和 <b>主體訊息模板</b>。<br />選擇 <b>JSONCloaking</b> 或 <b>JSONObjectCloaking</b> 時，會自動發送 <code>response_format: { type: 'json_object' }</code>（除非啟用 <b>使用 JSON 架構</b>，此時會發送 JSON 架構）。<b>JSONCloaking</b> 非常準確，但並非所有模型都支援，可嘗試 <b>gpt-3.5-turbo-1106</b>。"],["Number of retry","重試次數"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","當翻譯輸出驗證失敗時，引擎應重試多少次。如果為空值（空），則不重試。"],["Retry when the number of translated rows doesn't match original","當翻譯行數與原始不符時重試"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","如果啟用，當模型返回的翻譯行數與原始負載不同時，引擎將重試。"],["Retry when the number of lines for each translated row doesn't match original","當每個翻譯行的行數與原始不符時重試"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","如果啟用，當任何翻譯行的行數與其原始行不同時，引擎將重試。"],["Prompt: Row count mismatch","提示：行數不匹配"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","因行數/元素數不匹配而重試時使用的提示。可用模板變數包括：${MESSAGE_COUNT}、${RETURNED_MESSAGE_COUNT}、${LANG_TO}、${SOURCE_TEXT}。"],["Prompt: Line count mismatch","提示：行數不匹配"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","因每行行數不匹配而重試時使用的提示。可用模板變數包括：${LINE_ERRORS}、${LANG_TO}、${SOURCE_TEXT}。"],["Prompt: Error / Retry instruction","提示：錯誤 / 重試指令"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","在不匹配提示後附加的提示，用於指示模型重試。可用模板變數包括：${ERROR_MESSAGE}、${LANG_TO}、${SOURCE_TEXT}。"],["Custom Parameter","自定義參數"],["Key","鍵"],["Value","值"],["Type","類型"],["Type of the value.","值的類型。"],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","對於 <b>javascript</b> 類型，值將被評估為 JavaScript 代碼。"],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","JavaScript 代碼的作用域是 <code>window</code>。因此，您幾乎可以獲取任何值。"],["<br />Example: <code>trans.project.title</code>","<br />示例：<code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","丟棄不會發送到 API 的參數。<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","OpenAI API 不斷變化，一些新模型可能不支持舊參數，並會為無法識別的請求參數返回 HTTP 錯誤。"],["You can drop the parameters that are not supported by the model here.","您可以在此處丟棄模型不支援的參數。"],["Manage configuration","管理配置"],["RPG Maker","RPG Maker"],["HTML Cloaking Wrapped","HTML 偽裝包裝"],["JSONObject Cloaking","JSONObject 偽裝"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","此附加元件支援透過任何支援 OpenAI Chat API 的服務進行翻譯，例如 Deepseek、LlamaCPP、Google Gemini 等，當然也包括 OpenAI ChatGPT。"],["OpenAI API settings","OpenAI API 設定"],["General","一般"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>不要在推理模型上浪費金錢</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>多項研究已證明，推理模型在執行創意寫作和翻譯任務方面遠不如普通模型。</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>使用推理模型只會帶來更高的成本和更慢的回應時間，別無所獲。</p>"],["Explore more models","探索更多模型"],["Templates","模板"],["Enable context","啟用上下文"],["<h2>Sample dialogue</h2>","<h2>範例對話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>現有對話範例。您可以撰寫良好或不良回應的範例，以幫助翻譯器理解您的目標和對話上下文。</p>"],["Add Example: Translate Japanese to English","新增範例：翻譯日文到英文"],["Retry prompts","重試提示"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>這些提示在重試時作為額外的<b>使用者</b>訊息附加，緊接在先前模型輸出之後。</p>"],["<p>Available variables:</p>","<p>可用變數：</p>"],["Enable Jailbreak","啟用越獄"],["Advanced","進階"],["Custom Parameters","自訂參數"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","您可以向OpenAI Chat API請求主體添加自訂參數。這在您想添加表單中未提供的額外參數時非常有用。"],["<h2>Warning</h2>","<h2>警告</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>錯誤設置自訂參數可能導致API請求失敗。在添加自訂參數前，請確保您知道自己在做什麼。某些服務如OpenAI對您發送的參數要求嚴格，對於無法識別的請求參數會返回HTTP錯誤。</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>如果同一鍵被多次使用，僅最後一個值會被採用。</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>如果使用了現有配置中的相同鍵，則現有配置參數將被自訂參數覆蓋。</li>"],["Drop Parameters","刪除參數"],["Open chatGPT tester","開啟chatGPT測試器"],["Batch Translation Setting","批次翻譯設定"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","抱歉，此附加元件僅供活躍贊助者使用。\n您可以通過成為$1贊助者來解鎖此功能。"],["Preserve invalid returned rows","保留無效返回行"],["Retries and Refinement","重試與精煉"],["<h2>Retries and Refinement</h2>","<h2>重試與精煉</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>當翻譯輸出驗證失敗時，Translator++可以要求模型重試翻譯。您可以設定模型應重試的次數以及重試的條件。</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>設定合理的重試次數和適當的重試條件，可以在控制成本與時間的同時，顯著提升翻譯品質。</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>每次重試都會增加額外的時間和金錢成本</b>。如果您的批次翻譯頻繁重試，您可能需要調整提示，使指令對模型更清晰。</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>使用開發者工具或批次管理器來除錯您的批次翻譯。</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>代碼轉義算法</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>代碼轉義是一種技術，用於防止MTL（機器翻譯）更改對話中的代碼片段。當您的對話包含HTML標籤、XML標籤、JSON對象或JavaScript模板等代碼片段時，這非常有用。</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>選擇與您對話中代碼片段匹配的轉義算法。您可能需要相應地調整<b>系統消息</b>、<b>示例提示</b>和<b>正文消息</b>模板。</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>點擊<a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>此處</a>閱讀更多關於代碼轉義算法及其有效使用方法。</p>"],["Default","預設"],["JavaScript template cloaking","JavaScript模板偽裝"],["None (no escaping)","無（不轉義）"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","您是否要載入所選轉義算法的示例對話預設？這將覆蓋您現有的示例對話。"],["Always separate file","總是分離檔案"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","總是為每個批次分離檔案。這可以保持每個檔案的上下文不被其他檔案污染。"],["Add actor name","添加角色名稱"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","將行信息中的角色名稱附加到可翻譯文本中。這有助於翻譯者追蹤對話和代詞。Translator++隨後會從翻譯結果中移除角色名稱。這顯然會增加翻譯成本。"],["Load Actor Reference as Glossary","載入角色參考作為詞彙表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾選，Translator++將載入角色參考作為詞彙表。這有助於翻譯者理解對話的上下文。角色參考是對話中角色的名稱。這將作為詞彙表載入給翻譯者。這會增加翻譯成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","僅存在於對話中的角色將作為每個批次項目的詞彙表載入。使用模板命令在提示消息中載入角色參考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您啟用此選項，還需要在提示模板中包含<code>ACTOR_INFO</code>變量以放置角色信息數據。"],["Actor Reference Translation Column","角色參考翻譯列"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名稱翻譯的列。此列將用作角色參考的翻譯。這將提高對話中角色名稱翻譯的一致性。"],["Actor's Information Column","角色信息列"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含角色額外信息的列。您可以放置更多信息，如性別、年齡等。這將改善對話中代詞的翻譯。"],["Extra Prompt","額外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","將添加到提示訊息的額外提示。這將在系統訊息之後、實際提示訊息之前添加。"],["<br />","<br />"],["General Settings","一般設定"],["Always separate file for each batch","始終為每個批次使用單獨的檔案"],["Append actor name to the translatable text","將角色名稱附加到可翻譯文本"],["Glossary","詞彙表"],["<h2>Glossary</h2>","<h2>詞彙表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能將幫助您自動將詞彙表添加到提示中。詞彙表將為每個批次項目加載，以提高翻譯質量。該功能將嘗試僅加載相關術語，以避免提示過於臃腫。</p>"],["The Column of Actor's Additional Information","角色附加資訊的欄位"],["Prompt","提示"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":false,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"relPath":"/addons/transChatGPT/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":160,"length":160,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>發</u>送"],["Toggle word wrap","切換自動換行"],["Open debugger (F12)","開啟偵錯工具 (F12)"],["Help","說明"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能僅在您使用 Translator++ 開發者版本時可用。您可以透過基本工具 -> 變更核心 NWJS 來切換至開發者版本。"]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : 遊戲標題</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : 遊戲引擎</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : 角色資訊詞彙表。（僅在批次模式中啟用角色資訊選項時）</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[物件名稱] : 從 Translator++ 物件生成參考。<br />範例：<code>REFERENCE[通用參考]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : 先前翻譯的上下文（如果啟用上下文）</li>"],["Sample conversation","範例對話"],["<h2>Sample dialogue</h2>","<h2>範例對話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>現有對話的範例。您可以編寫良好或不良回應的範例，以幫助翻譯者理解您的目標和對話的上下文。</p>"],["Always separate file","始終分開檔案"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","始終為每個批次分開檔案。這可以保持每個檔案的上下文不受其他檔案污染。"],["Add actor name","添加角色名稱"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","將角色名稱從行資訊附加到可翻譯文本中。這將幫助譯者追蹤對話和代名詞。Translator++ 隨後會從翻譯結果中移除角色名稱。這顯然會增加翻譯成本。"],["Load Actor Reference as Glossary","載入角色參考作為詞彙表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","如果勾選，Translator++ 將載入角色參考作為詞彙表。這將幫助譯者理解對話的上下文。角色參考是對話中角色的名稱。這將作為詞彙表載入給譯者。這會增加翻譯成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","只有對話中存在的角色才會為每個批次項目載入為詞彙表。使用模板命令在提示訊息中載入角色參考。"],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️如果您啟用此選項，還需要在提示模板中包含 <code>ACTOR_INFO</code> 變數來放置角色資訊數據。"],["Actor Reference Translation Column","角色參考翻譯欄位"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名稱翻譯的欄位。此欄位將用作角色參考的翻譯。這將提高對話中角色名稱翻譯的一致性。"],["Actor's Information Column","角色資訊欄位"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含角色額外資訊的欄位。您可以放入更多資訊，如性別、年齡等。這將改善對話中代名詞的翻譯。"],["Extra Prompt","額外提示"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","將添加到提示訊息中的額外提示。這將在系統訊息之後、實際提示訊息之前添加。"],["General Settings","一般設定"],["Always separate file for each batch","始終為每個批次分開檔案"],["Append actor name to the translatable text","將角色名稱附加到可翻譯文本"],["Glossary","詞彙表"],["<h2>Glossary</h2>","<h2>詞彙表</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>此功能將幫助您自動將詞彙表添加到提示中。詞彙表將為每個批次項目載入，以提高翻譯質量。該功能會嘗試僅載入相關術語，以避免提示過於臃腫。</p>"],["The Column of Actor's Additional Information","角色額外資訊的欄位"],["Prompt","提示"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transChatGPT/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","與ChatGPT API聊天"],["Batch Manager","批次管理器"],["This feature is only available if you have a project open.","此功能僅在您有開啟專案時可用。"]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transChatGPT/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","您要安裝 DazedMTLTool 嗎？"],["Ignore if already translated","若已翻譯則忽略"],["OpenAI Translation with DazedMTL","使用 DazedMTL 的 OpenAI 翻譯"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":false,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"relPath":"/addons/transDazedMTL/transdazedmtl.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","DeepL 伺服器未安裝。您要現在安裝嗎？"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":false,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/transDeepl/DeepLUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","字元使用量：\n"],["Failed to fetch quota: ","獲取配額失敗："]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":false,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"relPath":"/addons/transDeeplPro/deepl-pro.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>發</u>送"],["Toggle word wrap","切換自動換行"],["Open debugger (F12)","開啟除錯器（F12）"],["Help","說明"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能僅在您使用 Translator++ 的開發者版本時可用。您可以透過基本工具 -> 變更核心 NWJS 切換至開發者版本。"]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>標題：遊戲的標題</li>"],["<li>ENGINE : Engine of the game</li>","<li>引擎：遊戲的引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>參考[物件名稱]：從 Translator++ 物件生成參考。<br />範例：<code>參考[通用參考]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>原生 Gemini API</h2><p>此引擎使用 Google Gemini 原生 API 進行翻譯。<br />您也可以使用適用於 Google Gemini 的 OpenAI 附加元件。OpenAI 附加元件提供更多功能，這就是為什麼<b style='color:green;'>我建議使用 OpenAI 附加元件代替</b>。</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","Gemini AI 需要 OpenAI 函式庫中的某些模組。請確保已安裝<b>transChatGPT（Translator++ 的 ChatGPT）</b>附加元件。"],["Explore more models","探索更多模型"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"relPath":"/addons/transGemini/gemini.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","自訂模型.自訂標籤"],["model","模型"],["|","|"],["promptLibrary","提示庫"],["search","搜尋"],["downloadChat","下載聊天"],["newChat","新聊天"],["api","API"],["customEndpoint","自定義端點"],["apiEndpoint.inputLabel","API端點輸入標籤"],["apiKey.inputLabel","API金鑰輸入標籤"],["apiVersion.inputLabel","API版本輸入標籤"],["apiVersion.description","API版本描述"],["securityMessage","安全訊息"],["apiEndpoint.description","API端點描述"],["apiEndpoint.warn","API端點警告"],["partialImportMessages","部分導入訊息"],["import","導入"],["name","名稱"],["prompt","提示"],["clearPrompts","清除提示"],["morePrompts","更多提示"],["toast.sync","通知.同步"],["toast.stop","通知.停止"],["button.sync","按鈕.同步"],["button.stop","按鈕.停止"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringL