enter to add a new line.","原始文字中要尋找的一行。按alt+enter新增一行。"],["Translation","翻譯"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/24/innerText"],["idx/11/innerText","idx/17/innerText"],["idx/12/innerText","idx/18/innerText"],["idx/13/innerText","idx/19/innerText"],["idx/14/innerText","idx/20/innerText"],["idx/15/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/25/innerText"],["idx/0/attr/placeholder"],["idx/1/attr/title","idx/3/attr/title","idx/7/attr/title"],["idx/2/attr/title","idx/4/attr/title"],["idx/5/attr/placeholder"],["idx/6/attr/placeholder"]],"basename":"find.html","dirname":"/","extension":".html","filename":"find.html","path":"/find.html","indexIsBuilt":false,"indexIds":{"Find":0,"Replace":1,"Put":2,"Target":3,"Grid":4,"Context":5,"Tag":6,"Comment":7,"Untranslated rows":8,"Refine":9,"Case sensitive":10,"Transpile \\r\\n\\t":11,"RegExp":12,"All files":13,"Select All Columns":14,"Find all string above and replace with :":15,"Original text:":16,"Text to put :":17,"into: ":18,"Search all files":19,"Type the keyword then hit enter. You can use glob pattern (e.g.: *.png)":20,"Drag to select, Shift+Drag to unselect":21,"Select target column":22,"A line in the original text to find. Press alt+enter to add a new line.":23,"Translation":24},"tags":[],"relPath":"/find.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":25,"length":25,"percent":100},"parameters":[]},"/js/RawViewer.js":{"data":[["Unable to find the file related to the data","無法找到與資料相關的檔案"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","要修正此問題，請在<a href=\"#\" class=\"openProjectProperties\">專案屬性</a>中更正<b>原始材料位置</b>欄位"],["Copy path to clipboard","複製路徑到剪貼簿"],["Path has been copied to clipboard.","路徑已複製到剪貼簿"],["Open folder","開啟資料夾"],["Open with external application","以外部應用程式開啟"],["VS Code","VS Code"],["Notepad++","Notepad++"],["Open with...","以...開啟"],[null,null,null,null,null]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":true,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"relPath":"/js/RawViewer.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~使用預設翻譯~"],["Column","欄位"],["Do you want to delete all context translation on the currently selected row?","您要刪除目前選取列的所有上下文翻譯嗎？"],["Do you want to delete all translation on the currently active row?","您要刪除目前活動列的所有翻譯嗎？"],[null,null,null,null,null]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":true,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"relPath":"/js/TranslationByContext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/addon.js":{"data":[["invalid type addonObj","無效的類型 addonObj"],["invalid type addonObj.addons","無效的類型 addonObj.addons"],["You are not eligible to get this addon","您不符合獲取此附加元件的資格"]],"context":[["tid/8980/type/StringLiteral"],["tid/9036/type/StringLiteral"],["tid/9089/type/StringLiteral"]],"basename":"addon.js","dirname":"/js","extension":".js","filename":"addon.js","path":"/js/addon.js","indexIsBuilt":false,"indexIds":{"invalid type addonObj":0,"invalid type addonObj.addons":1,"You are not eligible to get this addon":2},"tags":[],"relPath":"/js/addon.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/automationEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","在為 Translator++ 建立捷徑前，您應先儲存當前專案"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能僅在您使用 Translator++ 開發者版本時可用。您可透過基本工具 -> 變更核心 NWJS 切換至開發者版本。"]],"context":[["tid/4238/type/StringLiteral"],["tid/7854/type/StringLiteral"]],"basename":"automationEditor.js","dirname":"/js","extension":".js","filename":"automationEditor.js","path":"/js/automationEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/automationEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/find.js":{"data":[["Action","操作"],["Append tags","附加標籤"],["Remove tags","移除標籤"],["Set tags","設定標籤"],["Do nothing","不執行任何操作"],["Close","關閉"],["Proceed","繼續"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","關鍵字太短！\n您是否想搜尋所有列？請嘗試使用星號 '*' 作為關鍵字。"],["Found nothing!<br />Don't forget to set the Target search field.","未找到任何內容！<br />別忘了設定目標搜尋欄位。"],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","沒有可替換的內容！<br />替換功能不會替換鍵列上的任何內容。"],["Replace '","將「"],["' with '","」替換為「"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","？\r\n我們尚未為此功能建立復原功能！\n您確定要繼續嗎？"],["click to go","點擊前往"],["This will replace any translation found in target colum,\nAre you sure?","這將取代目標欄中找到的任何翻譯，\n您確定嗎？"],["Keyword too short!","關鍵字太短！"],["Not found!","未找到！"],["Are you sure want to execute the following script?","您確定要執行以下腳本嗎？"],["For ","對於 "],[" selected item(s)?"," 個選定項目？"],[" Select all"," 全選"],[" Invert selection"," 反轉選擇"],[" Clear selection"," 清除選擇"],[" Set Red tag"," 設定紅色標籤"],[" Set Yellow tag"," 設定黃色標籤"],[" Set Green tag"," 設定綠色標籤"],[" Set Blue tag"," 設定藍色標籤"],[" Set Gold tag"," 設定金色標籤"],[" More tags..."," 更多標籤..."],[" Clear tags"," 清除標籤"],[" Create Automation"," 建立自動化"],[" Run Automation"," 執行自動化"],[" Clear Automation","清除自動化"],["Are you sure want to clear all quick launch scripts?","您確定要清除所有快速啟動腳本嗎？"],[" Clear translation","清除翻譯"],["Do you want to clear translations of the selected items?","您要清除所選項目的翻譯嗎？"],[" Delete rows","刪除行"],["Do you want to remove selected rows?\nYou can not undo this action!","您要移除選取的行嗎？\n此操作無法撤銷！"],[" With selection ...","選取項目..."],["Always on top","總在最上層"],["Default","預設"],["Blur opacity","模糊不透明度"],["Type regex with the modifier","輸入帶有修飾符的正則表達式"],["Use $n to replace a group. e.g. $1","使用 $n 替換群組。例如：$1"],["Find","尋找"],["Replace","替換"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":false,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"relPath":"/js/find.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":46,"percent":100},"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","隱藏密碼"],["Show password","顯示密碼"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":false,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"relPath":"/js/jsonform.ext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","某些配置需要重新啟動應用程式才能生效。\n請保存您的工作，並重新啟動 Translator++。"],["Pleae select the name for your configuration.","請為您的配置選擇名稱。"],["Translator Engine configuration","翻譯引擎配置"],["Translator engine version.","翻譯引擎版本"],["By.","作者"],["No option for this engine","此引擎無選項"],["License","授權"],["Can not disable this addon","無法停用此附加元件"],["Requirements","需求"],["What is this?","這是什麼？"],["Uninstall","解除安裝"],["Update","更新"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","附加元件已成功安裝。\r\n某些附加元件可能需要重新啟動 Translator++ 才能生效。"],["WARNING!\n","警告！\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","此附加元件標記為「解析器變更」。您與此附加元件相關的舊專案可能無法如預期運作。建議在安裝此附加元件前備份您的專案。\n您可以將現有翻譯匯入新建立的專案中。\n\n是否要安裝 "],["Do you want to install ","您要安裝 "],["Add-on","附加元件"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","已成功安裝。\r\n某些附加元件可能需要重新啟動 Translator++ 才能生效。"],["Add-on version.","附加元件版本。"],["No option for this add-on","此附加元件無選項"],["Translator++ will write Window's registry.\r\nAre you sure?","Translator++ 將寫入 Windows 登錄檔。\r\n您確定嗎？"],["Error parsing patterns:","解析模式時發生錯誤："],["Do you really want to clear the custom escaper?","您真的想清除自訂跳脫器嗎？"],["Do you really want to reset the custom escaper?","您真的想重設自訂跳脫器嗎？"],["You are currently on the latest version.\nDo you still want to update?","您目前使用的是最新版本。\n是否仍要更新？"],["This option will open your default browser to login.\nDo you want to continue?","此選項將開啟您的預設瀏覽器以登入。\n是否要繼續？"],["Login with Browser","使用瀏覽器登入"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","您的瀏覽器已開啟至 <b>dreamsavior.net/gettoken/</b>。<br>登入後，登入將自動完成。<br><br>如果自動登入無效，請從該頁面複製您的令牌並貼上於下方："],["There is no default translator selected.\nChange the default translator to Google!","未選取預設翻譯器。\n將預設翻譯器更改為 Google！"],["Change Stagging Path to :","將暫存路徑更改為："],["Move the content of current Stagging Path into the new one?","將當前暫存路徑的內容移至新路徑嗎？"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","附加元件已安裝。\n需要重新啟動 Translator++ 以生效。"],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","您確定要清除所有設定並將 Translator++ 重置為預設值嗎？\n請注意，此操作不可逆轉。\n請在繼續前備份您的專案。"],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","如果不修復錯誤，Translator++ 可能無法正常運作。\n是否要關閉選項視窗？"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":false,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"relPath":"/js/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","在建立 Translator++ 捷徑前，您應先儲存當前專案。"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能僅在您使用 Translator++ 開發者版本時可用。您可以透過基本工具 -> 更改核心 NWJS 切換至開發者版本。"]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/scriptEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>無法執行 PHP 直譯器！</b><br />\n\t\t\t\tTranslator++ 需要 PHP CLI 來執行一些必要程序。<br />\n\t\t\t\t此錯誤通常發生在您的電腦<b>未安裝<a href=\"http://dreamsavior.net/download/#TPPSysreq\">正確版本的 Microsoft Visual C++ 可轉散發套件</a></b>時。\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>請安裝<a href=\"http://dreamsavior.net/download/#TPPSysreq\">所需的執行階段</a>。</li>\n\t\t\t\t\t\t<li>如果已安裝所有執行階段但仍出現此錯誤，請將 Translator++ 安裝目錄移至其他資料夾。</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\t請查看<a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>文件</a>以獲取有關此症狀的更多資訊。"],["Initialization Error!","初始化錯誤！"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":false,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"relPath":"/js/sys.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/js/trans.js":{"data":[["Original Text","原始文字"],["Initial","初始"],["Machine translation","機器翻譯"],["Better translation","更好的翻譯"],["Best translation","最佳翻譯"],["Loading","載入中"],["Error!","錯誤！"],["Error processing init file : ","處理初始化檔案時發生錯誤："],["Error! File list not found in init file at : ","錯誤！在初始化檔案中未找到檔案清單："],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","這表示您的遊戲未成功解析。請訪問 https://dreamsavior.net/?p=1311 以獲取此問題的可能解決方案。"],["Done!","完成！"],["All done!","全部完成！"],["Error opening file : ","開啟檔案時發生錯誤："],["error opening file (open): ","開啟檔案時發生錯誤（開啟）："],["Project properties - Staging path error!","專案屬性 - 暫存路徑錯誤！"],["Project properties","專案屬性"],["untitled project","未命名專案"],["create file list","建立檔案清單"],["Finished","完成"],["All process finished!","所有處理完成！"],["Open Explorer","開啟檔案總管"],["Opening file!","正在開啟檔案！"],["Assigning new staging path : ","指派新的暫存路徑："],["Success!","成功！"],["Failed!","失敗！"],["Collecting paths","正在收集路徑"],["Path : '","路徑：'"],["' doesn't exist","'不存在"],[" file(s) collected!","個檔案已收集！"],["Start importing data!","開始導入數據！"],["Importing : ","導入中："],["All Done!","全部完成！"],[" is not a valid object name","不是有效的物件名稱"],[" is not a valid directory name","不是有效的目錄名稱"],[" is already exist","已經存在"],["Error opening file :","打開檔案時出錯："],["Error executing :","執行時出錯："],["Are you sure want to execute the following script?","您確定要執行以下腳本嗎？"],["Clear quick launch","清除快速啟動"],["Are you sure want to clear quick launch?","您確定要清除快速啟動嗎？"],["How to add Automation here","如何在此處添加自動化"],["Select all","全選"],["Clear selection","清除選擇"],["Select 100%","選擇100%"],["Select <100%","選擇<100%"],["Select progress ≥ ...","選擇進度≥..."],["Select completed","選擇完成"],["Invert selection","反轉選擇"],["Toggle mark as complete","切換標記為完成"],["With all","與全部"],["With ","與 "],[" selected"," 已選"],["Mark as complete","標記為完成"],["Un-mark as complete","取消標記為完成"],["Batch translation","批次翻譯"],["Send to...","發送至..."],["Wrap texts","換行文字"],["Trim","修剪"],["Auto padding","自動填充"],["Context Tool","上下文工具"],["Create Automation","創建自動化"],["For each object","對每個物件"],["For each row","對每行"],["Run Automation","執行自動化"],["Import from...","從...導入"],["Trans File","翻譯檔案"],["Spreadsheets","試算表"],["RPGMTransPatch Files","RPGMTrans修補檔案"],["Export into...","匯出至..."],["A folder","一個資料夾"],["Zipped Game Patch","壓縮遊戲修補"],["Comma Separated Value (csv)","逗號分隔值 (csv)"],["Excel 2007 Spreadsheets (xlsx)","Excel 2007 試算表 (xlsx)"],["Excel Spreadsheets (xls)","Excel 試算表 (xls)"],["ODS Spreadsheets","ODS 試算表"],["Html Spreadsheets","Html 試算表"],["RMTrans Patch","RMTrans 修補"],["Inject Translation","注入翻譯"],["Revert to original","還原為原始"],["Clear translation","清除翻譯"],["Delete files","刪除檔案"],["Properties","屬性"],["Select progress greater than","選擇進度大於"],["Please input a number","請輸入數字"],["Do you want to clear translation?","您要清除翻譯嗎？"],["Add comment","新增註解"],["Remove comment","移除註解"],["added to reference table!","已新增至參考表！"],["Can not modify Column 0","無法修改第 0 欄"],["Unable to delete table : ","無法刪除表格："],["Can not remove key column!","無法移除關鍵欄！"],["Please open or create a project first","請先開啟或建立專案"],["Column name can not be empty!","欄位名稱不能為空！"],["Invalid column index!","無效的欄位索引！"],["Please open or create a new project first!","請先開啟或建立新專案！"],["You should not edit key value","您不應編輯關鍵值"],["Ilegal value","非法值"],["That value already exist!","該值已存在！"],["The maximum number of columns for this project has been reached, so you cannot add any more.","此專案已達最大欄位數，無法再新增。"],["Are you sure want to abort this process?","您確定要中止此程序嗎？"],["Process paused!\nPress OK to continue!","程序已暫停！\n按確定以繼續！"],["Unable to process, project not found","無法處理，找不到專案"],["Unable to process, data not found","無法處理，找不到資料"],["Translation engine not found","找不到翻譯引擎"],["Translation engine ","翻譯引擎"],[" is disabled!","已停用！"],["Selected files :","已選檔案："],["Collecting data from :","正在從以下來源收集數據："],["Translation finished","翻譯完成"],["applying translation to table!","正在將翻譯應用到表格！"],["Error when translating data!","翻譯數據時出錯！"],["\tHTTP Status : ","\tHTTP 狀態："],["\tError Type : ","\t錯誤類型："],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","您可能已被翻譯服務暫時封鎖！\r\n請適度使用線上翻譯服務\r\n這通常會在一兩天內自行解決。\r\n"],["Running trans.translateAll","正在執行 trans.translateAll"],["Start collecting data!","開始收集數據！"],["Data collection is done!","數據收集完成！"],["nothing is selected","未選取任何項目"],["no translator loaded","未載入翻譯器"],["unable to load translator window","無法載入翻譯器視窗"],["Reference path cannot empty!","參考路徑不能為空！"],["Collecting translation refference","正在收集翻譯參考"],["Applying translation!","正在應用翻譯！"],["Importing translation","正在匯入翻譯"],["Parsing data","正在解析數據"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions","不是有效的 JavaScript 正則表達式！\r\n了解更多關於 JavaScript 正則表達式的資訊：\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"],["Keyword too short!","關鍵字太短！"],["Delete comment","刪除評論"],["Translate here","在此翻譯"],["Translate here using ","使用 "],["Translate using...","使用...翻譯"],["Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?","您是否想要使用所選儲存格中的翻譯來翻譯此專案中所有相同的文字？"],[" cell(s) has been written!"," 個儲存格已寫入！"],["Column width","欄寬"],["Width must greater than 0","寬度必須大於0"],["Insert column right","在右側插入欄"],["Duplicate column","複製欄"],["Remove this column","移除此欄"],["Remove selected column?\nThis can not be undone!","移除選定的欄？\n此操作無法復原！"],["Rename this column","重新命名此欄"],["Please enter new name","請輸入新名稱"],["Tags","標籤"],["Red","紅色"],["Yellow","黃色"],["Green","綠色"],["Blue","藍色"],["Gold","黃金"],["More tags...","更多標籤..."],["Clear tags","清除標籤"],["Delete Row","刪除行"],["Do you want to remove the currently selected row(s)?","您要移除目前選取的行嗎？"],["Clear Context Translation","清除上下文翻譯"],["Clear Automation","清除自動化"],["Are you sure want to clear all quick launch scripts?","您確定要清除所有快速啟動腳本嗎？"],["Append rows to reference","將行附加到參考"],["Row properties","行屬性"]],"context":[["tid/2227/type/StringLiteral","tid/2619/type/StringLiteral"],["tid/2233/type/StringLiteral","tid/2625/type/StringLiteral"],["tid/2239/type/StringLiteral","tid/2631/type/StringLiteral"],["tid/2245/type/StringLiteral","tid/2637/type/StringLiteral"],["tid/2251/type/StringLiteral","tid/2643/type/StringLiteral"],["tid/4770/type/StringLiteral","tid/4811/type/StringLiteral","tid/18019/type/StringLiteral","tid/18070/type/StringLiteral","tid/18441/type/StringLiteral","tid/18484/type/StringLiteral","tid/18596/type/StringLiteral","tid/18692/type/StringLiteral","tid/18732/type/StringLiteral","tid/18832/type/StringLiteral","tid/20321/type/StringLiteral","tid/20364/type/StringLiteral"],["tid/5451/type/StringLiteral","tid/5538/type/StringLiteral","tid/5572/type/StringLiteral","tid/5947/type/StringLiteral","tid/5979/type/StringLiteral"],["tid/5457/type/StringLiteral"],["tid/5544/type/StringLiteral"],["tid/5578/type/StringLiteral"],["tid/5878/type/StringLiteral","tid/22004/type/StringLiteral","tid/22050/type/StringLiteral","tid/22829/type/StringLiteral","tid/22875/type/StringLiteral"],["tid/5884/type/StringLiteral"],["tid/5953/type/StringLiteral"],["tid/8844/type/StringLiteral"],["tid/9577/type/StringLiteral"],["tid/9623/type/StringLiteral"],["tid/11086/type/StringLiteral"],["tid/17099/type/StringLiteral"],["tid/