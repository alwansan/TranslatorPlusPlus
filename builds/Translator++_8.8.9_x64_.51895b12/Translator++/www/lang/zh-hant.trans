{"data":[[null]],"columns":[{"readOnly":false,"wordWrap":true,"width":200},{"readOnly":false,"wordWrap":true,"width":339},{"readOnly":false,"wordWrap":true,"width":134},{"readOnly":false,"wordWrap":true,"width":120},{"readOnly":false,"wordWrap":true,"width":109}],"colHeaders":["Original Text","Initial","Machine translation","Better translation","Best translation"],"project":{"indexOriginal":0,"gameEngine":"APPUI","files":{"/addons/VNTextPatch/vntextpatch.js":{"data":[["I have extracted the game data","我已提取遊戲數據"],["Load game's data folder","載入遊戲的數據文件夾"],["Select the game's data folder","選擇遊戲的數據文件夾"],["Engine Info","引擎資訊"],["Currently detected engine","目前檢測到的引擎"],["Manually Specify Format","手動指定格式"],["Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.","手動指定遊戲格式。<br />VNTranslationTools 會根據文件擴展名自動檢測格式。然而，如果您遇到模糊的文件擴展名，請明確提供格式。"],["Interface","介面"],["VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.","VNTextPatch 可以將遊戲解析為兩種格式：JSON 或 XLSX 電子表格。請選擇您要使用的介面。"],["Warning: There is a row limit if you're choosing XLSX spreadsheet.","警告：如果選擇 XLSX 電子表格，有行數限制。"],["Create a new project","創建新專案"],["Invalid destination directory:","無效的目的地目錄："],["Close","關閉"],[null,null,null,null,null]],"context":[["tid/8164/type/StringLiteral"],["tid/8228/type/StringLiteral"],["tid/8233/type/StringLiteral"],["tid/8246/type/StringLiteral"],["tid/8251/type/StringLiteral"],["tid/8256/type/StringLiteral"],["tid/8261/type/StringLiteral"],["tid/8266/type/StringLiteral"],["tid/8271/type/StringLiteral"],["tid/8276/type/StringLiteral"],["tid/8455/type/StringLiteral"],["tid/8516/type/NoSubstitutionTemplate"],["tid/11110/type/StringLiteral"]],"basename":"vntextpatch.js","dirname":"/addons/VNTextPatch","extension":".js","filename":"vntextpatch.js","path":"/addons/VNTextPatch/vntextpatch.js","indexIsBuilt":true,"indexIds":{"I have extracted the game data":0,"Load game's data folder":1,"Select the game's data folder":2,"Engine Info":3,"Currently detected engine":4,"Manually Specify Format":5,"Manually specify the game format.<br />VNTranslationTools will automatically detect the format based on the file extension. However, if you encounter ambiguous file extensions, please provide the format explicitly.":6,"Interface":7,"VNTextPatch can parse the game into two formats: JSON or an XLSX spreadsheet. Please select the interface you want to use.":8,"Warning: There is a row limit if you're choosing XLSX spreadsheet.":9,"Create a new project":10,"Invalid destination directory:":11,"Close":12},"tags":[],"relPath":"/addons/VNTextPatch/vntextpatch.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}],[null,{}]],"lastSelectedCell":[6,1]},"/addons/actionEditorParser/ae4parser.js":{"data":[["Start translation from Action Editor 4 Game","從 Action Editor 4 Game 開始翻譯"],["Create Project","創建專案"]],"context":[["tid/920/type/StringLiteral"],["tid/997/type/StringLiteral"]],"basename":"ae4parser.js","dirname":"/addons/actionEditorParser","extension":".js","filename":"ae4parser.js","path":"/addons/actionEditorParser/ae4parser.js","indexIsBuilt":false,"indexIds":{"Start translation from Action Editor 4 Game":0,"Create Project":1},"tags":[],"relPath":"/addons/actionEditorParser/ae4parser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/!post.html":{"data":[["Actions","操作"],["Build for 32bit system","為 32 位系統建構"],["Build for non developer build too","也為非開發者建構建構"],["Custom Version","自訂版本"],["Custom version (leave blank to autogenerate version)","自訂版本（留空以自動生成版本）"],["Generate minor versioning?","生成次要版本？"],["Save patch to","保存修補程式至"],["Destination folder of generated patch","生成修補程式的目標資料夾"],["Overider template","覆寫模板"],["Release template","發布模板"],["Select file to be available live and excluded from the package","選擇可線上使用並從套件中排除的檔案"],["The file will be excluded from package, but available online","該檔案將從套件中排除，但可在線上使用"],["Make the process does not require user input","使流程無需使用者輸入"],["Patch Type","修補程式類型"],["The file will be excluded from package, but available online. Select the file you want to substitute.","該檔案將從套件中排除，但可在線上使用。選擇您想替換的檔案。"],["Substitute trans.js with a fake one.","用偽造的 trans.js 替換。"],["Select Patch File","選擇修補程式檔案"],["Select the generated patch file (*.tpch).","選擇生成的修補程式檔案 (*.tpch)。"],["Patches Links","修補程式連結"],["Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.","自動更新將從這些連結下載。<b>必須是直接下載連結！</b> 每個下載連結請用換行分隔。"],["Download Links","下載連結"],["Downloadable package for manual download. Separate each download link with newline.","可供手動下載的套件。每個下載連結請用換行分隔。"],["Release Category","發布類別"],["Category of the release.","發布的類別。"],["Upload log along with this submission.","連同此提交上傳日誌。"],["Remove the same version found on database.","移除資料庫中找到的相同版本。"],["Whether this release is enabled or not.","此版本是否啟用。"],["Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.","此版本是否隱藏。如果版本被隱藏，只有管理員和具有<code>view_hidden_releases</code>（開發者）權限的成員可以透過套件安裝器安裝此版本。"],["Release Name","版本名稱"],["Release Number","版本號碼"],["Release Date","發佈日期"],["Release Key","版本金鑰"],["Release Type","版本類型"],["CRC","CRC"],["Required Version","必要版本"],["Minimum Version","最低版本"],["Release Note","版本說明"],["Release Info","版本資訊"],["On Before Install","安裝前"],["On After Install","安裝後"],["Extra parameters","額外參數"],["Remote file","遠端檔案"],["List of remote file, separate by new line","遠端檔案列表，以換行分隔"],["Patron Level","贊助等級"],["Post title","文章標題"],["Release post","發布貼文"],["Excerpt of the post","貼文摘要"],[null,null,null,null,null]],"context":[["idx/0/innerText","idx/14/innerText","idx/29/innerText","idx/79/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/16/innerText"],["idx/5/innerText","idx/17/innerText"],["idx/6/innerText","idx/18/innerText"],["idx/7/innerText","idx/19/innerText"],["idx/8/innerText","idx/20/innerText"],["idx/9/innerText","idx/21/innerText"],["idx/10/innerText","idx/22/innerText"],["idx/11/innerText","idx/25/innerText"],["idx/12/innerText"],["idx/13/innerText","idx/28/innerText"],["idx/23/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/45/innerText"],["idx/47/innerText"],["idx/49/innerText"],["idx/51/innerText"],["idx/53/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/59/innerText"],["idx/61/innerText"],["idx/63/innerText"],["idx/65/innerText"],["idx/67/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/73/innerText"],["idx/75/innerText"],["idx/77/innerText"]],"basename":"!post.html","dirname":"/addons/adminTools","extension":".html","filename":"!post.html","path":"/addons/adminTools/!post.html","indexIsBuilt":true,"indexIds":{"Actions":0,"Build for 32bit system":1,"Build for non developer build too":2,"Custom Version":3,"Custom version (leave blank to autogenerate version)":4,"Generate minor versioning?":5,"Save patch to":6,"Destination folder of generated patch":7,"Overider template":8,"Release template":9,"Select file to be available live and excluded from the package":10,"The file will be excluded from package, but available online":11,"Make the process does not require user input":12,"Patch Type":13,"The file will be excluded from package, but available online. Select the file you want to substitute.":14,"Substitute trans.js with a fake one.":15,"Select Patch File":16,"Select the generated patch file (*.tpch).":17,"Patches Links":18,"Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.":19,"Download Links":20,"Downloadable package for manual download. Separate each download link with newline.":21,"Release Category":22,"Category of the release.":23,"Upload log along with this submission.":24,"Remove the same version found on database.":25,"Whether this release is enabled or not.":26,"Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.":27,"Release Name":28,"Release Number":29,"Release Date":30,"Release Key":31,"Release Type":32,"CRC":33,"Required Version":34,"Minimum Version":35,"Release Note":36,"Release Info":37,"On Before Install":38,"On After Install":39,"Extra parameters":40,"Remote file":41,"List of remote file, separate by new line":42,"Patron Level":43,"Post title":44,"Release post":45,"Excerpt of the post":46},"tags":[],"relPath":"/addons/adminTools/!post.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":47,"length":47,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[null,null,null,null,null,null,[null,{"v":1}]]},"/addons/adminTools/!postPackage.html":{"data":[["Select package json file","選擇 package.json 檔案"],["Select the generated patch file","選擇生成的補丁檔案"],["Or Select Destination File","或選擇目標檔案"],["Or Download location","或下載位置"],["Icon","圖示"],["Author","作者"],["Name","名稱"],["name of the package.","套件的名稱。"],["Title","標題"],["Title of the package.","套件的標題。"],["Version","版本"],["Version of the package.","套件的版本。"],["Description","描述"],["Description of the package.","套件的描述。"],["Whether this release is active or not.","此發布是否為活躍狀態。"],["Whether this release is hidden or not.","此發布是否為隱藏狀態。"],["Patron Level","贊助者等級"],["Current month's pledge in $","本月承諾金額（美元）"],["Patron Points","贊助點數"],["100pts = 1$","100點 = 1美元"],["Purchase type","購買類型"],["Type of the purchase.","購買的類型。"],["On Before Install","安裝前"],["Javascript code to be run before install","安裝前要運行的Javascript代碼"],["On After Install","安裝後"],["Javascript code to be run after install","安裝後要運行的Javascript代碼"],["Manifest","清單"],["Manifest data","清單數據"],["Minimum version","最低版本"],["Minimum version of Translator++ to be able to insatall this addon.","能夠安裝此附加元件所需的最低Translator++版本。"],["Release Date","發布日期"],["Is parser changed?","解析器是否已更改？"],["Mark as parser change. Would warn the user to backup their project before updating to this addon.","標記為解析器更改。會警告用戶在更新到此附加元件前備份其專案。"],["Remove the same version found on database.","移除資料庫中找到的相同版本。"],["Excluded files","排除的檔案"],["Files listed here will be excluded from the distribution packages","此處列出的檔案將從分發包中排除"],["Script URL","腳本URL"],["Script of the URL.","URL的腳本。"],["Upload script","上傳腳本"],["This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t","此腳本將上傳至後端，並使用 [php]Scripts 模板腳本進行處理。\n\t\t\t\t\t使用此功能：\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>建立一個 WordPress 頁面，使用 <b>[php]Scripts 模板</b> 模板。<br>您也可以設定 Patreon 要求以查看帖子。</li>\n\t\t\t\t\t\t<li>將頁面 URL 添加到 package.json 文件中，使用 <b>l</b> GET 參數指向本地文件。<br>\n\t\t\t\t\t\t例如：<u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t"],["Actions","操作"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/3/innerText"],["idx/2/innerText"],["idx/4/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/47/innerText"]],"basename":"!postPackage.html","dirname":"/addons/adminTools","extension":".html","filename":"!postPackage.html","path":"/addons/adminTools/!postPackage.html","indexIsBuilt":false,"indexIds":{"Select package json file":0,"Select the generated patch file":1,"Or Select Destination File":2,"Or Download location":3,"Icon":4,"Author":5,"Name":6,"name of the package.":7,"Title":8,"Title of the package.":9,"Version":10,"Version of the package.":11,"Description":12,"Description of the package.":13,"Whether this release is active or not.":14,"Whether this release is hidden or not.":15,"Patron Level":16,"Current month's pledge in $":17,"Patron Points":18,"100pts = 1$":19,"Purchase type":20,"Type of the purchase.":21,"On Before Install":22,"Javascript code to be run before install":23,"On After Install":24,"Javascript code to be run after install":25,"Manifest":26,"Manifest data":27,"Minimum version":28,"Minimum version of Translator++ to be able to insatall this addon.":29,"Release Date":30,"Is parser changed?":31,"Mark as parser change. Would warn the user to backup their project before updating to this addon.":32,"Remove the same version found on database.":33,"Excluded files":34,"Files listed here will be excluded from the distribution packages":35,"Script URL":36,"Script of the URL.":37,"Upload script":38,"This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t":39,"Actions":40},"tags":[],"relPath":"/addons/adminTools/!postPackage.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":41,"length":41,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/adminTools/adminTools.js":{"data":[["Close","關閉"]],"context":[["tid/588/type/StringLiteral"]],"basename":"adminTools.js","dirname":"/addons/adminTools","extension":".js","filename":"adminTools.js","path":"/addons/adminTools/adminTools.js","indexIsBuilt":false,"indexIds":{"Close":0},"tags":[],"relPath":"/addons/adminTools/adminTools.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[[null,{"v":1}]],"lastSelectedCell":[0,1]},"/addons/aec/aec.js":{"data":[["Universal Archive Unpacker","通用檔案解包器"]],"context":[["tid/1001/type/StringLiteral","tid/1239/type/StringLiteral"]],"basename":"aec.js","dirname":"/addons/aec","extension":".js","filename":"aec.js","path":"/addons/aec/aec.js","indexIsBuilt":false,"indexIds":{"Universal Archive Unpacker":0},"tags":[],"relPath":"/addons/aec/aec.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/bakinParser/bakin-proxy.js":{"data":[["Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.","從 data.rbpack 提取 Bakin 遊戲字典，翻譯 dic.txt，並自動修補播放器。"],["Create project","建立專案"],["Error: customField is not defined. This should not happen!","錯誤：customField 未定義。這不應該發生！"],["Please select the Bakin game executable.","請選擇 Bakin 遊戲執行檔。"],["<h2>Proxy workflow</h2>","<h2>代理工作流程</h2>"],["Translator++ unpacks data.rbpack into a temporary folder.","Translator++ 將 data.rbpack 解包到臨時資料夾中。"],["Split Dictionary uses dump-split and creates one .txt file per source area by default.","分割字典預設使用 dump-split，並為每個來源區域建立一個 .txt 檔案。"],["Merge Dictionary uses a single dic.txt.","合併字典使用單個 dic.txt。"],["Injection merges split dictionaries back into data/dic.txt and patches the player executable.","注入將分割的字典合併回 data/dic.txt，並修補播放器執行檔。"],["Split Dictionary (default)","分割字典（預設）"],["Merge Dictionary","合併字典"]],"context":[["tid/2860/type/StringLiteral"],["tid/2929/type/StringLiteral"],["tid/2966/type/StringLiteral"],["tid/3002/type/StringLiteral"],["tid/3253/type/NoSubstitutionTemplate"],["tid/3266/type/StringLiteral"],["tid/3277/type/StringLiteral"],["tid/3288/type/StringLiteral"],["tid/3299/type/StringLiteral"],["tid/3383/type/StringLiteral"],["tid/3393/type/StringLiteral"]],"basename":"bakin-proxy.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-proxy.js","path":"/addons/bakinParser/bakin-proxy.js","indexIsBuilt":false,"indexIds":{"Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the Bakin game executable.":3,"<h2>Proxy workflow</h2>":4,"Translator++ unpacks data.rbpack into a temporary folder.":5,"Split Dictionary uses dump-split and creates one .txt file per source area by default.":6,"Merge Dictionary uses a single dic.txt.":7,"Injection merges split dictionaries back into data/dic.txt and patches the player executable.":8,"Split Dictionary (default)":9,"Merge Dictionary":10},"tags":[],"relPath":"/addons/bakinParser/bakin-proxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/bakinParser/bakin-xlsx.js":{"data":[["Start a translation project from RPG Developer Bakin localization sheet (xlsx).","從 RPG Developer Bakin 本地化工作表 (xlsx) 開始翻譯專案。"],["Create project","建立專案"],["Error: customField is not defined. This should not happen!","錯誤：customField 未定義。這不應該發生！"],["Please select the entry point to translate.","請選擇要翻譯的入口點。"],["<h2>RPG Developer Bakin editor is required</h2>","<h2>需要 RPG Developer Bakin 編輯器</h2>"],["RPG Developer Bakin editor is required to start the translation project.","啟動翻譯專案需要 RPG Developer Bakin 編輯器。"],["<h2>Before you start</h2>","<h2>開始之前</h2>"],["<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.","<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">解壓您的遊戲</a>為可編輯的 RPG Developer Bakin 專案。"],["Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.","使用 RPG Developer Bakin 應用程式將本地化字串匯出為 xlsx 檔案。<a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">請參閱此處的指南以了解如何翻譯 Bakin 遊戲</a>。"]],"context":[["tid/614/type/StringLiteral"],["tid/683/type/StringLiteral"],["tid/720/type/StringLiteral"],["tid/756/type/StringLiteral"],["tid/1034/type/NoSubstitutionTemplate"],["tid/1041/type/NoSubstitutionTemplate"],["tid/1064/type/NoSubstitutionTemplate"],["tid/1077/type/NoSubstitutionTemplate"],["tid/1088/type/NoSubstitutionTemplate"]],"basename":"bakin-xlsx.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-xlsx.js","path":"/addons/bakinParser/bakin-xlsx.js","indexIsBuilt":false,"indexIds":{"Start a translation project from RPG Developer Bakin localization sheet (xlsx).":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the entry point to translate.":3,"<h2>RPG Developer Bakin editor is required</h2>":4,"RPG Developer Bakin editor is required to start the translation project.":5,"<h2>Before you start</h2>":6,"<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.":7,"Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.":8},"tags":[],"relPath":"/addons/bakinParser/bakin-xlsx.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/basicUtils.js":{"data":[["NWJS Version","NWJS 版本"],["Change into this NWJS version","切換至此 NWJS 版本"],["Use Developer version","使用開發者版本"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","使用 NWJS 開發者版本。開發者版本提供開發者工具，適合調試和開發。"],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","在開發者版本中，您可以使用<b>開發者控制台</b>。按 F12 或右鍵點擊應用程式並選擇「檢查」即可存取開發者控制台。"],["Use 32-bit version","使用 32 位元版本"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","使用 NWJS 的 32 位元版本。32 位元版本有助於與舊系統相容。如果可能，建議取消勾選此選項（升級您的電腦吧，老兄）。"],["Some Translator++ feature may not work across NWJS version","某些 Translator++ 功能可能無法跨 NWJS 版本使用"],["Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.","請注意，某些 Translator++ 功能可能無法跨 NWJS 版本使用。更改 NWJS 版本後，請務必測試您的專案。"],["You're currently running on NWJS ver.","您目前正在運行 NWJS 版本"],["Change Translator++ Core NWJS version","更改 Translator++ 核心 NWJS 版本"],["You're already using the selected NWJS version.","您已經在使用選定的 NWJS 版本。"],["This operation will close Translator++ and change the current NW.js version into","此操作將關閉 Translator++ 並將目前的 NW.js 版本更改為"],["If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?","如果您有任何未儲存的更改，請選擇「取消」並先儲存您的專案。\n您要繼續嗎？"]],"context":[["tid/1342/type/StringLiteral"],["tid/1352/type/StringLiteral"],["tid/1428/type/StringLiteral","tid/1617/type/StringLiteral"],["tid/1438/type/StringLiteral"],["tid/1449/type/StringLiteral"],["tid/1482/type/StringLiteral","tid/1641/type/StringLiteral"],["tid/1492/type/StringLiteral"],["tid/1532/type/NoSubstitutionTemplate"],["tid/1537/type/NoSubstitutionTemplate"],["tid/1542/type/StringLiteral"],["tid/1669/type/NoSubstitutionTemplate"],["tid/1745/type/NoSubstitutionTemplate"],["tid/1769/type/NoSubstitutionTemplate"],["tid/1782/type/NoSubstitutionTemplate"]],"basename":"basicUtils.js","dirname":"/addons/basicUtils","extension":".js","filename":"basicUtils.js","path":"/addons/basicUtils/basicUtils.js","indexIsBuilt":false,"indexIds":{"NWJS Version":0,"Change into this NWJS version":1,"Use Developer version":2,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":3,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":4,"Use 32-bit version":5,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":6,"Some Translator++ feature may not work across NWJS version":7,"Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.":8,"You're currently running on NWJS ver.":9,"Change Translator++ Core NWJS version":10,"You're already using the selected NWJS version.":11,"This operation will close Translator++ and change the current NW.js version into":12,"If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?":13},"tags":[],"relPath":"/addons/basicUtils/basicUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/basicUtils/mainMenu.js":{"data":[["Change Language","更改語言"],["No MTL available for this language pair","此語言對無可用機器翻譯"],["Change default MTL for this project","變更此專案的預設機器翻譯"],["???","???"],["Search in a folder","在資料夾中搜尋"],["Search in Staging Files","在暫存檔案中搜尋"],["Search in Original Files","在原始檔案中搜尋"],["No original files path is set for this project.","此專案未設定原始檔案路徑。"],["Search in Translated Files","在翻譯檔案中搜尋"],["No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.","此專案未設定翻譯檔案路徑。\n您需要注入一次翻譯以設定翻譯檔案路徑。"],["Chat with AI Assistant","與AI助手聊天"],["AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.","AI助手不可用，因為新功能未載入。\n請重新安裝或重新更新Translator++。"]],"context":[["tid/442/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/974/type/StringLiteral"],["tid/1182/type/StringLiteral"],["tid/1339/type/StringLiteral"],["tid/1404/type/StringLiteral"],["tid/1501/type/StringLiteral"],["tid/1539/type/StringLiteral"],["tid/1624/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1777/type/StringLiteral"],["tid/1812/type/StringLiteral"]],"basename":"mainMenu.js","dirname":"/addons/basicUtils","extension":".js","filename":"mainMenu.js","path":"/addons/basicUtils/mainMenu.js","indexIsBuilt":false,"indexIds":{"Change Language":0,"No MTL available for this language pair":1,"Change default MTL for this project":2,"???":3,"Search in a folder":4,"Search in Staging Files":5,"Search in Original Files":6,"No original files path is set for this project.":7,"Search in Translated Files":8,"No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.":9,"Chat with AI Assistant":10,"AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.":11},"tags":[],"relPath":"/addons/basicUtils/mainMenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":12,"length":12,"percent":100},"parameters":[]},"/addons/basicUtils/utils/HTMLPacker.js":{"data":[["Path is not a file:","路徑不是檔案："],["Icon path is not a file:","圖示路徑不是檔案："],["Path is not an exe file:","路徑不是可執行檔："],["Icon path is not an ico file:","圖示路徑不是.ico檔案："],["Html entry point","HTML入口點"],["Select the html entry point file (usually index.html)","選擇HTML入口點檔案（通常是index.html）"],["Destination folder","目標資料夾"],["Select destination folder. The process will replace the existing files.","選擇目標資料夾。此過程將替換現有檔案。"],["NWJS version","NWJS版本"],["Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.","可選。選擇 NWJS 版本和架構。<br />最新版本不一定更好，只需使用適合您的版本。"],["Application ID","應用程式 ID"],["Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.","設定遊戲的應用程式 ID。ID 必須為小寫，且只能包含字母、數字和底線。"],["Application description","應用程式描述"],["Set the application description for the game.","設定遊戲的應用程式描述。"],["Window title","視窗標題"],["Set the default window title for the game.<br />This value may be overridden by the game engine.","設定遊戲的預設視窗標題。<br />此值可能被遊戲引擎覆蓋。"],["Window width","視窗寬度"],["Set the default window width for the game.","設定遊戲的預設視窗寬度。"],["Window height","視窗高度"],["Set the default window height for the game.","設定遊戲的預設視窗高度。"],["Full screen","全螢幕"],["Set the game to start in full screen mode.","設定遊戲以全螢幕模式啟動。"],["Resizable","可調整大小"],["Set the game window to be resizable.","設定遊戲視窗為可調整大小。"],["Game icon","遊戲圖示"],["Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.","選擇遊戲執行檔的圖示檔案。圖示檔案必須為 .ico 格式。圖示將嵌入遊戲執行檔中。"],["Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.","透過此表單，您可以建立遊戲的可玩套件。<br />此過程將替換目標資料夾中的現有檔案。"],["Start the application in full screen mode","以全螢幕模式啟動應用程式"],["Allow the application to be resizable","允許應用程式可調整大小"],["HTML Compiler","HTML編譯器"],["Compile","編譯"],["Source path can not empty","源路徑不能為空"],["Destination path can not empty","目標路徑不能為空"]],"context":[["tid/86/type/StringLiteral","tid/4136/type/StringLiteral"],["tid/116/type/StringLiteral"],["tid/151/type/StringLiteral"],["tid/186/type/StringLiteral"],["tid/2424/type/StringLiteral"],["tid/2434/type/StringLiteral"],["tid/2474/type/StringLiteral"],["tid/2484/type/StringLiteral"],["tid/2524/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2587/type/StringLiteral"],["tid/2597/type/StringLiteral"],["tid/2631/type/StringLiteral","tid/3795/type/StringLiteral"],["tid/2641/type/StringLiteral","tid/3805/type/StringLiteral"],["tid/2675/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2722/type/StringLiteral"],["tid/2732/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2810/type/StringLiteral"],["tid/2820/type/StringLiteral"],["tid/2854/type/StringLiteral"],["tid/2864/type/StringLiteral"],["tid/2899/type/StringLiteral"],["tid/2909/type/StringLiteral"],["tid/2950/type/NoSubstitutionTemplate"],["tid/3900/type/StringLiteral"],["tid/3924/type/StringLiteral"],["tid/4020/type/StringLiteral"],["tid/4037/type/StringLiteral"],["tid/4083/type/StringLiteral"],["tid/4104/type/StringLiteral"]],"basename":"HTMLPacker.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"HTMLPacker.js","path":"/addons/basicUtils/utils/HTMLPacker.js","indexIsBuilt":false,"indexIds":{"Path is not a file:":0,"Icon path is not a file:":1,"Path is not an exe file:":2,"Icon path is not an ico file:":3,"Html entry point":4,"Select the html entry point file (usually index.html)":5,"Destination folder":6,"Select destination folder. The process will replace the existing files.":7,"NWJS version":8,"Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.":9,"Application ID":10,"Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.":11,"Application description":12,"Set the application description for the game.":13,"Window title":14,"Set the default window title for the game.<br />This value may be overridden by the game engine.":15,"Window width":16,"Set the default window width for the game.":17,"Window height":18,"Set the default window height for the game.":19,"Full screen":20,"Set the game to start in full screen mode.":21,"Resizable":22,"Set the game window to be resizable.":23,"Game icon":24,"Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.":25,"Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.":26,"Start the application in full screen mode":27,"Allow the application to be resizable":28,"HTML Compiler":29,"Compile":30,"Source path can not empty":31,"Destination path can not empty":32},"tags":[],"relPath":"/addons/basicUtils/utils/HTMLPacker.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/basicUtils/utils/Updater.js":{"data":[["An update is being installed. Please do not close the application until the installation is completed.","正在安裝更新。請勿關閉應用程式，直到安裝完成。"],["Package Path","套件路徑"],["Select the package file.","選擇套件檔案。"],["Package Key","套件金鑰"],["If you have the key, please enter it here. If not, leave it empty.","如果您有金鑰，請在此輸入。如果沒有，請留空。"],["Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.","透過此表單，您可以使用更新套件檔案來更新Translator++。您可以<a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>在此</a>下載更新套件。"],["Update from package","從套件更新"],["Update","更新"],["Update Translator++","更新Translator++"]],"context":[["tid/4918/type/StringLiteral"],["tid/6562/type/StringLiteral"],["tid/6572/type/StringLiteral"],["tid/6612/type/StringLiteral"],["tid/6622/type/StringLiteral"],["tid/6661/type/NoSubstitutionTemplate"],["tid/6753/type/StringLiteral","tid/7195/type/StringLiteral"],["tid/6770/type/StringLiteral","tid/7091/type/StringLiteral"],["tid/7120/type/StringLiteral"]],"basename":"Updater.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"Updater.js","path":"/addons/basicUtils/utils/Updater.js","indexIsBuilt":false,"indexIds":{"An update is being installed. Please do not close the application until the installation is completed.":0,"Package Path":1,"Select the package file.":2,"Package Key":3,"If you have the key, please enter it here. If not, leave it empty.":4,"Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.":5,"Update from package":6,"Update":7,"Update Translator++":8},"tags":[],"relPath":"/addons/basicUtils/utils/Updater.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/utils/info.js":{"data":[["You have ","您有"],[" missed update(s)!","個錯過的更新！"],["Translator++ will update itself if auto-update is enabled.","如果啟用了自動更新，Translator++將自行更新。"],["You can download the latest core version of Translator++ at","您可以在以下位置下載Translator++的最新核心版本："],["This update is available for all patrons.","此更新適用於所有贊助者。"],["This update is available for tier $","此更新適用於層級$"],[" patrons or greater.","或以上的贊助者。"],["You're up-to-date!","您已是最新版本！"],["Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!","感謝您保持 Translator++ 的最新狀態！您正在使用最新版本，我們感謝您的支持。享受翻譯吧！"],["Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.","部分更新資訊可能來自快取顯示。您可以點擊 <b>'檢查更新'</b> 以載入最新版本的詳細資訊。"],["When the same version is available","當相同版本可用時"],["Allow Translator++ to reinstall the same version of Translator++.","允許 Translator++ 重新安裝相同版本的 Translator++。"],["Allow reinstall the same version","允許重新安裝相同版本"],["Update Settings","更新設定"],["Update Now","立即更新"],["Updater is not available, please update Translator++ manually.","更新程式不可用，請手動更新 Translator++。"],["Updating Translator++","正在更新 Translator++"],["Please don't close Translator++ until the update process is finished.","請勿在更新過程完成前關閉 Translator++。"],["Can not update, reason :\n","無法更新，原因：\n"],["You may need to reconnect Translator++ with your Patreon account (logout and login again).","您可能需要重新連接 Translator++ 與您的 Patreon 帳戶（登出並重新登入）。"],["Also, it has been reported that some countries such as mainland China are blocking dropbox repository.","此外，有報告指出，某些國家如中國大陸正在封鎖 Dropbox 儲存庫。"],["If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:","如果因某些原因您無法存取我們的儲存庫，請使用代理或 VPN 在此手動下載更新套件（tpch 檔案）："],["After that, please use the \"Update from package\" feature to update your Translator++.","之後，請使用「從套件更新」功能來更新您的 Translator++。"],["If you still have problems, please contact us at our Discord server : ","如果您仍有問題，請在我們的 Discord 伺服器聯繫我們："],["Restart","重新啟動"],["Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.","您現在要重新啟動 Translator++ 嗎？\n如果您有未儲存的工作，請取消此對話框並先儲存您的工作。"],["Check for Update","檢查更新"],["Close","關閉"]],"context":[["tid/649/type/StringLiteral"],["tid/660/type/StringLiteral"],["tid/665/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/1033/type/StringLiteral"],["tid/1077/type/StringLiteral"],["tid/1088/type/StringLiteral"],["tid/1665/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1675/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1765/type/StringLiteral"],["tid/1811/type/StringLiteral"],["tid/1873/type/StringLiteral"],["tid/2021/type/StringLiteral"],["tid/2066/type/StringLiteral"],["tid/2116/type/StringLiteral"],["tid/2130/type/StringLiteral"],["tid/2176/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2220/type/StringLiteral"],["tid/2245/type/NoSubstitutionTemplate"],["tid/2259/type/StringLiteral"],["tid/2357/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2449/type/StringLiteral"],["tid/2512/type/StringLiteral"]],"basename":"info.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"info.js","path":"/addons/basicUtils/utils/info.js","indexIsBuilt":false,"indexIds":{"You have ":0," missed update(s)!":1,"Translator++ will update itself if auto-update is enabled.":2,"You can download the latest core version of Translator++ at":3,"This update is available for all patrons.":4,"This update is available for tier $":5," patrons or greater.":6,"You're up-to-date!":7,"Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!":8,"Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.":9,"When the same version is available":10,"Allow Translator++ to reinstall the same version of Translator++.":11,"Allow reinstall the same version":12,"Update Settings":13,"Update Now":14,"Updater is not available, please update Translator++ manually.":15,"Updating Translator++":16,"Please don't close Translator++ until the update process is finished.":17,"Can not update, reason :\n":18,"You may need to reconnect Translator++ with your Patreon account (logout and login again).":19,"Also, it has been reported that some countries such as mainland China are blocking dropbox repository.":20,"If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:":21,"After that, please use the \"Update from package\" feature to update your Translator++.":22,"If you still have problems, please contact us at our Discord server : ":23,"Restart":24,"Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.":25,"Check for Update":26,"Close":27},"tags":[],"relPath":"/addons/basicUtils/utils/info.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":28,"length":28,"percent":100},"parameters":[]},"/addons/basicUtils/utils/uiTags.js":{"data":[["Do not process row with selected tag (blacklist)","不處理帶有選中標籤的行（黑名單）"],["Only process row with selected tag (whitelist)","僅處理帶有選中標籤的行（白名單）"],["Ignore tag","忽略標籤"],["Load last selection","載入上次選擇"],["Reset","重置"],["Cancel","取消"],["Confirm","確認"]],"context":[["tid/55/type/StringLiteral"],["tid/60/type/StringLiteral"],["tid/65/type/StringLiteral"],["tid/410/type/StringLiteral"],["tid/415/type/StringLiteral"],["tid/2085/type/StringLiteral"],["tid/2137/type/StringLiteral"]],"basename":"uiTags.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"uiTags.js","path":"/addons/basicUtils/utils/uiTags.js","indexIsBuilt":false,"indexIds":{"Do not process row with selected tag (blacklist)":0,"Only process row with selected tag (whitelist)":1,"Ignore tag":2,"Load last selection":3,"Reset":4,"Cancel":5,"Confirm":6},"tags":[],"relPath":"/addons/basicUtils/utils/uiTags.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/customParser/CustomParserLoader.js":{"data":[["List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.","可能的字元編碼列表。<b>順序很重要！</b>用逗號分隔每個值。<br />Translator++ 將使用以下編碼讀取原始檔案，修補檔案並使用<b>寫入字元編碼</b>選項寫入。留空以使用專案創建時的原始字元編碼。"],["For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>","對於 BOM 支援，在編碼後添加一個空格。例如：<code>utf8 bom</code>"],["Example: utf8,utf8 bom,utf16le,ascii","例如：utf8,utf8 bom,utf16le,ascii"],["Select the target character encoding.","選擇目標字元編碼。"]],"context":[["tid/3375/type/NoSubstitutionTemplate"],["tid/3383/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/4740/type/StringLiteral"]],"basename":"CustomParserLoader.js","dirname":"/addons/customParser","extension":".js","filename":"CustomParserLoader.js","path":"/addons/customParser/CustomParserLoader.js","indexIsBuilt":false,"indexIds":{"List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.":0,"For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>":1,"Example: utf8,utf8 bom,utf16le,ascii":2,"Select the target character encoding.":3},"tags":[],"relPath":"/addons/customParser/CustomParserLoader.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.html":{"data":[["<i class=\"icon-edit\"></i>","<i class=\"icon-edit\"></i>"],["<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>","<i class=\"icon-plus-circled\"></i><label data-tran=\"\">新增檔案群組</label>"],["Add a new file group","新增檔案群組"],["<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>","<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">移除當前檔案群組</label>"],["Remove current file group","移除當前檔案群組"],["Rules","規則"],["Hooks","鉤子"],["Options","選項"],["Testing","測試"],["Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>","在顯示於儲存格前對字串進行插值。<b>至網格</b>是<b>從網格</b>的反義。"],["Example","範例"],["For example, the text obtained from the parser is as follows:","例如，從解析器獲得的文字如下："],["In this grid it will look like this:","在此網格中，它會顯示如下："],["That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n","這不是最容易處理的文字。<br>\n  我們可以通過聲明<span class=\"inlineCode\">至網格掛鉤</span>來修復，如下所示：\n"],["With the hook above the text in the grid will be :","使用上述掛鉤，網格中的文字將變為："],["Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.","將儲存格中的字串插值到翻譯結果中。<b>從網格</b>是<b>至網格</b>的反義。"],["\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n","\n  例如，預期的翻譯字串應為JSON格式。<br>\n  但以JSON格式編寫翻譯並非最簡單的事。<br>\n  因此，與其要求翻譯者以JSON格式翻譯，我們可以只要求他們正常輸入，並添加一個<span class=\"inlineCode\">從網格掛鉤</span>，如下所示：\n"],["\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n","\n  使用上述<span class=\"inlineCode\">從網格掛鉤</span>，以下翻譯...\n"],["...will be converted into desired format: ","...將被轉換為所需格式："],["Edit the translated text just before writing it into a file.","在寫入檔案前編輯翻譯文字。"],["Parameters","參數"],["\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ","\n              <h3 data-tran=\"\">文字</h3>\n              <p data-tran=\"\">即將寫入檔案的文字。</p>\n            "],["text","文字"],["The text that is about to be written into a file.","即將寫入檔案的文字。"],["Return value","返回值"],["\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ","\n              <h3><i>字串</i></h3>\n              <p data-tran=\"\">將寫入檔案的文字。</p>\n            "],["The text that will be written into a file.","將寫入檔案的文字。"],["General","一般"],["Read character encoding","讀取字元編碼"],["Force parser to use the following character encoding when reading the file(s).","強制解析器在讀取檔案時使用以下字元編碼。"],["Write character encoding","寫入字元編碼"],["Force parser to use the following character encoding when writing the file(s).","強制解析器在寫入檔案時使用以下字元編碼。"],["You are editing:","您正在編輯："],["Please select the mode of your pattern","請選擇您的模式類型"],["Regular expression Pattern","正則表達式模式"],["A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.","有效的 ECMA Script 正則表達式及其修飾符。<br>您可以使用 <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> 來創建和測試您的模式。"],["Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ","注意待翻譯文本中回車符（\\r）的使用。regex101.com 會移除回車符，因此您的模式可能與在 regex101 上看到的效果不同。"],["<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.","<strong>關於捕獲零長度字串的量化符。</strong><br>\n            <i>空</i>字串會導致解析器出現問題。因此，建議使用 <strong>+</strong> 量化符（僅在字串存在時捕獲），而不是使用 <strong>*</strong> 量化符（也會捕獲 <i>空</i>字串）。"],["Translatable Capture groups","可翻譯捕獲群組"],["Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.","正則表達式群組（整數）的索引，用於可翻譯文本。可以有多個，用逗號分隔。"],["Row Info Capture group","行資訊捕獲群組"],["\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ","\n            正則表達式群組（整數）的索引，用於行資訊（例如角色名稱）。<b>只允許一個群組</b>。<br>\n            行資訊的值可以傳遞給子規則，如果子規則有行資訊值，則會被覆蓋。\n          "],["Context template","上下文模板"],["\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ","\n            上下文是可翻譯文本的唯一識別符。<br>\n            您可以使用 JavaScript 的模板字面量來添加資訊到上下文中。<br>\n            <b>可用變數：</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - 群組捕獲。</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - 規則的 ID。</li> -->\n            </ul>\n            <br>\n            <b>範例：</b>\n            <pre>item/${GROUP[2]}</pre>\n          "],["Action","操作"],["Capture value","捕獲值"],["Capture then mask value","捕獲並遮罩值"],["Mask value","遮罩值"],["Send to inner rule","傳送至內部規則"],["Edit inner rule <i class=\"icon-angle-double-right\"></i>","編輯內部規則 <i class=\"icon-angle-double-right\"></i>"],["What action the pattern is going to do.","此模式將執行的操作。"],["Javascript function","JavaScript 函數"],["Guide","指南"],["\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ","\n          <h2 data-tran=\"\">參數</h2>\n          <p data-tran=\"\">您編寫的代碼將位於一個具有2個參數的函數內，這些參數可在代碼中任何地方訪問：</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>字串</b></p>\n              <p data-tran=\"\">文件全部內容的字串。</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>物件</b></p>\n              <p data-tran=\"\">當前文件使用的規則物件。</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> 關鍵字</h2>\n          <p data-tran=\"\"><b>this</b> 將指向 CustomParser 類別的實例。</p>\n\n        "],["Arguments","參數"],["The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:","您編寫的代碼將位於一個具有2個參數的函數內，這些參數可在代碼中任何地方訪問："],["A string of the entire content of the file.","文件全部內容的字串。"],["The rule object that is currently used by the file.","當前文件使用的規則物件。"],["<i>this</i> Keyword","<i>this</i> 關鍵字"],["<b>this</b> will reffer to the instance of CustomParser class.","<b>this</b> 將指向 CustomParser 類別的實例。"],["\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ","\n          <h2 data-tran=\"\">預期返回值</h2>\n          <p data-tran=\"\">您的代碼必須<b>返回</b>以下值之一：</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">捕獲文字的偏移量，例如：\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"角色名稱\", // 角色名稱。可選\n    context: [\"some\", \"context\", \"here\"] // 上下文。可選\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">捕獲文字的偏移量陣列，例如：\n<pre>  [\n    {start:0, end:5, rowInfoText:\"角色名稱\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"另一個角色\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"第三個角色\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        "],["Expected Return Value","預期返回值"],["Your code must <b>return</b> one of the following value:","您的代碼必須<b>返回</b>以下值之一："],["Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ","捕獲文字的偏移量，例如：\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"角色名稱\", // 角色名稱。可選\n    context: [\"some\", \"context\", \"here\"] // 上下文。可選\n  }\n</pre>\n            "],["Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ","捕獲文字的偏移量陣列，例如：\n<pre>  [\n    {start:0, end:5, rowInfoText:\"角色名稱\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"另一個角色\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"第三個角色\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            "],["\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ","\n          <h2 data-tran=\"\">範例</h2>\n          <p data-tran=\"\">以下代碼是解析 srt 字幕的範例。</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ 使用 regexp-match-indices\n  因此所有 RegExp.exec() 方法將返回其群組偏移量\n  有關正則表達式索引的更多信息，請參閱：https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        "],["The following code is an example to parse srt subtitle.","以下代碼是解析 srt 字幕的範例。"],["Welcome to the Custom Parser Model Creator","歡迎使用自定義解析器模型創建器"],["Please start by creating a new File Group.","請先創建一個新的檔案群組。"],["Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ","請點擊\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>新增檔案群組</button> 按鈕來定義您想要解析的檔案類型。\n    "],["Press F1 to open the help dialog.","按F1開啟幫助對話框。"],["New File","新檔案"],["Open file","開啟檔案"],["Save file","儲存檔案"],["Save As","另存新檔"],["Open debugger (F12)","開啟偵錯器 (F12)"],["Help","幫助"],["Edit current file pattern","編輯當前檔案模式"],["Add a new file pattern","新增檔案模式"],["Remove current file pattern","移除當前檔案模式"],["Rule's order does matter, especially when you use masking! Drag to reorder.","規則的順序很重要，特別是當您使用遮罩時！拖曳以重新排序。"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText","idx/29/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/28/innerText","idx/69/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"],["idx/9/attr/title"]],"basename":"modelEditor.html","dirname":"/addons/customParser/modelEditor","extension":".html","filename":"modelEditor.html","path":"/addons/customParser/modelEditor/modelEditor.html","indexIsBuilt":false,"indexIds":{"<i class=\"icon-edit\"></i>":0,"<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>":1,"Add a new file group":2,"<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>":3,"Remove current file group":4,"Rules":5,"Hooks":6,"Options":7,"Testing":8,"Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>":9,"Example":10,"For example, the text obtained from the parser is as follows:":11,"In this grid it will look like this:":12,"That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n":13,"With the hook above the text in the grid will be :":14,"Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.":15,"\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n":16,"\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n":17,"...will be converted into desired format: ":18,"Edit the translated text just before writing it into a file.":19,"Parameters":20,"\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ":21,"text":22,"The text that is about to be written into a file.":23,"Return value":24,"\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ":25,"The text that will be written into a file.":26,"General":27,"Read character encoding":28,"Force parser to use the following character encoding when reading the file(s).":29,"Write character encoding":30,"Force parser to use the following character encoding when writing the file(s).":31,"You are editing:":32,"Please select the mode of your pattern":33,"Regular expression Pattern":34,"A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.":35,"Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ":36,"<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.":37,"Translatable Capture groups":38,"Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.":39,"Row Info Capture group":40,"\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ":41,"Context template":42,"\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ":43,"Action":44,"Capture value":45,"Capture then mask value":46,"Mask value":47,"Send to inner rule":48,"Edit inner rule <i class=\"icon-angle-double-right\"></i>":49,"What action the pattern is going to do.":50,"Javascript function":51,"Guide":52,"\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ":53,"Arguments":54,"The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:":55,"A string of the entire content of the file.":56,"The rule object that is currently used by the file.":57,"<i>this</i> Keyword":58,"<b>this</b> will reffer to the instance of CustomParser class.":59,"\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ":60,"Expected Return Value":61,"Your code must <b>return</b> one of the following value:":62,"Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ":63,"Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ":64,"\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ":65,"The following code is an example to parse srt subtitle.":66,"Welcome to the Custom Parser Model Creator":67,"Please start by creating a new File Group.":68,"Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ":69,"Press F1 to open the help dialog.":70,"New File":71,"Open file":72,"Save file":73,"Save As":74,"Open debugger (F12)":75,"Help":76,"Edit current file pattern":77,"Add a new file pattern":78,"Remove current file pattern":79,"Rule's order does matter, especially when you use masking! Drag to reorder.":80},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":81,"length":81,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.js":{"data":[["Do you want to close Model editor?\rAll unsaved changes will be discarded.","您要關閉模型編輯器嗎？\r所有未儲存的變更將被丟棄。"],["Translate here using ","在此使用 "],["Do you want to discard your changes and open\n","您要丟棄變更並開啟\n"],["Error when trying to open file :","嘗試開啟檔案時發生錯誤："],["Parser Model Creator","解析器模型創建器"],["Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json","請指定您想要解析的檔案類型。\n您可以使用分號分隔的萬用字元模式。例如：*.txt;*.js;*.json"],["Failed to create new file group. Please check your pattern!","創建新檔案群組失敗。請檢查您的模式！"],["Do you wish to remove current file group?\nYou can not undo this action!","您是否要移除目前的檔案群組？\n此操作無法復原！"],["Do you want to discard your changes and create a new blank model?","您是否要捨棄變更並建立一個新的空白模型？"],["Do you want to discard your changes and open a file?","您是否要捨棄變更並開啟一個檔案？"],["Clear history","清除歷史記錄"],["Open latest file","開啟最新檔案"],["Open from history","從歷史記錄開啟"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","此功能僅在您使用 Translator++ 的開發者版本時可用。您可以透過基本工具 -> 變更核心 NWJS 來切換至開發者版本。"]],"context":[["tid/156/type/StringLiteral"],["tid/5647/type/StringLiteral"],["tid/9760/type/StringLiteral"],["tid/10037/type/StringLiteral"],["tid/10099/type/StringLiteral"],["tid/10622/type/StringLiteral","tid/10941/type/StringLiteral"],["tid/10665/type/StringLiteral","tid/10987/type/StringLiteral"],["tid/11026/type/StringLiteral"],["tid/11104/type/StringLiteral"],["tid/11174/type/StringLiteral","tid/12080/type/StringLiteral"],["tid/11459/type/StringLiteral"],["tid/11525/type/StringLiteral"],["tid/11607/type/StringLiteral"],["tid/11750/type/StringLiteral"]],"basename":"modelEditor.js","dirname":"/addons/customParser/modelEditor","extension":".js","filename":"modelEditor.js","path":"/addons/customParser/modelEditor/modelEditor.js","indexIsBuilt":false,"indexIds":{"Do you want to close Model editor?\rAll unsaved changes will be discarded.":0,"Translate here using ":1,"Do you want to discard your changes and open\n":2,"Error when trying to open file :":3,"Parser Model Creator":4,"Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json":5,"Failed to create new file group. Please check your pattern!":6,"Do you wish to remove current file group?\nYou can not undo this action!":7,"Do you want to discard your changes and create a new blank model?":8,"Do you want to discard your changes and open a file?":9,"Clear history":10,"Open latest file":11,"Open from history":12,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":13},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string","無效的語言字串"],["Required field Project ID is blank!","必填欄位專案 ID 為空白！"],["Required field Service Account Key is blank!","必填欄位服務帳戶金鑰為空白！"],["Required field Server Location is blank!","必填欄位伺服器位置為空白！"],["Required field Location of the glossary file is blank!","必填欄位詞彙表檔案位置為空白！"],["Required field Glossary Languages is blank!","必填欄位詞彙表語言為空白！"],["Invalid glossary language value","無效的詞彙表語言值"],["Currently active glossary on this project: ","此專案目前活躍的詞彙表："],["Error when retreiving glossary info: ","擷取詞彙表資訊時發生錯誤："],["Error when removing glossary : ","移除詞彙表時發生錯誤："],["Glossary removed successfully.","詞彙表已成功移除。"],["Error when creating glossary : ","建立詞彙表時發生錯誤："],["Glossary created successfully.","詞彙表已成功建立。"],["Configuration error:\r\n","配置錯誤：\r\n"],["No error found!","未發現錯誤！"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js","使用Google Cloud Translate Advanced需要Node JS。請從https://node.js下載並安裝。"]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?","在指定位置找不到JCap可執行檔。您要安裝JCap嗎？"],["JCap agent started successfully. Press ","JCap代理已成功啟動。按"],["jcapKey","jcapKey"],["Please set the JCap executable path in the addon settings.","請在附加元件設定中設定JCap可執行檔路徑。"],["JCap executable already exists at the specified location.","JCap可執行檔已存在於指定位置。"],["JCap executable downloaded successfully.","JCap可執行檔已成功下載。"],["Failed to download JCap package. Please check the console for details.","下載JCap套件失敗。請檢查控制台以獲取詳細資訊。"],["JCap executable unpacked successfully.","JCap可執行檔已成功解壓縮。"],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.","您現在可以從主選單 - 工具 - OCR工具 JCap - 啟動JCap代理來啟動JCap代理。"],["Start JCap OCR Agent","啟動JCap OCR代理"],["Failed to unpack JCap package. Please check the console for details.","解壓縮JCap套件失敗。請檢查控制台以獲取詳細資訊。"],["JCap executable not found at the specified location.","在指定位置找不到JCap可執行檔。"],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.","您確定要解除安裝JCap嗎？這將刪除JCap可執行檔及其配置。"],["JCap uninstalled successfully.","JCap已成功解除安裝。"],["Failed to uninstall JCap. Please check the console for details.","解除安裝JCap失敗。請檢查控制台以獲取詳細資訊。"],["Help","幫助"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.","JCap OCR是一個OCR工具，允許您從螢幕擷取文字並使用JCap翻譯。要使用它，請點擊主選單上的OCR按鈕啟動JCap。\n然後按配置的按鍵（預設：F9）來擷取文字。"]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data","美化 JSON 數據"],["When checked the generated data will be beautified.","勾選時，生成的數據將被美化。"],["Start a new translation project from any JSON file.","從任何 JSON 檔案開始新的翻譯專案。"],["Translator++ will translate any translatable texts found in the JSON files.","Translator++ 將翻譯 JSON 檔案中找到的任何可翻譯文本。"],["Read the guide on how to start a new JSON translation project here","在此閱讀如何開始新的 JSON 翻譯專案指南"],["Translator++ will scan through this folder for any JSON files.","Translator++ 將掃描此資料夾中的任何 JSON 檔案。"],["How do you want to get the data from the JSON object?","您想如何從 JSON 物件獲取數據？"],["Parser mode","解析器模式"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>","<h2>簡單模式</h2><p>在簡單模式中，您可以遞歸地翻譯 JSON 物件內的所有字符串值。<br />在簡單模式中，原始文本始終是值。</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>","<h2>進階模式</h2><p>在進階模式中，您可以查詢 JSON 並處理鍵值對類型的翻譯表，其中原始文本是鍵。</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>","<h2>資訊</h2><p>您可以使用以下查詢欄位來選擇 JSON 物件的特定部分。查詢結果必須是物件或文本陣列。</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>","<h3>對於物件</h3><p><b>鍵將用作原始文本</b>，<b>值將用作預設翻譯</b>。</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />","如果值是字符串、null 或 undefined，解析器將自動註冊。<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>","<h3>對於陣列</h3><p>解析器將註冊陣列中的所有字符串值作為可翻譯文本。</p>"],["Start project","開始專案"],["`Invalid destination directory:\\n${","`無效的目的地目錄：\\n${"],["}`","}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label","標籤"],["is duplicated in the same scenario file","在同一個場景檔案中重複"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory","選擇目錄"],["Select a directory to repack","選擇一個目錄重新封裝"],["Target xp3","目標 xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.","選擇檔案名稱。特殊檔案名稱如 <b>patch.xp3</b>、<b>patch2.xp3</b>...等在載入時會優先於 data.xp3。"],["Patch to allow folder structure","允許資料夾結構的修補"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.","預設情況下，KAG 引擎不會讀取 xp3 檔案內資料夾中的檔案。此選項會自動將資料夾結構定義添加到 Config.tjs。如果找不到 Config.tjs 檔案，則無效。"],["Repack into xp3","重新封裝為 xp3"],["Close","關閉"],["Process","處理"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.","如果您一次解包多個檔案，<b>順序很重要</b>！檔案將按順序解包。如果檔案已存在，將被覆蓋。"],["Unpack XP3 files","解包 XP3 檔案"],["Repack a folder to xp3","將資料夾重新封裝為 xp3"],["Unpack xp3 file","解包 xp3 檔案"],["Before you create a new project, please make sure that :","在創建新專案之前，請確保："],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","所有 .ks 和 .tjs 檔案都是純文字（未編譯、未加擾、未加密）"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.","KAG 遊戲即使未重新封裝也應可玩。因此，您應該檢查遊戲在提取後是否可玩。"],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","某些操作會修改您的遊戲。<b>請務必創建遊戲的備份！</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","選擇遊戲執行檔。此檔案是將用於提取遊戲資料的主要遊戲檔案。"],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.","Translator++ 可以使用 AEC 附加元件提取 XP3 檔案。<b>但提取器並非適用於所有類型 XP3 的萬全解決方案</b>。"],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.","某些劇本檔案已加密。如果您希望 Translator++ 嘗試解密它們，請勾選此選項。"],["This may not work on some projects.","這可能在某些專案上無效。"],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","可能的字符編碼列表。<b>順序很重要！</b>您可以拖動以排序列表。"],["Literal tags are the tags that will be escaped into Translator++ editor.","文字標籤是將在Translator++編輯器中轉義的標籤。"],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b>是必需的。"],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b>標籤將由Translator++插入為新行，因此您不需要顯式寫入<b>[r]</b>。"],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","Kirikiri腳本(.ks)高度可自定義，允許開發者創建自己的標籤。"],["Translator++ can handle standard tags such as character names that start with a sharp (#).","Translator++可以處理標準標籤，例如以井號(#)開頭的角色名稱。"],["However, Translator++ cannot handle custom tags created by developers.","然而，Translator++無法處理開發者創建的自定義標籤。"],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","因此，您可能需要定義需要翻譯的標籤和屬性，以及需要標記為演員名稱的標籤。"],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.","在開始項目之前，您可能需要<input type=\"button\" value=\"提取您的xp3遊戲\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" />並分析其中的ks腳本。"],["Create Project","創建項目"],["Pack a folder into xp3","將文件夾打包為xp3"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.","選擇目標字符編碼。<br />大多數日語KAG遊戲使用SHIFT-JIS編寫，但KAG實際上支持UTF16LE Unicode。許多翻譯者將字符編碼設置為UTF16LE，以便遊戲可以在非日語Windows上運行，無需區域模擬器。最重要的是，可以顯示SHIFT-JIS以外的字符，如\"café\"。<br />默認情況下，Translator++將寫入其原始字符編碼。"],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference.","有幾種方法可以為KAG生成可玩的本地化遊戲。請選擇適合您偏好的方式。"]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode","選擇模式"],["Select how do you want to start your project. By selecting files or folders.","選擇您希望如何開始您的項目：通過選擇文件或文件夾。"],["Select Folder","選擇文件夾"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","選擇要處理的文件夾。Translator++將遞歸檢索指定文件夾中的PO文件。"],["Select File","選擇文件"],["Select the files you want to process.","選擇您要處理的文件。"],["Filters","過濾器"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","使用 glob 模式篩選檔案名稱。預設為 <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","所選資料夾及其子資料夾中的所有 .po 檔案。"],["All .mo files in the selected folder and its subfolders.","所選資料夾及其子資料夾中的所有 .mo 檔案。"],["PO Files","PO 檔案"],["MO Files","MO 檔案"],["You are about to export the translations as MO files.\n","您即將將翻譯匯出為 MO 檔案。\n"],["- MO files are binary files that cannot be edited manually.\n","- MO 檔案是無法手動編輯的二進位檔案。\n"],["- Only translated entries are stored in MO files.\n","- 只有已翻譯的條目會儲存在 MO 檔案中。\n"],["Are you sure you want to proceed?","您確定要繼續嗎？"],["PO / MO Files","PO / MO 檔案"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[],"cacheResetOnChange":{},"cellInfo":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.",".po 和 .mo 檔案是標準的文字型和二進位檔案格式，通常一起用於軟體本地化，特別是在 WordPress 中，用於翻譯主題和外掛。PO（Portable Object）檔案是可讀的文字，包含翻譯內容；而 MO（Machine Object）檔案是編譯後、機器可讀的二進位檔案，供軟體快速載入使用。"],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts","從 PO（Portable Object）和 MO（Machine Object）翻譯腳本開始翻譯"],["Create Project","建立專案"],["Select mode","選擇模式"],["Select how do you want to start your project. By selecting files or folders.","選擇您希望如何開始您的專案：透過選擇檔案或資料夾。"],["Select Folder","選擇資料夾"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","選擇要處理的資料夾。Translator++ 將遞迴地從指定資料夾中擷取 PO 檔案。"],["Select File","選擇檔案"],["Select the files you want to process.","選擇您要處理的檔案。"],["Filters","篩選器"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","使用 glob 模式篩選檔案名稱。預設為 <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","所選資料夾及其子資料夾中的所有 .po 檔案。"],["All .mo files in the selected folder and its subfolders.","所選資料夾及其子資料夾中的所有 .mo 檔案。"],["ProjectTitle","專案標題"],["Your project title","您的專案標題"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor","Livemaker 遊戲提取器"],["Half width character patch","半形字元修補"],["Patch half-width character","修補半形字元"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings","Livemaker 引擎在語言支援方面有限制。它需要將 Windows 非 Unicode 系統地區設定為日文才能執行 LiveMaker 和 LiveNovel 應用程式。此外，引擎硬編碼為僅使用已安裝的支援 Windows Shift-JIS (MS CP932) 的 Windows 系統字型，這意味著它可能不支援其他地區設定或編碼"],["Next","下一步"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?","無法偵測 RPG Maker 類型！\n您確定遊戲是 RPG Maker XP、VX 或 VX Ace 嗎？"],["Create a new project","建立新專案"],["Invalid destination file:","無效的目的地檔案："],[" doesn't seems to be a LiveMaker game."," 似乎不是 LiveMaker 遊戲。"]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path.","開發路徑未定義。\n您應該注入遊戲一次以生成開發路徑。"],["Decompile all rpyc files","反編譯所有 rpyc 檔案"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.","嘗試將所有 rpyc 檔案反編譯為 .rpy。<br />Translator++ 有自己的反編譯器。但據報告，有時無法反編譯一些使用 Renpy 7 創建的遊戲。您可以不勾選此欄位，並在開始專案前使用自己的工具自行反編譯遊戲。"],["Overwrite rpy","覆寫 rpy"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.","如果勾選，則反編譯器 <b>將覆寫現有的未編譯 rpy 檔案</b>。"],["Exclude command","排除指令"],["This option will allow us to skip some command for being processed and translated","此選項將允許我們跳過某些命令的處理和翻譯"],["Separate entries with a space","用空格分隔條目"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored","例如，如果您輸入 <b>old</b>，則所有以 <b>old</b> 開頭的 rpy 行將被忽略"],["Are you sure want to start a project without decompiling the rpyc files?","您確定要開始一個專案而不反編譯 rpyc 檔案嗎？"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?","您選擇的檔案不是 Ren'Py 遊戲可執行檔案。\n您仍要繼續嗎？"],["Play last build","播放最後的建置"],["Open Ren'Py documentation","開啟 Ren'Py 文件"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","選項已設定為使用舊版解析器。\n您可以隨時透過選項選單切換回新解析器。"]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator","Windows 二進位檔案翻譯器"],["Parsing Windows binary file with","正在使用解析 Windows 二進位檔案"],["Sellect supported files","選擇支援的檔案"],["Select supported file type to translate.","選擇要翻譯的支援檔案類型。"],["Create a new project","建立新專案"],["Please select a supported file to parse","請選擇一個支援的檔案進行解析"],["Please enter your project title!","請輸入您的專案標題！"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player","使用原生 RPG 播放器"],["Use native RPG Player instead of Easy RPG Player","使用原生 RPG 播放器而非簡易 RPG 播放器"],["Use native RPG Player","使用原生 RPG 播放器"],["Target folder","目標資料夾"],["Select destination folder.","選擇目標資料夾。"],["Install Easy RPG Player","安裝 Easy RPG Player"],["Close","關閉"],["Install","安裝"],["Process completed!","處理完成！"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin.","RPG Maker 2000 & 2003 解析器搭配 xmlTrans 插件。"],["Play last build","播放最後構建"],["Apply translation then play","套用翻譯後播放"],["Setup Easy RPG in the current directory","在當前目錄中設定 Easy RPG"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine","從 RM2k / RM2k3 引擎開始翻譯"],["Create project","建立專案"],["Please select RPG Maker 2000/2003 game!","請選擇 RPG Maker 2000/2003 遊戲！"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?","無法偵測 RPG Maker 類型！\n您確定遊戲是 RPG Maker 2000 / 2003 嗎？"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder","目標資料夾"],["Select destination folder.","選擇目的地資料夾。"],["Install Easy RPG Player","安裝 Easy RPG Player"],["Close","關閉"],["Install","安裝"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/","如何新增自訂字體。\n\n字體必須放置在遊戲目錄的 Font 資料夾中，且必須命名為 Font.ttf 或 Font2.ttf。使用哪個字體檔案取決於系統圖形字體設定。除了 ttf，還支援 fon 和許多其他字體（任何 FreeType 支援的格式，這是可用於字體渲染的最佳開源庫）。\n\n來源：https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!","處理完成！"],["Play last build","播放最後構建"],["Apply translation then play","套用翻譯後播放"],["Setup Easy RPG in the current directory","在當前目錄設定 Easy RPG"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data","美化 JSON 資料"],["When checked the generated data will be beautified.","勾選時，生成的資料將被美化。"],["Error loading system.json","載入 system.json 時發生錯誤"],["Loading","載入中"],["index.html not found in","在  中找不到 index.html"],["Encrypted game","加密遊戲"],["Select the index.html of your encrypted game.","選擇您加密遊戲的 index.html。"],["Target folder","目標資料夾"],["Select destination folder. The process will replace the existing files.","選擇目標資料夾。此過程將替換現有檔案。"],["Decrypt Resources","解密資源"],["Close","關閉"],["Process","處理"],["Source path can not empty","來源路徑不能為空"],["Destination path can not empty","目標路徑不能為空"],["Path is not a file:","路徑不是檔案："],["Invalid directory:","無效的目錄："],["Extract enigma","提取 enigma"],["Select enigma file.","選擇 enigma 檔案。"],["Extract Enigma","提取Enigma"],["Selected file is not an Enigma Virtual Box package.","所選檔案不是Enigma Virtual Box套件。"],["Plugins are already fetched for this project. Want to re-fetch the plugins?","此專案的插件已獲取。是否要重新獲取插件？"],["Translate Javascript File?","翻譯Javascript檔案？"],["Cancel","取消"],["I know the risk, Proceed!","我知道風險，繼續！"],["Game Executable Path","遊戲執行檔路徑"],["Path to the game executable file (.exe)","遊戲執行檔的路徑（.exe）"],["NWJS Version","NWJS版本"],["Change into this NWJS version","變更為此NWJS版本"],["Use Developer version","使用開發者版本"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","使用NWJS開發者版本。開發者版本提供開發者工具，適合調試和開發。"],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","在開發者版本中，您可以使用<b>開發者控制台</b>。可透過按F12或右鍵點擊應用並選擇'檢查'來存取開發者控制台。"],["Use 32-bit version","使用32位元版本"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","使用NWJS的32位元版本。32位元版本有助於與舊系統相容。如果可能，建議取消勾選此選項（就升級你的機器吧，老兄）。"],["Some game feature may not work across NWJS version","某些遊戲功能可能在不同NWJS版本中無法運作"],["Please be aware that some game feature may not work across NWJS version.","請注意，某些遊戲功能可能在不同NWJS版本中無法運作。"],["Change RPG Maker MV / RPG Maker MZ / NWJS version","變更RPG Maker MV / RPG Maker MZ / NWJS版本"],["This operation will change the NW.js version into","此操作將把NW.js版本變更為"],["Please close the application first before continuing.\nDo you want to continue?","請先關閉應用程式，然後再繼續。\n您要繼續嗎？"],["The selected file is not a valid NW.js application.","所選檔案不是有效的 NW.js 應用程式。"],["Could not find index.html in the game directory.","在遊戲目錄中找不到 index.html。"],["Debug menu script not found in addon directory.","在附加元件目錄中找不到除錯選單腳本。"],["Debug menu script is already installed in index.html.","除錯選單腳本已安裝在 index.html 中。"],["Debug options installed successfully!","除錯選項安裝成功！"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n","所選遊戲未在 NW.js 開發者模式（SDK）中執行。\n\n"],["Developer Mode provides additional debugging features:\n","開發者模式提供額外的除錯功能：\n"],["• Developer Console (F12)\n","• 開發者控制台（F12）\n"],["• Inspect Element (Right-click)\n","• 檢查元素（右鍵點擊）\n"],["• Network Monitor\n","• 網路監控器\n"],["• Performance Profiler\n\n","• 效能分析器\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n","您想升級到 NW.js 開發者模式嗎？\n"],["(Recommended for better debugging experience)","（建議以獲得更好的除錯體驗）"],["The game will be upgraded to NW.js SDK version","遊戲將升級到 NW.js SDK 版本"],["This may take a few minutes. Please wait...","這可能需要幾分鐘。請稍候..."],["NW.js has been upgraded to Developer Mode successfully!","NW.js 已成功升級到開發者模式！"],["Failed to upgrade to Developer Mode:\n","升級到開發者模式失敗：\n"],["Error installing debug options: ","安裝除錯選項時發生錯誤："],["Install Debug Options","安裝除錯選項"],["This will install a debug menu into your RPG Maker MV/MZ game.","這將在您的 RPG Maker MV/MZ 遊戲中安裝一個除錯選單。"],["Select the game executable file to install debug options.","選擇遊戲可執行文件以安裝除錯選項。"],["Compile HTML to Executable","編譯 HTML 為可執行文件"],["Change Existing NWJS Version","更改現有 NWJS 版本"],["Install debug options","安裝除錯選項"],["Find next","尋找下一個"],["Open folder","開啟資料夾"],["Open with external application","使用外部應用程式開啟"],["Raw JSON data. Right click to open menu.","原始 JSON 數據。右鍵點擊開啟選單。"],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)","此翻譯數據有可用的修補程式。此修補程式將使您的翻譯數據與當前版本的 Translator++ 相容。\n您要修補您的翻譯數據嗎？\n（如果不修補，某些功能可能無法正常運作）"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.","無法定位可執行文件以安裝除錯選項。請確保您的遊戲是為 Windows 使用 NW.js 打包的。"],["Error while installing debug options: ","安裝除錯選項時發生錯誤："],["Play last build","播放最後的構建"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","開發路徑未定義。\n您應該注入遊戲一次以生成開發路徑。"],["Open editor","開啟編輯器"],["Load Plugins Into Project","將插件載入到專案中"],["Compile Game","編譯遊戲"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","選項已設定為使用舊版解析器。\n您可以隨時通過選單切換回新解析器。"],["Unable to find the file related to the data","無法找到與數據相關的檔案"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","要修復此問題，請在 <a href=\"#\" class=\"openProjectProperties\">專案屬性</a> 中修正 <b>原始材料位置</b> 欄位"],["Maximum dialog line","最大對話行數"],["Maximum line in the dialog box. Default is 4.","對話框中的最大行數。預設為4。"],["Add debug options","添加除錯選項"],["Add debug options into the game to help testing.","在遊戲中添加除錯選項以協助測試。"],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>","啟用此選項以在遊戲中添加除錯工具。這些功能可幫助您測試翻譯。<br/><b>⚠️ 注意：此選項僅在您的遊戲使用適用於Windows的NWJS打包時可用。</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/type/StringLiteral","tid/21410/type/StringLiteral"],["tid/20865/type/StringLiteral","tid/21461/type/StringLiteral"],["tid/20925/type/StringLiteral"],["tid/20962/type/StringLiteral"],["tid/20992/type/StringLiteral"],["tid/21023/type/StringLiteral"],["tid/21215/type/StringLiteral"],["tid/21220/type/StringLiteral"],["tid/21309/type/StringLiteral"],["tid/21564/type/StringLiteral"],["tid/21678/type/StringLiteral"],["tid/22062/type/StringLiteral"],["tid/22163/type/StringLiteral"],["tid/22214/type/StringLiteral"],["tid/22424/type/StringLiteral","tid/24166/type/StringLiteral"],["tid/22434/type/StringLiteral","tid/24176/type/StringLiteral"],["tid/22468/type/StringLiteral"],["tid/22478/type/StringLiteral"],["tid/22512/type/StringLiteral","tid/22962/type/StringLiteral"],["tid/22522/type/StringLiteral"],["tid/22533/type/StringLiteral"],["tid/22560/type/StringLiteral","tid/22986/type/StringLiteral"],["tid/22570/type/StringLiteral"],["tid/22605/type/NoSubstitutionTemplate"],["tid/22610/type/NoSubstitutionTemplate"],["tid/23014/type/NoSubstitutionTemplate"],["tid/23119/type/NoSubstitutionTemplate"],["tid/23148/type/NoSubstitutionTemplate"],["tid/23298/type/StringLiteral"],["tid/23453/type/StringLiteral"],["tid/23555/type/StringLiteral"],["tid/23696/type/StringLiteral"],["tid/23770/type/StringLiteral"],["tid/23812/type/StringLiteral"],["tid/23820/type/StringLiteral"],["tid/23828/type/StringLiteral"],["tid/23836/type/StringLiteral"],["tid/23844/type/StringLiteral"],["tid/23852/type/StringLiteral"],["tid/23860/type/StringLiteral"],["tid/23868/type/StringLiteral"],["tid/23922/type/NoSubstitutionTemplate"],["tid/23931/type/NoSubstitutionTemplate"],["tid/23972/type/StringLiteral"],["tid/24005/type/StringLiteral"],["tid/24068/type/StringLiteral"],["tid/24217/type/NoSubstitutionTemplate","tid/24282/type/NoSubstitutionTemplate"],["tid/24222/type/NoSubstitutionTemplate"],["tid/24227/type/NoSubstitutionTemplate"],["tid/24482/type/StringLiteral"],["tid/24546/type/StringLiteral"],["tid/24598/type/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":82,"length":82,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS.","此功能僅在您使用NWJS的開發者版本時可用。"]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js.","此功能僅在您使用NW.js的開發者版本時可用。"]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser","使用舊版解析器"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.","使用（Translator++ ver. 3.8.12之前）的舊解析器。舊解析器不支援某些新增功能。"],["Use old parser","使用舊解析器"],["Event's thread concurrency","事件的執行緒並發數"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.","<b>警告！實驗性功能！</b><br />此選項決定在地圖和CommonEvents上並發解析事件數據的最大工作執行緒數。<b>設為0以禁用工作執行緒</b>。<br />此選項有可能加速大型遊戲的解析過程。但請注意，在較小的遊戲中，啟用此選項可能因執行開銷高於每個數據的解析時間而減慢解析過程。"],["The minimum number of command in an event that allowed in thread worker","事件中允許在工作執行緒中處理的最小指令數"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.","<b>警告！實驗性功能！</b><br />工作執行緒在執行時會產生開銷，這意味著處理空白事件或指令數較少的事件實際上可能阻礙整體過程。此選項允許您指定事件必須包含的最小指令數，以便在工作執行緒中解析。<br />請注意，即使空白事件也包含一個指令，在主執行緒而非工作執行緒中處理此類事件更有效率。因此，建議將此數值設為<b>大於1</b>。<br />設為0以禁用基於指令的任務分割。"],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.","請注意，空白事件實際上包含一個指令，您肯定希望在主執行緒而非工作執行緒中處理空白事件。您應將此數值設為大於1。"],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3","RPG Maker XP、VX、Ace、MV & MZ 解析器 V.3"],["Start translation from RPG Maker game using the latest parser.","使用最新解析器開始從RPG Maker遊戲翻譯。"],["Error!\r\nTranslator++ is unable to detect the type of ","錯誤！\r\nTranslator++無法檢測類型："],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.","您應更改路徑！\r\n開發目錄不應位於原始遊戲目錄內，因為這在後續注入遊戲時會導致問題。"],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","遊戲使用Enigma打包。\r\n您要解壓縮包嗎？\r\n這將花費數分鐘，取決於您的遊戲大小。"],["Unable to extract the Enigma package!","無法解壓縮Enigma包！"],["Copy & extract data into ","複製並提取數據至"]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?","執行此操作需要 RPGMakertrans CLI 閘道。\nRPGMakertrans CLI 閘道採用 GPL-3 授權，無法與程式一起分發。\n但 Translator++ 可以代您進行設置。\n\n您希望 Translator++ 為您安裝 RPGMakertrans CLI 閘道嗎？"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?","RPGMakertrans CLI 閘道需要更新。\n您希望 Translator++ 為您更新 RPGMakertrans CLI 閘道嗎？"],["Maximum dialog line","對話框最大行數"],["Maximum line in the dialog box. Default is 4.","對話框中的最大行數。預設為 4。"]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine.","從 SRPG Studio 引擎啟動翻譯專案。"],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..","解析器可以處理來自 <b>data.dts</b>（srpgs 檔案）的翻譯；以及由 SRPG Studio 在版本 1.253 引入的本地化工具生成的 <b>localization.dat</b> 檔案和本地化檔案（.json、.txt、.js）。"],["Create project","建立專案"],["Error: customField is not defined. This should not happen!","錯誤：customField 未定義。這不應該發生！"],["Please select the entry point to translate.","請選擇要翻譯的入口點。"],["There are currently two known locations of translatable text within the SRPG Studio game. <br />","目前已知在 SRPG Studio 遊戲中有兩個可翻譯文本的位置。<br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.","第一個是直接寫在 .srpgs 檔案中，第二個是在 localization.dat 檔案中。此解析器目前可以處理兩者。"],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.","<br />此外，您還可以翻譯由 SRPG Studio 本地化工具生成的本地化檔案。這些檔案格式為 JSON、TXT 和 JS。"]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.","解析 SRPG Studio 存檔和由 SRPG_Unpacker.exe 生成的翻譯轉儲 JSON。"],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.","從 SRPG Studio 的 data.dts、project.dat 或翻譯轉儲 JSON 開始翻譯。<br />這是最新的解析器——速度更快且更穩定——將取代先前版本。"],["Create Project","建立專案"],["Source mode","來源模式"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.","選擇 EXE 模式以從遊戲執行檔開始，存檔模式用於 data.dts / project.dat，或轉儲模式用於翻譯轉儲 JSON。"],["Select executable","選擇執行檔"],["Select the game executable. Translator++ will look for data.dts in the same folder.","選擇遊戲執行檔。Translator++ 將在同一資料夾中尋找 data.dts。"],["Select archive file","選擇歸檔文件"],["Select data.dts directly.","直接選擇 data.dts。"],["Select dump folder","選擇轉儲文件夾"],["Select the translation dump folder generated by SRPG_Unpacker.exe.","選擇由 SRPG_Unpacker.exe 生成的翻譯轉儲文件夾。"],["Filters","過濾器"],["Glob pattern used to select JSON files from the dump folder.","用於從轉儲文件夾中選擇 JSON 文件的全局模式。"],["ProjectTitle","項目標題"],["Your project title","您的項目標題"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>","Sugoi 翻譯器位置 <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"指向應用程序根目錄中的 .bat 文件或 .exe 文件。\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> 無效路徑。<br>在修復此問題之前，某些功能將被禁用。"],["Server Type :","伺服器類型："],["Installed Model :","已安裝模型："],["Install Sugoi Translator","安裝 Sugoi 翻譯器"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ","沒有 Sugoi 翻譯器？\n            立即安裝定制和優化的 Sugoi 翻譯器伺服器！\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>","要啟動的伺服器數量（CPU） <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"同時啟動的伺服器數量\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%","要同時啟動的伺服器數量。<br>更多進程不一定意味著更快的速度，請注意您的 RAM 和 CPU 容量。<br>如果僅運行一個伺服器時 CPU 使用率已達到 100%，您可能不會獲得任何好處。"],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ","\n                    您的 Sugoi 翻譯器不支持 GPU 處理。<br>\n                    您需要修補您的伺服器以支持 GPU 處理。<br>\n                    <h3 data-tran=\"\">選擇以下選項以安裝適合您系統的修補程式</h3>\n                    <div>\n                        <span data-tran=\"\">您的 GPU 是：</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">為 NVIDIA 30xx 系列或更高版本安裝修補程式</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">為 NVIDIA 20xx 系列或更低版本安裝修補程式</button>\n    \n                    </div>\n                "],["Select the following option to install the suitable patch for your system","選擇以下選項以安裝適合您系統的修補程式"],["Your GPU is:","您的 GPU 是："],["Install patch For NVIDIA series 30xx or greater","為 NVIDIA 30xx 系列或更高版本安裝修補程式"],["Install patch For NVIDIA series 20xx or lower","為 NVIDIA 20xx 系列或更低版本安裝修補程式"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>","要啟動的伺服器數量 (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"同時使用 GPU 啟動的伺服器數量。您的伺服器必須已修補以啟用 GPU 處理。\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.","您想在您的 <b>GPU</b> 上啟動多少個伺服器。可以同時運行基於 CPU 和 GPU 的服務。但請注意，如果您的 CPU 使用率高，可能會影響 GPU 性能。<br>您的伺服器必須已修補以啟用此模式。"],["Starting port number","起始埠號"],["The port numbers will be generated incrementaly starting from the value below","埠號將從以下值開始遞增生成"],["Keep console window open","保持控制台視窗開啟"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.","防止伺服器關閉時控制台視窗關閉。此選項有助於檢查導致伺服器崩潰的錯誤。"],["Action","操作"],["Set Sugoi Trans config based on this setting","基於此設定設置 Sugoi Trans 配置"],["Start All Server","啟動所有伺服器"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":22,"length":22,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder","選擇安裝資料夾"],["Where do you want to install the CT2 Sugoi Translator into?","您想將 CT2 Sugoi Translator 安裝到哪裡？"],["Cancel","取消"],["Install now!","立即安裝！"],["Path to the directory can not be empty!","目錄路徑不能為空！"],["Invalid directory:","無效的目錄："],["Failed to download file. Repository do not exist. Please see the console log for more information.","下載檔案失敗。儲存庫不存在。請查看控制台日誌以獲取更多資訊。"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series","您確定要更新您的伺服器嗎？\n此更新腳本適用於 NVIDIA 3XXX 系列"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier","您確定要更新您的伺服器嗎？\n此更新腳本適用於 NVIDIA 2XXX 系列及更早版本"],["Install CT2 Sugoi Translator","安裝 CT2 Sugoi Translator"],["Installation completed\nDo you want to set the Server Manager with this installed server?","安裝完成\n您要將此已安裝的伺服器設定為伺服器管理員嗎？"],["Sugoi Translator Installed","Sugoi Translator 已安裝"],["Server started\nPlease wait until the server(s) are ready before you translate things.","伺服器已啟動\n請等待伺服器準備就緒後再進行翻譯。"],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?","此操作將覆蓋 Sugoi Trans Addon 設定的當前值。\n您確定嗎？"],["Do you want to reset the current configuration?","您要重置當前配置嗎？"],["Configuration refreshed!","配置已刷新！"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter","行分隔符"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.","填入將由翻譯器跳過的字元或短語（原始短語和翻譯將始終相同）。這將確保翻譯文本的行數與原始文本的行數相同。\n目前沒有 Sugoi 能以 100% 成功率跳過的短語/字元。\n您可以嘗試使用 &#x3C;br&#x3E;，成功率尚可。\n若想將行合併為單一行，請留空。"],["Target URL(s)","目標網址"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.","翻譯器目標網址。您可以輸入一個或多個 Sugoi Translator 後端網址。Translator++ 將在所有服務實例間平衡請求負載。請用新行分隔每個條目。"],["Max Parallel job","最大平行作業數"],["Maximum parallel job that run simultaneously.","同時運行的最大平行作業數。"],["Send requests in batch","批次發送請求"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.","以陣列形式發送多個文本（由最大平行作業數決定）。\n更快且能顯著減少執行開銷。您必須從伺服器管理員運行伺服器才能啟用此選項。"],["Check First Line in Common Reference","檢查通用參考中的第一行"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.","如果第一行在通用參考中找到，則不將其包含在有效載荷中。\n這在角色名稱位於第一行時非常有用。"],["Check Last Line in Common Reference","檢查通用參考中的最後一行"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.","如果最後一行在通用參考中找到，則不將其包含在有效載荷中。\n這在角色名稱位於最後一行時非常有用。"],["Automatic splitting","自動分割"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.","自動將翻譯分割成與原始行數匹配的行數。每行的長度將大致相似。"],["Code Escaping Algorithm","程式碼跳脫演算法"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)","對話內嵌程式碼的跳脫演算法（尚未實作，請等待未來更新）"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary","載入角色參考作為詞彙表"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","若勾選，Translator++ 將載入角色參考作為詞彙表。這有助於翻譯者理解對話的上下文。角色參考是對話中角色的名稱。這將作為詞彙表載入給翻譯者。這會增加翻譯成本。"],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","僅存在於對話中的角色將為每個批次項目載入為詞彙表。使用模板指令在提示訊息中載入角色參考。"],["Actor Reference Translation Column","角色參考翻譯欄位"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","角色名稱翻譯的欄位。此欄位將用作角色參考的翻譯。這將提升對話中角色名稱翻譯的一致性。"],["Actor's Information Column","角色資訊欄位"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","包含角色附加資訊的欄位。您可以放入更多資訊，如性別、年齡等。這將改善對話中代詞的翻譯。"],["System Message Template","系統訊息模板"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","系統訊息是訊息的標頭，用於告知您的 chatGPT 助理的角色。此訊息將作為您發送給 chatGPT 的每個批次的第一條訊息發送。"],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","您可以使用 JavaScript 模板字面值風格包含以下變數 <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","變數：<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : 來源語言</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : 目標語言</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : 完整來源語言名稱</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : 完整目標語言名稱</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : 來源文字</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : 跳脫演算法的預定義訊息。</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : 代表換行的字串（換行替代）。</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT：批次中的訊息數量。</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO：新增角色的資訊。</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE：遊戲標題</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE：遊戲引擎</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[物件名稱]：從Translator++物件生成參考。<br />範例：<code>REFERENCE[通用參考]</code></li>"],["Body Message Template","主體訊息範本"],["Template of the body of your chat.","聊天主體的範本。"],["Sample conversation","範例對話"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","ChatGPT批次API允許您以非同步方式翻譯您的專案，成本降低50%，這意味著您將在<b style=\"color:red\">24小時內</b>收到翻譯結果，且成本僅為<b style=\"color:red\">正常的一半</b>。這對於不需要即時翻譯結果的大型專案特別有用。"],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .","<br />了解更多關於ChatGPT批次API：https://platform.openai.com/docs/guides/batch。"],["Glossary","詞彙表"],["<h2>Glossary</h2>","<h2>詞彙表</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>","<p>您可以選擇使用或不使用詞彙表。詞彙表將為每個批次項目加載，以提高翻譯品質。</p>"],["The Column of Actor's Additional Information","角色附加資訊欄位"],["Prompt Template","提示範本"],["<h2>1. System Message</h2>","<h2>1. 系統訊息</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>在這裡，您可以向助手解釋他們的角色是什麼。</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. 範例對話</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>現有對話的範例。您可以編寫良好或不良回應的範例，以幫助翻譯者理解您的目標和對話的上下文。</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. 您的實際提示</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>這是給助理的實際提示。</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>間接成本</h3>\n                        間接成本是您發送給助理的提示訊息中，不包含實際翻譯文本的成本。成本根據提示訊息中的令牌數量計算。令牌越多，成本越高。<br>\n                        <b>當前間接成本：</b> <span class=\"overheadCost\">0</span> 令牌 / 請求。"]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":40,"length":40,"percent":100},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?","TinyRPA 伺服器未安裝。您現在要安裝它嗎？"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization","自動有機翻譯記憶"],["If checked, all organic translation (manually inputted translation) will be memorized automatically.","如果勾選，所有有機翻譯（手動輸入的翻譯）將自動被記憶。"],["Memorize translation by automation script","通過自動化腳本記憶翻譯"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.","如果勾選，Translator++ 將記住從自動化腳本創建的翻譯。\n所有通過 'this.cells' 進行的更改將被記憶。但我們可以直接使用 trans API 修改網格的內容，這類更改不會觸發自動記憶。"],["Remind translation on cell translate","在單元格翻譯時提醒翻譯"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.","如果勾選，Translator++ 在對選定單元格執行自動翻譯前，將先從翻譯記憶中載入翻譯。"],["Default memorization behavior","預設記憶行為"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.","執行有機翻譯時覆蓋先前的記錄。如果未勾選，TM 將不會為現有記錄記憶新的翻譯。"],["MySQL host","MySQL 主機"],["The host name or IP address of your MySQL server","您的 MySQL 伺服器的主機名稱或 IP 地址"],["MySQL port","MySQL 端口"],["MySQL Port. Default is 3306.","MySQL 端口。預設為 3306。"],["MySQL user name","MySQL 使用者名稱"],["Username to access the DB.","存取資料庫的使用者名稱。"],["MySQL password","MySQL 密碼"],["Password to access the DB.","存取資料庫的密碼。"],["Database Name","資料庫名稱"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.","資料庫名稱。Translator++ 會嘗試在不存在時建立資料庫，但成功與否取決於所提供憑證的權限。"],["Database Type","資料庫類型"],["Automatically memorize manually inputted translations?","自動記憶手動輸入的翻譯嗎？"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","抱歉，此附加元件僅供活躍贊助者使用。\n您可以透過成為 $1 贊助者來解鎖此功能。"],["Automatically memorize translation made by automation scripts?","自動記憶由自動化腳本所做的翻譯嗎？"],["Remind translations when performing translate selection?","執行翻譯選擇時提醒翻譯嗎？"],["Use rememorize in organic translation","在有機翻譯中使用重新記憶"],["default","預設"],["Indexed DB (experimental)","索引化資料庫（實驗性）"],["MySQL","MySQL"],["Database Setting","資料庫設定"],["IndexedDB","IndexedDB"],["Generate","生成"],["Escaping algorithm for inline code inside dialogues","對話中內嵌代碼的轉義演算法"],["Test connection","測試連線"],["Connection success!","連線成功！"],["MySql","MySQL"],["Connection failed!\nError:","連線失敗！\n錯誤："],["Install MySQL Server","安裝 MySQL 伺服器"],["How to setup MySQL Server","如何設定 MySQL 伺服器"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?","檢測到一個關鍵句子有多個翻譯。\n只有最後找到的翻譯會被翻譯記憶庫記住。\n您要繼續嗎？"],["Your database structure need to be updated.","您的資料庫結構需要更新。"],["Upgrade database","升級資料庫"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?","此操作將升級您的資料庫。\n您要升級翻譯記憶庫資料庫嗎？"],["The translation memory database has been upgraded!\nPlease restart Translator++!","翻譯記憶庫資料庫已升級！\n請重新啟動 Translator++！"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":42,"length":42,"percent":100},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory","記憶"],["Fix the problem!","修復問題！"],["No exact matches found!","未找到完全匹配！"],["Original","原文"],["Translation","翻譯"],["Do you want Translator++ to forget the selected cell(s)?","您要 Translator++ 忘記選中的儲存格嗎？"],["Auto recall","自動回憶"],["Auto memorize organic translation","自動記憶有機翻譯"],["Auto memorize automation","自動記憶自動化"],["Use rememorize in organic translation","在有機翻譯中使用重新記憶"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["tid/2391/type/StringLiteral"],["tid/2543/type/StringLiteral"],["tid/2686/type/StringLiteral"],["tid/2838/type/StringLiteral"]],"basename":"tmUI.js","dirname":"/addons/tm","extension":".js","filename":"tmUI.js","path":"/addons/tm/tmUI.js","indexIsBuilt":false,"indexIds":{"Memory":0,"Fix the problem!":1,"No exact matches found!":2,"Original":3,"Translation":4,"Do you want Translator++ to forget the selected cell(s)?":5,"Auto recall":6,"Auto memorize organic translation":7,"Auto memorize automation":8,"Use rememorize in organic translation":9},"tags":[],"relPath":"/addons/tm/tmUI.js","originalFormat":"Autogenerated TRANS obj","type":"","prog