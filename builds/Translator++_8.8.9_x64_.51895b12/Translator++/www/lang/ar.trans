sheets":75,"RMTrans Patch":76,"Inject Translation":77,"Revert to original":78,"Clear translation":79,"Delete files":80,"Properties":81,"Select progress greater than":82,"Please input a number":83,"Do you want to clear translation?":84,"Add comment":85,"Remove comment":86,"added to reference table!":87,"Can not modify Column 0":88,"Unable to delete table : ":89,"Can not remove key column!":90,"Please open or create a project first":91,"Column name can not be empty!":92,"Invalid column index!":93,"Please open or create a new project first!":94,"You should not edit key value":95,"Ilegal value":96,"That value already exist!":97,"The maximum number of columns for this project has been reached, so you cannot add any more.":98,"Are you sure want to abort this process?":99,"Process paused!\nPress OK to continue!":100,"Unable to process, project not found":101,"Unable to process, data not found":102,"Translation engine not found":103,"Translation engine ":104," is disabled!":105,"Selected files :":106,"Collecting data from :":107,"Translation finished":108,"applying translation to table!":109,"Error when translating data!":110,"\tHTTP Status : ":111,"\tError Type : ":112,"You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n":113,"Running trans.translateAll":114,"Start collecting data!":115,"Data collection is done!":116,"nothing is selected":117,"no translator loaded":118,"unable to load translator window":119,"Reference path cannot empty!":120,"Collecting translation refference":121,"Applying translation!":122,"Importing translation":123,"Parsing data":124," is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions":125,"Keyword too short!":126,"Delete comment":127,"Translate here":128,"Translate here using ":129,"Translate using...":130,"Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?":131," cell(s) has been written!":132,"Column width":133,"Width must greater than 0":134,"Insert column right":135,"Duplicate column":136,"Remove this column":137,"Remove selected column?\nThis can not be undone!":138,"Rename this column":139,"Please enter new name":140,"Tags":141,"Red":142,"Yellow":143,"Green":144,"Blue":145,"Gold":146,"More tags...":147,"Clear tags":148,"Delete Row":149,"Do you want to remove the currently selected row(s)?":150,"Clear Context Translation":151,"Clear Automation":152,"Are you sure want to clear all quick launch scripts?":153,"Append rows to reference":154,"Row properties":155},"tags":[],"relPath":"/js/trans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":156,"length":156,"percent":100},"parameters":[]},"/js/ui.js":{"data":[["`You cannot close the application at this moment, reason: \\n${","لا يمكنك إغلاق التطبيق في هذه اللحظة، السبب: \\n${"],["}`","}`"],["Do you really want to exit Translator++?\nAll unsaved changes will be discarded!","هل تريد حقًا الخروج من Translator++؟\nسيتم فقدان جميع التغييرات غير المحفوظة!"],["Trans file","ملف الترجمة"],["Translator++ Project Package (TPP) file","حزمة مشروع Translator++ (TPP)"],["Select all","تحديد الكل"],["Select none","عدم تحديد أي شيء"],["Invert","عكس"],["Match destination selection","مطابقة اختيار الوجهة"],["use mouse drag to do bulk selection","استخدم سحب الماوس للاختيار الجماعي"],["Invalid trans data","بيانات ترجمة غير صالحة"],["Inject / Apply translation","حقن / تطبيق الترجمة"],["Inject / Apply translation to all","حقن / تطبيق الترجمة على الكل"],["Cancel","إلغاء"],["Apply Translation","تطبيق الترجمة"],["Target path cannot be a parent or child of the source material's path.\nPlease select another path.","لا يمكن أن يكون المسار الهدف أصلًا أو فرعًا لمسار المادة المصدر.\nيرجى اختيار مسار آخر."],["Help","مساعدة"],["Import","استيراد"],["Revert to origin data","الرجوع إلى البيانات الأصلية"],["Select target directory.","اختر الدليل الهدف."],["The existing files will be overwritten!","سيتم الكتابة فوق الملفات الموجودة!"],["Process","معالجة"],["Path to the directory can not be empty!","مسار المجلد لا يمكن أن يكون فارغًا!"],["Invalid directory:","مجلد غير صالح:"],["Rebuild translation table from this cache","إعادة بناء جدول الترجمة من هذا المخبأ"],["Create new project","إنشاء مشروع جديد"],["-nothing-","-لا شيء-"],["Ok","موافق"],["No action selected, are you sure?","لم يتم تحديد أي إجراء، هل أنت متأكد؟"],["No context's keyword specified!","لم يتم تحديد كلمة مفتاحية للسياق!"],["Remove context containing keyword :\n","إزالة السياق الذي يحتوي على الكلمة المفتاحية:\n"],["\nfrom selected files?","\nمن الملفات المحددة؟"],["Remove every rows except rows that has a context containing keyword :\n","إزالة كل الصفوف باستثناء الصفوف التي تحتوي على سياق يحتوي على الكلمة المفتاحية:\n"],["items","عناصر"],["Select Context","اختيار السياق"],["Manual Query","استعلام يدوي"],["Tag filter","تصفية العلامات"],["Merging option","خيار الدمج"],["Source Column","عمود المصدر"],["Target Column","عمود الهدف"],["Maximum length","الطول الأقصى"],["Query","استعلام"],["Select how you want to filter the rows to be wrapped based on their context.","اختر كيف تريد تصفية الصفوف ليتم لفها بناءً على سياقها."],["Your list of context separated by new line","قائمة السياقات الخاصة بك مفصولة بأسطر جديدة"],["Optionally filter rows by their color tags.","قم بتصفية الصفوف اختياريًا باستخدام علامات الألوان الخاصة بها."],["Options","خيارات"],["No merging","لا دمج"],["Merge lines","دمج الأسطر"],["Merge lines except first line","دمج الأسطر باستثناء السطر الأول"],["General setup","الإعدادات العامة"],["Wrap text","لف النص"],["Source & target column can not be same!","لا يمكن أن يكون عمود المصدر والهدف متماثلين!"],["No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?","لم يتم تحديد أي ملفات في لوحة محدد الملفات.\nسيفترض Translator++ أن جميع الملفات ستتم معالجتها\nهل أنت متأكد من ذلك؟"],["One or more required options are not set for ","لم يتم تعيين واحد أو أكثر من الخيارات المطلوبة لـ "],["One or more settings required by the translator engine are not set. If you continue, the translation process may fail.","لم يتم تعيين واحد أو أكثر من الإعدادات المطلوبة بواسطة محرك الترجمة. إذا تابعت، قد تفشل عملية الترجمة."],["Required options :","الخيارات المطلوبة:"],["Open the settings","افتح الإعدادات"],["Continue anyway","تابع على أي حال"],["Translate Now","ترجم الآن"],["Please select translator engine","الرجاء اختيار محرك الترجمة"],["Can not process your request because the source column and target column are same!","لا يمكن معالجة طلبك لأن عمود المصدر والهدف متماثلان!"],["Tags","العلامات"],["Merge Option","خيار الدمج"],["Add rows","إضافة صفوف"],["None","لا شيء"],["Merge","دمج"],["Merge except the first line","دمج باستثناء السطر الأول"],["No export path specified","لم يتم تحديد مسار التصدير"],["Export path can not be inside or the same with the project folder.\nYour export path: ","لا يمكن أن يكون مسار التصدير داخل أو نفس مجلد المشروع.\nمسار التصدير الخاص بك: "],["\nYour project path: ","\nمسار المشروع الخاص بك: "],["\n\nPlease choose another folder!","\n\nيرجى اختيار مجلد آخر!"],["Export Now","تصدير الآن"],["Action","الإجراء"],["Append tags","إضافة علامات"],["Remove tags","إزالة العلامات"],["Set tags","تعيين العلامات"],["Do nothing","لا تفعل شيئًا"],["-unknown title-","-عنوان غير معروف-"],["Can not open file. File not exist.","لا يمكن فتح الملف. الملف غير موجود."],["Go to online documentation.","اذهب إلى الوثائق عبر الإنترنت."],["No projects yet","لا توجد مشاريع بعد"],["Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t","هل أنت جديد على Translator++؟<br />\n\t\t\tيرجى قراءة وثائقنا عبر الإنترنت على <b>dreamsavior.net</b>.<br />\n\t\t\tاضغط على <b>F1</b> لفتح المساعدة عبر الإنترنت.<br />\n\t\t\tتواصل معي على <b>patreon.com/dreamsavior</b> للأسئلة وتقارير الأخطاء.\n\t\t\t"],["Warning","تحذير"],["Close","إغلاق"],["You are about to run a user script!","أنت على وشك تشغيل سكريبت مستخدم!"],["Execute the script","تنفيذ السكريبت"],["Bring to main screen","إحضار إلى الشاشة الرئيسية"],["Show row header info","عرض معلومات رأس الصف"],["Row header width","عرض رأس الصف"],["Display marker on organic cells","عرض علامة على الخلايا العضوية"],["Leave trail on cell visit","ترك أثر عند زيارة الخلية"],["Display trails on visited cells","عرض الآثار على الخلايا التي تمت زيارتها"],["Row Properties","خصائص الصف"],["Project Properties","خصائص المشروع"],["Project Properties : ","خصائص المشروع: "],["Stage path do not exist!","مسار المرحلة غير موجود!"],["Select dev folder","اختر مجلد التطوير"],["Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.","أين يقع دليل اللعبة المترجمة؟<br />هذا هو نفس المجلد مع دليل الوجهة عند حقن لعبتك."],["Select folder","اختر مجلد"],["Submit","إرسال"],["File Properties","خصائص الملف"],["File Properties : ","خصائص الملف:"],["Target column","العمود المستهدف"],["Trim Whitespaces","قص المسافات البيضاء"],["Please select a column","يرجى اختيار عمود"],["Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!","هل أنت متأكد من رغبتك في قص المسافات البيضاء في العمود المحدد؟\nلا يمكن التراجع عن هذا الإجراء!"],["Are you sure want commit autopadding on selected column?\nThis action can not be undone!","هل أنت متأكد من رغبتك في تنفيذ الحشو التلقائي في العمود المحدد؟\nلا يمكن التراجع عن هذا الإجراء!"],["Markers","علامات"],["Markers are visual guidelines for the number of characters in a line.","العلامات هي إرشادات مرئية لعدد الأحرف في السطر."],["The marker will only be visible if wordwrap in the text area is disabled.","ستكون العلامة مرئية فقط إذا تم تعطيل التفاف النص في منطقة النص."],["Add","إضافة"],["Clear all","مسح الكل"],["Enable suggestion","تمكين الاقتراح"],["Speech Synthesizer","مُركِّب الكلام"],["Reading speed:","سرعة القراءة:"],["Pitch:","النبرة:"],["Volume:","الصوت:"],["Mark at","وضع علامة عند"],["Units","وحدات"],["Half width character (ie. Alphabet, etc)","حرف نصف العرض (مثل الأبجدية، إلخ)"],["Full width character (ie. Hiragana, Kanji, 漢字, etc)","حرف كامل العرض (مثل الهيراغانا، الكانجي، 漢字، إلخ)"],["Color","لون"],["Remove","إزالة"],["Current Cell's Editor Options","خيارات محرر الخلية الحالية"],["Auto Padding","حشو تلقائي"],["Create","إنشاء"],["Unable to open that file!","غير قادر على فتح هذا الملف!"],["Are you sure want to close the project?\nYou will lost any unsaved changes!","هل أنت متأكد من رغبتك في إغلاق المشروع؟\nستفقد أي تغييرات غير محفوظة!"],["Are you sure want to exit Translator++?\nYou will lost any unsaved changes!","هل أنت متأكد من رغبتك في الخروج من Translator++؟\nستفقد أي تغييرات غير محفوظة!"],["Do not show this message again!","لا تعرض هذه الرسالة مرة أخرى!"],["Back","رجوع"],["Are you sure want to execute the following script?","هل أنت متأكد من رغبتك في تنفيذ السكريبت التالي؟"],["No script found","لم يتم العثور على سكريبت"],["Open Script Editor","فتح محرر السكريبت"],["How to add Automation here","كيفية إضافة الأتمتة هنا"],["Clear Quick Launch","مسح الإطلاق السريع"],["Are you sure want to clear all quick launch scripts?","هل أنت متأكد من رغبتك في مسح جميع سكريبتات الإطلاق السريع؟"],["Remove selected objects?","إزالة الكائنات المحددة؟"],["Do you wish to remove related staging files too?\nWarning: This is can not be undone!","هل ترغب في إزالة ملفات التجهيز المرتبطة أيضًا؟\nتحذير: لا يمكن التراجع عن هذا!"],["Error!\r\nTranslator++ is unable to detect the type of ","خطأ!\r\nTranslator++ غير قادر على اكتشاف نوع "],["`Required application to parse ${","`التطبيق المطلوب لتحليل ${"],["} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`","} غير مثبت.\\nيرجى تثبيته من خلال مثبت التطبيقات الخارجية.\\nهل تريد فتح نافذة مثبت التطبيقات الخارجية؟`"],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","اللعبة مضغوطة باستخدام Enigma.\r\nهل تريد استخراج الحزمة؟\r\nسيستغرق هذا دقائق، اعتمادًا على حجم لعبتك."],["Copy & extract data into ","نسخ واستخراج البيانات إلى "],["Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!","هل أنت متأكد حقًا من حذف جميع الترجمات في الصفحة الحالية؟\nتحذير: هذا إجراء لا يمكن التراجع عنه!"],["Are you realy sure want to delete current file?\nWarning: this is irreversible action!","هل أنت متأكد حقًا من حذف الملف الحالي؟\nتحذير: هذا إجراء لا يمكن التراجع عنه!"],["Please enter the title","يرجى إدخال العنوان"],["Do you want to remove the currently selected row(s)?","هل تريد إزالة الصف(وف) المحدد(ة) حاليًا؟"]],"context":[["tid/154/type/TemplateHead"],["tid/158/type/TemplateTail"],["tid/202/type/StringLiteral"],["tid/1201/type/StringLiteral"],["tid/1261/type/StringLiteral"],["tid/4827/type/StringLiteral"],["tid/4834/type/StringLiteral"],["tid/4841/type/StringLiteral"],["tid/4848/type/StringLiteral"],["tid/4855/type/StringLiteral"],["tid/8249/type/StringLiteral"],["tid/8829/type/StringLiteral"],["tid/8861/type/StringLiteral"],["tid/9513/type/StringLiteral","tid/10983/type/StringLiteral","tid/11779/type/StringLiteral","tid/12739/type/StringLiteral","tid/13697/type/StringLiteral","tid/17723/type/StringLiteral","tid/20089/type/StringLiteral","tid/21021/type/StringLiteral","tid/23071/type/StringLiteral","tid/23751/type/StringLiteral","tid/36680/type/StringLiteral","tid/38040/type/StringLiteral","tid/38571/type/StringLiteral","tid/43926/type/StringLiteral","tid/44634/type/StringLiteral","tid/59585/type/StringLiteral","tid/60083/type/StringLiteral","tid/60416/type/StringLiteral"],["t