:[["Actions","الإجراءات"],["Build for 32bit system","بناء لنظام 32 بت"],["Build for non developer build too","بناء للإصدار غير المطور أيضًا"],["Custom Version","إصدار مخصص"],["Custom version (leave blank to autogenerate version)","إصدار مخصص (اتركه فارغًا لتوليد الإصدار تلقائيًا)"],["Generate minor versioning?","توليد إصدارات ثانوية؟"],["Save patch to","حفظ التصحيح إلى"],["Destination folder of generated patch","مجلد الوجهة للتصحيح المُنشأ"],["Overider template","قالب التجاوز"],["Release template","قالب الإصدار"],["Select file to be available live and excluded from the package","حدد الملف ليكون متاحًا مباشرة ومستثنى من الحزمة"],["The file will be excluded from package, but available online","سيتم استبعاد الملف من الحزمة، ولكنه متاح عبر الإنترنت"],["Make the process does not require user input","جعل العملية لا تتطلب إدخالًا من المستخدم"],["Patch Type","نوع التصحيح"],["The file will be excluded from package, but available online. Select the file you want to substitute.","سيتم استبعاد الملف من الحزمة، ولكنه متاح عبر الإنترنت. حدد الملف الذي تريد استبداله."],["Substitute trans.js with a fake one.","استبدل trans.js بواحد مزيف."],["Select Patch File","حدد ملف التصحيح"],["Select the generated patch file (*.tpch).","حدد ملف التصحيح المُنشأ (*.tpch)."],["Patches Links","روابط التصحيحات"],["Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.","سيقوم التحديث التلقائي بالتنزيل من هذه الروابط. <b>يجب أن يكون رابط تنزيل مباشر!</b> افصل كل رابط تنزيل بسطر جديد."],["Download Links","روابط التنزيل"],["Downloadable package for manual download. Separate each download link with newline.","حزمة قابلة للتنزيل للتنزيل اليدوي. افصل كل رابط تنزيل بسطر جديد."],["Release Category","فئة الإصدار"],["Category of the release.","فئة الإصدار."],["Upload log along with this submission.","رفع السجل مع هذا التقديم."],["Remove the same version found on database.","إزالة النسخة نفسها الموجودة في قاعدة البيانات."],["Whether this release is enabled or not.","ما إذا كان هذا الإصدار مفعلاً أم لا."],["Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.","ما إذا كان هذا الإصدار مخفيًا أم لا. إذا كان الإصدار مخفيًا، فقط المسؤولون والأعضاء الذين لديهم قدرة <code>view_hidden_releases</code> (المطور) يمكنهم تثبيت الإصدار عبر مثبت الحزم."],["Release Name","اسم الإصدار"],["Release Number","رقم الإصدار"],["Release Date","تاريخ الإصدار"],["Release Key","مفتاح الإصدار"],["Release Type","نوع الإصدار"],["CRC","CRC"],["Required Version","النسخة المطلوبة"],["Minimum Version","الحد الأدنى للنسخة"],["Release Note","ملاحظات الإصدار"],["Release Info","معلومات الإصدار"],["On Before Install","قبل التثبيت"],["On After Install","بعد التثبيت"],["Extra parameters","معلمات إضافية"],["Remote file","ملف بعيد"],["List of remote file, separate by new line","قائمة الملفات البعيدة، مفصولة بأسطر جديدة"],["Patron Level","مستوى الراعي"],["Post title","عنوان المنشور"],["Release post","نشر الإصدار"],["Excerpt of the post","مقتطف من المنشور"]],"context":[["idx/0/innerText","idx/14/innerText","idx/29/innerText","idx/79/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/16/innerText"],["idx/5/innerText","idx/17/innerText"],["idx/6/innerText","idx/18/innerText"],["idx/7/innerText","idx/19/innerText"],["idx/8/innerText","idx/20/innerText"],["idx/9/innerText","idx/21/innerText"],["idx/10/innerText","idx/22/innerText"],["idx/11/innerText","idx/25/innerText"],["idx/12/innerText"],["idx/13/innerText","idx/28/innerText"],["idx/23/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/45/innerText"],["idx/47/innerText"],["idx/49/innerText"],["idx/51/innerText"],["idx/53/innerText"],["idx/55/innerText"],["idx/57/innerText"],["idx/59/innerText"],["idx/61/innerText"],["idx/63/innerText"],["idx/65/innerText"],["idx/67/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/73/innerText"],["idx/75/innerText"],["idx/77/innerText"]],"basename":"!post.html","dirname":"/addons/adminTools","extension":".html","filename":"!post.html","path":"/addons/adminTools/!post.html","indexIsBuilt":false,"indexIds":{"Actions":0,"":1,"Build for 32bit system":2,"Build for non developer build too":3,"Custom Version":4,"Custom version (leave blank to autogenerate version)":5,"Generate minor versioning?":6,"Save patch to":7,"Destination folder of generated patch":8,"Overider template":9,"Release template":10,"Select file to be available live and excluded from the package":11,"The file will be excluded from package, but available online":12,"Make the process does not require user input":13,"Patch Type":14,"The file will be excluded from package, but available online. Select the file you want to substitute.":15,"Substitute trans.js with a fake one.":16,"Select Patch File":17,"Select the generated patch file (*.tpch).":18,"Patches Links":19,"Autoupdate will download from these links. <b>Must be direct download!</b> Separate each download link with newline.":20,"Download Links":21,"Downloadable package for manual download. Separate each download link with newline.":22,"Release Category":23,"Category of the release.":24,"Upload log along with this submission.":25,"Remove the same version found on database.":26,"Whether this release is enabled or not.":27,"Whether this release is hidden or not. If a release is hidden. Only Administrators and member with <code>view_hidden_releases</code> (Developer) capability can install the release via package installer.":28,"Release Name":29,"Release Number":30,"Release Date":31,"Release Key":32,"Release Type":33,"CRC":34,"Required Version":35,"Minimum Version":36,"Release Note":37,"Release Info":38,"On Before Install":39,"On After Install":40,"Extra parameters":41,"Remote file":42,"List of remote file, separate by new line":43,"Patron Level":44,"Post title":45,"Release post":46,"Excerpt of the post":47},"tags":[],"relPath":"/addons/adminTools/!post.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":47,"length":47,"percent":100},"parameters":[]},"/addons/adminTools/!postPackage.html":{"data":[["Select package json file","اختر ملف json للحزمة"],["Select the generated patch file","اختر ملف التصحيح المُنشأ"],["Or Select Destination File","أو اختر ملف الوجهة"],["Or Download location","أو موقع التنزيل"],["Icon","الأيقونة"],["Author","المؤلف"],["Name","الاسم"],["name of the package.","اسم الحزمة."],["Title","العنوان"],["Title of the package.","عنوان الحزمة."],["Version","الإصدار"],["Version of the package.","إصدار الحزمة."],["Description","الوصف"],["Description of the package.","وصف الحزمة."],["Whether this release is active or not.","ما إذا كان هذا الإصدار نشطًا أم لا."],["Whether this release is hidden or not.","ما إذا كان هذا الإصدار مخفيًا أم لا."],["Patron Level","مستوى الراعي"],["Current month's pledge in $","التعهد الشهري الحالي بالدولار"],["Patron Points","نقاط الراعي"],["100pts = 1$","100 نقطة = 1 دولار"],["Purchase type","نوع الشراء"],["Type of the purchase.","نوع الشراء."],["On Before Install","قبل التثبيت"],["Javascript code to be run before install","كود جافا سكريبت ليتم تشغيله قبل التثبيت"],["On After Install","بعد التثبيت"],["Javascript code to be run after install","كود جافا سكريبت ليتم تشغيله بعد التثبيت"],["Manifest","البيان"],["Manifest data","بيانات البيان"],["Minimum version","الحد الأدنى للإصدار"],["Minimum version of Translator++ to be able to insatall this addon.","الحد الأدنى لإصدار Translator++ المطلوب لتثبيت هذا الإضافة."],["Release Date","تاريخ الإصدار"],["Is parser changed?","هل تم تغيير المحلل؟"],["Mark as parser change. Would warn the user to backup their project before updating to this addon.","وضع علامة كتغيير في المحلل. سيتم تحذير المستخدم لعمل نسخة احتياطية لمشروعه قبل التحديث إلى هذه الإضافة."],["Remove the same version found on database.","إزالة نفس الإصدار الموجود في قاعدة البيانات."],["Excluded files","الملفات المستثناة"],["Files listed here will be excluded from the distribution packages","الملفات المدرجة هنا سيتم استبعادها من حزم التوزيع"],["Script URL","رابط النص البرمجي"],["Script of the URL.","النص البرمجي للرابط."],["Upload script","تحميل السكريبت"],["This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t","سيتم تحميل هذا السكريبت إلى الخلفية ومعالجته باستخدام قالب سكريبت [php]Scripts.\n\t\t\t\t\tلاستخدام هذه الميزة:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>أنشئ صفحة ووردبريس باستخدام قالب <b>[php]Scripts</b>.<br>يمكنك أيضًا تعيين متطلبات باتريون لعرض المنشور.</li>\n\t\t\t\t\t\t<li>أضف رابط الصفحة إلى ملف package.json باستخدام معلمة <b>l</b> GET تشير إلى الملف المحلي.<br>\n\t\t\t\t\t\tعلى سبيل المثال: <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t"],["Actions","الإجراءات"]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/3/innerText"],["idx/2/innerText"],["idx/4/innerText"],["idx/6/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/47/innerText"]],"basename":"!postPackage.html","dirname":"/addons/adminTools","extension":".html","filename":"!postPackage.html","path":"/addons/adminTools/!postPackage.html","indexIsBuilt":false,"indexIds":{"Select package json file":0,"Select the generated patch file":1,"Or Select Destination File":2,"Or Download location":3,"":4,"Icon":5,"Author":6,"Name":7,"name of the package.":8,"Title":9,"Title of the package.":10,"Version":11,"Version of the package.":12,"Description":13,"Description of the package.":14,"Whether this release is active or not.":15,"Whether this release is hidden or not.":16,"Patron Level":17,"Current month's pledge in $":18,"Patron Points":19,"100pts = 1$":20,"Purchase type":21,"Type of the purchase.":22,"On Before Install":23,"Javascript code to be run before install":24,"On After Install":25,"Javascript code to be run after install":26,"Manifest":27,"Manifest data":28,"Minimum version":29,"Minimum version of Translator++ to be able to insatall this addon.":30,"Release Date":31,"Is parser changed?":32,"Mark as parser change. Would warn the user to backup their project before updating to this addon.":33,"Remove the same version found on database.":34,"Excluded files":35,"Files listed here will be excluded from the distribution packages":36,"Script URL":37,"Script of the URL.":38,"Upload script":39,"This script will be uploaded to the back-end and will be processed with [php]Scripts template script.\n\t\t\t\t\tTo use this feature:\n\t\t\t\t\t<ol>\n\t\t\t\t\t\t<li>Create a wordpress page with <b>[php]Scripts template</b> template.<br>You can also set the patreon's requirement to view the post.</li>\n\t\t\t\t\t\t<li>Add the url to the page into the package.json file with <b>l</b> GET parameter point to the local file.<br>\n\t\t\t\t\t\tFor example : <u>https://dreamsavior.net/script/translation-proxy/?l=/sub.js</u>\n\t\t\t\t\t\t</li>\n\t\t\t\t\t</ol>\n\t\t\t\t":40,"Actions":41},"tags":[],"relPath":"/addons/adminTools/!postPackage.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":41,"length":41,"percent":100},"parameters":[]},"/addons/adminTools/adminTools.js":{"data":[["Close","إغلاق"]],"context":[["tid/588/type/StringLiteral"]],"basename":"adminTools.js","dirname":"/addons/adminTools","extension":".js","filename":"adminTools.js","path":"/addons/adminTools/adminTools.js","indexIsBuilt":false,"indexIds":{"Close":0},"tags":[],"relPath":"/addons/adminTools/adminTools.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/aec/aec.js":{"data":[["Universal Archive Unpacker","فك الأرشيف العالمي"]],"context":[["tid/1001/type/StringLiteral","tid/1239/type/StringLiteral"]],"basename":"aec.js","dirname":"/addons/aec","extension":".js","filename":"aec.js","path":"/addons/aec/aec.js","indexIsBuilt":false,"indexIds":{"Universal Archive Unpacker":0},"tags":[],"relPath":"/addons/aec/aec.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/bakinParser/bakin-proxy.js":{"data":[["Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.","استخراج قاموس لعبة باكين من data.rbpack، ترجمة dic.txt، وتصحيح اللاعب تلقائيًا."],["Create project","إنشاء مشروع"],["Error: customField is not defined. This should not happen!","خطأ: customField غير معرف. هذا لا ينبغي أن يحدث!"],["Please select the Bakin game executable.","يرجى اختيار ملف تنفيذ لعبة باكين."],["<h2>Proxy workflow</h2>","<h2>سير عمل الوكيل</h2>"],["Translator++ unpacks data.rbpack into a temporary folder.","يقوم Translator++ بفك data.rbpack إلى مجلد مؤقت."],["Split Dictionary uses dump-split and creates one .txt file per source area by default.","يقوم Split Dictionary باستخدام dump-split وإنشاء ملف .txt واحد لكل منطقة مصدر افتراضيًا."],["Merge Dictionary uses a single dic.txt.","يستخدم Merge Dictionary ملف dic.txt واحدًا."],["Injection merges split dictionaries back into data/dic.txt and patches the player executable.","يقوم Injection بدمج القواميس المقسمة مرة أخرى في data/dic.txt وتصحيح ملف تنفيذ اللاعب."],["Split Dictionary (default)","Split Dictionary (افتراضي)"],["Merge Dictionary","Merge Dictionary"]],"context":[["tid/2860/type/StringLiteral"],["tid/2929/type/StringLiteral"],["tid/2966/type/StringLiteral"],["tid/3002/type/StringLiteral"],["tid/3253/type/NoSubstitutionTemplate"],["tid/3266/type/StringLiteral"],["tid/3277/type/StringLiteral"],["tid/3288/type/StringLiteral"],["tid/3299/type/StringLiteral"],["tid/3383/type/StringLiteral"],["tid/3393/type/StringLiteral"]],"basename":"bakin-proxy.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-proxy.js","path":"/addons/bakinParser/bakin-proxy.js","indexIsBuilt":false,"indexIds":{"Extract a Bakin game dictionary from data.rbpack, translate dic.txt, and patch the player automatically.":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the Bakin game executable.":3,"<h2>Proxy workflow</h2>":4,"Translator++ unpacks data.rbpack into a temporary folder.":5,"Split Dictionary uses dump-split and creates one .txt file per source area by default.":6,"Merge Dictionary uses a single dic.txt.":7,"Injection merges split dictionaries back into data/dic.txt and patches the player executable.":8,"Split Dictionary (default)":9,"Merge Dictionary":10},"tags":[],"relPath":"/addons/bakinParser/bakin-proxy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":11,"length":11,"percent":100},"parameters":[]},"/addons/bakinParser/bakin-xlsx.js":{"data":[["Start a translation project from RPG Developer Bakin localization sheet (xlsx).","ابدأ مشروع ترجمة من ورقة توطين RPG Developer Bakin (xlsx)."],["Create project","إنشاء مشروع"],["Error: customField is not defined. This should not happen!","خطأ: customField غير معرف. هذا لا ينبغي أن يحدث!"],["Please select the entry point to translate.","يرجى اختيار نقطة الدخول للترجمة."],["<h2>RPG Developer Bakin editor is required</h2>","<h2>محرر RPG Developer Bakin مطلوب</h2>"],["RPG Developer Bakin editor is required to start the translation project.","محرر RPG Developer Bakin مطلوب لبدء مشروع الترجمة."],["<h2>Before you start</h2>","<h2>قبل البدء</h2>"],["<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.","<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">فك حزمة لعبتك</a> إلى مشروع RPG Developer Bakin قابل للتحرير."],["Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.","قم بتصدير سلاسل الترجمة باستخدام تطبيق RPG Developer Bakin إلى ملف xlsx. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">شاهد الدليل هنا حول كيفية ترجمة لعبة Bakin</a>."]],"context":[["tid/614/type/StringLiteral"],["tid/683/type/StringLiteral"],["tid/720/type/StringLiteral"],["tid/756/type/StringLiteral"],["tid/1034/type/NoSubstitutionTemplate"],["tid/1041/type/NoSubstitutionTemplate"],["tid/1064/type/NoSubstitutionTemplate"],["tid/1077/type/NoSubstitutionTemplate"],["tid/1088/type/NoSubstitutionTemplate"]],"basename":"bakin-xlsx.js","dirname":"/addons/bakinParser","extension":".js","filename":"bakin-xlsx.js","path":"/addons/bakinParser/bakin-xlsx.js","indexIsBuilt":false,"indexIds":{"Start a translation project from RPG Developer Bakin localization sheet (xlsx).":0,"Create project":1,"Error: customField is not defined. This should not happen!":2,"Please select the entry point to translate.":3,"<h2>RPG Developer Bakin editor is required</h2>":4,"RPG Developer Bakin editor is required to start the translation project.":5,"<h2>Before you start</h2>":6,"<a href=\"#\" onclick=\"addonLoader.addons.bakinParser.openDecompileForm()\">Unpack your game</a> into editable RPG Developer Bakin's project.":7,"Export the localization strings by using RPG Developer Bakin application into a xlsx file. <a href=\"https://dreamsavior.net/docs/rpg-developer-bakin/how-to-translate-rpg-developer-bakin/\" class=\"externalLink\" external=\"true\">See the guide here on how to translate Bakin game</a>.":8},"tags":[],"relPath":"/addons/bakinParser/bakin-xlsx.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/basicUtils.js":{"data":[["NWJS Version","إصدار NWJS"],["Change into this NWJS version","التغيير إلى إصدار NWJS هذا"],["Use Developer version","استخدم الإصدار المطور"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","استخدم إصدار NWJS المطور. يحتوي الإصدار المطور على أدوات مطور متاحة. مناسب للتصحيح والتطوير."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","في الإصدار المطور، يمكنك استخدام <b>وحدة تحكم المطور</b>. يمكن الوصول إلى وحدة تحكم المطور بالضغط على F12 أو النقر بزر الماوس الأيمن على التطبيق واختيار 'فحص'."],["Use 32-bit version","استخدم الإصدار 32 بت"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","استخدم إصدار NWJS 32 بت. الإصدار 32 بت مفيد للتشغيل مع الأنظمة القديمة. يُنصح بإلغاء تحديد هذا الخيار إذا أمكن (فقط قم بترقية جهازك، يا صديقي)."],["Some Translator++ feature may not work across NWJS version","قد لا تعمل بعض ميزات Translator++ عبر إصدارات NWJS"],["Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.","يرجى العلم أن بعض ميزات Translator++ قد لا تعمل عبر إصدارات NWJS. تأكد من اختبار مشروعك بعد تغيير إصدار NWJS."],["You're currently running on NWJS ver.","أنت تعمل حاليًا على إصدار NWJS."],["Change Translator++ Core NWJS version","تغيير إصدار NWJS الأساسي لـ Translator++"],["You're already using the selected NWJS version.","أنت تستخدم بالفعل إصدار NWJS المحدد."],["This operation will close Translator++ and change the current NW.js version into","ستغلق هذه العملية Translator++ وتغير إصدار NW.js الحالي إلى"],["If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?","إذا كان لديك أي تغييرات غير محفوظة، يرجى اختيار 'إلغاء' وحفظ مشروعك أولاً.\nهل تريد المتابعة؟"]],"context":[["tid/1342/type/StringLiteral"],["tid/1352/type/StringLiteral"],["tid/1428/type/StringLiteral","tid/1617/type/StringLiteral"],["tid/1438/type/StringLiteral"],["tid/1449/type/StringLiteral"],["tid/1482/type/StringLiteral","tid/1641/type/StringLiteral"],["tid/1492/type/StringLiteral"],["tid/1532/type/NoSubstitutionTemplate"],["tid/1537/type/NoSubstitutionTemplate"],["tid/1542/type/StringLiteral"],["tid/1669/type/NoSubstitutionTemplate"],["tid/1745/type/NoSubstitutionTemplate"],["tid/1769/type/NoSubstitutionTemplate"],["tid/1782/type/NoSubstitutionTemplate"]],"basename":"basicUtils.js","dirname":"/addons/basicUtils","extension":".js","filename":"basicUtils.js","path":"/addons/basicUtils/basicUtils.js","indexIsBuilt":false,"indexIds":{"NWJS Version":0,"Change into this NWJS version":1,"Use Developer version":2,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":3,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":4,"Use 32-bit version":5,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":6,"Some Translator++ feature may not work across NWJS version":7,"Please be aware that some Translator++ feature may not work across NWJS version. Make sure to test your project after changing the NWJS version.":8,"You're currently running on NWJS ver.":9,"Change Translator++ Core NWJS version":10,"You're already using the selected NWJS version.":11,"This operation will close Translator++ and change the current NW.js version into":12,"If you have any unsaved changes, please select 'Cancel' and save your project first.\nDo you want to continue?":13},"tags":[],"relPath":"/addons/basicUtils/basicUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/basicUtils/mainMenu.js":{"data":[["Change Language","تغيير اللغة"],["No MTL available for this language pair","لا يوجد ترجمة آلية متاحة لهذا الزوج اللغوي"],["Change default MTL for this project","تغيير الترجمة الآلية الافتراضية لهذا المشروع"],["???","???"],["Search in a folder","البحث في مجلد"],["Search in Staging Files","البحث في ملفات المرحلة"],["Search in Original Files","البحث في الملفات الأصلية"],["No original files path is set for this project.","لم يتم تعيين مسار للملفات الأصلية لهذا المشروع."],["Search in Translated Files","البحث في الملفات المترجمة"],["No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.","لم يتم تعيين مسار للملفات المترجمة لهذا المشروع.\nتحتاج إلى حقن ترجمتك مرة واحدة لتعيين مسار الملفات المترجمة."],["Chat with AI Assistant","التحدث مع مساعد الذكاء الاصطناعي"],["AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.","مساعد الذكاء الاصطناعي غير متاح لأن الميزات الجديدة لم يتم تحميلها.\nيرجى إعادة تثبيت أو إعادة تحديث Translator++."]],"context":[["tid/442/type/StringLiteral"],["tid/729/type/StringLiteral"],["tid/974/type/StringLiteral"],["tid/1182/type/StringLiteral"],["tid/1339/type/StringLiteral"],["tid/1404/type/StringLiteral"],["tid/1501/type/StringLiteral"],["tid/1539/type/StringLiteral"],["tid/1624/type/StringLiteral"],["tid/1662/type/StringLiteral"],["tid/1777/type/StringLiteral"],["tid/1812/type/StringLiteral"]],"basename":"mainMenu.js","dirname":"/addons/basicUtils","extension":".js","filename":"mainMenu.js","path":"/addons/basicUtils/mainMenu.js","indexIsBuilt":false,"indexIds":{"Change Language":0,"No MTL available for this language pair":1,"Change default MTL for this project":2,"???":3,"Search in a folder":4,"Search in Staging Files":5,"Search in Original Files":6,"No original files path is set for this project.":7,"Search in Translated Files":8,"No translated files path is set for this project.\nYou need to inject your translation once to set the translated files path.":9,"Chat with AI Assistant":10,"AI Assistant is not available since the new features are not loaded.\nPlease reinstall or re-update Translator++.":11},"tags":[],"relPath":"/addons/basicUtils/mainMenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":12,"length":12,"percent":100},"parameters":[]},"/addons/basicUtils/utils/HTMLPacker.js":{"data":[["Path is not a file:","المسار ليس ملفًا:"],["Icon path is not a file:","مسار الأيقونة ليس ملفًا:"],["Path is not an exe file:","المسار ليس ملفًا تنفيذيًا:"],["Icon path is not an ico file:","مسار الأيقونة ليس ملفًا من نوع ico:"],["Html entry point","نقطة دخول HTML"],["Select the html entry point file (usually index.html)","اختر ملف نقطة دخول HTML (عادة index.html)"],["Destination folder","مجلد الوجهة"],["Select destination folder. The process will replace the existing files.","اختر مجلد الوجهة. ستستبدل العملية الملفات الموجودة."],["NWJS version","إصدار NWJS"],["Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.","اختياري. اختر إصدار NWJS والهيكل.<br />الإصدار الأحدث ليس دائمًا أفضل، استخدم ما يناسبك فقط."],["Application ID","معرف التطبيق"],["Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.","عيّن معرف التطبيق للعبة. يجب أن يكون المعرف بأحرف صغيرة ويمكن أن يحتوي فقط على أحرف وأرقام وشرطات سفلية."],["Application description","وصف التطبيق"],["Set the application description for the game.","عيّن وصف التطبيق للعبة."],["Window title","عنوان النافذة"],["Set the default window title for the game.<br />This value may be overridden by the game engine.","عيّن عنوان النافذة الافتراضي للعبة.<br />قد يتم تجاوز هذه القيمة بواسطة محرك اللعبة."],["Window width","عرض النافذة"],["Set the default window width for the game.","عيّن عرض النافذة الافتراضي للعبة."],["Window height","ارتفاع النافذة"],["Set the default window height for the game.","عيّن ارتفاع النافذة الافتراضي للعبة."],["Full screen","شاشة كاملة"],["Set the game to start in full screen mode.","عيّن اللعبة لتبدأ في وضع الشاشة الكاملة."],["Resizable","قابل للتغيير"],["Set the game window to be resizable.","عيّن نافذة اللعبة لتكون قابلة للتغيير."],["Game icon","أيقونة اللعبة"],["Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.","اختر ملف الأيقونة لتطبيق اللعبة. يجب أن يكون ملف الأيقونة بصيغة .ico. سيتم تضمين الأيقونة في تطبيق اللعبة."],["Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.","من خلال هذا النموذج، يمكنك إنشاء حزمة قابلة للعب من لعبتك. <br />ستقوم العملية باستبدال الملفات الموجودة في مجلد الوجهة."],["Start the application in full screen mode","ابدأ التطبيق في وضع الشاشة الكاملة"],["Allow the application to be resizable","اسمح للتطبيق بأن يكون قابلاً للتغيير"],["HTML Compiler","مترجم HTML"],["Compile","ترجمة"],["Source path can not empty","مسار المصدر لا يمكن أن يكون فارغًا"],["Destination path can not empty","مسار الوجهة لا يمكن أن يكون فارغًا"]],"context":[["tid/86/type/StringLiteral","tid/4136/type/StringLiteral"],["tid/116/type/StringLiteral"],["tid/151/type/StringLiteral"],["tid/186/type/StringLiteral"],["tid/2424/type/StringLiteral"],["tid/2434/type/StringLiteral"],["tid/2474/type/StringLiteral"],["tid/2484/type/StringLiteral"],["tid/2524/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2587/type/StringLiteral"],["tid/2597/type/StringLiteral"],["tid/2631/type/StringLiteral","tid/3795/type/StringLiteral"],["tid/2641/type/StringLiteral","tid/3805/type/StringLiteral"],["tid/2675/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2722/type/StringLiteral"],["tid/2732/type/StringLiteral"],["tid/2766/type/StringLiteral"],["tid/2776/type/StringLiteral"],["tid/2810/type/StringLiteral"],["tid/2820/type/StringLiteral"],["tid/2854/type/StringLiteral"],["tid/2864/type/StringLiteral"],["tid/2899/type/StringLiteral"],["tid/2909/type/StringLiteral"],["tid/2950/type/NoSubstitutionTemplate"],["tid/3900/type/StringLiteral"],["tid/3924/type/StringLiteral"],["tid/4020/type/StringLiteral"],["tid/4037/type/StringLiteral"],["tid/4083/type/StringLiteral"],["tid/4104/type/StringLiteral"]],"basename":"HTMLPacker.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"HTMLPacker.js","path":"/addons/basicUtils/utils/HTMLPacker.js","indexIsBuilt":false,"indexIds":{"Path is not a file:":0,"Icon path is not a file:":1,"Path is not an exe file:":2,"Icon path is not an ico file:":3,"Html entry point":4,"Select the html entry point file (usually index.html)":5,"Destination folder":6,"Select destination folder. The process will replace the existing files.":7,"NWJS version":8,"Optional. Select NWJS version and architecture.<br />Latest version not always better, just use what works for you.":9,"Application ID":10,"Set the application ID for the game. The ID must be in lowercase and can only contain letters, numbers, and underscores.":11,"Application description":12,"Set the application description for the game.":13,"Window title":14,"Set the default window title for the game.<br />This value may be overridden by the game engine.":15,"Window width":16,"Set the default window width for the game.":17,"Window height":18,"Set the default window height for the game.":19,"Full screen":20,"Set the game to start in full screen mode.":21,"Resizable":22,"Set the game window to be resizable.":23,"Game icon":24,"Select the icon file for the game executable. The icon file must be in .ico format. The icon will be embedded in the game executable.":25,"Through this form, you can create a playable package of your game. <br />The process will replace the existing files in the destination folder.":26,"Start the application in full screen mode":27,"Allow the application to be resizable":28,"HTML Compiler":29,"Compile":30,"Source path can not empty":31,"Destination path can not empty":32},"tags":[],"relPath":"/addons/basicUtils/utils/HTMLPacker.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":33,"length":33,"percent":100},"parameters":[]},"/addons/basicUtils/utils/Updater.js":{"data":[["An update is being installed. Please do not close the application until the installation is completed.","يتم تثبيت تحديث. يرجى عدم إغلاق التطبيق حتى اكتمال التثبيت."],["Package Path","مسار الحزمة"],["Select the package file.","اختر ملف الحزمة."],["Package Key","مفتاح الحزمة"],["If you have the key, please enter it here. If not, leave it empty.","إذا كان لديك المفتاح، يرجى إدخاله هنا. إذا لم يكن، اتركه فارغًا."],["Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.","من خلال هذا النموذج، يمكنك تحديث Translator++ باستخدام ملف حزمة التحديث. يمكنك تنزيل حزمة التحديث <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>هنا</a>."],["Update from package","تحديث من حزمة"],["Update","تحديث"],["Update Translator++","تحديث Translator++"]],"context":[["tid/4918/type/StringLiteral"],["tid/6562/type/StringLiteral"],["tid/6572/type/StringLiteral"],["tid/6612/type/StringLiteral"],["tid/6622/type/StringLiteral"],["tid/6661/type/NoSubstitutionTemplate"],["tid/6753/type/StringLiteral","tid/7195/type/StringLiteral"],["tid/6770/type/StringLiteral","tid/7091/type/StringLiteral"],["tid/7120/type/StringLiteral"]],"basename":"Updater.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"Updater.js","path":"/addons/basicUtils/utils/Updater.js","indexIsBuilt":false,"indexIds":{"An update is being installed. Please do not close the application until the installation is completed.":0,"Package Path":1,"Select the package file.":2,"Package Key":3,"If you have the key, please enter it here. If not, leave it empty.":4,"Through this form, you can update Translator++ with the updater package file. You can download the updater package <a href=\"https://dreamsavior.net/translator-plusplus/translator-update-package/\" external>here</a>.":5,"Update from package":6,"Update":7,"Update Translator++":8},"tags":[],"relPath":"/addons/basicUtils/utils/Updater.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/addons/basicUtils/utils/info.js":{"data":[["You have ","لديك "],[" missed update(s)!"," تحديث(ات) مفقود(ة)!"],["Translator++ will update itself if auto-update is enabled.","سيقوم Translator++ بتحديث نفسه إذا كان التحديث التلقائي مفعلًا."],["You can download the latest core version of Translator++ at","يمكنك تنزيل أحدث إصدار أساسي من Translator++ في"],["This update is available for all patrons.","هذا التحديث متاح لجميع الرعاة."],["This update is available for tier $","هذا التحديث متاح للرعاة من المستوى $"],[" patrons or greater."," أو أعلى."],["You're up-to-date!","أنت محدث!"],["Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!","شكرًا لك على البقاء محدثًا مع Translator++! أنت على أحدث إصدار، ونحن نقدر دعمك. استمتع بالترجمة!"],["Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.","قد تظهر بعض معلومات التحديث من الذاكرة المؤقتة. يمكنك النقر على <b>'التحقق من التحديث'</b> لتحميل تفاصيل أحدث إصدار."],["When the same version is available","عند توفر نفس الإصدار"],["Allow Translator++ to reinstall the same version of Translator++.","السماح لـ Translator++ بإعادة تثبيت نفس إصدار Translator++."],["Allow reinstall the same version","السماح بإعادة تثبيت نفس الإصدار"],["Update Settings","إعدادات التحديث"],["Update Now","تحديث الآن"],["Updater is not available, please update Translator++ manually.","المحدِّث غير متاح، يرجى تحديث Translator++ يدويًا."],["Updating Translator++","تحديث Translator++"],["Please don't close Translator++ until the update process is finished.","يرجى عدم إغلاق Translator++ حتى تنتهي عملية التحديث."],["Can not update, reason :\n","لا يمكن التحديث، السبب:\n"],["You may need to reconnect Translator++ with your Patreon account (logout and login again).","قد تحتاج إلى إعادة توصيل Translator++ بحساب Patreon الخاص بك (تسجيل الخروج وتسجيل الدخول مرة أخرى)."],["Also, it has been reported that some countries such as mainland China are blocking dropbox repository.","أيضًا، تم الإبلاغ عن أن بعض البلدان مثل الصين القارية تحظر مستودع Dropbox."],["If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:","إذا لسبب ما لا يمكنك الوصول إلى مستودعنا، يرجى تنزيل حزمة التحديث (ملف tpch) يدويًا باستخدام وكيل أو VPN من هنا:"],["After that, please use the \"Update from package\" feature to update your Translator++.","بعد ذلك، يرجى استخدام ميزة \"التحديث من الحزمة\" لتحديث Translator++ الخاص بك."],["If you still have problems, please contact us at our Discord server : ","إذا كنت لا تزال تواجه مشاكل، يرجى الاتصال بنا على خادم Discord الخاص بنا: "],["Restart","إعادة التشغيل"],["Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.","هل تريد إعادة تشغيل Translator++ الآن؟\nإذا كان لديك عمل غير محفوظ، قم بإلغاء هذا الحوار واحفظ عملك أولاً."],["Check for Update","التحقق من التحديث"],["Close","إغلاق"]],"context":[["tid/649/type/StringLiteral"],["tid/660/type/StringLiteral"],["tid/665/type/StringLiteral"],["tid/670/type/StringLiteral"],["tid/1033/type/StringLiteral"],["tid/1077/type/StringLiteral"],["tid/1088/type/StringLiteral"],["tid/1665/type/StringLiteral"],["tid/1670/type/StringLiteral"],["tid/1675/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1765/type/StringLiteral"],["tid/1811/type/StringLiteral"],["tid/1873/type/StringLiteral"],["tid/2021/type/StringLiteral"],["tid/2066/type/StringLiteral"],["tid/2116/type/StringLiteral"],["tid/2130/type/StringLiteral"],["tid/2176/type/StringLiteral"],["tid/2192/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2220/type/StringLiteral"],["tid/2245/type/NoSubstitutionTemplate"],["tid/2259/type/StringLiteral"],["tid/2357/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2449/type/StringLiteral"],["tid/2512/type/StringLiteral"]],"basename":"info.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"info.js","path":"/addons/basicUtils/utils/info.js","indexIsBuilt":false,"indexIds":{"You have ":0," missed update(s)!":1,"Translator++ will update itself if auto-update is enabled.":2,"You can download the latest core version of Translator++ at":3,"This update is available for all patrons.":4,"This update is available for tier $":5," patrons or greater.":6,"You're up-to-date!":7,"Thanks for staying up to date with Translator++! You're on the newest version, and we appreciate your support. Enjoy translating!":8,"Some update information may be shown from cache. You can click <b>'Check for update'</b> to load the latest version details.":9,"When the same version is available":10,"Allow Translator++ to reinstall the same version of Translator++.":11,"Allow reinstall the same version":12,"Update Settings":13,"Update Now":14,"Updater is not available, please update Translator++ manually.":15,"Updating Translator++":16,"Please don't close Translator++ until the update process is finished.":17,"Can not update, reason :\n":18,"You may need to reconnect Translator++ with your Patreon account (logout and login again).":19,"Also, it has been reported that some countries such as mainland China are blocking dropbox repository.":20,"If for some reason you cannot access our repository, please manually download the update package (tpch file) using a proxy or VPN here:":21,"After that, please use the \"Update from package\" feature to update your Translator++.":22,"If you still have problems, please contact us at our Discord server : ":23,"Restart":24,"Do you want to restart Translator++ now?\nIf you have unsaved work, cancel this dialog and save your work first.":25,"Check for Update":26,"Close":27},"tags":[],"relPath":"/addons/basicUtils/utils/info.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":28,"length":28,"percent":100},"parameters":[]},"/addons/basicUtils/utils/uiTags.js":{"data":[["Do not process row with selected tag (blacklist)","لا تعالج الصفوف ذات الوسم المحدد (القائمة السوداء)"],["Only process row with selected tag (whitelist)","عالج فقط الصفوف ذات الوسم المحدد (القائمة البيضاء)"],["Ignore tag","تجاهل الوسم"],["Load last selection","تحميل آخر اختيار"],["Reset","إعادة تعيين"],["Cancel","إلغاء"],["Confirm","تأكيد"]],"context":[["tid/55/type/StringLiteral"],["tid/60/type/StringLiteral"],["tid/65/type/StringLiteral"],["tid/410/type/StringLiteral"],["tid/415/type/StringLiteral"],["tid/2085/type/StringLiteral"],["tid/2137/type/StringLiteral"]],"basename":"uiTags.js","dirname":"/addons/basicUtils/utils","extension":".js","filename":"uiTags.js","path":"/addons/basicUtils/utils/uiTags.js","indexIsBuilt":false,"indexIds":{"Do not process row with selected tag (blacklist)":0,"Only process row with selected tag (whitelist)":1,"Ignore tag":2,"Load last selection":3,"Reset":4,"Cancel":5,"Confirm":6},"tags":[],"relPath":"/addons/basicUtils/utils/uiTags.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/customParser/CustomParserLoader.js":{"data":[["List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.","قائمة ترميزات الأحرف الممكنة. <b>الترتيب مهم!</b>. افصل كل قيمة بفاصلة.<br />سيقرأ Translator++ الملف الأصلي باستخدام الترميزات التالية، ويعدل الملفات ويكتب باستخدام خيار <b>ترميز كتابة الأحرف</b>. اتركه فارغًا لاستخدام ترميز الأحرف الأصلي عند إنشاء المشروع."],["For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>","لدعم BOM، أضف مسافة بعد الترميز. مثال: <code>utf8 bom</code>"],["Example: utf8,utf8 bom,utf16le,ascii","مثال: utf8,utf8 bom,utf16le,ascii"],["Select the target character encoding.","اختر ترميز الأحرف المستهدف."]],"context":[["tid/3375/type/NoSubstitutionTemplate"],["tid/3383/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/4740/type/StringLiteral"]],"basename":"CustomParserLoader.js","dirname":"/addons/customParser","extension":".js","filename":"CustomParserLoader.js","path":"/addons/customParser/CustomParserLoader.js","indexIsBuilt":false,"indexIds":{"List of the possible character encodings. <b>Order does matter!</b>. Separate each value with a comma.<br />Translator++ will read the original file with the following encodings, patch the files and write with the <b>Write Character encoding</b> option. Leave blank to use the original character encoding when the project is created.":0,"For BOM support, add a space after the encoding. Example: <code>utf8 bom</code>":1,"Example: utf8,utf8 bom,utf16le,ascii":2,"Select the target character encoding.":3},"tags":[],"relPath":"/addons/customParser/CustomParserLoader.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.html":{"data":[["<i class=\"icon-edit\"></i>","<i class=\"icon-edit\"></i>"],["<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>","<i class=\"icon-plus-circled\"></i><label data-tran=\"\">إضافة مجموعة ملفات جديدة</label>"],["Add a new file group","إضافة مجموعة ملفات جديدة"],["<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>","<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">إزالة مجموعة الملفات الحالية</label>"],["Remove current file group","إزالة مجموعة الملفات الحالية"],["Rules","قواعد"],["Hooks","خطافات"],["Options","خيارات"],["Testing","اختبار"],["Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>","استبدل النصوص قبل عرضها في الخلايا. <b>إلى الشبكة</b> هو عكس <b>من الشبكة</b>"],["Example","مثال"],["For example, the text obtained from the parser is as follows:","على سبيل المثال، النص المستخرج من المحلل هو كما يلي:"],["In this grid it will look like this:","في هذه الشبكة سيبدو هكذا:"],["That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n","هذا ليس أسهل نص للعمل معه.<br>\n  يمكننا إصلاح ذلك بتعريف <span class=\"inlineCode\">خطافات إلى الشبكة</span> كما يلي:\n"],["With the hook above the text in the grid will be :","باستخدام الخطاف أعلاه، سيكون النص في الشبكة:"],["Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.","استبدل النصوص من الخلايا في نتيجة الترجمة. <b>من الشبكة</b> هو عكس <b>إلى الشبكة</b>."],["\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n","\n  على سبيل المثال، يجب أن تكون النصوص المترجمة المتوقعة بتنسيق JSON.<br>\n  لكن كتابة الترجمة بتنسيق JSON ليس أسهل شيء للقيام به. <br>\n  لذا، بدلاً من طلب المترجم للترجمة بتنسيق JSON، يمكننا فقط أن نطلب منهم الكتابة بشكل طبيعي، وإضافة <span class=\"inlineCode\">خطاف من الشبكة</span> كما يلي:\n"],["\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n","\n  باستخدام <span class=\"inlineCode\">خطاف من الشبكة</span> أعلاه، الترجمة التالية ...\n"],["...will be converted into desired format: ","...سيتم تحويلها إلى التنسيق المطلوب: "],["Edit the translated text just before writing it into a file.","تحرير النص المترجم قبل كتابته في ملف."],["Parameters","المعلمات"],["\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ","\n              <h3 data-tran=\"\">نص</h3>\n              <p data-tran=\"\">النص الذي على وشك كتابته في ملف.</p>\n            "],["text","نص"],["The text that is about to be written into a file.","النص الذي على وشك كتابته في ملف."],["Return value","قيمة الإرجاع"],["\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ","\n              <h3><i>سلسلة</i></h3>\n              <p data-tran=\"\">النص الذي سيتم كتابته في ملف.</p>\n            "],["The text that will be written into a file.","النص الذي سيتم كتابته في ملف."],["General","عام"],["Read character encoding","قراءة ترميز الأحرف"],["Force parser to use the following character encoding when reading the file(s).","إجبار المحلل على استخدام ترميز الأحرف التالي عند قراءة الملف(ات)."],["Write character encoding","كتابة ترميز الأحرف"],["Force parser to use the following character encoding when writing the file(s).","إجبار المحلل على استخدام ترميز الأحرف التالي عند كتابة الملف(ات)."],["You are editing:","أنت تعدل:"],["Please select the mode of your pattern","يرجى اختيار نمط النمط الخاص بك"],["Regular expression Pattern","نمط التعبير المنتظم"],["A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.","تعبير منتظم صالح لـ ECMA Script مع المعدل.<br>يمكنك استخدام <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> لإنشاء واختبار نمطك."],["Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ","انتبه إلى استخدام إرجاع السطر (\\r) في النص المراد ترجمته. regex101.com سيزيل إرجاعات السطر لذا قد يكون لنمطك تأثير مختلف عما تراه على regex101."],["<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.","<strong>حول المحدد الكمي الذي يلتقط سلسلة بطول صفر.</strong><br>\n            <i>السلاسل الفارغة</i> ستسبب مشاكل للمحلل. لذلك، بدلاً من استخدام المحدد الكمي <strong>*</strong> الذي سيلتقط أيضًا <i>الفارغات</i>، يوصى بشدة باستخدام المحدد الكمي <strong>+</strong> الذي سيلتقط السلاسل فقط إذا كانت موجودة."],["Translatable Capture groups","مجموعات الالتقاط القابلة للترجمة"],["Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.","فهرس مجموعات التعبير المنتظم (عدد صحيح) للنصوص القابلة للترجمة. يمكن أن يكون أكثر من واحد. افصل بفاصلة."],["Row Info Capture group","مجموعة معلومات الصف"],["\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ","\n            فهرس مجموعة التعبير المنتظم (عدد صحيح) لمعلومات الصف (مثل اسم الشخصية). <b>مجموعة واحدة فقط</b> مسموح بها. <br>\n            يمكن نقل قيمة معلومات الصف إلى القواعد الفرعية وسيتم استبدالها بقيمة معلومات الصف للقاعدة الفرعية إذا كانت موجودة.\n          "],["Context template","قالب السياق"],["\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ","\n            السياق هو معرف فريد للنصوص القابلة للترجمة. <br>\n            يمكنك استخدام القوالب الحرفية لجافاسكريبت لإضافة معلومات إلى السياق.<br>\n            <b>المتغيرات المتاحة:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - التقاط المجموعة.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - معرف القاعدة.</li> -->\n            </ul>\n            <br>\n            <b>مثال:</b>\n            <pre>item/${GROUP[2]}</pre>\n          "],["Action","الإجراء"],["Capture value","التقاط القيمة"],["Capture then mask value","التقاط ثم إخفاء القيمة"],["Mask value","إخفاء القيمة"],["Send to inner rule","إرسال إلى القاعدة الداخلية"],["Edit inner rule <i class=\"icon-angle-double-right\"></i>","تحرير القاعدة الداخلية <i class=\"icon-angle-double-right\"></i>"],["What action the pattern is going to do.","ما هو الإجراء الذي سيقوم به النمط."],["Javascript function","دالة جافاسكريبت"],["Guide","دليل"],["\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ","\n          <h2 data-tran=\"\">الوسائط</h2>\n          <p data-tran=\"\">سيتم كتابة الكود الخاص بك داخل دالة تحتوي على وسيطتين يمكن الوصول إليهما في أي مكان في الكود:</p>\n          <ul>\n            <li>\n              <h3>نص</h3>\n              <p><b>سلسلة نصية</b></p>\n              <p data-tran=\"\">سلسلة نصية تحتوي على محتوى الملف بأكمله.</p>\n            </li>\n            <li>\n              <h3>هذا النموذج</h3>\n              <p><b>كائن</b></p>\n              <p data-tran=\"\">كائن القاعدة الذي يستخدمه الملف حاليًا.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>هذا</i> الكلمة المفتاحية</h2>\n          <p data-tran=\"\"><b>هذا</b> سيشير إلى مثيل فئة CustomParser.</p>\n\n        "],["Arguments","الوسائط"],["The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:","سيتم كتابة الكود الخاص بك داخل دالة تحتوي على وسيطتين يمكن الوصول إليهما في أي مكان في الكود:"],["A string of the entire content of the file.","سلسلة نصية تحتوي على محتوى الملف بأكمله."],["The rule object that is currently used by the file.","كائن القاعدة الذي يستخدمه الملف حاليًا."],["<i>this</i> Keyword","<i>هذا</i> الكلمة المفتاحية"],["<b>this</b> will reffer to the instance of CustomParser class.","<b>هذا</b> سيشير إلى مثيل فئة CustomParser."],["\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ","\n          <h2 data-tran=\"\">القيمة المتوقعة للإرجاع</h2>\n          <p data-tran=\"\">يجب أن <b>ترجع</b> الكود الخاص بك إحدى القيم التالية:</p>\n          <ul>\n            <li><pre>غير محدد</pre></li>\n            <li data-tran=\"\">إزاحة النص الملتقط، على سبيل المثال:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"اسم الشخصية\", // اسم الشخصية. اختياري\n    context: [\"بعض\", \"سياق\", \"هنا\"] // السياق. اختياري\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">مصفوفة من إزاحة النص الملتقط، على سبيل المثال:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"اسم الشخصية\", context: [\"بعض\", \"سياق\", \"هنا\"]},\n    {start:12, end:30, rowInfoText:\"شخصية أخرى\", context: [\"آخر\", \"سياق\"]},\n    {start:4581, end:4593, rowInfoText:\"شخصية ثالثة\", context: [\"ثالث\", \"سياق\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        "],["Expected Return Value","القيمة المتوقعة للإرجاع"],["Your code must <b>return</b> one of the following value:","يجب أن <b>ترجع</b> الكود الخاص بك إحدى القيم التالية:"],["Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ","إزاحة النص الملتقط، على سبيل المثال:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"اسم الشخصية\", // اسم الشخصية. اختياري\n    context: [\"بعض\", \"سياق\", \"هنا\"] // السياق. اختياري\n  }\n</pre>\n            "],["Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ","مصفوفة من إزاحة النص الملتقط، على سبيل المثال:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"اسم الشخصية\", context: [\"بعض\", \"سياق\", \"هنا\"]},\n    {start:12, end:30, rowInfoText:\"شخصية أخرى\", context: [\"آخر\", \"سياق\"]},\n    {start:4581, end:4593, rowInfoText:\"شخصية ثالثة\", context: [\"ثالث\", \"سياق\"]}\n  ]\n</pre>              \n            "],["\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ","\n          <h2 data-tran=\"\">مثال</h2>\n          <p data-tran=\"\">الكود التالي هو مثال لتحليل ترجمات srt.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ يستخدم regexp-match-indices\n  وبذلك فإن جميع طرق RegExp.exec() سترجع إزاحة المجموعة الخاصة بها\n  اقرأ المزيد عن مؤشرات التعبير العادي هنا: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        "],["The following code is an example to parse srt subtitle.","الكود التالي هو مثال لتحليل ترجمات srt."],["Welcome to the Custom Parser Model Creator","مرحبًا بك في منشئ نموذج المحلل المخصص"],["Please start by creating a new File Group.","يرجى البدء بإنشاء مجموعة ملفات جديدة."],["Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ","يرجى تحديد نوع الملف الذي تريد تحليله بالنقر على زر\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>إضافة مجموعة ملفات جديدة</button>.\n    "],["Press F1 to open the help dialog.","اضغط F1 لفتح مربع حوار المساعدة."],["New File","ملف جديد"],["Open file","فتح ملف"],["Save file","حفظ الملف"],["Save As","حفظ باسم"],["Open debugger (F12)","فتح أداة التصحيح (F12)"],["Help","مساعدة"],["Edit current file pattern","تحرير نمط الملف الحالي"],["Add a new file pattern","إضافة نمط ملف جديد"],["Remove current file pattern","إزالة نمط الملف الحالي"],["Rule's order does matter, especially when you use masking! Drag to reorder.","ترتيب القواعد مهم، خاصة عند استخدام الإخفاء! اسحب لإعادة الترتيب."]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText","idx/29/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText","idx/16/innerText","idx/28/innerText","idx/69/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/38/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/49/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"],["idx/9/attr/title"]],"basename":"modelEditor.html","dirname":"/addons/customParser/modelEditor","extension":".html","filename":"modelEditor.html","path":"/addons/customParser/modelEditor/modelEditor.html","indexIsBuilt":false,"indexIds":{"<i class=\"icon-edit\"></i>":0,"<i class=\"icon-plus-circled\"></i><label data-tran=\"\">Add a new file group</label>":1,"Add a new file group":2,"<i class=\"icon-cancel-circled red\"></i><label data-tran=\"\">Remove current file group</label>":3,"Remove current file group":4,"Rules":5,"Hooks":6,"Options":7,"Testing":8,"Interpolate the strings before being displayed on the cells. <b>To Grid</b> is antithesis of <b>From Grid</b>":9,"Example":10,"For example, the text obtained from the parser is as follows:":11,"In this grid it will look like this:":12,"That's not the easiest text to work with.<br>\n  We can fix that by declaring <span class=\"inlineCode\">To Grid hooks</span> as follows:\n":13,"With the hook above the text in the grid will be :":14,"Interpolate the strings from the cells into the translation result. <b>From Grid</b> is antithesis of <b>To Grid</b>.":15,"\n  For example, the expected translated strings should be in JSON format.<br>\n  But writing translation in JSON format is not realy the easiest thing to do. <br>\n  So, instead of asking our translator to translate in JSON format, we can just ask them to type normally, and add a <span class=\"inlineCode\">From Grid hook</span> as follows:\n":16,"\n  With the <span class=\"inlineCode\">From Grid hook</span> above, the following translation ...\n":17,"...will be converted into desired format: ":18,"Edit the translated text just before writing it into a file.":19,"Parameters":20,"\n              <h3 data-tran=\"\">text</h3>\n              <p data-tran=\"\">The text that is about to be written into a file.</p>\n            ":21,"text":22,"The text that is about to be written into a file.":23,"Return value":24,"\n              <h3><i>String</i></h3>\n              <p data-tran=\"\">The text that will be written into a file.</p>\n            ":25,"The text that will be written into a file.":26,"General":27,"Read character encoding":28,"Force parser to use the following character encoding when reading the file(s).":29,"Write character encoding":30,"Force parser to use the following character encoding when writing the file(s).":31,"You are editing:":32,"Please select the mode of your pattern":33,"Regular expression Pattern":34,"A valid ECMA Script's regular expression along with the modifier.<br>You can use <a href=\"https://regex101.com/\" class=\"externalLink\" external=\"\">regex101.com</a> to create and test your pattern.":35,"Pay attention to the use of carriage return (\\r) in the text to be translated. regex101.com will strip out the carriage returns so your pattern may have a different effect than what you see on regex101. ":36,"<strong>About quantifier that captures a zero length string.</strong><br>\n            <i>Null</i> strings will cause problems for the parser. Therefore, instead of using the <strong>*</strong> quantifier which will also capture <i>nulls</i>, it is highly recommended to use the <strong>+</strong> quantifier which will only capture strings if exist.":37,"Translatable Capture groups":38,"Index of the regular expression's groups (Integer) for the translatable texts. Can be more than one. Separate with comma.":39,"Row Info Capture group":40,"\n            Index of the regular expression's group (Integer) for the row info (e.g. character name). <b>Only one group</b> is allowed. <br>\n            The value of the Row info can be carried over to the child rules and will be overwritten by the child rule's Row info value if exist.\n          ":41,"Context template":42,"\n            Context is unique identifier for translatable texts. <br>\n            You can use Javascript's template literals to add information to the context.<br>\n            <b>Available variable:</b>\n            <ul>\n              <li><span class=\"inlineCode\">GROUP[<i>n</i>]</span> - Group capture.</li>\n              <!-- <li><span class=\"inlineCode\">RULE_ID</span> - The ID of the rule.</li> -->\n            </ul>\n            <br>\n            <b>Example:</b>\n            <pre>item/${GROUP[2]}</pre>\n          ":43,"Action":44,"Capture value":45,"Capture then mask value":46,"Mask value":47,"Send to inner rule":48,"Edit inner rule <i class=\"icon-angle-double-right\"></i>":49,"What action the pattern is going to do.":50,"Javascript function":51,"Guide":52,"\n          <h2 data-tran=\"\">Arguments</h2>\n          <p data-tran=\"\">The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:</p>\n          <ul>\n            <li>\n              <h3>text</h3>\n              <p><b>String</b></p>\n              <p data-tran=\"\">A string of the entire content of the file.</p>\n            </li>\n            <li>\n              <h3>thisModel</h3>\n              <p><b>Object</b></p>\n              <p data-tran=\"\">The rule object that is currently used by the file.</p>\n            </li>\n          </ul>\n          <h2 data-tran=\"\"><i>this</i> Keyword</h2>\n          <p data-tran=\"\"><b>this</b> will reffer to the instance of CustomParser class.</p>\n\n        ":53,"Arguments":54,"The code you write will be inside a function with 2 arguments that can be accessed anywhere in your code:":55,"A string of the entire content of the file.":56,"The rule object that is currently used by the file.":57,"<i>this</i> Keyword":58,"<b>this</b> will reffer to the instance of CustomParser class.":59,"\n          <h2 data-tran=\"\">Expected Return Value</h2>\n          <p data-tran=\"\">Your code must <b>return</b> one of the following value:</p>\n          <ul>\n            <li><pre>undefined</pre></li>\n            <li data-tran=\"\">Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            </li>\n            <li data-tran=\"\">Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            </li>\n          </ul>\n        ":60,"Expected Return Value":61,"Your code must <b>return</b> one of the following value:":62,"Offset of the captured text, for example:\n<pre>  {\n    start:100,\n    end:120,\n    rowInfoText:\"Character Name\", // Character name. optional\n    context: [\"some\", \"context\", \"here\"] // Context. optional\n  }\n</pre>\n            ":63,"Array of the offset of the captured text, for example:\n<pre>  [\n    {start:0, end:5, rowInfoText:\"Character Name\", context: [\"some\", \"context\", \"here\"]},\n    {start:12, end:30, rowInfoText:\"Another Character\", context: [\"another\", \"context\"]},\n    {start:4581, end:4593, rowInfoText:\"Third Character\", context: [\"third\", \"context\"]}\n  ]\n</pre>              \n            ":64,"\n          <h2 data-tran=\"\">Example</h2>\n          <p data-tran=\"\">The following code is an example to parse srt subtitle.</p>\n<pre><code class=\"language-javascript\">\n/*\n  Translator++ is using regexp-match-indices\n  by that all RegExp.exec() method will return their group offset\n  read more about Regular Expression Indices here: https://v8.dev/features/regexp-match-indices\n*/\n\nvar result \t\t\t= [];\nvar captureGroup \t= 1;\nvar regex \t\t\t= /\\d+[\\r\\n]+\\d+:\\d+:\\d+,\\d+ --&gt; \\d+:\\d+:\\d+,\\d+[\\r\\n]+((.+\\r?\\n)+(?=(\\r?\\n)?))/g;\nwhile(null != (matches=regex.exec(text))) {\n  console.log(matches);\n  if (!matches?.indices?.[captureGroup]) continue;\n  result.push({\n    start\t: matches.indices[captureGroup][0],\n    end\t\t: matches.indices[captureGroup][1]\n  })\n}\nreturn result;             \n</code>\n</pre>\n        ":65,"The following code is an example to parse srt subtitle.":66,"Welcome to the Custom Parser Model Creator":67,"Please start by creating a new File Group.":68,"Please define what kind of file you want to parse by clicking\n      <button class=\"addFileGroup\" onclick=\"addFileGroup(this)\"><i class=\"icon-plus-circled\"></i>Add a new file group</button> button.\n    ":69,"Press F1 to open the help dialog.":70,"New File":71,"Open file":72,"Save file":73,"Save As":74,"Open debugger (F12)":75,"Help":76,"Edit current file pattern":77,"Add a new file pattern":78,"Remove current file pattern":79,"Rule's order does matter, especially when you use masking! Drag to reorder.":80},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":81,"length":81,"percent":100},"parameters":[]},"/addons/customParser/modelEditor/modelEditor.js":{"data":[["Do you want to close Model editor?\rAll unsaved changes will be discarded.","هل تريد إغلاق محرر النموذج؟\rسيتم تجاهل جميع التغييرات غير المحفوظة."],["Translate here using ","ترجمة هنا باستخدام "],["Do you want to discard your changes and open\n","هل تريد تجاهل تغييراتك وفتح\n"],["Error when trying to open file :","خطأ عند محاولة فتح الملف:"],["Parser Model Creator","منشئ نموذج المحلل"],["Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json","يرجى تحديد نوع الملف الذي تريد تحليله.\nيمكنك استخدام أنماط عالمية مفصولة بفاصلة منقوطة. على سبيل المثال: *.txt;*.js;*.json"],["Failed to create new file group. Please check your pattern!","فشل في إنشاء مجموعة ملفات جديدة. يرجى التحقق من النمط الخاص بك!"],["Do you wish to remove current file group?\nYou can not undo this action!","هل ترغب في إزالة مجموعة الملفات الحالية؟\nلا يمكن التراجع عن هذا الإجراء!"],["Do you want to discard your changes and create a new blank model?","هل تريد تجاهل تغييراتك وإنشاء نموذج جديد فارغ؟"],["Do you want to discard your changes and open a file?","هل تريد تجاهل تغييراتك وفتح ملف؟"],["Clear history","مسح السجل"],["Open latest file","فتح أحدث ملف"],["Open from history","فتح من السجل"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","هذه الميزة متاحة فقط إذا كنت تستخدم إصدار المطور من Translator++. يمكنك التبديل إلى إصدار المطور باستخدام الأدوات الأساسية -> تغيير نواة NWJS."]],"context":[["tid/156/type/StringLiteral"],["tid/5647/type/StringLiteral"],["tid/9760/type/StringLiteral"],["tid/10037/type/StringLiteral"],["tid/10099/type/StringLiteral"],["tid/10622/type/StringLiteral","tid/10941/type/StringLiteral"],["tid/10665/type/StringLiteral","tid/10987/type/StringLiteral"],["tid/11026/type/StringLiteral"],["tid/11104/type/StringLiteral"],["tid/11174/type/StringLiteral","tid/12080/type/StringLiteral"],["tid/11459/type/StringLiteral"],["tid/11525/type/StringLiteral"],["tid/11607/type/StringLiteral"],["tid/11750/type/StringLiteral"]],"basename":"modelEditor.js","dirname":"/addons/customParser/modelEditor","extension":".js","filename":"modelEditor.js","path":"/addons/customParser/modelEditor/modelEditor.js","indexIsBuilt":false,"indexIds":{"Do you want to close Model editor?\rAll unsaved changes will be discarded.":0,"Translate here using ":1,"Do you want to discard your changes and open\n":2,"Error when trying to open file :":3,"Parser Model Creator":4,"Please specify what kind of file you want to parse.\nYou can use semicolon separated glob pattens. For example: *.txt;*.js;*.json":5,"Failed to create new file group. Please check your pattern!":6,"Do you wish to remove current file group?\nYou can not undo this action!":7,"Do you want to discard your changes and create a new blank model?":8,"Do you want to discard your changes and open a file?":9,"Clear history":10,"Open latest file":11,"Open from history":12,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":13},"tags":[],"relPath":"/addons/customParser/modelEditor/modelEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/googleCloudV3/trans.googleCloudV3.js":{"data":[["Invalid language string","سلسلة لغة غير صالحة"],["Required field Project ID is blank!","حقل معرف المشروع المطلوب فارغ!"],["Required field Service Account Key is blank!","حقل مفتاح حساب الخدمة المطلوب فارغ!"],["Required field Server Location is blank!","حقل موقع الخادم المطلوب فارغ!"],["Required field Location of the glossary file is blank!","حقل موقع ملف المصطلحات المطلوب فارغ!"],["Required field Glossary Languages is blank!","حقل لغات المصطلحات المطلوب فارغ!"],["Invalid glossary language value","قيمة لغة المصطلحات غير صالحة"],["Currently active glossary on this project: ","المصطلحات النشطة حاليًا في هذا المشروع: "],["Error when retreiving glossary info: ","خطأ عند استرداد معلومات المصطلحات: "],["Error when removing glossary : ","خطأ عند إزالة المصطلحات: "],["Glossary removed successfully.","تمت إزالة المصطلحات بنجاح."],["Error when creating glossary : ","خطأ عند إنشاء المصطلحات: "],["Glossary created successfully.","تم إنشاء المصطلحات بنجاح."],["Configuration error:\r\n","خطأ في التكوين:\r\n"],["No error found!","لم يتم العثور على أي خطأ!"],["Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js","Node JS مطلوب لاستخدام Google Cloud Translate Advanced. يرجى تنزيله وتثبيته من https://node.js"]],"context":[["tid/2012/type/StringLiteral"],["tid/3382/type/StringLiteral"],["tid/3437/type/StringLiteral"],["tid/3499/type/StringLiteral"],["tid/3554/type/StringLiteral"],["tid/3609/type/StringLiteral"],["tid/3640/type/StringLiteral"],["tid/3738/type/StringLiteral"],["tid/3819/type/StringLiteral"],["tid/3903/type/StringLiteral"],["tid/3932/type/StringLiteral"],["tid/4007/type/StringLiteral"],["tid/4036/type/StringLiteral"],["tid/4510/type/StringLiteral"],["tid/4546/type/StringLiteral"],["tid/6155/type/StringLiteral"]],"basename":"trans.googleCloudV3.js","dirname":"/addons/googleCloudV3","extension":".js","filename":"trans.googleCloudV3.js","path":"/addons/googleCloudV3/trans.googleCloudV3.js","indexIsBuilt":false,"indexIds":{"Invalid language string":0,"Required field Project ID is blank!":1,"Required field Service Account Key is blank!":2,"Required field Server Location is blank!":3,"Required field Location of the glossary file is blank!":4,"Required field Glossary Languages is blank!":5,"Invalid glossary language value":6,"Currently active glossary on this project: ":7,"Error when retreiving glossary info: ":8,"Error when removing glossary : ":9,"Glossary removed successfully.":10,"Error when creating glossary : ":11,"Glossary created successfully.":12,"Configuration error:\r\n":13,"No error found!":14,"Node JS is required to use Google Cloud Translate Advanced. Please download and install it from https://node.js":15},"tags":[],"relPath":"/addons/googleCloudV3/trans.googleCloudV3.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/jcap/jcap.js":{"data":[["JCap executable not found at the specified location. Do you want to install JCap?","لم يتم العثور على ملف JCap القابل للتنفيذ في الموقع المحدد. هل تريد تثبيت JCap؟"],["JCap agent started successfully. Press ","تم بدء وكيل JCap بنجاح. اضغط على "],["jcapKey","مفتاح jcap"],["Please set the JCap executable path in the addon settings.","يرجى تعيين مسار ملف JCap القابل للتنفيذ في إعدادات الإضافة."],["JCap executable already exists at the specified location.","يوجد ملف JCap القابل للتنفيذ بالفعل في الموقع المحدد."],["JCap executable downloaded successfully.","تم تنزيل ملف JCap القابل للتنفيذ بنجاح."],["Failed to download JCap package. Please check the console for details.","فشل تنزيل حزمة JCap. يرجى التحقق من وحدة التحكم للتفاصيل."],["JCap executable unpacked successfully.","تم فك حزمة JCap القابلة للتنفيذ بنجاح."],["You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.","يمكنك الآن بدء وكيل JCap من القائمة الرئيسية - الأدوات - أدوات OCR JCap - بدء وكيل JCap."],["Start JCap OCR Agent","بدء وكيل OCR JCap"],["Failed to unpack JCap package. Please check the console for details.","فشل فك حزمة JCap. يرجى التحقق من وحدة التحكم للتفاصيل."],["JCap executable not found at the specified location.","لم يتم العثور على ملف JCap القابل للتنفيذ في الموقع المحدد."],["Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.","هل أنت متأكد أنك تريد إلغاء تثبيت JCap؟ سيؤدي هذا إلى حذف ملف JCap القابل للتنفيذ وتكوينه."],["JCap uninstalled successfully.","تم إلغاء تثبيت JCap بنجاح."],["Failed to uninstall JCap. Please check the console for details.","فشل إلغاء تثبيت JCap. يرجى التحقق من وحدة التحكم للتفاصيل."],["Help","مساعدة"],["JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.","JCap OCR هي أداة OCR تتيح لك التقاط النص من الشاشة وترجمته باستخدام JCap. لاستخدامها، ابدأ JCap بالنقر على زر OCR في القائمة الرئيسية.\nثم اضغط على المفتاح المكون (الافتراضي: F9) لالتقاط النص."]],"context":[["tid/736/type/StringLiteral"],["tid/854/type/StringLiteral"],["tid/862/type/StringLiteral"],["tid/1005/type/StringLiteral"],["tid/1038/type/StringLiteral"],["tid/1392/type/StringLiteral"],["tid/1442/type/StringLiteral"],["tid/1554/type/StringLiteral"],["tid/1566/type/StringLiteral"],["tid/1591/type/StringLiteral"],["tid/1647/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1755/type/StringLiteral"],["tid/1828/type/StringLiteral"],["tid/1861/type/StringLiteral"],["tid/2350/type/StringLiteral"],["tid/2371/type/StringLiteral"]],"basename":"jcap.js","dirname":"/addons/jcap","extension":".js","filename":"jcap.js","path":"/addons/jcap/jcap.js","indexIsBuilt":false,"indexIds":{"JCap executable not found at the specified location. Do you want to install JCap?":0,"JCap agent started successfully. Press ":1,"jcapKey":2,"Please set the JCap executable path in the addon settings.":3,"JCap executable already exists at the specified location.":4,"JCap executable downloaded successfully.":5,"Failed to download JCap package. Please check the console for details.":6,"JCap executable unpacked successfully.":7,"You can now start the JCap agent from the Main Menu - Tools - OCR Tools JCap - Start JCap Agent.":8,"Start JCap OCR Agent":9,"Failed to unpack JCap package. Please check the console for details.":10,"JCap executable not found at the specified location.":11,"Are you sure you want to uninstall JCap? This will delete the JCap executable and its configuration.":12,"JCap uninstalled successfully.":13,"Failed to uninstall JCap. Please check the console for details.":14,"Help":15,"JCap OCR is an OCR tool that allows you to capture text from the screen and translate it using JCap. To use it start the JCap by clicking the OCR button on main menu.\nThen press the configured key (default: F9) to capture text.":16},"tags":[],"relPath":"/addons/jcap/jcap.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/jsonParser/json.js":{"data":[["Beautify JSON data","تحسين بيانات JSON"],["When checked the generated data will be beautified.","عند التحديد، سيتم تحسين البيانات المُنشأة."],["Start a new translation project from any JSON file.","ابدأ مشروع ترجمة جديد من أي ملف JSON."],["Translator++ will translate any translatable texts found in the JSON files.","سيترجم Translator++ أي نصوص قابلة للترجمة موجودة في ملفات JSON."],["Read the guide on how to start a new JSON translation project here","اقرأ الدليل حول كيفية بدء مشروع ترجمة JSON جديد هنا"],["Translator++ will scan through this folder for any JSON files.","سيقوم Translator++ بفحص هذا المجلد بحثًا عن أي ملفات JSON."],["How do you want to get the data from the JSON object?","كيف تريد الحصول على البيانات من كائن JSON؟"],["Parser mode","وضع المحلل"],["<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>","<h2>الوضع البسيط</h2><p>في الوضع البسيط، يمكنك ترجمة جميع قيم النصوص بشكل متكرر داخل كائن JSON.<br />في الوضع البسيط، النص الأصلي هو دائمًا القيمة.</p>"],["<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>","<h2>الوضع المتقدم</h2><p>في الوضع المتقدم، يمكنك استعلام JSON والتعامل مع جدول ترجمة من نوع زوج المفتاح-القيمة حيث النص الأصلي هو المفتاح.</p>"],["<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>","<h2>معلومات</h2><p>يمكنك استخدام حقل الاستعلام التالي لتحديد جزء معين من كائن JSON. يجب أن تكون نتيجة الاستعلام كائنًا أو مصفوفة من النصوص.</p>"],["<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>","<h3>للكائنات</h3><p>سيتم استخدام <b>المفتاح كنص أصلي</b> و<b>القيمة كترجمة افتراضية</b>.</p>"],["Parser will automatically register if the value is a string, null, or undefined.<br />","سيسجل المحلل تلقائيًا إذا كانت القيمة سلسلة نصية، أو فارغة، أو غير محددة.<br />"],["<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>","<h3>للمصفوفات</h3><p>سيسجل المحلل جميع قيم النصوص في المصفوفة كنصوص قابلة للترجمة.</p>"],["Start project","ابدأ المشروع"],["`Invalid destination directory:\\n${","`دليل الوجهة غير صالح:\\n${"],["}`","}`"]],"context":[["tid/92/type/StringLiteral","tid/119/type/StringLiteral"],["tid/102/type/StringLiteral"],["tid/2826/type/StringLiteral","tid/2879/type/StringLiteral"],["tid/2831/type/StringLiteral","tid/2884/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2998/type/StringLiteral"],["tid/3038/type/StringLiteral"],["tid/3214/type/StringLiteral"],["tid/3293/type/StringLiteral"],["tid/3346/type/StringLiteral"],["tid/3446/type/StringLiteral"],["tid/3451/type/StringLiteral"],["tid/3456/type/StringLiteral"],["tid/3461/type/StringLiteral"],["tid/3615/type/StringLiteral"],["tid/4070/type/TemplateHead"],["tid/4072/type/TemplateTail"]],"basename":"json.js","dirname":"/addons/jsonParser","extension":".js","filename":"json.js","path":"/addons/jsonParser/json.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Start a new translation project from any JSON file.":2,"Translator++ will translate any translatable texts found in the JSON files.":3,"Read the guide on how to start a new JSON translation project here":4,"Translator++ will scan through this folder for any JSON files.":5,"How do you want to get the data from the JSON object?":6,"Parser mode":7,"<h2>Simple Mode</h2><p>In simple mode, you can translate all strings value recursively inside the JSON object.<br />In simple mode, the original texts is always the value.</p>":8,"<h2>Advanced Mode</h2><p>In advanced mode you can query the JSON and handle key-value paired type translation table where the original text is the key.</p>":9,"<h2>Info</h2><p>You can use the following query field to select a specific part of the JSON object. The result of the query must be an object or an array of texts.</p>":10,"<h3>For objects</h3><p>The <b>key will be used as the original text</b> and <b>the value as the default translation</b>.</p>":11,"Parser will automatically register if the value is a string, null, or undefined.<br />":12,"<h3>For arrays</h3><p>The parser will register all string values in the array as translatable texts.</p>":13,"Start project":14,"`Invalid destination directory:\\n${":15,"}`":16},"tags":[],"relPath":"/addons/jsonParser/json.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/kagParser/TyranoParser.js":{"data":[["label","تسمية"],["is duplicated in the same scenario file","مكررة في ملف السيناريو نفسه"]],"context":[["tid/2372/type/StringLiteral"],["tid/2390/type/StringLiteral"]],"basename":"TyranoParser.js","dirname":"/addons/kagParser","extension":".js","filename":"TyranoParser.js","path":"/addons/kagParser/TyranoParser.js","indexIsBuilt":false,"indexIds":{"label":0,"is duplicated in the same scenario file":1},"tags":[],"relPath":"/addons/kagParser/TyranoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/kagParser/kagParser.js":{"data":[["Select directory","اختر الدليل"],["Select a directory to repack","اختر مجلدًا لإعادة التعبئة"],["Target xp3","الهدف xp3"],["Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.","اختر اسم الملف. الأسماء الخاصة مثل <b>patch.xp3</b>, <b>patch2.xp3</b>... إلخ تحصل على أولوية عند التحميل على data.xp3."],["Patch to allow folder structure","تصحيح لتمكين هيكل المجلدات"],["By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.","بشكل افتراضي، محرك KAG لا يقرأ الملفات داخل مجلد في ملفات xp3. هذا الخيار سيضيف تعريف هيكل المجلدات تلقائيًا إلى Config.tjs. لا تأثير إذا لم يتم العثور على ملف Config.tjs."],["Repack into xp3","إعادة التعبئة إلى xp3"],["Close","إغلاق"],["Process","معالجة"],["<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.","<b>الترتيب مهم</b> إذا قمت بفك ضغط عدة ملفات في وقت واحد! سيتم فك ضغط الملفات بالترتيب. إذا كانت الملفات موجودة، سيتم استبدالها."],["Unpack XP3 files","فك ضغط ملفات XP3"],["Repack a folder to xp3","إعادة تعبئة مجلد إلى xp3"],["Unpack xp3 file","فك ضغط ملف xp3"],["Before you create a new project, please make sure that :","قبل إنشاء مشروع جديد، تأكد من أن:"],["All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)","جميع ملفات .ks و .tjs في نص عادي (غير مجمعة، غير مشفرة، وغير محمية)"],["KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.","يجب أن تكون ألعاب KAG قابلة للعب حتى بدون إعادة التعبئة. لذا يجب التحقق مما إذا كانت لعبتك قابلة للعب بعد الاستخراج أم لا."],["Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>","بعض الإجراءات ستعدل لعبتك. <b>لذا تأكد من إنشاء نسخة احتياطية من لعبتك!</b>"],["Select the game executable file. This file is the main game file that will be used to extract the game data.","اختر ملف التنفيذ للعبة. هذا هو الملف الرئيسي للعبة الذي سيستخدم لاستخراج بيانات اللعبة."],["Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.","يمكن لـ Translator++ استخراج ملفات XP3 مع إضافة AEC. <b>لكن المستخرج ليس حلًا مضمونًا لجميع أنواع XP3</b>."],["Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.","بعض ملفات السيناريو مشفرة. حدد هذا الخيار إذا كنت ترغب في أن يحاول Translator++ فك تشفيرها."],["This may not work on some projects.","قد لا يعمل هذا على بعض المشاريع."],["List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.","قائمة ترميزات الأحرف المحتملة. <b>الترتيب مهم!</b>. يمكنك السحب لفرز القائمة."],["Literal tags are the tags that will be escaped into Translator++ editor.","الوسوم الحرفية هي الوسوم التي سيتم تهريبها إلى محرر Translator++."],["<b>ruby l r</b> are mandatory.","<b>ruby l r</b> إلزامية."],["<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.","<b>[r]</b> سيتم استبدال هذه الوسوم بواسطة Translator++ بسطر جديد. لذا لا تحتاج لكتابة <b>[r]</b> صراحةً."],["Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.","نص Kirikiri (.ks) قابل للتخصيص بشدة ويسمح للمطورين بإنشاء وسومهم الخاصة."],["Translator++ can handle standard tags such as character names that start with a sharp (#).","يمكن لـ Translator++ التعامل مع الوسوم القياسية مثل أسماء الشخصيات التي تبدأ بعلامة (#)."],["However, Translator++ cannot handle custom tags created by developers.","ومع ذلك، لا يمكن لـ Translator++ التعامل مع الوسوم المخصصة التي أنشأها المطورون."],["Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.","لذلك، قد تحتاج إلى تعريف الوسوم والسمات التي تحتاج إلى ترجمة وتلك التي يجب وضع علامة عليها كأسماء ممثلين."],["You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.","قد تحتاج إلى <input type=\"button\" value=\"استخراج لعبة xp3 الخاصة بك\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> وتحليل نص ks بداخلها قبل بدء المشروع."],["Create Project","إنشاء مشروع"],["Pack a folder into xp3","حزم مجلد إلى xp3"],["Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.","اختر ترميز الأحرف الهدف.<br />معظم ألعاب KAG اليابانية مكتوبة بـ SHIFT-JIS، لكن KAG يدعم في الواقع ترميز UTF16LE يونيكود. يحدد العديد من المترجمين ترميز الأحرف إلى UTF16LE حتى تكون اللعبة قابلة للعب على أنظمة ويندوز غير اليابانية بدون محاكي إعدادات محلية. والأهم من ذلك، يمكنها عرض أحرف خارج SHIFT-JIS مثل \"café\".<br />بشكل افتراضي، سيكتب Translator++ إلى ترميز الأحرف الأصلي."],["There are several ways to produce playable localized game for KAG. Please select one that suit your preference.","هناك عدة طرق لإنتاج لعبة KAG مترجمة قابلة للعب. يرجى اختيار ما يناسب تفضيلك."]],"context":[["tid/2913/type/StringLiteral"],["tid/2918/type/StringLiteral"],["tid/2925/type/StringLiteral"],["tid/2930/type/StringLiteral"],["tid/2937/type/StringLiteral"],["tid/2942/type/StringLiteral"],["tid/3173/type/StringLiteral"],["tid/3274/type/StringLiteral"],["tid/3325/type/StringLiteral"],["tid/3558/type/StringLiteral"],["tid/3684/type/NoSubstitutionTemplate"],["tid/3872/type/StringLiteral"],["tid/3929/type/StringLiteral"],["tid/4297/type/StringLiteral"],["tid/4302/type/StringLiteral"],["tid/4307/type/StringLiteral"],["tid/4312/type/StringLiteral"],["tid/4468/type/StringLiteral"],["tid/4508/type/StringLiteral"],["tid/4542/type/StringLiteral"],["tid/4549/type/StringLiteral"],["tid/4583/type/StringLiteral"],["tid/4631/type/StringLiteral"],["tid/4640/type/StringLiteral"],["tid/4649/type/StringLiteral"],["tid/5046/type/StringLiteral"],["tid/5053/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5067/type/StringLiteral"],["tid/5078/type/StringLiteral"],["tid/5389/type/StringLiteral"],["tid/6942/type/StringLiteral"],["tid/7218/type/StringLiteral","tid/7397/type/StringLiteral"],["tid/7462/type/StringLiteral"]],"basename":"kagParser.js","dirname":"/addons/kagParser","extension":".js","filename":"kagParser.js","path":"/addons/kagParser/kagParser.js","indexIsBuilt":false,"indexIds":{"Select directory":0,"Select a directory to repack":1,"Target xp3":2,"Select filename. Special filename such as <b>patch.xp3</b>, <b>patch2.xp3</b>...etc get priority over data.xp3 when loaded.":3,"Patch to allow folder structure":4,"By default KAG engine do not read files inside a folder within xp3 files. This option will automatically add folder structure definition to Config.tjs. Has no effect if no Config.tjs file is found.":5,"Repack into xp3":6,"Close":7,"Process":8,"<b>Order does matter</b> if you unpack multiple files at once! The files will be unpacked in ordered manner. If the files exist it will be overwritten.":9,"Unpack XP3 files":10,"Repack a folder to xp3":11,"Unpack xp3 file":12,"Before you create a new project, please make sure that :":13,"All .ks & .tjs files are in plain text (uncompiled, unscrambled, and unencrypted)":14,"KAG Games should be playable even without being repacked. So you should check whether your game is playable or not after being extracted.":15,"Some of the actions will modify your game. <b>So make sure to create a backup of your game!</b>":16,"Select the game executable file. This file is the main game file that will be used to extract the game data.":17,"Translator++ can extract XP3 files with AEC addon. <b>But the extractor is not a surefire solution for all kind XP3</b>.":18,"Some scenario files are encrypted. Check this option if you wish Translator++ to try to decrypt them.":19,"This may not work on some projects.":20,"List of the possible character encodings. <b>Order does matter!</b>. You can drag to sort the list.":21,"Literal tags are the tags that will be escaped into Translator++ editor.":22,"<b>ruby l r</b> are mandatory.":23,"<b>[r]</b> Tags will be interpolated by Translator++ into a new line. So you don't need to write <b>[r]</b> explicitly.":24,"Kirikiri script (.ks) is heavily customizable and allows developers to create their own tags.":25,"Translator++ can handle standard tags such as character names that start with a sharp (#).":26,"However, Translator++ cannot handle custom tags created by developers.":27,"Therefore, you may need to define the tags and attributes that need to be translated and those that need to be marked as actor names.":28,"You might need to <input type=\"button\" value=\"extract your xp3 game\" onclick=\"addonLoader.addons.kagParser.utils.unpackXP3Dialog()\" /> and analyze the ks script inside it before starting the project.":29,"Create Project":30,"Pack a folder into xp3":31,"Select the target character encoding.<br />Most Japanese KAG games are written with SHIFT-JIS, but KAG actually has support for UTF16LE unicode. Many translators set the character encoding to UTF16LE so that the game is playable non-Japanese windows without locale emulator. And most importantly, can displays characters outside SHIFT-JIS such as \"café\".<br />By default Translator++ will write to its original character encoding.":32,"There are several ways to produce playable localized game for KAG. Please select one that suit your preference.":33},"tags":[],"relPath":"/addons/kagParser/kagParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/addons/po/ExportImport.js":{"data":[["Select mode","اختر الوضع"],["Select how do you want to start your project. By selecting files or folders.","اختر كيف تريد بدء مشروعك. عن طريق اختيار ملفات أو مجلدات."],["Select Folder","اختر مجلد"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","اختر المجلد للمعالجة. سيقوم Translator++ باسترجاع ملفات PO بشكل متكرر من المجلد المحدد."],["Select File","اختر ملف"],["Select the files you want to process.","اختر الملفات التي تريد معالجتها."],["Filters","مرشحات"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","قم بتصفية اسم الملف باستخدام نمط glob. الافتراضي هو <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","جميع ملفات .po في المجلد المحدد والمجلدات الفرعية له."],["All .mo files in the selected folder and its subfolders.","جميع ملفات .mo في المجلد المحدد والمجلدات الفرعية له."],["PO Files","ملفات PO"],["MO Files","ملفات MO"],["You are about to export the translations as MO files.\n","أنت على وشك تصدير الترجمات كملفات MO.\n"],["- MO files are binary files that cannot be edited manually.\n","- ملفات MO هي ملفات ثنائية لا يمكن تحريرها يدويًا.\n"],["- Only translated entries are stored in MO files.\n","- يتم تخزين الإدخالات المترجمة فقط في ملفات MO.\n"],["Are you sure you want to proceed?","هل أنت متأكد أنك تريد المتابعة؟"],["PO / MO Files","ملفات PO / MO"]],"context":[["tid/1174/type/StringLiteral"],["tid/1196/type/StringLiteral"],["tid/1223/type/StringLiteral"],["tid/1233/type/StringLiteral"],["tid/1267/type/StringLiteral"],["tid/1277/type/StringLiteral"],["tid/1317/type/StringLiteral"],["tid/1327/type/StringLiteral"],["tid/1335/type/StringLiteral"],["tid/1340/type/StringLiteral"],["tid/2342/type/StringLiteral"],["tid/2509/type/StringLiteral"],["tid/2534/type/StringLiteral"],["tid/2542/type/StringLiteral"],["tid/2550/type/StringLiteral"],["tid/2558/type/StringLiteral"],["tid/2747/type/StringLiteral"]],"basename":"ExportImport.js","dirname":"/addons/po","extension":".js","filename":"ExportImport.js","path":"/addons/po/ExportImport.js","indexIsBuilt":false,"indexIds":{"Select mode":0,"Select how do you want to start your project. By selecting files or folders.":1,"Select Folder":2,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":3,"Select File":4,"Select the files you want to process.":5,"Filters":6,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":7,"All .po files in the selected folder and its subfolders.":8,"All .mo files in the selected folder and its subfolders.":9,"PO Files":10,"MO Files":11,"You are about to export the translations as MO files.\n":12,"- MO files are binary files that cannot be edited manually.\n":13,"- Only translated entries are stored in MO files.\n":14,"Are you sure you want to proceed?":15,"PO / MO Files":16},"tags":[],"relPath":"/addons/po/ExportImport.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":17,"length":17,"percent":100},"parameters":[]},"/addons/po/PoParser.js":{"data":[[".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.","ملفات .po و .mo هي تنسيقات ملفات قياسية تعتمد على النص والثنائي تُستخدم معًا لتدويل البرمجيات، خاصة في ووردبريس، لترجمة القوالب والإضافات. ملف PO (Portable Object) هو نص قابل للقراءة البشرية يحتوي على الترجمات، بينما ملف MO (Machine Object) هو ملف ثنائي مُجمَّع قابل للقراءة الآلية يُستخدم من قبل البرمجيات لتحميل أسرع."],["Start translation from PO (Portable Object) and MO (Machine Object) translation scripts","ابدأ الترجمة من نصوص ترجمة PO (Portable Object) و MO (Machine Object)"],["Create Project","إنشاء مشروع"],["Select mode","اختر الوضع"],["Select how do you want to start your project. By selecting files or folders.","اختر كيف تريد بدء مشروعك. عن طريق اختيار الملفات أو المجلدات."],["Select Folder","اختر مجلد"],["Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.","اختر المجلد للمعالجة. سيقوم Translator++ باسترداد ملفات PO بشكل متكرر من المجلد المحدد."],["Select File","اختر ملف"],["Select the files you want to process.","اختر الملفات التي تريد معالجتها."],["Filters","مرشحات"],["Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>","تصفية اسم الملف بنمط glob. الافتراضي هو <code>**/*.{po,mo}</code>"],["All .po files in the selected folder and its subfolders.","جميع ملفات .po في المجلد المحدد ومجلداته الفرعية."],["All .mo files in the selected folder and its subfolders.","جميع ملفات .mo في المجلد المحدد ومجلداته الفرعية."],["ProjectTitle","عنوان المشروع"],["Your project title","عنوان مشروعك"]],"context":[["tid/907/type/StringLiteral"],["tid/951/type/StringLiteral"],["tid/1028/type/StringLiteral"],["tid/1488/type/StringLiteral"],["tid/1510/type/StringLiteral"],["tid/1537/type/StringLiteral"],["tid/1547/type/StringLiteral"],["tid/1580/type/StringLiteral"],["tid/1590/type/StringLiteral"],["tid/1623/type/StringLiteral"],["tid/1633/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1646/type/StringLiteral"],["tid/1681/type/StringLiteral"],["tid/1691/type/StringLiteral"]],"basename":"PoParser.js","dirname":"/addons/po","extension":".js","filename":"PoParser.js","path":"/addons/po/PoParser.js","indexIsBuilt":false,"indexIds":{".po and .mo files are standard text-based and binary file formats used together for software localization, particularly in WordPress, to translate themes and plugins. The PO (Portable Object) file is human-readable text containing translations, while the MO (Machine Object) file is a compiled, machine-readable binary file used by software for faster loading.":0,"Start translation from PO (Portable Object) and MO (Machine Object) translation scripts":1,"Create Project":2,"Select mode":3,"Select how do you want to start your project. By selecting files or folders.":4,"Select Folder":5,"Select the folder for processing. Translator++ will recursively retrieve the PO files from the specified folder.":6,"Select File":7,"Select the files you want to process.":8,"Filters":9,"Filter the file name with glob pattern. Default is <code>**/*.{po,mo}</code>":10,"All .po files in the selected folder and its subfolders.":11,"All .mo files in the selected folder and its subfolders.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/po/PoParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/pylivemakerParser/plmUtils.js":{"data":[["Livemaker Game Extractor","مستخرج ألعاب Livemaker"],["Half width character patch","تصحيح أحرف العرض النصفي"],["Patch half-width character","تصحيح أحرف العرض النصفي"]],"context":[["tid/347/type/StringLiteral"],["tid/809/type/NoSubstitutionTemplate","tid/870/type/NoSubstitutionTemplate"],["tid/1061/type/StringLiteral"]],"basename":"plmUtils.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"plmUtils.js","path":"/addons/pylivemakerParser/plmUtils.js","indexIsBuilt":false,"indexIds":{"Livemaker Game Extractor":0,"Half width character patch":1,"Patch half-width character":2},"tags":[],"relPath":"/addons/pylivemakerParser/plmUtils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/pylivemakerParser/pylivemakerparser.js":{"data":[["Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings","محرك Livemaker له قيود فيما يتعلق بدعم اللغة. يتطلب تعيين إعدادات النظام غير اليونيكود في Windows إلى اليابانية لتشغيل تطبيقات LiveMaker وLiveNovel. بالإضافة إلى ذلك، المحرك مبرمج لاستخدام خطوط نظام Windows المثبتة فقط التي تدعم Windows Shift-JIS (MS CP932)، مما يعني أنه قد لا يدعم إعدادات محلية أو ترميزات أخرى"],["Next","التالي"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?","غير قادر على اكتشاف نوع RPG Maker!\nهل أنت متأكد أن اللعبة هي RPG Maker XP أو VX أو VX Ace؟"],["Create a new project","إنشاء مشروع جديد"],["Invalid destination file:","ملف الوجهة غير صالح:"],[" doesn't seems to be a LiveMaker game."," لا يبدو أنها لعبة LiveMaker."]],"context":[["tid/5574/type/NoSubstitutionTemplate"],["tid/5684/type/StringLiteral"],["tid/6243/type/StringLiteral"],["tid/6541/type/StringLiteral"],["tid/6626/type/NoSubstitutionTemplate"],["tid/6662/type/NoSubstitutionTemplate"]],"basename":"pylivemakerparser.js","dirname":"/addons/pylivemakerParser","extension":".js","filename":"pylivemakerparser.js","path":"/addons/pylivemakerParser/pylivemakerparser.js","indexIsBuilt":false,"indexIds":{"Livemaker engine has limitations regarding language support. It requires setting the Windows non-unicode system locale to Japanese to run LiveMaker and LiveNovel applications. Additionally, the engine is hardcoded to only use installed Windows system fonts that support Windows Shift-JIS (MS CP932), which means it may not supports other locales or encodings":0,"Next":1,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker XP, VX or VX Ace?":2,"Create a new project":3,"Invalid destination file:":4," doesn't seems to be a LiveMaker game.":5},"tags":[],"relPath":"/addons/pylivemakerParser/pylivemakerparser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/renParser/renParser.js":{"data":[["Dev path is not defined.\nYou should inject your game once to generate dev path.","مسار التطوير غير محدد.\nيجب عليك حقن لعبتك مرة واحدة لإنشاء مسار التطوير."],["Decompile all rpyc files","تفكيك جميع ملفات rpyc"],["Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.","محاولة تفكيك جميع ملفات rpyc إلى .rpy.<br />يحتوي Translator++ على مفككه الخاص. ولكن تم الإبلاغ عن أنه يفشل أحيانًا في تفكيك بعض الألعاب المصنوعة بـ Renpy 7. يمكنك ترك هذا الحقل غير محدد وتفكيك اللعبة بنفسك باستخدام أدواتك الخاصة قبل بدء المشروع."],["Overwrite rpy","كتابة rpy فوق"],["If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.","إذا تم تحديده، فإن المفكك <b>سيكتب فوق ملفات rpy غير المترجمة الموجودة</b>."],["Exclude command","استبعاد الأمر"],["This option will allow us to skip some command for being processed and translated","هذا الخيار سيسمح لنا بتخطي بعض الأوامر لمعالجتها وترجمتها"],["Separate entries with a space","افصل المدخلات بمسافة"],["For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored","على سبيل المثال، إذا وضعت <b>قديم</b> فسيتم تجاهل جميع الأسطر في rpy التي تبدأ بـ <b>قديم</b>"],["Are you sure want to start a project without decompiling the rpyc files?","هل أنت متأكد من أنك تريد بدء مشروع دون فك تشفير ملفات rpyc؟"],["The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?","الملف الذي حددته ليس ملف تنفيذي للعبة Ren'Py.\nهل تريد المتابعة على أي حال؟"],["Play last build","تشغيل آخر بناء"],["Open Ren'Py documentation","فتح وثائق Ren'Py"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","تم تعيين الخيار لاستخدام المحلل القديم.\nيمكنك العودة إلى المحلل الجديد في أي وقت عبر قائمة الخيارات."]],"context":[["tid/6255/type/StringLiteral","tid/11918/type/StringLiteral"],["tid/10916/type/StringLiteral"],["tid/10921/type/StringLiteral"],["tid/10926/type/StringLiteral"],["tid/10931/type/StringLiteral"],["tid/10936/type/StringLiteral"],["tid/10941/type/StringLiteral"],["tid/10946/type/StringLiteral"],["tid/10951/type/StringLiteral"],["tid/11291/type/StringLiteral"],["tid/11456/type/StringLiteral"],["tid/11869/type/StringLiteral"],["tid/11970/type/StringLiteral"],["tid/12146/type/StringLiteral"]],"basename":"renParser.js","dirname":"/addons/renParser","extension":".js","filename":"renParser.js","path":"/addons/renParser/renParser.js","indexIsBuilt":false,"indexIds":{"Dev path is not defined.\nYou should inject your game once to generate dev path.":0,"Decompile all rpyc files":1,"Attempt to decompile all rpyc files into .rpy.<br />Translator++ has its own decompiler. But it is reported that sometimes it fails to decompile some of the games created with Renpy 7. You can leave this field unchecked and decompile the game yourself with your own tools before starting a project.":2,"Overwrite rpy":3,"If checked then the decompiler <b>will overwrite the existing uncompiled rpy files</b>.":4,"Exclude command":5,"This option will allow us to skip some command for being processed and translated":6,"Separate entries with a space":7,"For example, if you put <b>old</b> then all lines in rpy that started with <b>old</b> will be ignored":8,"Are you sure want to start a project without decompiling the rpyc files?":9,"The file you're selected is not a Ren'Py game executable file.\nDo you want to continue anyway?":10,"Play last build":11,"Open Ren'Py documentation":12,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":13},"tags":[],"relPath":"/addons/renParser/renParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":14,"length":14,"percent":100},"parameters":[]},"/addons/resourceParser/ResourceParser.js":{"data":[["Windows binary file translator","مترجم ملفات ثنائية ويندوز"],["Parsing Windows binary file with","تحليل ملف ثنائي ويندوز مع"],["Sellect supported files","اختر الملفات المدعومة"],["Select supported file type to translate.","اختر نوع الملف المدعوم للترجمة."],["Create a new project","إنشاء مشروع جديد"],["Please select a supported file to parse","يرجى اختيار ملف مدعوم للتحليل"],["Please enter your project title!","يرجى إدخال عنوان مشروعك!"]],"context":[["tid/4109/type/StringLiteral"],["tid/4114/type/StringLiteral"],["tid/4127/type/StringLiteral"],["tid/4132/type/StringLiteral"],["tid/4469/type/StringLiteral"],["tid/4550/type/StringLiteral","tid/4600/type/StringLiteral"],["tid/4661/type/StringLiteral"]],"basename":"ResourceParser.js","dirname":"/addons/resourceParser","extension":".js","filename":"ResourceParser.js","path":"/addons/resourceParser/ResourceParser.js","indexIsBuilt":false,"indexIds":{"Windows binary file translator":0,"Parsing Windows binary file with":1,"Sellect supported files":2,"Select supported file type to translate.":3,"Create a new project":4,"Please select a supported file to parse":5,"Please enter your project title!":6},"tags":[],"relPath":"/addons/resourceParser/ResourceParser.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":7,"length":7,"percent":100},"parameters":[]},"/addons/rm2k2k3/2k.js":{"data":[["Use Native RPG Player","استخدام مشغل RPG الأصلي"],["Use native RPG Player instead of Easy RPG Player","استخدم مشغل RPG الأصلي بدلاً من مشغل Easy RPG"],["Use native RPG Player","استخدم مشغل RPG الأصلي"],["Target folder","المجلد الهدف"],["Select destination folder.","اختر مجلد الوجهة."],["Install Easy RPG Player","تثبيت مشغل Easy RPG"],["Close","إغلاق"],["Install","تثبيت"],["Process completed!","اكتملت العملية!"],["RPG Maker 2000 & 2003 Parser with xmlTrans plugin.","محلل RPG Maker 2000 و 2003 مع إضافة xmlTrans."],["Play last build","تشغيل آخر بناء"],["Apply translation then play","تطبيق الترجمة ثم التشغيل"],["Setup Easy RPG in the current directory","إعداد Easy RPG في المجلد الحالي"]],"context":[["tid/164/type/StringLiteral"],["tid/174/type/StringLiteral"],["tid/184/type/StringLiteral"],["tid/5955/type/StringLiteral"],["tid/5960/type/StringLiteral"],["tid/6034/type/StringLiteral"],["tid/6151/type/StringLiteral"],["tid/6202/type/StringLiteral"],["tid/6393/type/StringLiteral"],["tid/7198/type/NoSubstitutionTemplate"],["tid/8288/type/StringLiteral"],["tid/8344/type/StringLiteral"],["tid/8395/type/StringLiteral"]],"basename":"2k.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2k.js","path":"/addons/rm2k2k3/2k.js","indexIsBuilt":false,"indexIds":{"Use Native RPG Player":0,"Use native RPG Player instead of Easy RPG Player":1,"Use native RPG Player":2,"Target folder":3,"Select destination folder.":4,"Install Easy RPG Player":5,"Close":6,"Install":7,"Process completed!":8,"RPG Maker 2000 & 2003 Parser with xmlTrans plugin.":9,"Play last build":10,"Apply translation then play":11,"Setup Easy RPG in the current directory":12},"tags":[],"relPath":"/addons/rm2k2k3/2k.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":13,"length":13,"percent":100},"parameters":[]},"/addons/rm2k2k3/2knew.js":{"data":[["Start translation from RM2k / RM2k3 engine","بدء الترجمة من محرك RM2k / RM2k3"],["Create project","إنشاء مشروع"],["Please select RPG Maker 2000/2003 game!","يرجى اختيار لعبة RPG Maker 2000/2003!"],["Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?","تعذر اكتشاف نوع RPG Maker!\nهل أنت متأكد أن اللعبة هي RPG Maker 2000 / 2003؟"]],"context":[["tid/3902/type/StringLiteral"],["tid/3971/type/StringLiteral"],["tid/4041/type/StringLiteral"],["tid/4450/type/StringLiteral"]],"basename":"2knew.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"2knew.js","path":"/addons/rm2k2k3/2knew.js","indexIsBuilt":false,"indexIds":{"Start translation from RM2k / RM2k3 engine":0,"Create project":1,"Please select RPG Maker 2000/2003 game!":2,"Unable to detect RPG Maker type!\nAre you sure the game is RPG Maker 2000 / 2003?":3},"tags":[],"relPath":"/addons/rm2k2k3/2knew.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/rm2k2k3/utils.js":{"data":[["Target folder","المجلد الهدف"],["Select destination folder.","اختر مجلد الوجهة."],["Install Easy RPG Player","تثبيت مشغل Easy RPG"],["Close","إغلاق"],["Install","تثبيت"],["How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/","كيفية إضافة خط مخصص.\n\nيجب وضع الخطوط في مجلد Font الخاص بدليل اللعبة ويجب تسميتها Font.ttf أو Font2.ttf. أي ملف خط يُستخدم يعتمد على إعداد خط النظام الرسومي. بالإضافة إلى ttf، يتم دعم fon والعديد من الخطوط الأخرى (أي شيء يدعمه FreeType، أفضل مكتبة مفتوحة المصدر متاحة لعرض الخطوط).\n\nالمصدر: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/"],["Process completed!","اكتملت العملية!"],["Play last build","تشغيل آخر بناء"],["Apply translation then play","تطبيق الترجمة ثم التشغيل"],["Setup Easy RPG in the current directory","إعداد Easy RPG في المجلد الحالي"]],"context":[["tid/934/type/StringLiteral"],["tid/939/type/StringLiteral"],["tid/1013/type/StringLiteral"],["tid/1130/type/StringLiteral"],["tid/1181/type/StringLiteral"],["tid/1402/type/NoSubstitutionTemplate"],["tid/1450/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1743/type/StringLiteral"],["tid/1796/type/StringLiteral"]],"basename":"utils.js","dirname":"/addons/rm2k2k3","extension":".js","filename":"utils.js","path":"/addons/rm2k2k3/utils.js","indexIsBuilt":false,"indexIds":{"Target folder":0,"Select destination folder.":1,"Install Easy RPG Player":2,"Close":3,"Install":4,"How to add a custom font.\n\nThe fonts must be placed in the Font folder of the game directory and must be named Font.ttf or Font2.ttf. Which font file is used depends on the system graphic font setting. Besides ttf, fon and many other fonts are supported (anything supported by FreeType, the best open source library available for font rendering).\n\nSource: https://blog.easyrpg.org/2023/04/easyrpg-player-0-8-paralyze/":5,"Process completed!":6,"Play last build":7,"Apply translation then play":8,"Setup Easy RPG in the current directory":9},"tags":[],"relPath":"/addons/rm2k2k3/utils.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/rmmv/rmmv.js":{"data":[["Beautify JSON data","تجميل بيانات JSON"],["When checked the generated data will be beautified.","عند التحديد، سيتم تجميل البيانات المُنشأة."],["Error loading system.json","خطأ في تحميل system.json"],["Loading","جارٍ التحميل"],["index.html not found in","لم يتم العثور على index.html في"],["Encrypted game","لعبة مشفرة"],["Select the index.html of your encrypted game.","اختر index.html للعبة المشفرة الخاصة بك."],["Target folder","المجلد الهدف"],["Select destination folder. The process will replace the existing files.","اختر مجلد الوجهة. ستستبدل العملية الملفات الموجودة."],["Decrypt Resources","فك تشفير الموارد"],["Close","إغلاق"],["Process","معالجة"],["Source path can not empty","مسار المصدر لا يمكن أن يكون فارغًا"],["Destination path can not empty","مسار الوجهة لا يمكن أن يكون فارغًا"],["Path is not a file:","المسار ليس ملفًا:"],["Invalid directory:","دليل غير صالح:"],["Extract enigma","استخراج enigma"],["Select enigma file.","اختر ملف enigma."],["Extract Enigma","استخراج إنغما"],["Selected file is not an Enigma Virtual Box package.","الملف المحدد ليس حزمة إنغما فيرتشوال بوكس."],["Plugins are already fetched for this project. Want to re-fetch the plugins?","تم جلب الإضافات بالفعل لهذا المشروع. هل تريد إعادة جلب الإضافات؟"],["Translate Javascript File?","ترجمة ملف جافاسكريبت؟"],["Cancel","إلغاء"],["I know the risk, Proceed!","أعرف المخاطر، تابع!"],["Game Executable Path","مسار ملف تشغيل اللعبة"],["Path to the game executable file (.exe)","مسار ملف تشغيل اللعبة (.exe)"],["NWJS Version","إصدار NWJS"],["Change into this NWJS version","التغيير إلى إصدار NWJS هذا"],["Use Developer version","استخدام الإصدار المطور"],["Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.","استخدام إصدار مطور NWJS. يحتوي إصدار المطور على أدوات مطور متاحة. مناسب للتصحيح والتطوير."],["In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.","في إصدار المطور يمكنك استخدام <b>وحدة تحكم المطور</b>. يمكن الوصول إلى وحدة تحكم المطور بالضغط على F12 أو النقر بزر الماوس الأيمن على التطبيق واختيار 'فحص'."],["Use 32-bit version","استخدام الإصدار 32 بت"],["Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).","استخدام إصدار NWJS 32 بت. الإصدار 32 بت مفيد للتشغيل مع الأنظمة القديمة. يُوصى بإلغاء تحديد هذا الخيار إن أمكن (فقط قم بترقية جهازك، يا صديق)."],["Some game feature may not work across NWJS version","قد لا تعمل بعض ميزات اللعبة عبر إصدارات NWJS"],["Please be aware that some game feature may not work across NWJS version.","يرجى العلم بأن بعض ميزات اللعبة قد لا تعمل عبر إصدارات NWJS."],["Change RPG Maker MV / RPG Maker MZ / NWJS version","تغيير إصدار RPG Maker MV / RPG Maker MZ / NWJS"],["This operation will change the NW.js version into","هذه العملية ستغير إصدار NW.js إلى"],["Please close the application first before continuing.\nDo you want to continue?","يرجى إغلاق التطبيق أولاً قبل المتابعة.\nهل تريد المتابعة؟"],["The selected file is not a valid NW.js application.","الملف المحدد ليس تطبيق NW.js صالحًا."],["Could not find index.html in the game directory.","تعذر العثور على index.html في دليل اللعبة."],["Debug menu script not found in addon directory.","لم يتم العثور على نص قائمة التصحيح في دليل الإضافات."],["Debug menu script is already installed in index.html.","نص قائمة التصحيح مثبت بالفعل في index.html."],["Debug options installed successfully!","تم تثبيت خيارات التصحيح بنجاح!"],["The selected game is not running in NW.js Developer Mode (SDK).\n\n","اللعبة المحددة لا تعمل في وضع المطور لـ NW.js (SDK).\n\n"],["Developer Mode provides additional debugging features:\n","يوفر وضع المطور ميزات تصحيح إضافية:\n"],["• Developer Console (F12)\n","• وحدة تحكم المطور (F12)\n"],["• Inspect Element (Right-click)\n","• فحص العنصر (النقر بزر الماوس الأيمن)\n"],["• Network Monitor\n","• مراقب الشبكة\n"],["• Performance Profiler\n\n","• محلل الأداء\n\n"],["Do you want to upgrade to NW.js Developer Mode?\n","هل تريد الترقية إلى وضع المطور لـ NW.js؟\n"],["(Recommended for better debugging experience)","(موصى به لتجربة تصحيح أفضل)"],["The game will be upgraded to NW.js SDK version","سيتم ترقية اللعبة إلى إصدار NW.js SDK"],["This may take a few minutes. Please wait...","قد يستغرق هذا بضع دقائق. يرجى الانتظار..."],["NW.js has been upgraded to Developer Mode successfully!","تمت ترقية NW.js إلى وضع المطور بنجاح!"],["Failed to upgrade to Developer Mode:\n","فشل الترقية إلى وضع المطور:\n"],["Error installing debug options: ","خطأ في تثبيت خيارات التصحيح: "],["Install Debug Options","تثبيت خيارات التصحيح"],["This will install a debug menu into your RPG Maker MV/MZ game.","سيؤدي هذا إلى تثبيت قائمة تصحيح في لعبة RPG Maker MV/MZ الخاصة بك."],["Select the game executable file to install debug options.","اختر ملف التنفيذ الخاص باللعبة لتثبيت خيارات التصحيح."],["Compile HTML to Executable","تجميع HTML إلى ملف تنفيذي"],["Change Existing NWJS Version","تغيير إصدار NWJS الحالي"],["Install debug options","تثبيت خيارات التصحيح"],["Find next","ابحث عن التالي"],["Open folder","فتح المجلد"],["Open with external application","فتح باستخدام تطبيق خارجي"],["Raw JSON data. Right click to open menu.","بيانات JSON خام. انقر بزر الماوس الأيمن لفتح القائمة."],["Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)","يتوفر تصحيح لهذه البيانات المترجمة. سيؤدي هذا التصحيح إلى جعل بياناتك المترجمة متوافقة مع الإصدار الحالي من Translator++.\nهل تريد تصحيح بياناتك المترجمة؟\n(قد لا تعمل بعض الميزات بشكل صحيح إذا لم تقم بتصحيح بياناتك المترجمة)"],["Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.","تعذر العثور على ملف التنفيذ لتثبيت خيارات التصحيح. تأكد من أن لعبتك معبأة لنظام Windows باستخدام NW.js."],["Error while installing debug options: ","خطأ أثناء تثبيت خيارات التصحيح: "],["Play last build","تشغيل آخر بناء"],["Dev path is not defined.\nYou should inject your game once to generate dev path.","مسار التطوير غير محدد.\nيجب عليك حقن لعبتك مرة واحدة لتوليد مسار التطوير."],["Open editor","فتح المحرر"],["Load Plugins Into Project","تحميل الإضافات إلى المشروع"],["Compile Game","تجميع اللعبة"],["The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.","تم تعيين الخيار لاستخدام المحلل القديم.\nيمكنك العودة إلى المحلل الجديد في أي وقت عبر قائمة الخيارات."],["Unable to find the file related to the data","تعذر العثور على الملف المتعلق بالبيانات"],["To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>","لإصلاح هذا، صحح حقل <b>موقع المواد الخام</b> في <a href=\"#\" class=\"openProjectProperties\">خصائص المشروع</a>"],["Maximum dialog line","أقصى سطر للحوار"],["Maximum line in the dialog box. Default is 4.","الحد الأقصى للأسطر في مربع الحوار. الافتراضي هو 4."],["Add debug options","إضافة خيارات التصحيح"],["Add debug options into the game to help testing.","أضف خيارات التصحيح إلى اللعبة للمساعدة في الاختبار."],["Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>","قم بتفعيل هذا الخيار لإضافة أدوات التصحيح إلى اللعبة. هذه الميزات يمكن أن تساعدك في اختبار ترجمتك.<br/><b>⚠️ ملاحظة: هذا الخيار متاح فقط إذا كانت لعبتك معبأة مع NWJS لنظام Windows.</b>"]],"context":[["tid/125/type/StringLiteral","tid/152/type/StringLiteral"],["tid/135/type/StringLiteral"],["tid/16151/type/StringLiteral"],["tid/19426/type/StringLiteral","tid/19469/type/StringLiteral"],["tid/20448/type/StringLiteral"],["tid/20619/type/StringLiteral"],["tid/20624/type/StringLiteral"],["tid/20635/type/StringLiteral","tid/21231/type/StringLiteral"],["tid/20640/type/StringLiteral","tid/21236/type/StringLiteral"],["tid/20713/type/StringLiteral","tid/30541/type/StringLiteral"],["tid/20814/type/StringLiteral","tid/21410/type/StringLiteral"],["tid/20865/type/StringLiteral","tid/21461/type/StringLiteral"],["tid/20925/type/StringLiteral"],["tid/20962/type/StringLiteral"],["tid/20992/type/StringLiteral"],["tid/21023/type/StringLiteral"],["tid/21215/type/StringLiteral"],["tid/21220/type/StringLiteral"],["tid/21309/type/StringLiteral"],["tid/21564/type/StringLiteral"],["tid/21678/type/StringLiteral"],["tid/22062/type/StringLiteral"],["tid/22163/type/StringLiteral"],["tid/22214/type/StringLiteral"],["tid/22424/type/StringLiteral","tid/24166/type/StringLiteral"],["tid/22434/type/StringLiteral","tid/24176/type/StringLiteral"],["tid/22468/type/StringLiteral"],["tid/22478/type/StringLiteral"],["tid/22512/type/StringLiteral","tid/22962/type/StringLiteral"],["tid/22522/type/StringLiteral"],["tid/22533/type/StringLiteral"],["tid/22560/type/StringLiteral","tid/22986/type/StringLiteral"],["tid/22570/type/StringLiteral"],["tid/22605/type/NoSubstitutionTemplate"],["tid/22610/type/NoSubstitutionTemplate"],["tid/23014/type/NoSubstitutionTemplate"],["tid/23119/type/NoSubstitutionTemplate"],["tid/23148/type/NoSubstitutionTemplate"],["tid/23298/type/StringLiteral"],["tid/23453/type/StringLiteral"],["tid/23555/type/StringLiteral"],["tid/23696/type/StringLiteral"],["tid/23770/type/StringLiteral"],["tid/23812/type/StringLiteral"],["tid/23820/type/StringLiteral"],["tid/23828/type/StringLiteral"],["tid/23836/type/StringLiteral"],["tid/23844/type/StringLiteral"],["tid/23852/type/StringLiteral"],["tid/23860/type/StringLiteral"],["tid/23868/type/StringLiteral"],["tid/23922/type/NoSubstitutionTemplate"],["tid/23931/type/NoSubstitutionTemplate"],["tid/23972/type/StringLiteral"],["tid/24005/type/StringLiteral"],["tid/24068/type/StringLiteral"],["tid/24217/type/NoSubstitutionTemplate","tid/24282/type/NoSubstitutionTemplate"],["tid/24222/type/NoSubstitutionTemplate"],["tid/24227/type/NoSubstitutionTemplate"],["tid/24482/type/StringLiteral"],["tid/24546/type/StringLiteral"],["tid/24598/type/StringLiteral"],["tid/24781/type/StringLiteral"],["tid/24891/type/StringLiteral"],["tid/24981/type/StringLiteral"],["tid/25166/type/NoSubstitutionTemplate"],["tid/26021/type/StringLiteral"],["tid/29743/type/StringLiteral"],["tid/29779/type/StringLiteral"],["tid/30242/type/StringLiteral"],["tid/30291/type/StringLiteral","tid/30388/type/StringLiteral"],["tid/30339/type/StringLiteral"],["tid/30443/type/StringLiteral"],["tid/30705/type/StringLiteral"],["tid/30891/type/StringLiteral"],["tid/31622/type/NoSubstitutionTemplate"],["tid/31627/type/NoSubstitutionTemplate"],["tid/32659/type/StringLiteral","tid/32882/type/StringLiteral"],["tid/32669/type/StringLiteral","tid/32892/type/StringLiteral"],["tid/32935/type/StringLiteral"],["tid/32945/type/StringLiteral"],["tid/33021/type/StringLiteral"]],"basename":"rmmv.js","dirname":"/addons/rmmv","extension":".js","filename":"rmmv.js","path":"/addons/rmmv/rmmv.js","indexIsBuilt":false,"indexIds":{"Beautify JSON data":0,"When checked the generated data will be beautified.":1,"Error loading system.json":2,"Loading":3,"index.html not found in":4,"Encrypted game":5,"Select the index.html of your encrypted game.":6,"Target folder":7,"Select destination folder. The process will replace the existing files.":8,"Decrypt Resources":9,"Close":10,"Process":11,"Source path can not empty":12,"Destination path can not empty":13,"Path is not a file:":14,"Invalid directory:":15,"Extract enigma":16,"Select enigma file.":17,"Extract Enigma":18,"Selected file is not an Enigma Virtual Box package.":19,"Plugins are already fetched for this project. Want to re-fetch the plugins?":20,"Translate Javascript File?":21,"Cancel":22,"I know the risk, Proceed!":23,"Game Executable Path":24,"Path to the game executable file (.exe)":25,"NWJS Version":26,"Change into this NWJS version":27,"Use Developer version":28,"Use the NWJS Developer version. The Developer version has developer tools available. Suitable for debugging and development.":29,"In Developer version you can use <b>Developer Console</b>. Developer Console can be accessed by pressing F12 or right-clicking the app and selecting 'Inspect'.":30,"Use 32-bit version":31,"Use the 32-bit version of NWJS. The 32-bit version is useful for compatibility with older systems. It is recommended to uncheck this option if possible (just upgrade your machine, dude).":32,"Some game feature may not work across NWJS version":33,"Please be aware that some game feature may not work across NWJS version.":34,"Change RPG Maker MV / RPG Maker MZ / NWJS version":35,"This operation will change the NW.js version into":36,"Please close the application first before continuing.\nDo you want to continue?":37,"The selected file is not a valid NW.js application.":38,"Could not find index.html in the game directory.":39,"Debug menu script not found in addon directory.":40,"Debug menu script is already installed in index.html.":41,"Debug options installed successfully!":42,"The selected game is not running in NW.js Developer Mode (SDK).\n\n":43,"Developer Mode provides additional debugging features:\n":44,"• Developer Console (F12)\n":45,"• Inspect Element (Right-click)\n":46,"• Network Monitor\n":47,"• Performance Profiler\n\n":48,"Do you want to upgrade to NW.js Developer Mode?\n":49,"(Recommended for better debugging experience)":50,"The game will be upgraded to NW.js SDK version":51,"This may take a few minutes. Please wait...":52,"NW.js has been upgraded to Developer Mode successfully!":53,"Failed to upgrade to Developer Mode:\n":54,"Error installing debug options: ":55,"Install Debug Options":56,"This will install a debug menu into your RPG Maker MV/MZ game.":57,"Select the game executable file to install debug options.":58,"Compile HTML to Executable":59,"Change Existing NWJS Version":60,"Install debug options":61,"Find next":62,"Open folder":63,"Open with external application":64,"Raw JSON data. Right click to open menu.":65,"Patch is available for this trans data. This patch will make your trans data compatible with the current version of Translator++.\nDo you want to patch your Trans data?\n(Some feature may not work properly if you don't patch your trans data)":66,"Unable to locate executable to install debug options. Make sure your game is packaged for Windows with NW.js.":67,"Error while installing debug options: ":68,"Play last build":69,"Dev path is not defined.\nYou should inject your game once to generate dev path.":70,"Open editor":71,"Load Plugins Into Project":72,"Compile Game":73,"The option has been set to use the legacy parser.\nYou can switch back to the new parser anytime via option menu.":74,"Unable to find the file related to the data":75,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":76,"Maximum dialog line":77,"Maximum line in the dialog box. Default is 4.":78,"Add debug options":79,"Add debug options into the game to help testing.":80,"Enable this option to add debugging tools to the game. These features can help you test your translation.<br/><b>⚠️ Note: This option is only available if your game is packaged with NWJS for Windows.</b>":81},"tags":[],"relPath":"/addons/rmmv/rmmv.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":82,"length":82,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu-map-preview.js":{"data":[["This feature only available if you are using Developer version of NWJS.","هذه الميزة متاحة فقط إذا كنت تستخدم إصدار المطور من NWJS."]],"context":[["tid/19679/type/StringLiteral"]],"basename":"dv-debugmenu-map-preview.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu-map-preview.js","path":"/addons/rmmv/src/dv-debugmenu-map-preview.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of NWJS.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu-map-preview.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmmv/src/dv-debugmenu.js":{"data":[["This feature only available if you are using developer version of NW.js.","هذه الميزة متاحة فقط إذا كنت تستخدم إصدار المطور من NW.js."]],"context":[["tid/22924/type/StringLiteral"]],"basename":"dv-debugmenu.js","dirname":"/addons/rmmv/src","extension":".js","filename":"dv-debugmenu.js","path":"/addons/rmmv/src/dv-debugmenu.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using developer version of NW.js.":0},"tags":[],"relPath":"/addons/rmmv/src/dv-debugmenu.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/rmrgss/RMUtil.js":{"data":[["Use legacy parser","استخدم المحلل القديم"],["Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.","استخدم المحلل القديم قبل (Translator++ ver. 3.8.12). المحلل القديم لا يدعم بعض الميزات المضافة حديثًا."],["Use old parser","استخدم المحلل القديم"],["Event's thread concurrency","التزامن في خيوط الأحداث"],["<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.","<b>تحذير! ميزة تجريبية!</b><br />يحدد هذا الخيار الحد الأقصى لعدد خيوط العمل التي يمكنها تحليل بيانات الأحداث على الخريطة والأحداث المشتركة بشكل متزامن. <b>اضبط على 0 لتعطيل خيوط العمل</b>. <br />هذا الخيار لديه القدرة على تسريع عملية التحليل في الألعاب الكبيرة. ومع ذلك، من المهم ملاحظة أنه في الألعاب الصغيرة، قد يؤدي تفعيل هذا الخيار إلى إبطاء عملية التحليل بسبب التكلفة التنفيذية الأعلى مقارنة بوقت التحليل لكل بيانات."],["The minimum number of command in an event that allowed in thread worker","الحد الأدنى لعدد الأوامر في حدث المسموح به في خيط العمل"],["<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.","<b>تحذير! ميزة تجريبية!</b><br />خيوط العمل تتكبد تكلفة أثناء التنفيذ، مما يعني أن معالجة الأحداث الفارغة أو الأحداث ذات عدد قليل من الأوامر يمكن أن تعيق العملية الإجمالية. يتيح لك هذا الخيار تحديد الحد الأدنى لعدد الأوامر التي يجب أن يحتويها الحدث ليتم تحليله في خيط عمل. <br />من المهم ملاحظة أن الأحداث الفارغة تحتوي على أمر واحد، ومن الأكثر كفاءة معالجة مثل هذه الأحداث في الخيط الرئيسي بدلاً من خيط العمل. لذلك، يوصى بتعيين هذا الرقم إلى قيمة <b>أكبر من 1</b>.<br />اضبط على 0 لتعطيل تقسيم المهام بناءً على الأوامر."],["Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.","لاحظ أن الحدث الفارغ يحتوي في الواقع على أمر واحد، وأنك بالتأكيد تريد معالجة الأحداث الفارغة في الخيط الرئيسي بدلاً من خيط العمل. يجب عليك تعيين هذا الرقم إلى قيمة أكبر من 1."],["RPG Maker XP, VX, Ace, MV & MZ Parser V.3","محلل RPG Maker XP, VX, Ace, MV & MZ V.3"],["Start translation from RPG Maker game using the latest parser.","ابدأ الترجمة من لعبة RPG Maker باستخدام أحدث محلل."],["Error!\r\nTranslator++ is unable to detect the type of ","خطأ!\r\nTranslator++ غير قادر على اكتشاف نوع "],["You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.","يجب عليك تغيير المسار!\r\nيجب ألا يكون دليل التطوير داخل دليل اللعبة الأصلية، لأن هذا سيسبب مشكلة إذا قمت بحقن اللعبة لاحقًا."],["The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.","اللعبة معبأة مع Enigma.\r\nهل تريد استخراج الحزمة؟\r\nسوف يستغرق هذا دقائق، اعتمادًا على حجم لعبتك."],["Unable to extract the Enigma package!","غير قادر على استخراج حزمة Enigma!"],["Copy & extract data into ","نسخ واستخراج البيانات إلى"]],"context":[["tid/263/type/StringLiteral"],["tid/273/type/StringLiteral"],["tid/290/type/StringLiteral"],["tid/344/type/StringLiteral"],["tid/354/type/StringLiteral"],["tid/424/type/StringLiteral"],["tid/434/type/StringLiteral"],["tid/438/type/StringLiteral"],["tid/21951/type/StringLiteral"],["tid/21956/type/StringLiteral"],["tid/22453/type/StringLiteral"],["tid/22989/type/StringLiteral"],["tid/23038/type/StringLiteral"],["tid/23126/type/StringLiteral"],["tid/23333/type/StringLiteral"]],"basename":"RMUtil.js","dirname":"/addons/rmrgss","extension":".js","filename":"RMUtil.js","path":"/addons/rmrgss/RMUtil.js","indexIsBuilt":false,"indexIds":{"Use legacy parser":0,"Use the old parser prior to (Translator++ ver. 3.8.12). The old parser doesn't support some newly added features.":1,"Use old parser":2,"Event's thread concurrency":3,"<b>Warning! Experimental feature!</b><br />This option determines the maximum number of worker threads that can concurrently parse event data on the Map and CommonEvents. <b>Set to 0 to disable worker thread</b>. <br />This option has the potential to accelerate the parsing process in larger games. However, it is important to note that in smaller games, enabling this option may actually slow down the parsing process due to the higher execution overhead compared to the parsing time for each data.":4,"The minimum number of command in an event that allowed in thread worker":5,"<b>Warning! Experimental feature!</b><br />Thread workers incur overhead during execution, which means that processing blank events or events with a low number of commands can actually hinder the overall process. This option enables you to specify the minimum number of commands an event must have in order to be parsed in a worker thread. <br />It is important to note that even blank events contain one command, and it is more efficient to process such events in the main thread rather than in a worker thread. Therefore, it is recommended to set this number to a value <b>greater than 1</b>.<br />Set to 0 to disable splitting task based on commands.":6,"Note that a blank event actually contains one command, and you definitely want to process blank events in the main thread instead of a worker thread. You should set this number to a value greater than 1.":7,"RPG Maker XP, VX, Ace, MV & MZ Parser V.3":8,"Start translation from RPG Maker game using the latest parser.":9,"Error!\r\nTranslator++ is unable to detect the type of ":10,"You should change the path!\r\nThe Dev directory should not inside the original game's directory, as this will cause problem if you inject the game latter.":11,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":12,"Unable to extract the Enigma package!":13,"Copy & extract data into ":14},"tags":[],"relPath":"/addons/rmrgss/RMUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/rmrgss/legacyHandler.js":{"data":[["RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?","يحتاج تشغيل هذا الإجراء إلى بوابة سطر أوامر RPGMakertrans.\nبوابة سطر أوامر RPGMakertrans مرخصة تحت GPL-3 ولا يمكن توزيعها مع البرنامج.\nلكن Translator++ يمكنه إعدادها نيابةً عنك.\n\nهل تريد من Translator++ تثبيت بوابة سطر أوامر RPGMakertrans لك؟"],["RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?","يحتاج تحديث بوابة سطر أوامر RPGMakertrans.\nهل تريد من Translator++ تحديث بوابة سطر أوامر RPGMakertrans لك؟"],["Maximum dialog line","الحد الأقصى لسطر الحوار"],["Maximum line in the dialog box. Default is 4.","الحد الأقصى للسطر في مربع الحوار. الافتراضي هو 4."]],"context":[["tid/569/type/StringLiteral"],["tid/644/type/StringLiteral"],["tid/4420/type/StringLiteral"],["tid/4430/type/StringLiteral"]],"basename":"legacyHandler.js","dirname":"/addons/rmrgss","extension":".js","filename":"legacyHandler.js","path":"/addons/rmrgss/legacyHandler.js","indexIsBuilt":false,"indexIds":{"RPGMakertrans CLI Gateway is needed to run this action.\nRPGMakertrans CLI Gateway is licensed under GPL-3 and cannot be distributed along with the program.\nBut Translator++ can set it up on your behalf.\n\nDo you wan't Translator++ to install RPGMakertrans CLI Gateway for you?":0,"RPGMakertrans CLI Gateway is need to be updated.\nDo you wan't Translator++ to update the RPGMakertrans CLI Gateway for you?":1,"Maximum dialog line":2,"Maximum line in the dialog box. Default is 4.":3},"tags":[],"relPath":"/addons/rmrgss/legacyHandler.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/srpgStudioParser/srpgstudio.js":{"data":[["Start a translation project from SRPG Studio Engine.","بدء مشروع ترجمة من محرك SRPG Studio."],["The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..","يمكن للمحلل التعامل مع الترجمة من <b>data.dts</b> (ملف srpgs)؛ ملف <b>localization.dat</b> وملفات الترجمة (.json، .txt، .js) التي تم إنشاؤها بواسطة أداة الترجمة الخاصة بـ SRPG Studio المقدمة في الإصدار 1.253."],["Create project","إنشاء مشروع"],["Error: customField is not defined. This should not happen!","خطأ: customField غير معرف. هذا لا ينبغي أن يحدث!"],["Please select the entry point to translate.","يرجى اختيار نقطة الدخول للترجمة."],["There are currently two known locations of translatable text within the SRPG Studio game. <br />","هناك حاليًا موقعان معروفان للنص القابل للترجمة داخل لعبة SRPG Studio. <br />"],["The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.","الأول مكتوب مباشرةً داخل ملف .srpgs، والثاني في ملف localization.dat. يمكن لهذا المحلل حاليًا التعامل مع كليهما."],["<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.","<br />بالإضافة إلى ذلك، يمكنك أيضًا ترجمة ملفات الترجمة التي تم إنشاؤها بواسطة أداة الترجمة الخاصة بـ SRPG Studio. هذه الملفات بصيغة JSON و TXT و JS."]],"context":[["tid/2574/type/StringLiteral"],["tid/2579/type/StringLiteral"],["tid/2648/type/StringLiteral"],["tid/2685/type/StringLiteral"],["tid/2745/type/StringLiteral"],["tid/3047/type/NoSubstitutionTemplate"],["tid/3054/type/NoSubstitutionTemplate"],["tid/3061/type/NoSubstitutionTemplate"]],"basename":"srpgstudio.js","dirname":"/addons/srpgStudioParser","extension":".js","filename":"srpgstudio.js","path":"/addons/srpgStudioParser/srpgstudio.js","indexIsBuilt":false,"indexIds":{"Start a translation project from SRPG Studio Engine.":0,"The parser can handle translation from <b>data.dts</b> (srpgs file); the <b>localization.dat</b> file and localization files (.json, .txt, .js) generated by SRPG Studio's localization tool introduced in version 1.253..":1,"Create project":2,"Error: customField is not defined. This should not happen!":3,"Please select the entry point to translate.":4,"There are currently two known locations of translatable text within the SRPG Studio game. <br />":5,"The first is directly written inside the .srpgs file, and the second is in the localization.dat file. This parser can currently can handle both.":6,"<br />In addition to that, you can also translate the localization files generated by SRPG Studio's localization tool. These files are in JSON, TXT, and JS format.":7},"tags":[],"relPath":"/addons/srpgStudioParser/srpgstudio.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":8,"length":8,"percent":100},"parameters":[]},"/addons/srpgStudioParserAlt/srpgstudio-alt.js":{"data":[["Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.","تحليل أرشيفات SRPG Studio ونسخة JSON للترجمة التي تم إنشاؤها بواسطة SRPG_Unpacker.exe."],["Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.","بدء الترجمة من data.dts أو project.dat لـ SRPG Studio أو نسخة JSON للترجمة.<br />هذا هو أحدث محلل—أسرع وأكثر استقرارًا بكثير—والذي سيحل محل الإصدار السابق."],["Create Project","إنشاء مشروع"],["Source mode","وضع المصدر"],["Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.","اختر وضع EXE للبدء من ملف تنفيذ اللعبة، أو وضع الأرشيف لـ data.dts / project.dat، أو وضع النسخة لنسخة JSON للترجمة."],["Select executable","اختر الملف التنفيذي"],["Select the game executable. Translator++ will look for data.dts in the same folder.","اختر ملف تنفيذ اللعبة. سيبحث Translator++ عن data.dts في نفس المجلد."],["Select archive file","اختر ملف الأرشيف"],["Select data.dts directly.","اختر data.dts مباشرةً."],["Select dump folder","اختر مجلد التفريغ"],["Select the translation dump folder generated by SRPG_Unpacker.exe.","اختر مجلد تفريغ الترجمة الذي تم إنشاؤه بواسطة SRPG_Unpacker.exe."],["Filters","المرشحات"],["Glob pattern used to select JSON files from the dump folder.","نمط عام يستخدم لتحديد ملفات JSON من مجلد التفريغ."],["ProjectTitle","عنوان المشروع"],["Your project title","عنوان مشروعك"]],"context":[["tid/4165/type/StringLiteral"],["tid/4208/type/StringLiteral"],["tid/4279/type/StringLiteral"],["tid/4550/type/StringLiteral"],["tid/4582/type/StringLiteral"],["tid/4608/type/StringLiteral"],["tid/4618/type/StringLiteral"],["tid/4651/type/StringLiteral"],["tid/4661/type/StringLiteral"],["tid/4694/type/StringLiteral"],["tid/4704/type/StringLiteral"],["tid/4737/type/StringLiteral"],["tid/4747/type/StringLiteral"],["tid/4780/type/StringLiteral"],["tid/4790/type/StringLiteral"]],"basename":"srpgstudio-alt.js","dirname":"/addons/srpgStudioParserAlt","extension":".js","filename":"srpgstudio-alt.js","path":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","indexIsBuilt":false,"indexIds":{"Parse SRPG Studio archives and translation dump JSON generated by SRPG_Unpacker.exe.":0,"Start translation from SRPG Studio data.dts, project.dat, or translation dump JSON.<br />This is the latest parser—significantly faster and more stable—which will replace the previous version.":1,"Create Project":2,"Source mode":3,"Choose EXE mode to start from the game executable, archive mode for data.dts / project.dat, or dump mode for translation dump JSON.":4,"Select executable":5,"Select the game executable. Translator++ will look for data.dts in the same folder.":6,"Select archive file":7,"Select data.dts directly.":8,"Select dump folder":9,"Select the translation dump folder generated by SRPG_Unpacker.exe.":10,"Filters":11,"Glob pattern used to select JSON files from the dump folder.":12,"ProjectTitle":13,"Your project title":14},"tags":[],"relPath":"/addons/srpgStudioParserAlt/srpgstudio-alt.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.html":{"data":[["Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>","موقع مترجم Sugoi <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"أشر إلى ملف .bat أو .exe في المجلد الجذري للتطبيق.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> مسار غير صالح.<br>سيتم تعطيل بعض الميزات حتى يتم إصلاح هذا."],["Server Type :","نوع الخادم :"],["Installed Model :","النموذج المثبت :"],["Install Sugoi Translator","تثبيت مترجم Sugoi"],["Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ","ليس لديك مترجم Sugoi؟\n            قم بتثبيت خادم مترجم Sugoi مخصص ومحسن الآن!\n        "],["Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>","عدد الخوادم لبدء التشغيل (وحدة المعالجة المركزية) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"عدد الخوادم التي تبدأ في وقت واحد\"></i>"],["Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%","عدد الخوادم التي تبدأ في وقت واحد.<br>المزيد من العمليات لا يعني دائمًا سرعة أكبر، كن حذرًا من سعة ذاكرة الوصول العشوائي ووحدة المعالجة المركزية.<br>قد لا تحصل على الفائدة إذا وصل استخدام وحدة المعالجة المركزية إلى 100% بتشغيل خادم واحد فقط"],["\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ","\n                    مترجم Sugoi الخاص بك لا يدعم معالجة وحدة معالجة الرسومات.<br>\n                    تحتاج إلى تصحيح خادمك لدعم معالجة وحدة معالجة الرسومات.<br>\n                    <h3 data-tran=\"\">اختر الخيار التالي لتثبيت التصحيح المناسب لنظامك</h3>\n                    <div>\n                        <span data-tran=\"\">وحدة معالجة الرسومات الخاصة بك هي:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">تثبيت تصحيح لسلسلة NVIDIA 30xx أو أحدث</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">تثبيت تصحيح لسلسلة NVIDIA 20xx أو أقدم</button>\n                    </div>\n                "],["Select the following option to install the suitable patch for your system","اختر الخيار التالي لتثبيت التصحيح المناسب لنظامك"],["Your GPU is:","وحدة معالجة الرسومات الخاصة بك هي:"],["Install patch For NVIDIA series 30xx or greater","تثبيت تصحيح لسلسلة NVIDIA 30xx أو أحدث"],["Install patch For NVIDIA series 20xx or lower","تثبيت التصحيح لسلسلة NVIDIA 20xx أو أقل"],["Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>","عدد الخوادم لبدء (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"عدد الخوادم التي تبدأ في وقت واحد باستخدام GPU. يجب تصحيح خادمك لتمكين معالجة GPU.\"></i>"],["How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.","كم عدد الخوادم التي تريد بدءها على <b>GPU</b> الخاص بك. من الممكن تشغيل خدمة تعتمد على CPU وGPU في وقت واحد. لكن يرجى ملاحظة أنه إذا كان استخدام CPU مرتفعًا، فقد يعيق أداء GPU.<br>يجب تصحيح خادمك لتمكين هذا الوضع."],["Starting port number","رقم المنفذ البدئي"],["The port numbers will be generated incrementaly starting from the value below","سيتم إنشاء أرقام المنافذ بشكل تدريجي بدءًا من القيمة أدناه"],["Keep console window open","إبقاء نافذة وحدة التحكم مفتوحة"],["prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.","منع إغلاق نافذة وحدة التحكم عند إغلاق الخادم. هذا الخيار مفيد للتحقق من الأخطاء التي تسببت في تعطل الخادم."],["Action","إجراء"],["Set Sugoi Trans config based on this setting","تعيين إعدادات Sugoi Trans بناءً على هذا الإعداد"],["Start All Server","بدء جميع الخوادم"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/2/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/6/innerText"],["idx/5/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"]],"basename":"serverManager.html","dirname":"/addons/sugoiTrans","extension":".html","filename":"serverManager.html","path":"/addons/sugoiTrans/serverManager.html","indexIsBuilt":false,"indexIds":{"Sugoi translator location <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Point to the .bat file or .exe file on the root directory of the application.\"></i>":0,"<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.":1,"Server Type :":2,"Installed Model :":3,"Install Sugoi Translator":4,"Don't have Sugoi Translator?\n            Install customized &amp; optimized Sugoi Translator server now!\n        ":5,"Number of server to start (CPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously\"></i>":6,"Number of server to be started simultaneously.<br>More process desn't always means more speed, be mindful of your RAM &amp; CPU capacity.<br>You may won't get the benefit if by running just one server the CPU usage has reached 100%":7,"\n                    Your Sugoi Translator doesn't support GPU processing.<br>\n                    You need to patch your server to support GPU processing.<br>\n                    <h3 data-tran=\"\">Select the following option to install the suitable patch for your system</h3>\n                    <div>\n                        <span data-tran=\"\">Your GPU is:</span>\n                        <ul class=\"gpuList\"></ul>\n                    </div>\n                    <div class=\"gpuPatchOptions\">\n                        <button class=\"patchGPU\" data-tran=\"\">Install patch For NVIDIA series 30xx or greater</button>\n                        <button class=\"patchGPULegacy\" data-tran=\"\">Install patch For NVIDIA series 20xx or lower</button>\n    \n                    </div>\n                ":8,"Select the following option to install the suitable patch for your system":9,"Your GPU is:":10,"Install patch For NVIDIA series 30xx or greater":11,"Install patch For NVIDIA series 20xx or lower":12,"Number of server to start (GPU) <i class=\"icon-info-circled-1\" data-tranatrr=\"title\" title=\"Number of server started simultaneously using GPU. Your server must be patched to enable GPU processing.\"></i>":13,"How many server do you want to start on your <b>GPU</b>. It is possible to run both CPU and GPU based service simultaneously. But please keep in mind that if your CPU usage is high it may hinder the GPU performance.<br>Your server must be patched to enable this mode.":14,"Starting port number":15,"The port numbers will be generated incrementaly starting from the value below":16,"Keep console window open":17,"prevent console window from closing when the server closes. This option is useful for checking for errors that caused the server to crash.":18,"Action":19,"Set Sugoi Trans config based on this setting":20,"Start All Server":21},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":22,"length":22,"percent":100},"parameters":[]},"/addons/sugoiTrans/serverManager.js":{"data":[["Select installation folder","تحديد مجلد التثبيت"],["Where do you want to install the CT2 Sugoi Translator into?","أين تريد تثبيت CT2 Sugoi Translator؟"],["Cancel","إلغاء"],["Install now!","تثبيت الآن!"],["Path to the directory can not be empty!","مسار الدليل لا يمكن أن يكون فارغًا!"],["Invalid directory:","دليل غير صالح:"],["Failed to download file. Repository do not exist. Please see the console log for more information.","فشل في تنزيل الملف. المستودع غير موجود. يرجى الاطلاع على سجل وحدة التحكم لمزيد من المعلومات."],["Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series","هل أنت متأكد أنك تريد تحديث خادمك؟\nسينجح سيناريو التحديث هذا لسلسلة NVIDIA 3XXX"],["Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier","هل أنت متأكد أنك تريد تحديث خادمك؟\nسينجح سيناريو التحديث هذا لسلسلة NVIDIA 2XXX وما قبلها"],["Install CT2 Sugoi Translator","تثبيت CT2 Sugoi Translator"],["Installation completed\nDo you want to set the Server Manager with this installed server?","اكتمل التثبيت\nهل تريد إعداد مدير الخادم باستخدام هذا الخادم المثبت؟"],["Sugoi Translator Installed","تم تثبيت Sugoi Translator"],["Server started\nPlease wait until the server(s) are ready before you translate things.","بدأ الخادم\nيرجى الانتظار حتى يصبح الخادم (الخوادم) جاهزًا قبل ترجمة الأشياء."],["This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?","سيؤدي هذا الإجراء إلى الكتابة فوق القيمة الحالية لإعدادات إضافة Sugoi Trans.\nهل أنت متأكد؟"],["Do you want to reset the current configuration?","هل تريد إعادة تعيين التكوين الحالي؟"],["Configuration refreshed!","تم تحديث التكوين!"]],"context":[["tid/528/type/NoSubstitutionTemplate","tid/635/type/StringLiteral"],["tid/533/type/NoSubstitutionTemplate"],["tid/766/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/900/type/StringLiteral"],["tid/929/type/StringLiteral"],["tid/1552/type/StringLiteral"],["tid/6226/type/NoSubstitutionTemplate"],["tid/6296/type/NoSubstitutionTemplate"],["tid/8731/type/StringLiteral"],["tid/8957/type/StringLiteral"],["tid/9003/type/StringLiteral"],["tid/9606/type/StringLiteral"],["tid/9643/type/NoSubstitutionTemplate"],["tid/9713/type/StringLiteral"],["tid/9778/type/StringLiteral"]],"basename":"serverManager.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"serverManager.js","path":"/addons/sugoiTrans/serverManager.js","indexIsBuilt":false,"indexIds":{"Select installation folder":0,"Where do you want to install the CT2 Sugoi Translator into?":1,"Cancel":2,"Install now!":3,"Path to the directory can not be empty!":4,"Invalid directory:":5,"Failed to download file. Repository do not exist. Please see the console log for more information.":6,"Are you sure want to update your server?\nThis update script will work for NVIDIA 3XXX series":7,"Are you sure want to update your server?\nThis update script will work for NVIDIA 2XXX series and earlier":8,"Install CT2 Sugoi Translator":9,"Installation completed\nDo you want to set the Server Manager with this installed server?":10,"Sugoi Translator Installed":11,"Server started\nPlease wait until the server(s) are ready before you translate things.":12,"This action will overwrite the current value of Sugoi Trans Addon's settings.\nAre you sure?":13,"Do you want to reset the current configuration?":14,"Configuration refreshed!":15},"tags":[],"relPath":"/addons/sugoiTrans/serverManager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/sugoiTrans/sugoiTrans.js":{"data":[["Line delimiter","فاصل الأسطر"],["Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.","املأ بالأحرف أو العبارات التي سيتم تجنبها بواسطة المترجم (ستكون العبارة الأصلية والترجمة دائمًا نفسها). هذا يضمن أن عدد أسطر النص المترجم هو نفس عدد أسطر النص الأصلي.\nحاليًا لا توجد عبارات/أحرار سيتجنبها Sugoi بنسبة نجاح 100%.\nيمكنك تجربة استخدام &#x3C;br&#x3E; بنسبة نجاح معقولة.\nاتركه فارغًا إذا كنت تريد دمج الأسطر في سطر واحد."],["Target URL(s)","عنوان (عناوين) الهدف"],["Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.","عنوان URL الهدف للمترجم. يمكنك إدخال عنوان URL خلفي واحد أو أكثر لـ Sugoi Translator. سيقوم Translator++ بموازنة الحمل للطلبات عبر جميع مثيلات الخدمات. افصل كل إدخال بسطر جديد."],["Max Parallel job","الحد الأقصى للوظائف المتوازية"],["Maximum parallel job that run simultaneously.","الحد الأقصى للوظائف المتوازية التي تعمل في وقت واحد."],["Send requests in batch","إرسال الطلبات على دفعات"],["Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.","إرسال عدة نصوص (حسب الحد الأقصى للوظائف المتوازية) في مصفوفة.\nأسرع ويمكن أن يقلل من النفقات العامة للتشغيل بشكل كبير. يجب تشغيل الخادم من مدير الخادم لتمكين هذا الخيار."],["Check First Line in Common Reference","التحقق من السطر الأول في المرجع المشترك"],["Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.","لا تقم بتضمين السطر الأول في الحمولة إذا تم العثور على السطر الأول في المرجع المشترك.\nهذا مفيد جدًا إذا كان اسم الشخصية في السطر الأول."],["Check Last Line in Common Reference","التحقق من السطر الأخير في المرجع المشترك"],["Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.","لا تقم بتضمين السطر الأخير في الحمولة إذا تم العثور على السطر الأخير في المرجع المشترك.\nهذا مفيد جدًا إذا كان اسم الشخصية في السطر الأخير."],["Automatic splitting","التقسيم التلقائي"],["Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.","تقسيم الترجمة تلقائيًا إلى عدد الأسطر المطابق للأصل. سيكون طول كل سطر بحجم مماثل."],["Code Escaping Algorithm","خوارزمية الهروب من الرمز"],["Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)","خوارزمية الهروب للرمز المضمن داخل الحوارات (لم يتم تنفيذها بعد، يرجى الانتظار للتحديثات المستقبلية)"]],"context":[["tid/161/type/StringLiteral"],["tid/171/type/StringLiteral"],["tid/203/type/StringLiteral"],["tid/213/type/StringLiteral"],["tid/257/type/StringLiteral"],["tid/267/type/StringLiteral"],["tid/305/type/StringLiteral"],["tid/315/type/StringLiteral"],["tid/347/type/StringLiteral"],["tid/357/type/StringLiteral"],["tid/389/type/StringLiteral"],["tid/399/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/441/type/StringLiteral"],["tid/473/type/StringLiteral"],["tid/483/type/StringLiteral"]],"basename":"sugoiTrans.js","dirname":"/addons/sugoiTrans","extension":".js","filename":"sugoiTrans.js","path":"/addons/sugoiTrans/sugoiTrans.js","indexIsBuilt":false,"indexIds":{"Line delimiter":0,"Fill in with the characters or phrases that will be escaped by the translator (the original phrase and the translation will always be the same). This will guarantee that the number of lines of the translated text is the same as the number of lines of the original text. \nThere are currently no phrases/characters that Sugoi will escape with a 100% success rate.\nYou can try using &#x3C;br&#x3E; with decent amount of success rate.\nLeave blank if you want to concatenate the lines into a single line.":1,"Target URL(s)":2,"Translator target URL. You can enter one ore more Sugoi Translator back-end URL. Translator++ will load balance the request across all instance of the services. Separate each entry with a new line.":3,"Max Parallel job":4,"Maximum parallel job that run simultaneously.":5,"Send requests in batch":6,"Send several texts (by Max Parallel job) in array.\nFaster and can cut the execution overhead significantly. You must run the server from server manager to enable this option.":7,"Check First Line in Common Reference":8,"Do not include first line in the payload if the first line is found at Common Reference.\nThis is very useful if the character name is at the first line.":9,"Check Last Line in Common Reference":10,"Do not include last line in the payload if the last line is found at Common Reference.\nThis is very useful if the character name is at the last line.":11,"Automatic splitting":12,"Automatically split the translation into the number of lines matching the original. The length of each line will be of a similar size.":13,"Code Escaping Algorithm":14,"Escaping algorithm for inline code inside dialogues (not yet implemented, please wait for the future updates)":15},"tags":[],"relPath":"/addons/sugoiTrans/sugoiTrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":16,"length":16,"percent":100},"parameters":[]},"/addons/testAddon/emoji.js":{"data":[["Load Actor Reference as Glossary","تحميل مرجع الممثل كقاموس"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","إذا تم تحديده، سيحمل Translator++ مرجع الممثل كقاموس. سيساعد هذا المترجم على فهم سياق المحادثة. مرجع الممثل هو اسم الممثل في الحوار. سيتم تحميله كقاموس للمترجم. سيؤدي هذا إلى زيادة تكلفة الترجمة."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","سيتم تحميل الشخصيات الموجودة فقط في المحادثة كقاموس لكل عنصر دفعة. استخدم أمر القالب لتحميل مرجع الممثل في رسالة المطالبة."],["Actor Reference Translation Column","عمود ترجمة مرجع الممثل"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","عمود ترجمة اسم الممثل. سيستخدم هذا العمود كترجمة لمرجع الممثل. سيحسن هذا اتساق ترجمة اسم الممثل في المحادثة."],["Actor's Information Column","عمود معلومات الممثل"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","العمود الذي يحتوي على معلومات إضافية للممثل. يمكنك وضع معلومات إضافية مثل الجنس، العمر، إلخ. سيحسن هذا ترجمة الضمائر في المحادثة."],["System Message Template","قالب رسالة النظام"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","رسالة النظام هي رأس الرسالة التي ستخبر ما هو دور مساعد chatGPT الخاص بك. سيتم إرسال هذه الرسالة كأول رسالة في كل دفعة ترسلها إلى chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","يمكنك تضمين المتغيرات التالية بأسلوب القالب الحرفي لجافا سكريبت <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","المتغيرات:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : لغة المصدر</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : لغة الهدف</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : اسم لغة المصدر الكامل</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : اسم لغة الهدف الكامل</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : النص المصدر</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : رسالة محددة مسبقًا لخوارزمية الهروب.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : سلسلة تمثل سطرًا جديدًا (بديل السطر).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>عدد_الرسائل : عدد الرسائل في الدفعة.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>معلومات_الممثل : إضافة معلومات الممثلين.</li>"],["<li>TITLE : Title of the game</li>","<li>العنوان : عنوان اللعبة</li>"],["<li>ENGINE : Engine of the game</li>","<li>المحرك : محرك اللعبة</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>مرجع[اسم الكائن] : إنشاء مرجع من كائن Translator++. <br />مثال: <code>مرجع[المرجع المشترك]</code></li>"],["Body Message Template","قالب رسالة الجسم"],["Template of the body of your chat.","قالب جسم محادثتك."],["Sample conversation","محادثة نموذجية"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","تسمح واجهة برمجة تطبيقات ChatGPT الدفعية بترجمة مشروعك بشكل غير متزامن بتكلفة أقل بنسبة 50%، مما يعني أنك ستتلقى نتائج الترجمة <b style=\"color:red\">خلال 24 ساعة</b> و <b style=\"color:red\">بنصف التكلفة العادية</b>. هذا مفيد بشكل خاص للمشاريع الكبيرة التي لا تتطلب نتائج ترجمة فورية."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />اقرأ المزيد عن واجهة برمجة تطبيقات ChatGPT الدفعية: https://platform.openai.com/docs/guides/batch ."],["Glossary","قاموس المصطلحات"],["<h2>Glossary</h2>","<h2>قاموس المصطلحات</h2>"],["<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>","<p>يمكنك استخدام قاموس المصطلحات أو لا. سيتم تحميل القاموس لكل عنصر في الدفعة لتحسين جودة الترجمة.</p>"],["The Column of Actor's Additional Information","عمود المعلومات الإضافية للممثل"],["Prompt Template","قالب المطالبة"],["<h2>1. System Message</h2>","<h2>1. رسالة النظام</h2>"],["<p>Here you can explain to the assistant, what is their role.</p>","<p>هنا يمكنك شرح دور المساعد.</p>"],["<h2>2. Sample dialogue</h2>","<h2>2. حوار نموذجي</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>حوار موجود كنموذج. يمكنك كتابة نموذج لردود جيدة أو سيئة لمساعدة المترجم على فهم هدفك وسياق المحادثة.</p>"],["<h2>3. Your actual prompt</h2>","<h2>3. مطالبتك الفعلية</h2>"],["<p>This is the actual prompt to the assistant.</p>","<p>هذا هو المطالبة الفعلية للمساعد.</p>"],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.","<h3>تكلفة النفقات العامة</h3>\n                        تكلفة النفقات العامة هي تكلفة رسالة المطالبة التي ترسلها إلى المساعد دون نصوص الترجمة الفعلية. يتم حساب التكلفة بناءً على عدد الرموز في رسالة المطالبة. كلما زاد عدد الرموز لديك، زادت التكلفة.<br>\n                        <b>تكلفة النفقات العامة الحالية:</b> <span class=\"overheadCost\">0</span> رمز / طلب."]],"context":[["tid/1555/type/StringLiteral","tid/2095/type/StringLiteral"],["tid/1565/type/StringLiteral"],["tid/1572/type/StringLiteral"],["tid/1606/type/StringLiteral","tid/2126/type/StringLiteral"],["tid/1616/type/StringLiteral"],["tid/1643/type/StringLiteral"],["tid/1653/type/StringLiteral"],["tid/1685/type/StringLiteral"],["tid/1695/type/StringLiteral"],["tid/1703/type/StringLiteral"],["tid/1711/type/StringLiteral"],["tid/1724/type/StringLiteral"],["tid/1732/type/StringLiteral"],["tid/1740/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1756/type/StringLiteral"],["tid/1764/type/StringLiteral"],["tid/1772/type/StringLiteral"],["tid/1780/type/StringLiteral"],["tid/1788/type/StringLiteral"],["tid/1796/type/StringLiteral"],["tid/1804/type/StringLiteral"],["tid/1812/type/StringLiteral"],["tid/1850/type/StringLiteral"],["tid/1860/type/StringLiteral"],["tid/1906/type/StringLiteral"],["tid/2001/type/NoSubstitutionTemplate"],["tid/2013/type/NoSubstitutionTemplate"],["tid/2039/type/StringLiteral"],["tid/2065/type/StringLiteral"],["tid/2072/type/StringLiteral"],["tid/2157/type/StringLiteral"],["tid/2189/type/StringLiteral"],["tid/2215/type/StringLiteral"],["tid/2222/type/StringLiteral"],["tid/2266/type/StringLiteral"],["tid/2273/type/StringLiteral"],["tid/2399/type/StringLiteral"],["tid/2406/type/StringLiteral"],["tid/2459/type/NoSubstitutionTemplate"]],"basename":"emoji.js","dirname":"/addons/testAddon","extension":".js","filename":"emoji.js","path":"/addons/testAddon/emoji.js","indexIsBuilt":false,"indexIds":{"Load Actor Reference as Glossary":0,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":1,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":2,"Actor Reference Translation Column":3,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":4,"Actor's Information Column":5,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":6,"System Message Template":7,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":8,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":9,"Variables:<br>":10,"<li>LANG_FROM : Source language</li>":11,"<li>LANG_TO : Target language</li>":12,"<li>LANG_FROM_FULL : Full source language name</li>":13,"<li>LANG_TO_FULL : Full target language name</li>":14,"<li>SOURCE_TEXT : Source text</li>":15,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":16,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":17,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":18,"<li>ACTOR_INFO : Add information of the actors.</li>":19,"<li>TITLE : Title of the game</li>":20,"<li>ENGINE : Engine of the game</li>":21,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":22,"Body Message Template":23,"Template of the body of your chat.":24,"Sample conversation":25,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":26," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":27,"Glossary":28,"<h2>Glossary</h2>":29,"<p>You may or may not use the glossary. The glossary will be loaded for each batch items to improve the quality of the translation.</p>":30,"The Column of Actor's Additional Information":31,"Prompt Template":32,"<h2>1. System Message</h2>":33,"<p>Here you can explain to the assistant, what is their role.</p>":34,"<h2>2. Sample dialogue</h2>":35,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":36,"<h2>3. Your actual prompt</h2>":37,"<p>This is the actual prompt to the assistant.</p>":38,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":39},"tags":[],"relPath":"/addons/testAddon/emoji.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":40,"length":40,"percent":100},"parameters":[]},"/addons/tinyrpa/util.js":{"data":[["TinyRPA server is not installed. Do you want to install it now?","خادم TinyRPA غير مثبت. هل تريد تثبيته الآن؟"]],"context":[["tid/854/type/StringLiteral"]],"basename":"util.js","dirname":"/addons/tinyrpa","extension":".js","filename":"util.js","path":"/addons/tinyrpa/util.js","indexIsBuilt":false,"indexIds":{"TinyRPA server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/tinyrpa/util.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/tm/tm.js":{"data":[["Automatic organic translation memorization","حفظ الترجمة العضوية تلقائيًا"],["If checked, all organic translation (manually inputted translation) will be memorized automatically.","إذا تم تحديده، سيتم حفظ جميع الترجمات العضوية (المدخلة يدويًا) تلقائيًا."],["Memorize translation by automation script","حفظ الترجمة بواسطة سيناريو الأتمتة"],["If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.","إذا تم تحديده، سيتذكر Translator++ الترجمة المنشأة من سيناريوهات الأتمتة.\nسيتم حفظ جميع التغييرات عبر 'this.cells'. ولكن من الممكن لنا تعديل محتويات الشبكة مباشرة باستخدام API الترجمة، مثل هذه التغييرات لن تسبب حفظًا تلقائيًا."],["Remind translation on cell translate","تذكير بالترجمة عند ترجمة الخلية"],["If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.","إذا تم تحديده، سيقوم Translator++ بتحميل الترجمة من ذاكرة الترجمة أولاً قبل إجراء الترجمة التلقائية على الخلية المحددة."],["Default memorization behavior","سلوك الحفظ الافتراضي"],["Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.","كتابة السجل السابق عند إجراء ترجمة عضوية. إذا لم يتم تحديده، لن تقوم ذاكرة الترجمة بحفظ الترجمة الجديدة للسجل الموجود."],["MySQL host","مضيف MySQL"],["The host name or IP address of your MySQL server","اسم المضيف أو عنوان IP لخادم MySQL الخاص بك"],["MySQL port","منفذ MySQL"],["MySQL Port. Default is 3306.","منفذ MySQL. الافتراضي هو 3306."],["MySQL user name","اسم مستخدم MySQL"],["Username to access the DB.","اسم المستخدم للوصول إلى قاعدة البيانات."],["MySQL password","كلمة مرور MySQL"],["Password to access the DB.","كلمة المرور للوصول إلى قاعدة البيانات."],["Database Name","اسم قاعدة البيانات"],["Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.","اسم قاعدة البيانات. سيحاول Translator++ إنشاء قاعدة البيانات إذا لم تكن موجودة. لكن النجاح يعتمد على صلاحيات بيانات الاعتماد المقدمة."],["Database Type","نوع قاعدة البيانات"],["Automatically memorize manually inputted translations?","هل تريد حفظ الترجمات المدخلة يدوياً تلقائياً؟"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","عذراً، هذا الإضافة متاحة فقط للرعاة النشطين.\nيمكنك فتح هذه الميزة بأن تصبح راعياً بقيمة $1."],["Automatically memorize translation made by automation scripts?","هل تريد حفظ الترجمات التي تم إنشاؤها بواسطة نصوص الأتمتة تلقائياً؟"],["Remind translations when performing translate selection?","هل تريد تذكير الترجمات عند تنفيذ ترجمة الاختيار؟"],["Use rememorize in organic translation","استخدام إعادة الحفظ في الترجمة العضوية"],["default","افتراضي"],["Indexed DB (experimental)","قاعدة البيانات المفهرسة (تجريبي)"],["MySQL","MySQL"],["Database Setting","إعداد قاعدة البيانات"],["IndexedDB","IndexedDB"],["Generate","توليد"],["Escaping algorithm for inline code inside dialogues","خوارزمية الهروب للكود المضمن داخل الحوارات"],["Test connection","اختبار الاتصال"],["Connection success!","نجاح الاتصال!"],["MySql","MySql"],["Connection failed!\nError:","فشل الاتصال!\nخطأ:"],["Install MySQL Server","تثبيت خادم MySQL"],["How to setup MySQL Server","كيفية إعداد خادم MySQL"],["Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?","تم اكتشاف ترجمات متعددة لجملة مفتاحية واحدة.\nسيتم حفظ آخر ترجمة تم العثور عليها فقط في ذاكرة الترجمة.\nهل تريد المتابعة؟"],["Your database structure need to be updated.","يحتاج هيكل قاعدة بياناتك إلى التحديث."],["Upgrade database","ترقية قاعدة البيانات"],["This action will upgrade your database.\nDo you want to upgrade your translation memory database?","سيؤدي هذا الإجراء إلى ترقية قاعدة بياناتك.\nهل تريد ترقية قاعدة بيانات ذاكرة الترجمة الخاصة بك؟"],["The translation memory database has been upgraded!\nPlease restart Translator++!","تمت ترقية قاعدة بيانات ذاكرة الترجمة!\nيرجى إعادة تشغيل Translator++!"]],"context":[["tid/292/type/StringLiteral"],["tid/302/type/StringLiteral"],["tid/340/type/StringLiteral"],["tid/350/type/StringLiteral"],["tid/388/type/StringLiteral"],["tid/398/type/StringLiteral"],["tid/436/type/StringLiteral"],["tid/446/type/StringLiteral"],["tid/484/type/StringLiteral"],["tid/494/type/StringLiteral"],["tid/532/type/StringLiteral"],["tid/542/type/StringLiteral"],["tid/588/type/StringLiteral"],["tid/598/type/StringLiteral"],["tid/643/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/754/type/StringLiteral","tid/764/type/StringLiteral"],["tid/835/type/StringLiteral"],["tid/878/type/StringLiteral","tid/1008/type/StringLiteral","tid/1138/type/StringLiteral"],["tid/965/type/StringLiteral"],["tid/1095/type/StringLiteral"],["tid/1225/type/StringLiteral"],["tid/1290/type/StringLiteral"],["tid/1300/type/StringLiteral"],["tid/1310/type/StringLiteral"],["tid/1390/type/StringLiteral"],["tid/1428/type/StringLiteral"],["tid/1459/type/StringLiteral","tid/1938/type/StringLiteral"],["tid/1469/type/StringLiteral","tid/1948/type/StringLiteral"],["tid/1500/type/StringLiteral","tid/1979/type/StringLiteral"],["tid/1523/type/StringLiteral","tid/2093/type/StringLiteral"],["tid/1557/type/StringLiteral"],["tid/2114/type/StringLiteral"],["tid/2153/type/StringLiteral"],["tid/2201/type/StringLiteral"],["tid/3362/type/StringLiteral"],["tid/4084/type/StringLiteral"],["tid/4095/type/StringLiteral"],["tid/4123/type/StringLiteral"],["tid/4203/type/StringLiteral"]],"basename":"tm.js","dirname":"/addons/tm","extension":".js","filename":"tm.js","path":"/addons/tm/tm.js","indexIsBuilt":false,"indexIds":{"Automatic organic translation memorization":0,"If checked, all organic translation (manually inputted translation) will be memorized automatically.":1,"Memorize translation by automation script":2,"If checked, Translator++ will remember the translation created from automation scripts. \nAll changes via 'this.cells' will be memorized. But it is possible for us to modify the contents of the grid directly using the trans API, such changes will not trigger the automatic memorization.":3,"Remind translation on cell translate":4,"If checked, Translator++ will load translation from translation memory first before performing automatic translation on selected cell.":5,"Default memorization behavior":6,"Overwrite previous record when performing organic translation. If unchecked, TM will not memorize the new translation for existing record.":7,"MySQL host":8,"The host name or IP address of your MySQL server":9,"MySQL port":10,"MySQL Port. Default is 3306.":11,"MySQL user name":12,"Username to access the DB.":13,"MySQL password":14,"Password to access the DB.":15,"Database Name":16,"Database name. Translator++ will try to create database if not exist. But the success is depend on the privilege of the given credential.":17,"Database Type":18,"Automatically memorize manually inputted translations?":19,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":20,"Automatically memorize translation made by automation scripts?":21,"Remind translations when performing translate selection?":22,"Use rememorize in organic translation":23,"default":24,"Indexed DB (experimental)":25,"MySQL":26,"Database Setting":27,"IndexedDB":28,"Generate":29,"Escaping algorithm for inline code inside dialogues":30,"Test connection":31,"Connection success!":32,"MySql":33,"Connection failed!\nError:":34,"Install MySQL Server":35,"How to setup MySQL Server":36,"Multiple translations for one key sentence is detected.\nOnly the last found translation will be memorized by the Translation Memory.\nDo you want to continue?":37,"Your database structure need to be updated.":38,"Upgrade database":39,"This action will upgrade your database.\nDo you want to upgrade your translation memory database?":40,"The translation memory database has been upgraded!\nPlease restart Translator++!":41},"tags":[],"relPath":"/addons/tm/tm.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":42,"length":42,"percent":100},"parameters":[]},"/addons/tm/tmUI.js":{"data":[["Memory","ذاكرة"],["Fix the problem!","إصلاح المشكلة!"],["No exact matches found!","لم يتم العثور على تطابقات دقيقة!"],["Original","الأصل"],["Translation","الترجمة"],["Do you want Translator++ to forget the selected cell(s)?","هل تريد أن ينسى Translator++ الخلية (الخلايا) المحددة؟"],["Auto recall","استدعاء تلقائي"],["Auto memorize organic translation","حفظ تلقائي للترجمة العضوية"],["Auto memorize automation","حفظ تلقائي للأتمتة"],["Use rememorize in organic translation","استخدام إعادة الحفظ في الترجمة العضوية"]],"context":[["tid/47/type/StringLiteral"],["tid/534/type/StringLiteral"],["tid/591/type/StringLiteral"],["tid/1126/type/StringLiteral"],["tid/1131/type/StringLiteral"],["tid/1804/type/NoSubstitutionTemplate"],["tid/2391/type/StringLiteral"],["tid/2543/type/StringLiteral"],["tid/2686/type/StringLiteral"],["tid/2838/type/StringLiteral"]],"basename":"tmUI.js","dirname":"/addons/tm","extension":".js","filename":"tmUI.js","path":"/addons/tm/tmUI.js","indexIsBuilt":false,"indexIds":{"Memory":0,"Fix the problem!":1,"No exact matches found!":2,"Original":3,"Translation":4,"Do you want Translator++ to forget the selected cell(s)?":5,"Auto recall":6,"Auto memorize organic translation":7,"Auto memorize automation":8,"Use rememorize in organic translation":9},"tags":[],"relPath":"/addons/tm/tmUI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/addons/tpp-localizationTool/fetchtrans.js":{"data":[["Preparing download file...","جارٍ تحضير ملف التنزيل..."],["Translation template downloaded successfully!","تم تنزيل قالب الترجمة بنجاح!"],["Building translation data...","جارٍ بناء بيانات الترجمة..."],["Processing: ","جارٍ المعالجة: "],["Fetching directory content...","جارٍ جلب محتويات الدليل..."],["Parsing: ","تحليل: "],["Localization Tools","أدوات الترجمة"],["Generate UI Translation Template","إنشاء قالب ترجمة واجهة المستخدم"],["Update Translation Table","تحديث جدول الترجمة"],["This will overwrite www/lang/template.trans and update all localization files listed in www/lang/options.json.\n\nExisting translations will be preserved. New strings from the current source will be added.\n\nContinue?","سيؤدي هذا إلى استبدال www/lang/template.trans وتحديث جميع ملفات الترجمة المدرجة في www/lang/options.json.\n\nسيتم الحفاظ على الترجمات الحالية. ستتم إضافة سلاسل جديدة من المصدر الحالي.\n\nمتابعة؟"],["Saving template.trans...","حفظ template.trans..."],["Loading language options...","تحميل خيارات اللغة..."],["Updating: ","تحديث: "],["Failed to update: ","فشل في التحديث: "],["Translation tables updated successfully!","تم تحديث جداول الترجمة بنجاح!"]],"context":[["tid/2001/type/StringLiteral"],["tid/2228/type/StringLiteral"],["tid/2286/type/StringLiteral"],["tid/2439/type/StringLiteral"],["tid/2623/type/StringLiteral"],["tid/2825/type/StringLiteral"],["tid/3098/type/StringLiteral"],["tid/3131/type/StringLiteral"],["tid/3208/type/StringLiteral"],["tid/3244/type/StringLiteral"],["tid/3358/type/StringLiteral"],["tid/3408/type/StringLiteral"],["tid/3657/type/StringLiteral"],["tid/3812/type/StringLiteral"],["tid/3852/type/StringLiteral"]],"basename":"fetchtrans.js","dirname":"/addons/tpp-localizationTool","extension":".js","filename":"fetchtrans.js","path":"/addons/tpp-localizationTool/fetchtrans.js","indexIsBuilt":false,"indexIds":{"Preparing download file...":0,"Translation template downloaded successfully!":1,"Building translation data...":2,"Processing: ":3,"Fetching directory content...":4,"Parsing: ":5,"Localization Tools":6,"Generate UI Translation Template":7,"Update Translation Table":8,"This will overwrite www/lang/template.trans and update all localization files listed in www/lang/options.json.\n\nExisting translations will be preserved. New strings from the current source will be added.\n\nContinue?":9,"Saving template.trans...":10,"Loading language options...":11,"Updating: ":12,"Failed to update: ":13,"Translation tables updated successfully!":14},"tags":[],"relPath":"/addons/tpp-localizationTool/fetchtrans.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","نموذج"],["|","|"],["promptLibrary","promptLibrary"],["search","بحث"],["downloadChat","تحميل المحادثة"],["newChat","محادثة جديدة"],["api","api"],["customEndpoint","customEndpoint"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","مفتاح API.تسمية الإدخال"],["apiVersion.inputLabel","نسخة API.تسمية الإدخال"],["apiVersion.description","وصف نسخة API"],["securityMessage","رسالة الأمان"],["apiEndpoint.description","وصف نقطة نهاية API"],["apiEndpoint.warn","تحذير نقطة نهاية API"],["partialImportMessages","رسائل الاستيراد الجزئي"],["import","استيراد"],["name","اسم"],["prompt","مطالبة"],["clearPrompts","مسح المطالبات"],["morePrompts","المزيد من المطالبات"],["toast.sync","إشعار.مزامنة"],["toast.stop","إشعار.إيقاف"],["button.sync","زر.مزامنة"],["button.stop","زر.إيقاف"]],"context":[["tid/100988/type/St