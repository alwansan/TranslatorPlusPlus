.js":{"data":[["Action","إجراء"],["Append tags","إضافة علامات"],["Remove tags","إزالة علامات"],["Set tags","تعيين العلامات"],["Do nothing","لا تفعل شيئًا"],["Close","إغلاق"],["Proceed","متابعة"],["Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.","الكلمة المفتاحية قصيرة جدًا!\nهل تحاول البحث في جميع الصفوف؟ حاول استخدام علامة النجمة '*' ككلمة مفتاحية."],["Found nothing!<br />Don't forget to set the Target search field.","لم يتم العثور على شيء!<br />لا تنس تعيين حقل البحث الهدف."],["Found nothing to replace!<br />Replace function doesn't replace anything on the key column.","لم يتم العثور على شيء لاستبداله!<br />وظيفة الاستبدال لا تستبدل أي شيء في عمود المفتاح."],["Replace '","استبدال '"],["' with '","' بـ '"],["'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?","'؟\r\nلم ننشئ بعد وظيفة التراجع لهذا الشيء!\nهل أنت متأكد من أنك تريد المتابعة؟"],["click to go","انقر للذهاب"],["This will replace any translation found in target colum,\nAre you sure?","سيستبدل هذا أي ترجمة موجودة في العمود الهدف،\nهل أنت متأكد؟"],["Keyword too short!","الكلمة المفتاحية قصيرة جدًا!"],["Not found!","غير موجود!"],["Are you sure want to execute the following script?","هل أنت متأكد من أنك تريد تنفيذ البرنامج النصي التالي؟"],["For ","لـ "],[" selected item(s)?"," عنصر(عناصر) محدد(ة)؟"],[" Select all"," تحديد الكل"],[" Invert selection"," عكس التحديد"],[" Clear selection"," مسح التحديد"],[" Set Red tag","تعيين علامة حمراء"],[" Set Yellow tag","تعيين علامة صفراء"],[" Set Green tag","تعيين علامة خضراء"],[" Set Blue tag","تعيين علامة زرقاء"],[" Set Gold tag","تعيين علامة ذهبية"],[" More tags...","المزيد من العلامات..."],[" Clear tags","مسح العلامات"],[" Create Automation","إنشاء أتمتة"],[" Run Automation","تشغيل الأتمتة"],[" Clear Automation","مسح الأتمتة"],["Are you sure want to clear all quick launch scripts?","هل أنت متأكد أنك تريد مسح جميع نصوص التشغيل السريع؟"],[" Clear translation","مسح الترجمة"],["Do you want to clear translations of the selected items?","هل تريد مسح ترجمات العناصر المحددة؟"],[" Delete rows","حذف الصفوف"],["Do you want to remove selected rows?\nYou can not undo this action!","هل تريد إزالة الصفوف المحددة؟\nلا يمكنك التراجع عن هذا الإجراء!"],[" With selection ...","مع التحديد ..."],["Always on top","دائمًا في المقدمة"],["Default","افتراضي"],["Blur opacity","عتامة التمويه"],["Type regex with the modifier","اكتب تعبيرًا منتظمًا مع المعدل"],["Use $n to replace a group. e.g. $1","استخدم $n لاستبدال مجموعة. على سبيل المثال: $1"],["Find","بحث"],["Replace","استبدال"]],"context":[["tid/3162/type/StringLiteral"],["tid/3167/type/StringLiteral"],["tid/3172/type/StringLiteral"],["tid/3177/type/StringLiteral","tid/3237/type/StringLiteral"],["tid/3182/type/StringLiteral"],["tid/3338/type/StringLiteral","tid/14333/type/StringLiteral"],["tid/3389/type/StringLiteral"],["tid/4973/type/StringLiteral"],["tid/5018/type/StringLiteral"],["tid/6793/type/StringLiteral"],["tid/6812/type/StringLiteral"],["tid/6819/type/StringLiteral"],["tid/6826/type/StringLiteral"],["tid/7666/type/StringLiteral"],["tid/8319/type/StringLiteral"],["tid/8373/type/StringLiteral"],["tid/8660/type/StringLiteral","tid/8687/type/StringLiteral"],["tid/11038/type/StringLiteral"],["tid/11051/type/StringLiteral"],["tid/11060/type/StringLiteral"],["tid/11205/type/StringLiteral"],["tid/11264/type/StringLiteral"],["tid/11323/type/StringLiteral"],["tid/11425/type/StringLiteral"],["tid/11490/type/StringLiteral"],["tid/11555/type/StringLiteral"],["tid/11620/type/StringLiteral"],["tid/11685/type/StringLiteral"],["tid/11750/type/StringLiteral"],["tid/11832/type/StringLiteral"],["tid/11914/type/StringLiteral"],["tid/11971/type/StringLiteral"],["tid/12017/type/StringLiteral"],["tid/12049/type/StringLiteral"],["tid/12143/type/StringLiteral"],["tid/12182/type/StringLiteral"],["tid/12234/type/StringLiteral"],["tid/12273/type/StringLiteral"],["tid/12331/type/StringLiteral"],["tid/13555/type/StringLiteral"],["tid/13993/type/StringLiteral"],["tid/14119/type/StringLiteral"],["tid/15347/type/StringLiteral"],["tid/15364/type/StringLiteral"],["tid/15388/type/StringLiteral"],["tid/15405/type/StringLiteral"]],"basename":"find.js","dirname":"/js","extension":".js","filename":"find.js","path":"/js/find.js","indexIsBuilt":false,"indexIds":{"Action":0,"Append tags":1,"Remove tags":2,"Set tags":3,"Do nothing":4,"Close":5,"Proceed":6,"Keyword too short!\nAre you trying to search all rows? Try using asterisk '*' as the keyword.":7,"Found nothing!<br />Don't forget to set the Target search field.":8,"Found nothing to replace!<br />Replace function doesn't replace anything on the key column.":9,"Replace '":10,"' with '":11,"'?\r\nWe still haven't create undo function for this thing!\nAre you sure want to proceed?":12,"click to go":13,"This will replace any translation found in target colum,\nAre you sure?":14,"Keyword too short!":15,"Not found!":16,"Are you sure want to execute the following script?":17,"For ":18," selected item(s)?":19," Select all":20," Invert selection":21," Clear selection":22," Set Red tag":23," Set Yellow tag":24," Set Green tag":25," Set Blue tag":26," Set Gold tag":27," More tags...":28," Clear tags":29," Create Automation":30," Run Automation":31," Clear Automation":32,"Are you sure want to clear all quick launch scripts?":33," Clear translation":34,"Do you want to clear translations of the selected items?":35," Delete rows":36,"Do you want to remove selected rows?\nYou can not undo this action!":37," With selection ...":38,"Always on top":39,"Default":40,"Blur opacity":41,"Type regex with the modifier":42,"Use $n to replace a group. e.g. $1":43,"Find":44,"Replace":45},"tags":[],"relPath":"/js/find.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":46,"percent":100},"parameters":[]},"/js/jsonform.ext.js":{"data":[["Hide password","إخفاء كلمة المرور"],["Show password","إظهار كلمة المرور"]],"context":[["tid/498/type/StringLiteral"],["tid/567/type/StringLiteral","tid/8581/type/StringLiteral"]],"basename":"jsonform.ext.js","dirname":"/js","extension":".js","filename":"jsonform.ext.js","path":"/js/jsonform.ext.js","indexIsBuilt":false,"indexIds":{"Hide password":0,"Show password":1},"tags":[],"relPath":"/js/jsonform.ext.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/options.js":{"data":[["Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.","بعض الإعدادات تتطلب إعادة تشغيل التطبيق لتصبح فعالة.\nيرجى حفظ عملك، وإعادة تشغيل Translator++."],["Pleae select the name for your configuration.","يرجى اختيار اسم للإعداد الخاص بك."],["Translator Engine configuration","إعداد محرك الترجمة"],["Translator engine version.","إصدار محرك الترجمة."],["By.","بواسطة."],["No option for this engine","لا توجد خيارات لهذا المحرك"],["License","الترخيص"],["Can not disable this addon","لا يمكن تعطيل هذا الإضافة"],["Requirements","المتطلبات"],["What is this?","ما هذا؟"],["Uninstall","إلغاء التثبيت"],["Update","تحديث"],["Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.","تم تثبيت الإضافة بنجاح.\r\nقد يحتاج Translator++ إلى إعادة التشغيل حتى تصبح بعض الإضافات فعالة."],["WARNING!\n","تحذير!\n"],["This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ","تم وضع علامة على هذه الإضافة بأنها \"تغيير محلل\". قد لا يعمل مشروعك القديم المرتبط بهذه الإضافة كما هو متوقع. يُنصح بعمل نسخة احتياطية لمشروعك قبل تثبيت هذه الإضافة.\nيمكنك استيراد ترجمتك الحالية إلى المشروع الذي تم إنشاؤه حديثًا.\n\nهل ترغب في تثبيت "],["Do you want to install ","هل تريد تثبيت "],["Add-on","الإضافة"],["is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.","تم تثبيت الإضافة بنجاح.\r\nقد يحتاج Translator++ إلى إعادة التشغيل لتفعيل بعض الإضافات."],["Add-on version.","نسخة الإضافة."],["No option for this add-on","لا توجد خيارات لهذه الإضافة"],["Translator++ will write Window's registry.\r\nAre you sure?","سيكتب Translator++ في سجل Windows.\r\nهل أنت متأكد؟"],["Error parsing patterns:","خطأ في تحليل الأنماط:"],["Do you really want to clear the custom escaper?","هل تريد حقًا مسح الهروب المخصص؟"],["Do you really want to reset the custom escaper?","هل تريد حقًا إعادة تعيين الهروب المخصص؟"],["You are currently on the latest version.\nDo you still want to update?","أنت حاليًا على أحدث إصدار.\nهل لا تزال تريد التحديث؟"],["This option will open your default browser to login.\nDo you want to continue?","سيؤدي هذا الخيار إلى فتح متصفحك الافتراضي لتسجيل الدخول.\nهل تريد المتابعة؟"],["Login with Browser","تسجيل الدخول باستخدام المتصفح"],["Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:","تم فتح متصفحك إلى <b>dreamsavior.net/gettoken/</b>.<br>سيتم اكتمال تسجيل الدخول تلقائيًا بمجرد تسجيل الدخول.<br><br>إذا لم يعمل تسجيل الدخول التلقائي، انسخ رمزك من تلك الصفحة والصقه أدناه:"],["There is no default translator selected.\nChange the default translator to Google!","لا يوجد مترجم افتراضي محدد.\nقم بتغيير المترجم الافتراضي إلى Google!"],["Change Stagging Path to :","تغيير مسار التدريج إلى:"],["Move the content of current Stagging Path into the new one?","هل تريد نقل محتوى مسار التدريج الحالي إلى المسار الجديد؟"],["Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.","تم تثبيت الإضافة/الإضافات.\nيحتاج Translator++ إلى إعادة التشغيل لتفعيلها."],["Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.","هل تريد حقًا مسح جميع الإعدادات وإعادة تعيين Translator++ إلى الوضع الافتراضي؟\nيرجى ملاحظة أن هذا الإجراء لا يمكن التراجع عنه.\nيرجى نسخ مشروعك احتياطيًا قبل المتابعة."],["Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?","قد لا يعمل Translator++ بشكل طبيعي إذا لم تقم بإصلاح الخطأ.\nهل تريد إغلاق نافذة الخيارات؟"]],"context":[["tid/566/type/StringLiteral"],["tid/6369/type/StringLiteral"],["tid/6944/type/StringLiteral"],["tid/6953/type/StringLiteral"],["tid/6966/type/StringLiteral","tid/12450/type/StringLiteral"],["tid/7089/type/StringLiteral"],["tid/7943/type/StringLiteral"],["tid/8089/type/StringLiteral"],["tid/8732/type/StringLiteral"],["tid/8754/type/StringLiteral"],["tid/9104/type/StringLiteral"],["tid/9413/type/StringLiteral"],["tid/9608/type/StringLiteral"],["tid/10010/type/NoSubstitutionTemplate"],["tid/10015/type/NoSubstitutionTemplate"],["tid/10053/type/NoSubstitutionTemplate"],["tid/10153/type/NoSubstitutionTemplate"],["tid/10162/type/NoSubstitutionTemplate"],["tid/12435/type/StringLiteral"],["tid/13100/type/StringLiteral"],["tid/14016/type/StringLiteral"],["tid/14941/type/StringLiteral"],["tid/16519/type/NoSubstitutionTemplate"],["tid/16597/type/NoSubstitutionTemplate"],["tid/18996/type/StringLiteral"],["tid/19597/type/StringLiteral"],["tid/19687/type/StringLiteral"],["tid/19694/type/StringLiteral"],["tid/22105/type/StringLiteral"],["tid/22172/type/StringLiteral"],["tid/22270/type/StringLiteral"],["tid/22662/type/StringLiteral"],["tid/22834/type/StringLiteral"],["tid/23223/type/StringLiteral"]],"basename":"options.js","dirname":"/js","extension":".js","filename":"options.js","path":"/js/options.js","indexIsBuilt":false,"indexIds":{"Some configuration require you to restart the application to take effect.\nPlease save your work, and restart Translator++.":0,"Pleae select the name for your configuration.":1,"Translator Engine configuration":2,"Translator engine version.":3,"By.":4,"No option for this engine":5,"License":6,"Can not disable this addon":7,"Requirements":8,"What is this?":9,"Uninstall":10,"Update":11,"Addon successfully installed.\r\nTranslator++ may need to be restarted for some addon to take effect.":12,"WARNING!\n":13,"This add-on has marked as \"parser change\". Your old project related to this add-on may no longer worked as expected. It is advised to backup your project before installing this add-on.\nYou can import your existing translation into the newly created project.\n\nDo you wish to install ":14,"Do you want to install ":15,"Add-on":16,"is installed successfully.\r\nTranslator++ may need to be restarted for some addon to take effect.":17,"Add-on version.":18,"No option for this add-on":19,"Translator++ will write Window's registry.\r\nAre you sure?":20,"Error parsing patterns:":21,"Do you really want to clear the custom escaper?":22,"Do you really want to reset the custom escaper?":23,"You are currently on the latest version.\nDo you still want to update?":24,"This option will open your default browser to login.\nDo you want to continue?":25,"Login with Browser":26,"Your browser has been opened to <b>dreamsavior.net/gettoken/</b>.<br>The login will complete automatically once you log in.<br><br>If the automatic login does not work, copy your token from that page and paste it below:":27,"There is no default translator selected.\nChange the default translator to Google!":28,"Change Stagging Path to :":29,"Move the content of current Stagging Path into the new one?":30,"Addon(s) has been installed.\nTranslator++ is need to be restarted to take effect.":31,"Do you really want to clear all settings and reset Translator++ to default?\nPlese note that this action is irreversible.\nPlease backup your project before proceeding.":32,"Translator++ may not work normally if you don't fix the error.\nDo you want to close the options Window?":33},"tags":[],"relPath":"/js/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":34,"length":34,"percent":100},"parameters":[]},"/js/scriptEditor.js":{"data":[["You should save the current project first before creating shortcut to Translator++","يجب حفظ المشروع الحالي أولاً قبل إنشاء اختصار لـ Translator++"],["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","هذه الميزة متاحة فقط إذا كنت تستخدم إصدار المطور من Translator++. يمكنك التبديل إلى إصدار المطور باستخدام الأدوات الأساسية -> تغيير نواة NWJS."]],"context":[["tid/2869/type/StringLiteral"],["tid/8065/type/StringLiteral"]],"basename":"scriptEditor.js","dirname":"/js","extension":".js","filename":"scriptEditor.js","path":"/js/scriptEditor.js","indexIsBuilt":false,"indexIds":{"You should save the current project first before creating shortcut to Translator++":0,"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":1},"tags":[],"relPath":"/js/scriptEditor.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/sys.js":{"data":[["<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.","<b>غير قادر على تشغيل مترجم PHP!</b><br />\n\t\t\t\tيحتاج Translator++ إلى PHP CLI لتشغيل بعض الإجراءات الإلزامية.<br />\n\t\t\t\tيحدث هذا الخطأ عادةً لأن جهازك <b>لم يتم تثبيت <a href=\"http://dreamsavior.net/download/#TPPSysreq\">الإصدار الصحيح من Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>يرجى تثبيت <a href=\"http://dreamsavior.net/download/#TPPSysreq\">الوقت التشغيلي المطلوب</a>.</li>\n\t\t\t\t\t\t<li>ويرجى نقل دليل تثبيت Translator++ إلى مجلد آخر إذا كنت قد قمت بتثبيت كل الوقت التشغيلي ولا تزال تواجه هذا الخطأ.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tيرجى التحقق من <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>التوثيق</a> لمزيد من المعلومات حول هذه الأعراض."],["Initialization Error!","خطأ في التهيئة!"]],"context":[["tid/2886/type/NoSubstitutionTemplate"],["tid/2890/type/StringLiteral"]],"basename":"sys.js","dirname":"/js","extension":".js","filename":"sys.js","path":"/js/sys.js","indexIsBuilt":false,"indexIds":{"<b>Unable to run PHP Interpreter!</b><br />\n\t\t\t\tTranslator++ need PHP CLI to run some mandatory procedure.<br />\n\t\t\t\tThis error usually occurred because your computer is <b>not installed with the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">correct version of Microsoft Visual C++ redistributable</a></b>.\n\t\t\t\t<div class=\"blockBox warningBlock withIcon\">\n\t\t\t\t\t<ul>\n\t\t\t\t\t\t<li>Please install the <a href=\"http://dreamsavior.net/download/#TPPSysreq\">required runtime</a>.</li>\n\t\t\t\t\t\t<li>And please move the Translator++ installation directory to other folder if you have installed all the runtime and still having this error.</li>\n\t\t\t\t\t</ul>\n\t\t\t\t</div>\n\t\t\t\tPlease check the <a href='http://dreamsavior.net/docs/translator/faq/have-installed-all-required-vc-redist-but-still-got-an-error/'>documentation</a> for more information about this symptom.":0,"Initialization Error!":1},"tags":[],"relPath":"/js/sys.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/trans.js":{"data":[["Original Text","النص الأصلي"],["Initial","مبدئي"],["Machine translation","ترجمة آلية"],["Better translation","ترجمة أفضل"],["Best translation","أفضل ترجمة"],["Loading","جارٍ التحميل"],["Error!","خطأ!"],["Error processing init file : ","خطأ في معالجة ملف التهيئة : "],["Error! File list not found in init file at : ","خطأ! لم يتم العثور على قائمة الملفات في ملف التهيئة في : "],["This means that your game was not successfully parsed. Please visit https://dreamsavior.net/?p=1311 for possible solution for this issue.","هذا يعني أن لعبتك لم يتم تحليلها بنجاح. يرجى زيارة https://dreamsavior.net/?p=1311 للحصول على حل محتمل لهذه المشكلة."],["Done!","تم!"],["All done!","تم كل شيء!"],["Error opening file : ","خطأ في فتح الملف : "],["error opening file (open): ","خطأ في فتح الملف (فتح): "],["Project properties - Staging path error!","خصائص المشروع - خطأ في مسار التخزين المؤقت!"],["Project properties","خصائص المشروع"],["untitled project","مشروع غير مسمى"],["create file list","إنشاء قائمة الملفات"],["Finished","تم الانتهاء"],["All process finished!","تم الانتهاء من جميع العمليات!"],["Open Explorer","فتح المستكشف"],["Opening file!","فتح الملف!"],["Assigning new staging path : ","تعيين مسار جديد للتدريج : "],["Success!","نجاح!"],["Failed!","فشل!"],["Collecting paths","جمع المسارات"],["Path : '","المسار : '"],["' doesn't exist","' غير موجود"],[" file(s) collected!"," ملف(ملفات) تم جمعها!"],["Start importing data!","بدء استيراد البيانات!"],["Importing : ","جاري الاستيراد : "],["All Done!","تم كل شيء!"],[" is not a valid object name"," ليس اسم كائن صالح"],[" is not a valid directory name"," ليس اسم مجلد صالح"],[" is already exist"," موجود بالفعل"],["Error opening file :","خطأ في فتح الملف :"],["Error executing :","خطأ في التنفيذ :"],["Are you sure want to execute the following script?","هل أنت متأكد من رغبتك في تنفيذ البرنامج النصي التالي؟"],["Clear quick launch","مسح الإطلاق السريع"],["Are you sure want to clear quick launch?","هل أنت متأكد من رغبتك في مسح الإطلاق السريع؟"],["How to add Automation here","كيفية إضافة الأتمتة هنا"],["Select all","تحديد الكل"],["Clear selection","مسح التحديد"],["Select 100%","تحديد 100%"],["Select <100%","تحديد <100%"],["Select progress ≥ ...","تحديد التقدم ≥ ..."],["Select completed","تحديد المكتمل"],["Invert selection","عكس التحديد"],["Toggle mark as complete","تبديل وضع علامة كمكتمل"],["With all","مع الكل"],["With ","مع "],[" selected"," محدد"],["Mark as complete","وضع علامة كمكتمل"],["Un-mark as complete","إزالة علامة كمكتمل"],["Batch translation","ترجمة مجمعة"],["Send to...","إرسال إلى..."],["Wrap texts","تفاف النصوص"],["Trim","قص"],["Auto padding","حشو تلقائي"],["Context Tool","أداة السياق"],["Create Automation","إنشاء أتمتة"],["For each object","لكل كائن"],["For each row","لكل صف"],["Run Automation","تشغيل الأتمتة"],["Import from...","استيراد من..."],["Trans File","ملف الترجمة"],["Spreadsheets","جداول البيانات"],["RPGMTransPatch Files","ملفات RPGMTransPatch"],["Export into...","تصدير إلى..."],["A folder","مجلد"],["Zipped Game Patch","رزمة لعبة مضغوطة"],["Comma Separated Value (csv)","قيم مفصولة بفواصل (csv)"],["Excel 2007 Spreadsheets (xlsx)","جداول بيانات Excel 2007 (xlsx)"],["Excel Spreadsheets (xls)","جداول بيانات Excel (xls)"],["ODS Spreadsheets","جداول بيانات ODS"],["Html Spreadsheets","جداول بيانات Html"],["RMTrans Patch","رزمة RMTrans"],["Inject Translation","حقن الترجمة"],["Revert to original","الرجوع إلى الأصل"],["Clear translation","مسح الترجمة"],["Delete files","حذف الملفات"],["Properties","خصائص"],["Select progress greater than","اختر التقدم أكبر من"],["Please input a number","الرجاء إدخال رقم"],["Do you want to clear translation?","هل تريد مسح الترجمة؟"],["Add comment","إضافة تعليق"],["Remove comment","إزالة تعليق"],["added to reference table!","تمت الإضافة إلى جدول المرجعية!"],["Can not modify Column 0","لا يمكن تعديل العمود 0"],["Unable to delete table : ","غير قادر على حذف الجدول: "],["Can not remove key column!","لا يمكن إزالة عمود المفتاح!"],["Please open or create a project first","الرجاء فتح أو إنشاء مشروع أولاً"],["Column name can not be empty!","اسم العمود لا يمكن أن يكون فارغاً!"],["Invalid column index!","فهرس عمود غير صالح!"],["Please open or create a new project first!","الرجاء فتح أو إنشاء مشروع جديد أولاً!"],["You should not edit key value","يجب ألا تقوم بتعديل قيمة المفتاح"],["Ilegal value","قيمة غير قانونية"],["That value already exist!","هذه القيمة موجودة بالفعل!"],["The maximum number of columns for this project has been reached, so you cannot add any more.","تم الوصول إلى الحد الأقصى لعدد الأعمدة لهذا المشروع، لذا لا يمكنك إضافة المزيد."],["Are you sure want to abort this process?","هل أنت متأكد أنك تريد إلغاء هذه العملية؟"],["Process paused!\nPress OK to continue!","العملية متوقفة!\nاضغط موافق للمتابعة!"],["Unable to process, project not found","غير قادر على المعالجة، المشروع غير موجود"],["Unable to process, data not found","غير قادر على المعالجة، البيانات غير موجودة"],["Translation engine not found","محرك الترجمة غير موجود"],["Translation engine ","محرك الترجمة "],[" is disabled!"," معطل!"],["Selected files :","الملفات المحددة:"],["Collecting data from :","جمع البيانات من:"],["Translation finished","تم الانتهاء من الترجمة"],["applying translation to table!","تطبيق الترجمة على الجدول!"],["Error when translating data!","خطأ عند ترجمة البيانات!"],["\tHTTP Status : ","\tحالة HTTP: "],["\tError Type : ","\tنوع الخطأ: "],["You are probably temporarily banned by your translation service!\r\nPlease use online translation service in moderation\r\nThis usualy fixed by itself within a day or two.\r\n","ربما تم حظرك مؤقتًا من خدمة الترجمة الخاصة بك!\r\nيرجى استخدام خدمة الترجمة عبر الإنترنت باعتدال\r\nعادةً ما يتم إصلاح هذا تلقائيًا خلال يوم أو يومين.\r\n"],["Running trans.translateAll","تشغيل trans.translateAll"],["Start collecting data!","بدء جمع البيانات!"],["Data collection is done!","تم جمع البيانات!"],["nothing is selected","لم يتم تحديد شيء"],["no translator loaded","لم يتم تحميل مترجم"],["unable to load translator window","غير قادر على تحميل نافذة المترجم"],["Reference path cannot empty!","مسار المرجع لا يمكن أن يكون فارغًا!"],["Collecting translation refference","جمع مرجع الترجمة"],["Applying translation!","تطبيق الترجمة!"],["Importing translation","استيراد الترجمة"],["Parsing data","تحليل البيانات"],[" is not a valid javascript's regexp!\r\nFind out more about Javascipt's Regular Expression at :\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"," ليس تعبيرًا منتظمًا صالحًا لجافاسكريبت!\r\nاكتشف المزيد حول التعبيرات المنتظمة لجافاسكريبت في:\r\nhttps://developer.mozilla.org/en-US/docs/Web/JavaScript/Guide/Regular_Expressions"],["Keyword too short!","الكلمة المفتاحية قصيرة جدًا!"],["Delete comment","حذف التعليق"],["Translate here","ترجم هنا"],["Translate here using ","ترجم هنا باستخدام "],["Translate using...","ترجم باستخدام..."],["Do you want to translate all the same texts found across this project with the translation on the selected cell(s)?","هل تريد ترجمة جميع النصوص المتشابهة الموجودة عبر هذا المشروع باستخدام الترجمة في الخلية (الخلايا) المحددة؟"],[" cell(s) has been written!"," تمت كتابة خلية (خلايا)!"],["Column width","عرض العمود"],["Width must greater than 0","يجب أن يكون العرض أكبر من 0"],["Insert column right","إدراج عمود إلى اليمين"],["Duplicate column","تكرار العمود"],["Remove this column","إزالة هذا العمود"],["Remove selected column?\nThis can not be undone!","إزالة العمود المحدد؟\nلا يمكن التراجع عن هذا!"],["Rename this column","إعادة تسمية هذا العمود"],["Please enter new name","الرجاء إدخال اسم جديد"],["Tags","العلامات"],["Red","أحمر"],["Yellow","أصفر"],["Green","أخضر"],["Blue","أزرق"],["Gold","ذهبي"],["More tags...","المزيد من العلامات..."],["Clear tags","مسح العلامات"],["Delete Row","حذف الصف"],["Do you want to remove the currently selected row(s)?","هل تريد إزالة الصف(وف) المحدد(ة) حاليًا؟"],["Clear Context Translation","مسح ترجمة السياق"],["Clear Automation","مسح الأتمتة"],["Are you sure want to clear all quick launch scripts?","هل أنت متأكد من رغبتك في مسح جميع نصوص التشغيل السريع؟"],["Append rows to reference","إضافة صفوف إلى المرجع"],["Row properties","خصائص الصف"]],"context":[["tid/2227/type/StringLiteral","tid/2619/type/StringLiteral"],["tid/2233/type/StringLiteral","tid/2625/type/StringLiteral"],["tid/2239/type/StringLiteral","tid/2631/type/StringLiteral"],["tid/2245/type/StringLiteral","tid/2637/type/StringLiteral"],["tid/2251/type/StringLiteral","tid/2643/type/StringLiteral"],["tid/4770/type/StringLiteral","tid/4811/type/StringLiteral","tid/18019/type/StringLiteral","tid/18070/type/StringLiteral","tid/18441/type/StringLiteral","tid/18484/type/StringLiteral","tid/18596/type/StringLiteral","tid/18692/type/StringLiteral","tid/18732/type/StringLiteral","tid/18832/type/StringLiteral","tid/20321/type/StringLiteral","tid/20364/type/StringLiteral"],["tid/5451/type/StringLiteral","tid/5538/type/StringLiteral","tid/5572/type/StringLiteral","tid/5947/type/StringLiteral","tid/5979/type/StringLiteral"],["tid/5457/type/StringLiteral"],["tid/5544/type/StringLiteral"],["tid/5578/type/StringLiteral"],["tid/5878/type/StringLiteral","tid/22004/type/StringLiteral","tid/22050/type/StringLiteral","tid/22829/type/StringLiteral","tid/22875/type/StringLiteral"],["tid/5884/type/StringLiteral"],["tid/5953/type/StringLiteral"],["tid/8844/type/StringLiteral"],["tid/9577/type/StringLiteral"],["tid/9623/type/StringLiteral"],["tid/11086/type/StringLiteral"],["tid/17099/type/StringLiteral"],["tid/18136/type/StringLiteral","tid/18762/type/StringLiteral","tid/18862/type/StringLiteral","tid/20430/type/StringLiteral"],["tid/18142/typ