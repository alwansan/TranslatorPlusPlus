VS Code"],["Notepad++","Notepad++"],["Open with...","فتح باستخدام..."]],"context":[["tid/2507/type/NoSubstitutionTemplate"],["tid/2512/type/NoSubstitutionTemplate"],["tid/3171/type/StringLiteral"],["tid/3253/type/StringLiteral"],["tid/3301/type/StringLiteral"],["tid/3392/type/StringLiteral"],["tid/3505/type/StringLiteral"],["tid/3692/type/StringLiteral"],["tid/3885/type/StringLiteral"]],"basename":"RawViewer.js","dirname":"/js","extension":".js","filename":"RawViewer.js","path":"/js/RawViewer.js","indexIsBuilt":false,"indexIds":{"Unable to find the file related to the data":0,"To fix this correct the <b>Raw material location</b> field at the <a href=\"#\" class=\"openProjectProperties\">Project properties</a>":1,"Copy path to clipboard":2,"Path has been copied to clipboard.":3,"Open folder":4,"Open with external application":5,"VS Code":6,"Notepad++":7,"Open with...":8},"tags":[],"relPath":"/js/RawViewer.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":9,"length":9,"percent":100},"parameters":[]},"/js/TranslationByContext.js":{"data":[["~use default translation~","~استخدام الترجمة الافتراضية~"],["Column","عمود"],["Do you want to delete all context translation on the currently selected row?","هل تريد حذف كل ترجمة السياق في الصف المحدد حاليًا؟"],["Do you want to delete all translation on the currently active row?","هل تريد حذف كل الترجمة في الصف النشط حاليًا؟"]],"context":[["tid/5275/type/StringLiteral"],["tid/5407/type/StringLiteral"],["tid/6138/type/StringLiteral"],["tid/6218/type/StringLiteral"]],"basename":"TranslationByContext.js","dirname":"/js","extension":".js","filename":"TranslationByContext.js","path":"/js/TranslationByContext.js","indexIsBuilt":false,"indexIds":{"~use default translation~":0,"Column":1,"Do you want to delete all context translation on the currently selected row?":2,"Do you want to delete all translation on the currently active row?":3},"tags":[],"relPath":"/js/TranslationByContext.js","originalFormat":"Auto