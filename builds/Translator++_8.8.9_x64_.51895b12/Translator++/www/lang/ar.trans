irectory.":19,"The existing files will be overwritten!":20,"Process":21,"Path to the directory can not be empty!":22,"Invalid directory:":23,"Rebuild translation table from this cache":24,"Create new project":25,"-nothing-":26,"Ok":27,"No action selected, are you sure?":28,"No context's keyword specified!":29,"Remove context containing keyword :\n":30,"\nfrom selected files?":31,"Remove every rows except rows that has a context containing keyword :\n":32,"items":33,"Select Context":34,"Manual Query":35,"Tag filter":36,"Merging option":37,"Source Column":38,"Target Column":39,"Maximum length":40,"Query":41,"Select how you want to filter the rows to be wrapped based on their context.":42,"Your list of context separated by new line":43,"Optionally filter rows by their color tags.":44,"Options":45,"No merging":46,"Merge lines":47,"Merge lines except first line":48,"General setup":49,"Wrap text":50,"Source & target column can not be same!":51,"No files are selected on file selector pane.\nTranslator++ will assume that all files will be processed\nAre you sure with this?":52,"One or more required options are not set for ":53,"One or more settings required by the translator engine are not set. If you continue, the translation process may fail.":54,"Required options :":55,"Open the settings":56,"Continue anyway":57,"Translate Now":58,"Please select translator engine":59,"Can not process your request because the source column and target column are same!":60,"Tags":61,"Merge Option":62,"Add rows":63,"None":64,"Merge":65,"Merge except the first line":66,"No export path specified":67,"Export path can not be inside or the same with the project folder.\nYour export path: ":68,"\nYour project path: ":69,"\n\nPlease choose another folder!":70,"Export Now":71,"Action":72,"Append tags":73,"Remove tags":74,"Set tags":75,"Do nothing":76,"-unknown title-":77,"Can not open file. File not exist.":78,"Go to online documentation.":79,"No projects yet":80,"Are you new to Translator++?<br />\n\t\t\tPlease read our online documentation at <b>dreamsavior.net</b>.<br />\n\t\t\tPress <b>F1</b> to open online help.<br />\n\t\t\tContact me at <b>patreon.com/dreamsavior</b> for question and bug reports.\n\t\t\t":81,"Warning":82,"Close":83,"You are about to run a user script!":84,"Execute the script":85,"Bring to main screen":86,"Show row header info":87,"Row header width":88,"Display marker on organic cells":89,"Leave trail on cell visit":90,"Display trails on visited cells":91,"Row Properties":92,"Project Properties":93,"Project Properties : ":94,"Stage path do not exist!":95,"Select dev folder":96,"Where is the translated game's directory located at?<br />This is the same folder with the destination directory when injecting your game.":97,"Select folder":98,"Submit":99,"File Properties":100,"File Properties : ":101,"Target column":102,"Trim Whitespaces":103,"Please select a column":104,"Are you sure want to trim the whitespaces on selected column?\nThis action can not be undone!":105,"Are you sure want commit autopadding on selected column?\nThis action can not be undone!":106,"Markers":107,"Markers are visual guidelines for the number of characters in a line.":108,"The marker will only be visible if wordwrap in the text area is disabled.":109,"Add":110,"Clear all":111,"Enable suggestion":112,"Speech Synthesizer":113,"Reading speed:":114,"Pitch:":115,"Volume:":116,"Mark at":117,"Units":118,"Half width character (ie. Alphabet, etc)":119,"Full width character (ie. Hiragana, Kanji, 漢字, etc)":120,"Color":121,"Remove":122,"Current Cell's Editor Options":123,"Auto Padding":124,"Create":125,"Unable to open that file!":126,"Are you sure want to close the project?\nYou will lost any unsaved changes!":127,"Are you sure want to exit Translator++?\nYou will lost any unsaved changes!":128,"Do not show this message again!":129,"Back":130,"Are you sure want to execute the following script?":131,"No script found":132,"Open Script Editor":133,"How to add Automation here":134,"Clear Quick Launch":135,"Are you sure want to clear all quick launch scripts?":136,"Remove selected objects?":137,"Do you wish to remove related staging files too?\nWarning: This is can not be undone!":138,"Error!\r\nTranslator++ is unable to detect the type of ":139,"`Required application to parse ${":140,"} is not installed.\\nPlease install it through Third party application installer.\\nDo you want to open Third Party Application Installer window?`":141,"The game is packed with Enigma.\r\nDo you want to extract the package?\r\nThis will take minutes, depend on the size of your game.":142,"Copy & extract data into ":143,"Are you realy sure want to delete all translation on current page?\nWarning: this is irreversible action!":144,"Are you realy sure want to delete current file?\nWarning: this is irreversible action!":145,"Please enter the title":146,"Do you want to remove the currently selected row(s)?":147},"tags":[],"relPath":"/js/ui.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":148,"length":148,"percent":100},"parameters":[]},"/js/ui.legacylog.js":{"data":[["You can view the more detailed information on console log (F12)","يمكنك عرض معلومات أكثر تفصيلاً في سجل وحدة التحكم (F12)"],["Close","إغلاق"]],"context":[["tid/496/type/StringLiteral"],["tid/777/type/StringLiteral"]],"basename":"ui.legacylog.js","dirname":"/js","extension":".js","filename":"ui.legacylog.js","path":"/js/ui.legacylog.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.legacylog.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/ui.log.js":{"data":[["You can view the more detailed information on console log (F12)","يمكنك عرض معلومات أكثر تفصيلاً في سجل وحدة التحكم (F12)"],["Close","إغلاق"]],"context":[["tid/946/type/StringLiteral"],["tid/1227/type/StringLiteral"]],"basename":"ui.log.js","dirname":"/js","extension":".js","filename":"ui.log.js","path":"/js/ui.log.js","indexIsBuilt":false,"indexIds":{"You can view the more detailed information on console log (F12)":0,"Close":1},"tags":[],"relPath":"/js/ui.log.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/js/ui.parts.js":{"data":[["Form","نموذج"],["Cancel","إلغاء"],["Ok","موافق"]],"context":[["tid/514/type/StringLiteral"],["tid/784/type/StringLiteral"],["tid/841/type/StringLiteral"]],"basename":"ui.parts.js","dirname":"/js","extension":".js","filename":"ui.parts.js","path":"/js/ui.parts.js","indexIsBuilt":false,"indexIds":{"Form":0,"Cancel":1,"Ok":2},"tags":[],"relPath":"/js/ui.parts.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/jsoneditor.html":{"data":[["Remove note","إزالة الملاحظة"]],"context":[["idx/0/attr/title"]],"basename":"jsoneditor.html","dirname":"/","extension":".html","filename":"jsoneditor.html","path":"/jsoneditor.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/jsoneditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/login.html":{"data":[["working","يعمل"]],"context":[["idx/0/innerText"]],"basename":"login.html","dirname":"/","extension":".html","filename":"login.html","path":"/login.html","indexIsBuilt":false,"indexIds":{"working":0},"tags":[],"relPath":"/login.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/note.html":{"data":[["Remove note","إزالة الملاحظة"]],"context":[["idx/0/attr/title"]],"basename":"note.html","dirname":"/","extension":".html","filename":"note.html","path":"/note.html","indexIsBuilt":false,"indexIds":{"Remove note":0},"tags":[],"relPath":"/note.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/options.html":{"data":[["Click to login","انقر لتسجيل الدخول"],["Translator &amp; Language","المترجم واللغة"],["Proofreader","مدقق لغوي"],["Assistant","مساعد"],["General","عام"],["Preferences","التفضيلات"],["Add-ons","الإضافات"],["About","حول"],["User Information","معلومات المستخدم"],["Login to your Patreon account to get access to the latest features and updates.","سجّل الدخول إلى حساب Patreon الخاص بك للوصول إلى أحدث الميزات والتحديثات."],["<i class=\"icon-login\"></i> Login","<i class=\"icon-login\"></i> تسجيل الدخول"],["<i class=\"icon-login\"></i> Login with browser","<i class=\"icon-login\"></i> تسجيل الدخول باستخدام المتصفح"],["Welcome,","مرحباً،"],["Name","الاسم"],["Email","البريد الإلكتروني"],["Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>","المستوى <div class=\"infoHeadNote\">(الاشتراك الحالي بالسنتات الأمريكية)</div>"],["Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>","النقاط <div class=\"infoHeadNote\">(إجمالي الاشتراك مدى الحياة بالسنتات الأمريكية)</div>"],["Payment status <div class=\"infoHeadNote\">(Current payment status)</div>","حالة الدفع <div class=\"infoHeadNote\">(حالة الدفع الحالية)</div>"],["\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t","\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">لا داعي للذعر!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>ورجاءً اقرأ المعلومات التالية.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">يشير هذا العلم إلى أن Patreon لم يتلقَ بعد الأموال لالتزامك. من الطبيعي أن يواجه نظام الدفع تأخيرات. اعتماداً على طريقة الدفع وبلدك الأصلي، قد تحدث تأخيرات تصل إلى 24 ساعة.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">خلال هذا التأخير، قد ترى خصماً من بطاقتك الائتمانية. لا تقلق—سيحاول Patreon بشكل دوري التحقق مما إذا كان قد تلقى دفعتك. عادةً ما يحل هذا الأمر نفسه خلال 24 ساعة.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">إذا استمرت المشكلة بعد هذه الفترة، يرجى النشر في موضوع <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> على خادم Translator++ في Discord. سأساعدك قدر الإمكان.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">يرجى فهم أنه لمنع الاحتيال، <b><span class=\"userInfoPoints\">النقاط</span> و <span class=\"userInfoLevel\">المستوى</span> لن تُحتسب حتى يتلقى Patreon دفعتك بنجاح</b>.</p>\n\t\t\t\t\t\t\t\t"],["<span class=\"blue\">Don't panic!</span>","<span class=\"blue\">لا داعي للذعر!</span>"],["This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.","يشير هذا العلم إلى أن Patreon لم يتلقَ بعد الأموال لالتزامك. من الطبيعي أن يواجه نظام الدفع تأخيرات. اعتماداً على طريقة الدفع وبلدك الأصلي، قد تحدث تأخيرات تصل إلى 24 ساعة."],["During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.","خلال هذا التأخير، قد ترى خصماً من بطاقتك الائتمانية. لا تقلق—سيحاول Patreon بشكل دوري التحقق مما إذا كان قد تلقى دفعتك. عادةً ما يحل هذا الأمر نفسه خلال 24 ساعة."],["If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.","إذا استمرت المشكلة بعد هذه الفترة، يرجى النشر في موضوع <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> على خادم Translator++ على Discord. سأقدم لك المساعدة بقدر الإمكان."],["Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.","يرجى فهم أنه لمنع الاحتيال، <b><span class=\"userInfoPoints\">النقاط</span> و <span class=\"userInfoLevel\">المستوى</span> لن تُحتسب حتى يتم استلام دفعتك بنجاح من قبل Patreon</b>."],["<i class=\"icon-logout\"></i> Logout","<i class=\"icon-logout\"></i> تسجيل الخروج"],["Primary Translator","المترجم الرئيسي"],["Default Translator Engine","محرك الترجمة الافتراضي"],["\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t","\n\t\t\t\t\tسيتم استخدام محرك الترجمة هذا عند الضغط على <span class=\"keyboardHint\">Ctrl+g</span> في الخلية (الخلايا) المحددة ل<strong>ت</strong>وليد الترجمة في الخلية المحددة.\n\t\t\t\t"],["Default Language","اللغة الافتراضية"],["\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t","\n\t\t\t\tإعدادات اللغة الافتراضية عبر المشاريع!<br>\n\t\t\t\tسيتم تجاوز هذه القيمة بواسطة الإعدادات في خصائص المشروع.\n\t\t\t"],["Default Source Language","لغة المصدر الافتراضية"],["Default Target Language","لغة الهدف الافتراضية"],["Custom escape","الهروب المخصص"],["Patterns","أنماط"],["\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t","\n\t\t\t\t\t\tجميع الكلمات التي تطابق النمط أدناه لن تتم ترجمتها بواسطة مترجمي الآلة. \n\t\t\t\t\t\tهذا القسم مناسب لإخفاء العلامات والنصوص البرمجية من محركات الترجمة. <br>\n\t\t\t\t\t\tكل إدخال هو تعبير عادي صالح في جافا سكريبت، أو دالة، أو literal string مفصولة ب<b>فاصلة</b>.<br>\n\t\t\t\t\t\tيعمل الهروب المخصص فقط لخوارزميات <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">الهروب المدعومة</a>.\n\t\t\t\t\t\t<b>تلميح:</b> يمكنك أيضًا طلب من ChatGPT إنشاء تعبير عادي لك. <br>\n\t\t\t\t\t\tيرجى كتابة نمط التعبير العادي مع معدله.<br>\n\t\t\t\t\t\tعلى سبيل المثال:\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t"],["Tester","اختبار"],["\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t","\n\t\t\t\t\t\tالصق نصك هنا للتحقق من النمط.\n\t\t\t\t\t\tسيتم تمييز جميع الأنماط المطابقة.\n\t\t\t\t\t"],["\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t","\n\t\t\t\t<h2>قيد الإنشاء</h2>\n\t\t\t\t<p>ستكون هذه المنطقة مكانًا لتكوين إعدادات وخيارات المدقق الآلي التلقائي.</p>\n\t\t\t"],["AI Assistant","مساعد الذكاء الاصطناعي"],["\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t","\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>مرحبًا! أنا ميراي، مساعدك الذكي للذكاء الاصطناعي في Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>ما عليك سوى النقر على أيقونتي <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> في قائمة الصفحة الرئيسية للدردشة معي. يمكنني مساعدتك في:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>تحسينات واقتراحات الترجمة</li>\n\t\t\t\t\t\t\t<li>التدقيق والتحقق من الجودة</li>\n\t\t\t\t\t\t\t<li>إعداد سير عمل الترجمة الخاص بك</li>\n\t\t\t\t\t\t\t<li>إنشاء نصوص برمجية للأتمتة</li>\n\t\t\t\t\t\t\t<li>والمزيد!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>لنجعل عملك في الترجمة أسهل وأكثر كفاءة معًا!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>ملاحظة: ما زلت جديدًا، لذا، يرجى التحلي بالصبر معي.🙇‍♀️ لكنني أتعلم وأتحسن كل يوم!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t"],["AI Configuration","تكوين الذكاء الاصطناعي"],["Model Endpoint","نقطة نهاية النموذج"],["The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions","عنوان نقطة نهاية API لنموذج الذكاء الاصطناعي الخاص بك. على سبيل المثال: https://api.openai.com/v1/chat/completions"],["API Key","مفتاح API"],["Your API key for authenticating with the AI service. This will be stored securely.","مفتاح API الخاص بك للمصادقة مع خدمة الذكاء الاصطناعي. سيتم تخزينه بأمان."],["Model Name","اسم النموذج"],["Select or enter the AI model to use. Models with tool support are recommended for best results.","اختر أو أدخل نموذج الذكاء الاصطناعي للاستخدام. يوصى بنماذج تدعم الأدوات للحصول على أفضل النتائج."],["File Association","ارتباط الملف"],["Extension","امتداد"],["Associate","اربط"],["Set All","تعيين الكل"],["Unset All","إلغاء تعيين الكل"],["Apply","تطبيق"],["Update","تحديث"],["Auto update","تحديث تلقائي"],["Automatically update Translator++ if possible.","قم بتحديث Translator++ تلقائيًا إذا أمكن."],["Allow reinstall the same version","السم بإعادة تثبيت نفس الإصدار"],["Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.","اسمح لـ Translator++ بإعادة تثبيت نفس الإصدار الذي تم تثبيته بالفعل. يرجى إبقاء هذا الخيار معطلاً بعد تثبيت التحديث، خاصة عندما يكون إعداد <b>التحديث التلقائي</b> قيد التشغيل. وإلا، سيستمر Translator++ في تحديث نفسه في كل مرة تفتح فيها البرنامج."],["Use default browser to login","استخدام المتصفح الافتراضي لتسجيل الدخول"],["Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.","استخدم المتصفح الافتراضي الموثوق به في نظامك لتسجيل الدخول إلى حساب Patreon الخاص بك. ما لم يتم تحديد هذا الخيار، سيتم استخدام المتصفح المدمج في Translator++."],["Multi threading","متعدد الخيوط"],["Number of thread","عدد الخيوط"],["The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t","عدد العمليات الفرعية التي يتم فتحها في وقت واحد.<br>\n\t\t\t\t\t\t\t0 = تعطيل التعددية الخيطية. سيتم تنفيذ جميع العمليات بواسطة عملية العرض.<br>\n\t\t\t\t\t\t\tالكمية المثلى عادةً هي عدد النوى الفعلية لديك - 1.\n\t\t\t\t\t\t"],["Backup","نسخ احتياطي"],["Enable backup","تفعيل النسخ الاحتياطي"],["Automatically create backup every time you save your project.","إنشاء نسخة احتياطية تلقائياً في كل مرة تحفظ فيها مشروعك."],["Backup level history","سجل مستويات النسخ الاحتياطي"],["How many history of backup do you want to keep?","كم عدد سجلات النسخ الاحتياطي التي تريد الاحتفاظ بها؟"],["Log &amp; Debugging","السجلات والتشخيص"],["Log to file","تسجيل في ملف"],["Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.","تسجيل في ملف بدلاً من نافذة وحدة التحكم الافتراضية.<br>هذا مفيد إذا كنت تريد تشخيص Translator++ وليس لديك إمكانية الوصول إلى نافذة وحدة التحكم. تفعيل هذا الخيار سيؤثر قليلاً على الأداء. لذا، يجب أن يكون هذا الخيار معطلاً في جميع الأوقات، إلا عند التشخيص أو الإبلاغ عن المشاكل.<br>يتم حفظ السجلات في مجلد data/logs/."],["Truncate log file each session","تقليم ملف السجل في كل جلسة"],["When checked your log file will be truncated each time you re open the application.","عند التحديد، سيتم تقليم ملف السجل الخاص بك في كل مرة تعيد فيها فتح التطبيق."],["Application Settings","إعدادات التطبيق"],["Enable remote debugging","تفعيل التشخيص عن بعد"],["Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.","يُمكّن بروتوكول تشخيص Chrome DevTools عن بعد على المنفذ 9222. هذا يسمح لك بفحص وتشخيص Translator++ باستخدام متصفح خارجي عن طريق الانتقال إلى <code>chrome://inspect</code>. هذا العلم يضيف <code>--remote-debugging-port=9222</code> إلى وسائط بدء تشغيل التطبيق. يلزم إعادة التشغيل لتطبيق التغييرات."],["Disable GPU","تعطيل GPU"],["Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.","يعطل تسريع GPU للأجهزة. هذا مفيد إذا واجهت أخطاء بصرية، أو تعطلات، أو مشاكل في العرض على أجهزة أو برامج تشغيل رسومات معينة. هذا العلم يضيف <code>--disable-gpu</code> إلى وسائط بدء تشغيل التطبيق. يلزم إعادة التشغيل لتطبيق التغييرات."],["Dangerous Area","منطقة خطرة"],["Interface Language","لغة الواجهة"],["UI Language","لغة واجهة المستخدم"],["Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.","تعيين لغة واجهة المستخدم. يمكنك إنشاء الترجمة الخاصة بك إذا لم يكن Translator++ متوفراً بلغتك. بيانات اللغة موجودة داخل مجلد www/lang."],["Spell checker Language","لغة مدقق الإملاء"],["Set the default spell checker language.","تعيين لغة مدقق الإملاء الافتراضية."],["Environment Variables","متغيرات البيئة"],["Staging Directory","دليل التجهيز"],["Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.","دليل التجهيز هو ذاكرة تخزين مؤقت صارمة للمشاريع قيد العمل. يتم نسخ جزء من البيانات من المواد الخام إلى هذا الدليل للوصول إليها بواسطة نصوص المترجم."],["Project creation","إنشاء المشروع"],["Auto Load Common Reference","تحميل المرجع المشترك تلقائيًا"],["Auto load common reference from .trans file.","تحميل المرجع المشترك تلقائيًا من ملف .trans."],["Project settings","إعدادات المشروع"],["Progress Column Indices","مؤشرات أعمدة التقدم"],["Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t","هنا، يمكنك تحديد الأعمدة التي سيتم تضمينها في حساب تقدم المشروع.\n\t\t\t\t\t\t\t<br>مؤشر العمود هو عدد صحيح يبدأ من الصفر، حيث العمود الأقصى اليسار هو 0.\n\t\t\t\t\t\t\t<br>استخدم الفواصل لتحديد أعمدة متعددة. على سبيل المثال: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>الافتراضي: فارغ</b>. إذا تركت فارغًا، سيقوم Translator++ بحساب التقدم من جميع الأعمدة المتاحة.\n\t\t\t\t\t\t"],["<i class=\"selected icon-ok-circled\"></i>Enable/Disable","<i class=\"selected icon-ok-circled\"></i>تفعيل/تعطيل"],["<i class=\"icon-download-cloud-1\"></i>Install","<i class=\"icon-download-cloud-1\"></i>تثبيت"],["Install from a package","التثبيت من حزمة"],["Visit our website &amp; documentation : ","قم بزيارة موقعنا الوثائقي: "],["Fork Translator++ at : ","انشر Translator++ على: "],["Support Translator++ at : ","ادعم Translator++ على: "],["Join our discord channel at : ","انضم إلى قناتنا على Discord في: "],["*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!","*) إذا كنت راعيًا، يجب أن <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">تربط حساب Discord الخاص بك على ملفك الشخصي في Patreon</a>. ستتم دعوتك تلقائيًا، وهناك مزايا تنتظرك!"],["Version Info","معلومات الإصدار"],["Last checked at : ","آخر فحص في: "],["Check now!","تحقق الآن!"],["You have a pending update","لديك تحديث معلق"],["Update now","تحديث الآن"],["Your Translator++ is up to date 😃.","مترجمك++ محدث 😃."],["Architecture","الهندسة المعمارية"],["License","الترخيص"],["Click here to read the license.","انقر هنا لقراءة الترخيص."],["Credits","الاعتمادات"],["Localization","التوطين"],["About Third Party Software","حول برامج الطرف الثالث"],["\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t","\n\t\t\t\tيستخدم هذا البرنامج برامج طرف ثالث موجودة في /3rdParty. تحمل برامج الطرف الثالث هذه تراخيصها الخاصة و\n\t\t\t\tتتضمن فقط لتسهيل الاستخدام و\n\t\t\t\tتقدم \"كما هي\" دون أي ضمان، سواء صريح أو ضمني، ويجب استخدام هذا البرنامج على مسؤوليتك الخاصة.\n\t\t\t\t"],["Special Thanks","شكر خاص"],["Want to explicitly support Translator++ by putting your name on this section?","هل ترغب في دعم مترجم++ بوضع اسمك في هذا القسم؟"],["Click here to learn more about how to do that!","انقر هنا لمعرفة المزيد عن كيفية القيام بذلك!"],["Changelog","سجل التغييرات"],["Feeds","التغذية"],["Click connect button, to connect translator with Translator++ table","انقر على زر الاتصال، لربط المترجم بجدول مترجم++"],["working","يعمل"],["Patreon level/Your current pledge this month in cent (1 USD = 100 lv)","مستوى باتريون/التبرع الحالي لك هذا الشهر بالسنت (1 دولار = 100 مستوى)"],["Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)","النقاط/التعهد مدى الحياة+المكافآت بالسنت (1 دولار = 100 نقطة)"],["Filter...","تصفية..."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/25/innerText"],["idx/2/innerText","idx/38/innerText"],["idx/3/innerText"],["idx/4/innerText","idx/49/innerText"],["idx/5/innerText","idx/82/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/9/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/28/innerText"],["idx/29/innerText"],["idx/30/innerText"],["idx/31/innerText"],["idx/32/innerText"],["idx/33/innerText"],["idx/34/innerText"],["idx/35/innerText"],["idx/36/innerText"],["idx/37/innerText"],["idx/39/innerText"],["idx/40/innerText"],["idx/41/innerText"],["idx/42/innerText"],["idx/43/innerText"],["idx/44/innerText"],["idx/45/innerText"],["idx/46/innerText"],["idx/47/innerText"],["idx/48/innerText"],["idx/50/innerText"],["idx/51/innerText"],["idx/52/innerText"],["idx/53/innerText"],["idx/54/innerText"],["idx/55/innerText"],["idx/56/innerText"],["idx/57/innerText"],["idx/58/innerText"],["idx/59/innerText"],["idx/60/innerText"],["idx/61/innerText"],["idx/62/innerText"],["idx/63/innerText"],["idx/64/innerText"],["idx/65/innerText"],["idx/66/innerText"],["idx/67/innerText"],["idx/68/innerText"],["idx/69/innerText"],["idx/70/innerText"],["idx/71/innerText"],["idx/72/innerText"],["idx/73/innerText"],["idx/74/innerText"],["idx/75/innerText"],["idx/76/innerText"],["idx/77/innerText"],["idx/78/innerText"],["idx/79/innerText"],["idx/80/innerText"],["idx/81/innerText"],["idx/83/innerText"],["idx/84/innerText"],["idx/85/innerText"],["idx/86/innerText"],["idx/87/innerText"],["idx/88/innerText"],["idx/89/innerText"],["idx/90/innerText"],["idx/91/innerText"],["idx/92/innerText"],["idx/93/innerText"],["idx/94/innerText"],["idx/95/innerText"],["idx/96/innerText"],["idx/97/innerText"],["idx/98/innerText"],["idx/99/innerText"],["idx/100/innerText"],["idx/101/innerText"],["idx/102/innerText"],["idx/103/innerText"],["idx/104/innerText"],["idx/105/innerText"],["idx/106/innerText"],["idx/107/innerText"],["idx/108/innerText"],["idx/109/innerText"],["idx/110/innerText"],["idx/111/innerText"],["idx/112/innerText"],["idx/113/innerText"],["idx/114/innerText"],["idx/115/innerText"],["idx/116/innerText"],["idx/117/innerText"],["idx/118/innerText"],["idx/119/innerText"],["idx/120/innerText"],["idx/121/innerText"],["idx/122/innerText"],["idx/123/innerText"],["idx/124/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/placeholder","idx/3/attr/placeholder"]],"basename":"options.html","dirname":"/","extension":".html","filename":"options.html","path":"/options.html","indexIsBuilt":false,"indexIds":{"Click to login":0,"Translator &amp; Language":1,"Proofreader":2,"Assistant":3,"General":4,"Preferences":5,"Add-ons":6,"About":7,"User Information":8,"Login to your Patreon account to get access to the latest features and updates.":9,"<i class=\"icon-login\"></i> Login":10,"<i class=\"icon-login\"></i> Login with browser":11,"Welcome,":12,"Name":13,"Email":14,"Level <div class=\"infoHeadNote\">(Current subscription in USD cents)</div>":15,"Points <div class=\"infoHeadNote\">(Total lifetime subscription in USD cents)</div>":16,"Payment status <div class=\"infoHeadNote\">(Current payment status)</div>":17,"\n\t\t\t\t\t\t\t\t\t<h4 data-tran=\"\"><span class=\"blue\">Don't panic!</span></h4>\n\t\t\t\t\t\t\t\t\t<h5>And please read the following information.</h5>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.</p>\n\t\t\t\t\t\t\t\t\t<p data-tran=\"\">Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.</p>\n\t\t\t\t\t\t\t\t":18,"<span class=\"blue\">Don't panic!</span>":19,"This flag indicates that Patreon has not yet successfully received the funds for your pledge. It's normal for the payment system to experience delays. Depending on your payment method and country of origin, delays can occur for up to 24 hours.":20,"During this delay, you might see a debit from your credit card. Don’t worry—Patreon will retry at regular intervals to check if they have received your payment. This usually resolves itself within 24 hours.":21,"If the issue persists beyond this period, please post in the <a href=\"https://discord.com/channels/870491016891883570/1122329902637650010\" external=\"\">account-problem</a> thread on the Translator++ server on Discord. I will assist you as much as possible.":22,"Please understand that to prevent fraud, <b><span class=\"userInfoPoints\">points</span> and <span class=\"userInfoLevel\">Level</span> will not be counted until your payment has been successfully received by Patreon</b>.":23,"<i class=\"icon-logout\"></i> Logout":24,"Primary Translator":25,"Default Translator Engine":26,"\n\t\t\t\t\tThis Translator Engine will be used when you press <span class=\"keyboardHint\">Ctrl+g</span> at the selected cell(s) to <strong>g</strong>enerate translation at selected cell.\n\t\t\t\t":27,"Default Language":28,"\n\t\t\t\tThe default language settings across projects!<br>\n\t\t\t\tThe settings in the project's properties will override this value.\n\t\t\t":29,"Default Source Language":30,"Default Target Language":31,"Custom escape":32,"Patterns":33,"\n\t\t\t\t\t\tAll words that match the pattern below will not be translated by machine translators. \n\t\t\t\t\t\tThis section is suitable for hiding tags and scripts from translation engines. <br>\n\t\t\t\t\t\tEach entry is a valid javaScript's of regular expression, function, or literal string that separated by a <b>comma</b>.<br>\n\t\t\t\t\t\tCustom escape only worked for supported <a href=\"https://dreamsavior.net/docs/translator/code-escaping-algorithm/custom-pattern/\" class=\"externalLink\">escape algorithm</a>.\n\t\t\t\t\t\t<b>Hint:</b>You can also ask ChatGPT to generate you regular expression. <br>\n\t\t\t\t\t\tPlease write the regex pattern along with its modifier.<br>\n\t\t\t\t\t\tfor example :\n\t\t\t\t\t\t<code>/(\\\\[a-zA-Z0-9]+\\[.*\\])+/gi</code>\n\t\t\t\t\t":34,"Tester":35,"\n\t\t\t\t\t\tPaste your text here to check the pattern.\n\t\t\t\t\t\tAll matched pattern will be highlighted.\n\t\t\t\t\t":36,"\n\t\t\t\t<h2>Under Construction</h2>\n\t\t\t\t<p>This area will be the place where automatic proofreader settings and options will be configured.</p>\n\t\t\t":37,"AI Assistant":38,"\n\t\t\t\t\t<div style=\"display: inline-block; padding-top:2em; margin-left: -1.5em;\">\n\t\t\t\t\t\t<i class=\"icon-mira-ai-assistant\" style=\"font-size: 6em;\"></i>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div>\n\t\t\t\t\t\t<p><strong>Hi! I'm MIRAI, your AI assistant for Translator++.👋</strong></p>\n\t\t\t\t\t\t<p>Just click my icon <button type=\"button\" onclick=\"addonLoader.addons.basicUtils.openMiraiAssistant()\"><i class=\"icon-mira-ai-assistant\" style=\"font-size: 1.5em;\"></i></button> on your Home menu to chat with me. I can assist you with:</p>\n\t\t\t\t\t\t<ul>\n\t\t\t\t\t\t\t<li>Translation improvements and suggestions</li>\n\t\t\t\t\t\t\t<li>Proofreading and quality checks</li>\n\t\t\t\t\t\t\t<li>Setting up your translation workflow</li>\n\t\t\t\t\t\t\t<li>Creating automation scripts</li>\n\t\t\t\t\t\t\t<li>And much more!</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t<p>Let's make your translation work easier and more efficient together!</p>\n\t\t\t\t\t\t<br>\n\t\t\t\t\t\t<p><i>PS. I'm still new, So, please be patient with me.🙇‍♀️ But I'm learning and improving every day!😉</i></p>\n\t\t\t\t\t</div>\n\t\t\t\t":39,"AI Configuration":40,"Model Endpoint":41,"The API endpoint URL for your AI model. For example: https://api.openai.com/v1/chat/completions":42,"API Key":43,"Your API key for authenticating with the AI service. This will be stored securely.":44,"Model Name":45,"Select or enter the AI model to use. Models with tool support are recommended for best results.":46,"File Association":47,"Extension":48,"Associate":49,"Set All":50,"Unset All":51,"Apply":52,"Update":53,"Auto update":54,"Automatically update Translator++ if possible.":55,"Allow reinstall the same version":56,"Allow Translator++ to reinstall the same version that has already been installed. Please keep this option disabled after you've installed the update, especially when your <b>Auto update</b> setting is on. Otherwise, your Translator++ will keep updating itself each time you open the program.":57,"Use default browser to login":58,"Use your trusted system's default browser to login into your Patreon account. Unless this option is checked, Translator++'s embedded browser will be used.":59,"Multi threading":60,"Number of thread":61,"The number of child processes that are opened simultaneously.<br>\n\t\t\t\t\t\t\t0 = disable multi threading. All process will be done by renderer process.<br>\n\t\t\t\t\t\t\tThe optimum amount usually is the number of your physical core - 1.\n\t\t\t\t\t\t":62,"Backup":63,"Enable backup":64,"Automatically create backup every time you save your project.":65,"Backup level history":66,"How many history of backup do you want to keep?":67,"Log &amp; Debugging":68,"Log to file":69,"Log to file instead of the default console window.<br>This is useful if you want to debug Translator++ and you don't have access to the console window. Enabling this option will impact the performance slightly. So, you want this option to be off all the time, except when you're debugging or reporting problems.<br>Logs are saved in data/logs/ folder.":70,"Truncate log file each session":71,"When checked your log file will be truncated each time you re open the application.":72,"Application Settings":73,"Enable remote debugging":74,"Enables the Chrome DevTools remote debugging protocol on port 9222. This allows you to inspect and debug Translator++ using an external browser by navigating to <code>chrome://inspect</code>. This flag adds <code>--remote-debugging-port=9222</code> to the application startup arguments. A restart is required to apply changes.":75,"Disable GPU":76,"Disables hardware GPU acceleration. This is useful if you experience visual glitches, crashes, or rendering issues on certain graphics hardware or drivers. This flag adds <code>--disable-gpu</code> to the application startup arguments. A restart is required to apply changes.":77,"Dangerous Area":78,"Interface Language":79,"UI Language":80,"Set the language of the user interface. You can create your own localization if Translator++ is not available in your language. The language data are located inside www/lang folder.":81,"Spell checker Language":82,"Set the default spell checker language.":83,"Environment Variables":84,"Staging Directory":85,"Staging Directory is a hard cache of projects that are being worked on. A portion of the data from the raw materials are copied to this directory to be accessed the interpreter scripts.":86,"Project creation":87,"Auto Load Common Reference":88,"Auto load common reference from .trans file.":89,"Project settings":90,"Progress Column Indices":91,"Here, you can specify which columns will be included in the project's progress calculation.\n\t\t\t\t\t\t\t<br>The column index is a zero-based integer, where the leftmost column is 0.\n\t\t\t\t\t\t\t<br>Use commas to specify multiple columns. For example: <code>2,3,4</code>.\n\t\t\t\t\t\t\t<br><b>Default: Blank</b>. If left blank, Translator++ will calculate progress from all available columns.\n\t\t\t\t\t\t":92,"<i class=\"selected icon-ok-circled\"></i>Enable/Disable":93,"<i class=\"icon-download-cloud-1\"></i>Install":94,"Install from a package":95,"Visit our website &amp; documentation : ":96,"Fork Translator++ at : ":97,"Support Translator++ at : ":98,"Join our discord channel at : ":99,"*) If you're a patron, you should <a href=\"https://support.patreon.com/hc/en-us/articles/212052266-How-do-I-connect-Discord-to-Patreon-Patron-\" target=\"_system\" external=\"\">link your discord account on your Patreon profile</a>. You will get invited automatically, and there are benefits waiting for you!":100,"Version Info":101,"Last checked at : ":102,"Check now!":103,"You have a pending update":104,"Update now":105,"Your Translator++ is up to date 😃.":106,"Architecture":107,"License":108,"Click here to read the license.":109,"Credits":110,"Localization":111,"About Third Party Software":112,"\n\t\t\t\tThis software is using third party softwares that located at /3rdParty. These third party softwares hold their own licenses and \n\t\t\t\tare included solely for convenience of use and \n\t\t\t\tprovided “as is” without warranty of any kind, either expressed or implied and such software is to be used at your own risk.\n\t\t\t\t":113,"Special Thanks":114,"Want to explicitly support Translator++ by putting your name on this section?":115,"Click here to learn more about how to do that!":116,"Changelog":117,"Feeds":118,"Click connect button, to connect translator with Translator++ table":119,"working":120,"Patreon level/Your current pledge this month in cent (1 USD = 100 lv)":121,"Points/Your lifetime pledge+bonuses in cent (1 USD = 100 pts)":122,"Filter...":123},"tags":[],"relPath":"/options.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":124,"length":124,"percent":100},"parameters":[]},"/scriptEditor.html":{"data":[["Run","تشغيل"],["New Project (ctrl+n)","مشروع جديد (ctrl+n)"],["Open (ctrl+o)","فتح (ctrl+o)"],["Save file (ctrl+s)","حفظ الملف (ctrl+s)"],["Save As (ctrl+shift+s)","حفظ باسم (ctrl+shift+s)"],["Open debugger (F12)","فتح المصحح (F12)"],["Help","مساعدة"],["Select file in the current workspace","اختر ملفًا في مساحة العمل الحالية"],["file path","مسار الملف"],["Create shortcut of the current script","إنشاء اختصار للنص الحالي"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/4/attr/title"],["idx/5/attr/title"],["idx/6/attr/title"],["idx/7/attr/title"],["idx/8/attr/title"]],"basename":"scriptEditor.html","dirname":"/","extension":".html","filename":"scriptEditor.html","path":"/scriptEditor.html","indexIsBuilt":false,"indexIds":{"Run":0,"New Project (ctrl+n)":1,"Open (ctrl+o)":2,"Save file (ctrl+s)":3,"Save As (ctrl+shift+s)":4,"Open debugger (F12)":5,"Help":6,"Select file in the current workspace":7,"file path":8,"Create shortcut of the current script":9},"tags":[],"relPath":"/scriptEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":10,"length":10,"percent":100},"parameters":[]},"/tableEditor.html":{"data":[["Reset","إعادة تعيين"],["Clear","مسح"],["Search","بحث"],["Help","مساعدة"]],"context":[["idx/0/innerText"],["idx/1/innerText"],["idx/0/attr/title"],["idx/1/attr/title"]],"basename":"tableEditor.html","dirname":"/","extension":".html","filename":"tableEditor.html","path":"/tableEditor.html","indexIsBuilt":false,"indexIds":{"Reset":0,"Clear":1,"Search":2,"Help":3},"tags":[],"relPath":"/tableEditor.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/trans.html":{"data":[["Start","بدء"],["Home","الرئيسية"],["Translator","المترجم"],["Objects","الكائنات"],["Live translation","ترجمة حية"],["Original","الأصل"],["Raw","خام"],["Row Properties","خصائص الصف"],["Default translation","الترجمة الافتراضية"],["Context translation","ترجمة السياق"],["\n\t\tPath <a class=\"problemPath\"></a> is not accessible by PHP interpreter.<br>\n\t\tPlease rename the path and use only alphanumeric naming.\n\t","\n\t\tالمسار <a class=\"problemPath\"></a> غير قابل للوصول بواسطة مترجم PHP.<br>\n\t\tيرجى إعادة تسمية المسار واستخدام تسمية أبجدية رقمية فقط.\n\t"],["<i class=\"icon-pin\"></i><span>Location</span>","<i class=\"icon-pin\"></i><span>الموقع</span>"],["File :","الملف :"],["Row ID :","معرف الصف :"],["<i class=\"icon-th-2\"></i><span>Context</span>","<i class=\"icon-th-2\"></i><span>السياق</span>"],["<i class=\"icon-users\"></i><span>Actors</span>","<i class=\"icon-users\"></i><span>الممثلون</span>"],["<i class=\"icon-key-inv\"></i><span>Key Text</span>","<i class=\"icon-key-inv\"></i><span>النص الرئيسي</span>"],["<i class=\"icon-translate-1\"></i><span>Best Translation</span>","<i class=\"icon-translate-1\"></i><span>أفضل ترجمة</span>"],["File ID","معرف الملف"],["Path","المسار"],["Original Format","التنسيق الأصلي"],["Data Length","طول البيانات"],["Translated","مترجم"],["General","عام"],["Language","اللغة"],["Staging","المرحلة"],["Stats","الإحصائيات"],["Advanced","متقدم"],["Info","معلومات"],["Title","العنوان"],["File Location","موقع الملف"],["Project ID","معرف المشروع"],["Built on","مبني على"],["Editor Name","اسم المحرر"],["Editor Version","إصدار المحرر"],["Engine","المحرك"],["Parser","المحلل"],["Parser version","إصدار المحلل"],["Raw Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the original material. You should not modify anything inside this folder.\"></i>","موقع المواد الخام <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"موقع المواد الأصلية. يجب ألا تعدل أي شيء داخل هذا المجلد.\"></i>"],["<i class=\"icon-attention red\"></i> Invalid path.<br>Some features will be disabled until this is fixed.","<i class=\"icon-attention red\"></i> مسار غير صالح.<br>سيتم تعطيل بعض الميزات حتى يتم إصلاح هذا."],["Translated Material Location <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"The location of the game that has been translated. The default location of the translation injection.\"></i>","موقع المواد المترجمة <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"موقع اللعبة التي تمت ترجمتها. الموقع الافتراضي لحقن الترجمة.\"></i>"],["Translator <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Prefered translator for this project. If not defined, global setting will be used.\"></i>","المترجم <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"المترجم المفضل لهذا المشروع. إذا لم يتم تعريفه، سيتم استخدام الإعدادات العامة.\"></i>"],["Translate From","الترجمة من"],["Translate Into","الترجمة إلى"],["Staging Path <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.\"></i>","مسار التجهيز <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"مسار التجهيز هو موقع بعض الملفات المطلوبة لتصدير/بناء الترجمات. يتم إنشاء ملفات التجهيز عند إنشاء المشروع.\"></i>"],["Objects <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of objects/files available on the left pane\"></i>","الكائنات <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"عدد الكائنات/الملفات المتاحة في اللوحة اليسرى\"></i>"],["Folders","المجلدات"],["Characters <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Number of characters in the Original Text column\"></i>","الأحرف <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"عدد الأحرف في عمود النص الأصلي\"></i>"],["Words <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"May display wrong value in languages that doesn't use spaces (ie. Japanese, Chinese).\"></i>","الكلمات <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"قد يعرض قيمة خاطئة في اللغات التي لا تستخدم المسافات (مثل اليابانية، الصينية).\"></i>"],["Total Rows","إجمالي الصفوف"],["Translated row","الصف المترجم"],["Organic translation <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Users filled directly into the grid. Which is a good sign. Can be human translation, can be edited MTL, etc.\"></i>","ترجمة عضوية <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"تم ملؤها مباشرة في الشبكة من قبل المستخدمين. وهي علامة جيدة. يمكن أن تكون ترجمة بشرية، أو MTL معدلة، إلخ.\"></i>"],["&nbsp;","&nbsp;"],["Overall progress <span class=\"percentDisplay\" data-field=\"percent\"></span>%","التقدم العام <span class=\"percentDisplay\" data-field=\"percent\"></span>%"],["On after export<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Run a javascript function after this project is successfully exported.\"></i>","بعد التصدير<i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"تشغيل دالة جافا سكريبت بعد تصدير هذا المشروع بنجاح.\"></i>"],["Display this information when the project is opened.","عرض هذه المعلومات عند فتح المشروع."],["Select Export Mode","اختر وضع التصدير"],["Export to a folder","تصدير إلى مجلد"],["Export pre-compiled game data to a folder<br>Folder structures are retained","تصدير بيانات اللعبة المترجمة مسبقًا إلى مجلد<br>يتم الاحتفاظ بهياكل المجلدات"],["Export as a Zip file","تصدير كملف مضغوط"],["Export pre-compiled game data to a single zipped archive","تصدير بيانات اللعبة المترجمة مسبقًا إلى أرشيف مضغوط واحد"],["RPGMakerTrans Patch Files","ملفات تصحيح RPGMakerTrans"],["Export to RPGMakerTrans formatted *.txt files in a folder","تصدير إلى ملفات *.txt بتنسيق RPGMakerTrans في مجلد"],["Comma Separated Values","قيم مفصولة بفواصل"],["Export to Comma Separated Values (csv) files in a folder","تصدير إلى ملفات قيم مفصولة بفواصل (csv) في مجلد"],["Office Open XML (.xlsx) Excel 2007 and above","Office Open XML (.xlsx) إكسل 2007 وما فوق"],["Export to Microsoft Excel Spreadsheet (xlsx) files in a folder","تصدير إلى ملفات جدول بيانات مايكروسوفت إكسل (xlsx) في مجلد"],["BIFF 8 (.xls) Excel 97 and above","BIFF 8 (.xls) إكسل 97 وما فوق"],["Export to Microsoft Excel Spreadsheet (xls) files in a folder","تصدير إلى ملفات جدول بيانات مايكروسوفت إكسل (xls) في مجلد"],["HTML Spreadsheet","جدول بيانات HTML"],["Export to HTML files in a folder","تصدير إلى ملفات HTML في مجلد"],["Open Document Format/OASIS (.ods)","تنسيق المستند المفتوح/OASIS (.ods)"],["Export to ODS files in a folder","تصدير إلى ملفات ODS في مجلد"],["Select Import Mode","اختر وضع الاستيراد"],["Import translation from another .trans file","استيراد الترجمة من ملف .trans آخر"],["Open another Translator++ file<br>Apply translation into current project.","افتح ملف Translator++ آخر<br>طبق الترجمة على المشروع الحالي."],["Import translation from spreadsheets","استيراد الترجمة من جداول البيانات"],["Import translation from various spreadsheets file<br>(.xls, .xlsx, .ods, .html, .xml, etc)","استيراد الترجمة من ملفات جداول بيانات متنوعة<br>(.xls، .xlsx، .ods، .html، .xml، إلخ)"],["Import translation from RPGMakerTrans Patch format","استيراد الترجمة من تنسيق رقعة RPGMakerTrans"],["Import translation from RPGMaker Trans' patch files<br>(.txt)","استيراد الترجمة من ملفات رقعة RPGMaker Trans<br>(.txt)"],["Source :","المصدر:"],["Select objects to import","اختر العناصر للاستيراد"],["Import mode :","وضع الاستيراد:"],["Import translations","استيراد الترجمات"],["Import data object","استيراد كائن البيانات"],["Destination :","الوجهة :"],["Currently selected : ","المحدد حاليًا : "],["Options :","الخيارات :"],["Import the context translations","استيراد ترجمات السياق"],["Case insensitive","غير حساس لحالة الأحرف"],["Overwrite target","كتابة فوق الهدف"],["Destination column : ","عمود الوجهة : "],["Translation mode :","وضع الترجمة :"],["Row by row translation","ترجمة صفًا بصف"],["Line by line translation","ترجمة سطرًا بسطر"],["Select translation by context address","اختيار الترجمة حسب عنوان السياق"],["Just copy translation into the same row (No checking)","مجرد نسخ الترجمة في نفس الصف (بدون فحص)"],["Merge data","دمج البيانات"],["Import translation from spreadsheet into project","استيراد الترجمة من جدول البيانات إلى المشروع"],["Import translation from any spreadsheet format (xls, xlsx, odx, html, csv, etc).","استيراد الترجمة من أي تنسيق جدول بيانات (xls, xlsx, odx, html, csv, إلخ)."],["<b>The spreadsheet must have at least 2 columns.</b> The most important column is the first column (the leftmost column) containing the original texts. The following columns contain the translations. Translator++ will use the text in the rightmost cell that is not empty.","<b>يجب أن يحتوي جدول البيانات على عمودين على الأقل.</b> العمود الأهم هو العمود الأول (أقصى اليسار) الذي يحتوي على النصوص الأصلية. الأعمدة التالية تحتوي على الترجمات. سيستخدم Translator++ النص في الخلية أقصى اليمين غير الفارغة."],["Please click the radio button to select files/folder to import","يرجى النقر على زر الراديو لاختيار الملفات/المجلدات للاستيراد"],["Import file(s)","استيراد ملف/ملفات"],["Import folder","استيراد مجلد"],["Import translation from RPG Maker Trans into project","استيراد الترجمة من RPG Maker Trans إلى المشروع"],["<i class=\"icon-tpp\"></i><span data-tran=\"\">Select project type</span>","<i class=\"icon-tpp\"></i><span data-tran=\"\">اختر نوع المشروع</span>"],["Select project type","اختر نوع المشروع"],["Spreadsheet","جدول بيانات"],["Start a translation project from spreadsheet data (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)","ابدأ مشروع ترجمة من بيانات جدول بيانات (xls, xlsx, ods, xml, html, sylk, gnumeric, csv)"],["Blank project","مشروع فارغ"],["Create a new .trans file from scratch.","أنشئ ملف .trans جديد من الصفر."],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Spreadsheet</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">جدول بيانات</span>"],["Fetch type","نوع الجلب"],["The first columns are translatable text, the rest of the column are predefined translations (Create a grid data that matches the original table)","الأعمدة الأولى هي نص قابل للترجمة، وبقية الأعمدة هي ترجمات محددة مسبقًا (أنشئ بيانات شبكية تتطابق مع الجدول الأصلي)"],["All columns are translatable text","جميع الأعمدة هي نص قابل للترجمة"],["Custom","مخصص"],["Custom Options","خيارات مخصصة"],["Which column do you want to fetch?","أي عمود تريد جلب؟"],["Please specify which column you want to fetch and which column you want to put the translation into. <b>It is 0 based index (the first column is 0)</b>.","يرجى تحديد أي عمود تريد جلب وأي عمود تريد وضع الترجمة فيه. <b>المؤشر يعتمد على الصفر (العمود الأول هو 0)</b>."],["Column to be translated","العمود المراد ترجمته"],["Column to put translation into","العمود لوضع الترجمة فيه"],["Action","إجراء"],["Enable Row Header Text Column","تفعيل عمود نص رأس الصف"],["If enabled, the parser will process the following Row Header Text Column rule","إذا تم التفعيل، سيعالج المحلل قاعدة عمود نص رأس الصف التالية"],["Row Header Text Column","نص عمود رأس الصف"],["If specified, the value in this column will be applied to the row header. This is useful for determining the current speaker or actor, etc. It is a zero-based index.","إذا تم تحديده، سيتم تطبيق القيمة في هذا العمود على رأس الصف. هذا مفيد لتحديد المتحدث أو الممثل الحالي، إلخ. إنه فهرس يبدأ من الصفر."],["Options","خيارات"],["Calculate cell value","حساب قيمة الخلية"],["Cell value in the form of formula will be transpiled","سيتم تحويل قيمة الخلية في شكل صيغة"],["Get formatted value","الحصول على القيمة المنسقة"],["Process cell values after formatting. (For example the integer 100000 in certain locale will become USD 100,000)","معالجة قيم الخلايا بعد التنسيق. (على سبيل المثال، سيتحول العدد الصحيح 100000 في إعدادات محلية معينة إلى 100,000 دولار أمريكي)"],["Parse CSV in EXCEL format","تحليل CSV بتنسيق EXCEL"],["Force the parser to parse CSV in MS EXCEL way. (only for CSV files)","إجبار المحلل على تحليل CSV بطريقة MS EXCEL. (فقط لملفات CSV)"],["Skip the first <i>n</i> row(s)","تخطي أول <i>n</i> صف(وف)"],["Use this option if you want to skip the row header.","استخدم هذا الخيار إذا كنت تريد تخطي رأس الصف."],["Select File(s)","تحديد ملف(ات)"],["Select a directory","تحديد مجلد"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Create a new Trans file</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">إنشاء ملف Trans جديد</span>"],["Create a new Trans file","إنشاء ملف Trans جديد"],["The title of this project","عنوان هذا المشروع"],["Engine type","نوع المحرك"],["Type of the engine","نوع المحرك"],["<i class=\"icon-plus-circled\"></i><span data-tran=\"\">Placeholder for something great at the near future!</span>","<i class=\"icon-plus-circled\"></i><span data-tran=\"\">مكان لحفظ شيء رائع في المستقبل القريب!</span>"],["Placeholder for something great at the near future!","مكان لحفظ شيء رائع في المستقبل القريب!"],["This module will be created when the patron count reach 500!","سيتم إنشاء هذه الوحدة عندما يصل عدد الرعاة إلى 500!"],["\n\t\tA project with the same title <br>\"<span class=\"dialogGameTitle\"></span>\"<br> is already exist on the post processed cache.<br>\n\t\tYou can re-use this cache to shorten loading time significantly.\n\t","\n\t\tمشروع بنفس العنوان <br>\"<span class=\"dialogGameTitle\"></span>\"<br> موجود بالفعل في ذاكرة التخزين المؤقت المعالجة.<br>\n\t\tيمكنك إعادة استخدام هذه الذاكرة لتقليل وقت التحميل بشكل كبير.\n\t"],["If you are confused, you can always safely click <strong><a href=\"#\">\"Create new project\"</a></strong> button. ","إذا كنت مرتبكًا، يمكنك دائمًا النقر بأمان على زر <strong><a href=\"#\">\"إنشاء مشروع جديد\"</a></strong>."],["Existed cache","ذاكرة التخزين المؤقت الموجودة"],["Select Translator","اختر المترجم"],["Source column","عمود المصدر"],["Which column is the source text to translate for?<br>(default is key column / leftmost column).","أي عمود يحتوي على النص المصدر للترجمة؟<br>(الافتراضي هو عمود المفاتيح / العمود الأقصى اليسار)."],["Target column","عمود الهدف"],["Which column is the translated text put into.<br>(Can not same with source column)","أي عمود سيتم وضع النص المترجم فيه.<br>(لا يمكن أن يكون نفس عمود المصدر)"],["Translator's Options","خيارات المترجم"],["Also try to translate other object","حاول أيضًا ترجمة كائنات أخرى"],["If this option is checked then Translator++ will also try to translate other objects that you did not select that doesn't require machine translation. This is the default behavior in Translator++ version 2.3.23 or lower.","إذا تم تحديد هذا الخيار، فسيحاول Translator++ أيضًا ترجمة كائنات أخرى لم تقم بتحديدها ولا تتطلب ترجمة آلية. هذا هو السلوك الافتراضي في إصدار Translator++ 2.3.23 أو أقل."],["Ignore if already translated","تجاهل إذا تمت الترجمة بالفعل"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","إذا تم تحديد هذا الخيار، فسيتجاهل Translator++ أي صف يحتوي بالفعل على ترجمات في عموده."],["Overwrite cells","الكتابة فوق الخلايا"],["Overwrite target cells. If not checked, the cells will not be touched when not empty.","الكتابة فوق خلايا الهدف. إذا لم يتم تحديده، فلن يتم لمس الخلايا عندما لا تكون فارغة."],["Save project on each batch.","حفظ المشروع في كل دفعة."],["Save your project on each batch completion.<br>This option is to avoid data loss when the application crashes due to running heavy tasks from the local translator application. You probably don't need this if you're running cloud based translator.","احفظ مشروعك عند اكتمال كل دفعة.<br>هذا الخيار لتجنب فقدان البيانات عند تعطل التطبيق بسبب تشغيل مهام ثقيلة من تطبيق المترجم المحلي. ربما لا تحتاج هذا إذا كنت تستخدم مترجمًا قائمًا على السحابة."],["Play sound when completed.","تشغيل صوت عند الانتهاء."],["Tags","العلامات"],["Select Context(s)","اختر السياق (سياقات)"],["Manual Query","استعلام يدوي"],["Match all words","مطابقة جميع الكلمات"],["Remove selected","إزالة المحدد"],["Remove all but selected","إزالة كل شيء باستثناء المحدد"],["Select Context","اختر السياق"],["Source Column","عمود المصدر"],["Target Column","عمود الهدف"],["Maximum length","الحد الأقصى للطول"],["Export into","تصدير إلى"],["What to do with tagged rows?","ماذا تفعل بالصفوف الموسومة؟"],["Select Color Tag","اختر علامة اللون"],["On the fly word wrap","التفاف الكلمات على الفور"],["Inject all files (ignoring selection)","حقن جميع الملفات (تجاهل التحديد)"],["You're about to inject translation via <b>Inject all</b> button. This will inject translation regardless your selected object on the left pane. Use left pane's context menu if you want to inject selected object.","أنت على وشك حقن الترجمة عبر زر <b>حقن الكل</b>. سيؤدي هذا إلى حقن الترجمة بغض النظر عن الكائن المحدد في اللوحة اليسرى. استخدم قائمة السياق في اللوحة اليسرى إذا كنت تريد حقن الكائن المحدد."],["Select the source material to be translated","اختر المادة المصدر ليتم ترجمتها"],["\n\t\t\t\tSelect the specific material or content you wish to translate, such as a file, directory, or other relevant input. Make sure the chosen material is accessible and appropriately formatted for the corresponding parser.<br>\n\t\t\t\tBy default, some parsers use the staging directory as the source material.\n\t\t\t","\n\t\t\t\tاختر المادة أو المحتوى المحدد الذي ترغب في ترجمته، مثل ملف أو دليل أو مدخل آخر ذي صلة. تأكد من أن المادة المختارة قابلة للوصول ومُنسقة بشكل مناسب للمحلل المقابل.<br>\n\t\t\t\tبشكل افتراضي، يستخدم بعض المحللين دليل المرحلة كمادة المصدر.\n\t\t\t"],["Path is inaccessible.","المسار غير قابل للوصول."],["Target Directory","دليل الهدف"],["\n\t\t\t\tA copy of your translated application will be generated in this folder.\n\t\t\t","\n\t\t\t\tسيتم إنشاء نسخة من تطبيقك المترجم في هذا المجلد.\n\t\t\t"],["Field can not be empty!","لا يمكن أن يكون الحقل فارغًا!"],["Target to apply translation","الهدف لتطبيق الترجمة"],["\n\t\t\t\tPlease select executable file.\n\t\t\t","\n\t\t\t\tيرجى تحديد ملف قابل للتنفيذ.\n\t\t\t"],["Copy materials","نسخ المواد"],["The copying options from Source Material to Target Directory. (experimental, not all engines are supported)","خيارات النسخ من المواد المصدر إلى الدليل الهدف. (تجريبي، لا يتم دعم جميع المحركات)"],["Word Wrap by Tags","التفاف النص بالوسوم"],["Directory name","اسم الدليل"],["\n\t\t\t\tThe object will be grouped under this directory.<br>\n\t\t\t\tEnter star \"<code>*</code>\" to add a new <b>reference object</b>.\n\t\t\t","\n\t\t\t\tسيتم تجميع الكائن تحت هذا الدليل.<br>\n\t\t\t\tأدخل نجمة \"<code>*</code>\" لإضافة <b>كائن مرجعي</b> جديد.\n\t\t\t"],["Invalid directory  name","اسم الدليل غير صالح"],["Object name","اسم الكائن"],["\n\t\t\t\tThe name of the object.\n\t\t\t","\n\t\t\t\tاسم الكائن.\n\t\t\t"],["Invalid object name","اسم الكائن غير صالح"],["New Project","مشروع جديد"],["Save","حفظ"],["Save as...","حفظ باسم..."],["Open...","فتح..."],["Recent","الأخيرة"],["None...","لا شيء..."],["Export Project","تصدير المشروع"],["To a folder","إلى مجلد"],["As a zip file","كملف مضغوط"],["To portable .tpp file","إلى ملف محمول .tpp"],["To RPGMakerTrans file (*.txt)","إلى ملف RPGMakerTrans (*.txt)"],["To CSV file","إلى ملف CSV"],["To XLSX file","إلى ملف XLSX"],["To XLS file","إلى ملف XLS"],["To ODS file","إلى ملف ODS"],["To HTML file","إلى ملف HTML"],["Import","استيراد"],["Project from .tpp file","مشروع من ملف .tpp"],["Translation from .trans file","ترجمة من ملف .trans"],["Translation Spreadsheet","جدول بيانات الترجمة"],["Translation RPGMKTRANSPATCH Format","تنسيق ترجمة RPGMKTRANSPATCH"],["Automation","أتمتة"],["Batch translation","ترجمة دفعة"],["Context tool","أداة السياق"],["Batch word wrapping","لف النصوص دفعة"],["Trim","قص"],["Auto padding","حشو تلقائي"],["Tools","أدوات"],["Third Party Application Installer","مثبت التطبيقات الخارجية"],["Close project","إغلاق المشروع"],["Exit","خروج"],["Start here","ابدأ هنا"],["Start a New Project","ابدأ مشروعًا جديدًا"],["Continue your work","استمر في عملك"],["Open Project","فتح مشروع"],["Your recent translation","ترجمتك الأخيرة"],["Tips for you","نصائح لك"],["Next tip! <span class=\"icon-angle-double-right\"></span>","النصيحة التالية! <span class=\"icon-angle-double-right\"></span>"],["The rightmost cell in a row will get the priority.","الخلية أقصى اليمين في الصف ستأخذ الأولوية."],["You can't share your project with others with just a trans file. You need to generate a TPP file.","لا يمكنك مشاركة مشروعك مع الآخرين بمجرد ملف ترانس. تحتاج إلى إنشاء ملف TPP."],["Always make backups of your trans files.","احتفظ دائمًا بنسخ احتياطية من ملفات ترانس الخاصة بك."],["You can rename and reorder the column with the coulumn header's context menu.","يمكنك إعادة تسمية وإعادة ترتيب العمود باستخدام قائمة السياق لرأس العمود."],["Always backup your game before working with Translator++!","احتفظ دائمًا بنسخة احتياطية من لعبتك قبل العمل مع Translator++!"],["If you encountered a feature that is not running normally, try restarting Translator++, it will fix the problem in the most cases.","إذا واجهت ميزة لا تعمل بشكل طبيعي، حاول إعادة تشغيل Translator++، فهذا سيصلح المشكلة في معظم الحالات."],["Always create a backup of your game before patching with a translation.","احتفظ دائمًا بنسخة احتياطية من لعبتك قبل الترقيع بترجمة."],["Thank you for supporting Translator++.","شكرًا لدعمك لـ Translator++."],["Please check Translator++'s online documentation at","يرجى التحقق من الوثائق عبر الإنترنت لـ Translator++ في"],["working","يعمل"],["Open","فتح"],["Save file","حفظ الملف"],["Save As","حفظ باسم"],["Import Project","استيراد المشروع"],["Inject / apply all translation","حقن / تطبيق جميع الترجمات"],["Execute Global Level Custom Script","تنفيذ سكريبت مخصص على المستوى العام"],["Toggle Active Cell Info","تبديل معلومات الخلية النشطة"],["Project Properties","خصائص المشروع"],["Get Help (F1)","الحصول على المساعدة (F1)"],["Batch translation (crl+b)","ترجمة دفعة (ctrl+b)"],["File list","قائمة الملفات"],["Live Translation Pane","لوحة الترجمة المباشرة"],["Toggle selection","تبديل التحديد"],["Invert selection","عكس التحديد"],["Add A New Object","إضافة كائن جديد"],["Connect to auto translator","الاتصال بالمترجم الآلي"],["Undock pane","فصل اللوحة"],["Collapse / restore left panel","طي / استعادة اللوحة اليسرى"],["Add new key (alt+n)","إضافة مفتاح جديد (alt+n)"],["Import Here","استيراد هنا"],["Add a note to this file","إضافة ملاحظة إلى هذا الملف"],["Open search menu","فتح قائمة البحث"],["Toggle grid information","تبديل معلومات الشبكة"],["Object Properties","خصائص الكائن"],["Automatically set selected original text to clipboard","تعيين النص الأصلي المحدد تلقائيًا إلى الحافظة"],["Resize Font","تغيير حجم الخط"],["Toggle word wrapping & Explicit white spaces","تبديل التفاف النص والمسافات البيضاء الصريحة"],["Use Monospace font","استخدام خط أحادي المسافة"],["Remove all translation from this file","إزالة كل الترجمات من هذا الملف"],["Remove this file from project","إزالة هذا الملف من المشروع"],["file path","مسار الملف"],["Quick find","بحث سريع"],["Active cell's info","معلومات الخلية النشطة"],["View original untranslated text","عرض النص الأصلي غير المترجم"],["View raw data","عرض البيانات الأولية"],["View row properties","عرض خصائص الصف"],["Go to current cell","الانتقال إلى الخلية الحالية"],["Current coordinate","الإحداثيات الحالية"],["Word wraping (for non Japanese text)","تفاف النص (للنصوص غير اليابانية)"],["Speak original text (alt+,)","قراءة النص الأصلي (alt+,)"],["Copy original text into current cell (ctrl+0)","نسخ النص الأصلي إلى الخلية الحالية (ctrl+0)"],["Default translation for all occurrence","الترجمة الافتراضية لجميع التكرارات"],["Translations by context","الترجمات حسب السياق"],["This cell has a comment","هذه الخلية تحتوي على تعليق"],["This cell has an organic content","هذه الخلية تحتوي على محتوى عضوي"],["This cell has been visited","تمت زيارة هذه الخلية"],["This is the first time this cell has been visited","هذه هي المرة الأولى التي تتم فيها زيارة هذه الخلية"],["Word wraping","التفاف النص"],["Speak current translation text (alt+.)","تحدث نص الترجمة الحالي (alt+.)"],["Current Cell Editor options","خيارات محرر الخلية الحالية"],["Clear context translation for current row","مسح ترجمة السياق للصف الحالي"],["Get help about translation by context","الحصول على مساعدة حول الترجمة حسب السياق"],["Open menu","فتح القائمة"],["Path not accessible","المسار غير قابل للوصول"],["The location of the original material. You should not modify anything inside this folder.","موقع المادة الأصلية. لا يجب تعديل أي شيء داخل هذا المجلد."],["The location of the game that has been translated. The default location of the translation injection.","موقع اللعبة التي تمت ترجمتها. الموقع الافتراضي لحقن الترجمة."],["Prefered translator for this project. If not defined, global setting will be used.","المترجم المفضل لهذا المشروع. إذا لم يتم تعريفه، سيتم استخدام الإعدادات العامة."],["-use default-","-استخدام الافتراضي-"],["Staging path is the location of some files required to export/build translations. Staging files generated when you created the project.","مسار المرحلة هو موقع بعض الملفات المطلوبة ل