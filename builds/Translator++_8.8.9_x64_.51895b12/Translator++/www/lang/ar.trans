earPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-05e7d66a.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-4418d312.js":{"data":[["customModels.customLabel","النماذج المخصصة.تسمية مخصصة"],["model","نموذج"],["|","|"],["promptLibrary","مكتبة المطالبات"],["search","بحث"],["downloadChat","تحميل الدردشة"],["newChat","دردشة جديدة"],["api","واجهة برمجة التطبيقات"],["customEndpoint","نقطة نهاية مخصصة"],["apiEndpoint.inputLabel","تسمية إدخال نقطة نهاية واجهة برمجة التطبيقات"],["apiKey.inputLabel","تسمية إدخال مفتاح واجهة برمجة التطبيقات"],["apiVersion.inputLabel","تسمية إدخال إصدار واجهة برمجة التطبيقات"],["apiVersion.description","وصف إصدار واجهة برمجة التطبيقات"],["securityMessage","رسالة أمان"],["apiEndpoint.description","وصف نقطة نهاية واجهة برمجة التطبيقات"],["apiEndpoint.warn","تحذير نقطة نهاية واجهة برمجة التطبيقات"],["partialImportMessages","رسائل الاستيراد الجزئي"],["import","استيراد"],["name","اسم"],["prompt","موجه"],["clearPrompts","مسح المطالبات"],["morePrompts","المزيد من المطالبات"],["toast.sync","تحديث التنبيه"],["toast.stop","إيقاف التنبيه"],["button.sync","زر.مزامنة"],["button.stop","زر.توقف"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/Str