tringLiteral"],["tid/629359/type/StringLiteral"],["tid/629410/type/StringLiteral","tid/629417/type/StringLiteral"],["tid/629443/type/StringLiteral","tid/629450/type/StringLiteral"]],"basename":"index-a94634e1.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-a94634e1.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":3,"promptLibrary":4,"search":5,"downloadChat":6,"newChat":7,"api":8,"customEndpoint":9,"apiEndpoint.inputLabel":10,"apiKey.inputLabel":11,"apiVersion.inputLabel":12,"apiVersion.description":13,"securityMessage":14,"apiEndpoint.description":15,"apiEndpoint.warn":16,"partialImportMessages":17,"import":18,"name":19,"prompt":20,"clearPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-a94634e1.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js":{"data":[["customModels.customLabel","تسمية مخصصة للنماذج المخصصة"],["model","نموذج"],["|","|"],["promptLibrary","مكتبة التوجيهات"],["search","بحث"],["downloadChat","تحميل الدردشة"],["newChat","دردشة جديدة"],["api","واجهة برمجة التطبيقات"],["customEndpoint","نقطة نهاية مخصصة"],["apiEndpoint.inputLabel","تسمية إدخال نقطة نهاية واجهة برمجة التطبيقات"],["apiKey.inputLabel","تسمية إدخال مفتاح واجهة برمجة التطبيقات"],["apiVersion.inputLabel","تسمية إدخال إصدار واجهة برمجة التطبيقات"],["apiVersion.description","وصف إصدار API"],["securityMessage","رسالة الأمان"],["apiEndpoint.description","وصف نقطة نهاية API"],["apiEndpoint.warn","تحذير نقطة نهاية API"],["partialImportMessages","رسائل الاستيراد الجزئي"],["import","استيراد"],["name","اسم"],["prompt","مطالبة"],["clearPrompts","مسح المطالبات"],["morePrompts","المزيد من المطالبات"],["toast.sync","تحديث التنبيه"],["toast.stop","إيقاف التنبيه"],["button.sync","زر المزامنة"],["button.stop","زر الإيقاف"]],"context":[["tid/100988/type/StringLiteral"],["tid/100993/type/StringLiteral"],["tid/461961/type/StringLiteral"],["tid/553437/type/StringLiteral","tid/622216/type/StringLiteral"],["tid/553469/type/StringLiteral"],["tid/557612/type/StringLiteral","tid/557632/type/StringLiteral","tid/557654/type/StringLiteral"],["tid/560505/type/StringLiteral","tid/560543/type/StringLiteral","tid/560586/type/StringLiteral"],["tid/606465/type/StringLiteral","tid/606538/type/StringLiteral","tid/606579/type/StringLiteral","tid/606677/type/StringLiteral","tid/606756/type/StringLiteral","tid/606782/type/StringLiteral","tid/606903/type/StringLiteral","tid/606925/type/StringLiteral","tid/606947/type/StringLiteral"],["tid/606533/type/StringLiteral"],["tid/606574/type/StringLiteral"],["tid/606672/type/StringLiteral"],["tid/606751/type/StringLiteral"],["tid/606777/type/StringLiteral"],["tid/606898/type/StringLiteral"],["tid/606920/type/StringLiteral"],["tid/606942/type/StringLiteral"],["tid/608789/type/StringLiteral"],["tid/608794/type/StringLiteral"],["tid/622327/type/StringLiteral","tid/630226/type/StringLiteral"],["tid/622347/type/StringLiteral"],["tid/622664/type/StringLiteral"],["tid/622687/type/StringLiteral"],["tid/629607/type/StringLiteral"],["tid/629731/type/StringLiteral"],["tid/629782/type/StringLiteral","tid/629789/type/StringLiteral"],["tid/629815/type/StringLiteral","tid/629822/type/StringLiteral"]],"basename":"index-b6a300c4.js","dirname":"/addons/transChatGPT/BetterChatGPT/dist/assets","extension":".js","filename":"index-b6a300c4.js","path":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","indexIsBuilt":false,"indexIds":{"customModels.customLabel":0,"model":1,"":2,"|":3,"promptLibrary":4,"search":5,"downloadChat":6,"newChat":7,"api":8,"customEndpoint":9,"apiEndpoint.inputLabel":10,"apiKey.inputLabel":11,"apiVersion.inputLabel":12,"apiVersion.description":13,"securityMessage":14,"apiEndpoint.description":15,"apiEndpoint.warn":16,"partialImportMessages":17,"import":18,"name":19,"prompt":20,"clearPrompts":21,"morePrompts":22,"toast.sync":23,"toast.stop":24,"button.sync":25,"button.stop":26},"tags":[],"relPath":"/addons/transChatGPT/BetterChatGPT/dist/assets/index-b6a300c4.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":26,"length":26,"percent":100},"parameters":[]},"/addons/transChatGPT/batchAPI.js":{"data":[["Translate with ChatGPT Batch API","ترجمة باستخدام واجهة برمجة تطبيقات ChatGPT الدفعية"],["Model","النموذج"],["The pre-trained model.","النموذج المدرب مسبقًا."],["It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n","يبدو أن واجهة برمجة تطبيقات OpenAI الدفعية تستخدم اصطلاح تسمية نماذج مختلف قليلاً عن واجهة برمجة التطبيقات العامة. النماذج المستخدمة في واجهة برمجة التطبيقات الدفعية لها بادئة \"-batch\". على سبيل المثال، إذا كنت تستخدم <code>gpt-4.1-mini</code>، يصبح النموذج تلقائيًا <code>gpt-4.1-mini-batch</code>.<br />\nومع ذلك، اعتبارًا من وقت إنشاء هذا الإضافة، لا تظهر النماذج الدفعية في حدود استخدام النماذج في OpenAI، مما يجعل من المستحيل على المستخدمين استخدام واجهة برمجة التطبيقات الدفعية إذا قاموا بتعيين عامل تصفية استخدام النموذج إلى \"السماح\" (القائمة البيضاء).<br />\nمن المحتمل أن يكون هذا خطأ في واجهة مستخدم OpenAI قد يتم إصلاحه في المستقبل.<br />\nلذلك، تأكد من تعيين حدود الاستخدام في OpenAI إلى وضع \"الحظر\" (القائمة السوداء) لاستخدام واجهة برمجة التطبيقات الدفعية.<br />\nانقر هنا لتغيير حدود استخدام النموذج: https://platform.openai.com/settings/proj_xxx/limits"],["Source Column","عمود المصدر"],["The column of the original texts you want to translate.","عمود النصوص الأصلية التي تريد ترجمتها."],["Add actor name","إضافة اسم الممثل"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","إلحاق اسم الممثل من معلومات الصف بالنص القابل للترجمة. سيساعد هذا المترجمين على تتبع الحوار والضمائر. سيقوم Translator++ بعد ذلك بإزالة اسم الممثل من نتيجة الترجمة. هذا سيزيد من تكلفة الترجمة بشكل واضح."],["Ignore if already translated","تجاهل إذا كانت مترجمة بالفعل"],["If this option is checked then Translator++ will ignore any row that already has translations on its column.","إذا تم تحديد هذا الخيار، فسيتجاهل Translator++ أي صف يحتوي بالفعل على ترجمات في عموده."],["Load Actor Reference as Glossary","تحميل مرجع الممثل كقاموس"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","إذا تم تحديده، سيقوم Translator++ بتحميل مرجع الممثل كقاموس. سيساعد هذا المترجم على فهم سياق المحادثة. المرجع هو اسم الممثل في الحوار. سيتم تحميله كقاموس للمترجم. هذا سيزيد من تكلفة الترجمة."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","سيتم تحميل الشخصيات الموجودة فقط في المحادثة كقاموس لكل عنصر دفعة. استخدم أمر القالب لتحميل مرجع الممثل في رسالة المطالبة."],["Actor Reference Translation Column","عمود ترجمة مرجع الممثل"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","عمود ترجمة اسم الممثل. سيتم استخدام هذا العمود كترجمة لمرجع الممثل. سيحسن هذا من اتساق ترجمة اسم الممثل في المحادثة."],["Actor's Information Column","عمود معلومات الممثل"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","العمود الذي يحتوي على معلومات إضافية للممثل. يمكنك وضع معلومات إضافية مثل الجنس، العمر، إلخ. سيحسن هذا من ترجمة الضمائر في المحادثة."],["System Message Template","قالب رسالة النظام"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","رسالة النظام هي رأس الرسالة التي ستخبر ما هو دور مساعد chatGPT الخاص بك. ستُرسل هذه الرسالة كأول رسالة في كل دفعة ترسلها إلى chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","يمكنك تضمين المتغيرات التالية بأسلوب Template Literal في JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","المتغيرات:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : لغة المصدر</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : لغة الهدف</li>"],["<li>LANG_FROM_FULL : Full source language name</li>","<li>LANG_FROM_FULL : اسم لغة المصدر الكامل</li>"],["<li>LANG_TO_FULL : Full target language name</li>","<li>LANG_TO_FULL : اسم لغة الهدف الكامل</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : النص المصدر</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : رسالة محددة مسبقًا لخوارزمية الهروب.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : سلسلة تمثل سطرًا جديدًا (بديل السطر).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : عدد الرسائل في الدفعة.</li>"],["<li>ACTOR_INFO : Add information of the actors.</li>","<li>ACTOR_INFO : إضافة معلومات الممثلين.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : عنوان اللعبة</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : محرك اللعبة</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : إنشاء مرجع من كائن Translator++. <br />مثال: <code>REFERENCE[المرجع المشترك]</code></li>"],["<li>CONTEXT : Include some previous lines as a context</li>","<li>CONTEXT : تضمين بعض الأسطر السابقة كسياق</li>"],["Body Message Template","قالب رسالة الجسم"],["Template of the body of your chat.","قالب جسم محادثتك."],["Sample conversation","محادثة نموذجية"],["The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.","تتيح لك واجهة برمجة تطبيقات ChatGPT Batch ترجمة مشروعك بشكل غير متزامن بتكلفة أقل بنسبة 50٪، مما يعني أنك ستتلقى نتائج الترجمة <b style=\"color:red\">خلال 24 ساعة</b> و <b style=\"color:red\">بنصف التكلفة العادية</b>. هذا مفيد بشكل خاص للمشاريع الكبيرة التي لا تتطلب نتائج ترجمة فورية."],[" <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch ."," <br />اقرأ المزيد عن واجهة برمجة تطبيقات ChatGPT Batch: https://platform.openai.com/docs/guides/batch ."],["General Settings","الإعدادات العامة"],["This form is using your existing ChatGPT configuration.<br>","هذا النموذج يستخدم إعدادات ChatGPT الحالية الخاصة بك.<br>"],["You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>","يمكنك تغيير الإعدادات عن طريق الانتقال إلى إعدادات مترجم ChatGPT في نافذة الخيارات.<br>"],["There you can set the API key, model, and other settings.<br />","هناك يمكنك تعيين مفتاح API والنموذج والإعدادات الأخرى.<br />"],["<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />","<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"فتح إعدادات ChatGPT\" />"],["Append actor name to the translatable text","إضافة اسم الممثل إلى النص القابل للترجمة"],["Ignore translated rows","تجاهل الصفوف المترجمة"],["Glossary",null],["<h2>Glossary</h2>",null],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>",null],["The Column of Actor's Additional Information",null],["Prompt Template",null],["<h2>1. System Message</h2>",null],["<p>Here you can explain to the assistant, what is their role.</p>",null],["<h2>2. Sample dialogue</h2>",null],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>",null],["<h2>3. Your actual prompt</h2>",null],["<p>This is the actual prompt to the assistant.</p>",null],["<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.",null],["Are you sure you want to reset the form?",null],["Are you sure you want to process the batch?\nCost will be incurred for this operation.",null],["The batch is successfully created. Do you want to open the batch manager?",null],["OpenAI Batch API Queue",null]],"context":[["tid/206/type/StringLiteral"],["tid/283/type/StringLiteral"],["tid/293/type/NoSubstitutionTemplate"],["tid/302/type/NoSubstitutionTemplate"],["tid/339/type/StringLiteral"],["tid/349/type/StringLiteral"],["tid/376/type/StringLiteral"],["tid/386/type/StringLiteral"],["tid/421/type/StringLiteral"],["tid/431/type/StringLiteral"],["tid/494/type/StringLiteral","tid/1400/type/StringLiteral"],["tid/504/type/StringLiteral"],["tid/511/type/StringLiteral"],["tid/545/type/StringLiteral","tid/1431/type/StringLiteral"],["tid/555/type/StringLiteral"],["tid/582/type/StringLiteral"],["tid/592/type/StringLiteral"],["tid/698/type/StringLiteral"],["tid/708/type/StringLiteral"],["tid/716/type/StringLiteral"],["tid/724/type/StringLiteral"],["tid/737/type/StringLiteral"],["tid/745/type/StringLiteral"],["tid/753/type/StringLiteral"],["tid/761/type/StringLiteral"],["tid/769/type/StringLiteral"],["tid/777/type/StringLiteral"],["tid/785/type/StringLiteral"],["tid/793/type/StringLiteral"],["tid/801/type/StringLiteral"],["tid/809/type/StringLiteral"],["tid/817/type/StringLiteral"],["tid/825/type/StringLiteral"],["tid/833/type/StringLiteral"],["tid/872/type/StringLiteral"],["tid/882/type/StringLiteral"],["tid/928/type/StringLiteral"],["tid/1023/type/NoSubstitutionTemplate"],["tid/1035/type/NoSubstitutionTemplate"],["tid/1059/type/StringLiteral"],["tid/1085/type/NoSubstitutionTemplate"],["tid/1093/type/NoSubstitutionTemplate"],["tid/1100/type/NoSubstitutionTemplate"],["tid/1107/type/NoSubstitutionTemplate"],["tid/1268/type/StringLiteral"],["tid/1292/type/StringLiteral"],["tid/1344/type/StringLiteral"],["tid/1370/type/StringLiteral"],["tid/1377/type/StringLiteral"],["tid/1462/type/StringLiteral"],["tid/1530/type/StringLiteral"],["tid/1556/type/StringLiteral"],["tid/1563/type/StringLiteral"],["tid/1608/type/StringLiteral"],["tid/1615/type/StringLiteral"],["tid/1741/type/StringLiteral"],["tid/1748/type/StringLiteral"],["tid/1802/type/NoSubstitutionTemplate"],["tid/2019/type/StringLiteral"],["tid/5713/type/StringLiteral"],["tid/6174/type/StringLiteral"],["tid/6421/type/StringLiteral"]],"basename":"batchAPI.js","dirname":"/addons/transChatGPT","extension":".js","filename":"batchAPI.js","path":"/addons/transChatGPT/batchAPI.js","indexIsBuilt":false,"indexIds":{"Translate with ChatGPT Batch API":0,"Model":1,"The pre-trained model.":2,"It seems that the OpenAI Batch API uses a slightly different model naming convention than the generally used API. Models used in the Batch API have a “-batch” prefix. For example, if you use <code>gpt-4.1-mini</code>, the model automatically becomes <code>gpt-4.1-mini-batch</code>.<br />\nHowever, as of the time this add-on was created, batch models are not listed in OpenAI's model usage limits, which makes it impossible for users to use the Batch API if they've set the Model Usage filter to “Allow” (whitelist).<br />\nThis is likely a bug in the OpenAI UI that may be fixed in the future.<br />\nSo, make sure to set the usage limits in OpenAI to “Block” (blacklist) mode in order to use the Batch API.<br />\nClick here to change the model's usage limits: https://platform.openai.com/settings/proj_xxx/limits\n":3,"Source Column":4,"The column of the original texts you want to translate.":5,"Add actor name":6,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":7,"Ignore if already translated":8,"If this option is checked then Translator++ will ignore any row that already has translations on its column.":9,"Load Actor Reference as Glossary":10,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":11,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":12,"Actor Reference Translation Column":13,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":14,"Actor's Information Column":15,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>LANG_FROM_FULL : Full source language name</li>":23,"<li>LANG_TO_FULL : Full target language name</li>":24,"<li>SOURCE_TEXT : Source text</li>":25,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":26,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":27,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":28,"<li>ACTOR_INFO : Add information of the actors.</li>":29,"<li>TITLE : Title of the game</li>":30,"<li>ENGINE : Engine of the game</li>":31,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":32,"<li>CONTEXT : Include some previous lines as a context</li>":33,"Body Message Template":34,"Template of the body of your chat.":35,"Sample conversation":36,"The ChatGPT Batch API allows you to translate your project asynchronously at 50% lower costs, meaning you will receive the results of your translation <b style=\"color:red\">within 24 hours</b> at <b style=\"color:red\">half the normal cost</b>. This is particularly useful for large projects that do not require immediate translation results.":37," <br />Read more about the ChatGPT Batch API: https://platform.openai.com/docs/guides/batch .":38,"General Settings":39,"This form is using your existing ChatGPT configuration.<br>":40,"You can change the configuration by going to the ChatGPT Translator settings in the options window.<br>":41,"There you can set the API key, model, and other settings.<br />":42,"<input type=\"button\" href=\"#\" onclick='ui.openOptionsWindow({focus: {menu: \"chatGPT\",find: \"Your OpenAI API Key\"}});' value=\"Open ChatGPT settings\" />":43,"Append actor name to the translatable text":44,"Ignore translated rows":45,"Glossary":46,"<h2>Glossary</h2>":47,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":48,"The Column of Actor's Additional Information":49,"Prompt Template":50,"<h2>1. System Message</h2>":51,"<p>Here you can explain to the assistant, what is their role.</p>":52,"<h2>2. Sample dialogue</h2>":53,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":54,"<h2>3. Your actual prompt</h2>":55,"<p>This is the actual prompt to the assistant.</p>":56,"<h3>Overhead cost</h3>\n                        Overhead cost is the cost of the prompt message that you send to the assistant without the actual translation texts. The cost is calculated based on the number of tokens in the prompt message. The more tokens you have, the higher the cost will be.<br>\n                        <b>Current overhead cost:</b> <span class=\"overheadCost\">0</span> tokens / request.":57,"Are you sure you want to reset the form?":58,"Are you sure you want to process the batch?\nCost will be incurred for this operation.":59,"The batch is successfully created. Do you want to open the batch manager?":60,"OpenAI Batch API Queue":61},"tags":[],"relPath":"/addons/transChatGPT/batchAPI.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":46,"length":62,"percent":74.19354838709677},"parameters":[]},"/addons/transChatGPT/chatGPT-legacy.js":{"data":[["<li>TITLE : Title of the game</li>",null],["<li>ENGINE : Engine of the game</li>",null],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>",null]],"context":[["tid/540/type/StringLiteral"],["tid/548/type/StringLiteral"],["tid/556/type/StringLiteral"]],"basename":"chatGPT-legacy.js","dirname":"/addons/transChatGPT","extension":".js","filename":"chatGPT-legacy.js","path":"/addons/transChatGPT/chatGPT-legacy.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2},"tags":[],"relPath":"/addons/transChatGPT/chatGPT-legacy.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":0,"length":3,"percent":0},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js":{"data":[["Please select the rows to apply the translation","يرجى تحديد الصفوف لتطبيق الترجمة"],["Target Column","العمود الهدف"],["The column to put the translation result.","العمود لوضع نتيجة الترجمة."],["Import translation from ChatGPT Batch","استيراد الترجمة من دفعة ChatGPT"],["Translation applied to selected rows","تم تطبيق الترجمة على الصفوف المحددة"],["Invalid format","تنسيق غير صالح"],["OK","موافق"],["Mismatch","عدم تطابق"],["Failed to load batch list with error: \n","فشل تحميل قائمة الدفعات مع الخطأ: \n"],["Download Error File","تنزيل ملف الخطأ"],["Batch is not completed yet","الدفعة لم تكتمل بعد"],["Are you sure you want to cancel this batch?","هل أنت متأكد أنك تريد إلغاء هذه الدفعة؟"],["Cannot cancel completed batch.","لا يمكن إلغاء الدفعة المكتملة."],["Batch cancelled","تم إلغاء الدفعة"],["Failed to cancel batch","فشل إلغاء الدفعة"]],"context":[["tid/1722/type/StringLiteral"],["tid/1767/type/StringLiteral","tid/11130/type/StringLiteral"],["tid/1777/type/StringLiteral","tid/11140/type/StringLiteral"],["tid/1851/type/StringLiteral","tid/11214/type/StringLiteral"],["tid/2191/type/StringLiteral"],["tid/2621/type/StringLiteral"],["tid/2653/type/StringLiteral","tid/2732/type/StringLiteral"],["tid/2700/type/StringLiteral"],["tid/6512/type/StringLiteral","tid/6773/type/StringLiteral"],["tid/8735/type/StringLiteral"],["tid/11078/type/StringLiteral"],["tid/12952/type/StringLiteral"],["tid/13030/type/StringLiteral"],["tid/13088/type/StringLiteral"],["tid/13105/type/StringLiteral"]],"basename":"chatgpt-batch-manager.js","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".js","filename":"chatgpt-batch-manager.js","path":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","indexIsBuilt":false,"indexIds":{"Please select the rows to apply the translation":0,"Target Column":1,"The column to put the translation result.":2,"Import translation from ChatGPT Batch":3,"Translation applied to selected rows":4,"Invalid format":5,"OK":6,"Mismatch":7,"Failed to load batch list with error: \n":8,"Download Error File":9,"Batch is not completed yet":10,"Are you sure you want to cancel this batch?":11,"Cannot cancel completed batch.":12,"Batch cancelled":13,"Failed to cancel batch":14},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/chatgpt-batch-manager.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":15,"length":15,"percent":100},"parameters":[]},"/addons/transChatGPT/chatgpt-batch-manager/index.html":{"data":[["Batches","الدفعات"],["Apply translation","تطبيق الترجمة"],["Cancel batch","إلغاء الدفعة"],["Status","الحالة"],["Batch ID","معرف الدفعة"],["Input File ID","معرف ملف الإدخال"],["End point","نقطة النهاية"],["Created at","تم الإنشاء في"],["Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>","تنتهي في <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"الدفعات التي لا تكتمل في الوقت المحدد تنتقل في النهاية إلى حالة منتهية الصلاحية؛ يتم إلغاء الطلبات غير المكتملة داخل تلك الدفعة، وتتوفر أي ردود على الطلبات المكتملة عبر ملف الإخراج للدفعة. سيتم محاسبتك على الرموز المستهلكة من أي طلبات مكتملة.\"></i>"],["Completed at","تم الإكمال في"],["Errors","الأخطاء"],["Batch Item Detail of","تفاصيل عنصر الدفعة لـ"],["ID","المعرف"],["Completed on","تم الإكمال في"],["Model","النموذج"],["Prompt Token","رمز المطالبة"],["Completion Token","رمز الإكمال"],["Total Token","إجمالي الرموز"],["Status Code","رمز الحالة"],["error","خطأ"],["Conversation","المحادثة"],["Response Validation","التحقق من الاستجابة"],["Raw Payload","الحمولة الخام"],["View raw payload","عرض الحمولة الخام"],["Response Preview","معاينة الاستجابة"],["Apply translations from selected rows","تطبيق الترجمات من الصفوف المحددة"],["Here you can edit the translation result individually and send it into Translator++","هنا يمكنك تعديل نتيجة الترجمة بشكل فردي وإرسالها إلى Translator++"],["Open ChatGPT Settings","فتح إعدادات ChatGPT"],["Help","مساعدة"],["File list","قائمة الملفات"],["Collapse / restore left panel","طي / استعادة اللوحة اليسرى"],["Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.","الدُفعات التي لا تكتمل في الوقت المحدد تنتقل في النهاية إلى حالة منتهية الصلاحية؛ يتم إلغاء الطلبات غير المكتملة داخل تلك الدفعة، وتتوفر أي استجابات للطلبات المكتملة عبر ملف الإخراج للدفعة. سيتم تحميلك رسومًا للرموز المستهلكة من أي طلبات مكتملة."]],"context":[["idx/0/innerText"],["idx/1/innerText","idx/4/attr/title"],["idx/2/innerText","idx/5/attr/title"],["idx/3/innerText","idx/9/innerText"],["idx/4/innerText"],["idx/5/innerText"],["idx/6/innerText"],["idx/7/innerText"],["idx/8/innerText"],["idx/10/innerText"],["idx/11/innerText"],["idx/12/innerText"],["idx/13/innerText"],["idx/14/innerText"],["idx/15/innerText"],["idx/16/innerText"],["idx/17/innerText"],["idx/18/innerText"],["idx/19/innerText"],["idx/20/innerText"],["idx/21/innerText"],["idx/22/innerText"],["idx/23/innerText"],["idx/24/innerText"],["idx/25/innerText"],["idx/26/innerText"],["idx/27/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"],["idx/3/attr/title"],["idx/6/attr/title"]],"basename":"index.html","dirname":"/addons/transChatGPT/chatgpt-batch-manager","extension":".html","filename":"index.html","path":"/addons/transChatGPT/chatgpt-batch-manager/index.html","indexIsBuilt":false,"indexIds":{"Batches":0,"Apply translation":1,"Cancel batch":2,"Status":3,"Batch ID":4,"Input File ID":5,"End point":6,"Created at":7,"Expires at <i class=\"icon-info-circled-1\" data-tranattr=\"title\" title=\"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.\"></i>":8,"Completed at":9,"Errors":10,"Batch Item Detail of":11,"ID":12,"Completed on":13,"Model":14,"Prompt Token":15,"Completion Token":16,"Total Token":17,"Status Code":18,"error":19,"Conversation":20,"Response Validation":21,"Raw Payload":22,"View raw payload":23,"Response Preview":24,"Apply translations from selected rows":25,"Here you can edit the translation result individually and send it into Translator++":26,"Open ChatGPT Settings":27,"Help":28,"File list":29,"Collapse / restore left panel":30,"Batches that do not complete in time eventually move to an expired state; unfinished requests within that batch are cancelled, and any responses to completed requests are made available via the batch's output file. You will be charged for tokens consumed from any completed requests.":31},"tags":[],"relPath":"/addons/transChatGPT/chatgpt-batch-manager/index.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":32,"length":32,"percent":100},"parameters":[]},"/addons/transChatGPT/options.js":{"data":[["OpenAI Chat",null],["Target URL","الرابط المستهدف"],["Target end point. You can use any service that supports OpenAI API.","نقطة النهاية المستهدفة. يمكنك استخدام أي خدمة تدعم واجهة برمجة تطبيقات OpenAI."],["Sample endpoints","نقاط النهاية النموذجية"],["Use this endpoint","استخدم نقطة النهاية هذه"],["Copy to clipboard","نسخ إلى الحافظة"],["e.g.","مثلاً"],["API Key","مفتاح API"],["Enter your API Key here.<br>The method to get the API key is different for each service.<br>","أدخل مفتاح API الخاص بك هنا.<br>تختلف طريقة الحصول على مفتاح API لكل خدمة.<br>"],["Leave it blank if the service doesn't require API key.","اتركه فارغًا إذا كانت الخدمة لا تتطلب مفتاح API."],["Model","النموذج"],["The pre-trained model","النموذج المدرب مسبقًا"],["For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).","لـ OpenAI، قد تحتاج إلى تعيين النموذج المسموح باستخدامه (https://platform.openai.com/settings/proj_xxx/limits)."],["Enable Context","تفعيل السياق"],["Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>","تفعيل السياق للترجمة. سيتم تضمين المواد المترجمة سابقًا فوق الدفعة الحالية كسياق. <b>تحتاج أيضًا إلى تضمين السياق صراحةً في القالب</b>"],["Context Character Limit","حد أحرف السياق"],["Character limit for the context.","حد الأحرف للسياق."],["System Message Template","قالب رسالة النظام"],["System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.","رسالة النظام هي رأس الرسالة التي ستخبر ما هو دور مساعد chatGPT الخاص بك. ستُرسل هذه الرسالة كأول رسالة في كل دفعة ترسلها إلى chatGPT."],["You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>","يمكنك تضمين المتغيرات التالية بأسلوب Template Literal في JavaScript <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>"],["Variables:<br>","المتغيرات:<br>"],["<li>LANG_FROM : Source language</li>","<li>LANG_FROM : اللغة المصدر</li>"],["<li>LANG_TO : Target language</li>","<li>LANG_TO : اللغة الهدف</li>"],["<li>SOURCE_TEXT : Source text</li>","<li>SOURCE_TEXT : النص المصدر</li>"],["<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>","<li>ESCAPE_ALGORITHM_PROMPT : رسالة محددة مسبقًا لخوارزمية الهروب.</li>"],["<li>NEWLINE_STRING : String represents new line (Line substitute).</li>","<li>NEWLINE_STRING : سلسلة تمثل سطر جديد (بديل السطر).</li>"],["<li>MESSAGE_COUNT : Number of messages in the batch.</li>","<li>MESSAGE_COUNT : عدد الرسائل في الدفعة.</li>"],["<li>TITLE : Title of the game</li>","<li>TITLE : عنوان اللعبة</li>"],["<li>ENGINE : Engine of the game</li>","<li>ENGINE : محرك اللعبة</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>ACTOR_INFO : مسرد معلومات الممثلين. (فقط إذا تم تمكين خيار معلومات الممثلين في وضع الدفعة)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>REFERENCE[object name] : إنشاء مرجع من كائن Translator++. <br />مثال: <code>REFERENCE[المرجع المشترك]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>CONTEXT : سياق الترجمة السابقة (إذا تم تمكين السياق)</li>"],["Sample conversation","محادثة نموذجية"],["User message","رسالة المستخدم"],["Assistant's response","رد المساعد"],["Body Message Template","قالب نص الرسالة الرئيسي"],["Template of the body of your chat.","قالب نص محادثتك الرئيسي."],["Enable JailBreak","تمكين JailBreak"],["Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.","تمكين Jailbreak للترجمة. سيجعل هذا الترجمة أكثر دقة وأقل تحيزًا. قد ترغب بعض النماذج في ربط الأحداث الخيالية بأحداث الحياة الواقعية، وبالتالي ستحاول تغيير الترجمة لتناسب سردها الخاص. سيمنع هذا الخيار ذلك."],["Jailbreak Template","قالب Jailbreak"],["Template of the Jailbreak message.","قالب رسالة Jailbreak."],["Maximum Tokens","الحد الأقصى للرموز"],["The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).","الحد الأقصى لعدد الرموز التي سيتم توليدها في الإكمال.<br>عدد رموز المطالبة بالإضافة إلى max_tokens لا يمكن أن يتجاوز طول سياق النموذج. معظم النماذج لها طول سياق يبلغ 2048 رمزًا (باستثناء أحدث النماذج التي تدعم 4096)."],["Temperature","درجة الحرارة"],["What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.","درجة حرارة أخذ العينات المستخدمة، بين 0 و 2. القيم الأعلى مثل 0.8 ستجعل الناتج أكثر عشوائية، بينما القيم الأقل مثل 0.2 ستجعله أكثر تركيزًا وحتمية.<br>توصي OpenAI عمومًا بتغيير هذا أو top_p وليس كليهما."],["Nucleus sampling (top_p)","أخذ العينات النووية (top_p)"],["An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.","بديل لأخذ العينات بدرجة الحرارة، يسمى أخذ العينات النووية، حيث يأخذ النموذج في الاعتبار نتائج الرموز ذات كتلة الاحتمال top_p. لذا 0.1 تعني أن الرموز التي تشكل أعلى 10% من كتلة الاحتمال فقط هي التي تؤخذ في الاعتبار.<br>توصي OpenAI عمومًا بتغيير هذا أو درجة الحرارة وليس كليهما."],["Frequency Penalty","عندة التكرار"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details","رقم بين -2.0 و 2.0. القيم الإيجابية تعاقب الرموز الجديدة بناءً على تكرارها الحالي في النص حتى الآن، مما يقلل من احتمالية تكرار النموذج لنفس السطر حرفيًا.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Presence Penalty","عندة الحضور"],["Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details","رقم بين -2.0 و 2.0. القيم الإيجابية تعاقب الرموز الجديدة بناءً على ما إذا كانت تظهر في النص حتى الآن، مما يزيد من احتمالية حديث النموذج عن مواضيع جديدة.<br>https://platform.openai.com/docs/api-reference/parameter-details"],["Use JSON Schema","استخدام مخطط JSON"],["Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.","استخدم <code>json_schema</code> لحقل <code>response_format.type</code> بدلاً من <code>json_object</code> القديم. <code>json_schema</code> مطلوب من قبل بعض أحدث النماذج وبعض الخوادم مثل <b>LM Studio</b>، لكن بعض النماذج القديمة لا تزال تستخدم <code>json_object</code>."],["Max Characters per Batch","الحد الأقصى للأحرف لكل دفعة"],["Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.","الحد الأقصى لعدد الأحرف لكل دفعة ترجمة.\nهذا الخيار سوف يحسب طول أحرف النص الأصلي فقط، وليس طول أحرف رسالة المطالبة."],["Max concurrent requests","الحد الأقصى للطلبات المتزامنة"],["How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.","كم عدد الطلبات المتزامنة المسموح بها للاتصال في وقت واحد؟ كل اتصال متزامن إضافي سيضاعف سرعة الترجمة، ولكنه سيستنفد أيضًا حد الرموز المحدد من قبل مزودك بسرعة.<br />اضبطه على <b>0</b> لتعطيل هذه الميزة.<br />اجمع هذا الخيار مع <b>الحد الأقصى للصفوف لكل طلب متزامن</b> لزيادة سرعة الترجمة أكثر.<br />ضبط هذا الخيار على أكثر من 1 سيؤثر على <b>السياق</b> لأنه ستكون هناك طلبات تتم معالجتها قبل انتهاء الطلب السابق. وبالتالي، سيرسل السياق بدون نتيجة ترجمة الطلب السابق."],["Max row per concurrent requests","الحد الأقصى للصفوف لكل طلب متزامن"],["How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />","كم عدد الصفوف المسموح بها لكل طلب متزامن. اضبطه على <b>0</b> لتعطيل هذه الميزة.<br />إذا تم تعطيل هذا الخيار، فبغض النظر عن عدد <b>الطلبات المتزامنة القصوى</b> التي قمت بتعيينها، سيعالج Translator++ الطلب كقطعة واحدة.<br />"],["The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.","كلما زاد عدد الصفوف التي تحددها، كلما حصلت على ترجمة أكثر في دفعة واحدة. وبالتالي تقلل من تكلفة النفقات العامة وتزيد من فرصة عودة النتائج الخاطئة من الذكاء الاصطناعي.<br />كلما قل الرقم، قل احتمال خطأ الترجمة ولكنه سيكلفك إضافات للمطالبات العامة."],["Preserve translations from invalid returned number of rows","الحفاظ على الترجمات من عدد الصفوف المرتجعة غير الصالحة"],["Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.","الحفاظ على الترجمات من الردود التي تحتوي على عدد صفوف غير صالح.<br />إذا تم تحديده، سيحاول Translator++ تصحيح عدد الصفوف وإدراج الترجمات في الشبكة.<br />إذا لم يتم تحديده، ستبقى الخلايا فارغة.<br />يوصى بترك هذا الخيار غير محدد لأغراض إعادة الترجمة."],["Batch delay","تأخير الدفعة"],["Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.","التأخير بين الدفعات (بالميلي ثانية).<br />استخدم هذا الإعداد للتحكم في طلباتك حتى لا تتجاوز حد RPM (طلبات في الدقيقة)."],["Batch Timeout","مهلة الدفعة"],["Timeout for each batch in milisecond","المهلة لكل دفعة بالميلي ثانية"],["Code Escaping Algorithm","خوارزمية تهريب الكود"],["Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.","خوارزمية تهريب للكود المضمن داخل الحوارات. قد تحتاج إلى تغيير <b>قالب رسالة النظام</b> و <b>قالب رسالة الجسم</b> وفقًا لخوارزمية التهريب التي تختارها.<br />عند اختيار <b>JSONCloaking</b> أو <b>JSONObjectCloaking</b>، سيتم إرسال <code>response_format: { type: 'json_object' }</code> تلقائيًا (ما لم تقم بتمكين <b>استخدام مخطط JSON</b>، والذي سيرسل مخطط JSON بدلاً من ذلك). <b>JSONCloaking</b> دقيق جدًا، لكنه لا يعمل مع جميع النماذج، جرب <b>gpt-3.5-turbo-1106</b>."],["Number of retry","عدد المحاولات"],["How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.","كم مرة يجب على المحرك إعادة المحاولة عندما يفشل التحقق من إخراج الترجمة. إذا كانت فارغة، فلا توجد محاولات إعادة."],["Retry when the number of translated rows doesn't match original","إعادة المحاولة عندما لا يتطابق عدد الصفوف المترجمة مع الأصل"],["If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.","إذا تم تمكينه، سيعيد المحرك المحاولة عندما يعيد النموذج عددًا مختلفًا من صفوف الترجمة مقارنة بالحمل الأصلي."],["Retry when the number of lines for each translated row doesn't match original","إعادة المحاولة عندما لا يتطابق عدد الأسطر لكل صف مترجم مع الأصل"],["If enabled, the engine will retry when any translated row has different number of lines than its original row.","إذا تم تمكينه، سيعيد المحرك المحاولة عندما يكون لأي صف مترجم عدد أسطر مختلف عن صفه الأصلي."],["Prompt: Row count mismatch","مطالبة: عدم تطابق عدد الصفوف"],["Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.","المطالبة المستخدمة عند إعادة المحاولة بسبب عدم تطابق عدد الصفوف/العناصر. المتغيرات القابلة للاستخدام في القالب تشمل: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Line count mismatch","مطالبة: عدم تطابق عدد الأسطر"],["Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.","المطالبة المستخدمة عند إعادة المحاولة بسبب عدم تطابق عدد الأسطر لكل صف. المتغيرات القابلة للاستخدام في القالب تشمل: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}."],["Prompt: Error / Retry instruction","مطالبة: خطأ / تعليمات إعادة المحاولة"],["Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.","المطالبة المضافة بعد مطالبات عدم التطابق لتوجيه النموذج لإعادة المحاولة. المتغيرات القابلة للاستخدام في القالب تشمل: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}."],["Custom Parameter","معلمة مخصصة"],["Key","مفتاح"],["Value","قيمة"],["Type","نوع"],["Type of the value.","نوع القيمة."],["For <b>javascript</b> type, the value will be evaluated as JavaScript code.","بالنسبة لنوع <b>جافا سكريبت</b>، سيتم تقييم القيمة ككود جافا سكريبت."],["The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.","نطاق كود الجافا سكريبت هو <code>window</code>. لذا يمكنك الوصول إلى أي قيمة تقريبًا."],["<br />Example: <code>trans.project.title</code>","<br />مثال: <code>trans.project.title</code>"],["Drop parameters that will not be sent to the API.<br />","إسقاط المعاملات التي لن تُرسل إلى واجهة برمجة التطبيقات.<br />"],["OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.","تتغير واجهة برمجة تطبيقات OpenAI باستمرار، وقد لا تدعم بعض النماذج الجديدة المعاملات القديمة وستُرجع خطأ HTTP للمعاملات غير المعترف بها في الطلب."],["You can drop the parameters that are not supported by the model here.","يمكنك إسقاط المعاملات غير المدعومة من قبل النموذج هنا."],["Manage configuration","إدارة الإعدادات"],["RPG Maker","صانع RPG"],["HTML Cloaking Wrapped","التغليف HTML"],["JSONObject Cloaking","التغليف JSONObject"],["This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.","هذه الإضافة تمكن الترجمة من خلال أي خدمة تدعم واجهة برمجة تطبيقات OpenAI Chat، مثل Deepseek وLlamaCPP وGoogle Gemini، وما إلى ذلك، وبالطبع OpenAI ChatGPT."],["OpenAI API settings","إعدادات واجهة برمجة تطبيقات OpenAI"],["General","عام"],["<h2>Don't waste your money on Reasoning Models</h2>","<h2>لا تضيع أموالك على نماذج التفكير</h2>"],["<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>","<p>أثبتت دراسات مختلفة أن نماذج التفكير أسوأ بكثير من النماذج العادية في أداء المهام الإبداعية والترجمة.</p>"],["<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>","<p>لا تكسب شيئًا سوى تكلفة أعلى وأوقات استجابة أبطأ عند استخدام نماذج التفكير.</p>"],["Explore more models","استكشف المزيد من النماذج"],["Templates","القوالب"],["Enable context","تفعيل السياق"],["<h2>Sample dialogue</h2>","<h2>حوار نموذجي</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>حوار موجود نموذجي. يمكنك كتابة نموذج لردود جيدة أو سيئة لمساعدة المترجم على فهم هدفك وسياق المحادثة.</p>"],["Add Example: Translate Japanese to English","إضافة مثال: ترجمة اليابانية إلى الإنجليزية"],["Retry prompts","إعادة المحاولة"],["<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>","<p>يتم إلحاق هذه المطالبات كرسائل <b>مستخدم</b> إضافية أثناء إعادة المحاولات، مباشرة بعد إخراج النموذج السابق.</p>"],["<p>Available variables:</p>","<p>المتغيرات المتاحة:</p>"],["Enable Jailbreak","تفعيل Jailbreak"],["Advanced","متقدم"],["Custom Parameters","معلمات مخصصة"],["You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.","يمكنك إضافة معلمات مخصصة إلى جسم طلب OpenAI Chat API. هذا مفيد إذا كنت ترغب في إضافة معلمات إضافية غير متوفرة في النموذج."],["<h2>Warning</h2>","<h2>تحذير</h2>"],["<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>","<li>قد يؤدي تعيين المعلمات المخصصة بشكل غير صحيح إلى فشل طلب API. تأكد من معرفتك بما تفعله قبل إضافة معلمات مخصصة. بعض الخدمات مثل OpenAI صارمة بشأن المعلمات التي ترسلها، وستُرجع خطأ HTTP للمعلمة غير المعترف بها.</li>"],["<li>If the same key is used multiple times, only the last value will be used.</li>","<li>إذا تم استخدام نفس المفتاح عدة مرات، سيتم استخدام القيمة الأخيرة فقط.</li>"],["<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>","<li>إذا تم استخدام نفس المفتاح في التكوين الحالي، فسيتم استبدال معلمة التكوين الحالية بالمعلمة المخصصة.</li>"],["Drop Parameters","إسقاط المعلمات"],["Open chatGPT tester","فتح اختبار chatGPT"],["Batch Translation Setting","إعداد الترجمة المجمعة"],["Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.","عذرًا، هذه الإضافة متاحة فقط للرعاة النشطين.\nيمكنك فتح هذه الميزة بأن تصبح راعيًا بـ $1."],["Preserve invalid returned rows","الحفاظ على الصفوف غير الصالحة المرتجعة"],["Retries and Refinement","إعادة المحاولات والتحسين"],["<h2>Retries and Refinement</h2>","<h2>إعادة المحاولات والتحسين</h2>"],["<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>","<p>عندما يفشل إخراج الترجمة في التحقق، يمكن لـ Translator++ أن يطلب من النموذج إعادة محاولة الترجمة. يمكنك تعيين عدد المرات التي يجب أن يعيد فيها النموذج المحاولة وكذلك تعيين شرط لإعادة المحاولة.</p>"],["<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>","<p>تعيين عدد معقول من إعادة المحاولات مع شروط إعادة محاولة مناسبة يمكن أن يحسن جودة الترجمة بشكل كبير مع الحفاظ على التكلفة والوقت تحت السيطرة.</p>"],["<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>","<p><b>كل إعادة محاولة تكلفك وقتًا ومالًا إضافيين</b>. إذا انتهى دفعتك بإعادة المحاولات بشكل متكرر، قد ترغب في تعديل توجيهاتك لجعل التعليمات أوضح للنموذج.</p>"],["<p>Use developer tool or Batch Manager to debug your batch translation.</p>","<p>استخدم أداة المطور أو مدير الدفعات لتصحيح ترجمة دفعتك.</p>"],["<h2>Code Escaping Algorithm</h2>","<h2>خوارزمية تهريب الكود</h2>"],["<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>","<p>تهريب الكود هو تقنية لمنع MTL من تغيير مقاطع الكود داخل الحوارات. هذا مفيد عندما تحتوي حواراتك على مقاطع كود مثل علامات HTML، علامات XML، كائنات JSON، أو قوالب JavaScript.</p>"],["<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>","<p>اختر خوارزمية التهريب التي تتطابق مع مقاطع الكود داخل حواراتك. قد تحتاج إلى تعديل قوالب <b>رسالة النظام</b>، <b>توجيه العينة</b> و <b>رسالة الجسم</b> وفقًا لذلك.</p>"],["<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>","<p>انقر <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>هنا</a> لقراءة المزيد عن خوارزميات تهريب الكود وكيفية استخدامها بفعالية.</p>"],["Default","افتراضي"],["JavaScript template cloaking","تعتيم قالب JavaScript"],["None (no escaping)","لا شيء (بدون تهريب)"],["Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.","هل تريد تحميل إعداد الحوار النموذجي لخوارزمية التهريب المحددة؟ هذا سوف يستبدل حوار العينة الحالي الخاص بك."],["Always separate file","دائمًا ملف منفصل"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","دائمًا افصل الملف لكل دفعة. هذا قد يحافظ على سياقات كل ملف غير ملوثة بملفات أخرى."],["Add actor name","إضافة اسم الممثل"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","أضف اسم الممثل من معلومات الصف إلى النص القابل للترجمة. هذا سيساعد المترجمين على تتبع الحوار والضمائر. ثم سيزيل Translator++ اسم الممثل من نتيجة الترجمة. هذا سيزيد تكلفة الترجمة بوضوح."],["Load Actor Reference as Glossary","تحميل مرجع الممثل كقاموس"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","إذا تم تحديده، سيقوم Translator++ بتحميل مرجع الممثل كقاموس. سيساعد هذا المترجم على فهم سياق المحادثة. مرجع الممثل هو اسم الممثل في الحوار. سيتم تحميله كقاموس للمترجم. سيؤدي ذلك إلى زيادة تكلفة الترجمة."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","سيتم تحميل الشخصيات الموجودة فقط في المحادثة كقاموس لكل عنصر دفعة. استخدم أمر القالب لتحميل مرجع الممثل في رسالة المطالبة."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️إذا قمت بتمكين هذا الخيار، تحتاج أيضًا إلى تضمين المتغير <code>ACTOR_INFO</code> في قالب المطالبة لوضع بيانات معلومات الشخصية."],["Actor Reference Translation Column","عمود ترجمة مرجع الممثل"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","عمود ترجمة اسم الممثل. سيتم استخدام هذا العمود كترجمة لمرجع الممثل. سيحسن ذلك اتساق ترجمة اسم الممثل في المحادثة."],["Actor's Information Column","عمود معلومات الممثل"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","العمود الذي يحتوي على معلومات إضافية للممثل. يمكنك وضع المزيد من المعلومات مثل الجنس، العمر، إلخ. سيحسن ذلك ترجمة الضمائر في المحادثة."],["Extra Prompt","مطالبة إضافية"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","مطالبة إضافية ستتم إضافتها إلى رسالة المطالبة. ستتم إضافتها بعد رسالة النظام وقبل رسالة المطالبة الفعلية."],["<br />","<br />"],["General Settings","الإعدادات العامة"],["Always separate file for each batch","دائمًا ملف منفصل لكل دفعة"],["Append actor name to the translatable text","إلحاق اسم الممثل بالنص القابل للترجمة"],["Glossary","قاموس"],["<h2>Glossary</h2>","<h2>قاموس</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>ستساعدك هذه الميزة في إضافة قاموس تلقائيًا إلى المطالبة. سيتم تحميل القاموس لكل دفعة من العناصر لتحسين جودة الترجمة. ستقوم الميزة بمحاولة تحميل المصطلحات ذات الصلة فقط لتجنب تضخيم مطالبك.</p>"],["The Column of Actor's Additional Information","عمود المعلومات الإضافية للممثل"],["Prompt","مطالبة"]],"context":[["tid/292/type/StringLiteral"],["tid/453/type/StringLiteral"],["tid/464/type/StringLiteral"],["tid/483/type/StringLiteral"],["tid/503/type/StringLiteral","tid/558/type/StringLiteral","tid/613/type/StringLiteral","tid/673/type/StringLiteral","tid/728/type/StringLiteral","tid/783/type/StringLiteral"],["tid/523/type/StringLiteral","tid/578/type/StringLiteral","tid/633/type/StringLiteral","tid/693/type/StringLiteral","tid/748/type/StringLiteral","tid/803/type/StringLiteral","tid/898/type/StringLiteral","tid/907/type/StringLiteral","tid/916/type/StringLiteral","tid/925/type/StringLiteral"],["tid/653/type/StringLiteral"],["tid/876/type/StringLiteral"],["tid/886/type/StringLiteral"],["tid/937/type/NoSubstitutionTemplate"],["tid/977/type/StringLiteral"],["tid/987/type/StringLiteral"],["tid/994/type/NoSubstitutionTemplate"],["tid/1169/type/StringLiteral"],["tid/1179/type/StringLiteral"],["tid/1212/type/StringLiteral"],["tid/1222/type/StringLiteral"],["tid/1256/type/StringLiteral"],["tid/1266/type/StringLiteral"],["tid/1274/type/StringLiteral","tid/8055/type/StringLiteral"],["tid/1282/type/StringLiteral","tid/8063/type/StringLiteral"],["tid/1295/type/StringLiteral","tid/8076/type/StringLiteral"],["tid/1303/type/StringLiteral","tid/8084/type/StringLiteral"],["tid/1311/type/StringLiteral","tid/8092/type/StringLiteral"],["tid/1319/type/StringLiteral","tid/8100/type/StringLiteral"],["tid/1327/type/StringLiteral","tid/8108/type/StringLiteral"],["tid/1335/type/StringLiteral","tid/8116/type/StringLiteral"],["tid/1343/type/StringLiteral","tid/8124/type/StringLiteral"],["tid/1351/type/StringLiteral","tid/8132/type/StringLiteral"],["tid/1359/type/StringLiteral","tid/8140/type/StringLiteral"],["tid/1367/type/StringLiteral","tid/8148/type/StringLiteral"],["tid/1375/type/StringLiteral","tid/8156/type/StringLiteral"],["tid/1444/type/StringLiteral"],["tid/1473/type/StringLiteral"],["tid/1499/type/StringLiteral"],["tid/1535/type/StringLiteral"],["tid/1545/type/StringLiteral"],["tid/1587/type/StringLiteral"],["tid/1597/type/StringLiteral"],["tid/1631/type/StringLiteral"],["tid/1641/type/StringLiteral"],["tid/1678/type/StringLiteral"],["tid/1688/type/StringLiteral"],["tid/1744/type/StringLiteral"],["tid/1754/type/StringLiteral"],["tid/1810/type/StringLiteral"],["tid/1820/type/StringLiteral"],["tid/1876/type/StringLiteral"],["tid/1886/type/StringLiteral"],["tid/1943/type/StringLiteral"],["tid/1953/type/StringLiteral"],["tid/2010/type/StringLiteral","tid/5757/type/StringLiteral"],["tid/2020/type/StringLiteral"],["tid/2060/type/StringLiteral"],["tid/2070/type/StringLiteral"],["tid/2128/type/StringLiteral"],["tid/2138/type/StringLiteral"],["tid/2196/type/StringLiteral"],["tid/2206/type/StringLiteral"],["tid/2213/type/StringLiteral"],["tid/2272/type/StringLiteral"],["tid/2282/type/StringLiteral"],["tid/2317/type/StringLiteral"],["tid/2327/type/StringLiteral"],["tid/2367/type/StringLiteral"],["tid/2377/type/StringLiteral"],["tid/2410/type/StringLiteral"],["tid/2420/type/StringLiteral"],["tid/2501/type/StringLiteral","tid/6925/type/StringLiteral"],["tid/2511/type/StringLiteral","tid/6935/type/StringLiteral"],["tid/2560/type/StringLiteral","tid/7100/type/StringLiteral"],["tid/2570/type/StringLiteral","tid/7110/type/StringLiteral"],["tid/2612/type/StringLiteral","tid/7181/type/StringLiteral"],["tid/2622/type/StringLiteral","tid/7191/type/StringLiteral"],["tid/2664/type/StringLiteral"],["tid/2674/type/StringLiteral"],["tid/2716/type/StringLiteral"],["tid/2726/type/StringLiteral"],["tid/2768/type/StringLiteral"],["tid/2778/type/StringLiteral"],["tid/2836/type/StringLiteral"],["tid/2865/type/StringLiteral"],["tid/2892/type/StringLiteral"],["tid/2919/type/StringLiteral"],["tid/2947/type/StringLiteral"],["tid/2954/type/StringLiteral"],["tid/2961/type/StringLiteral"],["tid/2968/type/StringLiteral"],["tid/3007/type/StringLiteral"],["tid/3014/type/StringLiteral"],["tid/3021/type/StringLiteral"],["tid/3066/type/StringLiteral"],["tid/3192/type/StringLiteral"],["tid/3228/type/StringLiteral"],["tid/3264/type/StringLiteral"],["tid/3313/type/StringLiteral"],["tid/3336/type/StringLiteral"],["tid/3374/type/StringLiteral"],["tid/3536/type/NoSubstitutionTemplate"],["tid/3544/type/NoSubstitutionTemplate"],["tid/3552/type/NoSubstitutionTemplate"],["tid/3641/type/StringLiteral"],["tid/3817/type/StringLiteral"],["tid/3850/type/StringLiteral"],["tid/4085/type/StringLiteral"],["tid/4092/type/StringLiteral"],["tid/4426/type/StringLiteral"],["tid/4740/type/StringLiteral"],["tid/4766/type/StringLiteral"],["tid/4773/type/StringLiteral"],["tid/5138/type/StringLiteral"],["tid/5311/type/StringLiteral"],["tid/5827/type/StringLiteral"],["tid/5860/type/StringLiteral"],["tid/5883/type/StringLiteral"],["tid/5894/type/StringLiteral"],["tid/5901/type/StringLiteral"],["tid/5908/type/StringLiteral"],["tid/6158/type/StringLiteral"],["tid/6303/type/StringLiteral"],["tid/6364/type/StringLiteral"],["tid/6486/type/StringLiteral"],["tid/6769/type/StringLiteral"],["tid/6848/type/StringLiteral"],["tid/6874/type/StringLiteral"],["tid/6881/type/StringLiteral"],["tid/6888/type/StringLiteral"],["tid/6895/type/StringLiteral"],["tid/6902/type/StringLiteral"],["tid/7269/type/StringLiteral"],["tid/7276/type/StringLiteral"],["tid/7283/type/StringLiteral"],["tid/7290/type/StringLiteral"],["tid/7319/type/StringLiteral"],["tid/7329/type/StringLiteral"],["tid/7339/type/StringLiteral"],["tid/7586/type/StringLiteral"],["tid/7805/type/StringLiteral"],["tid/7815/type/StringLiteral"],["tid/7849/type/StringLiteral"],["tid/7859/type/StringLiteral"],["tid/7896/type/StringLiteral","tid/8333/type/StringLiteral"],["tid/7906/type/StringLiteral"],["tid/7913/type/StringLiteral"],["tid/7920/type/StringLiteral"],["tid/7954/type/StringLiteral","tid/8364/type/StringLiteral"],["tid/7964/type/StringLiteral"],["tid/7991/type/StringLiteral"],["tid/8001/type/StringLiteral"],["tid/8031/type/StringLiteral"],["tid/8041/type/StringLiteral"],["tid/8048/type/StringLiteral"],["tid/8195/type/StringLiteral"],["tid/8221/type/StringLiteral"],["tid/8245/type/StringLiteral"],["tid/8277/type/StringLiteral"],["tid/8303/type/StringLiteral"],["tid/8310/type/StringLiteral"],["tid/8395/type/StringLiteral"],["tid/8426/type/StringLiteral"]],"basename":"options.js","dirname":"/addons/transChatGPT","extension":".js","filename":"options.js","path":"/addons/transChatGPT/options.js","indexIsBuilt":false,"indexIds":{"OpenAI Chat":0,"Target URL":1,"Target end point. You can use any service that supports OpenAI API.":2,"Sample endpoints":3,"Use this endpoint":4,"Copy to clipboard":5,"e.g.":6,"API Key":7,"Enter your API Key here.<br>The method to get the API key is different for each service.<br>":8,"Leave it blank if the service doesn't require API key.":9,"Model":10,"The pre-trained model":11,"For OpenAI, you may need to set the allowed model to be used (https://platform.openai.com/settings/proj_xxx/limits).":12,"Enable Context":13,"Enable context for the translation. The previously translated material above the current batch will be included as a context. <b>You also need to explicitly includes the CONTEXT into the template</b>":14,"Context Character Limit":15,"Character limit for the context.":16,"System Message Template":17,"System message is the header of the message that will tell what is the role of your chatGPT assistant. This message will be sent as the very first message of every batch you send to chatGPT.":18,"You can include the following variables with JavaScript's Template Literal style <span class='inlineCode'><b>${</b>VARIABLE<b>}</b></span><br>":19,"Variables:<br>":20,"<li>LANG_FROM : Source language</li>":21,"<li>LANG_TO : Target language</li>":22,"<li>SOURCE_TEXT : Source text</li>":23,"<li>ESCAPE_ALGORITHM_PROMPT : Pre-defined message of escape algorithm.</li>":24,"<li>NEWLINE_STRING : String represents new line (Line substitute).</li>":25,"<li>MESSAGE_COUNT : Number of messages in the batch.</li>":26,"<li>TITLE : Title of the game</li>":27,"<li>ENGINE : Engine of the game</li>":28,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":29,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":30,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":31,"Sample conversation":32,"User message":33,"Assistant's response":34,"Body Message Template":35,"Template of the body of your chat.":36,"Enable JailBreak":37,"Enable Jailbreak for the translation. This will make the translation more accurate and less biased. Some models may want to relate fictional events to real life events, hence they will try to alter the translation to fit their own narrative. This option will prevent that.":38,"Jailbreak Template":39,"Template of the Jailbreak message.":40,"Maximum Tokens":41,"The maximum number of tokens to generate in the completion.<br>The token count of your prompt plus max_tokens cannot exceed the model's context length. Most models have a context length of 2048 tokens (except for the newest models, which support 4096).":42,"Temperature":43,"What sampling temperature to use, between 0 and 2. Higher values like 0.8 will make the output more random, while lower values like 0.2 will make it more focused and deterministic. <br>OpenAI generally recommend altering this or top_p but not both.":44,"Nucleus sampling (top_p)":45,"An alternative to sampling with temperature, called nucleus sampling, where the model considers the results of the tokens with top_p probability mass. So 0.1 means only the tokens comprising the top 10% probability mass are considered. <br>OpenAI generally recommend altering this or temperature but not both.":46,"Frequency Penalty":47,"Number between -2.0 and 2.0. Positive values penalize new tokens based on their existing frequency in the text so far, decreasing the model's likelihood to repeat the same line verbatim. <br>https://platform.openai.com/docs/api-reference/parameter-details":48,"Presence Penalty":49,"Number between -2.0 and 2.0. Positive values penalize new tokens based on whether they appear in the text so far, increasing the model's likelihood to talk about new topics. <br>https://platform.openai.com/docs/api-reference/parameter-details":50,"Use JSON Schema":51,"Use <code>json_schema</code> for the <code>response_format.type</code> field instead of the old <code>json_object</code>. The <code>json_schema</code> is required by some of the latest models and some servers like <b>LM Studio</b>, but some old models are still using <code>json_object</code>.":52,"Max Characters per Batch":53,"Maximum character limit per translation batch.\nThis options will count the original text's character length only, and not the prompt message's character length.":54,"Max concurrent requests":55,"How many concurrent requests are allowed to be connected simultaneously? Each additional concurrent connection will multiply your translation speed, but will also quickly exhaust your token limit set by your provider.<br />Set it to <b>0</b> to disable this feature.<br />Combine this option with <b>Max row per concurrent request</b> to boost the translation speed further.<br />Setting this option to more than 1 will affect the <b>Context</b> because there will be a request processed before the previous one is finished. Thus, the context will be sent without the translation result of the prior request.":56,"Max row per concurrent requests":57,"How many rows are allowed for each concurrent requests. Set it to <b>0</b> to disable this feature.<br />If this option is disabled then no matter how many <b>Max concurrent requests</b> you set, Translator++ will process the request as a single chunk.<br />":58,"The more rows you set, the more translation you can get in a single batch. Hence reduce the overhead cost and increases the chance of the AI returning error results.<br />The lower the number, the less likely the translation will error but will cost you extra for overhead prompts.":59,"Preserve translations from invalid returned number of rows":60,"Preserve translations from responses that has invalid row counts.<br />If checked, Translator++ will attempt to correct the row count and insert translations into the grid.<br />If unchecked, cells will remain blank.<br />It is recommended to leave this option unchecked for retranslation purposes.":61,"Batch delay":62,"Delay between batch (in miliseconds).<br />Use this setting to control your requests so you don't hit the RPM (requests per minute) limit.":63,"Batch Timeout":64,"Timeout for each batch in milisecond":65,"Code Escaping Algorithm":66,"Escaping algorithm for inline code inside dialogues. You may need to change the <b>System Message Template</b> and <b>Body Message Template</b> according to the escape algorighm of your choice.<br />When you choose <b>JSONCloaking</b> or <b>JSONObjectCloaking</b>, <code>response_format: { type: 'json_object' }</code> will be sent automatically (unless you enable <b>Use JSON Schema</b>, which will send a JSON schema instead). <b>JSONCloaking</b> is very accurate, but doesn't work with all models, try <b>gpt-3.5-turbo-1106</b>.":67,"Number of retry":68,"How many times the engine should retry when translation output validation fails. If nullish (empty), then no retry.":69,"Retry when the number of translated rows doesn't match original":70,"If enabled, the engine will retry when the model returns a different number of translation rows compared to the original payload.":71,"Retry when the number of lines for each translated row doesn't match original":72,"If enabled, the engine will retry when any translated row has different number of lines than its original row.":73,"Prompt: Row count mismatch":74,"Prompt used when retrying due to row/element count mismatch. Available template variables include: ${MESSAGE_COUNT}, ${RETURNED_MESSAGE_COUNT}, ${LANG_TO}, ${SOURCE_TEXT}.":75,"Prompt: Line count mismatch":76,"Prompt used when retrying due to per-row line count mismatch. Available template variables include: ${LINE_ERRORS}, ${LANG_TO}, ${SOURCE_TEXT}.":77,"Prompt: Error / Retry instruction":78,"Prompt appended after the mismatch prompt(s) to instruct the model to retry. Available template variables include: ${ERROR_MESSAGE}, ${LANG_TO}, ${SOURCE_TEXT}.":79,"Custom Parameter":80,"Key":81,"Value":82,"Type":83,"Type of the value.":84,"For <b>javascript</b> type, the value will be evaluated as JavaScript code.":85,"The scope of the javascript code is <code>window</code>. So you can pretty much grab any value.":86,"<br />Example: <code>trans.project.title</code>":87,"Drop parameters that will not be sent to the API.<br />":88,"OpenAI API is keep changing, some new models may not support the old parameters and will return HTTP error for unrecognized request parameter.":89,"You can drop the parameters that are not supported by the model here.":90,"Manage configuration":91,"RPG Maker":92,"HTML Cloaking Wrapped":93,"JSONObject Cloaking":94,"This addon enables translation through any service that supports the OpenAI Chat API, such as Deepseek, LlamaCPP, Google Gemini, etc, and, of course, OpenAI ChatGPT.":95,"OpenAI API settings":96,"General":97,"<h2>Don't waste your money on Reasoning Models</h2>":98,"<p>It has been proven by various studies that reasoning models are far worse than the normal models on performing creative writings and translation tasks.</p>":99,"<p>You gain nothing but more expensive cost and slower response times when using reasoning models.</p>":100,"Explore more models":101,"Templates":102,"Enable context":103,"<h2>Sample dialogue</h2>":104,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":105,"Add Example: Translate Japanese to English":106,"Retry prompts":107,"<p>These prompts are appended as extra <b>user</b> messages during retries, right after the previous model output.</p>":108,"<p>Available variables:</p>":109,"Enable Jailbreak":110,"Advanced":111,"Custom Parameters":112,"You can add custom parameters to the OpenAI Chat API request body. This is useful if you want to add additional parameters that are not available in the form.":113,"<h2>Warning</h2>":114,"<li>Incorrectly setting custom parameters may cause the API request to fail. Make sure you know what you are doing before adding custom parameters. Some services like OpenAI are strict about what parameters you're sending, and they will return HTTP error for unrecognized request parameter.</li>":115,"<li>If the same key is used multiple times, only the last value will be used.</li>":116,"<li>If the same key in the existing configuration is used, then existing configuration parameter will be overwritten by the custom parameter.</li>":117,"Drop Parameters":118,"Open chatGPT tester":119,"Batch Translation Setting":120,"Sorry, this addon is only available for active patrons only.\nYou can unlock this feature by becoming a $1 patron.":121,"Preserve invalid returned rows":122,"Retries and Refinement":123,"<h2>Retries and Refinement</h2>":124,"<p>When the translation output fails the validation, Translator++ can ask the model to retry the translation. You can set how many times the model should retry and also set the condition for the retry.</p>":125,"<p>Setting a reasonable number of retries with proper retry conditions can significantly improve the translation quality while keeping the cost and time in check.</p>":126,"<p><b>Each retry costs you additional time and money</b>. If your batch ends up retrying frequently, you may want to adjust your prompt to make the instructions clearer for the model.</p>":127,"<p>Use developer tool or Batch Manager to debug your batch translation.</p>":128,"<h2>Code Escaping Algorithm</h2>":129,"<p>Code escaping is a technique to prevent the MTL from altering the code snippets inside the dialogues. This is useful when your dialogues contains code snippets such as HTML tags, XML tags, JSON objects, or JavaScript templates.</p>":130,"<p>Choose the escaping algorithm that matches the code snippets inside your dialogues. You may need to adjust the <b>system message</b>, <b>Sample prompt</b> and <b>body message</b> templates accordingly.</p>":131,"<p>Click <a href='https://dreamsavior.net/docs/translator/code-escaping-algorithm/' external>here</a> to read more about code escaping algorithms and how to use them effectively.</p>":132,"Default":133,"JavaScript template cloaking":134,"None (no escaping)":135,"Do you want to load the sample dialogue preset for the selected escape algorithm? This will overwrite your existing sample dialogue.":136,"Always separate file":137,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":138,"Add actor name":139,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":140,"Load Actor Reference as Glossary":141,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":142,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":143,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":144,"Actor Reference Translation Column":145,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":146,"Actor's Information Column":147,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":148,"Extra Prompt":149,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":150,"<br />":151,"General Settings":152,"Always separate file for each batch":153,"Append actor name to the translatable text":154,"Glossary":155,"<h2>Glossary</h2>":156,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":157,"The Column of Actor's Additional Information":158,"Prompt":159},"tags":[],"relPath":"/addons/transChatGPT/options.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":159,"length":160,"percent":99.375},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>إ</u>رسال"],["Toggle word wrap","تبديل التفاف النص"],["Open debugger (F12)","فتح المصحح (F12)"],["Help","مساعدة"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transChatGPT/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transChatGPT/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transChatGPT/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","هذه الميزة متاحة فقط إذا كنت تستخدم النسخة المطورة من Translator++. يمكنك التبديل إلى النسخة المطورة باستخدام الأدوات الأساسية -> تغيير نواة NWJS."]],"context":[["tid/1692/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transChatGPT/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transChatGPT/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transChatGPT/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transChatGPT/transOpenAIAssistant.js":{"data":[["<li>TITLE : Title of the game</li>","<li>TITLE : عنوان اللعبة</li>"],["<li>ENGINE : Engine of the game</li>","<li>المحرك: محرك اللعبة</li>"],["<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>","<li>معلومات الممثل: مسرد معلومات الممثلين. (فقط إذا تم تمكين خيار معلومات الممثل في وضع الدفعة)</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>مرجع [اسم الكائن]: إنشاء مرجع من كائن Translator++. <br />مثال: <code>مرجع [المرجع المشترك]</code></li>"],["<li>CONTEXT : Context of the previous translation (if context is enabled)</li>","<li>السياق: سياق الترجمة السابقة (إذا تم تمكين السياق)</li>"],["Sample conversation","محادثة نموذجية"],["<h2>Sample dialogue</h2>","<h2>حوار نموذجي</h2>"],["<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>","<p>حوار موجود نموذجي. يمكنك كتابة مثال لردود جيدة أو سياعدة المترجم على فهم هدفك وسياق المحادثة.</p>"],["Always separate file","فصل الملف دائمًا"],["Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.","افصل الملف دائمًا لكل دفعة. قد يحافظ هذا على سياقات كل ملف غير ملوثة بملفات أخرى."],["Add actor name","إضافة اسم الممثل"],["Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.","أضف اسم الممثل من معلومات الصف إلى النص القابل للترجمة. سيساعد هذا المترجمين على تتبع الحوار والضمائر. سيقوم Translator++ بعد ذلك بإزالة اسم الممثل من نتيجة الترجمة. سيؤدي هذا بوضوح إلى زيادة تكلفة الترجمة."],["Load Actor Reference as Glossary","تحميل مرجع الممثل كمسرد"],["If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.","إذا تم تحديده، سيقوم Translator++ بتحميل مرجع الممثل كمسرد. سيساعد هذا المترجم على فهم سياق المحادثة. مرجع الممثل هو اسم الممثل في الحوار. سيتم تحميله كمسرد للمترجم. سيؤدي هذا إلى زيادة تكلفة الترجمة."],["Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.","سيتم تحميل الشخصيات الموجودة فقط في المحادثة كمسرد لكل عنصر دفعة. استخدم أمر القالب لتحميل مرجع الممثل في رسالة المطالبة."],["<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.","<br />⚠️إذا قمت بتمكين هذا الخيار، تحتاج أيضًا إلى تضمين المتغير <code>معلومات الممثل</code> في قالب المطالبة لوضع بيانات معلومات الشخصية."],["Actor Reference Translation Column","عمود ترجمة مرجع الممثل"],["The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.","عمود ترجمة اسم الممثل. سيتم استخدام هذا العمود كترجمة لمرجع الممثل. سيحسن هذا اتساق ترجمة اسم الممثل في المحادثة."],["Actor's Information Column","عمود معلومات الممثل"],["The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.","العمود الذي يحتوي على معلومات إضافية للممثل. يمكنك وضع معلومات إضافية مثل الجنس، العمر، إلخ. سيحسن هذا ترجمة الضمائر في المحادثة."],["Extra Prompt","مطالبة إضافية"],["Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.","مطالبة إضافية ستضاف إلى رسالة المطالبة. ستضاف بعد رسالة النظام وقبل رسالة المطالبة الفعلية."],["General Settings","الإعدادات العامة"],["Always separate file for each batch","ملف منفصل دائمًا لكل دفعة"],["Append actor name to the translatable text","إضافة اسم الممثل إلى النص القابل للترجمة"],["Glossary","المعجم"],["<h2>Glossary</h2>","<h2>المعجم</h2>"],["<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>","<p>هذه الميزة ستساعدك في إضافة معجم تلقائيًا إلى المطالبة. سيتم تحميل المعجم لكل دفعة من العناصر لتحسين جودة الترجمة. ستحاول الميزة تحميل المصطلحات ذات الصلة فقط لتجنب تضخيم مطالبتك.</p>"],["The Column of Actor's Additional Information","عمود المعلومات الإضافية للممثل"],["Prompt","المطالبة"]],"context":[["tid/778/type/StringLiteral","tid/4939/type/StringLiteral"],["tid/786/type/StringLiteral","tid/4947/type/StringLiteral"],["tid/794/type/StringLiteral","tid/4955/type/StringLiteral"],["tid/802/type/StringLiteral","tid/4963/type/StringLiteral"],["tid/810/type/StringLiteral","tid/4971/type/StringLiteral"],["tid/879/type/StringLiteral"],["tid/2626/type/StringLiteral"],["tid/2633/type/StringLiteral"],["tid/4647/type/StringLiteral"],["tid/4657/type/StringLiteral"],["tid/4691/type/StringLiteral"],["tid/4701/type/StringLiteral"],["tid/4738/type/StringLiteral","tid/5148/type/StringLiteral"],["tid/4748/type/StringLiteral"],["tid/4755/type/StringLiteral"],["tid/4762/type/StringLiteral"],["tid/4796/type/StringLiteral","tid/5179/type/StringLiteral"],["tid/4806/type/StringLiteral"],["tid/4833/type/StringLiteral"],["tid/4843/type/StringLiteral"],["tid/4873/type/StringLiteral"],["tid/4883/type/StringLiteral"],["tid/5010/type/StringLiteral"],["tid/5036/type/StringLiteral"],["tid/5060/type/StringLiteral"],["tid/5092/type/StringLiteral"],["tid/5118/type/StringLiteral"],["tid/5125/type/StringLiteral"],["tid/5210/type/StringLiteral"],["tid/5241/type/StringLiteral"]],"basename":"transOpenAIAssistant.js","dirname":"/addons/transChatGPT","extension":".js","filename":"transOpenAIAssistant.js","path":"/addons/transChatGPT/transOpenAIAssistant.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>ACTOR_INFO : Glossary of actor information.(Only if actor information option is enabled in batch mode)</li>":2,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":3,"<li>CONTEXT : Context of the previous translation (if context is enabled)</li>":4,"Sample conversation":5,"<h2>Sample dialogue</h2>":6,"<p>Sample existing dialog. You can write a sample of good or bad responses to help the translator understand your aim and the context of the conversation.</p>":7,"Always separate file":8,"Always separate the file for each batch. This may keep the contexts of each files unpoluted with another files.":9,"Add actor name":10,"Append actor name from row info to the translatable text. This will help the translators to keep track of the dialogue and pronouns. Translator++ will then removes the actor name from the translation result. This obviously will increase the cost of the translation.":11,"Load Actor Reference as Glossary":12,"If checked, Translator++ will load the actor reference as glossary. This will help the translator to understand the context of the conversation. The actor reference is the name of the actor in the dialogue. This will be loaded as a glossary to the translator. This will increase the cost of the translation.":13,"Only the characters that are exists in the conversation will be loaded as glossary for each batch item. Use the template command to load the actor reference in the prompt message.":14,"<br />⚠️If you enable this option, you also need to include the <code>ACTOR_INFO</code> variable in the prompt template to place the character information data.":15,"Actor Reference Translation Column":16,"The column of the translation of the actor name. This column will be used as the translation of the actor reference. This will improve the consistency of actor name's translation in the conversation.":17,"Actor's Information Column":18,"The column that contains the actor's additional information. You can put more information such as gender, age, etc. This will improve the translation of the pronouns in the conversation.":19,"Extra Prompt":20,"Extra prompt that will be added to the prompt message. This will be added after the system message and before the actual prompt message.":21,"General Settings":22,"Always separate file for each batch":23,"Append actor name to the translatable text":24,"Glossary":25,"<h2>Glossary</h2>":26,"<p>This feature will help you automatically add a glossary into the prompt. The glossary will be loaded for each batch of items to improve the quality of the translation. The feature will try to load only the relevant terms to avoid bloating your prompt.</p>":27,"The Column of Actor's Additional Information":28,"Prompt":29},"tags":[],"relPath":"/addons/transChatGPT/transOpenAIAssistant.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":30,"length":30,"percent":100},"parameters":[]},"/addons/transChatGPT/utility.js":{"data":[["Chat with ChatGPT API","محادثة مع واجهة برمجة تطبيقات ChatGPT"],["Batch Manager","مدير الدُفعات"],["This feature is only available if you have a project open.","هذه الميزة متاحة فقط إذا كان لديك مشروع مفتوح."]],"context":[["tid/500/type/StringLiteral"],["tid/596/type/StringLiteral"],["tid/632/type/StringLiteral"]],"basename":"utility.js","dirname":"/addons/transChatGPT","extension":".js","filename":"utility.js","path":"/addons/transChatGPT/utility.js","indexIsBuilt":false,"indexIds":{"Chat with ChatGPT API":0,"Batch Manager":1,"This feature is only available if you have a project open.":2},"tags":[],"relPath":"/addons/transChatGPT/utility.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDazedMTL/transdazedmtl.js":{"data":[["Do you want to install DazedMTLTool?","هل تريد تثبيت DazedMTLTool؟"],["Ignore if already translated","تجاهل إذا تمت الترجمة بالفعل"],["OpenAI Translation with DazedMTL","ترجمة OpenAI مع DazedMTL"]],"context":[["tid/808/type/StringLiteral"],["tid/2798/type/StringLiteral"],["tid/5499/type/StringLiteral"]],"basename":"transdazedmtl.js","dirname":"/addons/transDazedMTL","extension":".js","filename":"transdazedmtl.js","path":"/addons/transDazedMTL/transdazedmtl.js","indexIsBuilt":false,"indexIds":{"Do you want to install DazedMTLTool?":0,"Ignore if already translated":1,"OpenAI Translation with DazedMTL":2},"tags":[],"relPath":"/addons/transDazedMTL/transdazedmtl.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":3,"length":3,"percent":100},"parameters":[]},"/addons/transDeepl/DeepLUtil.js":{"data":[["DeepL server is not installed. Do you want to install it now?","خادم DeepL غير مثبت. هل تريد تثبيته الآن؟"]],"context":[["tid/850/type/StringLiteral"]],"basename":"DeepLUtil.js","dirname":"/addons/transDeepl","extension":".js","filename":"DeepLUtil.js","path":"/addons/transDeepl/DeepLUtil.js","indexIsBuilt":false,"indexIds":{"DeepL server is not installed. Do you want to install it now?":0},"tags":[],"relPath":"/addons/transDeepl/DeepLUtil.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transDeeplPro/deepl-pro.js":{"data":[["Characters usage:\n","استخدام الأحرف:\n"],["Failed to fetch quota: ","فشل في جلب الحصة: "]],"context":[["tid/2118/type/StringLiteral"],["tid/2156/type/StringLiteral"]],"basename":"deepl-pro.js","dirname":"/addons/transDeeplPro","extension":".js","filename":"deepl-pro.js","path":"/addons/transDeeplPro/deepl-pro.js","indexIsBuilt":false,"indexIds":{"Characters usage:\n":0,"Failed to fetch quota: ":1},"tags":[],"relPath":"/addons/transDeeplPro/deepl-pro.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":2,"length":2,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.html":{"data":[["<u>S</u>end","<u>إ</u>رسال"],["Toggle word wrap","تبديل التفاف النص"],["Open debugger (F12)","فتح المصحح (F12)"],["Help","مساعدة"]],"context":[["idx/0/innerText"],["idx/0/attr/title"],["idx/1/attr/title"],["idx/2/attr/title"]],"basename":"chatGPTtester.html","dirname":"/addons/transGPT4All/tester","extension":".html","filename":"chatGPTtester.html","path":"/addons/transGPT4All/tester/chatGPTtester.html","indexIsBuilt":false,"indexIds":{"<u>S</u>end":0,"Toggle word wrap":1,"Open debugger (F12)":2,"Help":3},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.html","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":4,"length":4,"percent":100},"parameters":[]},"/addons/transGPT4All/tester/chatGPTtester.js":{"data":[["This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.","هذه الميزة متاحة فقط إذا كنت تستخدم النسخة المطورة من Translator++. يمكنك التبديل إلى النسخة المطورة باستخدام الأدوات الأساسية -> تغيير نواة NWJS."]],"context":[["tid/921/type/StringLiteral"]],"basename":"chatGPTtester.js","dirname":"/addons/transGPT4All/tester","extension":".js","filename":"chatGPTtester.js","path":"/addons/transGPT4All/tester/chatGPTtester.js","indexIsBuilt":false,"indexIds":{"This feature only available if you are using Developer version of Translator++. You can switch into Developer version by using Basic Utilities -> Change Core NWJS.":0},"tags":[],"relPath":"/addons/transGPT4All/tester/chatGPTtester.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":1,"length":1,"percent":100},"parameters":[]},"/addons/transGemini/gemini.js":{"data":[["<li>TITLE : Title of the game</li>","<li>العنوان : عنوان اللعبة</li>"],["<li>ENGINE : Engine of the game</li>","<li>المحرك : محرك اللعبة</li>"],["<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>","<li>مرجع[اسم الكائن] : إنشاء مرجع من كائن Translator++. <br />مثال : <code>مرجع[المرجع المشترك]</code></li>"],["<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>","<h2>واجهة برمجة تطبيقات Gemini الأصلية</h2><p>يستخدم هذا المحرك واجهة برمجة تطبيقات Google Gemini الأصلية للترجمة. <br />يمكنك أيضًا استخدام إضافة OpenAI لـ Google Gemini. هناك ميزات أكثر في إضافة OpenAI، لهذا <b style='color:green;'>أوصي باستخدام إضافة OpenAI بدلاً من ذلك</b>.</p>"],["Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.","يتطلب Gemini AI بعض الوحدات من مكتبة OpenAI. يرجى التأكد من تثبيت إضافة <b>transChatGPT (ChatGPT لـ Translator++)</b>."],["Explore more models","استكشف المزيد من النماذج"]],"context":[["tid/500/type/StringLiteral"],["tid/508/type/StringLiteral"],["tid/516/type/StringLiteral"],["tid/1399/type/StringLiteral"],["tid/1423/type/StringLiteral"],["tid/1703/type/StringLiteral"]],"basename":"gemini.js","dirname":"/addons/transGemini","extension":".js","filename":"gemini.js","path":"/addons/transGemini/gemini.js","indexIsBuilt":false,"indexIds":{"<li>TITLE : Title of the game</li>":0,"<li>ENGINE : Engine of the game</li>":1,"<li>REFERENCE[object name] : Generate reference from Translator++ object. <br />Example : <code>REFERENCE[Common Reference]</code></li>":2,"<h2>Native Gemini API</h2><p>This engine uses Google Gemini native API for translation. <br />You can also use OpenAI add-on for Google Gemini. There are more features in the OpenAI add-on, That's why <b style='color:green;'>I recommend using the OpenAI add-on instead</b>.</p>":3,"Gemini AI requires some module from OpenAI library. Please make sure <b>transChatGPT (ChatGPT for Translator++)</b> add-on is installed.":4,"Explore more models":5},"tags":[],"relPath":"/addons/transGemini/gemini.js","originalFormat":"Autogenerated TRANS obj","type":"","progress":{"translated":6,"length":6,"percent":100},"parameters":[]},"/addons/transGeminiAi/BetterChatGPT/dist/assets/index-05e7d66a.js":{"data":[["customModels.customLabel","customModels.customLabel"],["model","نموذج"],["|","|"],["promptLibrary","مكتبة النصوص"],["search","بحث"],["downloadChat","تحميل محادثة"],["newChat","محادثة جديدة"],["api","واجهة برمجة التطبيقات"],["customEndpoint","نقطة نهاية مخصصة"],["apiEndpoint.inputLabel","apiEndpoint.inputLabel"],["apiKey.inputLabel","apiKey.inputLabel"],["apiVersion.inputLabel","apiVersion.inputLabel"],["apiVersion.description","apiVersion.description"],["securityMessage","رسالة الأمان"],["apiEndpoint.description","apiEndpoint.description"],["apiEndpoint.warn","apiEndpoint.warn"],["partialImportMessages"